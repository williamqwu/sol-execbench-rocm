__pycache__/
*.pyc
.pytest_cache/
# Anchored to the repo root ON PURPOSE. An unanchored `data/` also matches
# src/sol_execbench/core/data/ and tests/sol_execbench/core/data/, and in
# session 1 it silently excluded the vendored data-model package from the
# commit -- the code imported it, the working tree had it, and git did not.
# See STATE.md deviation D6.
/data/
artifacts/**/logs/
# Golden reference tensors: 143 GB of regenerable float64 CPU output.
# `scripts/gen_golden.py` rebuilds them from the dataset on any machine, with
# no GPU. The per-workload report beside them IS tracked, because which tier
# produced each golden (float64 vs native_cpu) is a finding, not data.
artifacts/golden/*.pt
*.so
.venv/
uv.lock
.uv-cache/

# Leaderboard databases: a rebuildable view over artifacts/, not a source of
# truth. One file per part, ~17 MB of binary each, regenerated in under a
# second by `leaderboard/ingest.py`.
leaderboard/db/
# The pre-split single-file layout. Nothing writes it any more; `app.py` still
# reads a leftover one so an old checkout does not go blank.
leaderboard/solbench.db*

# Which out-of-repo agent-run roots this machine's board is built from. The
# paths are machine-local, so the tracked file is `sources.json.example` --
# which does not match this pattern and stays in the tree.
leaderboard/sources.json

# torch TunableOp writes its tuning results to CWD when an agent enables it.
tunableop_results*.csv

# Agent transcripts: 2 MB of JSONL per problem, and their provenance records
# carry gateway hostnames and API-key prefixes. Kept on disk and served to
# internal viewers by /api/v1/.../transcript, which reads the path out of the
# `transcript` table -- never out of the request. Not in the tree.
artifacts/10/*/transcripts/

# Submission API tokens, and the queue's own database. The queue is durable
# state, not a view over artifacts -- but it is per-deployment state, and a
# token file in the tree is a token that is public.
leaderboard/.tokens
leaderboard/queue.db*
artifacts/10/_spool/

# SOLAR writes this next to the cwd when run from the repo root.
solar_handlers_cache/
