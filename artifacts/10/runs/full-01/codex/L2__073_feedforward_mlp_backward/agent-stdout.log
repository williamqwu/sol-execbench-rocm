{"type":"item.started","item":{"id":"item_6","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch\n\ntorch.manual_seed(1)\nM,H,I=1024,2048,8192\ngo=torch.randn((M,H),device='cuda',dtype=torch.float32)\nhs=torch.randn((M,H),device='cuda',dtype=torch.float32)\nw1=torch.randn((I,H),device='cuda',dtype=torch.float32)\nw2=torch.randn((H,I),device='cuda',dtype=torch.float32)\nx=torch.randn((M,I),device='cuda',dtype=torch.float32)\nia=torch.randn((M,I),device='cuda',dtype=torch.float32)\n\ndef time(name, fn, n=10):\n    for _ in range(3): y=fn()\n    torch.cuda.synchronize()\n    ev=[]\n    for _ in range(n):\n        a=torch.cuda.Event(True); b=torch.cuda.Event(True)\n        a.record(); y=fn(); b.record(); ev.append((a,b))\n    torch.cuda.synchronize()\n    ts=sorted(a.elapsed_time(b) for a,b in ev)\n    print(name, ts[len(ts)//2])\n    return y\n\ngia=time('go@w2',lambda: go@w2)\ngw2=time('goT@ia',lambda: go.T@ia)\ngb2=time('sum go',lambda:go.sum(0))\ndef gelu():\n    xc=x*x*x\n    inner=0.7978845608028654*(x+0.044715*xc)\n    t=torch.tanh(inner)\n    di=0.7978845608028654*(1.0+3.0*0.044715*x*x)\n    ss=1.0-t*t\n    gg=0.5*(1.0+t)+0.5*x*ss*di\n    return gia*gg\ngi=time('gelu backward',gelu)\ngh=time('gi@w1',lambda:gi@w1)\ngw1=time('giT@hs',lambda:gi.T@hs)\ngb1=time('sum gi',lambda:gi.sum(0))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
