{"type":"item.started","item":{"id":"item_44","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch,triton,kernel,gc\n\ndef prof(M):\n H,I=2048,8192;n=M*I\n go=torch.randn(M,H,device='cuda');hs=torch.randn(M,H,device='cuda');w1=torch.randn(I,H,device='cuda');w2=torch.randn(H,I,device='cuda');x=torch.randn(M,I,device='cuda');ia=torch.randn(M,I,device='cuda')\n cur=torch.cuda.current_stream();aux=kernel._aux_stream\n def one(show=False):\n  ev=[torch.cuda.Event(True) for _ in range(9)];s,c1,a1,a2,c2,a4,a5,c3,e=ev\n  s.record();aux.wait_stream(cur)\n  gia=go@w2;c1.record()\n  with torch.cuda.stream(aux):\n   gw2=go.T@ia;a1.record();gb2=go.sum(0);a2.record()\n  gi=torch.empty_like(x);kernel._gelu_pre_kernel[(triton.cdiv(n,512),)](x,gi,n,BLOCK=512,num_warps=4);gi.tanh_();kernel._gelu_post_kernel[(triton.cdiv(n,512),)](gia,x,gi,gi,n,BLOCK=512,num_warps=4);c2.record()\n  aux.wait_stream(cur)\n  with torch.cuda.stream(aux):\n   gw1=gi.T@hs;a4.record();gb1=gi.sum(0);a5.record()\n  gh=gi@w1;c3.record();cur.wait_stream(aux);e.record();torch.cuda.synchronize()\n  return [s.elapsed_time(q) for q in ev[1:]]\n for _ in range(2):one()\n rows=[one() for _ in range(5)];rows.sort(key=lambda z:z[-1]);r=rows[2]\n print('M',M,'cGIA aGW2 aGB2 cGI aGW1 aGB1 cGH END');print(' '.join(f'{z:.3f}' for z in r)); print('all ends',[round(z[-1],3) for z in rows])\n del go,hs,w1,w2,x,ia;gc.collect();torch.cuda.empty_cache()\nprof(1024);prof(8192)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
