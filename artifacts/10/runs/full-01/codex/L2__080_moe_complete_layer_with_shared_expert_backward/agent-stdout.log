{"type":"item.completed","item":{"id":"item_29","type":"command_execution","command":"/bin/bash -lc \"nl -ba kernel.py | sed -n '1,240p'\"","aggregated_output":"     1\timport torch\n     2\timport triton\n     3\timport triton.language as tl\n     4\t\n     5\t\n     6\t@triton.jit\n     7\tdef _swiglu_backward_kernel(\n     8\t    grad_activated,\n     9\t    up_output,\n    10\t    gate_output,\n    11\t    grad_up_output,\n    12\t    grad_gate_output,\n    13\t    n_elements: tl.constexpr,\n    14\t    BLOCK: tl.constexpr,\n    15\t):\n    16\t    offsets = tl.program_id(0) * BLOCK + tl.arange(0, BLOCK)\n    17\t    mask = offsets < n_elements\n    18\t    ga = tl.load(grad_activated + offsets, mask=mask)\n    19\t    up = tl.load(up_output + offsets, mask=mask)\n    20\t    gate = tl.load(gate_output + offsets, mask=mask).to(tl.float32)\n    21\t\n    22\t    # Match the eager implementation's BF16 intermediates.\n    23\t    grad_gate_silu = (ga * up).to(tl.bfloat16)\n    24\t    sigmoid_gate = tl.sigmoid(gate)\n    25\t    silu_gate = (gate * sigmoid_gate).to(tl.bfloat16)\n    26\t    grad_up = (ga * silu_gate).to(tl.bfloat16)\n    27\t    silu_derivative = sigmoid_gate * (1.0 + gate * (1.0 - sigmoid_gate))\n    28\t    grad_gate = (grad_gate_silu.to(tl.float32) * silu_derivative).to(tl.bfloat16)\n    29\t\n    30\t    tl.store(grad_up_output + offsets, grad_up, mask=mask)\n    31\t    tl.store(grad_gate_output + offsets, grad_gate, mask=mask)\n    32\t\n    33\t\n    34\t@triton.jit\n    35\tdef _scatter_router_kernel(\n    36\t    grad_selected,\n    37\t    topk_indices,\n    38\t    score_mask,\n    39\t    scores,\n    40\t    grad_router_logits,\n    41\t    grad_router_logits_bf16,\n    42\t):\n    43\t    token = tl.program_id(0)\n    44\t    experts = tl.arange(0, 128)\n    45\t    selected = tl.zeros((128,), tl.float32)\n    46\t    for k in range(8):\n    47\t        index = tl.load(topk_indices + token * 8 + k)\n    48\t        value = tl.load(grad_selected + token * 8 + k)\n    49\t        selected += tl.where(experts == index, value, 0.0)\n    50\t\n    51\t    offsets = token * 128 + experts\n    52\t    value = selected * tl.load(score_mask + offsets)\n    53\t    score = tl.load(scores + offsets)\n    54\t    value = value * score\n    55\t    value = value * (1.0 - score)\n    56\t    tl.store(grad_router_logits + offsets, value)\n    57\t    tl.store(grad_router_logits_bf16 + offsets, value.to(tl.bfloat16))\n    58\t\n    59\t\n    60\t@triton.jit\n    61\tdef _routing_preprocess_kernel(\n    62\t    grad_output,\n    63\t    topk_weights,\n    64\t    grad_selected,\n    65\t):\n    66\t    token = tl.program_id(0)\n    67\t    hidden_offsets = token * 4096 + tl.arange(0, 4096)\n    68\t    go = tl.load(grad_output + hidden_offsets).to(tl.float32)\n    69\t    grad_norm_sq = tl.sum(go * go, axis=0)\n    70\t\n    71\t    k = tl.arange(0, 8)\n    72\t    weights = tl.load(topk_weights + token * 8 + k)\n    73\t    grad = grad_norm_sq * 0.125\n    74\t    denominator = tl.sum(weights, axis=0) + 1.0e-20\n    75\t    sum_grad = tl.sum(grad * weights, axis=0) / denominator\n    76\t    result = (grad - sum_grad) / denominator\n    77\t    tl.store(grad_selected + token * 8 + k, result)\n    78\t\n    79\t\n    80\t@triton.jit\n    81\tdef _grad_norm_kernel(grad_output, grad_norm_sq):\n    82\t    token = tl.program_id(0)\n    83\t    offsets = token * 4096 + tl.arange(0, 4096)\n    84\t    value = tl.load(grad_output + offsets).to(tl.float32)\n    85\t    result = tl.sum(value * value, axis=0)\n    86\t    tl.store(grad_norm_sq + token, result)\n    87\t\n    88\t\n    89\t@torch.no_grad()\n    90\tdef run(\n    91\t    grad_output,\n    92\t    hidden_states,\n    93\t    router_weight,\n    94\t    e_score_correction_bias,\n    95\t    router_logits,\n    96\t    scores,\n    97\t    topk_indices,\n    98\t    topk_weights,\n    99\t    score_mask,\n   100\t    shared_expert_gate_weight,\n   101\t    shared_expert_up_weight,\n   102\t    shared_expert_down_weight,\n   103\t    shared_gate_output,\n   104\t    shared_up_output,\n   105\t    shared_activated,\n   106\t):\n   107\t    batch_seq_len = hidden_states.shape[0]\n   108\t\n   109\t    grad_shared_activated = grad_output @ shared_expert_down_weight\n   110\t    grad_shared_expert_down_weight = grad_output.t() @ shared_activated\n   111\t\n   112\t    grad_shared_up_output = torch.empty_like(shared_up_output)\n   113\t    grad_shared_gate_output = torch.empty_like(shared_gate_output)\n   114\t    n_elements = shared_gate_output.numel()\n   115\t    _swiglu_backward_kernel[(triton.cdiv(n_elements, 1024),)](\n   116\t        grad_shared_activated,\n   117\t        shared_up_output,\n   118\t        shared_gate_output,\n   119\t        grad_shared_up_output,\n   120\t        grad_shared_gate_output,\n   121\t        n_elements=n_elements,\n   122\t        BLOCK=1024,\n   123\t        num_warps=8,\n   124\t    )\n   125\t\n   126\t    grad_hidden_from_shared_up = grad_shared_up_output @ shared_expert_up_weight\n   127\t    grad_shared_expert_up_weight = grad_shared_up_output.t() @ hidden_states\n   128\t    grad_shared_expert_gate_weight = grad_shared_gate_output.t() @ hidden_states\n   129\t\n   130\t    hidden_f32 = hidden_states.to(torch.float32)\n   131\t    grad_norm_sq = torch.empty(\n   132\t        batch_seq_len, 1, dtype=torch.float32, device=hidden_states.device\n   133\t    )\n   134\t    _grad_norm_kernel[(batch_seq_len,)](\n   135\t        grad_output,\n   136\t        grad_norm_sq,\n   137\t        num_warps=8,\n   138\t    )\n   139\t    grad_topk_weights = grad_norm_sq.expand_as(topk_weights) / 8\n   140\t    denominator = topk_weights.sum(dim=-1, keepdim=True) + 1e-20\n   141\t    sum_grad = (grad_topk_weights * topk_weights).sum(dim=-1, keepdim=True) / denominator\n   142\t    grad_topk_weights_before_norm = (grad_topk_weights - sum_grad) / denominator\n   143\t\n   144\t    grad_router_logits = torch.empty(\n   145\t        batch_seq_len, 128, dtype=torch.float32, device=hidden_states.device\n   146\t    )\n   147\t    grad_router_logits_bf16 = torch.empty(\n   148\t        batch_seq_len, 128, dtype=torch.bfloat16, device=hidden_states.device\n   149\t    )\n   150\t    _scatter_router_kernel[(batch_seq_len,)](\n   151\t        grad_topk_weights_before_norm,\n   152\t        topk_indices,\n   153\t        score_mask,\n   154\t        scores,\n   155\t        grad_router_logits,\n   156\t        grad_router_logits_bf16,\n   157\t        num_warps=4,\n   158\t    )\n   159\t    grad_router_weight = grad_router_logits.t() @ hidden_f32\n   160\t\n   161\t    grad_hidden_from_shared_gate = grad_shared_gate_output @ shared_expert_gate_weight\n   162\t    grad_hidden_from_router = grad_router_logits_bf16 @ router_weight\n   163\t    grad_hidden_states = (\n   164\t        grad_hidden_from_shared_up\n   165\t        + grad_hidden_from_shared_gate\n   166\t        + grad_hidden_from_router\n   167\t    )\n   168\t    return (\n   169\t        grad_hidden_states,\n   170\t        grad_router_weight,\n   171\t        grad_shared_expert_gate_weight,\n   172\t        grad_shared_expert_up_weight,\n   173\t        grad_shared_expert_down_weight,\n   174\t    )\n","exit_code":0,"status":"completed"}}
