{"type":"item.completed","item":{"id":"item_26","type":"command_execution","command":"/bin/bash -lc \"nl -ba kernel.py | sed -n '1,280p'\"","aggregated_output":"     1\timport torch\n     2\timport triton\n     3\timport triton.language as tl\n     4\t\n     5\t\n     6\t@triton.jit\n     7\tdef _rounded_causal_attention(\n     8\t    Q, K, V, O,\n     9\t    stride_qb: tl.constexpr, stride_qh: tl.constexpr, stride_qm: tl.constexpr,\n    10\t    stride_kb: tl.constexpr, stride_kh: tl.constexpr, stride_kn: tl.constexpr,\n    11\t    stride_vb: tl.constexpr, stride_vh: tl.constexpr, stride_vn: tl.constexpr,\n    12\t    stride_ob: tl.constexpr, stride_om: tl.constexpr, stride_oh: tl.constexpr,\n    13\t    SCALE: tl.constexpr, N_CTX: tl.constexpr,\n    14\t    BLOCK_M: tl.constexpr, BLOCK_N: tl.constexpr,\n    15\t):\n    16\t    start_m = tl.program_id(0) * BLOCK_M\n    17\t    off_bh = tl.program_id(1)\n    18\t    off_b = off_bh // 40\n    19\t    off_h = off_bh % 40\n    20\t    off_kh = off_h // 5\n    21\t\n    22\t    offs_m = start_m + tl.arange(0, BLOCK_M)\n    23\t    offs_n = tl.arange(0, BLOCK_N)\n    24\t    offs_d = tl.arange(0, 128)\n    25\t\n    26\t    q_ptrs = Q + off_b * stride_qb + off_h * stride_qh + offs_m[:, None] * stride_qm + offs_d[None, :]\n    27\t    q = tl.load(q_ptrs, mask=offs_m[:, None] < N_CTX, other=0.0)\n    28\t\n    29\t    # First pass obtains the FP32 softmax normalization without materializing\n    30\t    # the quadratic score tensor.  Scores are explicitly rounded after the\n    31\t    # GEMM and again after scaling, matching the two BF16 reference ops.\n    32\t    row_max = tl.full((BLOCK_M,), -float(\"inf\"), tl.float32)\n    33\t    row_sum = tl.zeros((BLOCK_M,), tl.float32)\n    34\t    loop_hi = tl.minimum(start_m + BLOCK_M, N_CTX)\n    35\t    for start_n in tl.range(0, loop_hi, BLOCK_N):\n    36\t        n = start_n + offs_n\n    37\t        k_ptrs = K + off_b * stride_kb + off_kh * stride_kh + n[None, :] * stride_kn + offs_d[:, None]\n    38\t        k = tl.load(k_ptrs, mask=n[None, :] < N_CTX, other=0.0)\n    39\t        score = tl.dot(q, k).to(tl.bfloat16)\n    40\t        score = (score.to(tl.float32) * SCALE).to(tl.bfloat16)\n    41\t        valid = (offs_m[:, None] < N_CTX) & (n[None, :] <= offs_m[:, None]) & (n[None, :] < N_CTX)\n    42\t        score = tl.where(valid, score.to(tl.float32), -float(\"inf\"))\n    43\t        block_max = tl.max(score, axis=1)\n    44\t        new_max = tl.maximum(row_max, block_max)\n    45\t        alpha = tl.exp(row_max - new_max)\n    46\t        row_sum = row_sum * alpha + tl.sum(tl.exp(score - new_max[:, None]), axis=1)\n    47\t        row_max = new_max\n    48\t\n    49\t    # The probability must be rounded only after division by the complete\n    50\t    # softmax denominator.  A second score pass preserves that checkpoint.\n    51\t    acc = tl.zeros((BLOCK_M, 128), tl.float32)\n    52\t    for start_n in tl.range(0, loop_hi, BLOCK_N):\n    53\t        n = start_n + offs_n\n    54\t        k_ptrs = K + off_b * stride_kb + off_kh * stride_kh + n[None, :] * stride_kn + offs_d[:, None]\n    55\t        k = tl.load(k_ptrs, mask=n[None, :] < N_CTX, other=0.0)\n    56\t        score = tl.dot(q, k).to(tl.bfloat16)\n    57\t        score = (score.to(tl.float32) * SCALE).to(tl.bfloat16)\n    58\t        valid = (offs_m[:, None] < N_CTX) & (n[None, :] <= offs_m[:, None]) & (n[None, :] < N_CTX)\n    59\t        score = tl.where(valid, score.to(tl.float32), -float(\"inf\"))\n    60\t        prob = tl.exp(score - row_max[:, None]) / row_sum[:, None]\n    61\t        prob = tl.where(valid, prob, 0.0).to(tl.bfloat16)\n    62\t        v_ptrs = V + off_b * stride_vb + off_kh * stride_vh + n[:, None] * stride_vn + offs_d[None, :]\n    63\t        v = tl.load(v_ptrs, mask=n[:, None] < N_CTX, other=0.0)\n    64\t        acc = tl.dot(prob, v, acc)\n    65\t\n    66\t    o_ptrs = O + off_b * stride_ob + offs_m[:, None] * stride_om + off_h * stride_oh + offs_d[None, :]\n    67\t    tl.store(o_ptrs, acc.to(tl.bfloat16), mask=offs_m[:, None] < N_CTX)\n    68\t\n    69\t\n    70\t@torch.no_grad()\n    71\tdef run(\n    72\t    hidden_states,\n    73\t    position_ids,\n    74\t    attention_mask,\n    75\t    q_proj_weight,\n    76\t    k_proj_weight,\n    77\t    v_proj_weight,\n    78\t    o_proj_weight,\n    79\t    q_norm_weight,\n    80\t    k_norm_weight,\n    81\t    inv_freq,\n    82\t    rms_norm_eps,\n    83\t    attention_factor,\n    84\t    scaling,\n    85\t):\n    86\t    batch_size, seq_len, hidden_size = hidden_states.shape\n    87\t\n    88\t    query_states = torch.nn.functional.linear(hidden_states, q_proj_weight)\n    89\t    key_states = torch.nn.functional.linear(hidden_states, k_proj_weight)\n    90\t    value_states = torch.nn.functional.linear(hidden_states, v_proj_weight)\n    91\t\n    92\t    query_states = torch.nn.functional.rms_norm(query_states, (hidden_size,), q_norm_weight, rms_norm_eps)\n    93\t    key_states = torch.nn.functional.rms_norm(key_states, (1024,), k_norm_weight, rms_norm_eps)\n    94\t\n    95\t    query_states = query_states.view(batch_size, seq_len, 40, 128).transpose(1, 2)\n    96\t    key_states = key_states.view(batch_size, seq_len, 8, 128).transpose(1, 2)\n    97\t    value_states = value_states.view(batch_size, seq_len, 8, 128).transpose(1, 2)\n    98\t\n    99\t    freqs = (inv_freq[None, :, None].float() @ position_ids[:, None, :].float()).transpose(1, 2)\n   100\t    emb = torch.cat((freqs, freqs), dim=-1)\n   101\t    cos = (emb.cos() * attention_factor).unsqueeze(1).to(hidden_states.dtype)\n   102\t    sin = (emb.sin() * attention_factor).unsqueeze(1).to(hidden_states.dtype)\n   103\t\n   104\t    q1, q2 = query_states[..., :64], query_states[..., 64:]\n   105\t    k1, k2 = key_states[..., :64], key_states[..., 64:]\n   106\t    query_states = (query_states * cos) + (torch.cat((-q2, q1), dim=-1) * sin)\n   107\t    key_states = (key_states * cos) + (torch.cat((-k2, k1), dim=-1) * sin)\n   108\t\n   109\t    attn_output = torch.empty_like(hidden_states)\n   110\t    block_m = 128\n   111\t    block_n = 32\n   112\t    _rounded_causal_attention[(triton.cdiv(seq_len, block_m), batch_size * 40)](\n   113\t        query_states, key_states, value_states, attn_output,\n   114\t        query_states.stride(0), query_states.stride(1), query_states.stride(2),\n   115\t        key_states.stride(0), key_states.stride(1), key_states.stride(2),\n   116\t        value_states.stride(0), value_states.stride(1), value_states.stride(2),\n   117\t        attn_output.stride(0), attn_output.stride(1), 128,\n   118\t        scaling, seq_len,\n   119\t        BLOCK_M=block_m, BLOCK_N=block_n,\n   120\t        num_warps=4,\n   121\t    )\n   122\t    return torch.nn.functional.linear(attn_output, o_proj_weight)\n","exit_code":0,"status":"completed"}}
