{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,280p' reference.py && printf '\\\\nDEFINITION\\\\n' && jq . definition.json && printf '\\\\nWORKLOADS\\\\n' && nl -ba workload.jsonl\"","aggregated_output":"import torch\nimport math\n\ndef get_inputs(axes_and_scalars: dict, device: torch.device) -> dict:\n    batch_size = axes_and_scalars[\"batch_size\"]\n    seq_len = axes_and_scalars[\"seq_len\"]\n    hidden_size = 5120\n    num_attention_heads = 40\n    num_key_value_heads = 8\n    head_dim = 128\n    kv_hidden_size = num_key_value_heads * head_dim\n    half_head_dim = head_dim // 2\n    sliding_window = 4096\n    \n    dtype = torch.bfloat16\n    \n    hidden_states = torch.randn(batch_size, seq_len, hidden_size, dtype=dtype, device=device)\n    position_ids = torch.arange(seq_len, dtype=torch.int64, device=device).unsqueeze(0).expand(batch_size, -1)\n    \n    # Create sliding window causal mask\n    mask = torch.full((seq_len, seq_len), float(\"-inf\"), dtype=dtype, device=device)\n    mask = torch.triu(mask, diagonal=1)\n    # Apply sliding window\n    for i in range(seq_len):\n        start = max(0, i - sliding_window + 1)\n        if start > 0:\n            mask[i, :start] = float(\"-inf\")\n    attention_mask = mask.unsqueeze(0).unsqueeze(0).expand(batch_size, 1, seq_len, seq_len)\n    \n    q_proj_weight = torch.randn(hidden_size, hidden_size, dtype=dtype, device=device) * 0.02\n    k_proj_weight = torch.randn(kv_hidden_size, hidden_size, dtype=dtype, device=device) * 0.02\n    v_proj_weight = torch.randn(kv_hidden_size, hidden_size, dtype=dtype, device=device) * 0.02\n    o_proj_weight = torch.randn(hidden_size, hidden_size, dtype=dtype, device=device) * 0.02\n    \n    q_norm_weight = torch.ones(hidden_size, dtype=dtype, device=device)\n    k_norm_weight = torch.ones(kv_hidden_size, dtype=dtype, device=device)\n    \n    # Compute YARN RoPE inv_freq\n    rope_theta = 500000.0\n    rope_scaling_factor = 8.0\n    beta_fast = 32\n    beta_slow = 1\n    original_max_position_embeddings = 8192\n    \n    inv_freq_base = 1.0 / (rope_theta ** (torch.arange(0, head_dim, 2, dtype=torch.float32, device=device) / head_dim))\n    old_context_len = original_max_position_embeddings\n    low_freq_wavelen = old_context_len / beta_fast\n    high_freq_wavelen = old_context_len / beta_slow\n    wavelen = 2 * math.pi / inv_freq_base\n    smooth_factor = (old_context_len / wavelen - beta_fast) / (beta_slow - beta_fast)\n    smooth_factor = torch.clamp(smooth_factor, 0.0, 1.0)\n    inv_freq = (1 - smooth_factor) * (inv_freq_base / rope_scaling_factor) + smooth_factor * inv_freq_base\n    \n    rms_norm_eps = 1e-6\n    attention_factor_val = 1.2079441541679836\n    scaling_val = head_dim ** -0.5\n    \n    return {\n        \"hidden_states\": hidden_states,\n        \"position_ids\": position_ids,\n        \"attention_mask\": attention_mask,\n        \"q_proj_weight\": q_proj_weight,\n        \"k_proj_weight\": k_proj_weight,\n        \"v_proj_weight\": v_proj_weight,\n        \"o_proj_weight\": o_proj_weight,\n        \"q_norm_weight\": q_norm_weight,\n        \"k_norm_weight\": k_norm_weight,\n        \"inv_freq\": inv_freq,\n        \"rms_norm_eps\": rms_norm_eps,\n        \"attention_factor\": attention_factor_val,\n        \"scaling\": scaling_val,\n    }\n\n@torch.no_grad()\ndef run(\n    hidden_states: torch.Tensor,\n    position_ids: torch.Tensor,\n    attention_mask: torch.Tensor,\n    q_proj_weight: torch.Tensor,\n    k_proj_weight: torch.Tensor,\n    v_proj_weight: torch.Tensor,\n    o_proj_weight: torch.Tensor,\n    q_norm_weight: torch.Tensor,\n    k_norm_weight: torch.Tensor,\n    inv_freq: torch.Tensor,\n    rms_norm_eps: float,\n    attention_factor: float,\n    scaling: float,\n):\n    batch_size, seq_len, hidden_size = hidden_states.shape\n    num_attention_heads = 40\n    num_key_value_heads = 8\n    head_dim = 128\n    num_key_value_groups = 5\n    \n    # Project Q, K, V\n    query_states = torch.nn.functional.linear(hidden_states, q_proj_weight)\n    key_states = torch.nn.functional.linear(hidden_states, k_proj_weight)\n    value_states = torch.nn.functional.linear(hidden_states, v_proj_weight)\n    \n    # Apply Q normalization (RMS norm)\n    q_fp32 = query_states.to(torch.float32)\n    q_variance = q_fp32.pow(2).mean(-1, keepdim=True)\n    q_normed = q_fp32 * torch.rsqrt(q_variance + rms_norm_eps)\n    query_states = (q_norm_weight * q_normed).to(hidden_states.dtype)\n    \n    # Apply K normalization (RMS norm)\n    k_fp32 = key_states.to(torch.float32)\n    k_variance = k_fp32.pow(2).mean(-1, keepdim=True)\n    k_normed = k_fp32 * torch.rsqrt(k_variance + rms_norm_eps)\n    key_states = (k_norm_weight * k_normed).to(hidden_states.dtype)\n    \n    # Reshape to [batch, num_heads, seq_len, head_dim]\n    query_states = query_states.view(batch_size, seq_len, num_attention_heads, head_dim).transpose(1, 2)\n    key_states = key_states.view(batch_size, seq_len, num_key_value_heads, head_dim).transpose(1, 2)\n    value_states = value_states.view(batch_size, seq_len, num_key_value_heads, head_dim).transpose(1, 2)\n    \n    # Apply YARN RoPE\n    inv_freq_expanded = inv_freq[None, :, None].float().expand(batch_size, -1, 1)\n    position_ids_expanded = position_ids[:, None, :].float()\n    freqs = torch.matmul(inv_freq_expanded, position_ids_expanded).transpose(1, 2)\n    emb = torch.cat((freqs, freqs), dim=-1)\n    cos = (emb.cos() * attention_factor).unsqueeze(1).to(query_states.dtype)\n    sin = (emb.sin() * attention_factor).unsqueeze(1).to(query_states.dtype)\n    \n    # Rotate half helper inline\n    def rotate_half(x):\n        x1 = x[..., : x.shape[-1] // 2]\n        x2 = x[..., x.shape[-1] // 2 :]\n        return torch.cat((-x2, x1), dim=-1)\n    \n    query_states = (query_states * cos) + (rotate_half(query_states) * sin)\n    key_states = (key_states * cos) + (rotate_half(key_states) * sin)\n    \n    # Repeat KV for GQA\n    key_states = key_states[:, :, None, :, :].expand(\n        batch_size, num_key_value_heads, num_key_value_groups, seq_len, head_dim\n    ).reshape(batch_size, num_attention_heads, seq_len, head_dim)\n    value_states = value_states[:, :, None, :, :].expand(\n        batch_size, num_key_value_heads, num_key_value_groups, seq_len, head_dim\n    ).reshape(batch_size, num_attention_heads, seq_len, head_dim)\n    \n    # Compute attention scores\n    attn_weights = torch.matmul(query_states, key_states.transpose(2, 3)) * scaling\n    \n    # Apply attention mask (includes sliding window)\n    attn_weights = attn_weights + attention_mask\n    \n    # Softmax\n    attn_weights = torch.nn.functional.softmax(attn_weights, dim=-1, dtype=torch.float32).to(query_states.dtype)\n    \n    # Compute output\n    attn_output = torch.matmul(attn_weights, value_states)\n    attn_output = attn_output.transpose(1, 2).contiguous()\n    attn_output = attn_output.reshape(batch_size, seq_len, hidden_size)\n    \n    # Output projection\n    output = torch.nn.functional.linear(attn_output, o_proj_weight)\n    \n    return output\n\nDEFINITION\n{\n  \"name\": \"027_grouped_query_attention_with_yarn_rope_and_qk_norm\",\n  \"description\": \"Grouped Query Attention with YARN RoPE scaling and Q/K normalization. 40 query heads, 8 key-value heads (5:1 GQA ratio), head dimension 128, YARN RoPE with 8x scaling for 65536 max positions, sliding window attention 4096 tokens, RMS normalization on Q/K before attention.\",\n  \"hf_id\": \"allenai/Olmo-3-32B-Think\",\n  \"custom_inputs_entrypoint\": \"get_inputs\",\n  \"axes\": {\n    \"batch_size\": {\n      \"type\": \"var\",\n      \"description\": \"Batch size\"\n    },\n    \"seq_len\": {\n      \"type\": \"var\",\n      \"description\": \"Sequence length\"\n    },\n    \"hidden_size\": {\n      \"type\": \"const\",\n      \"value\": 5120,\n      \"description\": \"Hidden dimension\"\n    },\n    \"num_attention_heads\": {\n      \"type\": \"const\",\n      \"value\": 40,\n      \"description\": \"Number of query attention heads\"\n    },\n    \"num_key_value_heads\": {\n      \"type\": \"const\",\n      \"value\": 8,\n      \"description\": \"Number of key-value heads for GQA\"\n    },\n    \"head_dim\": {\n      \"type\": \"const\",\n      \"value\": 128,\n      \"description\": \"Dimension per attention head\"\n    },\n    \"kv_hidden_size\": {\n      \"type\": \"expr\",\n      \"expression\": \"num_key_value_heads * head_dim\",\n      \"description\": \"KV projection output size\"\n    },\n    \"num_key_value_groups\": {\n      \"type\": \"expr\",\n      \"expression\": \"num_attention_heads // num_key_value_heads\",\n      \"description\": \"GQA group ratio\"\n    },\n    \"half_head_dim\": {\n      \"type\": \"expr\",\n      \"expression\": \"head_dim // 2\",\n      \"description\": \"Half of head dimension for RoPE\"\n    }\n  },\n  \"inputs\": {\n    \"hidden_states\": {\n      \"shape\": [\n        \"batch_size\",\n        \"seq_len\",\n        \"hidden_size\"\n      ],\n      \"dtype\": \"bfloat16\",\n      \"description\": \"Input hidden states\"\n    },\n    \"position_ids\": {\n      \"shape\": [\n        \"batch_size\",\n        \"seq_len\"\n      ],\n      \"dtype\": \"int64\",\n      \"description\": \"Position IDs for RoPE\"\n    },\n    \"attention_mask\": {\n      \"shape\": [\n        \"batch_size\",\n        \"1\",\n        \"seq_len\",\n        \"seq_len\"\n      ],\n      \"dtype\": \"bfloat16\",\n      \"description\": \"Attention mask with sliding window\"\n    },\n    \"q_proj_weight\": {\n      \"shape\": [\n        \"hidden_size\",\n        \"hidden_size\"\n      ],\n      \"dtype\": \"bfloat16\",\n      \"description\": \"Query projection weight\"\n    },\n    \"k_proj_weight\": {\n      \"shape\": [\n        \"kv_hidden_size\",\n        \"hidden_size\"\n      ],\n      \"dtype\": \"bfloat16\",\n      \"description\": \"Key projection weight\"\n    },\n    \"v_proj_weight\": {\n      \"shape\": [\n        \"kv_hidden_size\",\n        \"hidden_size\"\n      ],\n      \"dtype\": \"bfloat16\",\n      \"description\": \"Value projection weight\"\n    },\n    \"o_proj_weight\": {\n      \"shape\": [\n        \"hidden_size\",\n        \"hidden_size\"\n      ],\n      \"dtype\": \"bfloat16\",\n      \"description\": \"Output projection weight\"\n    },\n    \"q_norm_weight\": {\n      \"shape\": [\n        \"hidden_size\"\n      ],\n      \"dtype\": \"bfloat16\",\n      \"description\": \"Query RMS norm weight\"\n    },\n    \"k_norm_weight\": {\n      \"shape\": [\n        \"kv_hidden_size\"\n      ],\n      \"dtype\": \"bfloat16\",\n      \"description\": \"Key RMS norm weight\"\n    },\n    \"inv_freq\": {\n      \"shape\": [\n        \"half_head_dim\"\n      ],\n      \"dtype\": \"float32\",\n      \"description\": \"Precomputed YARN RoPE inverse frequencies\"\n    },\n    \"rms_norm_eps\": {\n      \"shape\": null,\n      \"dtype\": \"float32\",\n      \"description\": \"RMS normalization epsilon\"\n    },\n    \"attention_factor\": {\n      \"shape\": null,\n      \"dtype\": \"float32\",\n      \"description\": \"YARN attention scaling factor\"\n    },\n    \"scaling\": {\n      \"shape\": null,\n      \"dtype\": \"float32\",\n      \"description\": \"Attention score scaling (1/sqrt(head_dim))\"\n    }\n  },\n  \"outputs\": {\n    \"output\": {\n      \"shape\": [\n        \"batch_size\",\n        \"seq_len\",\n        \"hidden_size\"\n      ],\n      \"dtype\": \"bfloat16\",\n      \"description\": \"Attention output\"\n    }\n  },\n  \"reference\": \"import torch\\nimport math\\n\\ndef get_inputs(axes_and_scalars: dict, device: torch.device) -> dict:\\n    batch_size = axes_and_scalars[\\\"batch_size\\\"]\\n    seq_len = axes_and_scalars[\\\"seq_len\\\"]\\n    hidden_size = 5120\\n    num_attention_heads = 40\\n    num_key_value_heads = 8\\n    head_dim = 128\\n    kv_hidden_size = num_key_value_heads * head_dim\\n    half_head_dim = head_dim // 2\\n    sliding_window = 4096\\n    \\n    dtype = torch.bfloat16\\n    \\n    hidden_states = torch.randn(batch_size, seq_len, hidden_size, dtype=dtype, device=device)\\n    position_ids = torch.arange(seq_len, dtype=torch.int64, device=device).unsqueeze(0).expand(batch_size, -1)\\n    \\n    # Create sliding window causal mask\\n    mask = torch.full((seq_len, seq_len), float(\\\"-inf\\\"), dtype=dtype, device=device)\\n    mask = torch.triu(mask, diagonal=1)\\n    # Apply sliding window\\n    for i in range(seq_len):\\n        start = max(0, i - sliding_window + 1)\\n        if start > 0:\\n            mask[i, :start] = float(\\\"-inf\\\")\\n    attention_mask = mask.unsqueeze(0).unsqueeze(0).expand(batch_size, 1, seq_len, seq_len)\\n    \\n    q_proj_weight = torch.randn(hidden_size, hidden_size, dtype=dtype, device=device) * 0.02\\n    k_proj_weight = torch.randn(kv_hidden_size, hidden_size, dtype=dtype, device=device) * 0.02\\n    v_proj_weight = torch.randn(kv_hidden_size, hidden_size, dtype=dtype, device=device) * 0.02\\n    o_proj_weight = torch.randn(hidden_size, hidden_size, dtype=dtype, device=device) * 0.02\\n    \\n    q_norm_weight = torch.ones(hidden_size, dtype=dtype, device=device)\\n    k_norm_weight = torch.ones(kv_hidden_size, dtype=dtype, device=device)\\n    \\n    # Compute YARN RoPE inv_freq\\n    rope_theta = 500000.0\\n    rope_scaling_factor = 8.0\\n    beta_fast = 32\\n    beta_slow = 1\\n    original_max_position_embeddings = 8192\\n    \\n    inv_freq_base = 1.0 / (rope_theta ** (torch.arange(0, head_dim, 2, dtype=torch.float32, device=device) / head_dim))\\n    old_context_len = original_max_position_embeddings\\n    low_freq_wavelen = old_context_len / beta_fast\\n    high_freq_wavelen = old_context_len / beta_slow\\n    wavelen = 2 * math.pi / inv_freq_base\\n    smooth_factor = (old_context_len / wavelen - beta_fast) / (beta_slow - beta_fast)\\n    smooth_factor = torch.clamp(smooth_factor, 0.0, 1.0)\\n    inv_freq = (1 - smooth_factor) * (inv_freq_base / rope_scaling_factor) + smooth_factor * inv_freq_base\\n    \\n    rms_norm_eps = 1e-6\\n    attention_factor_val = 1.2079441541679836\\n    scaling_val = head_dim ** -0.5\\n    \\n    return {\\n        \\\"hidden_states\\\": hidden_states,\\n        \\\"position_ids\\\": position_ids,\\n        \\\"attention_mask\\\": attention_mask,\\n        \\\"q_proj_weight\\\": q_proj_weight,\\n        \\\"k_proj_weight\\\": k_proj_weight,\\n        \\\"v_proj_weight\\\": v_proj_weight,\\n        \\\"o_proj_weight\\\": o_proj_weight,\\n        \\\"q_norm_weight\\\": q_norm_weight,\\n        \\\"k_norm_weight\\\": k_norm_weight,\\n        \\\"inv_freq\\\": inv_freq,\\n        \\\"rms_norm_eps\\\": rms_norm_eps,\\n        \\\"attention_factor\\\": attention_factor_val,\\n        \\\"scaling\\\": scaling_val,\\n    }\\n\\n@torch.no_grad()\\ndef run(\\n    hidden_states: torch.Tensor,\\n    position_ids: torch.Tensor,\\n    attention_mask: torch.Tensor,\\n    q_proj_weight: torch.Tensor,\\n    k_proj_weight: torch.Tensor,\\n    v_proj_weight: torch.Tensor,\\n    o_proj_weight: torch.Tensor,\\n    q_norm_weight: torch.Tensor,\\n    k_norm_weight: torch.Tensor,\\n    inv_freq: torch.Tensor,\\n    rms_norm_eps: float,\\n    attention_factor: float,\\n    scaling: float,\\n):\\n    batch_size, seq_len, hidden_size = hidden_states.shape\\n    num_attention_heads = 40\\n    num_key_value_heads = 8\\n    head_dim = 128\\n    num_key_value_groups = 5\\n    \\n    # Project Q, K, V\\n    query_states = torch.nn.functional.linear(hidden_states, q_proj_weight)\\n    key_states = torch.nn.functional.linear(hidden_states, k_proj_weight)\\n    value_states = torch.nn.functional.linear(hidden_states, v_proj_weight)\\n    \\n    # Apply Q normalization (RMS norm)\\n    q_fp32 = query_states.to(torch.float32)\\n    q_variance = q_fp32.pow(2).mean(-1, keepdim=True)\\n    q_normed = q_fp32 * torch.rsqrt(q_variance + rms_norm_eps)\\n    query_states = (q_norm_weight * q_normed).to(hidden_states.dtype)\\n    \\n    # Apply K normalization (RMS norm)\\n    k_fp32 = key_states.to(torch.float32)\\n    k_variance = k_fp32.pow(2).mean(-1, keepdim=True)\\n    k_normed = k_fp32 * torch.rsqrt(k_variance + rms_norm_eps)\\n    key_states = (k_norm_weight * k_normed).to(hidden_states.dtype)\\n    \\n    # Reshape to [batch, num_heads, seq_len, head_dim]\\n    query_states = query_states.view(batch_size, seq_len, num_attention_heads, head_dim).transpose(1, 2)\\n    key_states = key_states.view(batch_size, seq_len, num_key_value_heads, head_dim).transpose(1, 2)\\n    value_states = value_states.view(batch_size, seq_len, num_key_value_heads, head_dim).transpose(1, 2)\\n    \\n    # Apply YARN RoPE\\n    inv_freq_expanded = inv_freq[None, :, None].float().expand(batch_size, -1, 1)\\n    position_ids_expanded = position_ids[:, None, :].float()\\n    freqs = torch.matmul(inv_freq_expanded, position_ids_expanded).transpose(1, 2)\\n    emb = torch.cat((freqs, freqs), dim=-1)\\n    cos = (emb.cos() * attention_factor).unsqueeze(1).to(query_states.dtype)\\n    sin = (emb.sin() * attention_factor).unsqueeze(1).to(query_states.dtype)\\n    \\n    # Rotate half helper inline\\n    def rotate_half(x):\\n        x1 = x[..., : x.shape[-1] // 2]\\n        x2 = x[..., x.shape[-1] // 2 :]\\n        return torch.cat((-x2, x1), dim=-1)\\n    \\n    query_states = (query_states * cos) + (rotate_half(query_states) * sin)\\n    key_states = (key_states * cos) + (rotate_half(key_states) * sin)\\n    \\n    # Repeat KV for GQA\\n    key_states = key_states[:, :, None, :, :].expand(\\n        batch_size, num_key_value_heads, num_key_value_groups, seq_len, head_dim\\n    ).reshape(batch_size, num_attention_heads, seq_len, head_dim)\\n    value_states = value_states[:, :, None, :, :].expand(\\n        batch_size, num_key_value_heads, num_key_value_groups, seq_len, head_dim\\n    ).reshape(batch_size, num_attention_heads, seq_len, head_dim)\\n    \\n    # Compute attention scores\\n    attn_weights = torch.matmul(query_states, key_states.transpose(2, 3)) * scaling\\n    \\n    # Apply attention mask (includes sliding window)\\n    attn_weights = attn_weights + attention_mask\\n    \\n    # Softmax\\n    attn_weights = torch.nn.functional.softmax(attn_weights, dim=-1, dtype=torch.float32).to(query_states.dtype)\\n    \\n    # Compute output\\n    attn_output = torch.matmul(attn_weights, value_states)\\n    attn_output = attn_output.transpose(1, 2).contiguous()\\n    attn_output = attn_output.reshape(batch_size, seq_len, hidden_size)\\n    \\n    # Output projection\\n    output = torch.nn.functional.linear(attn_output, o_proj_weight)\\n    \\n    return output\\n\"\n}\n\nWORKLOADS\n     1\t{\"uuid\": \"40bf5a7e-da47-56be-bf8b-5db663938e00\", \"axes\": {\"batch_size\": 64, \"seq_len\": 128}, \"inputs\": {\"hidden_states\": {\"type\": \"custom\"}, \"position_ids\": {\"type\": \"custom\"}, \"attention_mask\": {\"type\": \"custom\"}, \"q_proj_weight\": {\"type\": \"custom\"}, \"k_proj_weight\": {\"type\": \"custom\"}, \"v_proj_weight\": {\"type\": \"custom\"}, \"o_proj_weight\": {\"type\": \"custom\"}, \"q_norm_weight\": {\"type\": \"custom\"}, \"k_norm_weight\": {\"type\": \"custom\"}, \"inv_freq\": {\"type\": \"custom\"}, \"rms_norm_eps\": {\"type\": \"custom\"}, \"attention_factor\": {\"type\": \"custom\"}, \"scaling\": {\"type\": \"custom\"}}, \"tolerance\": {\"max_atol\": 0.005660867477188714, \"max_rtol\": 0.0078125, \"required_matched_ratio\": 0.99, \"_provenance\": \"max run-to-run error over 10 seeds x 1.25 margin, floored at torch.bfloat16 epsilon\"}}\n     2\t{\"uuid\": \"a889513b-a0f1-537d-985d-e40e3ed56109\", \"axes\": {\"batch_size\": 2, \"seq_len\": 1571}, \"inputs\": {\"hidden_states\": {\"type\": \"custom\"}, \"position_ids\": {\"type\": \"custom\"}, \"attention_mask\": {\"type\": \"custom\"}, \"q_proj_weight\": {\"type\": \"custom\"}, \"k_proj_weight\": {\"type\": \"custom\"}, \"v_proj_weight\": {\"type\