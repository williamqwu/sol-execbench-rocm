{"type":"item.started","item":{"id":"item_9","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch\nimport torch.nn.functional as F\n\ndef bench(fn, n=20):\n    for _ in range(5): fn()\n    torch.cuda.synchronize()\n    a=torch.cuda.Event(enable_timing=True); b=torch.cuda.Event(enable_timing=True)\n    a.record()\n    for _ in range(n): y=fn()\n    b.record(); torch.cuda.synchronize()\n    return a.elapsed_time(b)/n, y\nfor B,S in [(1,997),(1,2048),(4,773),(8,256),(32,128)]:\n    q=torch.randn(B,40,S,128,device='cuda',dtype=torch.bfloat16)\n    k=torch.randn(B,8,S,128,device='cuda',dtype=torch.bfloat16)\n    v=torch.randn(B,8,S,128,device='cuda',dtype=torch.bfloat16)\n    ke=k[:,:,None].expand(B,8,5,S,128).reshape(B,40,S,128)\n    ve=v[:,:,None].expand(B,8,5,S,128).reshape(B,40,S,128)\n    mask=torch.full((S,S),float('-inf'),device='cuda',dtype=torch.bfloat16).triu(1)\n    def eager():\n        p=(q@ke.transpose(-2,-1))*0.08838834764831845\n        p=torch.softmax(p+mask,dim=-1,dtype=torch.float32).to(torch.bfloat16)\n        return p@ve\n    def sdpa_gqa(): return F.scaled_dot_product_attention(q,k,v,is_causal=True,scale=0.08838834764831845,enable_gqa=True)\n    def sdpa_exp(): return F.scaled_dot_product_attention(q,ke,ve,is_causal=True,scale=0.08838834764831845)\n    te,ye=bench(eager,5)\n    tg,yg=bench(sdpa_gqa,10)\n    tx,yx=bench(sdpa_exp,10)\n    d=(yg.float()-ye.float()).abs()\n    print(B,S,'eager',te,'gqa',tg,'exp',tx,'max',d.max().item(),'mean',d.mean().item(),'match.01',(d<.01).float().mean().item())\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
