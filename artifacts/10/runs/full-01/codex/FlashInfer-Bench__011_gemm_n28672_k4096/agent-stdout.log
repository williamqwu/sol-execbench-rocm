{"type":"item.started","item":{"id":"item_22","type":"command_execution","command":"/bin/bash -lc \"PYTHONUNBUFFERED=1 python - <<'PY'\nimport torch, aiter, time\n\ntorch.manual_seed(7)\nN,K=28672,4096\nB=torch.randn((N,K),device='cuda',dtype=torch.float16)\naiter.hipb_create_extension()\nprobe=torch.randn((16,K),device='cuda',dtype=torch.float16)\nsols=aiter.hipb_findallsols(probe,B.T)\nprint('solutions',len(sols),flush=True)\n\ndef evtime(fn, reps=2):\n    s=torch.cuda.Event(enable_timing=True); e=torch.cuda.Event(enable_timing=True)\n    s.record()\n    for _ in range(reps): fn()\n    e.record(); e.synchronize()\n    return s.elapsed_time(e)/reps\n\nfor M in [1,8,16,32,64,128,256,972,2053,2379,8192]:\n    A=torch.randn((M,K),device='cuda',dtype=torch.float16)\n    # Stabilize clocks and establish the library baseline.\n    for _ in range(5): torch.matmul(A,B.T)\n    torch.cuda.synchronize()\n    base=evtime(lambda: torch.matmul(A,B.T),5)\n    vals=[]\n    t0=time.time()\n    for i,sol in enumerate(sols):\n        try:\n            aiter.hipb_mm(A,B.T,sol)\n            ms=evtime(lambda sol=sol: aiter.hipb_mm(A,B.T,sol),2)\n            vals.append((ms,sol))\n        except Exception:\n            pass\n    vals.sort()\n    top=' '.join(f'{sol}:{ms:.4f}' for ms,sol in vals[:12])\n    print(f'M={M} torch={base:.4f} tested={len(vals)} wall={time.time()-t0:.1f}s top {top}',flush=True)\naiter.hipb_destroy_extension()\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
