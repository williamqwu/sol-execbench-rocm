{"type":"item.started","item":{"id":"item_42","type":"command_execution","command":"/bin/bash -lc \"PYTHONUNBUFFERED=1 python - <<'PY'\nimport torch,aiter,importlib,statistics,time\nN,K=28672,4096\nMs=[256,248,240,232,224,216,208,200,192,184,176,168,160,152,144,136,128,120,112,104,96,88,80,72,64,56,48,40,32,24,16,8,4,2,1,7,35,70,15]\nB=torch.randn((N,K),device='cuda',dtype=torch.float16)\nflush=torch.empty((134217728,),device='cuda',dtype=torch.float32)\naiter.rocb_create_extension(); roc=importlib.import_module('aiter.jit.module_rocsolgemm')\nprobe=torch.randn((16,K),device='cuda',dtype=torch.float16)\nsols=roc.rocb_findallsols(probe,B.T)\nprint('solutions',len(sols),flush=True)\n\ndef batch_times(fns):\n ev=[]\n for fn in fns:\n  flush.add_(1)\n  s=torch.cuda.Event(enable_timing=True);e=torch.cuda.Event(enable_timing=True)\n  s.record();fn();e.record();ev.append((s,e))\n ev[-1][1].synchronize()\n return [s.elapsed_time(e) for s,e in ev]\n\nmapping={}\nfor M in Ms:\n t0=time.time(); A=torch.randn((M,K),device='cuda',dtype=torch.float16)\n # One cold observation of every supported solution, retaining a broad set.\n coarse=batch_times([lambda sol=sol:roc.rocb_mm(A,B.T,sol) for sol in sols])\n candidates=[sol for _,sol in sorted(zip(coarse,sols))[:60]]\n # Interleave seven cold observations of each candidate and the torch default.\n tagged=[];fns=[]\n for rep in range(7):\n  for sol in candidates:\n   tagged.append(sol);fns.append(lambda sol=sol:roc.rocb_mm(A,B.T,sol))\n  tagged.append(-1);fns.append(lambda:A@B.T)\n measured=batch_times(fns)\n by={sol:[] for sol in candidates};by[-1]=[]\n for sol,ms in zip(tagged,measured):by[sol].append(ms)\n vals=sorted((statistics.median(v),sol,min(v)) for sol,v in by.items())\n best,win,mn=vals[0]; base=statistics.median(by[-1])\n if win == -1 or best > base*0.985: win=-1;best=base\n mapping[M]=win\n top=' '.join(f'{s}:{med:.4f}' for med,s,mn in vals[:5])\n print(f'M={M:4d} torch={base:.4f} win={win} med={best:.4f} speed={base/best:.3f} wall={time.time()-t0:.1f}s top {top}',flush=True)\nprint('MAPPING',mapping,flush=True)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
