{"type":"item.started","item":{"id":"item_33","type":"command_execution","command":"/bin/bash -lc \"PYTHONUNBUFFERED=1 python - <<'PY'\nimport torch,aiter,statistics\nN,K=28672,4096\nB=torch.randn((N,K),device='cuda',dtype=torch.float16)\nflush=torch.empty((134217728,),device='cuda',dtype=torch.float32)\naiter.hipb_create_extension()\nsolsets={\n1:[477419,477461,477227,476584,476585,476583,477480,477479],\n16:[477461,477419,477364,477455,477460,476584,476585,476583],\n64:[477418,477413,477363,476634,476624,476584,476585,476583],\n128:[476643,476639,477416,476626,476658,476584,476585,476583],\n256:[477337,477103,476650,476651,476869,476584,476585,476583],\n}\ndef cold(fn,reps=12):\n ss=[];es=[]\n for _ in range(reps):\n  flush.add_(1)\n  s=torch.cuda.Event(enable_timing=True);e=torch.cuda.Event(enable_timing=True)\n  s.record();fn();e.record();ss.append(s);es.append(e)\n es[-1].synchronize()\n return statistics.median(s.elapsed_time(e) for s,e in zip(ss,es))\nfor M,sols in solsets.items():\n A=torch.randn((M,K),device='cuda',dtype=torch.float16)\n vals=[(cold(lambda:A@B.T), 'torch')]\n for sol in sols:\n  vals.append((cold(lambda sol=sol:aiter.hipb_mm(A,B.T,sol)),str(sol)))\n vals.sort()\n print('M',M,' '.join(f'{name}:{ms:.4f}' for ms,name in vals),flush=True)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
