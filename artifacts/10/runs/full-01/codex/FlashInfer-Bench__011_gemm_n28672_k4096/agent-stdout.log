{"type":"item.started","item":{"id":"item_14","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch, triton\nimport kernel\n\ntorch.manual_seed(1)\nB=torch.randn((28672,4096),device='cuda',dtype=torch.float16)\nfor M in [1,2,4,7,8,15,16,24,32,35,64,70,128,256]:\n A=torch.randn((M,4096),device='cuda',dtype=torch.float16)\n ref=torch.matmul(A,B.T)\n y=kernel.run(A,B)\n torch.cuda.synchronize()\n d=(y-ref).abs()\n tol=.0362 + ref.abs()*.0009765625\n ratio=(d<=tol).float().mean().item()\n mx=d.max().item()\n t=triton.testing.do_bench(lambda: kernel.run(A,B),warmup=20,rep=100)\n tr=triton.testing.do_bench(lambda: torch.matmul(A,B.T),warmup=20,rep=100)\n print(f'M={M:3d} custom={t:.4f} torch={tr:.4f} speed={tr/t:.3f} max={mx:.5f} ratio={ratio:.6f}')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
