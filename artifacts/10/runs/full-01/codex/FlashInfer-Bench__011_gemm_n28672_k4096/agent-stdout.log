{"type":"item.started","item":{"id":"item_49","type":"command_execution","command":"/bin/bash -lc \"PYTHONUNBUFFERED=1 python - <<'PY'\nimport torch,aiter,importlib,statistics,time\nN,K=28672,4096\nB=torch.randn((N,K),device='cuda',dtype=torch.float16)\nflush=torch.empty((134217728,),device='cuda',dtype=torch.float32)\naiter.rocb_create_extension();roc=importlib.import_module('aiter.jit.module_rocsolgemm')\nprobe=torch.randn((16,K),device='cuda',dtype=torch.float16);sols=roc.rocb_findallsols(probe,B.T)\ndef batch(fns):\n ev=[]\n for fn in fns:\n  flush.add_(1);s=torch.cuda.Event(enable_timing=True);e=torch.cuda.Event(enable_timing=True);s.record();fn();e.record();ev.append((s,e))\n ev[-1][1].synchronize();return [s.elapsed_time(e) for s,e in ev]\nfor M in [972,2053,2379,8192]:\n A=torch.randn((M,K),device='cuda',dtype=torch.float16);t=time.time()\n coarse=batch([lambda sol=sol:roc.rocb_mm(A,B.T,sol) for sol in sols])\n cs=[sol for _,sol in sorted(zip(coarse,sols))[:40]]\n tags=[];fs=[]\n for _ in range(5):\n  for sol in cs:tags.append(sol);fs.append(lambda sol=sol:roc.rocb_mm(A,B.T,sol))\n  tags.append(-1);fs.append(lambda:A@B.T)\n ts=batch(fs);by={x:[] for x in cs};by[-1]=[]\n for x,v in zip(tags,ts):by[x].append(v)\n vals=sorted((statistics.median(v),x) for x,v in by.items())\n print('M',M,'wall',time.time()-t,'top',' '.join(f'{x}:{v:.4f}' for v,x in vals[:12]),flush=True)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
