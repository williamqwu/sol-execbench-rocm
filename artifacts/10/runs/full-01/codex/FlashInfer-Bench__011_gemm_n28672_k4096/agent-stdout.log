{"type":"item.started","item":{"id":"item_25","type":"command_execution","command":"/bin/bash -lc \"PYTHONUNBUFFERED=1 python - <<'PY'\nimport torch,aiter,statistics\nN,K=28672,4096\ncands=[477480,477479,476714,477325,477091,476736,476717,476719,476857,477099,477333,476666,476749,476693,476750,476747,476720,476751,476736,477325]\nB=torch.randn((N,K),device='cuda',dtype=torch.float16)\naiter.hipb_create_extension()\ndef tm(fn,reps):\n s=torch.cuda.Event(enable_timing=True);e=torch.cuda.Event(enable_timing=True);s.record()\n for _ in range(reps):fn()\n e.record();e.synchronize();return s.elapsed_time(e)/reps\nfor M in [972,2053,2379,8192]:\n A=torch.randn((M,K),device='cuda',dtype=torch.float16)\n for _ in range(5): A@B.T\n torch.cuda.synchronize()\n base=statistics.median(tm(lambda:A@B.T,20) for _ in range(5))\n vals=[]\n for sol in sorted(set(cands)):\n  ts=[tm(lambda sol=sol:aiter.hipb_mm(A,B.T,sol),20) for _ in range(5)]\n  vals.append((statistics.median(ts),min(ts),sol))\n vals.sort()\n print('M',M,'torch',base,'top',' '.join(f'{s}:{med:.4f}/{mn:.4f}' for med,mn,s in vals[:10]),flush=True)\naiter.hipb_destroy_extension()\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
