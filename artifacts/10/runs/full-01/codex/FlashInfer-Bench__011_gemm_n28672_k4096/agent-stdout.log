{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"printf '%s\\\\n' '-- definition.json --' && sed -n '1,260p' definition.json && printf '%s\\\\n' '-- reference.py --' && sed -n '1,320p' reference.py && printf '%s\\\\n' '-- workload.jsonl --' && sed -n '1,260p' workload.jsonl\"","aggregated_output":"-- definition.json --\n{\n  \"name\": \"011_gemm_n28672_k4096\",\n  \"description\": \"General matrix multiply (GEMM) C = A @ B.T. Captured from Llama 3.1 8B mlp.gate_up_proj.\",\n  \"hf_id\": null,\n  \"custom_inputs_entrypoint\": null,\n  \"axes\": {\n    \"M\": {\n      \"type\": \"var\"\n    },\n    \"N\": {\n      \"type\": \"const\",\n      \"value\": 28672\n    },\n    \"K\": {\n      \"type\": \"const\",\n      \"value\": 4096\n    }\n  },\n  \"inputs\": {\n    \"A\": {\n      \"shape\": [\n        \"M\",\n        \"K\"\n      ],\n      \"dtype\": \"float16\"\n    },\n    \"B\": {\n      \"shape\": [\n        \"N\",\n        \"K\"\n      ],\n      \"dtype\": \"float16\"\n    }\n  },\n  \"outputs\": {\n    \"C\": {\n      \"shape\": [\n        \"M\",\n        \"N\"\n      ],\n      \"dtype\": \"float16\"\n    }\n  },\n  \"reference\": \"import torch\\n\\ndef run(A, B):\\n    C = torch.matmul(A, B.T)\\n    return C\"\n}\n-- reference.py --\nimport torch\n\ndef run(A, B):\n    C = torch.matmul(A, B.T)\n    return C-- workload.jsonl --\n{\"uuid\": \"181e4a1e-6dec-4bca-8a21-703c35d0762a\", \"axes\": {\"M\": 256}, \"inputs\": {\"A\": {\"type\": \"random\"}, \"B\": {\"type\": \"random\"}}, \"tolerance\": {\"max_atol\": 0.0359961294835565, \"max_rtol\": 0.0009765625, \"required_matched_ratio\": 0.99, \"_provenance\": \"max run-to-run error over 10 seeds x 1.25 margin, floored at torch.float16 epsilon\"}}\n{\"uuid\": \"4723ac5c-205a-454d-9318-2ea368b0a57d\", \"axes\": {\"M\": 248}, \"inputs\": {\"A\": {\"type\": \"random\"}, \"B\": {\"type\": \"random\"}}, \"tolerance\": {\"max_atol\": 0.03599351440718477, \"max_rtol\": 0.