{"type":"item.completed","item":{"id":"item_21","type":"command_execution","command":"/bin/bash -lc \"nl -ba kernel.py | sed -n '1,180p'\"","aggregated_output":"     1\timport torch\n     2\timport triton\n     3\timport triton.language as tl\n     4\t\n     5\t\n     6\t@triton.jit\n     7\tdef _rope_kernel(\n     8\t    query,\n     9\t    key,\n    10\t    cos,\n    11\t    sin,\n    12\t    query_out,\n    13\t    key_out,\n    14\t    NUM_QUERY_HEADS: tl.constexpr,\n    15\t    NUM_KEY_HEADS: tl.constexpr,\n    16\t    NUM_QUERY_GROUPS: tl.constexpr,\n    17\t    GROUP_SIZE: tl.constexpr,\n    18\t    SEQ_LEN: tl.constexpr,\n    19\t):\n    20\t    batch_pos = tl.program_id(0)\n    21\t    head_group = tl.program_id(1)\n    22\t    d = tl.arange(0, 64)\n    23\t    batch = batch_pos // SEQ_LEN\n    24\t    pos = batch_pos % SEQ_LEN\n    25\t    rope_base = pos * 128\n    26\t    c0 = tl.load(cos + rope_base + d)\n    27\t    c1 = tl.load(cos + rope_base + 64 + d)\n    28\t    s0 = tl.load(sin + rope_base + d)\n    29\t    s1 = tl.load(sin + rope_base + 64 + d)\n    30\t\n    31\t    if head_group < NUM_QUERY_GROUPS:\n    32\t        first_head = head_group * GROUP_SIZE\n    33\t        for i in tl.static_range(0, GROUP_SIZE):\n    34\t            head = first_head + i\n    35\t            valid = head < NUM_QUERY_HEADS\n    36\t            row = (batch * NUM_QUERY_HEADS + head) * SEQ_LEN + pos\n    37\t            x_base = query + row * 128\n    38\t            out_base = query_out + row * 128\n    39\t            x0 = tl.load(x_base + d, mask=valid)\n    40\t            x1 = tl.load(x_base + 64 + d, mask=valid)\n    41\t            y0 = x0 * c0 + (-x1) * s0\n    42\t            y1 = x1 * c1 + x0 * s1\n    43\t            tl.store(out_base + d, y0, mask=valid)\n    44\t            tl.store(out_base + 64 + d, y1, mask=valid)\n    45\t\n    46\t\n    47\t@triton.jit\n    48\tdef _rope_flat_kernel(\n    49\t    query,\n    50\t    key,\n    51\t    cos,\n    52\t    sin,\n    53\t    query_out,\n    54\t    key_out,\n    55\t    NUM_QUERY_GROUPS: tl.constexpr,\n    56\t    SEQ_LEN: tl.constexpr,\n    57\t):\n    58\t    pos = tl.program_id(0)\n    59\t    row_group = tl.program_id(1)\n    60\t    d = tl.arange(0, 64)\n    61\t\n    62\t    rope_base = pos * 128\n    63\t    c0 = tl.load(cos + rope_base + d)\n    64\t    c1 = tl.load(cos + rope_base + 64 + d)\n    65\t    s0 = tl.load(sin + rope_base + d)\n    66\t    s1 = tl.load(sin + rope_base + 64 + d)\n    67\t\n    68\t    if row_group < NUM_QUERY_GROUPS:\n    69\t        first_row = row_group * 4\n    70\t        for i in tl.static_range(0, 4):\n    71\t            row = first_row + i\n    72\t            offset = (row * SEQ_LEN + pos) * 128\n    73\t            x0 = tl.load(query + offset + d)\n    74\t            x1 = tl.load(query + offset + 64 + d)\n    75\t            y0 = x0 * c0 + (-x1) * s0\n    76\t            y1 = x1 * c1 + x0 * s1\n    77\t            tl.store(query_out + offset + d, y0)\n    78\t            tl.store(query_out + offset + 64 + d, y1)\n    79\t    else:\n    80\t        first_row = (row_group - NUM_QUERY_GROUPS) * 4\n    81\t        for i in tl.static_range(0, 4):\n    82\t            row = first_row + i\n    83\t            offset = (row * SEQ_LEN + pos) * 128\n    84\t            x0 = tl.load(key + offset + d)\n    85\t            x1 = tl.load(key + offset + 64 + d)\n    86\t            y0 = x0 * c0 + (-x1) * s0\n    87\t            y1 = x1 * c1 + x0 * s1\n    88\t            tl.store(key_out + offset + d, y0)\n    89\t            tl.store(key_out + offset + 64 + d, y1)\n    90\t    else:\n    91\t        first_key_head = (head_group - NUM_QUERY_GROUPS) * GROUP_SIZE\n    92\t        for i in tl.static_range(0, GROUP_SIZE):\n    93\t            key_head = first_key_head + i\n    94\t            valid = key_head < NUM_KEY_HEADS\n    95\t            row = (batch * NUM_KEY_HEADS + key_head) * SEQ_LEN + pos\n    96\t            x_base = key + row