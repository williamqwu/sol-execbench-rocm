{"type":"item.started","item":{"id":"item_17","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch\nimport triton\nimport kernel\n\n\ndef bench_shape(B, H, K, S):\n    D = 128\n    q = torch.empty((B,H,S,D), device='cuda', dtype=torch.float32)\n    k = torch.empty((B,K,S,D), device='cuda', dtype=torch.float32)\n    c = torch.empty((S,D), device='cuda', dtype=torch.float32)\n    s = torch.empty((S,D), device='cuda', dtype=torch.float32)\n    oq = torch.empty_like(q)\n    ok = torch.empty_like(k)\n    print('shape', B,H,K,S)\n    for g in (2,4,8,16):\n        qg = triton.cdiv(H,g)\n        kg = triton.cdiv(K,g)\n        def call():\n            kernel._rope_kernel[(B*S,qg+kg)](\n                q,k,c,s,oq,ok,\n                NUM_QUERY_HEADS=H,\n                NUM_KEY_HEADS=K,\n                NUM_QUERY_GROUPS=qg,\n                GROUP_SIZE=g,\n                SEQ_LEN=S,\n                num_warps=1,\n            )\n        call()\n        torch.cuda.synchronize()\n        ms = triton.testing.do_bench(call, warmup=20, rep=100)\n        print(g, f'{ms:.6f}')\n    del q,k,c,s,oq,ok\n\nfor shape in [\n    (1,8,8,128),\n    (1,40,8,131),\n    (8,24,8,1024),\n    (1,64,8,8192),\n    (32,16,4,4096),\n]:\n    bench_shape(*shape)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
