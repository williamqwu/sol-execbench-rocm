{"type":"item.started","item":{"id":"item_15","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport math, torch, triton\nimport kernel\n\nfor kind in ('normal', 'uniform'):\n    n = 8 << 20\n    x = torch.randn(n, device='cuda') if kind == 'normal' else torch.rand(n, device='cuda') * 2 - 1\n    ref = 0.5 * x * (1.0 + torch.tanh(math.sqrt(2.0 / math.pi) * (x + 0.044715 * (x * x * x))))\n    print(kind)\n    for fn in (kernel._gelu_kernel, kernel._gelu_fast_kernel):\n        out = torch.empty_like(x)\n        fn[(triton.cdiv(n, 1024),)](x, out, n, BLOCK_SIZE=1024, num_warps=4)\n        torch.cuda.synchronize()\n        diff = (out-ref).abs()\n        ratio = torch.isclose(out, ref, atol=7.77e-8, rtol=1.1920928955078125e-7).float().mean()\n        print(fn.fn.__name__, 'ratio', ratio.item(), 'max', diff.max().item(), 'mean', diff.mean().item())\n\nn = 128 << 20\nx = torch.randn(n, device='cuda')\nout = torch.empty_like(x)\nfor fn in (kernel._gelu_kernel, kernel._gelu_fast_kernel):\n    for block, warps in ((512,2),(1024,2),(1024,4),(2048,4),(4096,8)):\n        grid=(triton.cdiv(n,block),)\n        for _ in range(4): fn[grid](x,out,n,BLOCK_SIZE=block,num_warps=warps)\n        torch.cuda.synchronize()\n        a=torch.cuda.Event(enable_timing=True); b=torch.cuda.Event(enable_timing=True)\n        a.record()\n        for _ in range(30): fn[grid](x,out,n,BLOCK_SIZE=block,num_warps=warps)\n        b.record(); b.synchronize()\n        print(fn.fn.__name__, block, warps, a.elapsed_time(b)/30)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
