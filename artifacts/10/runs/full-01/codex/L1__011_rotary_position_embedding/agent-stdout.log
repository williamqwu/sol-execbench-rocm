{"type":"item.started","item":{"id":"item_29","type":"command_execution","command":"/bin/bash -lc \"python -c '\nimport numpy as np\nfrom scipy.optimize import linprog\nL=np.pi/2\nx=np.linspace(0,L,20001)\nfor kind, powers in [(\\\"sin3\\\",[1,3]),(\\\"sin5\\\",[1,3,5]),(\\\"cos2\\\",[0,2]),(\\\"cos4\\\",[0,2,4])]:\n f=np.sin(x) if kind.startswith(\\\"sin\\\") else np.cos(x)\n A=np.stack([x**p for p in powers],axis=1)\n # A c - f <= e ; f - A c <= e\n Aub=np.vstack([np.c_[A,-np.ones(len(x))],np.c_[-A,-np.ones(len(x))]])\n bub=np.r_[f,-f]\n c=np.r_[np.zeros(len(powers)),1.0]\n res=linprog(c,A_ub=Aub,b_ub=bub,bounds=[(None,None)]*len(powers)+[(0,None)],method=\\\"highs\\\")\n coef=res.x[:-1]; err=np.max(np.abs(A@coef-f))\n print(kind,coef,\\\"err\\\",err,\\\"at\\\",x[np.argmax(np.abs(A@coef-f))])\n'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
