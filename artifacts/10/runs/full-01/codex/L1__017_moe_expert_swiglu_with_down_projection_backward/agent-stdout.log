{"type":"item.started","item":{"id":"item_47","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch,triton\nfrom reference import gen_inputs\nimport kernel\ns=torch.cuda.Stream()\ndef par(g,x,gw,uw,dw,gate,sig,silu,up,inter):\n m=g.shape[0]; res=m<=128; pw=3072 if res else 1536; small=m<=8\n gp=torch.empty((m,pw),device='cuda',dtype=torch.bfloat16); wp=torch.empty((pw,2048),device='cuda',dtype=torch.bfloat16); nw=pw*2048\n cur=torch.cuda.current_stream(); s.wait_stream(cur)\n with torch.cuda.stream(s):\n  kernel._pack_weights[(triton.cdiv(nw,2048),)](gw,uw,wp,n_elements=nw,BLOCK=2048,num_warps=4)\n if not small: gdw=torch.mm(g.t(),inter)\n di=torch.mm(g,dw,out_dtype=torch.float32); n=m*768\n kernel._activation_bwd[(triton.cdiv(n,2048),)](di,gate,sig,silu,up,gp,n_elements=n,PAIR_WIDTH=pw,WITH_RESIDUAL=res,BLOCK=2048,num_warps=4)\n if small:\n  gdw=torch.empty((2048,768),device='cuda',dtype=torch.bfloat16); gws=torch.empty((1536,2048),device='cuda',dtype=torch.bfloat16); total=3*2048*768\n  kernel._small_weight_grads[(triton.cdiv(total,2048),)](g,x,inter,gp,gdw,gws,M=m,PAIR_WIDTH=pw,BLOCK=2048,num_warps=4)\n else: gws=torch.mm(gp[:,:1536].t(),x)\n cur.wait_stream(s); wp.record_stream(cur)\n gx=torch.mm(gp,wp)\n return gx,gws[:768],gws[768:],gdw\nfor m in [1,2,8,16,128,512,1321,4093,8192]:\n d=gen_inputs({'num_tokens':m},'cuda'); a=tuple(d.values()); par(*a); kernel.run(*a);torch.cuda.synchronize()\n tp=triton.testing.do_bench(lambda:par(*a),warmup=20,rep=100 if m<1000 else 50)\n tb=triton.testing.do_bench(lambda:kernel.run(*a),warmup=20,rep=100 if m<1000 else 50)\n print(m,round(tp,4),round(tb,4))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
