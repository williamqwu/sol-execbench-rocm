{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"cat definition.json && printf '\\\\nREFERENCE\\\\n' && sed -n '1,260p' reference.py && printf '\\\\nWORKLOADS\\\\n' && cat workload.jsonl\"","aggregated_output":"{\n  \"name\": \"017_moe_expert_swiglu_with_down_projection_backward\",\n  \"description\": \"Backward pass for MoE expert SwiGLU with down projection. Computes gradients through the complete expert MLP chain: down_proj <- SwiGLU <- [gate_proj, up_proj]. Returns gradients for input x and all three weight matrices (gate, up, down).\",\n  \"hf_id\": \"Qwen/Qwen3-30B-A3B-Instruct-2507\",\n  \"custom_inputs_entrypoint\": \"gen_inputs\",\n  \"axes\": {\n    \"num_tokens\": {\n      \"type\": \"var\"\n    },\n    \"hidden_size\": {\n      \"type\": \"const\",\n      \"value\": 2048\n    },\n    \"intermediate_size\": {\n      \"type\": \"const\",\n      \"value\": 768\n    }\n  },\n  \"inputs\": {\n    \"grad_output\": {\n      \"shape\": [\n        \"num_tokens\",\n        \"hidden_size\"\n      ],\n      \"dtype\": \"bfloat16\",\n      \"description\": \"Gradient of loss w.r.t. output\"\n    },\n    \"x\": {\n      \"shape\": [\n        \"num_tokens\",\n        \"hidden_size\"\n      ],\n      \"dtype\": \"bfloat16\",\n      \"description\": \"Input tensor saved from forward pass\"\n    },\n    \"gate_weight\": {\n      \"shape\": [\n        \"intermediate_size\",\n        \"hidden_size\"\n      ],\n      \"dtype\": \"bfloat16\",\n      \"description\": \"Gate projection weight matrix\"\n    },\n    \"up_weight\": {\n      \"shape\": [\n        \"intermediate_size\",\n        \"hidden_size\"\n      ],\n      \"dtype\": \"bfloat16\",\n      \"description\": \"Up projection weight matrix\"\n    },\n    \"down_weight\": {\n      \"shape\": [\n        \"hidden_size\",\n        \"intermediate_size\"\n      ],\n      \"dtype\": \"bfloat16\",\n      \"description\": \"Down projection weight matrix\"\n    },\n    \"gate\": {\n      \"shape\": [\n        \"num_tokens\",\n        \"intermediate_size\"\n      ],\n      \"dtype\": \"bfloat16\",\n      \"description\": \"Gate projection output saved from forward pass\"\n    },\n    \"gate_sigmoid\": {\n      \"shape\": [\n        \"num_tokens\",\n        \"intermediate_size\"\n      ],\n      \"dtype\": \"bfloat16\",\n      \"description\": \"Sigmoid of gate saved from forward pass\"\n    },\n    \"gate_silu\": {\n      \"shape\": [\n        \"num_tokens\",\n        \"intermediate_size\"\n      ],\n      \"dtype\": \"bfloat16\",\n      \"description\": \"SiLU activation of gate saved from forward pass\"\n    },\n    \"up\": {\n      \"shape\": [\n        \"num_tokens\",\n        \"intermediate_size\"\n      ],\n      \"dtype\": \"bfloat16\",\n      \"description\": \"Up projection output saved from forward pass\"\n    },\n    \"intermediate\": {\n      \"shape\": [\n        \"num_tokens\",\n        \"intermediate_size\"\n      ],\n      \"dtype\": \"bfloat16\",\n      \"description\": \"SwiGLU output (gate_silu * up) saved from forward pass\"\n    }\n  },\n  \"outputs\": {\n    \"grad_x\": {\n      \"shape\": [\n        \"num_tokens\",\n        \"hidden_size\"\n      ],\n      \"dtype\": \"bfloat16\",\n      \"description\": \"Gradient w.r.t. input x\"\n    },\n    \"grad_gate_weight\": {\n      \"shape\": [\n        \"intermediate_size\",\n        \"hidden_size\"\n      ],\n      \"dtype\": \"bfloat16\",\n      \"description\": \"Gradient w.r.t. gate projection weight\"\n    },\n    \"grad_up_weight\": {\n      \"shape\": [\n        \"intermediate_size\",\n        \"hidden_size\"\n      ],\n      \"dtype\": \"bfloat16\",\n      \"description\": \"Gradient w.r.t. up projection weight\"\n    },\n    \"grad_down_weight\": {\n      \"shape\": [\n        \"hidden_size\",\n        \"intermediate_size\"\n      ],\n      \"dtype\": \"bfloat16\",\n      \"description\": \"Gradient w.r.t. down projection weight\"\n    }\n  },\n  \"reference\": \"import torch\\nimport torch.nn.functional as F\\nimport math\\n\\n\\ndef gen_inputs(axes_and_scalars, device):\\n    num_tokens = axes_and_scalars['num_tokens']\\n    hidden_size = 2048\\n    intermediate_size = 768\\n\\n    # Xavier-scaled weights\\n    gate_weight = torch.randn(intermediate_size, hidden_size, dtype=torch.bfloat16, device=device) / math.sqrt(hidden_size)\\n    up_weight = torch.randn(intermediate_size, hidden_size, dtype=torch.bfloat16, device=device) / math.sqrt(hidden_size)\\n    down_weight = torch.randn(hidden_size, intermediate_size, dtype=torch.bfloat16, device=device) / math.sqrt(intermediate_size)\\n\\n    # Activation-scale input\\n    x = torch.randn(num_tokens, hidden_size, dtype=torch.bfloat16, device=device) / math.sqrt(hidden_size)\\n\\n    # Run forward pass to produce consistent saved tensors\\n    with torch.no_grad():\\n        gate = F.linear(x, gate_weight)\\n        gate_sigmoid = torch.sigmoid(gate.to(torch.float32)).to(torch.bfloat16)\\n        gate_silu = gate * gate_sigmoid\\n        up = F.linear(x, up_weight)\\n        intermediate = gate_silu * up\\n\\n    # Small-magnitude upstream gradient\\n    grad_output = torch.randn(num_tokens, hidden_size, dtype=torch.bfloat16, device=device) / math.sqrt(hidden_size)\\n\\n    return {\\n        'grad_output': grad_output,\\n        'x': x,\\n        'gate_weight': gate_weight,\\n        'up_weight': up_weight,\\n        'down_weight': down_weight,\\n        'gate': gate,\\n        'gate_sigmoid': gate_sigmoid,\\n        'gate_silu': gate_silu,\\n        'up': up,\\n        'intermediate': intermediate,\\n    }\\n\\n\\n@torch.no_grad()\\ndef run(\\n    grad_output: torch.Tensor,\\n    x: torch.Tensor,\\n    gate_weight: torch.Tensor,\\n    up_weight: torch.Tensor,\\n    down_weight: torch.Tensor,\\n    gate: torch.Tensor,\\n    gate_sigmoid: torch.Tensor,\\n    gate_silu: torch.Tensor,\\n    up: torch.Tensor,\\n    intermediate: torch.Tensor,\\n):\\n    # Convert to float32 for numerical stability\\n    grad_output_f32 = grad_output.to(torch.float32)\\n    x_f32 = x.to(torch.float32)\\n    gate_weight_f32 = gate_weight.to(torch.float32)\\n    up_weight_f32 = up_weight.to(torch.float32)\\n    down_weight_f32 = down_weight.to(torch.float32)\\n    gate_f32 = gate.to(torch.float32)\\n    gate_sigmoid_f32 = gate_sigmoid.to(torch.float32)\\n    gate_silu_f32 = gate_silu.to(torch.float32)\\n    up_f32 = up.to(torch.float32)\\n    intermediate_f32 = intermediate.to(torch.float32)\\n    \\n    # Gradient w.r.t. down_weight\\n    # down_proj: output = intermediate @ down_weight.T\\n    # grad_down_weight = grad_output.T @ intermediate\\n    grad_down_weight = grad_output_f32.t().mm(intermediate_f32)\\n    \\n    # Gradient w.r.t. intermediate\\n    grad_intermediate = grad_output_f32.mm(down_weight_f32)\\n    \\n    # Gradient w.r.t. gate_silu and up (element-wise multiplication)\\n    # intermediate = gate_silu * up\\n    grad_gate_silu = grad_intermediate * up_f32\\n    grad_up = grad_intermediate * gate_silu_f32\\n    \\n    # Gradient w.r.t. gate (through SiLU activation)\\n    # gate_silu = gate * sigmoid(gate)\\n    # d(gate_silu)/d(gate) = sigmoid(gate) * (1 + gate * (1 - sigmoid(gate)))\\n    grad_gate = grad_gate_silu * gate_sigmoid_f32 * (1.0 + gate_f32 * (1.0 - gate_sigmoid_f32))\\n    \\n    # Gradient w.r.t. up_weight\\n    # up_proj: up = x @ up_weight.T\\n    # grad_up_weight = grad_up.T @ x\\n    grad_up_weight = grad_up.t().mm(x_f32)\\n    \\n    # Gradient w.r.t. gate_weight\\n    # gate_proj: gate = x @ gate_weight.T\\n    # grad_gate_weight = grad_gate.T @ x\\n    grad_gate_weight = grad_gate.t().mm(x_f32)\\n    \\n    # Gradient w.r.t. x (input)\\n    # Accumulate gradients from both gate and up projections\\n    grad_x = grad_gate.mm(gate_weight_f32) + grad_up.mm(up_weight_f32)\\n    \\n    return (\\n        grad_x.to(torch.bfloat16),\\n        grad_gate_weight.to(torch.bfloat16),\\n        grad_up_weight.to(torch.bfloat16),\\n        grad_down_weight.to(torch.bfloat16),\\n    )\\n\"\n}\n\nREFERENCE\nimport torch\nimport torch.nn.functional as F\nimport math\n\n\ndef gen_inputs(axes_and_scalars, device):\n    num_tokens = axes_and_scalars['num_tokens']\n    hidden_size = 2048\n    intermediate_size = 768\n\n    # Xavier-scaled weights\n    gate_weight = torch.randn(intermediate_size, hidden_size, dtype=torch.bfloat16, device=device) / math.sqrt(hidden_size)\n    up_weight = torch.randn(intermediate_size, hidden_size, dtype=torch.bfloat16, device=device) / math.sqrt(hidden_size)\n    down_weight = torch.randn(hidden_size, intermediate_size, dtype=torch.bfloat16, device=device) / math.sqrt(intermediate_size)\n\n    # Activation-scale input\n    x = torch.randn(num_tokens, hidden_size, dtype=torch.bfloat16, device=device) / math.sqrt(hidden_size)\n\n    # Run forward pass to produce consistent saved tensors\n    with torch.no_grad():\n        gate = F.linear(x, gate_weight)\n        gate_sigmoid = torch.sigmoid(gate.to(torch.float32)).to(torch.bfloat16)\n        gate_silu = gate * gate_sigmoid\n        up = F.linear(x, up_weight)\n        intermediate = gate_silu * up\n\n    # Small-magnitude upstream gradient\n    grad_output = torch.randn(num_tokens, hidden_size, dtype=torch.bfloat16, device=device) / math.sqrt(hidden_size)\n\n    return {\n        'grad_output': grad_output,\n        'x': x,\n        'gate_weight': gate_weight,\n        'up_weight': up_weight,\n        'down_weight': down_weight,\n        'gate': gate,\n        'gate_sigmoid': gate_sigmoid,\n        'gate_silu': gate_silu,\n        'up': up,\n        'intermediate': intermediate,\n    }\n\n\n@torch.no_grad()\ndef run(\n    grad_output: torch.Tensor,\n    x: torch.Tensor,\n    gate_weight: torch.Tensor,\n    up_weight: torch.Tensor,\n    down_weight: torch.Tensor,\n    gate: torch.Tensor,\n    gate_sigmoid: torch.Tensor,\n    gate_silu: torch.Tensor,\n    up: torch.Tensor,\n    intermediate: torch.Tensor,\n):\n    # Convert to float32 for numerical stability\n    grad_output_f32 = grad_output.to(torch.float32)\n    x_f32 = x.to(torch.float32)\n    gate_weight_f32 = gate_weight.to(torch.float32)\n    up_weight_f32 = up_weight.to(torch.float32)\n    down_weight_f32 = down_weight.to(torch.float32)\n    gate_f32 = gate.to(torch.float32)\n    gate_sigmoid_f32 = gate_sigmoid.to(torch.float32)\n    gate_silu_f32 = gate_silu.to(torch.float32)\n    up_f32 = up.to(torch.float32)\n    intermediate_f32 = intermediate.to(torch.float32)\n    \n    # Gradient w.r.t. down_weight\n    # down_proj: output = intermediate @ down_weight.T\n    # grad_down_weight = grad_output.T @ intermediate\n    grad_down_weight = grad_output_f32.t().mm(intermediate_f32)\n    \n    # Gradient w.r.t. intermediate\n    grad_intermediate = grad_output_f32.mm(down_weight_f32)\n    \n    # Gradient w.r.t. gate_silu and up (element-wise multiplication)\n    # intermediate = gate_silu * up\n    grad_gate_silu = grad_intermediate * up_f32\n    grad_up = grad_intermediate * gate_silu_f32\n    \n    # Gradient w.r.t. gate (through SiLU activation)\n    # gate_silu = gate * sigmoid(gate)\n    # d(gate_silu)/d(gate) = sigmoid(gate) * (1 + gate * (1 - sigmoid(gate)))\n    grad_gate = grad_gate_silu * gate_sigmoid_f32 * (1.0 + gate_f32 * (1.0 - gate_sigmoid_f32))\n    \n    # Gradient w.r.t. up_weight\n    # up_proj: up = x @ up_weight.T\n    # grad_up_weight = grad_up.T @ x\n    grad_up_weight = grad_up.t().mm(x_f32)\n    \n    # Gradient w.r.t. gate_weight\n    # gate_proj: gate = x @ gate_weight.T\n    # grad_gate_weight = grad_gate.T @ x\n    grad_gate_weight = grad_gate.t().mm(x_f32)\n    \n    # Gradient w.r.t. x (input)\n    # Accumulate gradients from both gate and up projections\n    grad_x = grad_gate.mm(gate_weight_f32) + grad_up.mm(up_weight_f32)\n    \n    return (\n        grad_x.to(torch.bfloat16),\n        grad_gate_weight.to(torch.bfloat16),\n        grad_up_weight.to(torch.bfloat16),\n        grad_down_weight.to(t