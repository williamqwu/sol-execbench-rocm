{"type":"item.started","item":{"id":"item_10","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch, time, statistics, math\nfrom reference import gen_inputs, run as ref\n\ndef cand(g,x,gw,uw,dw,gate,sig,silu,up,inter):\n    gdw = torch.mm(g.t(), inter)\n    di = torch.mm(g, dw, out_dtype=torch.float32)\n    sf = sig.float()\n    dg = di * up.float() * sf * (1.0 + gate.float() * (1.0 - sf))\n    du = di * silu.float()\n    ds = torch.cat((dg.bfloat16(), du.bfloat16()), dim=1)\n    ws = torch.cat((gw, uw), dim=0)\n    dws = torch.mm(ds.t(), x)\n    dx = torch.mm(ds, ws)\n    return dx,dws[:768],dws[768:],gdw\n\ndef bench(fn,args,n):\n    for _ in range(3): fn(*args)\n    torch.cuda.synchronize()\n    ts=[]\n    for _ in range(n):\n      st=torch.cuda.Event(True); en=torch.cuda.Event(True)\n      st.record(); fn(*args); en.record(); en.synchronize(); ts.append(st.elapsed_time(en))\n    return statistics.median(ts)\nfor m,atol in [(1,8.97e-8),(8,2.36e-7),(128,9.1e-7),(512,1.7e-6),(1321,2.41e-6),(8192,3.53e-6)]:\n  d=gen_inputs({'num_tokens':m},'cuda'); args=tuple(d.values())\n  r=ref(*args); c=cand(*args); torch.cuda.synchronize()\n  stats=[]\n  for a,b in zip(c,r):\n    dif=(a.float()-b.float()).abs(); tol=atol+0.0078125*b.float().abs()\n    stats.append((float(dif.max()),float((dif<=tol).float().mean())))\n  n=20 if m<1000 else 8\n  print(m,stats,'ms',bench(cand,args,n),bench(ref,args,n))\n  del d,args,r,c\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
