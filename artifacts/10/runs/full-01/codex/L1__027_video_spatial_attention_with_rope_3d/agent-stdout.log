{"type":"item.started","item":{"id":"item_11","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport math,torch\n\ndef old(q,k,F,P,tf,sf):\n N=F*P; fp=torch.arange(F,device=q.device).unsqueeze(1).expand(F,P).reshape(-1).float(); side=math.ceil(math.sqrt(P)); pi=torch.arange(P,device=q.device);hp=(pi//side).unsqueeze(0).expand(F,P).reshape(-1).float();wp=(pi%side).unsqueeze(0).expand(F,P).reshape(-1).float()\n def r3(x):\n  oo=[]\n  for st,pos,freq in ((0,fp,tf),(21,hp,sf),(42,wp,sf)):\n   part=x[...,st:st+21];ang=pos[:,None]*freq[:10];c=ang.cos()[None,None];s=ang.sin()[None,None];x1=part[...,0::2][...,:10];x2=part[...,1::2][...,:10];o1=x1*c-x2*s;o2=x1*s+x2*c;oo.append(torch.cat((torch.stack((o1,o2),-1).flatten(-2),part[...,-1:]),-1))\n  return torch.cat((*oo,x[...,63:]),-1)\n return r3(q),r3(k)\n\ndef new(q,k,F,P,tf,sf):\n N=F*P; fp=torch.arange(F,device=q.device).unsqueeze(1).expand(F,P).reshape(-1).float(); side=math.ceil(math.sqrt(P)); pi=torch.arange(P,device=q.device);hp=(pi//side).unsqueeze(0).expand(F,P).reshape(-1).float();wp=(pi%side).unsqueeze(0).expand(F,P).reshape(-1).float()\n pos=torch.stack((fp,hp,wp),0); freqs=torch.stack((tf[:10],sf[:10],sf[:10]),0); ang=pos[...,None]*freqs[:,None,:];c=ang.cos()[:,None,None];s=ang.sin()[:,None,None]\n def r3(x):\n  x1=torch.stack((x[...,0:20:2],x[...,21:41:2],x[...,42:62:2]),0)\n  x2=torch.stack((x[...,1:21:2],x[...,22:42:2],x[...,43:63:2]),0)\n  p1=x1*c; p2=x2*s; o1=p1-p2\n  p3=x1*s; p4=x2*c; o2=p3+p4\n  evenodd=torch.stack((o1,o2),-1).flatten(-2)\n  return torch.cat((evenodd[0],x[...,20:21],evenodd[1],x[...,41:42],evenodd[2],x[...,62:]),-1)\n return r3(q),r3(k)\nfor B,F,P in ((1,4,64),(4,16,64),(1,16,256),(1,14,541)):\n N=F*P;q=torch.randn(B,16,N,64,device='cuda');k=torch.randn_like(q);tf=torch.randn(32,device='cuda');sf=torch.randn(32,device='cuda')\n a=old(q,k,F,P,tf,sf);b=new(q,k,F,P,tf,sf);print(B,F,P,torch.equal(a[0],b[0]),torch.equal(a[1],b[1]),(a[0]-b[0]).abs().max().item())\n for fn in (old,new):\n  for _ in range(3):fn(q,k,F,P,tf,sf)\n  st=torch.cuda.Event(True);en=torch.cuda.Event(True);st.record()\n  for _ in range(10):fn(q,k,F,P,tf,sf)\n  en.record();en.synchronize();print(fn.__name__,st.elapsed_time(en)/10)\n del q,k,a,b\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
