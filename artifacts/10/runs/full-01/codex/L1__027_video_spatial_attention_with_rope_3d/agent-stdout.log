{"type":"item.started","item":{"id":"item_7","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport math, time, torch\nimport torch.nn.functional as F\nimport reference\n\ndef prep(d):\n    x,w,b,ow,ob,tf,sf,scale = (d[k] for k in ('hidden_states','qkv_weight','qkv_bias','out_weight','out_bias','temporal_freqs','spatial_freqs','scale'))\n    B,Fm,P,H=x.shape; N=Fm*P\n    fp=torch.arange(Fm,device=x.device).unsqueeze(1).expand(Fm,P).reshape(-1).float()\n    side=math.ceil(math.sqrt(P)); pi=torch.arange(P,device=x.device)\n    hp=(pi//side).unsqueeze(0).expand(Fm,P).reshape(-1).float(); wp=(pi%side).unsqueeze(0).expand(Fm,P).reshape(-1).float()\n    z=F.linear(x.reshape(B,N,H),w,b).reshape(B,N,3,16,64).permute(2,0,3,1,4)\n    def r3(a):\n      out=[]\n      for st,pos,freq in ((0,fp,tf),(21,hp,sf),(42,wp,sf)):\n        p=a[...,st:st+21]; ang=pos[:,None]*freq[:10]; c=ang.cos()[None,None]; s=ang.sin()[None,None]\n        a1=p[...,0::2][...,:10]; a2=p[...,1::2][...,:10]\n        out.append(torch.cat((torch.stack((a1*c-a2*s,a1*s+a2*c),-1).flatten(-2),p[...,-1:]),-1))\n      return torch.cat((*out,a[...,63:]),-1)\n    q,k,v=z\n    return r3(q),r3(k),v,ow,ob,scale,(B,Fm,P,H)\n\nprint(torch.__version__, torch.version.hip, torch.cuda.get_device_name())\nfor axes in ({'batch_size':1,'num_frames':4,'num_patches_per_frame':64},{'batch_size':1,'num_frames':16,'num_patches_per_frame':256}):\n  torch.manual_seed(123)\n  d=reference.get_inputs(axes,torch.device('cuda'))\n  ref=reference.run(**d)\n  q,k,v,ow,ob,scale,shape=prep(d)\n  y=F.scaled_dot_product_attention(q,k,v,scale=scale)\n  y=F.linear(y.transpose(1,2).reshape(shape[0],-1,1024),ow,ob).reshape(shape)\n  torch.cuda.synchronize()\n  diff=(y-ref).abs(); tol=1.1920928955078125e-7*ref.abs()+3.5e-9\n  print(axes,'max',diff.max().item(),'ratio',(diff<=tol).float().mean().item())\n  for fn in (lambda: reference.run(**d),lambda: F.scaled_dot_product_attention(q,k,v,scale=scale)):\n    for _ in range(3): fn()\n    torch.cuda.synchronize(); st=torch.cuda.Event(True); en=torch.cuda.Event(True); st.record()\n    for _ in range(10): fn()\n    en.record(); en.synchronize(); print(st.elapsed_time(en)/10)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
