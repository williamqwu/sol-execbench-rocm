{"type":"item.started","item":{"id":"item_23","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport math,torch,triton\nimport torch.nn.functional as F\nimport reference,kernel\nfor B,Fm,P in ((1,4,64),(4,16,64),(1,16,256),(1,14,541)):\n d=reference.get_inputs({'batch_size':B,'num_frames':Fm,'num_patches_per_frame':P},torch.device('cuda'));x=d['hidden_states'];N=Fm*P\n z=F.linear(x.reshape(B,N,1024),d['qkv_weight'],d['qkv_bias']).reshape(B,N,3,16,64)\n fp=torch.arange(Fm,device='cuda').unsqueeze(1).expand(Fm,P).reshape(-1).float();side=math.ceil(math.sqrt(P));pi=torch.arange(P,device='cuda');hp=(pi//side).unsqueeze(0).expand(Fm,P).reshape(-1).float();wp=(pi%side).unsqueeze(0).expand(Fm,P).reshape(-1).float();pos=torch.stack((fp,hp,wp));freq=torch.stack((d['temporal_freqs'][:10],d['spatial_freqs'][:10],d['spatial_freqs'][:10]));a0=pos[...,None]*freq[:,None,:]\n a1=torch.empty_like(a0);kernel._make_angles_kernel[(triton.cdiv(N*10,1024),3)](d['temporal_freqs'],d['spatial_freqs'],a1,N=N,P=P,SIDE=side,BLOCK=1024)\n print('angles',B,Fm,P,torch.equal(a0,a1),(a0-a1).abs().max().item())\n c=a0.cos();s=a0.sin();q,k=z.permute(2,0,3,1,4)[:2]\n def r3(xx):\n  x1=torch.stack((xx[...,0:20:2],xx[...,21:41:2],xx[...,42:62:2]));x2=torch.stack((xx[...,1:21:2],xx[...,22:42:2],xx[...,43:63:2]));cc=c[:,None,None];ss=s[:,None,None];p1=x1*cc;p2=x2*ss;r1=p1-p2;p3=x1*ss;p4=x2*cc;r2=p3+p4;pairs=torch.stack((r1,r2),-1).flatten(-2);return torch.cat((pairs[0],xx[...,20:21],pairs[1],xx[...,41:42],pairs[2],xx[...,62:]),-1)\n refq=r3(q);refk=r3(k);out=torch.empty((2,B,16,N,64),device='cuda');kernel._rope_kernel[(triton.cdiv(out.numel(),256),)](z,c,s,out,N=N,B=B,BLOCK=256)\n print('rope',torch.equal(refq,out[0]),torch.equal(refk,out[1]),(refq-out[0]).abs().max().item(),((refq-out[0])==0).float().mean().item())\n for fn in (lambda:(r3(q),r3(k)),lambda:kernel._rope_kernel[(triton.cdiv(out.numel(),256),)](z,c,s,out,N=N,B=B,BLOCK=256)):\n  for _ in range(3):fn()\n  st=torch.cuda.Event(True);en=torch.cuda.Event(True);st.record()\n  for _ in range(20):fn()\n  en.record();en.synchronize();print(st.elapsed_time(en)/20)\n del z,q,k,refq,refk,out,a0,a1\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
