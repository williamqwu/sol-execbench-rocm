{"type":"item.started","item":{"id":"item_9","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch, torch.nn.functional as F, time\n@torch.compile(fullgraph=True)\ndef cs(x, scale):\n return F.softmax(x * scale, dim=-1, dtype=torch.float32)\nfor n in (256,1024,4096,7574):\n if n>1024: b=1\n else: b=16\n x=torch.randn(b,n,n,device='cuda')\n s=0.125\n a=F.softmax(x*s,dim=-1,dtype=torch.float32)\n st=time.time(); z=cs(x,s); torch.cuda.synchronize(); print('compile',n,time.time()-st)\n d=(a-z).abs(); tol=1.2e-7*a.abs()+1e-10\n print(n,d.max().item(),(d<=tol).float().mean().item(),torch.equal(a,z))\n for fn in (lambda:F.softmax(x*s,dim=-1,dtype=torch.float32),lambda:cs(x,s)):\n  for _ in range(3): fn()\n  stt=torch.cuda.Event(True); end=torch.cuda.Event(True); stt.record()\n  for _ in range(10): fn()\n  end.record();end.synchronize(); print(stt.elapsed_time(end)/10)\n del x,a,z\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
