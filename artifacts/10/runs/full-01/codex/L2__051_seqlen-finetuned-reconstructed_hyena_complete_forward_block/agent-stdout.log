{"type":"item.started","item":{"id":"item_41","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport json,torch,reference,kernel\nfor i,line in enumerate(open('workload.jsonl')):\n w=json.loads(line); b=w['axes']['batch_size'];l=w['axes']['seq_len'];tol=w['tolerance']\n a=reference.get_inputs(w['axes'],torch.device('cuda'));v=list(a.values());ref=reference.run(*v);out=kernel.run(*v);torch.cuda.synchronize()\n d=(out-ref).abs();allow=tol['max_atol']+tol['max_rtol']*ref.abs();ratio=(d<=allow).float().mean().item()\n print(i,b,l,'PASS' if ratio>=tol['required_matched_ratio'] else 'FAIL',f'{ratio:.6f}',f'{d.max().item():.3e}')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
