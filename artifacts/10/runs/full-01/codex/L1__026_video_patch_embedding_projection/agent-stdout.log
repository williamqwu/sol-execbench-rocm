{"type":"item.started","item":{"id":"item_23","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport gc, torch, triton\nimport kernel\nB,F,C,H,W,N=1,81,16,224,224,5120\ndev='cuda:0'; g=lambda *s: torch.randn(*s,device=dev,dtype=torch.float16)\nvideo=g(B,F,C,H,W); weight=g(N,C,1,2,2); bias=g(N)\nsp=g(1,H//2*W//2,N); tp=g(1,F,1,N); nw=g(N); nb=g(N)\nfor rep in range(3):\n    a,b,c,d,e,f=[torch.cuda.Event(enable_timing=True) for _ in range(6)]\n    a.record()\n    rows=video.unfold(3,2,2).unfold(4,2,2).permute(0,1,3,4,2,5,6).contiguous().reshape(-1,64)\n    b.record()\n    out=torch.nn.functional.linear(rows,weight.reshape(N,64),bias)\n    c.record()\n    kernel._positional_layer_norm[(out.shape[0],)](out,sp,tp,nw,nb,1e-6,SPATIAL=(H//2)*(W//2),WIDTH=N,BLOCK=8192,num_warps=8,waves_per_eu=1)\n    d.record(); torch.cuda.synchronize()\n    print(rep, 'pack',a.elapsed_time(b),'linear',b.elapsed_time(c),'post',c.elapsed_time(d),'total',a.elapsed_time(d))\n    del rows,out; gc.collect()\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
