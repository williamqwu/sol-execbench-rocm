{"type":"item.started","item":{"id":"item_22","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch,triton,kernel\n\ndef test(b,s,bm,bn,bk,nw,ns):\n a=torch.empty((b,40,s,s),device='cuda',dtype=torch.bfloat16);v=torch.empty((b,40,s,128),device='cuda',dtype=torch.bfloat16)\n grid=(triton.cdiv(s,bm)*triton.cdiv(128,bn),40,b)\n kw=dict(SEQ_LEN=s,BLOCK_M=bm,BLOCK_N=bn,BLOCK_K=bk,num_warps=nw,num_stages=ns)\n def launch(o): kernel._attn_value_kernel[grid](a,v,o,**kw)\n def current():\n  o=torch.empty((b,s,5120),dtype=torch.bfloat16,device=a.device);launch(o);return o\n def new_empty():\n  o=v.new_empty((b,s,5120));launch(o);return o\n def like_view():\n  o=torch.empty_like(v).view(b,s,5120);launch(o);return o\n def empty_1d_view():\n  o=torch.empty(b*s*5120,dtype=torch.bfloat16,device=a.device).view(b,s,5120);launch(o);return o\n funcs=[('kernel.run',lambda:kernel.run(a,v)),('torch.empty',current),('new_empty',new_empty),('like_view',like_view),('1d_view',empty_1d_view)]\n print('SHAPE',b,s)\n for name,fn in funcs:\n  vals=[triton.testing.do_bench(fn,warmup=20,rep=100) for _ in range(3)]\n  print(name,*(f'{x:.5f}' for x in vals))\n\ntest(1,131,32,128,64,4,2)\ntest(8,512,128,128,64,8,3)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
