{"type":"item.started","item":{"id":"item_18","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch\nimport triton\nimport kernel\n\nK = kernel._rope_inv_freq_kernel\nGRID = (1,)\nLAUNCH = K[GRID]\nEMPTY = torch.empty\nDTYPE = torch.float32\nDEVICE = torch.device(\\\"cuda\\\")\n\ndef baseline(theta):\n    out = torch.empty((64,), device=\\\"cuda\\\", dtype=torch.float32)\n    K[(1,)](out, theta, num_warps=1)\n    return out\n\ndef int_shape(theta):\n    out = torch.empty(64, device=\\\"cuda\\\", dtype=torch.float32)\n    K[(1,)](out, theta, num_warps=1)\n    return out\n\ndef globals_cached(theta):\n    out = EMPTY(64, device=DEVICE, dtype=DTYPE)\n    LAUNCH(out, theta, num_warps=1)\n    return out\n\ndef cached_launch(theta):\n    out = torch.empty(64, device=\\\"cuda\\\", dtype=torch.float32)\n    LAUNCH(out, theta, num_warps=1)\n    return out\n\nfuncs = (baseline, int_shape, globals_cached, cached_launch)\nfor fn in funcs:\n    fn(1000000.0)\nfor cycle in range(3):\n    for fn in funcs:\n        q = triton.testing.do_bench(lambda: fn(1000000.0), warmup=100, rep=2000, quantiles=[0.2, 0.5, 0.8])\n        print(cycle, fn.__name__, q)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
