{"type":"item.started","item":{"id":"item_23","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch,triton\nimport kernel as mod\n\ndef compare(q,k,cfgs,dist):\n torch.manual_seed(123)\n make=torch.rand if dist=='rand' else torch.randn\n a=make((2,20,q,k),device='cuda',dtype=torch.bfloat16)\n v=make((2,20,k,64),device='cuda',dtype=torch.bfloat16)\n ref=torch.matmul(a,v).transpose(1,2).contiguous().reshape(2,q,1280)\n print('case',q,k,dist)\n for bm,bk,w,s in cfgs:\n  o=torch.empty_like(ref); grid=(triton.cdiv(q,bm),40)\n  mod._attention_value_kernel[grid](a,v,o,Q=q,K=k,BLOCK_M=bm,BLOCK_K=bk,num_warps=w,num_stages=s)\n  torch.cuda.synchronize()\n  d=(o.float()-ref.float()).abs(); eq=(o==ref).float().mean()\n  rel=d/(ref.float().abs()+1e-30)\n  good=(d <= 0.0015 + .0078125*ref.float().abs()).float().mean()\n  print((bm,bk,w,s),'eq',float(eq),'maxabs',float(d.max()),'maxrel',float(rel.max()),'good',float(good))\nfor dist in ('rand','randn'):\n compare(541,77,[(32,32,2,1),(64,128,2,1),(128,128,4,1)],dist)\n compare(293,293,[(32,32,4,2),(16,32,4,2)],dist)\n compare(256,256,[(64,32,2,3),(128,64,4,3)],dist)\n compare(512,1024,[(64,32,4,3),(64,64,4,4)],dist)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
