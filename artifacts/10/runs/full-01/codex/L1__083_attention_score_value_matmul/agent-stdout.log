{"type":"item.started","item":{"id":"item_21","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch,triton\nimport kernel as mod\n\ndef sweep(shape,cfgs):\n b,q,k=shape\n a=torch.randn((b,20,q,k),device='cuda',dtype=torch.bfloat16)\n v=torch.randn((b,20,k,64),device='cuda',dtype=torch.bfloat16)\n o=torch.empty((b,q,1280),device='cuda',dtype=torch.bfloat16)\n results=[]\n for bm,bk,w,s,mi in cfgs:\n  grid=(triton.cdiv(q,bm),b*20)\n  def f():\n   opts={} if mi==0 else {'matrix_instr_nonkdim':mi}\n   mod._attention_value_kernel[grid](a,v,o,Q=q,K=k,BLOCK_M=bm,BLOCK_K=bk,num_warps=w,num_stages=s,**opts)\n  try:\n   x=float(triton.testing.do_bench(f,warmup=20,rep=100))\n   results.append((x,(bm,bk,w,s,mi)))\n  except Exception as e: results.append((999,(bm,bk,w,s,mi,type(e).__name__)))\n results.sort()\n print('\\\\nshape',shape,'TOP')\n for x,c in results[:15]: print(f'{x:.6f}',c)\n\nc77=[]\nfor bm in (32,64,128,256):\n for w in ((1,2,4) if bm<128 else (2,4,8)):\n  for s in (1,2,3): c77.append((bm,32,w,s,0))\nc77 += [(64,bk,2,1,0) for bk in (16,64,128)]\nc77 += [(64,32,2,1,32),(128,32,4,1,32)]\nsweep((4,4096,77),c77)\nsweep((4,1024,77),c77)\n\nc293=[]\nfor bm in (16,32,64,128):\n for bk in (16,32,64):\n  for w in (1,2,4):\n   for s in (1,2,3,4):\n    if (bm,bk,w,s) in [(16,16,1,1),(16,16,2,2),(16,32,2,1),(16,32,2,2),(16,32,4,2),(16,64,2,2),(32,16,2,1),(32,16,2,2),(32,16,4,2),(32,32,1,2),(32,32,2,1),(32,32,2,2),(32,32,2,3),(32,32,4,1),(32,32,4,2),(32,32,4,3),(32,32,4,4),(32,64,2,2),(32,64,4,2),(32,64,4,3),(64,16,2,2),(64,16,4,2),(64,32,1,2),(64,32,2,1),(64,32,2,2),(64,32,2,3),(64,32,4,1),(64,32,4,2),(64,32,4,3),(64,32,4,4),(64,64,2,2),(64,64,4,2),(64,64,4,3),(128,32,4,1),(128,32,4,2)]: c293.append((bm,bk,w,s,0))\nc293 += [(32,32,4,2,32),(64,32,4,2,32)]\nsweep((2,293,293),c293)\n\nc1024=[]\nfor bm in (32,64,128,256):\n for bk in (16,32,64):\n  for w in ((2,4) if bm<128 else (4,8)):\n   for s in (1,2,3,4):\n    if bk==32 or (bm in (64,128) and s in (2,3)): c1024.append((bm,bk,w,s,0))\nc1024 += [(64,32,2,3,32),(64,32,4,3,32),(128,32,4,2,32)]\nsweep((4,1024,1024),c1024)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
