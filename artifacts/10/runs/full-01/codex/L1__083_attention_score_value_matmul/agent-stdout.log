{"type":"item.started","item":{"id":"item_6","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch, triton\nimport kernel as mod\n\ndef bench(shape, configs):\n    b,q,k = shape\n    a=torch.randn((b,20,q,k),device='cuda',dtype=torch.bfloat16)\n    v=torch.randn((b,20,k,64),device='cuda',dtype=torch.bfloat16)\n    o=torch.empty((b,q,1280),device='cuda',dtype=torch.bfloat16)\n    print('shape', shape)\n    for bm,bk,w,s in configs:\n        grid=(triton.cdiv(q,bm), b*20)\n        def f():\n            mod._attention_value_kernel[grid](a,v,o,Q=q,K=k,BLOCK_M=bm,BLOCK_K=bk,num_warps=w,num_stages=s)\n        try:\n            ms=triton.testing.do_bench(f, warmup=20, rep=100)\n            print((bm,bk,w,s), f'{ms:.6f}')\n        except Exception as e:\n            print((bm,bk,w,s), type(e).__name__, str(e)[:160])\n\nconfigs=[(16,32,4,2),(32,16,4,2),(32,32,4,1),(32,32,4,2),(32,32,4,3),(32,64,4,2),(64,16,4,2),(64,32,4,1),(64,32,4,2),(64,32,4,3),(64,64,4,2),(64,32,8,2),(128,32,4,2),(128,32,8,2)]\nbench((2,2053,2053), configs)\nbench((2,2048,77), configs)\nbench((2,256,256), configs)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
