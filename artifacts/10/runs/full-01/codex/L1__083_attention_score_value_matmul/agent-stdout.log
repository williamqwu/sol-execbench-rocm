{"type":"item.started","item":{"id":"item_14","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch,triton\n\ndef check(b,q,k):\n a=torch.randn((b,20,q,k),device='cuda',dtype=torch.bfloat16)\n v=torch.randn((b,20,k,64),device='cuda',dtype=torch.bfloat16)\n o=torch.empty((b,q,1280),device='cuda',dtype=torch.bfloat16)\n ov=o.view(b,q,20,64).transpose(1,2)\n try:\n  torch.matmul(a,v,out=ov)\n  ref=torch.matmul(a,v).transpose(1,2).contiguous().reshape(b,q,1280)\n  print('shape',b,q,k,'strides',ov.stride(),'equal',torch.equal(o,ref),'max',float((o.float()-ref.float()).abs().max()))\n  def direct(): torch.matmul(a,v,out=ov)\n  def plain(): return torch.matmul(a,v)\n  def full(): return torch.matmul(a,v).transpose(1,2).contiguous()\n  print('direct',triton.testing.do_bench(direct,warmup=20,rep=100),'plain',triton.testing.do_bench(plain,warmup=20,rep=100),'full',triton.testing.do_bench(full,warmup=20,rep=100))\n except Exception as e: print('error',type(e).__name__,e)\n\ncheck(2,2053,2053)\ncheck(2,1024,1024)\ncheck(4,4096,77)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
