{\n      \"type\": \"expr\",\n      \"expression\": \"height // 4\"\n    },\n    \"height_div8\": {\n      \"type\": \"expr\",\n      \"expression\": \"height // 8\"\n    },\n    \"width_div2\": {\n      \"type\": \"expr\",\n      \"expression\": \"width // 2\"\n    },\n    \"width_div4\": {\n      \"type\": \"expr\",\n      \"expression\": \"width // 4\"\n    },\n    \"width_div8\": {\n      \"type\": \"expr\",\n      \"expression\": \"width // 8\"\n    }\n  },\n  \"inputs\": {\n    \"x\": {\n      \"shape\": [\n        \"batch_size\",\n        \"in_channels\",\n        \"frames\",\n        \"height\",\n        \"width\"\n      ],\n      \"dtype\": \"float32\",\n      \"description\": \"Input video tensor normalized to [-1, 1]\"\n    },\n    \"input_conv_weight\": {\n      \"shape\": [\n        \"hidden_div4\",\n        \"in_channels\",\n        \"3\",\n        \"3\",\n        \"3\"\n      ],\n      \"dtype\": \"float32\",\n      \"description\": \"Initial 3D convolution weight\"\n    },\n    \"input_conv_bias\": {\n      \"shape\": [\n        \"hidden_div4\"\n      ],\n      \"dtype\": \"float32\",\n      \"description\": \"Initial 3D convolution bias\"\n    },\n    \"down1_gn_weight\": {\n      \"shape\": [\n        \"hidden_div4\"\n      ],\n      \"dtype\": \"float32\",\n      \"description\": \"First block group norm weight\"\n    },\n    \"down1_gn_bias\": {\n      \"shape\": [\n        \"hidden_div4\"\n      ],\n      \"dtype\": \"float32\",\n      \"description\": \"First block group norm bias\"\n    },\n    \"down1_conv_weight\": {\n      \"shape\": [\n        \"hidden_div2\",\n        \"hidden_div4\",\n        \"3\",\n        \"4\",\n        \"4\"\n      ],\n      \"dtype\": \"float32\",\n      \"description\": \"First downsampling conv weight\"\n    },\n    \"down1_conv_bias\": {\n      \"shape\": [\n        \"hidden_div2\"\n      ],\n      \"dtype\": \"float32\",\n      \"description\": \"First downsampling conv bias\"\n    },\n    \"down1_res_weight\": {\n      \"shape\": [\n        \"hidden_div2\",\n        \"hidden_div4\",\n        \"1\",\n        \"1\",\n        \"1\"\n      ],\n      \"dtype\": \"float32\",\n      \"description\": \"First residual projection weight\"\n    },\n    \"down1_res_bias\": {\n      \"shape\": [\n        \"hidden_div2\"\n      ],\n      \"dtype\": \"float32\",\n      \"description\": \"First residual projection bias\"\n    },\n    \"down2_gn_weight\": {\n      \"shape\": [\n        \"hidden_div2\"\n      ],\n      \"dtype\": \"float32\",\n      \"description\": \"Second block group norm weight\"\n    },\n    \"down2_gn_bias\": {\n      \"shape\": [\n        \"hidden_div2\"\n      ],\n      \"dtype\": \"float32\",\n      \"description\": \"Second block group norm bias\"\n    },\n    \"down2_conv_weight\": {\n      \"shape\": [\n        \"hidden_size\",\n        \"hidden_div2\",\n        \"3\",\n        \"4\",\n        \"4\"\n      ],\n      \"dtype\": \"float32\",\n      \"description\": \"Second downsampling conv weight\"\n    },\n    \"down2_conv_bias\": {\n      \"shape\": [\n        \"hidden_size\"\n      ],\n      \"dtype\": \"float32\",\n      \"description\": \"Second downsampling conv bias\"\n    },\n    \"down2_res_weight\": {\n      \"shape\": [\n        \"hidden_size\",\n        \"hidden_div2\",\n        \"1\",\n        \"1\",\n        \"1\"\n      ],\n      \"dtype\": \"float32\",\n      \"description\": \"Second residual projection weight\"\n    },\n    \"down2_res_bias\": {\n      \"shape\": [\n        \"hidden_size\"\n      ],\n      \"dtype\": \"float32\",\n      \"description\": \"Second residual projection bias\"\n    },\n    \"down3_gn_weight\": {\n      \"shape\": [\n        \"hidden_size\"\n      ],\n      \"dtype\": \"float32\",\n      \"description\": \"Third block group norm weight\"\n    },\n    \"down3_gn_bias\": {\n      \"shape\": [\n        \"hidden_size\"\n      ],\n      \"dtype\": \"float32\",\n      \"description\": \"Third block group norm bias\"\n    },\n    \"down3_conv_weight\": {\n      \"shape\": [\n        \"hidden_size\",\n        \"hidden_size\",\n        \"3\",\n        \"4\",\n        \"4\"\n      ],\n      \"dtype\": \"float32\",\n      \"description\": \"Third downsampling conv weight\"\n    },\n    \"down3_conv_bias\": {\n      \"shape\": [\n        \"hidden_size\"\n      ],\n      \"dtype\": \"float32\",\n      \"description\": \"Third downsampling conv bias\"\n    },\n    \"down3_res_weight\": {\n      \"shape\": [\n        \"hidden_size\",\n        \"hidden_size\",\n        \"1\",\n        \"1\",\n        \"1\"\n      ],\n      \"dtype\": \"float32\",\n      \"description\": \"Third residual projection weight\"\n    },\n    \"down3_res_bias\": {\n      \"shape\": [\n        \"hidden_size\"\n      ],\n      \"dtype\": \"float32\",\n      \"description\": \"Third residual projection bias\"\n    },\n    \"latent_gn_weight\": {\n      \"shape\": [\n        \"hidden_size\"\n      ],\n      \"dtype\": \"float32\",\n      \"description\": \"Latent projection group norm weight\"\n    },\n    \"latent_gn_bias\": {\n      \"shape\": [\n        \"hidden_size\"\n      ],\n      \"dtype\": \"float32\",\n      \"description\": \"Latent projection group norm bias\"\n    },\n    \"latent_conv_weight\": {\n      \"shape\": [\n        \"latent_channels\",\n        \"hidden_size\",\n        \"3\",\n        \"3\",\n        \"3\"\n      ],\n      \"dtype\": \"float32\",\n      \"description\": \"Latent projection conv weight\"\n    },\n    \"latent_conv_bias\": {\n      \"shape\": [\n        \"latent_channels\"\n      ],\n      \"dtype\": \"float32\",\n      \"description\": \"Latent projection conv bias\"\n    },\n    \"eps\": {\n      \"shape\": null,\n      \"dtype\": \"float32\",\n      \"description\": \"Epsilon for group normalization\"\n    }\n  },\n  \"outputs\": {\n    \"output\": {\n      \"shape\": [\n        \"batch_size\",\n        \"latent_channels\",\n        \"frames_div4\",\n        \"height_div8\",\n        \"width_div8\"\n      ],\n      \"dtype\": \"float32\",\n      \"description\": \"Compressed latent representation\"\n    }\n  },\n  \"reference\": \"import torch\\nimport torch.nn.functional as F\\n\\n@torch.no_grad()\\ndef run(\\n    x: torch.Tensor,\\n    input_conv_weight: torch.Tensor,\\n    input_conv_bias: torch.Tensor,\\n    down1_gn_weight: torch.Tensor,\\n    down1_gn_bias: torch.Tensor,\\n    down1_conv_weight: torch.Tensor,\\n    down1_conv_bias: torch.Tensor,\\n    down1_res_weight: torch.Tensor,\\n    down1_res_bias: torch.Tensor,\\n    down2_gn_weight: torch.Tensor,\\n    down2_gn_bias: torch.Tensor,\\n    down2_conv_weight: torch.Tensor,\\n    down2_conv_bias: torch.Tensor,\\n    down2_res_weight: torch.Tensor,\\n    down2_res_bias: torch.Tensor,\\n    down3_gn_weight: torch.Tensor,\\n    down3_gn_bias: torch.Tensor,\\n    down3_conv_weight: torch.Tensor,\\n    down3_conv_bias: torch.Tensor,\\n    down3_res_weight: torch.Tensor,\\n    down3_res_bias: torch.Tensor,\\n    latent_gn_weight: torch.Tensor,\\n    latent_gn_bias: torch.Tensor,\\n    latent_conv_weight: torch.Tensor,\\n    latent_conv_bias: torch.Tensor,\\n    eps: float,\\n):\\n    num_groups = 32\\n    \\n    # Initial projection: (B, 3, T, H, W) -> (B, 256, T, H, W)\\n    h = F.conv3d(x, input_conv_weight, input_conv_bias, stride=1, padding=1)\\n    \\n    # First downsampling block with residual\\n    # Group norm + SiLU + Conv3d\\n    identity1 = F.conv3d(h, down1_res_weight, down1_res_bias, stride=2)\\n    h = F.group_norm(h, num_groups // 4, down1_gn_weight, down1_gn_bias, eps)\\n    h = F.silu(h)\\n    h = F.conv3d(h, down1_conv_weight, down1_conv_bias, stride=2, padding=1)\\n    h = h + identity1\\n    \\n    # Second downsampling block with residual\\n    identity2 = F.conv3d(h, down2_res_weight, down2_res_bias, stride=2)\\n    h = F.group_norm(h, num_groups // 2, down2_gn_weight, down2_gn_bias, eps)\\n    h = F.silu(h)\\n    h = F.conv3d(h, down2_conv_weight, down2_conv_bias, stride=2, padding=1)\\n    h = h + identity2\\n    \\n    # Third downsampling block with residual (spatial only)\\n    identity3 = F.conv3d(h, down3_res_weight, down3_res_bias, stride=(1, 2, 2))\\n    h = F.group_norm(h, num_groups, down3_gn_weight, down3_gn_bias, eps)\\n    h = F.silu(h)\\n    h = F.conv3d(h, down3_conv_weight, down3_conv_bias, stride=(1, 2, 2), padding=1)\\n    h = h + identity3\\n    \\n    # Latent projection\\n    h = F.group_norm(h, num_groups, latent_gn_weight, latent_gn_bias, eps)\\n    h = F.silu(h)\\n    output = F.conv3d(h, latent_conv_weight, latent_conv_bias, stride=1, padding=1)\\n    \\n    return output\\n\"\n}\nREFERENCE\nimport torch\nimport torch.nn.functional as F\n\n@torch.no_grad()\ndef run(\n    x: torch.Tensor,\n    input_conv_weight: torch.Tensor,\n    input_conv_bias: torch.Tensor,\n    down1_gn_weight: torch.Tensor,\n    down1_gn_bias: torch.Tensor,\n    down1_conv_weight: torch.Tensor,\n    down1_conv_bias: torch.Tensor,\n    down1_res_weight: torch.Tensor,\n    down1_res_bias: torch.Tensor,\n    down2_gn_weight: torch.Tensor,\n    down2_gn_bias: torch.Tensor,\n    down2_conv_weight: torch.Tensor,\n    down2_conv_bias: torch.Tensor,\n    down2_res_weight: torch.Tensor,\n    down2_res_bias: torch.Tensor,\n    down3_gn_weight: torch.Tensor,\n    down3_gn_bias: torch.Tensor,\n    down3_conv_weight: torch.Tensor,\n    down3_conv_bias: torch.Tensor,\n    down3_res_weight: torch.Tensor,\n    down3_res_bias: torch.Tensor,\n    latent_gn_weight: torch.Tensor,\n    latent_gn_bias: torch.Tensor,\n    latent_conv_weight: torch.Tensor,\n    latent_conv_bias: torch.Tensor,\n    eps: float,\n):\n    num_groups = 32\n    \n    # Initial projection: (B, 3, T, H, W) -> (B, 256, T, H, W)\n    h = F.conv3d(x, input_conv_weight, input_conv_bias, stride=1, padding=1)\n    \n    # First downsampling block with residual\n    # Group norm + SiLU + Conv3d\n    identity1 = F.conv3d(h, down1_res_weight, down1_res_bias, stride=2)\n    h = F.group_norm(h, num_groups // 4, down1_gn_weight, down1_gn_bias, eps)\n    h = F.silu(h)\n    h = F.conv3d(h, down1_conv_weight, down1_conv_bias, stride=2, padding=1)\n    h = h + identity1\n    \n    # Second downsampling block with residual\n    identity2 = F.conv3d(h, down2_res_weight, down2_res_bias, stride=2)\n    h = F.group_norm(h, num_groups // 2, down2_gn_weight, down2_gn_bias, eps)\n    h = F.silu(h)\n    h = F.conv3d(h, down2_conv_weight, down2_conv_bias, stride=2, padding=1)\n    h = h + identity2\n    \n    # Third downsampling block with residual (spatial only)\n    identity3 = F.conv3d(h, down3_res_weight, down3_res_bias, stride=(1, 2, 2))\n    h = F.group_norm(h, num_groups, down3_gn_weight, down3_gn_bias, eps)\n    h = F.silu(h)\n    h = F.conv3d(h, down3_conv_weight, down3_conv_bias, stride=(1, 2, 2), padding=1)\n    h = h + identity3\n    \n    # Latent projection\n    h = F.group_norm(h, num_groups, latent_gn_weight, latent_gn_bias, eps)\n    h = F.silu(h)\n    output = F.conv3d(h, latent_conv_weight, latent_conv_bias, stride=1, padding=1)\n    \n    return output\nWORKLOADS\n{\"uuid\": \"85c906d0-7726-57ce-a5b7-c0ff320e083f\", \"axes\": {\"batch_size\": 1, \"frames\": 16, \"height\": 384, \"width\": 384}, \"inputs\": {\"x\": {\"type\": \"random\"}, \"input_conv_weight\": {\"type\": \"random\"}, \"input_conv_bias\": {\"type\": \"random\"}, \"down1_gn_weight\": {\"type\": \"random\"}, \"down1_gn_bias\": {\"type\": \"random\"}, \"down1_conv_weight\": {\"type\": \"random\"}, \"down1_conv_bias\": {\"type\": \"random\"}, \"down1_res_weight\": {\"type\": \"random\"}, \"down1_res_bias\": {\"type\": \"random\"}, \"down2_gn_weight\": {\"type\": \"random\"}, \"down2_gn_bias\": {\"type\": \"random\"}, \"down2_conv_weight\": {\"type\": \"random\"}, \"down2_conv_bias\": {\"type\": \"random\"}, \"down2_res_weight\": {\"type\": \"random\"}, \"down2_res_bias\": {\"type\": \"random\"}, \"down3_gn_weight\": {\"type\": \"random\"}, \"down3_gn_bias\": {\"type\": \"rando