{"type":"item.started","item":{"id":"item_9","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch, aiter\nimport reference\n\ndef alt(*args):\n (hidden_states, position_ids, attention_mask, qw,kw,vw,ow,qn,kn,sk,sv,theta,cap,eps,shared)=args\n b,s,_=hidden_states.shape\n q=torch.nn.functional.linear(hidden_states,qw).view(b,s,32,96)\n var=q.float().square().mean(-1,keepdim=True); q=(q*torch.rsqrt(var+eps)*qn).to(q.dtype)\n inv=1.0/(theta**(torch.arange(0,96,2,dtype=torch.float32,device=q.device)/96))\n freqs=(inv[None,:,None].expand(b,-1,1)@position_ids[:,None,:].float()).transpose(1,2)\n emb=torch.cat((freqs,freqs),-1); cos=emb.cos().to(q.dtype); sin=emb.sin().to(q.dtype)\n def rope(x): return x*cos[:,:,None,:]+torch.cat((-x[...,48:],x[...,:48]),-1)*sin[:,:,None,:]\n q=rope(q)\n k=torch.nn.functional.linear(hidden_states,kw).view(b,s,8,96)\n var=k.float().square().mean(-1,keepdim=True); k=(k*torch.rsqrt(var+eps)*kn).to(k.dtype); k=rope(k)\n v=torch.nn.functional.linear(hidden_states,vw).view(b,s,8,96)\n var=v.float().square().mean(-1,keepdim=True); v=(v*torch.rsqrt(var+eps)).to(v.dtype)\n cu=torch.arange(0,(b+1)*s,s,dtype=torch.int32,device=q.device)\n out=aiter.flash_attn_varlen_func(q.reshape(b*s,32,96),k.reshape(b*s,8,96),v.reshape(b*s,8,96),cu,cu,s,s,dropout_p=0.,softmax_scale=1.0,logits_soft_cap=cap,causal=True)\n if isinstance(out,(tuple,list)): out=out[0]\n return torch.nn.functional.linear(out.reshape(b,s,3072),ow)\n\nfor b,s in [(1,128),(2,131),(1,256),(4,128)]:\n x=reference.get_inputs({'batch_size':b,'seq_len':s},torch.device('cuda'))\n args=list(x.values())\n y=reference.run(*args); z=alt(*args)\n d=(y.float()-z.float()).abs(); tol=0.0064+0.0078125*y.float().abs()\n print(b,s,d.max().item(),(d<=tol).float().mean().item(),z.shape)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
