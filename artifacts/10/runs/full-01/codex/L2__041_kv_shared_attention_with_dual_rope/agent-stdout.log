{"type":"item.started","item":{"id":"item_56","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch,time,triton,gc\nimport kernel\nshapes=[(4,128),(32,128),(1,256),(4,256),(16,512),(4,1024),(2,2048),(1,4096)]\nfor b,s in shapes:\n q=torch.randn(b,s,32,96,device='cuda',dtype=torch.bfloat16);k=torch.randn(b,s,8,96,device='cuda',dtype=torch.bfloat16);v=torch.randn_like(k);o=torch.empty_like(q);n=30 if b*s*s<30000000 else 10;print((b,s),end=' ')\n # existing chosen-like 128x32\n for kind,hm,bn in [('old',128,32),('gqa',16,32),('gqa',16,64),('gqa',32,32),('gqa',32,64)]:\n  try:\n   if kind=='old':\n    grid=(triton.cdiv(s,hm),b*32);call=lambda:kernel._attention[grid](q,k,v,o,N_CTX=s,SOFTCAP=30.,Q_STRIDE_T=3072,KV_STRIDE_T=768,BLOCK_M=hm,BLOCK_N=bn,num_warps=4,num_stages=1)\n   else:\n    grid=(triton.cdiv(s,hm),b*8);call=lambda:kernel._attention_gqa4[grid](q,k,v,o,N_CTX=s,SOFTCAP=30.,Q_STRIDE_T=3072,KV_STRIDE_T=768,HEAD_M=hm,BLOCK_N=bn,num_warps=4,num_stages=1)\n   for _ in range(2):call()\n   torch.cuda.synchronize();st=time.perf_counter()\n   for _ in range(n):call()\n   torch.cuda.synchronize();print((kind,hm,bn),round((time.perf_counter()-st)*1000/n,4),end='  ')\n  except Exception as e:print((kind,hm,bn),'ERR',str(e).splitlines()[-1][:80],end='  ')\n print();del q,k,v,o;gc.collect();torch.cuda.empty_cache()\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
