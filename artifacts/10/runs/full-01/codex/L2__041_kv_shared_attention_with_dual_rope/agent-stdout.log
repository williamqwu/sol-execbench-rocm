{"type":"item.started","item":{"id":"item_39","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch,time,triton\nimport kernel\nconfigs=[(64,64,32,4,1),(64,128,32,4,1),(128,64,32,4,1),(128,128,32,8,1),(64,64,64,4,1),(64,128,64,4,1),(128,64,64,4,1),(128,128,64,8,1),(64,128,32,8,2),(128,128,32,8,2)]\nfor M in [128,256,512,1024,4096]:\n N=K=3072;a=torch.randn(M,K,device='cuda',dtype=torch.bfloat16);b=torch.randn(N,K,device='cuda',dtype=torch.bfloat16);c=torch.empty(M,N,device='cuda',dtype=torch.bfloat16)\n print('M',M)\n # torch\n for _ in range(3):y=torch.nn.functional.linear(a,b)\n torch.cuda.synchronize();st=time.perf_counter()\n for _ in range(20):y=torch.nn.functional.linear(a,b)\n torch.cuda.synchronize();print('torch',round((time.perf_counter()-st)*50,4))\n for cfg in configs:\n  bm,bn,bk,nw,ns=cfg;grid=(triton.cdiv(M,bm)*triton.cdiv(N,bn),)\n  try:\n   for _ in range(3):kernel._gemm[grid](a,b,c,M=M,N=N,K=K,BLOCK_M=bm,BLOCK_N=bn,BLOCK_K=bk,GROUP_M=8,num_warps=nw,num_stages=ns)\n   torch.cuda.synchronize();st=time.perf_counter()\n   for _ in range(20):kernel._gemm[grid](a,b,c,M=M,N=N,K=K,BLOCK_M=bm,BLOCK_N=bn,BLOCK_K=bk,GROUP_M=8,num_warps=nw,num_stages=ns)\n   torch.cuda.synchronize();print(cfg,round((time.perf_counter()-st)*50,4),end='  ')\n  except Exception as e:print(cfg,'ERR',str(e)[:80],end='  ')\n print()\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
