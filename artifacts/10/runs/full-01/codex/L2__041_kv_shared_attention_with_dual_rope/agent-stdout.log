{"type":"item.started","item":{"id":"item_26","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch,triton\nimport reference,kernel\nb,s=1,4096\nx=reference.get_inputs({'batch_size':b,'seq_len':s},torch.device('cuda')); h=x['hidden_states'];p=x['position_ids'];e=x['rms_norm_eps'];t=x['rope_theta']\nq=torch.nn.functional.linear(h,x['q_proj_weight']).view(b,s,32,96); qt=q.clone(); qe=reference.rms_norm(q,x['q_norm_weight'],e);c,si=reference.compute_rope_embeddings(qe,p,t,96);qe=reference.apply_rotary_pos_emb(qe,c,si,2)\nk=torch.nn.functional.linear(h,x['k_proj_weight']).view(b,s,8,96);v=torch.nn.functional.linear(h,x['v_proj_weight']).view(b,s,8,96)\nkernel._norm_rope_qkv[(b*s*32,)](qt,k,v,p,x['q_norm_weight'],x['k_norm_weight'],POS_STRIDE_B=p.stride(0),POS_STRIDE_S=p.stride(1),N_CTX=s,EPS=e,THETA=t,num_warps=1,num_stages=1);torch.cuda.synchronize()\nd=(qe.float()-qt.float()).abs(); dm=d.amax((0,2,3)); vals,idx=torch.topk(dm,20)\nprint(list(zip(idx.cpu().tolist(),vals.cpu().tolist())))\nfor i in idx[:5]:\n di=d[0,i]; inds=(di>0).nonzero(); print('pos',i.item(),'n',len(inds),'first',inds[:10].cpu().tolist())\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
