{"type":"item.started","item":{"id":"item_40","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch,time,triton,gc\nimport reference,kernel\nconfigs=[(16,32,4,1),(16,64,4,1),(32,32,4,1),(32,64,4,1),(32,128,4,1),(32,128,8,1),(64,32,4,1),(64,64,4,1),(64,64,8,1),(64,128,4,1),(64,128,8,1),(128,32,4,1),(128,64,8,1),(128,128,8,1)]\nfor s in [128,512,1024,2048,4096]:\n b=1;x=reference.get_inputs({'batch_size':b,'seq_len':s},torch.device('cuda'));h=x['hidden_states'];q=torch.nn.functional.linear(h,x['q_proj_weight']).view(b,s,32,96);k=torch.nn.functional.linear(h,x['k_proj_weight']).view(b,s,8,96);v=torch.nn.functional.linear(h,x['v_proj_weight']).view(b,s,8,96);inv=1/(x['rope_theta']**(torch.arange(0,96,2,device='cuda',dtype=torch.float32)/96));kernel._norm_rope_qkv[(b*s*32,)](q,k,v,x['position_ids'],x['q_norm_weight'],x['k_norm_weight'],inv,POS_STRIDE_B=x['position_ids'].stride(0),POS_STRIDE_S=x['position_ids'].stride(1),N_CTX=s,EPS=x['rms_norm_eps'],THETA=x['rope_theta'],num_warps=1,num_stages=1);o=torch.empty_like(q);torch.cuda.synchronize();print('S',s)\n n=50 if s<=1024 else 20\n for bm,bn,nw,ns in configs:\n  try:\n   grid=(triton.cdiv(s,bm),b*32)\n   for _ in range(2):kernel._attention[grid](q,k,v,o,N_CTX=s,SOFTCAP=30.,BLOCK_M=bm,BLOCK_N=bn,num_warps=nw,num_stages=ns)\n   torch.cuda.synchronize();st=time.perf_counter()\n   for _ in range(n):kernel._attention[grid](q,k,v,o,N_CTX=s,SOFTCAP=30.,BLOCK_M=bm,BLOCK_N=bn,num_warps=nw,num_stages=ns)\n   torch.cuda.synchronize();ms=(time.perf_counter()-st)*1000/n\n   print((bm,bn,nw,ns),round(ms,4),end='  ')\n  except Exception as e:print((bm,bn,nw,ns),'ERR',str(e).splitlines()[-1][:50],end='  ')\n print();del x,h,q,k,v,inv,o;gc.collect();torch.cuda.empty_cache()\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
