{"type":"item.started","item":{"id":"item_17","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport torch, reference, time\nN=1280\nprint('allocating')\nx=reference.get_inputs({'num_tokens':N,'hidden_size':6144,'moe_intermediate_size':2560,'num_experts':160,'num_experts_per_tok':8},torch.device('cuda'))\ntorch.cuda.synchronize(); print('ready')\ndef bench(fn,it=10):\n for _ in range(2): fn()\n torch.cuda.synchronize(); a=torch.cuda.Event(True); b=torch.cuda.Event(True); a.record()\n for _ in range(it): fn()\n b.record(); b.synchronize(); return a.elapsed_time(b)/it\nh=x['hidden_states']; se=x['selected_experts']; rw=x['routing_weights']; wg=x['expert_gate_weights']; wu=x['expert_up_weights']; wd=x['expert_down_weights']; E=160; C=N//16; K=8\nstate={}\ndef route():\n fe=se.reshape(-1); fw=rw.reshape(-1); ft=torch.arange(N,device='cuda').repeat_interleave(K)\n sx,si=fe.sort(stable=True); sw=fw[si]; st=ft[si]; counts=torch.bincount(sx,minlength=E); starts=torch.zeros(E,dtype=torch.long,device='cuda'); starts[1:]=counts[:-1].cumsum(0); wp=torch.arange(len(sx),device='cuda')-starts[sx]; v=wp<C; ve=sx[v]; vp=wp[v]; vt=st[v]; vw=sw[v]\n inp=torch.zeros(E,C,6144,dtype=torch.bfloat16,device='cuda'); inp[ve,vp]=h[vt]\n state.update(inp=inp,ve=ve,vp=vp,vt=vt,vw=vw)\nroute(); torch.cuda.synchronize()\nprint('route',bench(route,20))\nroute(); inp=state['inp']\nprint('gate bmm',bench(lambda: torch.bmm(inp,wg),10))\nprint('up bmm',bench(lambda: torch.bmm(inp,wu),10))\ng=torch.bmm(inp,wg); u=torch.bmm(inp,wu)\nprint('act',bench(lambda: torch.nn.functional.silu(g)*u,20))\na=torch.nn.functional.silu(g)*u\nprint('down',bench(lambda: torch.bmm(a,wd),10))\no=torch.bmm(a,wd); ve=state['ve']; vp=state['vp']; vt=state['vt']; vw=state['vw']\ndef agg():\n z=torch.zeros_like(h); z.index_add_(0,vt,vw[:,None]*o[ve,vp]); return z\nprint('agg',bench(agg,20))\nprint('full',bench(lambda: reference.run(**x),10))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
