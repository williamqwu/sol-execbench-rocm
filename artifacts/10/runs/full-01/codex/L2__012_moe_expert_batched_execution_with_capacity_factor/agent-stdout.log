{"type":"item.started","item":{"id":"item_64","type":"command_execution","command":"/bin/bash -lc \"python3 -u - <<'PY'\nimport torch,triton,reference,kernel\nN=8192; E=160; C=512; H=6144; I=2560\nx=reference.get_inputs({'num_tokens':N,'hidden_size':H,'moe_intermediate_size':I,'num_experts':E,'num_experts_per_tok':8},torch.device('cuda')); print('ready')\nh=x['hidden_states']; sel=x['selected_experts']; rw=x['routing_weights']; wg=x['expert_gate_weights']; wu=x['expert_up_weights']; wd=x['expert_down_weights']\ntm=torch.empty(E,C,dtype=torch.int32,device='cuda'); pos=torch.empty(N,8,dtype=torch.int32,device='cuda'); inp=torch.empty(E,C,H,dtype=torch.bfloat16,device='cuda'); mb=triton.cdiv(C,16)\ndef route(): kernel._build_routes[(E,)](sel,tm,pos,N,CAPACITY=C,BLOCK_T=256,BLOCK_C=512,num_warps=8)\ndef gather(): kernel._gather_expert_inputs[(E*mb,triton.cdiv(H,512))](h,tm,inp,H=H,ROUTE_CAPACITY=C,OUTPUT_CAPACITY=C,M_BLOCKS=mb,BLOCK_M=16,BLOCK_H=512,num_warps=8)\ndef bench(fn,it=8):\n for _ in range(2): y=fn()\n torch.cuda.synchronize(); a=torch.cuda.Event(True); b=torch.cuda.Event(True); a.record()\n for _ in range(it): y=fn()\n b.record(); b.synchronize(); return a.elapsed_time(b)/it\nroute();gather();torch.cuda.synchronize()\nprint('route',bench(route,20)); print('gather',bench(gather,20)); print('gate',bench(lambda:torch.bmm(inp,wg))); print('up',bench(lambda:torch.bmm(inp,wu))); g=torch.bmm(inp,wg);u=torch.bmm(inp,wu); print('act',bench(lambda:torch.nn.functional.silu(g)*u,20)); act=torch.nn.functional.silu(g)*u; print('down',bench(lambda:torch.bmm(act,wd))); out=torch.bmm(act,wd); res=torch.empty_like(h)\ndef agg(): kernel._aggregate[(triton.cdiv(N,8),triton.cdiv(H,256))](out,sel,rw,pos,res,N,H=H,CAPACITY=C,BLOCK_M=8,BLOCK_H=256,num_warps=8)\nprint('agg',bench(agg,20)); print('full',bench(lambda:kernel.run(**x),5))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
