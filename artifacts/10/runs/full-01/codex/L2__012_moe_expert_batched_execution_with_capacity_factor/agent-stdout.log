{"type":"item.started","item":{"id":"item_20","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport torch, kernel\nN,E,K,H,I=16,8,8,64,32\ntorch.manual_seed(1)\nx=torch.randn(N,H,device='cuda',dtype=torch.bfloat16)\nsel=torch.stack([torch.randperm(E,device='cuda')[:K] for _ in range(N)])\nrw=torch.softmax(torch.randn(N,K,device='cuda').float(),-1).bfloat16()\nwg=torch.randn(E,H,I,device='cuda',dtype=torch.bfloat16)/8\nwu=torch.randn(E,H,I,device='cuda',dtype=torch.bfloat16)/8\nwd=torch.randn(E,I,H,device='cuda',dtype=torch.bfloat16)/6\n# Generic reference equivalent.\ndef ref():\n C=max(int((N*K/E)*1.25),1); fe=sel.flatten(); fw=rw.flatten(); ft=torch.arange(N,device='cuda').repeat_interleave(K); se,si=fe.sort(stable=True); sw=fw[si]; st=ft[si]; cnt=torch.bincount(se,minlength=E); starts=torch.zeros(E,dtype=torch.long,device='cuda'); starts[1:]=cnt[:-1].cumsum(0); wp=torch.arange(N*K,device='cuda')-starts[se]; v=wp<C; ve=se[v]; vp=wp[v]; vt=st[v]; vw=sw[v]; inp=torch.zeros(E,C,H,dtype=torch.bfloat16,device='cuda'); inp[ve,vp]=x[vt]; o=(torch.nn.functional.silu(inp@wg)*(inp@wu))@wd; z=torch.zeros_like(x); z.index_add_(0,vt,vw[:,None]*o[ve,vp]); return z\na=kernel.run(x,sel,rw,wg,wu,wd); b=ref(); torch.cuda.synchronize()\nprint(a.shape, (a-b).abs().max().item(), torch.isclose(a,b,atol=.02,rtol=.4).float().mean().item())\nprint(a[0,:8]); print(b[0,:8])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
