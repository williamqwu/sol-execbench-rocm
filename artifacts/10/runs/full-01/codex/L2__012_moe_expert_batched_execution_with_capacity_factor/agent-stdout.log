{"type":"item.started","item":{"id":"item_76","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport torch, kernel\nN,E,K,H,I=16,8,8,64,32; torch.manual_seed(3)\nx=torch.randn(N,H,device='cuda',dtype=torch.bfloat16); sel=torch.stack([torch.randperm(E,device='cuda')[:K] for _ in range(N)]); rw=torch.softmax(torch.randn(N,K,device='cuda').float(),-1).bfloat16(); wg=torch.randn(E,H,I,device='cuda',dtype=torch.bfloat16)/8; wu=torch.randn_like(wg)/8; wd=torch.randn(E,I,H,device='cuda',dtype=torch.bfloat16)/6\ndef ref():\n C=max(int((N*K/E)*1.25),1); fe=sel.flatten(); ft=torch.arange(N,device='cuda').repeat_interleave(K); sx,si=fe.sort(stable=True); st=ft[si]; sw=rw.flatten()[si]; cnt=torch.bincount(sx,minlength=E); starts=torch.zeros(E,dtype=torch.long,device='cuda'); starts[1:]=cnt[:-1].cumsum(0); p=torch.arange(N*K,device='cuda')-starts[sx]; v=p<C; inp=torch.zeros(E,C,H,dtype=torch.bfloat16,device='cuda'); inp[sx[v],p[v]]=x[st[v]]; o=(torch.nn.functional.silu(inp@wg)*(inp@wu))@wd; z=torch.zeros_like(x); z.index_add_(0,st[v],sw[v,None]*o[sx[v],p[v]]); return z\na=kernel.run(x,sel,rw,wg,wu,wd);b=ref();torch.cuda.synchronize();print((a-b).abs().max().item(),torch.isclose(a,b,atol=.02,rtol=.4).float().mean().item())\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
