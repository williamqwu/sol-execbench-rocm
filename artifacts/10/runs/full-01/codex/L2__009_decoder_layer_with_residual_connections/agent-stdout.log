{"type":"item.started","item":{"id":"item_41","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch,time,concurrent.futures\nD='cuda';torch.manual_seed(10);E=128;total=8192;H=2048;I=768\nids=torch.randint(0,E,(total,),device=D);ids,_=torch.sort(ids,stable=True);counts=torch.bincount(ids,minlength=E).to(torch.int32);offs=counts.cumsum(0,dtype=torch.int32);cl=counts.cpu().tolist();starts=[0];\nfor c in cl:starts.append(starts[-1]+c)\nx=torch.randn(total,H,device=D);wg=torch.randn(E,I,H,device=D);wu=torch.randn_like(wg);wd=torch.randn(E,H,I,device=D);rw=torch.rand(total,1,device=D)\n# reference current approach\ndef grouped():\n g=torch.ops.aten._grouped_mm(x,wg.transpose(1,2),offs);u=torch.ops.aten._grouped_mm(x,wu.transpose(1,2),offs);z=torch.nn.functional.silu(g)*u;z=torch.ops.aten._grouped_mm(z,wd.transpose(1,2),offs);return z*rw\nNW=8; streams=[torch.cuda.Stream() for _ in range(NW)];pool=concurrent.futures.ThreadPoolExecutor(NW)\ndef threaded():\n out=torch.empty(total,H,device=D);main=torch.cuda.current_stream()\n for s in streams:s.wait_stream(main)\n def work(wid):\n  with torch.cuda.stream(streams[wid]):\n   for e in range(wid,E,NW):\n    a,b=starts[e],starts[e+1]\n    if b>a:\n     cur=x[a:b];g=torch.nn.functional.linear(cur,wg[e]);u=torch.nn.functional.linear(cur,wu[e]);z=torch.nn.functional.silu(g)*u;z=torch.nn.functional.linear(z,wd[e]);out[a:b].copy_(z*rw[a:b])\n fs=[pool.submit(work,i) for i in range(NW)]\n for f in fs:f.result()\n for s in streams:main.wait_stream(s)\n return out\nref=grouped();y=threaded();torch.cuda.synchronize();d=(ref-y).abs();print('equal',torch.equal(ref,y),d.max().item(),torch.count_nonzero(d).item())\nfor fn in (grouped,threaded):\n ts=[]\n for rep in range(8):\n  torch.cuda.synchronize();t=time.perf_counter();z=fn();torch.cuda.synchronize();ts.append((time.perf_counter()-t)*1e3)\n print(fn.__name__,ts)\npool.shutdown()\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
