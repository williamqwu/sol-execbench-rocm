{"type":"item.started","item":{"id":"item_20","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch, time\nD='cuda'; torch.manual_seed(3); N=1024; H=2048; E=128; K=8\n# unique expert ids per token, like topk\nselected=torch.rand(N,E,device=D).topk(K,dim=1).indices\nroute_experts=selected.T.contiguous().view(-1)\norder=torch.argsort(route_experts,stable=True)\nslot=torch.div(order,N,rounding_mode='floor'); token=order.remainder(N)\ncontrib=torch.randn(N*K,H,device=D)\n# contribution is in sorted expert order\nref=torch.zeros(N,H,device=D)\ncounts=torch.bincount(route_experts,minlength=E).cpu().tolist(); s=0\nfor e,c in enumerate(counts):\n ref.index_add_(0,token[s:s+c],contrib[s:s+c]); s+=c\n# rank/scatter approach\nslot_order=torch.argsort(selected,dim=1,stable=True)\nrank_by_slot=torch.empty_like(slot_order)\nrank_by_slot.scatter_(1,slot_order,torch.arange(K,device=D).expand(N,K))\nrank=rank_by_slot[token,slot]\nranked=torch.empty((K,N,H),device=D)\nranked[rank,token]=contrib\nout=torch.zeros_like(ref)\nfor r in range(K): out.add_(ranked[r])\ntorch.cuda.synchronize(); d=(out-ref).abs()\nprint('equal',torch.equal(out,ref),'max',d.max().item(),'different',torch.count_nonzero(d).item())\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
