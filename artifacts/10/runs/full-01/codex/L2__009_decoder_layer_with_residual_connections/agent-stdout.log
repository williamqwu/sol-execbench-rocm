{"type":"item.started","item":{"id":"item_36","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch, time\nimport reference, kernel\nargs=reference.get_inputs({'batch_size':1,'seq_len':128},torch.device('cuda')); vals=list(args.values())\nref=reference.run(*vals); out=kernel.run(*vals); torch.cuda.synchronize()\nd=(out-ref).abs(); print('equal',torch.equal(out,ref),'max',d.max().item(),'different',torch.count_nonzero(d).item(),'total',d.numel())\n# Measure only the two exact accumulation implementations on representative data.\nN,H,E,K=4096,2048,128,8\nselected=torch.rand(N,E,device='cuda').topk(K,dim=1).indices\nrex=selected.T.contiguous().view(-1); order=torch.argsort(rex,stable=True); slot=torch.div(order,N,rounding_mode='floor'); token=order.remainder(N)\ncontrib=torch.randn(N*K,H,device='cuda')\nslot_order=torch.argsort(selected,dim=1,stable=True)\ninv=torch.empty_like(order);inv[order]=torch.arange(order.numel(),device='cuda')\ntri=torch.empty(N,H,device='cuda'); kernel._accumulate_routes[(N,triton_cdiv:=8)](contrib,inv,slot_order,tri,N,HIDDEN=H,BLOCK=256,num_warps=4)\nrank_by_slot=torch.empty_like(slot_order);rank_by_slot.scatter_(1,slot_order,torch.arange(K,device='cuda').expand_as(slot_order)); rank=rank_by_slot[token,slot]\nranked=torch.empty(K,N,H,device='cuda');ranked[rank,token]=contrib\nold=torch.zeros(N,H,device='cuda')\nfor r in range(K):old.add_(ranked[r])\ntorch.cuda.synchronize();dd=(tri-old).abs();print('acc_equal',torch.equal(tri,old),'max',dd.max().item(),'different',torch.count_nonzero(dd).item())\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
