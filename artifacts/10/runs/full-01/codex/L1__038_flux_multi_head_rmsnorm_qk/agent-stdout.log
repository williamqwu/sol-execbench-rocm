{"type":"item.started","item":{"id":"item_36","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch,triton\nfrom kernel import _rmsnorm_qk_kernel,_tiled_head_rmsnorm_qk_kernel\n\ndef test(tokens):\n shape=(tokens,48,128);q=torch.randn(shape,device='cuda');k=torch.randn(shape,device='cuda');wq=torch.randn((48,128),device='cuda');wk=torch.randn((48,128),device='cuda');oq=torch.empty_like(q);ok=torch.empty_like(k);rows=q.numel()//128\n def launch(tile):\n  if tile==0:_rmsnorm_qk_kernel[(rows,)](q,k,wq,wk,oq,ok,eps=1e-6,HEAD_DIM=128,LOAD_CG=0,STORE_CS=1,SEQUENTIAL=False,WEIGHT_LAST=False,num_warps=1)\n  else:_tiled_head_rmsnorm_qk_kernel[(48*tile,triton.cdiv(tokens,tile))](q,k,wq,wk,oq,ok,tokens,eps=1e-6,HEAD_DIM=128,TOKEN_TILE=tile,num_warps=1)\n def bench(tile):\n  for _ in range(20):launch(tile)\n  torch.cuda.synchronize();v=[]\n  reps=100 if tokens>=1024 else 300\n  for _ in range(5):\n   a=torch.cuda.Event(enable_timing=True);b=torch.cuda.Event(enable_timing=True);a.record()\n   for _ in range(reps):launch(tile)\n   b.record();b.synchronize();v.append(a.elapsed_time(b)/reps)\n  return sorted(v)\n for tile in [0,1,2,4,8,16,32]:\n  v=bench(tile);print(tokens,tile,v,v[2])\nfor t in [1024,8192]:test(t)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
