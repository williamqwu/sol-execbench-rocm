{"type":"item.started","item":{"id":"item_22","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch\nfrom kernel import _rmsnorm_qk_kernel\n\ntokens=8192; shape=(1,tokens,48,128)\nq=torch.randn(shape,device='cuda'); k=torch.randn(shape,device='cuda')\nwq=torch.randn((48,128),device='cuda'); wk=torch.randn((48,128),device='cuda')\nrows=q.numel()//128\n\ndef launch(oq,ok):\n _rmsnorm_qk_kernel[(rows,)](q,k,wq,wk,oq,ok,eps=1e-6,HEAD_DIM=128,\n   LOAD_CG=False,STORE_CS=1,SEQUENTIAL=False,num_warps=1)\ndef two():\n oq=torch.empty_like(q);ok=torch.empty_like(k);launch(oq,ok);return oq,ok\ndef combined():\n both=torch.empty((2,*q.shape),device=q.device,dtype=q.dtype)\n oq=both[0];ok=both[1];launch(oq,ok);return oq,ok\n\ndef bench(fn):\n x=None\n for _ in range(30):x=fn()\n torch.cuda.synchronize(); vals=[]\n for _ in range(11):\n  a=torch.cuda.Event(enable_timing=True);b=torch.cuda.Event(enable_timing=True);a.record()\n  for _ in range(100):x=fn()\n  b.record();b.synchronize();vals.append(a.elapsed_time(b)/100)\n return sorted(vals)\nfor fn in [two,combined]:\n v=bench(fn);print(fn.__name__,v,'median',v[5])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
