{"type":"item.started","item":{"id":"item_14","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch\nfrom kernel import _rmsnorm_qk_kernel\n\ndevice = 'cuda:0'\ntokens = 8192\nshape = (tokens, 48, 128)\nq = torch.randn(shape, device=device)\nk = torch.randn(shape, device=device)\nwq = torch.randn((48, 128), device=device)\nwk = torch.randn((48, 128), device=device)\noq = torch.empty_like(q)\nok = torch.empty_like(k)\nrows = q.numel() // 128\n\ndef launch(load_cg, store_cs, waves=1):\n    _rmsnorm_qk_kernel[(rows,)](q, k, wq, wk, oq, ok, eps=1e-6,\n        HEAD_DIM=128, LOAD_CG=load_cg, STORE_CS=store_cs,\n        num_warps=1, waves_per_eu=waves)\n\nfor load_cg, store_cs, waves in [\n    (False, False, 1), (True, False, 1),\n    (False, True, 1), (True, True, 1),\n    (False, False, 2), (False, False, 3), (False, False, 4),\n]:\n    try:\n        for _ in range(20):\n            launch(load_cg, store_cs, waves)\n        torch.cuda.synchronize()\n        start = torch.cuda.Event(enable_timing=True)\n        end = torch.cuda.Event(enable_timing=True)\n        samples = []\n        for _ in range(7):\n            start.record()\n            for _ in range(100):\n                launch(load_cg, store_cs, waves)\n            end.record()\n            end.synchronize()\n            samples.append(start.elapsed_time(end) / 100)\n        print(load_cg, store_cs, waves, sorted(samples), 'median', sorted(samples)[3])\n    except Exception as exc:\n        print(load_cg, store_cs, waves, type(exc).__name__, exc)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
