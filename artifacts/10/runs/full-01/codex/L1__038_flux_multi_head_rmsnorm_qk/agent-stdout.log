{"type":"item.started","item":{"id":"item_15","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch\nfrom kernel import _rmsnorm_qk_kernel\n\ntokens = 8192\nshape = (tokens, 48, 128)\nq = torch.randn(shape, device='cuda:0')\nk = torch.randn(shape, device='cuda:0')\nwq = torch.randn((48, 128), device='cuda:0')\nwk = torch.randn((48, 128), device='cuda:0')\noq = torch.empty_like(q)\nok = torch.empty_like(k)\nrows = q.numel() // 128\n\ndef launch(load_cg, store_cs, waves=None):\n    kw = dict(eps=1e-6, HEAD_DIM=128, LOAD_CG=load_cg,\n              STORE_CS=store_cs, num_warps=1)\n    if waves is not None:\n        kw['waves_per_eu'] = waves\n    _rmsnorm_qk_kernel[(rows,)](q, k, wq, wk, oq, ok, **kw)\n\ndef bench(config):\n    for _ in range(30): launch(*config)\n    torch.cuda.synchronize()\n    vals=[]\n    for _ in range(9):\n        a=torch.cuda.Event(enable_timing=True); b=torch.cuda.Event(enable_timing=True)\n        a.record()\n        for _ in range(100): launch(*config)\n        b.record(); b.synchronize(); vals.append(a.elapsed_time(b)/100)\n    return sorted(vals)\n\nconfigs = [(False,False,None),(True,False,None),(False,True,None),(True,True,None),\n           (False,False,5),(False,False,6),(False,False,8)]\nfor c in configs:\n    try:\n        v=bench(c)\n        print(c, v, 'median',v[len(v)//2])\n    except Exception as e: print(c,type(e).__name__,e)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
