{"type":"item.started","item":{"id":"item_7","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch, statistics\nfrom reference import get_inputs\nimport kernel\n\ntorch.set_grad_enabled(False)\nside = torch.cuda.Stream()\n\ndef overlap(timestep, pooled, freqs, w1, b1, w2, b2, wt, bt):\n    main = torch.cuda.current_stream()\n    side.wait_stream(main)\n    with torch.cuda.stream(side):\n        text = torch.nn.functional.linear(pooled, wt, bt)\n    args = (timestep * 1000.0)[:, None] * freqs[None, :]\n    te = torch.cat((torch.cos(args), torch.sin(args)), dim=-1)\n    x = torch.nn.functional.linear(te, w1, b1)\n    x = x * torch.sigmoid(x)\n    te = torch.nn.functional.linear(x, w2, b2)\n    main.wait_stream(side)\n    text.record_stream(main)\n    return te + text\n\ndef measure(fn, vals):\n    for _ in range(10): fn(*vals)\n    torch.cuda.synchronize()\n    starts = [torch.cuda.Event(enable_timing=True) for _ in range(100)]\n    ends = [torch.cuda.Event(enable_timing=True) for _ in range(100)]\n    for s,e in zip(starts, ends):\n        s.record()\n        fn(*vals)\n        e.record()\n    torch.cuda.synchronize()\n    ts = [s.elapsed_time(e)*1000 for s,e in zip(starts,ends)]\n    return statistics.median(ts), sum(ts)/len(ts)\n\nfor B in [1,2,5,12,20,37,59]:\n    d = get_inputs(dict(batch_size=B,inner_dim=3072,pooled_projection_dim=768,time_embed_dim=768,half_time_embed_dim=384), torch.device('cuda'))\n    vals = tuple(d.values())\n    a = kernel.run(*vals)\n    b = overlap(*vals)\n    torch.cuda.synchronize()\n    print(B, torch.equal(a,b), measure(kernel.run,vals), measure(overlap,vals))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
