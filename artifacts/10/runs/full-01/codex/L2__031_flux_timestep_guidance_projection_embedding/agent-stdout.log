{"type":"item.started","item":{"id":"item_23","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch, triton, statistics\nfrom reference import get_inputs, run as reference_run\nfrom kernel import _timestep_embedding_kernel, _silu_libdevice_kernel\n\ntorch.set_grad_enabled(False)\ndef run2(t,p,f,w1,b1,w2,b2,wt,bt):\n te=torch.empty((t.shape[0],768),device=t.device); _timestep_embedding_kernel[(t.shape[0],)](t,f,te,BLOCK=512,num_warps=1)\n x=torch.nn.functional.linear(te,w1,b1); _silu_libdevice_kernel[(triton.cdiv(x.numel(),256),)](x,n_elements=x.numel(),BLOCK=256,num_warps=4)\n te=torch.nn.functional.linear(x,w2,b2); text=torch.nn.functional.linear(p,wt,bt); return te+text\ndef measure(fn,v,reps=100):\n for _ in range(10): fn(*v)\n torch.cuda.synchronize(); ss=[torch.cuda.Event(enable_timing=True) for _ in range(reps)]; es=[torch.cuda.Event(enable_timing=True) for _ in range(reps)]\n for s,e in zip(ss,es): s.record();fn(*v);e.record()\n torch.cuda.synchronize(); z=[s.elapsed_time(e)*1000 for s,e in zip(ss,es)];return statistics.median(z)\nfor B in [1,2,5,12,20,37,59]:\n d=get_inputs(dict(batch_size=B,inner_dim=3072,pooled_projection_dim=768,time_embed_dim=768,half_time_embed_dim=384),torch.device('cuda'));v=tuple(d.values());ref=reference_run(*v);got=run2(*v);torch.cuda.synchronize(); diff=(ref-got).abs();tol=7.2e-8+1.1920928955078125e-7*ref.abs()\n a=(v[0]*1000)[:,None]*v[2][None,:]; ee=torch.cat((torch.cos(a),torch.sin(a)),1); x=torch.nn.functional.linear(ee,v[3],v[4]); xs=x*torch.sigmoid(x); xt=x.clone();_silu_libdevice_kernel[(triton.cdiv(x.numel(),256),)](xt,n_elements=x.numel(),BLOCK=256,num_warps=4);torch.cuda.synchronize(); sd=(xs-xt).abs()\n print(B,'silu exact',float((sd==0).float().mean()),float(sd.max()),'final',float((diff<=tol).float().mean()),float(diff.max()),'us',measure(run2,v))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
