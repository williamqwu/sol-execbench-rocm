{"type":"item.started","item":{"id":"item_17","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch, triton, statistics\nfrom kernel import _timestep_embedding_kernel as rowk, _timestep_embedding_flat_kernel as flatk\n\ndef med_launch(call,reps=200):\n for _ in range(10): call()\n torch.cuda.synchronize(); ss=[torch.cuda.Event(enable_timing=True) for _ in range(reps)]; es=[torch.cuda.Event(enable_timing=True) for _ in range(reps)]\n for s,e in zip(ss,es): s.record(); call(); e.record()\n torch.cuda.synchronize(); z=[s.elapsed_time(e)*1000 for s,e in zip(ss,es)]; return round(statistics.median(z),2)\nfor B in [1,2,5,12,20,37,59]:\n t=torch.rand(B,device='cuda'); f=torch.rand(384,device='cuda'); o=torch.empty(B,768,device='cuda')\n vals={}\n for w in [1,2,4,8]: vals[f'r{w}']=med_launch(lambda w=w: rowk[(B,)](t,f,o,BLOCK=512,num_warps=w))\n for block,w in [(128,1),(128,2),(128,4),(256,1),(256,2),(256,4),(512,2),(512,4),(512,8)]:\n  vals[f'f{block}w{w}']=med_launch(lambda block=block,w=w: flatk[(triton.cdiv(B*384,block),)](t,f,o,n_elements=B*384,BLOCK=block,num_warps=w))\n print(B,vals)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
