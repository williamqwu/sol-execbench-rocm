{"type":"item.started","item":{"id":"item_11","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch, triton, triton.language as tl, statistics\nfrom reference import get_inputs\n\ntorch.set_grad_enabled(False)\n\n@triton.jit\ndef emb_kernel(t, f, out, B: tl.constexpr, BLOCK: tl.constexpr):\n    row = tl.program_id(0)\n    j = tl.arange(0, BLOCK)\n    m = j < 384\n    ts = tl.load(t + row) * 1000.0\n    a = ts * tl.load(f + j, mask=m, other=0.0)\n    tl.store(out + row * 768 + j, tl.cos(a), mask=m)\n    tl.store(out + row * 768 + 384 + j, tl.sin(a), mask=m)\n\n@triton.jit\ndef silu_kernel(x, n: tl.constexpr, BLOCK: tl.constexpr):\n    i = tl.program_id(0) * BLOCK + tl.arange(0, BLOCK)\n    m = i < n\n    v = tl.load(x+i, mask=m)\n    tl.store(x+i, v * tl.sigmoid(v), mask=m)\n\ndef emb(t,f):\n    o=torch.empty((t.shape[0],768),device=t.device,dtype=t.dtype)\n    emb_kernel[(t.shape[0],)](t,f,o,B=t.shape[0],BLOCK=512,num_warps=8)\n    return o\n\ndef eager_emb(t,f):\n    args=(t*1000.0)[:,None]*f[None,:]\n    return torch.cat((torch.cos(args),torch.sin(args)),dim=-1)\n\ndef tri_run(timestep, pooled, freqs, w1,b1,w2,b2,wt,bt):\n    te=emb(timestep,freqs)\n    x=torch.nn.functional.linear(te,w1,b1)\n    silu_kernel[(triton.cdiv(x.numel(),256),)](x,n=x.numel(),BLOCK=256,num_warps=4)\n    te=torch.nn.functional.linear(x,w2,b2)\n    text=torch.nn.functional.linear(pooled,wt,bt)\n    return te+text\n\ndef eager_run(timestep, pooled, freqs, w1,b1,w2,b2,wt,bt):\n    te=eager_emb(timestep,freqs)\n    x=torch.nn.functional.linear(te,w1,b1)\n    x=x*torch.sigmoid(x)\n    te=torch.nn.functional.linear(x,w2,b2)\n    text=torch.nn.functional.linear(pooled,wt,bt)\n    return te+text\n\ndef measure(fn, vals, reps=100):\n    for _ in range(10): fn(*vals)\n    torch.cuda.synchronize()\n    ss=[torch.cuda.Event(enable_timing=True) for _ in range(reps)]\n    es=[torch.cuda.Event(enable_timing=True) for _ in range(reps)]\n    for s,e in zip(ss,es): s.record(); fn(*vals); e.record()\n    torch.cuda.synchronize(); ts=[s.elapsed_time(e)*1000 for s,e in zip(ss,es)]\n    return statistics.median(ts),sum(ts)/len(ts)\n\nfor B in [1,2,5,12,20,37,59]:\n d=get_inputs(dict(batch_size=B,inner_dim=3072,pooled_projection_dim=768,time_embed_dim=768,half_time_embed_dim=384),torch.device('cuda'))\n v=tuple(d.values()); ref=eager_run(*v); got=tri_run(*v); torch.cuda.synchronize()\n diff=(ref-got).abs(); tol=7.2e-8+1.1920928955078125e-7*ref.abs()\n er=eager_emb(v[0],v[2]); et=emb(v[0],v[2]); ed=(er-et).abs()\n x=torch.nn.functional.linear(er,v[3],v[4]); xs=x*torch.sigmoid(x); xt=x.clone(); silu_kernel[(triton.cdiv(xt.numel(),256),)](xt,n=xt.numel(),BLOCK=256,num_warps=4); torch.cuda.synchronize(); sd=(xs-xt).abs()\n print(B,'ratio',float((diff<=tol).float().mean()),'max',float(diff.max()),'emb nz',float((ed\"'!=0).float().mean()),float(ed.max()),'\"'silu nz',float((sd\"'!=0).float().mean()),float(sd.max()),'\"'time',measure(eager_run,v),measure(tri_run,v))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
