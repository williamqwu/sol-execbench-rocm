{"type":"item.started","item":{"id":"item_14","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch, triton, statistics\nfrom reference import get_inputs, run as reference_run\nfrom kernel import _timestep_embedding_kernel, _silu_kernel\n\ntorch.set_grad_enabled(False)\ndef embed(t,f):\n o=torch.empty((t.shape[0],768),device=t.device,dtype=t.dtype); _timestep_embedding_kernel[(t.shape[0],)](t,f,o,BLOCK=512,num_warps=8); return o\ndef eager_embed(t,f):\n a=(t*1000.0)[:,None]*f[None,:]; return torch.cat((torch.cos(a),torch.sin(a)),dim=-1)\ndef variant(v, ekind, skind):\n t,p,f,w1,b1,w2,b2,wt,bt=v\n te=embed(t,f) if ekind else eager_embed(t,f)\n x=torch.nn.functional.linear(te,w1,b1)\n if skind==1: _silu_kernel[(triton.cdiv(x.numel(),256),)](x,n_elements=x.numel(),BLOCK=256,num_warps=4)\n elif skind==2: x=torch.nn.functional.silu(x)\n else: x=x*torch.sigmoid(x)\n te=torch.nn.functional.linear(x,w2,b2); text=torch.nn.functional.linear(p,wt,bt); return te+text\ndef measure(fn,reps=100):\n for _ in range(10): fn()\n torch.cuda.synchronize(); ss=[torch.cuda.Event(enable_timing=True) for _ in range(reps)]; es=[torch.cuda.Event(enable_timing=True) for _ in range(reps)]\n for s,e in zip(ss,es): s.record(); fn(); e.record()\n torch.cuda.synchronize(); z=[s.elapsed_time(e)*1000 for s,e in zip(ss,es)]; return statistics.median(z)\nfor B in [1,20,59]:\n d=get_inputs(dict(batch_size=B,inner_dim=3072,pooled_projection_dim=768,time_embed_dim=768,half_time_embed_dim=384),torch.device('cuda')); v=tuple(d.values()); ref=reference_run(*v)\n ee=eager_embed(v[0],v[2]); ce=embed(v[0],v[2]); torch.cuda.synchronize(); ed=(ee-ce).abs()\n x=torch.nn.functional.linear(ee,v[3],v[4]); s0=x*torch.sigmoid(x); s1=x.clone(); _silu_kernel[(triton.cdiv(x.numel(),256),)](s1,n_elements=x.numel(),BLOCK=256,num_warps=4); s2=torch.nn.functional.silu(x); torch.cuda.synchronize()\n print('B',B,'embed nz/max',float((ed\"'!=0).float().mean()),float(ed.max()),'\"'custom silu nz/max',float((s0-s1\"'!=0).float().mean()),float((s0-s1).abs().max()),'\"'F silu nz/max',float((s0-s2\"'!=0).float().mean()),float((s0-s2).abs().max()))\n for ek,sk in [(0,0),(1,0),(0,1),(1,1),(0,2),(1,2)]:\n  got=variant(v,ek,sk); torch.cuda.synchronize(); diff=(ref-got).abs(); tol=7.2e-8+1.1920928955078125e-7*ref.abs(); print((ek,sk),float((diff<=tol).float().mean()),float(diff.max()),measure(lambda:variant(v,ek,sk)))\nPY'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
