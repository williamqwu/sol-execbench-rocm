{"type":"item.started","item":{"id":"item_16","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch, time\nB,S,H=1,128,5120\nd='cuda:0'\ng=torch.randn(B,S,H,device=d,dtype=torch.bfloat16)\nr=torch.randn(B,S,H,device=d,dtype=torch.bfloat16)\nw=torch.randn(H,device=d,dtype=torch.bfloat16)\nv=torch.rand(B,S,1,device=d,dtype=torch.float32)\nh=torch.randn(B,S,H,device=d,dtype=torch.float32)\na=torch.randn(B,S,H,device=d,dtype=torch.bfloat16)\ndef eager(g,r,w,v,h,a):\n    gf=g.float(); gw=(gf*h).sum((0,1)); rv=torch.rsqrt(v+1e-6); gn=gf*w.float(); gh=gn*rv; vv=-0.5*(gn*r.float()).sum(-1,keepdim=True)*rv.pow(3); gh=gh+(2.0/H)*r.float()*vv; return a+gh.to(r.dtype),gw\ncompiled=torch.compile(eager,fullgraph=True,dynamic=True)\ne=eager(g,r,w,v,h,a)\nc=compiled(g,r,w,v,h,a)\ntorch.cuda.synchronize()\nfor x,y in zip(c,e): print(float((x.float()-y.float()).abs().max()), float((x==y).float().mean()))\nfor fn in (eager,compiled):\n    for _ in range(3): fn(g,r,w,v,h,a)\n    torch.cuda.synchronize(); st=torch.cuda.Event(True); en=torch.cuda.Event(True); st.record()\n    for _ in range(20): fn(g,r,w,v,h,a)\n    en.record(); en.synchronize(); print(fn,st.elapsed_time(en)/20)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
