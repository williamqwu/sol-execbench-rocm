{"type":"item.started","item":{"id":"item_14","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport torch\nimport torch.nn.functional as F\n\ndef naive(q,k,v,m,s):\n k=k[:,:,None].expand(q.shape[0],8,5,q.shape[2],128).reshape(q.shape[0],40,q.shape[2],128)\n v=v[:,:,None].expand(q.shape[0],8,5,q.shape[2],128).reshape(q.shape[0],40,q.shape[2],128)\n a=torch.matmul(q,k.transpose(2,3))*s\n a=F.softmax(a+m,dim=-1,dtype=torch.float32).to(torch.bfloat16)\n return torch.matmul(a,v)\ndef sdpa(q,k,v,m,s):\n return F.scaled_dot_product_attention(q,k,v,attn_mask=m,scale=s,enable_gqa=True)\ndef bench(fn,it):\n for _ in range(2): y=fn()\n torch.cuda.synchronize(); a=torch.cuda.Event(True);b=torch.cuda.Event(True);a.record()\n for _ in range(it):y=fn()\n b.record();b.synchronize();return a.elapsed_time(b)/it,y\nfor S in [131,512,997,2048]:\n B=1\n q=torch.randn(B,40,S,128,device='cuda',dtype=torch.bfloat16)\n k=torch.randn(B,8,S,128,device='cuda',dtype=torch.bfloat16)\n v=torch.randn(B,8,S,128,device='cuda',dtype=torch.bfloat16)\n m=torch.randn(B,1,S,S,device='cuda',dtype=torch.bfloat16)\n try:\n  tn,yn=bench(lambda:naive(q,k,v,m,0.08838834764831845),5)\n  ts,ys=bench(lambda:sdpa(q,k,v,m,0.08838834764831845),5)\n  d=(yn.float()-ys.float()).abs(); ok=((d<=0.0092)|(d<=0.0078125*yn.float().abs())).float().mean().item()\n  print(S,tn,ts,'dtype',ys.dtype,'max',d.max().item(),'mean',d.mean().item(),'ratio',ok)\n except Exception as e: print(S,'ERROR',repr(e))\n del q,k,v,m\n torch.cuda.empty_cache()\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
