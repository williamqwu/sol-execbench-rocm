{"type":"item.started","item":{"id":"item_43","type":"command_execution","command":"/bin/bash -lc \"python3 -u - <<'PY'\nimport torch\nimport torch.nn.functional as F\nfrom flash_attn import attention\n\ndef naive(q,k0,v0,m):\n B,H,S,D=q.shape\n k=k0[:,:,None].expand(B,8,5,S,D).reshape(B,40,S,D);v=v0[:,:,None].expand(B,8,5,S,D).reshape(B,40,S,D)\n a=torch.matmul(q,k.transpose(2,3))*.08838834764831845\n a=F.softmax(a+m,dim=-1,dtype=torch.float32).to(torch.bfloat16)\n return torch.matmul(a,v)\ndef fasttorch(q,k0,v0,m):\n B,H,S,D=q.shape\n k=k0[:,:,None].expand(B,8,5,S,D).reshape(B,40,S,D);v=v0[:,:,None].expand(B,8,5,S,D).reshape(B,40,S,D)\n return F.scaled_dot_product_attention(q,k,v,attn_mask=m,scale=.08838834764831845)\ndef bench(fn,it=10):\n for _ in range(2):y=fn()\n torch.cuda.synchronize();a=torch.cuda.Event(True);b=torch.cuda.Event(True);a.record()\n for _ in range(it):y=fn()\n b.record();b.synchronize();return a.elapsed_time(b)/it,y\nfor S in [131,512,997,2048,8192]:\n B=1;q=torch.randn(B,40,S,128,device='cuda',dtype=torch.bfloat16);k=torch.randn(B,8,S,128,device='cuda',dtype=torch.bfloat16);v=torch.randn_like(k);m=torch.randn(B,1,S,S,device='cuda',dtype=torch.bfloat16)\n it=5 if S<8192 else 2\n tn,yn=bench(lambda:naive(q,k,v,m),it);tt,yt=bench(lambda:fasttorch(q,k,v,m),it)\n print('base',S,tn,tt,flush=True)\n for bm,bn,nw in [(64,64,4),(64,128,4),(64,64,8),(128,64,8)]:\n  try:\n   tx,y=bench(lambda:attention(q,k,v,m,.08838834764831845,bm,bn,nw),it)\n   d=(yn.float()-y.float()).abs();ok=((d<=.0092)|(d<=.0078125*yn.float().abs())).float().mean().item()\n   dt=(yt.float()-y.float()).abs();okt=((dt<=.0092)|(dt<=.0078125*yt.float().abs())).float().mean().item()\n   print('tri',S,bm,bn,nw,tx,'naive',d.max().item(),d.mean().item(),ok,'torch',okt,flush=True)\n  except Exception as e:print('ERR',S,bm,bn,nw,repr(e),flush=True)\n del q,k,v,m,yn,yt;torch.cuda.empty_cache()\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
