{"type":"item.started","item":{"id":"item_39","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport torch\nimport torch.nn.functional as F\ns1=torch.cuda.Stream();s2=torch.cuda.Stream()\ndef qseq(x,wq,wk,wv):return F.linear(x,wq),F.linear(x,wk),F.linear(x,wv)\ndef qpar(x,wq,wk,wv):\n c=torch.cuda.current_stream();s1.wait_stream(c);s2.wait_stream(c)\n q=F.linear(x,wq)\n with torch.cuda.stream(s1):k=F.linear(x,wk)\n with torch.cuda.stream(s2):v=F.linear(x,wv)\n c.wait_stream(s1);c.wait_stream(s2)\n return q,k,v\ndef gseq(x,wg,wu):return F.linear(x,wg),F.linear(x,wu)\ndef gpar(x,wg,wu):\n c=torch.cuda.current_stream();s1.wait_stream(c)\n g=F.linear(x,wg)\n with torch.cuda.stream(s1):u=F.linear(x,wu)\n c.wait_stream(s1);return g,u\ndef bench(fn,it=20):\n for _ in range(3):y=fn()\n torch.cuda.synchronize();a=torch.cuda.Event(True);b=torch.cuda.Event(True);a.record()\n for _ in range(it):y=fn()\n b.record();b.synchronize();return a.elapsed_time(b)/it\nwq=torch.randn(5120,5120,device='cuda',dtype=torch.bfloat16);wk=torch.randn(1024,5120,device='cuda',dtype=torch.bfloat16);wv=torch.randn_like(wk)\nfor M in [131,512,2048,8192]:\n x=torch.randn(M,5120,device='cuda',dtype=torch.bfloat16)\n print('qkv',M,bench(lambda:qseq(x,wq,wk,wv),10),bench(lambda:qpar(x,wq,wk,wv),10));del x\nwg=torch.randn(17408,5120,device='cuda',dtype=torch.bfloat16);wu=torch.randn_like(wg)\nfor M in [131,512,2048,8192]:\n x=torch.randn(M,5120,device='cuda',dtype=torch.bfloat16)\n print('gu',M,bench(lambda:gseq(x,wg,wu),10),bench(lambda:gpar(x,wg,wu),10));del x\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.started","item":{"id":"item_40","type":"command_execution","command":"/bin/bash -lc \"python3 -u - <<'PY'\nimport torch\nimport torch.nn.functional as F\ns1=torch.cuda.Stream();s2=torch.cuda.Stream()\ndef par3(x,a,b,d):\n c=torch.cuda.current_stream();s1.wait_stream(c);s2.wait_stream(c)\n y=F.linear(x,a)\n with torch.cuda.stream(s1):z=F.linear(x,b)\n with torch.cuda.stream(s2):w=F.linear(x,d)\n c.wait_stream(s1);c.wait_stream(s2);return y,z,w\ndef par2(x,a,b):\n c=torch.cuda.current_stream();s1.wait_stream(c);y=F.linear(x,a)\n with torch.cuda.stream(s1):z=F.linear(x,b)\n c.wait_stream(s1);return y,z\ndef bench(fn,it=10):\n for _ in range(2):q=fn()\n torch.cuda.synchronize();a=torch.cuda.Event(True);b=torch.cuda.Event(True);a.record()\n for _ in range(it):q=fn()\n b.record();b.synchronize();return a.elapsed_time(b)/it\nwq=torch.randn(5120,5120,device='cuda',dtype=torch.bfloat16);wk=torch.randn(1024,5120,device='cuda',dtype=torch.bfloat16);wv=torch.randn_like(wk)\nfor M in [131,512,2048,8192]:\n x=torch.randn(M,5120,device='cuda',dtype=torch.bfloat16)\n print('qkv',M,bench(lambda:(F.linear(x,wq),F.linear(x,wk),F.linear(x,wv))),bench(lambda:par3(x,wq,wk,wv)),flush=True)\ndel wq,wk,wv;torch.cuda.empty_cache()\nwg=torch.randn(17408,5120,device='cuda',dtype=torch.bfloat16);wu=torch.randn_like(wg)\nfor M in [131,512,2048,8192]:\n x=torch.randn(M,5120,device='cuda',dtype=torch.bfloat16)\n print('gu',M,bench(lambda:(F.linear(x,wg),F.linear(x,wu))),bench(lambda:par2(x,wg,wu)),flush=True)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
