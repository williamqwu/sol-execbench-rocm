{"type":"item.started","item":{"id":"item_34","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport torch\n\ndef rope_e(q,k,p,inv):\n B=p.shape[0]\n f=(inv[None,:,None].float().expand(B,-1,1)@p[:,None,:].float()).transpose(1,2)\n e=torch.cat((f,f),-1);c=e.cos().to(torch.bfloat16).unsqueeze(1);s=e.sin().to(torch.bfloat16).unsqueeze(1)\n q1,q2=q[...,:64],q[...,64:];k1,k2=k[...,:64],k[...,64:]\n return q*c+torch.cat((-q2,q1),-1)*s,k*c+torch.cat((-k2,k1),-1)*s\n@torch.compile(fullgraph=True,dynamic=True)\ndef rope_c(q,k,p,inv):\n f=p.float().unsqueeze(-1)*inv.float()\n e=torch.cat((f,f),-1);c=e.cos().to(torch.bfloat16).unsqueeze(1);s=e.sin().to(torch.bfloat16).unsqueeze(1)\n q1,q2=q[...,:64],q[...,64:];k1,k2=k[...,:64],k[...,64:]\n return q*c+torch.cat((-q2,q1),-1)*s,k*c+torch.cat((-k2,k1),-1)*s\n\ndef bench(fn,it=20):\n for _ in range(3):y=fn()\n torch.cuda.synchronize();a=torch.cuda.Event(True);b=torch.cuda.Event(True);a.record()\n for _ in range(it):y=fn()\n b.record();b.synchronize();return a.elapsed_time(b)/it,y\nfor B,S in [(1,131),(1,512),(2,1024),(1,8192)]:\n # Create underlying B,S,H,D then transpose to reproduce input strides.\n q0=torch.randn(B,S,40,128,device='cuda',dtype=torch.bfloat16);k0=torch.randn(B,S,8,128,device='cuda',dtype=torch.bfloat16)\n q=q0.transpose(1,2);k=k0.transpose(1,2);p=torch.randint(0,8192,(B,S),device='cuda',dtype=torch.int64);inv=torch.rand(64,device='cuda')\n te,ye=bench(lambda:rope_e(q,k,p,inv));tc,yc=bench(lambda:rope_c(q,k,p,inv))\n for name,a,b in [('q',ye[0],yc[0]),('k',ye[1],yc[1])]:\n  d=(a.float()-b.float()).abs();print(B,S,name,'times',te,tc,'max',d.max().item(),'neq',(d\"'!=0).float().mean().item(),'\"'tol',((d<=.0092)|(d<=.0078125*a.float().abs())).float().mean().item())\n del q0,k0,q,k,p,inv,ye,yc;torch.cuda.empty_cache()\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
