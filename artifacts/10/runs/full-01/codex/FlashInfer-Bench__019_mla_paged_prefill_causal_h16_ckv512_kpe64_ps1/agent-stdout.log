{"type":"item.started","item":{"id":"item_35","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch,triton,kernel,reference\n\ndef make(qs,ks):\n T=sum(qs);N=sum(ks);P=max(N,1)+7;d='cuda';torch.manual_seed(12)\n q=torch.randn(T,16,512,device=d,dtype=torch.bfloat16);qp=torch.randn(T,16,64,device=d,dtype=torch.bfloat16);k=torch.randn(P,1,512,device=d,dtype=torch.bfloat16);kp=torch.randn(P,1,64,device=d,dtype=torch.bfloat16)\n qo=torch.tensor([0]+torch.tensor(qs).cumsum(0).tolist(),device=d,dtype=torch.int32);ki=torch.tensor([0]+torch.tensor(ks).cumsum(0).tolist(),device=d,dtype=torch.int32);idx=torch.randperm(P,device=d)[:N].int();return q,qp,k,kp,qo,ki,idx,.1352337747812271\n\ndef flat(args,br,bn,nw):\n q,qp,k,kp,qo,ki,idx,s=args;T=q.shape[0];B=qo.shape[0]-1; qb=br//16\n out=torch.empty_like(q);lse=torch.empty((T,16),device=q.device,dtype=torch.float32)\n kernel._mla_prefill_flat[(triton.cdiv(T,qb)+B,)](q,qp,k,kp,qo,ki,idx,out,lse,s,NUM_BATCHES=B,BLOCK_B=triton.next_power_of_2(B),BLOCK_R=br,BLOCK_N=bn,num_warps=nw,num_stages=1)\n return out,lse\nargs=make([5,0,17,3],[8,0,19,7]);want=reference.run(*args)\nfor c in [(16,64,4),(16,64,8),(16,32,4),(32,32,8),(64,16,8)]:\n try:\n  got=flat(args,*c);torch.cuda.synchronize();print(c,'outmatch',torch.isclose(got[0].float(),want[0].float(),atol=.0063,rtol=.0078125).float().mean().item(),'lse',(got[1]-want[1]).abs().max().item(),flush=True)\n except Exception as e:print(c,'FAIL',type(e).__name__,e,flush=True)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
