{"type":"item.started","item":{"id":"item_32","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch,triton,kernel\nconfigs=[('orig',16,64,8),('m16n32',16,32,4),('m16n16',16,16,4),('m32n16',32,16,8),('m64n16',64,16,8)]\ndef bench(T,P):\n d='cuda';q=torch.randn(T,16,512,device=d,dtype=torch.bfloat16);qp=torch.randn(T,16,64,device=d,dtype=torch.bfloat16);k=torch.randn(P,1,512,device=d,dtype=torch.bfloat16);kp=torch.randn(P,1,64,device=d,dtype=torch.bfloat16);qo=torch.tensor([0,T],device=d,dtype=torch.int32);ki=torch.tensor([0,P],device=d,dtype=torch.int32);idx=torch.arange(P,device=d,dtype=torch.int32);out=torch.empty_like(q);lse=torch.empty((T,16),device=d,dtype=torch.float32);s=.1352337747812271\n def call(bm,bn,nw): kernel._mla_prefill[(triton.cdiv(T,bm)+1,16)](q,qp,k,kp,qo,ki,idx,out,lse,s,NUM_BATCHES=1,BLOCK_B=1,BLOCK_M=bm,BLOCK_N=bn,num_warps=nw,num_stages=1)\n print('case',T,P)\n for name,bm,bn,nw in configs:\n  call(bm,bn,nw);torch.cuda.synchronize(); reps=100 if T<256 else (20 if T<2048 else 3)\n  st=torch.cuda.Event(True);en=torch.cuda.Event(True);st.record()\n  for _ in range(reps):call(bm,bn,nw)\n  en.record();en.synchronize();print(name,round(st.elapsed_time(en)/reps,5),flush=True)\nfor x in [(1,34),(33,34),(128,132),(1024,1038),(4096,4099),(8192,8195),(16384,16387)]:bench(*x)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
