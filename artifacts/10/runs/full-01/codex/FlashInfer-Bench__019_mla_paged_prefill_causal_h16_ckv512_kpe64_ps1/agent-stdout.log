{"type":"item.started","item":{"id":"item_9","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch\nimport kernel\nimport reference\n\ntorch.manual_seed(1)\ndevice='cuda'\nq_lens=[5,0,17,3]\nkv_lens=[8,0,19,7]\nT=sum(q_lens); P=128\nq=torch.randn(T,16,512,device=device,dtype=torch.bfloat16)\nqp=torch.randn(T,16,64,device=device,dtype=torch.bfloat16)\nk=torch.randn(P,1,512,device=device,dtype=torch.bfloat16)\nkp=torch.randn(P,1,64,device=device,dtype=torch.bfloat16)\nqo=torch.tensor([0,5,5,22,25],device=device,dtype=torch.int32)\nki=torch.tensor([0,8,8,27,34],device=device,dtype=torch.int32)\nidx=torch.randperm(P,device=device,dtype=torch.int64)[:34].to(torch.int32)\nscale=0.1352337747812271\nwant=reference.run(q,qp,k,kp,qo,ki,idx,scale)\ngot=kernel.run(q,qp,k,kp,qo,ki,idx,scale)\ntorch.cuda.synchronize()\nfor n,a,b in zip(('out','lse'),got,want):\n    d=(a.float()-b.float()).abs()\n    print(n, 'max', d.max().item(), 'mean', d.mean().item(), 'ratio<=.006', (d<=.006).float().mean().item())\nprint('sample lse',got[1][0,:4],want[1][0,:4])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
