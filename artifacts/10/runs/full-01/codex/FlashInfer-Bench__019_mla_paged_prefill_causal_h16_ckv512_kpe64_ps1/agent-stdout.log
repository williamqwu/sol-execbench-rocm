{"type":"item.started","item":{"id":"item_29","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch,time,triton,kernel,reference\n\ndef launch(args,bm,bn=64,nw=8):\n q,qp,k,kp,qo,ki,idx,s=args; T=q.shape[0]; B=qo.shape[0]-1\n out=torch.empty_like(q); lse=torch.empty((T,16),device=q.device,dtype=torch.float32)\n kernel._mla_prefill[(triton.cdiv(T,bm)+B,16)](q,qp,k,kp,qo,ki,idx,out,lse,s,NUM_BATCHES=B,BLOCK_B=triton.next_power_of_2(B),BLOCK_M=bm,BLOCK_N=bn,num_warps=nw,num_stages=1)\n return out,lse\n\ndef make(T):\n P=T+3;d='cuda'; torch.manual_seed(7)\n q=torch.randn(T,16,512,device=d,dtype=torch.bfloat16);qp=torch.randn(T,16,64,device=d,dtype=torch.bfloat16)\n k=torch.randn(P,1,512,device=d,dtype=torch.bfloat16);kp=torch.randn(P,1,64,device=d,dtype=torch.bfloat16)\n qo=torch.tensor([0,T],device=d,dtype=torch.int32);ki=torch.tensor([0,P],device=d,dtype=torch.int32);idx=torch.arange(P,device=d,dtype=torch.int32)\n return q,qp,k,kp,qo,ki,idx,.1352337747812271\nsmall=make(129); want=reference.run(*small);torch.cuda.synchronize()\nfor bm in (16,32,64,128):\n try:\n  t=time.monotonic();got=launch(small,bm);torch.cuda.synchronize();ct=time.monotonic()-t\n  print('accuracy bm',bm,'compile',ct,'match',torch.isclose(got[0].float(),want[0].float(),atol=.0063,rtol=.0078125).float().mean().item(),'lsemax',(got[1]-want[1]).abs().max().item(),flush=True)\n except Exception as e: print('FAIL bm',bm,type(e).__name__,e,flush=True)\nlarge=make(8192)\nfor bm in (16,32,64,128):\n try:\n  launch(large,bm);torch.cuda.synchronize(); st=torch.cuda.Event(True);en=torch.cuda.Event(True);st.record();launch(large,bm);en.record();en.synchronize()\n  print('speed bm',bm,st.elapsed_time(en),flush=True)\n except Exception as e: print('FAIL speed bm',bm,type(e).__name__,e,flush=True)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
