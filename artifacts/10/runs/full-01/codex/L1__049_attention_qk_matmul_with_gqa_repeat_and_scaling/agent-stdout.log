{"type":"item.started","item":{"id":"item_16","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch,triton\nimport triton.testing\nimport kernel\n\ncfgs=[\n (64,64,32,4),(64,128,32,4),(128,64,32,4),(128,128,32,2),(128,128,32,4),(128,128,32,8),\n (64,256,32,4),(64,256,32,8),(256,64,32,4),(256,64,32,8),\n (128,256,32,4),(128,256,32,8),(256,128,32,4),(256,128,32,8),\n]\nfor b,s in [(1,1024),(8,1024),(1,4096),(1,8192)]:\n q=torch.randn((b,4,s,256),device='cuda',dtype=torch.bfloat16)\n k=torch.randn((b,1,s,256),device='cuda',dtype=torch.bfloat16)\n o=torch.empty((b,4,s,s),device='cuda',dtype=torch.bfloat16)\n vals=[]\n for bm,bn,bk,w in cfgs:\n  grid=(triton.cdiv(s,bm)*triton.cdiv(s,bn),b*4)\n  fn=lambda bm=bm,bn=bn,bk=bk,w=w,grid=grid: kernel._qk_tiled_kernel[grid](q,k,o,s,0.0625,BLOCK_M=bm,BLOCK_N=bn,BLOCK_K=bk,num_warps=w)\n  try:\n   ms=triton.testing.do_bench(fn,warmup=8,rep=20)\n   vals.append(f'{bm}x{bn}w{w}={ms*1000:.1f}')\n  except Exception as e: vals.append(f'{bm}x{bn}w{w}=ERR')\n print(f'B{b} S{s} us: '+' '.join(vals),flush=True)\n\nprint('STAGES',flush=True)\nfor b,s in [(8,1024),(1,4096)]:\n q=torch.randn((b,4,s,256),device='cuda',dtype=torch.bfloat16)\n k=torch.randn((b,1,s,256),device='cuda',dtype=torch.bfloat16)\n o=torch.empty((b,4,s,s),device='cuda',dtype=torch.bfloat16)\n grid=(triton.cdiv(s,128)**2,b*4)\n vals=[]\n for st in (1,2,3,4,5):\n  fn=lambda st=st: kernel._qk_tiled_kernel[grid](q,k,o,s,0.0625,BLOCK_M=128,BLOCK_N=128,BLOCK_K=32,num_warps=4,num_stages=st)\n  try:\n   ms=triton.testing.do_bench(fn,warmup=8,rep=20)\n   vals.append(f's{st}={ms*1000:.1f}')\n  except Exception as e: vals.append(f's{st}=ERR')\n print(f'B{b} S{s}: '+' '.join(vals),flush=True)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
