{"type":"item.started","item":{"id":"item_25","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch,triton\nimport triton.testing\nimport kernel\n\ncases=[(8,1024,128,256),(4,2048,128,128),(1,4096,128,128),(1,8192,128,128)]\nfor b,s,bm,bn in cases:\n q=torch.randn((b,4,s,256),device='cuda',dtype=torch.bfloat16)\n k=torch.randn((b,1,s,256),device='cuda',dtype=torch.bfloat16)\n o=torch.empty((b,4,s,s),device='cuda',dtype=torch.bfloat16)\n total=triton.cdiv(s,bm)*triton.cdiv(s,bn)*b*4\n grid=(triton.cdiv(s,bm)*triton.cdiv(s,bn),b*4)\n base=lambda: kernel._qk_tiled_kernel[grid](q,k,o,s,0.0625,BLOCK_M=bm,BLOCK_N=bn,BLOCK_K=32,num_warps=8,num_stages=2)\n vals=[]\n try: vals.append(('base',triton.testing.do_bench(base,warmup=8,rep=24)*1000))\n except Exception: vals.append(('base',99999))\n for np in (128,256,512,1024,2048):\n  if np>total: continue\n  fn=lambda np=np: kernel._qk_persistent_kernel[(np,)](q,k,o,s,0.0625,TOTAL_TILES=total,NUM_PROGRAMS=np,BLOCK_M=bm,BLOCK_N=bn,BLOCK_K=32,num_warps=8,num_stages=2)\n  try: vals.append((f'p{np}',triton.testing.do_bench(fn,warmup=8,rep=24)*1000))\n  except Exception as e: vals.append((f'p{np}',99999)); print(type(e).__name__,str(e).splitlines()[0],flush=True)\n print(f'B{b} S{s} total{total}: '+' '.join(f'{n}={v:.1f}' for n,v in vals),flush=True)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
