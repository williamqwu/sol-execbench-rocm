{"type":"item.started","item":{"id":"item_11","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch, triton\nimport triton.testing\nimport kernel\n\ntiles=[(64,64,4),(128,128,4),(64,256,4)]\nopts=[\n ('base',{}),\n ('st1',{'num_stages':1}), ('st2',{'num_stages':2}),\n ('wv1',{'waves_per_eu':1}), ('wv2',{'waves_per_eu':2}), ('wv4',{'waves_per_eu':4}),\n ('mi16',{'matrix_instr_nonkdim':16}), ('mi32',{'matrix_instr_nonkdim':32}),\n ('kp2',{'kpack':2}),\n ('mi16kp2',{'matrix_instr_nonkdim':16,'kpack':2}),\n ('mi32kp2',{'matrix_instr_nonkdim':32,'kpack':2}),\n ('wv2mi16',{'waves_per_eu':2,'matrix_instr_nonkdim':16}),\n]\nfor b,s in [(8,1024),(1,4096)]:\n q=torch.randn((b,4,s,256),device='cuda',dtype=torch.bfloat16)\n k=torch.randn((b,1,s,256),device='cuda',dtype=torch.bfloat16)\n o=torch.empty((b,4,s,s),device='cuda',dtype=torch.bfloat16)\n print(f'B{b} S{s}',flush=True)\n for bm,bn,w in tiles:\n  vals=[]\n  grid=(triton.cdiv(s,bm)*triton.cdiv(s,bn),b*4)\n  for name,op in opts:\n   def fn(op=op):\n    kernel._qk_kernel[grid](q,k,o,s,0.0625,BLOCK_M=bm,BLOCK_N=bn,num_warps=w,**op)\n   try:\n    ms=triton.testing.do_bench(fn,warmup=8,rep=20)\n    vals.append(f'{name}={ms*1000:.1f}')\n   except Exception as e:\n    vals.append(f'{name}=ERR')\n  print(f' {bm}x{bn}w{w}: '+' '.join(vals),flush=True)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
