{"type":"item.started","item":{"id":"item_7","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch\nimport triton\nimport triton.testing\nimport kernel\n\nconfigs = [\n    (32, 32, 4),\n    (64, 64, 4),\n    (64, 64, 8),\n    (64, 128, 4),\n    (64, 128, 8),\n    (128, 64, 4),\n    (128, 64, 8),\n    (128, 128, 4),\n    (128, 128, 8),\n]\ncases = [(1,128), (1,256), (1,293), (1,512), (1,1024), (2,1024), (1,2048), (1,4096), (1,8192)]\nfor b, s in cases:\n    q = torch.randn((b,4,s,256), device='cuda', dtype=torch.bfloat16)\n    k = torch.randn((b,1,s,256), device='cuda', dtype=torch.bfloat16)\n    o = torch.empty((b,4,s,s), device='cuda', dtype=torch.bfloat16)\n    vals=[]\n    for bm,bn,w in configs:\n        grid=(triton.cdiv(s,bm)*triton.cdiv(s,bn), b*4)\n        fn=lambda bm=bm,bn=bn,w=w,grid=grid: kernel._qk_kernel[grid](q,k,o,s,0.0625,BLOCK_M=bm,BLOCK_N=bn,num_warps=w)\n        try:\n            ms=triton.testing.do_bench(fn, warmup=10, rep=30)\n            vals.append(f'{bm}x{bn}w{w}={ms*1000:.2f}us')\n        except Exception as e:\n            vals.append(f'{bm}x{bn}w{w}=ERR:{type(e).__name__}')\n    print(f'B{b} S{s}: ' + '  '.join(vals), flush=True)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
