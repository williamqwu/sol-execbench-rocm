{"type":"item.started","item":{"id":"item_9","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch\nimport triton\nimport triton.testing\nimport kernel\n\nconfigs = [\n    (64,64,2), (128,128,2), (64,128,2), (128,64,2),\n    (64,256,4), (64,256,8), (256,64,4), (256,64,8),\n    (128,256,4), (128,256,8), (256,128,4), (256,128,8),\n    (256,256,8),\n]\ncases = [(1,1024), (8,1024), (1,2048), (4,2048), (1,4096), (1,8192)]\nfor b, s in cases:\n    q=torch.randn((b,4,s,256),device='cuda',dtype=torch.bfloat16)\n    k=torch.randn((b,1,s,256),device='cuda',dtype=torch.bfloat16)\n    o=torch.empty((b,4,s,s),device='cuda',dtype=torch.bfloat16)\n    vals=[]\n    for bm,bn,w in configs:\n        grid=(triton.cdiv(s,bm)*triton.cdiv(s,bn),b*4)\n        fn=lambda bm=bm,bn=bn,w=w,grid=grid: kernel._qk_kernel[grid](q,k,o,s,0.0625,BLOCK_M=bm,BLOCK_N=bn,num_warps=w)\n        try:\n            ms=triton.testing.do_bench(fn,warmup=8,rep=20)\n            vals.append(f'{bm}x{bn}w{w}={ms*1000:.1f}')\n        except Exception as e:\n            vals.append(f'{bm}x{bn}w{w}=ERR({str(e).splitlines()[0][:35]})')\n    print(f'B{b} S{s} us: '+'  '.join(vals),flush=True)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
