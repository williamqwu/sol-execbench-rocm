{"type":"item.started","item":{"id":"item_14","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch,triton\nimport triton.testing\nimport kernel\n\ntiles=[(64,64,4),(64,128,4),(128,128,4),(64,256,4)]\nfor b,s in [(1,1024),(8,1024),(1,4096),(1,8192)]:\n q=torch.randn((b,4,s,256),device='cuda',dtype=torch.bfloat16)\n k=torch.randn((b,1,s,256),device='cuda',dtype=torch.bfloat16)\n o=torch.empty((b,4,s,s),device='cuda',dtype=torch.bfloat16)\n print(f'B{b} S{s}',flush=True)\n for bm,bn,w in tiles:\n  grid=(triton.cdiv(s,bm)*triton.cdiv(s,bn),b*4)\n  vals=[]\n  for bk in (16,32,64,128):\n   fn=lambda bk=bk: kernel._qk_tiled_kernel[grid](q,k,o,s,0.0625,BLOCK_M=bm,BLOCK_N=bn,BLOCK_K=bk,num_warps=w)\n   try:\n    ms=triton.testing.do_bench(fn,warmup=8,rep=20)\n    vals.append(f'k{bk}={ms*1000:.1f}')\n   except Exception as e:\n    vals.append(f'k{bk}=ERR({str(e).splitlines()[0][:24]})')\n  print(f' {bm}x{bn}w{w}: '+' '.join(vals),flush=True)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
