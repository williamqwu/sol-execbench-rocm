{"type":"item.started","item":{"id":"item_21","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch, triton\nimport kernel\n\ndef one(kind, x, y, rows, cols):\n    nw = 16 if cols >= 12288 else 8\n    if kind == 'old':\n        kernel._gaussian_sparse_kernel[(rows,)](x, y, n_cols=cols, z=-0.5244005, BLOCK=triton.next_power_of_2(cols), num_warps=nw, num_stages=1)\n    else:\n        kernel._gaussian_sparse_kernel_tiled[(rows,)](x, y, n_cols=cols, z=-0.5244005, CHUNKS=cols//4096, TILE=4096, num_warps=nw, num_stages=1)\n\ndef bench(rows, cols):\n    x = torch.empty((rows, cols), device='cuda', dtype=torch.bfloat16)\n    y = torch.empty_like(x)\n    for kind in ('old','new'):\n        for _ in range(5): one(kind, x, y, rows, cols)\n        torch.cuda.synchronize()\n        times=[]\n        for _ in range(20):\n            a=torch.cuda.Event(enable_timing=True); b=torch.cuda.Event(enable_timing=True)\n            a.record()\n            for _ in range(10): one(kind, x, y, rows, cols)\n            b.record(); b.synchronize(); times.append(a.elapsed_time(b)/10)\n        times.sort()\n        print(rows, cols, kind, times[len(times)//2], min(times))\n\nfor shape in [(512,12288),(8192,12288),(4096,12288),(586,12288),(1024,16384),(422,8192),(18608,8192),(2164,8192),(65536,8192),(8192,4096),(1796,4096),(262,4096)]:\n    bench(*shape)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
