{"type":"item.started","item":{"id":"item_34","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch\nimport torch.nn.functional as F\nimport reference\n\nv = reference.get_inputs({'batch_size': 1, 'height': 1024, 'width': 1024}, torch.device('cuda:0'))\nx = torch.cat((v['predicted'], v['target']))\nstages=[]\nfor level in range(3):\n    w1=v[f'extractor{level}_conv1_weight']; b1=v[f'extractor{level}_conv1_bias']\n    w2=v[f'extractor{level}_conv2_weight']; b2=v[f'extractor{level}_conv2_bias']\n    stages.append((f'{level}.1',x,w1,b1))\n    x=F.relu(F.conv2d(x,w1,b1,padding=1))\n    stages.append((f'{level}.2',x,w2,b2))\n    x=F.max_pool2d(F.relu(F.conv2d(x,w2,b2,padding=1)),2,2)\nfor name,x,w,b in stages:\n    fns={\n      'raw': lambda x=x,w=w,b=b: F.conv2d(x,w,b,padding=1),\n      'eager_relu': lambda x=x,w=w,b=b: F.relu(F.conv2d(x,w,b,padding=1)),\n      'fused': lambda x=x,w=w,b=b: torch.ops.aten.miopen_convolution_relu(x,w,b,[1,1],[1,1],[1,1],1),\n    }\n    print(name, tuple(x.shape), flush=True)\n    for label,fn in fns.items():\n        for _ in range(3): fn()\n        torch.cuda.synchronize(); ts=[]\n        for _ in range(9):\n            s=torch.cuda.Event(enable_timing=True); e=torch.cuda.Event(enable_timing=True)\n            s.record(); fn(); e.record(); e.synchronize(); ts.append(s.elapsed_time(e))\n        print(label, sorted(ts)[4], flush=True)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
