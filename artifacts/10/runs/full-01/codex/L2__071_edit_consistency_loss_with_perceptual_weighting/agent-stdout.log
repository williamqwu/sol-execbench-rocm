{"type":"item.started","item":{"id":"item_23","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport time\nimport torch\nimport torch.nn.functional as F\nimport reference\n\nv = reference.get_inputs({'batch_size': 1, 'height': 320, 'width': 320}, torch.device('cuda:0'))\nx0 = torch.cat((v['predicted'], v['target']))\npairs = [\n    ('conv0_1', x0, v['extractor0_conv1_weight'], v['extractor0_conv1_bias']),\n]\nx1 = F.relu(F.conv2d(x0, v['extractor0_conv1_weight'], v['extractor0_conv1_bias'], padding=1))\npairs.append(('conv0_2', x1, v['extractor0_conv2_weight'], v['extractor0_conv2_bias']))\nfor name, x, w, b in pairs:\n    def eager(): return F.relu(F.conv2d(x, w, b, padding=1))\n    def fused(): return torch.ops.aten.miopen_convolution_relu(x, w, b, [1,1], [1,1], [1,1], 1)\n    a = eager(); z = fused(); torch.cuda.synchronize()\n    print(name, 'maxerr', (a-z).abs().max().item(), 'equal', torch.equal(a,z))\n    for label, fn in [('eager', eager), ('fused', fused)]:\n        for _ in range(5): fn()\n        torch.cuda.synchronize()\n        times=[]\n        for _ in range(20):\n            s=torch.cuda.Event(enable_timing=True); e=torch.cuda.Event(enable_timing=True)\n            s.record(); fn(); e.record(); e.synchronize(); times.append(s.elapsed_time(e))\n        print(label, sorted(times)[10])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
