{"type":"item.started","item":{"id":"item_53","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport json,torch,triton\nimport kernel,reference\n\ndef previous(args):\n x,qw,kw,vw,qn,kn,eps=args;bs,sl,_=x.shape;rows=bs*sl\n if rows in (128,2164):q=x@qw.t();k=x@kw.t();v=x@vw.t();stride=1024\n else:\n  qkv=x@torch.cat((qw,kw,vw)).t();q=qkv[...,:1024];k=qkv[...,1024:2048];v=qkv[...,2048:];stride=3072\n q=q.view(bs,sl,8,128);k=k.view(bs,sl,8,128);v=v.view(bs,sl,8,128)\n bm=32 if rows>=8192 else 16 if rows>=4096 else 8 if rows>=1024 else 4\n kernel._qk_rms_kernel[(triton.cdiv(rows,bm),8)](q,k,qn,kn,q,k,rows,eps,BLOCK_M=bm,IN_STRIDE=stride,OUT_STRIDE=stride,num_warps=4)\n return q,k,v\nshapes=[]\nfor line in open('workload.jsonl'):\n a=json.loads(line)['axes'];shape=(a['batch_size'],a['seq_len'])\n if shape not in shapes:shapes.append(shape)\nfor bs,sl in shapes:\n m=bs*sl;x=torch.rand((bs,sl,1024),device='cuda');ws=[torch.rand((1024,1024),device='cuda') for _ in range(3)];nw=[torch.rand(128,device='cuda') for _ in range(2)];args=(x,*ws,*nw,1e-6)\n ref=reference.run(*args);new=kernel.run(*args);torch.cuda.synchronize()\n ok=[torch.isclose(u,v,atol=1.1921e-7,rtol=1.1921e-7).float().mean().item() for u,v in zip(new,ref)]\n tn=triton.testing.do_bench(lambda:kernel.run(*args),warmup=20,rep=100)\n to=triton.testing.do_bench(lambda:previous(args),warmup=20,rep=100)\n print((bs,sl,m),f'custom {tn:.4f} prev {to:.4f} ratio {to/tn:.3f}',ok)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
