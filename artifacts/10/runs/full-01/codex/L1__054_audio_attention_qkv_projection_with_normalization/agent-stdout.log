{"type":"item.started","item":{"id":"item_28","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport json, torch, triton\nimport kernel, reference\n\ndef sequential(args):\n x,qw,kw,vw,qn,kn,eps=args; bs,sl,_=x.shape;rows=bs*sl\n q=x@qw.t();k=x@kw.t();v=x@vw.t();qo=torch.empty_like(q);ko=torch.empty_like(k)\n kernel._qk_rms_kernel[(triton.cdiv(rows,4),8)](q,k,qn,kn,qo,ko,rows,eps,BLOCK_M=4,IN_STRIDE=1024,num_warps=4)\n return qo.view(bs,sl,8,128),ko.view(bs,sl,8,128),v.view(bs,sl,8,128)\n\nshapes=[]\nfor line in open('workload.jsonl'):\n a=json.loads(line)['axes']; shape=(a['batch_size'],a['seq_len'])\n if shape not in shapes: shapes.append(shape)\nfor bs,sl in shapes:\n m=bs*sl;x=torch.rand((bs,sl,1024),device='cuda');ws=[torch.rand((1024,1024),device='cuda') for _ in range(3)];nw=[torch.rand(128,device='cuda') for _ in range(2)];args=(x,*ws,*nw,1e-6)\n ref=reference.run(*args);cur=kernel.run(*args);torch.cuda.synchronize()\n stats=[]\n for a,b in zip(cur,ref):\n  stats.append(((a-b).abs().max().item(),torch.isclose(a,b,atol=1.1921e-7,rtol=1.1921e-7).float().mean().item()))\n tc=triton.testing.do_bench(lambda:kernel.run(*args),warmup=15,rep=70)\n ts=triton.testing.do_bench(lambda:sequential(args),warmup=15,rep=70)\n print((bs,sl,m),f'wide {tc:.4f} seq {ts:.4f} ratio {ts/tc:.3f}',stats)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
