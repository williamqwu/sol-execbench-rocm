{"type":"item.started","item":{"id":"item_48","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch,triton\n\ndef wtcat(x,ws):\n w=torch.cat(ws,dim=0)\n return x.view(-1,1024)@w.t()\ndef tcat(x,ws):\n w=torch.cat(tuple(q.t() for q in ws),dim=1)\n return x.view(-1,1024)@w\nfor m in (131,256,512,586,1024,2048,2164,4096,6184,8192):\n x=torch.rand((1,m,1024),device='cuda');ws=[torch.rand((1024,1024),device='cuda') for _ in range(3)]\n a=wtcat(x,ws);b=tcat(x,ws);torch.cuda.synchronize()\n ok=torch.isclose(a,b,atol=1.1921e-7,rtol=1.1921e-7).float().mean().item(); exact=(a==b).float().mean().item();mx=(a-b).abs().max().item()\n ta=triton.testing.do_bench(lambda:wtcat(x,ws),warmup=20,rep=100)\n tb=triton.testing.do_bench(lambda:tcat(x,ws),warmup=20,rep=100)\n print(m,f'normal {ta:.4f} transposed {tb:.4f} ratio {ta/tb:.3f} ok {ok:.5f} exact {exact:.5f} max {mx}')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
