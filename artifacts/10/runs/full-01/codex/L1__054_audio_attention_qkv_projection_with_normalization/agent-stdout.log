{"type":"item.started","item":{"id":"item_50","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch,triton\nimport kernel\nws=[torch.rand((1024,1024),device='cuda') for _ in range(3)]\ndef tc():return torch.cat(ws,dim=0)\ndef custom(block,nw):\n out=torch.empty((3072,1024),device='cuda')\n kernel._cat3_kernel[(triton.cdiv(1024*1024,block),3)](*ws,out,BLOCK=block,num_warps=nw)\n return out\nref=tc();vals=[]\nt=triton.testing.do_bench(tc,warmup=20,rep=200);print('torch',t)\nfor block in (1024,2048,4096,8192,16384,32768,65536):\n for nw in (4,8):\n  try:\n   o=custom(block,nw);torch.cuda.synchronize();assert torch.equal(ref,o)\n   t=triton.testing.do_bench(lambda:custom(block,nw),warmup=20,rep=200);vals.append((t,block,nw))\n  except Exception as e: print('err',block,nw,str(e)[:160])\nprint(sorted(vals))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
