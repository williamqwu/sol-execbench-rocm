{"type":"item.started","item":{"id":"item_11","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch, kernel, time\n\ndef eager(x,w,p,eps):\n    h=x.float(); v=h.square().mean(-1,keepdim=True)\n    n=(h*torch.rsqrt(v+eps)*w.float()).to(x.dtype)\n    y=n@p.t(); b,s,_=x.shape\n    z=y.view(b,s,128,256).transpose(1,2)\n    return z[...,:128], z[...,128:]\n\ndef bench(fn,args,n=100):\n    for _ in range(10): fn(*args)\n    torch.cuda.synchronize()\n    st=torch.cuda.Event(enable_timing=True); en=torch.cuda.Event(enable_timing=True)\n    st.record()\n    for _ in range(n): fn(*args)\n    en.record(); en.synchronize()\n    return st.elapsed_time(en)/n\nw=torch.randn(512,device='cuda',dtype=torch.bfloat16)\np=torch.randn(32768,512,device='cuda',dtype=torch.bfloat16)\nfor m in (128,1024,8192):\n    x=torch.randn(1,m,512,device='cuda',dtype=torch.bfloat16)\n    a=(x,w,p,1e-6)\n    tc=bench(kernel.run,a,100)\n    te=bench(eager,a,100)\n    o=kernel.run(*a); r=eager(*a)\n    print(m, 'compiled',tc,'eager',te,'max',max((o[i].float()-r[i].float()).abs().max().item() for i in range(2)))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
