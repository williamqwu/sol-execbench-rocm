{"type":"item.started","item":{"id":"item_25","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch, triton, kernel\nconfigs=[(32,128,32,8,4,2),(64,128,32,8,4,2),(64,128,32,8,8,2),(128,128,32,8,8,2),(32,256,32,8,8,2)]\nw=torch.randn(32768,512,device='cuda',dtype=torch.bfloat16)\ndef tri(a,c,cfg):\n bm,bn,bk,gm,nw,ns=cfg; m=a.shape[0]; grid=(triton.cdiv(m,bm)*(32768//bn),)\n kernel._matmul_kernel[grid](a,w,c,M=m,BLOCK_M=bm,BLOCK_N=bn,BLOCK_K=bk,GROUP_M=gm,num_warps=nw,num_stages=ns)\ndef bench(fn,n=100):\n for _ in range(5):fn()\n torch.cuda.synchronize();s=torch.cuda.Event(True);e=torch.cuda.Event(True);s.record()\n for _ in range(n):fn()\n e.record();e.synchronize();return s.elapsed_time(e)/n\nfor m in (128,1024,8192):\n a=torch.randn(m,512,device='cuda',dtype=torch.bfloat16); c=torch.empty(m,32768,device='cuda',dtype=torch.bfloat16); ref=a@w.t()\n out=[]\n for cfg in configs:\n  try:\n   tri(a,c,cfg); torch.cuda.synchronize(); err=(c.float()-ref.float()).abs().max().item(); out.append((cfg,bench(lambda:tri(a,c,cfg),50),err))\n  except Exception as e: out.append((cfg,'ERR:'+str(e).splitlines()[-1],None))\n out.append(('vendor',bench(lambda:a@w.t(),100),0))\n print(m,out,flush=True)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
