{"type":"item.started","item":{"id":"item_10","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport torch, time\nimport torch.nn.functional as F\nfrom reference import run as ref\n\ntorch.manual_seed(123); dev='cuda:0'; B,S,D=1,128,1536\nxs=[torch.randn(B,S,D,device=dev), torch.randn(3*D,D,device=dev), torch.randn(3*D,device=dev), torch.randn(64,device=dev), torch.randn(64,device=dev), torch.randn(64,device=dev), torch.randn(64,device=dev), torch.randn(D,D,device=dev), torch.randn(D,device=dev)]\n\ndef cand(x,w,b,qw,qb,kw,kb,ow,ob,eps):\n    qkv=F.linear(x,w,b)\n    B,S,D=x.shape\n    q,k,v=qkv.reshape(B,S,3,24,64).permute(2,0,3,1,4)\n    qm=q.mean(-1,True); qv=q.var(-1,False,True); q=(q-qm)/torch.sqrt(qv+eps); q=(q*qw+qb)*.125\n    km=k.mean(-1,True); kv=k.var(-1,False,True); k=(k-km)/torch.sqrt(kv+eps); k=k*kw+kb\n    p=F.softmax(torch.matmul(q,k.transpose(-2,-1)),-1)\n    a=torch.matmul(p,v).transpose(1,2).reshape(B,S,D)\n    return F.linear(a,ow,ob)\n\ncc=torch.compile(cand,fullgraph=True,dynamic=True,mode='max-autotune-no-cudagraphs')\ny=ref(*xs,1e-6); torch.cuda.synchronize()\nt=time.time(); z=cc(*xs,1e-6); torch.cuda.synchronize(); print('compile_sec',time.time()-t)\nd=(z-y).abs(); ok=torch.isclose(z,y,atol=1.67e-7,rtol=1.1920928955078125e-7)\nprint('maxabs',d.max().item(),'mean',d.mean().item(),'ratio',ok.float().mean().item())\nfor f,name in [(cand,'eager'),(cc,'compile')]:\n  for _ in range(5): f(*xs,1e-6)\n  torch.cuda.synchronize(); s=torch.cuda.Event(True); e=torch.cuda.Event(True); s.record()\n  for _ in range(100): f(*xs,1e-6)\n  e.record(); e.synchronize(); print(name,s.elapsed_time(e)/100)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
