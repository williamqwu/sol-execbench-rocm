{"type":"item.started","item":{"id":"item_42","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport torch,numpy as np\nN=10000\nx=torch.randn(N,64,device='cuda'); target=(x.mean(-1)*64).cpu().numpy().view(np.uint32); a=x.cpu().numpy()\n\ndef add(u,v): return np.float32(u+v)\ndef reduce_tree(vals):\n vals=vals.copy()\n n=len(vals);off=n//2\n while off:\n  vals[:off]=np.float32(vals[:off]+vals[off:2*off]);off//=2\n return vals[0]\ndef candidate(row,T,kind,local):\n vals=np.zeros(T,dtype=np.float32)\n if kind=='stride':\n  for t in range(T):\n   inds=range(t,64,T)\n   z=np.float32(0)\n   for i in inds:z=add(z,row[i])\n   vals[t]=z\n else:\n  V=64//T\n  for t in range(T):\n   inds=range(t*V,(t+1)*V)\n   z=np.float32(0)\n   for i in inds:z=add(z,row[i])\n   vals[t]=z\n return reduce_tree(vals)\nfor kind in ['stride','contig']:\n for T in [1,2,4,8,16,32,64]:\n  out=np.array([candidate(row,T,kind,0) for row in a],np.float32).view(np.uint32)\n  print(kind,T,(out==target).mean())\n# contiguous balanced tree directly\nout=np.array([reduce_tree(r) for r in a],np.float32).view(np.uint32);print('contig_tree',np.mean(out==target))\n# sequential\nout=np.array([np.float32(r).sum(dtype=np.float32) for r in a],np.float32).view(np.uint32);print('np_sum',np.mean(out==target))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
