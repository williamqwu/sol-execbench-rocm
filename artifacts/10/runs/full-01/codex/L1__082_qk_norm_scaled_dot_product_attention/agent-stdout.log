{"type":"item.started","item":{"id":"item_31","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport torch\nimport torch.nn.functional as F\nfrom reference import run as ref\nfrom experiment_kernel import norm_qkv_kernel\n\ntorch.manual_seed(19);D=1536\n\ndef cand(x,w,b,qw,qb,kw,kb,ow,ob,eps):\n B,S,D=x.shape; qkv=F.linear(x,w,b); p=qkv.reshape(B,S,3,24,64).permute(2,0,3,1,4); qk=p[:2]\n means=qk.mean(-1,True); variances=qk.var(-1,False,True)\n rows=B*24*S; packed=torch.empty((3,B,24,S,64),device=x.device,dtype=x.dtype)\n norm_qkv_kernel[(rows,)](qkv,means,variances,qw,qb,kw,kb,packed,n_rows=rows,seq_len=S,eps=eps,num_warps=1)\n q,k,v=packed[0].reshape(B*24,S,64),packed[1].reshape(B*24,S,64),packed[2].reshape(B*24,S,64)\n p=F.softmax(torch.bmm(q,k.transpose(1,2)),-1)\n a=torch.bmm(p,v).reshape(B,24,S,64).transpose(1,2).reshape(B,S,D)\n return F.linear(a,ow,ob)\n\nfor B,S in [(1,128),(4,293),(1,1024)]:\n xs=[torch.randn(B,S,D,device='cuda'),torch.randn(3*D,D,device='cuda'),torch.randn(3*D,device='cuda'),torch.randn(64,device='cuda'),torch.randn(64,device='cuda'),torch.randn(64,device='cuda'),torch.randn(64,device='cuda'),torch.randn(D,D,device='cuda'),torch.randn(D,device='cuda')]\n y=ref(*xs,1e-6);z=cand(*xs,1e-6);torch.cuda.synchronize();d=(z-y).abs();ok=torch.isclose(z,y,atol=1.67e-7,rtol=1.1920928955078125e-7)\n print(B,S,'equal',torch.equal(z,y),'max',d.max().item(),'ratio',ok.float().mean().item())\n for f,n in [(ref,'ref'),(cand,'cand')]:\n  for _ in range(5):f(*xs,1e-6)\n  torch.cuda.synchronize();st=torch.cuda.Event(True);en=torch.cuda.Event(True);st.record()\n  for _ in range(100):f(*xs,1e-6)\n  en.record();en.synchronize();print(n,st.elapsed_time(en)/100)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
