{"type":"item.started","item":{"id":"item_11","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport torch\nimport torch.nn.functional as F\nfrom reference import run as ref\n\ntorch.manual_seed(321); dev='cuda:0'; D=1536\n\ndef cand(x,w,b,qw,qb,kw,kb,ow,ob,eps):\n B,S,D=x.shape\n qkv=F.linear(x,w,b).reshape(B,S,3,24,64).permute(2,0,3,1,4)\n qk=qkv[:2]\n m=qk.mean(-1,True); var=qk.var(-1,False,True)\n qk=(qk-m)/torch.sqrt(var+eps)\n q=qk[0]*qw+qb; q=q*.125\n k=qk[1]*kw+kb; v=qkv[2]\n p=F.softmax(torch.matmul(q,k.transpose(-2,-1)),-1)\n a=torch.matmul(p,v).transpose(1,2).reshape(B,S,D)\n return F.linear(a,ow,ob)\n\nfor B,S in [(1,128),(4,256),(1,1024)]:\n xs=[torch.randn(B,S,D,device=dev), torch.randn(3*D,D,device=dev), torch.randn(3*D,device=dev), torch.randn(64,device=dev), torch.randn(64,device=dev), torch.randn(64,device=dev), torch.randn(64,device=dev), torch.randn(D,D,device=dev), torch.randn(D,device=dev)]\n y=ref(*xs,1e-6); z=cand(*xs,1e-6); torch.cuda.synchronize()\n d=(z-y).abs(); ok=torch.isclose(z,y,atol=1.67e-7,rtol=1.1920928955078125e-7)\n print(B,S,'maxabs',d.max().item(),'ratio',ok.float().mean().item())\n for f,name in [(ref,'ref'),(cand,'cand')]:\n  for _ in range(5): f(*xs,1e-6)\n  torch.cuda.synchronize(); a=torch.cuda.Event(True); b=torch.cuda.Event(True); a.record()\n  for _ in range(100): f(*xs,1e-6)\n  b.record(); b.synchronize(); print(name,a.elapsed_time(b)/100)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
