{"type":"item.started","item":{"id":"item_9","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport torch\nimport torch.nn.functional as F\nfrom reference import run as ref\n\ntorch.manual_seed(123)\ndev='cuda:0'; B,S,D=1,128,1536\nxs=[torch.randn(B,S,D,device=dev), torch.randn(3*D,D,device=dev), torch.randn(3*D,device=dev),\n    torch.randn(64,device=dev), torch.randn(64,device=dev), torch.randn(64,device=dev), torch.randn(64,device=dev),\n    torch.randn(D,D,device=dev), torch.randn(D,device=dev)]\neps=1e-6\n\ndef cand(linear=False, ln=False, sdpa=False):\n    x,w,b,qw,qb,kw,kb,ow,ob=xs\n    qkv = F.linear(x,w,b) if linear else torch.matmul(x,w.t())+b\n    q,k,v=qkv.reshape(B,S,3,24,64).permute(2,0,3,1,4)\n    if ln:\n      q=F.layer_norm(q,(64,),qw,qb,eps)\n      k=F.layer_norm(k,(64,),kw,kb,eps)\n    else:\n      qm=q.mean(-1,True); qv=q.var(-1,False,True); q=(q-qm)/torch.sqrt(qv+eps); q=q*qw+qb\n      km=k.mean(-1,True); kv=k.var(-1,False,True); k=(k-km)/torch.sqrt(kv+eps); k=k*kw+kb\n    if sdpa:\n      a=F.scaled_dot_product_attention(q,k,v,scale=.125)\n    else:\n      a=torch.matmul(F.softmax(torch.matmul(q*.125,k.transpose(-2,-1)),-1),v)\n    a=a.transpose(1,2).reshape(B,S,D)\n    return F.linear(a,ow,ob) if linear else torch.matmul(a,ow.t())+ob\n\ny=ref(*xs,eps)\ntorch.cuda.synchronize()\nfor label,opts in [('linear',(1,0,0)),('ln',(0,1,0)),('sdpa',(0,0,1)),('linear+ln',(1,1,0)),('all',(1,1,1))]:\n  z=cand(*opts); torch.cuda.synchronize()\n  d=(z-y).abs(); rel=d/y.abs().clamp_min(1e-30)\n  ok=torch.isclose(z,y,atol=1.67e-7,rtol=1.1920928955078125e-7)\n  print(label, 'maxabs',d.max().item(),'mean',d.mean().item(),'maxrel',rel.max().item(),'ratio',ok.float().mean().item())\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
