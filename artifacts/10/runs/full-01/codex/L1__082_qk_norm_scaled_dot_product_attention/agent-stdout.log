{"type":"item.started","item":{"id":"item_41","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport torch\nimport torch.nn.functional as F\nfrom kernel import _normalize_and_pack_qkv\nD=1536\n\ndef once(xs, record=False):\n x,w,b,qw,qb,kw,kb,ow,ob=xs;B,S,D=x.shape\n ev=[torch.cuda.Event(True) for _ in range(8)] if record else None\n if ev:ev[0].record()\n qkv=F.linear(x,w,b)\n if ev:ev[1].record()\n qkvv=qkv.reshape(B,S,3,24,64).permute(2,0,3,1,4);qk=qkvv[:2];m=qk.mean(-1,True);var=qk.var(-1,False,True)\n if ev:ev[2].record()\n rows=B*24*S;pack=torch.empty(3,B,24,S,64,device='cuda');_normalize_and_pack_qkv[(rows,)](qkv,m,var,qw,qb,kw,kb,pack,n_rows=rows,seq_len=S,eps=1e-6,num_warps=1)\n if ev:ev[3].record()\n q,k,v=[pack[i].reshape(B*24,S,64) for i in range(3)];score=torch.bmm(q,k.transpose(1,2))\n if ev:ev[4].record()\n p=F.softmax(score,-1)\n if ev:ev[5].record()\n a=torch.empty(S,B,24,64,device='cuda');out=torch.as_strided(a,(B*24,S,64),(64,B*24*64,1));torch.bmm(p,v,out=out)\n if ev:ev[6].record()\n y=F.linear(a.reshape(S,B,D),ow,ob).permute(1,0,2)\n if ev:ev[7].record();ev[-1].synchronize();return [ev[i].elapsed_time(ev[i+1]) for i in range(7)]\n return y\nfor B,S,N in [(1,128,100),(4,293,100),(16,691,20)]:\n xs=[torch.randn(B,S,D,device='cuda'),torch.randn(3*D,D,device='cuda'),torch.randn(3*D,device='cuda'),torch.randn(64,device='cuda'),torch.randn(64,device='cuda'),torch.randn(64,device='cuda'),torch.randn(64,device='cuda'),torch.randn(D,D,device='cuda'),torch.randn(D,device='cuda')]\n for _ in range(10):once(xs)\n torch.cuda.synchronize(); vals=[once(xs,True) for _ in range(N)]; avg=[sum(v[i] for v in vals)/N for i in range(7)]\n print(B,S,dict(zip(['qkv','moments','pack','qk_bmm','softmax','pv_bmm','out'],avg)),'sum',sum(avg))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
