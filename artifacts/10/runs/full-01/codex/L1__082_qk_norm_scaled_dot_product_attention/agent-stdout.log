{"type":"item.started","item":{"id":"item_34","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport torch\nimport torch.nn.functional as F\nfrom reference import run as ref\nfrom experiment_kernel import norm_qkv_kernel\nD=1536\n\ndef cand(x,w,b,qw,qb,kw,kb,ow,ob,eps,mode):\n B,S,D=x.shape;qkv=F.linear(x,w,b);base=qkv.reshape(B,S,3,24,64).permute(2,0,3,1,4);qk=base[:2];m=qk.mean(-1,True);var=qk.var(-1,False,True);rows=B*24*S;packed=torch.empty((3,B,24,S,64),device=x.device)\n norm_qkv_kernel[(rows,)](qkv,m,var,qw,qb,kw,kb,packed,n_rows=rows,seq_len=S,eps=eps,num_warps=1)\n q,k,v=packed\n p=F.softmax(torch.bmm(q.reshape(B*24,S,64),k.reshape(B*24,S,64).transpose(1,2)),-1)\n if mode==0:\n  a=torch.bmm(p,v.reshape(B*24,S,64)).reshape(B,24,S,64).transpose(1,2).reshape(B,S,D)\n else:\n  a4=torch.empty((B,S,24,64),device=x.device); out=a4.permute(0,2,1,3)\n  torch.matmul(p.reshape(B,24,S,S),v,out=out)\n  a=a4.reshape(B,S,D)\n return F.linear(a,ow,ob)\n\nfor B,S in [(1,128),(4,293),(1,1024)]:\n xs=[torch.randn(B,S,D,device='cuda'),torch.randn(3*D,D,device='cuda'),torch.randn(3*D,device='cuda'),torch.randn(64,device='cuda'),torch.randn(64,device='cuda'),torch.randn(64,device='cuda'),torch.randn(64,device='cuda'),torch.randn(D,D,device='cuda'),torch.randn(D,device='cuda')]\n y=ref(*xs,1e-6)\n for mode in range(2):\n  z=cand(*xs,1e-6,mode);torch.cuda.synchronize();d=(z-y).abs();print(B,S,mode,torch.equal(z,y),d.max().item())\n  for _ in range(5):cand(*xs,1e-6,mode)\n  torch.cuda.synchronize();st=torch.cuda.Event(True);en=torch.cuda.Event(True);st.record()\n  for _ in range(100):cand(*xs,1e-6,mode)\n  en.record();en.synchronize();print('ms',st.elapsed_time(en)/100)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
