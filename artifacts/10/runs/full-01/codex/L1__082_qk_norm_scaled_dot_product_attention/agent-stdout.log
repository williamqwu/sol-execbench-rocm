{"type":"item.started","item":{"id":"item_46","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport torch,numpy as np\nN=2000;x=torch.randn(N,64,device='cuda');target=x.var(-1,False).cpu().numpy().view(np.uint32);a=x.cpu().numpy()\nf=np.float32\n\ndef comb(A,B):\n ma,m2a,na=A;mb,m2b,nb=B\n if na==0:return B\n if nb==0:return A\n delta=f(mb-ma); n=na+nb; ratio=f(f(nb)/f(n))\n mean=f(ma+f(delta*ratio))\n m2=f(m2a+f(m2b+f(f(delta*delta)*f(f(na)*ratio))))\n return mean,m2,n\n\ndef cand(row,T,kind):\n vals=[]\n for t in range(T):\n  inds=range(t,64,T) if kind=='stride' else range(t*(64//T),(t+1)*(64//T))\n  z=(f(0),f(0),0)\n  for i in inds:z=comb(z,(f(row[i]),f(0),1))\n  vals.append(z)\n off=T//2\n while off:\n  for i in range(off):vals[i]=comb(vals[i],vals[i+off])\n  off//=2\n return f(vals[0][1]/f(64))\nfor kind in ['stride','contig']:\n for T in [1,2,4,8,16,32,64]:\n  out=np.array([cand(r,T,kind) for r in a],np.float32).view(np.uint32)\n  print(kind,T,np.mean(out==target),np.max(np.abs(out.view(np.float32)-target.view(np.float32))))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
