{"type":"item.started","item":{"id":"item_49","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport torch,kernel,itertools\nS=64\nxs=[torch.rand((S,16,128),device='cuda') for _ in range(4)];e=torch.rand((S,128),device='cuda')\nouts=[torch.empty_like(xs[0]),torch.empty_like(xs[0]),torch.empty_like(e)]\nkernel._backward_parallel_kernel[(S,)](*xs,e,*outs,num_warps=4)\nt=xs[0]*xs[2]+xs[1]*xs[3]\na=[]\nfor r in range(4):\n x=torch.zeros_like(outs[2])\n for h in range(r,16,4):x=x+t[:,h]\n a.append(x)\nbest=[]\nfor p in itertools.permutations(range(4)):\n x0,x1,x2,x3=[a[i] for i in p]\n cs=[((x0+x1)+x2)+x3,(x0+(x1+x2))+x3,(x0+x1)+(x2+x3),x0+((x1+x2)+x3),x0+(x1+(x2+x3))]\n for ti,z in enumerate(cs):\n  eq=(outs[2]==z).float().mean().item()\n  best.append((eq,p,ti,(outs[2]-z).abs().max().item()))\ntorch.cuda.synchronize()\nfor x in sorted(best,reverse=True)[:12]:print(x)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
