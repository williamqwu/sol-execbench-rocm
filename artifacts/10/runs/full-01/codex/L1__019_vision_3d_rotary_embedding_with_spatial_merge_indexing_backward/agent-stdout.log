{"type":"item.completed","item":{"id":"item_57","type":"agent_message","text":"The exact parallel form is materially faster through sequence length 1024, while the one-wave form wins above that. I’m also checking whether a single shared output allocation reduces the roughly 4–5 μs fixed overhead; this is a layout-only change, and each returned tensor remains a normal contiguous view."}}
{"type":"item.started","item":{"id":"item_58","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport torch,triton,kernel\nfor S in (128,512,1024,4096):\n xs=[torch.rand((S,16,128),device='cuda') for _ in range(4)];e=torch.rand((S,128),device='cuda')\n def launch(outs):\n  if S<=1024:\n   w=1 if S<=256 else (2 if S<=512 else 4)\n   kernel._backward_parallel_kernel[(S,)](*xs,e,*outs,num_warps=4,waves_per_eu=w)\n  else: kernel._backward_kernel[(S,)](*xs,e,*outs,num_warps=1,waves_per_eu=(4 if S<3500 else 2))\n def sep():\n  outs=[torch.empty_like(xs[0]),torch.empty_like(xs[0]),torch.empty_like(e)];launch(outs);return outs\n def flat():\n  n=xs[0].numel();m=e.numel();buf=torch.empty(2*n+m,device=e.device,dtype=e.dtype)\n  outs=[buf[:n].view_as(xs[0]),buf[n:2*n].view_as(xs[0]),buf[2*n:].view_as(e)];launch(outs);return outs\n def pair():\n  pair=torch.empty((2,)+xs[0].shape,device=e.device,dtype=e.dtype);oe=torch.empty_like(e)\n  outs=[pair[0],pair[1],oe];launch(outs);return outs\n print(S,[(name,triton.testing.do_bench(fn,warmup=100,rep=500,return_mode='median')) for name,fn in [('sep',sep),('flat',flat),('pair',pair)]])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
