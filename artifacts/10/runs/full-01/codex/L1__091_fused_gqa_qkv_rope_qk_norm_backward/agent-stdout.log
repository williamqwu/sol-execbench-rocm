{"type":"item.started","item":{"id":"item_82","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport torch\nfrom kernel import _query_kernel,_key_value_kernel,_qkv_kernel\nD='cuda';bf=torch.bfloat16\nfor b,s in [(1,128),(32,256)]:\n m=b*s;R=lambda *sh:torch.randn(sh,device=D,dtype=bf)\n gq,gk,gv,c,si,qw,kw,qx,kx,qr,kr=(R(b,32,s,128),R(b,8,s,128),R(b,8,s,128),R(b,s,128),R(b,s,128),R(128),R(128),R(b,32,s,128),R(b,8,s,128),R(b,32,s,1),R(b,8,s,1))\n dq0=torch.empty(m,6144,device=D,dtype=bf);gc0=torch.empty(m,128,device=D,dtype=bf);gs0=torch.empty_like(gc0);qp0=torch.empty(m,128,device=D);kp0=torch.empty_like(qp0)\n dq1=torch.empty_like(dq0);gc1=torch.empty_like(gc0);gs1=torch.empty_like(gs0);qp1=torch.empty_like(qp0);kp1=torch.empty_like(kp0)\n def sep():\n  _query_kernel[(m,)](gq,qx,c,si,qw,qr,dq0,gc0,gs0,qp0,SEQ=s,num_warps=4 if m<1024 else 2)\n  _key_value_kernel[(m,)](gk,gv,kx,c,si,kw,kr,dq0,gc0,gs0,kp0,SEQ=s,num_warps=2 if m<1024 else 1)\n def comb(nw):_qkv_kernel[(m,)](gq,qx,gk,gv,kx,c,si,qw,kw,qr,kr,dq1,gc1,gs1,qp1,kp1,SEQ=s,num_warps=nw)\n sep();comb(2);torch.cuda.synchronize();print('M',m,'equal',[(x==y).float().mean().item() for x,y in [(dq0,dq1),(gc0,gc1),(gs0,gs1),(qp0,qp1),(kp0,kp1)]])\n for name,f in [('sep',sep)]+[(f'c{nw}',lambda nw=nw:comb(nw)) for nw in [1,2,4,8]]:\n  try:\n   for _ in range(3):f()\n   torch.cuda.synchronize();ts=[]\n   for _ in range(15):\n    x=torch.cuda.Event(enable_timing=True);y=torch.cuda.Event(enable_timing=True);x.record();f();y.record();y.synchronize();ts.append(x.elapsed_time(y))\n   print(name,sorted(ts)[7],min(ts))\n  except Exception as e:print(name,'ERR',str(e)[:160])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
