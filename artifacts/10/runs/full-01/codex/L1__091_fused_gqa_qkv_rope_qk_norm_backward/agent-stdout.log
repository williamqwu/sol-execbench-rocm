{"type":"item.started","item":{"id":"item_39","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport torch,aiter,time\nm=8192;d='cuda';bf=torch.bfloat16\nA=torch.randn(m,6144,device=d,dtype=bf);W=torch.randn(6144,4096,device=d,dtype=bf);H=torch.randn(m,4096,device=d,dtype=bf)\naiter.hipb_create_extension()\nfor name,a,b in [('nn',A,W),('tn',A.T,H)]:\n sols=aiter.hipb_findallsols(a,b);res=[];wall=time.time();bad=0\n for j,sol in enumerate(sols):\n  try:\n   st=torch.cuda.Event(enable_timing=True);en=torch.cuda.Event(enable_timing=True)\n   st.record();z=aiter.hipb_mm(a,b,sol);en.record();en.synchronize();res.append((st.elapsed_time(en),sol))\n  except Exception:bad+=1\n print(name,'wall',time.time()-wall,'bad',bad,'top20',sorted(res)[:20])\n # Retest the 10 fastest first-pass candidates.\n final=[]\n for _,sol in sorted(res)[:10]:\n  ts=[]\n  for _ in range(6):\n   st=torch.cuda.Event(enable_timing=True);en=torch.cuda.Event(enable_timing=True)\n   st.record();z=aiter.hipb_mm(a,b,sol);en.record();en.synchronize();ts.append(st.elapsed_time(en))\n  final.append((sorted(ts)[3],min(ts),sol))\n print(name,'retest',sorted(final))\n for _,_,sol in sorted(final)[:3]: print(sol,aiter.getHipblasltKernelName(sol))\naiter.hipb_destroy_extension()\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
