{"type":"item.started","item":{"id":"item_45","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport torch\nfrom kernel import _query_kernel,_key_value_kernel\nD='cuda';bf=torch.bfloat16\nfor b,s in [(1,128),(32,256)]:\n m=b*s;R=lambda *sh:torch.randn(sh,device=D,dtype=bf)\n gq,gk,gv,c,si,qw,kw,qx,kx,qr,kr=(R(b,32,s,128),R(b,8,s,128),R(b,8,s,128),R(b,s,128),R(b,s,128),R(128),R(128),R(b,32,s,128),R(b,8,s,128),R(b,32,s,1),R(b,8,s,1))\n dq=torch.empty((m,6144),device=D,dtype=bf);gc=torch.empty((m,128),device=D,dtype=bf);gs=torch.empty_like(gc);qp=torch.empty((m,128),device=D);kp=torch.empty_like(qp)\n print('M',m)\n for name,kern,args in [('q',_query_kernel,(gq,qx,c,si,qw,qr,dq,gc,gs,qp)),('k',_key_value_kernel,(gk,gv,kx,c,si,kw,kr,dq,gc,gs,kp))]:\n  for nw in [2,4,8,16]:\n   try:\n    for _ in range(3):kern[(m,)](*args,SEQ=s,num_warps=nw)\n    torch.cuda.synchronize();ts=[]\n    for _ in range(12):\n     x=torch.cuda.Event(enable_timing=True);y=torch.cuda.Event(enable_timing=True);x.record();kern[(m,)](*args,SEQ=s,num_warps=nw);y.record();y.synchronize();ts.append(x.elapsed_time(y))\n    print(name,nw,round(sorted(ts)[6],5),round(min(ts),5))\n   except Exception as e:print(name,nw,'ERR',str(e)[:120])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
