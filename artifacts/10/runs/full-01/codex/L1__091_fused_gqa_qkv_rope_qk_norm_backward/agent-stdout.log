{"type":"item.started","item":{"id":"item_66","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport torch,triton\nfrom kernel import _gemm_kernel\nD='cuda';bf=torch.bfloat16\nconfigs=[(64,64,32,4),(64,128,32,4),(128,64,32,4),(128,128,32,4),(128,128,32,8),(128,128,64,8),(256,64,32,8),(64,256,32,8),(256,128,32,8),(128,256,32,8)]\nfor k in [128,256,512,586,1571,2048]:\n A=torch.randn(k,6144,device=D,dtype=bf);B=torch.randn(k,4096,device=D,dtype=bf);M=6144;N=4096\n print('K',k)\n for BM,BN,BK,nw in configs:\n  try:\n   C=torch.empty(M,N,device=D,dtype=bf);grid=(triton.cdiv(M,BM)*triton.cdiv(N,BN),)\n   for _ in range(2):_gemm_kernel[grid](A,B,C,M=M,N=N,K=k,stride_am=1,stride_ak=6144,stride_bk=4096,stride_bn=1,BLOCK_M=BM,BLOCK_N=BN,BLOCK_K=BK,GROUP_M=8,num_warps=nw,num_stages=2)\n   torch.cuda.synchronize();ts=[]\n   for _ in range(5):\n    x=torch.cuda.Event(enable_timing=True);y=torch.cuda.Event(enable_timing=True);x.record();_gemm_kernel[grid](A,B,C,M=M,N=N,K=k,stride_am=1,stride_ak=6144,stride_bk=4096,stride_bn=1,BLOCK_M=BM,BLOCK_N=BN,BLOCK_K=BK,GROUP_M=8,num_warps=nw,num_stages=2);y.record();y.synchronize();ts.append(x.elapsed_time(y))\n   print((BM,BN,BK,nw),round(sorted(ts)[2],4),end='; ')\n  except Exception as e:print('ERR',str(e)[:50])\n print()\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
