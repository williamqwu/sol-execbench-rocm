{"type":"item.started","item":{"id":"item_76","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport torch,aiter,time,gc\nD='cuda';bf=torch.bfloat16\naiter.hipb_create_extension();W=torch.randn(6144,4096,device=D,dtype=bf)\nfor m in [1571,2164]:\n A=torch.randn(m,6144,device=D,dtype=bf);H=torch.randn(m,4096,device=D,dtype=bf)\n pairs=[('nn',A,W)] + ([('tn',A.T,H)] if m==2164 else [])\n for name,a,b in pairs:\n  sols=aiter.hipb_findallsols(a,b);res=[];wall=time.time()\n  for sol in sols:\n   x=torch.cuda.Event(enable_timing=True);y=torch.cuda.Event(enable_timing=True);x.record();z=aiter.hipb_mm(a,b,sol);y.record();y.synchronize();res.append((x.elapsed_time(y),sol))\n  finals=[]\n  for _,sol in sorted(res)[:10]:\n   ts=[]\n   for _ in range(6):\n    x=torch.cuda.Event(enable_timing=True);y=torch.cuda.Event(enable_timing=True);x.record();z=aiter.hipb_mm(a,b,sol);y.record();y.synchronize();ts.append(x.elapsed_time(y))\n   finals.append((sorted(ts)[3],min(ts),sol))\n  print(m,name,'wall',round(time.time()-wall,2),'first',sorted(res)[:12],'final',sorted(finals))\n del A,H;gc.collect();torch.cuda.empty_cache()\naiter.hipb_destroy_extension()\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
