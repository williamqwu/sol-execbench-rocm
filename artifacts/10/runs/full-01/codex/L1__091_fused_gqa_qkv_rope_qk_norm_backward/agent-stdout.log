{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,230p' kernel.py\"","aggregated_output":"import torch\nimport triton\nimport triton.language as tl\n\n\n@triton.jit\ndef _query_kernel(\n    grad_ptr, x_ptr, cos_ptr, sin_ptr, weight_ptr, rstd_ptr,\n    dqkv_ptr, grad_cos_ptr, grad_sin_ptr, partial_weight_ptr,\n    SEQ: tl.constexpr,\n    H: tl.constexpr = 32,\n    D: tl.constexpr = 128,\n):\n    token = tl.program_id(0)\n    batch = token // SEQ\n    seq = token - batch * SEQ\n    heads = tl.arange(0, H)[:, None]\n    dims = tl.arange(0, D)[None, :]\n\n    in_offs = ((batch * H + heads) * SEQ + seq) * D + dims\n    g = tl.load(grad_ptr + in_offs).to(tl.float32)\n    x = tl.load(x_ptr + in_offs).to(tl.float32)\n    w = tl.load(weight_ptr + dims).to(tl.float32)\n    r = tl.load(rstd_ptr + (batch * H + heads) * SEQ + seq).to(tl.float32)\n\n    # Match the reference's float32 RMS-backward expression and its required\n    # bfloat16 boundary before the RoPE backward.\n    x_normed = x * r\n    weight_term = g * x_normed\n    grad_r = tl.sum((g * w) * x, axis=1)\n    direct = (g * w) * r\n    r3 = (r * r) * r\n    from_rstd = grad_r[:, None] * (((-r3) * x) * (1.0 / 128.0))\n    g = (direct + from_rstd).to(tl.bfloat16)\n\n    c = tl.load(cos_ptr + token * D + dims).to(tl.bfloat16)\n    s = tl.load(sin_ptr + token * D + dims).to(tl.bfloat16)\n    partner_dims = (dims + 64) % 128\n    partner_offs = ((batch * H + heads) * SEQ + seq) * D + partner_dims\n\n    # The signs are those of cat((g2, -g1)) and cat((-x2, x1)).\n    g_partner = tl.where(dims < 64, tl.load(grad_ptr + partner_offs), -tl.load(grad_ptr + partner_offs))\n    # g_partner above must use RMS output, not grad_output.  Recompute its RMS\n    # lane using a column permutation of the already computed tile.\n    g_partner = tl.where(dims < 64, tl.reshape(g, (H, 2, 64))[:, 1, :], -tl.reshape(g, (H, 2, 64))[:, 0, :])\n    rope_a = (g * c).to(tl.bfloat16)\n    rope_b = (g_partner * s).to(tl.bfloat16)\n    grad_pre_rope = (rope_a + rope_b).to(tl.bfloat16)\n\n    x_bf = x.to(tl.bfloat16)\n    x_partner = tl.where(dims < 64, -tl.reshape(x_bf, (H, 2, 64))[:, 1, :], tl.reshape(x_bf, (H, 2, 64))[:, 0, :])\n    orig_a = (x_bf * c).to(tl.bfloat16)\n    orig_b = (x_partner * s).to(tl.bfloat16)\n    x_original = (orig_a + orig_b).to(tl.bfloat16)\n\n    cos_product = (g * x_original).to(tl.bfloat16)\n    x_orig_partner = tl.where(dims < 64, -tl.reshape(x_original, (H, 2, 64))[:, 1, :], tl.reshape(x_original, (H, 2, 64))[:, 0, :])\n    sin_product = (g * x_orig_partner).to(tl.bfloat16)\n    grad_cos = tl.sum(cos_product.to(tl.float32), axis=0).to(tl.bfloat16)\n    grad_sin = tl.sum(sin_product.to(tl.float32), axis=0).to(tl.bfloat16)\n    partial_weight = tl.sum(weight_term, axis=0)\n\n    out_offs = token * 6144 + heads * D + dims\n    tl.store(dqkv_ptr + out_offs, grad_pre_rope)\n    tl.store(grad_cos_ptr + token * D + tl.arange(0, D), grad_cos)\n    tl.store(grad_sin_ptr + token * D + tl.arange(0, D), grad_sin)\n    tl.store(partial_weight_ptr + token * D + tl.arange(0, D), partial_weight)\n\n\n@triton.jit\ndef _key_value_kernel(\n    grad_ptr, value_ptr, x_ptr, cos_ptr, sin_ptr, weight_ptr, rstd_ptr,\n    dqkv_ptr, grad_cos_ptr, grad_sin_ptr, partial_weight_ptr,\n    SEQ: tl.constexpr,\n    H: tl.constexpr = 8,\n    D: tl.constexpr = 128,\n):\n    token = tl.program_id(0)\n    batch = token // SEQ\n    seq = token - batch * SEQ\n    heads = tl.arange(0, H)[:, None]\n    dims = tl.arange(0, D)[None, :]\n    in_offs = ((batch * H + heads) * SEQ + seq) * D + dims\n\n    g = tl.load(grad_ptr + in_offs).to(tl.float32)\n    x = tl.load(x_ptr + in_offs).to(tl.float32)\n    w = tl.load(weight_ptr + dims).to(tl.float32)\n    r = tl.load(rstd_ptr + (batch * H + heads) * SEQ + seq).to(tl.float32)\n    weight_term = g * (x * r)\n    grad_r = tl.sum((g * w) * x, axis=1)\n    direct = (g * w) * r\n    r3 = (r * r) * r\n    g = (direct + grad_r[:, None] * (((-r3) * x) * (1.0 / 128.0))).to(tl.bfloat16)\n\n    c = tl.load(cos_ptr + token * D + dims).to(tl.bfloat16)\n    s = tl.load(sin_ptr + token * D + dims).to(tl.bfloat16)\n    g_partner = tl.where(dims < 64, tl.reshape(g, (H, 2, 64))[:, 1, :], -tl.reshape(g, (H, 2, 64))[:, 0, :])\n    grad_pre_rope = ((g * c).to(tl.bfloat16) + (g_partner * s).to(tl.bfloat16)).to(tl.bfloat16)\n\n    x_bf = x.to(tl.bfloat16)\n    x_partner = tl.where(dims < 64, -tl.reshape(x_bf, (H, 2, 64))[:, 1, :], tl.reshape(x_bf, (H, 2, 64))[:, 0, :])\n    x_original = ((x_bf * c).to(tl.bfloat16) + (x_partner * s).to(tl.bfloat16)).to(tl.bfloat16)\n    cos_product = (g * x_original).to(tl.bfloat16)\n    x_orig_partner = tl.where(dims < 64, -tl.reshape(x_original, (H, 2, 64))[:, 1, :], tl.reshape(x_original, (H, 2, 64))[:, 0, :])\n    sin_product = (g * x_orig_partner).to(tl.bfloat16)\n    key_cos = tl.sum(cos_product.to(tl.float32), axis=0).to(tl.bfloat16)\n    key_sin = tl.sum(sin_product.to(tl.float32), axis=0).to(tl.bfloat16)\n    partial_weight = tl.sum(weight_term, axis=0)\n\n    out_offs = token * 6144 + 4096 + heads * D + dims\n    tl.store(dqkv_ptr + out_offs, grad_pre_rope)\n    tl.store(dqkv_ptr + out_offs + 1024, tl.load(value_ptr + in_offs))\n\n    flat_dims = tl.arange(0, D)\n    old_cos = tl.load(grad_cos_ptr + token * D + flat_dims)\n    old_sin = tl.load(grad_sin_ptr + token * D + flat_dims)\n    tl.store(grad_cos_ptr + token * D + flat_dims, (old_cos + key_cos).to(tl.bfloat16))\n    tl.store(grad_sin_ptr + token * D + flat_dims, (old_sin + key_sin).to(tl.bfloat16))\n    tl.store(partial_weight_ptr + token * D + flat_dims, partial_weight)\n\n\n@triton.jit\ndef _weight_reduce_kernel(q_partial, k_partial, q_out, k_out, M: tl.constexpr, BLOCK_M: tl.constexpr):\n    d = tl.program_id(0)\n    rows = tl.arange(0, BLOCK_M)\n    mask = rows < M\n    q = tl.load(q_partial + rows * 128 + d, mask=mask, other=0.0)\n    k = tl.load(k_partial + rows * 128 + d, mask=mask, other=0.0)\n    tl.store(q_out + d, tl.sum(q, axis=0).to(tl.bfloat16))\n    tl.store(k_out + d, tl.sum(k, axis=0).to(tl.bfloat16))\n\n\n@torch.no_grad()\ndef run(\n    grad_query, grad_key, grad_value, hidden_states, cos, sin, qkv_weight,\n    q_norm_weight, k_norm_weight, query_pre_norm, key_pre_norm, q_rstd,\n    k_rstd, eps,\n):\n    b, seq, _ = hidden_states.shape\n    m = b * seq\n    device = hidden_states.device\n    dqkv = torch.empty((m, 6144), device=device, dtype=torch.bfloat16)\n    grad_cos = torch.empty((m, 128), device=device, dtype=torch.bfloat16)\n    grad_sin = torch.empty_like(grad_cos)\n    q_partial = torch.empty((m, 128), device=device, dtype=torch.float32)\n    k_partial = torch.empty_like(q_partial)\n\n    _query_kernel[(m,)](\n        grad_query, query_pre_norm, cos, sin, q_norm_weight, q_rstd,\n        dqkv, grad_cos, grad_sin, q_partial, SEQ=seq, num_warps=8,\n    )\n    _key_value_kernel[(m,)](\n        grad_key, grad_value, key_pre_norm, cos, sin, k_norm_weight, k_rstd,\n        dqkv, grad_cos, grad_sin, k_partial, SEQ=seq, num_warps=4,\n    )\n\n    grad_q_weight = torch.empty((128,), device=device, dtype=torch.bfloat16)\n    grad_k_weight = torch.empty_like(grad_q_weight)\n    block_m = triton.next_power_of_2(m)\n    _weight_reduce_kernel[(128,)](\n        q_partial, k_partial, grad_q_weight, grad_k_weight,\n        M=m, BLOCK_M=block_m, num_warps=8,\n    )\n\n    hidden = hidden_states.reshape(m, 4096)\n    grad_hidden = torch.mm(dqkv, qkv_weight).reshape(b, seq, 4096)\n    grad_weight = torch.mm(dqkv.T, hidden)\n    return grad_hidden, grad_cos.reshape(b, seq, 128), grad_sin.reshape(b, seq, 128), grad_weight, grad_q_weight, grad_k_weight\n","exit_code":0,"status":"completed"}}
