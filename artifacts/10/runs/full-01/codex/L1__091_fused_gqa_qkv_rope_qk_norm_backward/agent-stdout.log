{"type":"item.started","item":{"id":"item_16","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport torch, triton\nfrom kernel import _query_kernel,_key_value_kernel,_weight_reduce_kernel\n\ntorch.manual_seed(4); d='cuda'; bf=torch.bfloat16; b,s=32,256; m=b*s\nR=lambda *sh: torch.randn(sh,device=d,dtype=bf)\ngq,gk,gv,h,c,si,w,qw,kw,qx,kx,qr,kr=(R(b,32,s,128),R(b,8,s,128),R(b,8,s,128),R(b,s,4096),R(b,s,128),R(b,s,128),R(6144,4096),R(128),R(128),R(b,32,s,128),R(b,8,s,128),R(b,32,s,1),R(b,8,s,1))\ndq=torch.empty((m,6144),device=d,dtype=bf); gc=torch.empty((m,128),device=d,dtype=bf); gs=torch.empty_like(gc); qp=torch.empty((m,128),device=d); kp=torch.empty_like(qp); qo=torch.empty(128,device=d,dtype=bf); ko=torch.empty_like(qo)\ndef q(): _query_kernel[(m,)](gq,qx,c,si,qw,qr,dq,gc,gs,qp,SEQ=s,num_warps=8)\ndef k(): _key_value_kernel[(m,)](gk,gv,kx,c,si,kw,kr,dq,gc,gs,kp,SEQ=s,num_warps=4)\ndef red(): _weight_reduce_kernel[(128,)](qp,kp,qo,ko,M=m,BLOCK_M=triton.next_power_of_2(m),num_warps=8)\ndef mm1(): return torch.mm(dq,w)\ndef mm2(): return torch.mm(dq.T,h.reshape(m,4096))\nfor name,f in [('q',q),('k',k),('reduce',red),('mm1',mm1),('mm2',mm2)]:\n  for _ in range(3): z=f()\n  torch.cuda.synchronize(); ts=[]\n  for _ in range(20):\n    a=torch.cuda.Event(enable_timing=True); e=torch.cuda.Event(enable_timing=True); a.record(); z=f(); e.record(); e.synchronize(); ts.append(a.elapsed_time(e))\n  print(name, 'med',sorted(ts)[10], 'min',min(ts), 'all',sorted(ts)[:5])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
