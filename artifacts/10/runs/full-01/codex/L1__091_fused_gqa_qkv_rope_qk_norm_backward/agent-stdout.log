{"type":"item.started","item":{"id":"item_38","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport torch,aiter,time\nm=8192;d='cuda';bf=torch.bfloat16\nA=torch.randn(m,6144,device=d,dtype=bf);W=torch.randn(6144,4096,device=d,dtype=bf);H=torch.randn(m,4096,device=d,dtype=bf)\naiter.hipb_create_extension()\nfor name,a,b in [('nn',A,W),('tn',A.T,H)]:\n sols=aiter.hipb_findallsols(a,b); print(name,'n',len(sols))\n tests=sols[:30]\n res=[]\n for sol in tests:\n  try:\n   st=torch.cuda.Event(enable_timing=True);en=torch.cuda.Event(enable_timing=True);st.record();z=aiter.hipb_mm(a,b,sol);en.record();en.synchronize();res.append((st.elapsed_time(en),sol))\n  except Exception as e: print('bad',sol,str(e)[:80])\n print('top',sorted(res)[:15])\n for sol in [x[1] for x in sorted(res)[:3]]:\n  ts=[]\n  for _ in range(8):\n   st=torch.cuda.Event(enable_timing=True);en=torch.cuda.Event(enable_timing=True);st.record();z=aiter.hipb_mm(a,b,sol);en.record();en.synchronize();ts.append(st.elapsed_time(en))\n  print(sol,sorted(ts),aiter.getHipblasltKernelName(sol))\naiter.hipb_destroy_extension()\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
