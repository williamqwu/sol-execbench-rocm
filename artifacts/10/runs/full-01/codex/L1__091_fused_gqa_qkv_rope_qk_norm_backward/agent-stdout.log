{"type":"item.started","item":{"id":"item_65","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport torch,triton\nfrom kernel import _weight_reduce_kernel,_weight_block_reduce_kernel\nD='cuda';m=8192\nq=torch.randn(m,128,device=D);k=torch.randn_like(q);qo=torch.empty(128,device=D,dtype=torch.bfloat16);ko=torch.empty_like(qo)\ndef old():_weight_reduce_kernel[(128,)](q,k,qo,ko,M=m,BLOCK_M=8192,num_warps=8)\nconfigs=[(8,2),(8,4),(16,2),(16,4),(16,8),(32,4),(32,8),(64,8)]\nfor br,nw in configs:\n nb=triton.cdiv(m,br);qb=torch.empty(nb,128,device=D);kb=torch.empty_like(qb)\n def f(br=br,nw=nw,nb=nb,qb=qb,kb=kb):\n  _weight_block_reduce_kernel[(nb,)](q,k,qb,kb,M=m,BLOCK_ROWS=br,num_warps=nw)\n  _weight_reduce_kernel[(128,)](qb,kb,qo,ko,M=nb,BLOCK_M=triton.next_power_of_2(nb),num_warps=4)\n for _ in range(3):f()\n torch.cuda.synchronize();ts=[]\n for _ in range(20):\n  x=torch.cuda.Event(enable_timing=True);y=torch.cuda.Event(enable_timing=True);x.record();f();y.record();y.synchronize();ts.append(x.elapsed_time(y))\n print(br,nw,sorted(ts)[10],min(ts))\nfor _ in range(3):old()\ntorch.cuda.synchronize();ts=[]\nfor _ in range(20):\n x=torch.cuda.Event(enable_timing=True);y=torch.cuda.Event(enable_timing=True);x.record();old();y.record();y.synchronize();ts.append(x.elapsed_time(y))\nprint('old',sorted(ts)[10],min(ts))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
