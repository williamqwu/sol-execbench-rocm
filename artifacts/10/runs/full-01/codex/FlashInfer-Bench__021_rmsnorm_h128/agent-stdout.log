{"type":"item.completed","item":{"id":"item_29","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,280p' kernel.py\"","aggregated_output":"import torch\nimport triton\nimport triton.language as tl\n\n\n@triton.jit\ndef _rmsnorm_kernel(x_ptr, w_ptr, y_ptr, n_rows: tl.constexpr):\n    row = tl.program_id(0)\n    cols = tl.arange(0, 128)\n    offsets = row * 128 + cols\n\n    x = tl.load(x_ptr + offsets).to(tl.float32)\n    w = tl.load(w_ptr + cols).to(tl.float32)\n    mean_square = tl.sum(x * x, axis=0) * (1.0 / 128.0)\n    inv_rms = tl.rsqrt(mean_square + 1.0e-6)\n    tl.store(y_ptr + offsets, x * inv_rms * w)\n\n\n@triton.jit\ndef _rmsnorm_grouped_kernel(\n    x_ptr,\n    w_ptr,\n    y_ptr,\n    n_rows,\n    ROWS: tl.constexpr,\n    EVEN_N: tl.constexpr,\n    CACHE_MODE: tl.constexpr,\n):\n    rows = tl.program_id(0) * ROWS + tl.arange(0, ROWS)\n    cols = tl.arange(0, 128)\n    offsets = rows[:, None] * 128 + cols[None, :]\n    if EVEN_N:\n        if CACHE_MODE == 7 or CACHE_MODE == 11:\n            x = tl.load(x_ptr + offsets, cache_modifier=\".cv\").to(tl.float32)\n        elif CACHE_MODE == 9 or CACHE_MODE == 12:\n            x = tl.load(\n                x_ptr + offsets,\n                cache_modifier=\".cg\",\n                eviction_policy=\"evict_first\",\n            ).to(tl.float32)\n        elif (\n            CACHE_MODE == 1\n            or CACHE_MODE == 3\n            or (CACHE_MODE >= 4 and CACHE_MODE <= 9)\n        ):\n            x = tl.load(x_ptr + offsets, cache_modifier=\".cg\").to(tl.float32)\n        else:\n            x = tl.load(x_ptr + offsets).to(tl.float32)\n    else:\n        mask = rows[:, None] < n_rows\n        if CACHE_MODE == 1 or CACHE_MODE == 3:\n            x = tl.load(\n                x_ptr + offsets, mask=mask, other=0.0, cache_modifier=\".cg\"\n            ).to(tl.float32)\n        else:\n            x = tl.load(x_ptr + offsets, mask=mask, other=0.0).to(tl.float32)\n    w = tl.load(w_ptr + cols).to(tl.float32)\n    mean_square = tl.sum(x * x, axis=1) * (1.0 / 128.0)\n    inv_rms = tl.rsqrt(mean_square + 1.0e-6)\n    y = x * inv_rms[:, None] * w[None, :]\n    if EVEN_N:\n        if CACHE_MODE == 2 or CACHE_MODE == 3:\n            tl.store(y_ptr + offsets, y, cache_modifier=\".cs\")\n        elif CACHE_MODE == 4:\n            tl.store(y_ptr + offsets, y, cache_modifier=\".cg\")\n        elif CACHE_MODE == 5 or CACHE_MODE >= 10:\n            tl.store(y_ptr + offsets, y, cache_modifier=\".wt\")\n        elif CACHE_MODE == 6:\n            tl.store(y_ptr + offsets, y, cache_modifier=\".wb\")\n        elif CACHE_MODE == 7 or CACHE_MODE == 9:\n            tl.store(y_ptr + offsets, y, cache_modifier=\".cs\")\n        else:\n            tl.store(y_ptr + offsets, y)\n    else:\n        if CACHE_MODE == 2 or CACHE_MODE == 3:\n            tl.store(y_ptr + offsets, y, mask=mask, cache_modifier=\".cs\")\n        else:\n            tl.store(y_ptr + offsets, y, mask=mask)\n\n\n@triton.jit\ndef _rmsnorm_persistent_kernel(\n    x_ptr,\n    w_ptr,\n    y_ptr,\n    n_rows,\n    NPROGRAMS: tl.constexpr,\n):\n    cols = tl.arange(0, 128)\n    w = tl.load(w_ptr + cols).to(tl.float32)\n    for row in tl.range(tl.program_id(0), n_rows, NPROGRAMS):\n        offsets = row * 128 + cols\n        x = tl.load(x_ptr + offsets).to(tl.float32)\n        mean_square = tl.sum(x * x, axis=0) * (1.0 / 128.0)\n        inv_rms = tl.rsqrt(mean_square + 1.0e-6)\n        tl.store(y_ptr + offsets, x * inv_rms * w)\n\n\ndef run_config(hidden_states, weight, rows, num_warps, waves_per_eu=1, cache_mode=0):\n    n_rows = hidden_states.shape[0]\n    output = torch.empty_like(hidden_states)\n    _rmsnorm_grouped_kernel[(triton.cdiv(n_rows, rows),)](\n        hidden_states,\n        weight,\n        output,\n        n_rows,\n        ROWS=rows,\n        EVEN_N=(n_rows % rows == 0),\n        CACHE_MODE=cache_mode,\n        num_warps=num_warps,\n        waves_per_eu=waves_per_eu,\n    )\n    return output\n\n\ndef run_persistent(hidden_states, weight, nprograms, num_warps):\n    n_rows = hidden_states.shape[0]\n    nprograms = min(n_rows, nprograms)\n    output = torch.empty_like(hidden_states)\n    _rmsnorm_persistent_kernel[(nprograms,)](\n        hidden_states,\n        weight,\n        output,\n        n_rows,\n        NPROGRAMS=nprograms,\n        num_warps=num_warps,\n    )\n    return output\n\n\ndef run_single(hidden_states, weight, num_warps, waves_per_eu=0):\n    n_rows = hidden_states.shape[0]\n    output = torch.empty_like(hidden_states)\n    _rmsnorm_kernel[(n_rows,)](\n        hidden_states,\n        weight,\n        output,\n        n_rows=n_rows,\n        num_warps=num_warps,\n        waves_per_eu=waves_per_eu,\n    )\n    return output\n\n\ndef run(hidden_states, weight):\n    n_rows = hidden_states.shape[0]\n    output = torch.empty_like(hidden_states)\n    _rmsnorm_kernel[(n_rows,)](\n        hidden_states,\n        weight,\n        output,\n        n_rows=n_rows,\n        num_warps=2,\n    )\n    return output\n","exit_code":0,"status":"completed"}}
