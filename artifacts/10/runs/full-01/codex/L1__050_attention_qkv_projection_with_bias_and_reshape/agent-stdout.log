{"type":"item.started","item":{"id":"item_29","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch,triton\nimport kernel\nbases={512:(64,64,64,4,4),1024:(64,128,64,8,3),2048:(128,128,32,4,3),4096:(128,64,64,8,3)}\nfor M,(bm,bn,bk,nw,st) in bases.items():\n variants=[]\n def add(nw=nw,st=st,g=8,w=1,mi=0):\n  c=(nw,st,g,w,mi)\n  if c not in variants:variants.append(c)\n for g in (1,2,4,8,16,32):add(g=g)\n for w in (0,1,2,3,4):add(w=w)\n for mi in (16,32):add(mi=mi)\n for n in (2,4,8):add(nw=n)\n for s in (1,2,3,4):add(st=s)\n x=torch.randn((1,M,640),device='cuda',dtype=torch.bfloat16)\n ws=[torch.randn((n,640),device='cuda',dtype=torch.bfloat16) for n in (1024,256,256)]\n bs=[torch.randn((n,),device='cuda',dtype=torch.bfloat16) for n in (1024,256,256)]\n args=(x,ws[0],bs[0],ws[1],bs[1],ws[2],bs[2])\n vals=[]\n for c in variants:\n  try:\n   fn=lambda c=c:kernel._run_triton(*args,block_m=bm,block_n=bn,block_k=bk,num_warps=c[0],num_stages=c[1],group_m=c[2],waves_per_eu=c[3],matrix_instr_nonkdim=c[4])\n   t=triton.testing.do_bench(fn,warmup=10,rep=80,return_mode='median')\n   vals.append((t,c))\n  except:pass\n print('M',M,'BEST',sorted(vals)[:10])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
