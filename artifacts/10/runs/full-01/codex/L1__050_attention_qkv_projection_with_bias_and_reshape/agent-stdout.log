{"type":"item.started","item":{"id":"item_25","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch,triton\nimport kernel\nfor M in (1024,4096,8192):\n x=torch.randn((M,640),device='cuda',dtype=torch.bfloat16)\n ws=[torch.randn((n,640),device='cuda',dtype=torch.bfloat16) for n in (1024,256,256)]\n bs=[torch.randn((n,),device='cuda',dtype=torch.bfloat16) for n in (1024,256,256)]\n args=(x.view(1,M,640),ws[0],bs[0],ws[1],bs[1],ws[2],bs[2])\n def catgemm():\n  w=torch.cat(ws)\n  b=torch.cat(bs)\n  o=torch.addmm(b,x,w.t())\n  return o[:,:1024],o[:,1024:1280],o[:,1280:]\n y=catgemm(); r=[x@w.t()+b for w,b in zip(ws,bs)]\n print('correct',M,[torch.isclose(a.float(),b.float(),atol=.01116,rtol=.0078125).float().mean().item() for a,b in zip(y,r)])\n print('times',M,'cat',triton.testing.do_bench(catgemm,warmup=25,rep=100,return_mode='median'),'tri',triton.testing.do_bench(lambda:kernel.run(*args),warmup=25,rep=100,return_mode='median'))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
