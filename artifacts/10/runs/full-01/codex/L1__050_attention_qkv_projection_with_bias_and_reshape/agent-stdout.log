{"type":"item.started","item":{"id":"item_17","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch,triton\nimport kernel\nbases={131:(64,64,64,4),1024:(64,128,64,4),8192:(128,128,64,8)}\nfor M,base in bases.items():\n bm,bn,bk,nw=base\n variants=[]\n def add(bm=bm,bn=bn,bk=bk,nw=nw,st=2,g=8,w=1,mi=0,kp=1):\n  c=(bm,bn,bk,nw,st,g,w,mi,kp)\n  if c not in variants: variants.append(c)\n for x in (32,64,128): add(bk=x)\n for x in (2,4,8): add(nw=x)\n for x in (1,2,3,4): add(st=x)\n for x in (0,1,2,3,4): add(w=x)\n for x in (1,4,8,16,32): add(g=x)\n for mi in (16,32):\n  for kp in (1,2): add(mi=mi,kp=kp)\n x=torch.randn((1,M,640),device='cuda',dtype=torch.bfloat16)\n ws=[torch.randn((n,640),device='cuda',dtype=torch.bfloat16) for n in (1024,256,256)]\n bs=[torch.randn((n,),device='cuda',dtype=torch.bfloat16) for n in (1024,256,256)]\n args=(x,ws[0],bs[0],ws[1],bs[1],ws[2],bs[2])\n print('M',M)\n for c in variants:\n  try:\n   fn=lambda c=c:kernel._run_triton(*args,block_m=c[0],block_n=c[1],block_k=c[2],num_warps=c[3],num_stages=c[4],group_m=c[5],waves_per_eu=c[6],matrix_instr_nonkdim=c[7],kpack=c[8])\n   t=triton.testing.do_bench(fn,warmup=10,rep=80)\n   print(c,f'{t:.4f}')\n  except Exception as e: print(c,'ERR',str(e).splitlines()[-1])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
