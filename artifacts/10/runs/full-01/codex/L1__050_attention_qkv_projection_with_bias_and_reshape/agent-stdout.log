{"type":"item.started","item":{"id":"item_7","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch, time\n\ntorch.manual_seed(1)\nfor M in (131, 1024, 8192):\n    x=torch.randn((M,640),device='cuda',dtype=torch.bfloat16)\n    ws=[torch.randn((n,640),device='cuda',dtype=torch.bfloat16) for n in (1024,256,256)]\n    bs=[torch.randn((n,),device='cuda',dtype=torch.bfloat16) for n in (1024,256,256)]\n    ref=[x@w.t()+b for w,b in zip(ws,bs)]\n    alt=[torch.addmm(b,x,w.t()) for w,b in zip(ws,bs)]\n    torch.cuda.synchronize()\n    for j,(a,r) in enumerate(zip(alt,ref)):\n        d=(a.float()-r.float()).abs()\n        ok=torch.isclose(a.float(),r.float(),atol=.01116,rtol=.0078125)\n        print('M',M,'out',j,'max',d.max().item(),'ratio',ok.float().mean().item(),'exact',(d==0).float().mean().item())\n    def bench(fn):\n        for _ in range(20): fn()\n        torch.cuda.synchronize()\n        s=torch.cuda.Event(enable_timing=True); e=torch.cuda.Event(enable_timing=True)\n        s.record()\n        for _ in range(200): fn()\n        e.record(); e.synchronize()\n        return s.elapsed_time(e)/200\n    print('times',bench(lambda:[x@w.t()+b for w,b in zip(ws,bs)]),bench(lambda:[torch.addmm(b,x,w.t()) for w,b in zip(ws,bs)]))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
