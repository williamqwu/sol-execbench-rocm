{"type":"item.started","item":{"id":"item_21","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch\nimport triton\nimport reference\nfrom kernel import _post_norm_residual_kernel as base, _post_norm_residual_dot_kernel as dot\nfor rows in (128, 512, 2048, 8192, 16384):\n    x = torch.randn((rows, 4096), device='cuda', dtype=torch.bfloat16)\n    r = torch.randn_like(x)\n    w = torch.randn((4096,), device='cuda', dtype=torch.bfloat16)\n    y0 = torch.empty_like(x); y1 = torch.empty_like(x)\n    def call0(): base[(rows,)](x,r,w,y0,1e-6,BLOCK_SIZE=4096,num_warps=8)\n    def call1(): dot[(rows,)](x,r,w,y1,1e-6,BLOCK_SIZE=4096,num_warps=8)\n    try:\n        t0 = triton.testing.do_bench(call0, warmup=20, rep=100)\n        t1 = triton.testing.do_bench(call1, warmup=20, rep=100)\n        if rows == 128:\n            call1(); ref = reference.run(x,r,w,1e-6); torch.cuda.synchronize()\n            d=(y1.float()-ref.float()).abs()\n            accuracy=f'max={d.max().item():.5f} exact={(y1==ref).float().mean().item():.5f}'\n        else: accuracy=''\n        print(rows, f'base={t0:.5f} dot={t1:.5f}', accuracy)\n    except Exception as e:\n        print(rows, type(e).__name__, e)\n        break\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
