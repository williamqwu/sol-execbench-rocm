{"type":"item.started","item":{"id":"item_45","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch,gc\nfrom trial import hybrid\nD='cuda';E=256\nfor nt in [2048,2560,4096,6144]:\n A=nt*8\n ids=torch.randint(E,(A,),device=D);counts=torch.bincount(ids,minlength=E);off=counts.cumsum(0,dtype=torch.int32)\n # sorted values can be arbitrary for timing\n for trans,K,N in [(True,4096,2048),(False,2048,4096)]:\n  a=torch.zeros(A,K,device=D);w=torch.zeros((E,N,K) if trans else (E,K,N),device=D)\n  wt=w.transpose(1,2) if trans else w\n  def base():return torch._grouped_mm(a,wt,off)\n  def hyb():return hybrid(a,w,counts,off,trans)\n  def bench(f,n=3):\n   for _ in range(1):y=f()\n   torch.cuda.synchronize();s=torch.cuda.Event(True);e=torch.cuda.Event(True);s.record()\n   for _ in range(n):y=f()\n   e.record();e.synchronize();return s.elapsed_time(e)/n\n  tb=bench(base);th=bench(hyb)\n  print(nt,'T' if trans else 'N','minmax',counts.min().item(),counts.max().item(),'base',tb,'hyb',th,flush=True)\n  del a,w;gc.collect();torch.cuda.empty_cache()\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
