{"type":"item.started","item":{"id":"item_41","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch\nD='cuda'\ndef test(K,N,cap,lo,hi):\n cs=list(range(lo,hi+1));G=len(cs);w=torch.randn(G,N,K,device=D)*.02;x=torch.zeros(G,cap,K,device=D);refs=[]\n for g,c in enumerate(cs):x[g,:c]=torch.randn(c,K,device=D);refs.append(torch.nn.functional.linear(x[g,:c],w[g]))\n y=torch.bmm(x,w.transpose(1,2));torch.cuda.synchronize();good=[]\n for g,c in enumerate(cs):\n  if torch.equal(y[g,:c],refs[g]):good.append(c)\n # compress ranges\n ranges=[]\n for c in good:\n  if not ranges or c>ranges[-1][-1]+1:ranges.append([c,c])\n  else:ranges[-1][-1]=c\n print(K,N,'cap',cap,'good',ranges)\nfor cap in [96,128,160,192,224,256]:\n test(4096,2048,cap,max(32,cap-80),cap)\nfor cap in [96,128,160,192,224,256]:\n test(2048,4096,cap,max(32,cap-80),cap)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
