{"type":"item.started","item":{"id":"item_40","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch,gc\nD='cuda';K=4096;N=2048\nallc=[32,40,48,52,56,60,63,64,65,66,68,70,72,76,80,88,96,104,112,120,128,144,160,176,192,208,224,240,256]\nfor cap in [64,80,96,112,128,144,160,192,224,256]:\n cs=[c for c in allc if c<=cap][-16:];G=len(cs)\n w=torch.randn(G,N,K,device=D)*.02;x=torch.zeros(G,cap,K,device=D);refs=[]\n for g,c in enumerate(cs):\n  x[g,:c]=torch.randn(c,K,device=D);refs.append(torch.nn.functional.linear(x[g,:c],w[g]))\n y=torch.bmm(x,w.transpose(1,2));torch.cuda.synchronize()\n marks=[]\n for g,c in enumerate(cs):\n  marks.append(f'{c}:{int(torch.equal(y[g,:c],refs[g]))}')\n print('cap',cap,' '.join(marks),flush=True)\n del w,x,y,refs;gc.collect();torch.cuda.empty_cache()\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
