{"type":"item.started","item":{"id":"item_25","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch\nimport torch.nn.functional as F\n\ntorch.manual_seed(123)\nb,s,h=1,256,2048\nB=torch.randn((b,h,s),device='cuda',dtype=torch.bfloat16)*20\nX=torch.randn((b,h,s),device='cuda',dtype=torch.bfloat16)*20\ncw=torch.randn((h,1,4),device='cuda',dtype=torch.bfloat16)\ncb=torch.randn((h,),device='cuda',dtype=torch.bfloat16)\nbx=B*X\npad=F.pad(bx,(3,0)); ref=F.conv1d(pad,cw,cb,groups=h)\nfor prod_round in (False,True):\n for accum_round in (False,True):\n  for order_name,order in [('f',range(4)),('r',range(3,-1,-1))]:\n   acc=cb[None,:,None].expand_as(ref).clone() if accum_round else cb[None,:,None].float().expand(b,h,s).clone()\n   for k in order:\n    term=pad[:,:,k:k+s]*cw[:,0,k][None,:,None] if prod_round else pad[:,:,k:k+s].float()*cw[:,0,k][None,:,None].float()\n    acc=acc+term\n    if accum_round: acc=acc.bfloat16()\n   got=acc.bfloat16()\n   diff=(got\"'!=ref)\n   print(prod_round,accum_round,order_name,diff.float().mean().item(),(got.float()-ref.float()).abs().max().item())\nPY'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
