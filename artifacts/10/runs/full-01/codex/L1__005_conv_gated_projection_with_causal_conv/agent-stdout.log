{"type":"item.started","item":{"id":"item_15","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch, triton\nimport kernel\nm,h,s=8192,2048,8192\nbcx=torch.randn((m,3*h),device='cuda',dtype=torch.bfloat16)\ncw=torch.randn((h,1,4),device='cuda',dtype=torch.bfloat16)\ncb=torch.randn((h,),device='cuda',dtype=torch.bfloat16)\ny=torch.empty((m,h),device='cuda',dtype=torch.bfloat16)\nbx=torch.empty_like(y)\n\ndef bench(fn):\n    return triton.testing.do_bench(fn, warmup=10, rep=30)\nprint('single')\nfor bm,bh,nw in [(1,256,4),(2,256,4),(4,256,4),(4,128,4),(8,64,4),(8,128,4),(8,256,8),(16,64,4),(16,128,8),(32,64,8)]:\n    fn=lambda bm=bm,bh=bh,nw=nw: kernel._causal_gate_kernel[(triton.cdiv(m,bm),triton.cdiv(h,bh))](bcx,cw,cb,y,M=m,S=s,H=h,BLOCK_M=bm,BLOCK_H=bh,num_warps=nw)\n    print((bm,bh,nw),bench(fn))\nprint('split bx')\nfor block,nw in [(256,4),(512,4),(512,8),(1024,4),(1024,8)]:\n    fn=lambda block=block,nw=nw: kernel._bx_kernel[(triton.cdiv(m*h,block),)](bcx,bx,N=m*h,H=h,BLOCK=block,num_warps=nw)\n    print((block,nw),bench(fn))\nprint('split conv')\nfor bm,bh,nw in [(1,256,4),(2,256,4),(4,256,4),(4,128,4),(8,64,4),(8,128,4),(8,256,8),(16,64,4),(16,128,8),(32,64,8)]:\n    fn=lambda bm=bm,bh=bh,nw=nw: kernel._conv_gate_kernel[(triton.cdiv(m,bm),triton.cdiv(h,bh))](bcx,bx,cw,cb,y,M=m,S=s,H=h,BLOCK_M=bm,BLOCK_H=bh,num_warps=nw)\n    print((bm,bh,nw),bench(fn))\nprint('gather')\nfor bm,bh,sm,nw in [(4,64,8,4),(4,128,8,4),(4,256,8,4),(8,64,16,4),(8,128,16,4),(8,256,16,8),(16,64,32,4),(16,128,32,8)]:\n    try:\n      fn=lambda bm=bm,bh=bh,sm=sm,nw=nw: kernel._causal_gate_gather_kernel[(triton.cdiv(m,bm),triton.cdiv(h,bh))](bcx,cw,cb,y,M=m,S=s,H=h,BLOCK_M=bm,BLOCK_H=bh,SOURCE_M=sm,num_warps=nw)\n      print((bm,bh,sm,nw),bench(fn))\n    except Exception as e:\n      print((bm,bh,sm,nw),'ERR',type(e).__name__,str(e).splitlines()[-1])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
