{"type":"item.started","item":{"id":"item_10","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch, triton\nimport kernel\n\ntorch.manual_seed(1)\nfor m in (256, 2048, 8192):\n    h=2048\n    x=torch.randn((m,h),device='cuda',dtype=torch.bfloat16)\n    wi=torch.randn((3*h,h),device='cuda',dtype=torch.bfloat16)\n    bi=torch.randn((3*h,),device='cuda',dtype=torch.bfloat16)\n    wo=torch.randn((h,h),device='cuda',dtype=torch.bfloat16)\n    bo=torch.randn((h,),device='cuda',dtype=torch.bfloat16)\n    bcx=torch.empty((m,3*h),device='cuda',dtype=torch.bfloat16)\n    y=torch.empty((m,h),device='cuda',dtype=torch.bfloat16)\n    cw=torch.randn((h,1,4),device='cuda',dtype=torch.bfloat16)\n    cb=torch.randn((h,),device='cuda',dtype=torch.bfloat16)\n    def first(): torch.nn.functional.linear(x,wi,bi)\n    def middle(): kernel._causal_gate_kernel[(triton.cdiv(m,8),triton.cdiv(h,128))](bcx,cw,cb,y,M=m,S=m,H=h,BLOCK_M=8,BLOCK_H=128,num_warps=4)\n    def last(): torch.nn.functional.linear(y,wo,bo)\n    print(m, 'first', triton.testing.do_bench(first), 'middle',triton.testing.do_bench(middle),'last',triton.testing.do_bench(last))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
