r 10 seeds x 1.25 margin, floored at torch.bfloat16 epsilon\"}}\n{\"uuid\": \"3ac091d6-0457-5f48-83d0-c0d786e35551\", \"axes\": {\"batch_size\": 4, \"seq_len\": 512}, \"inputs\": {\"x\": {\"type\": \"random\"}, \"in_proj_weight\": {\"type\": \"random\"}, \"in_proj_bias\": {\"type\": \"random\"}, \"conv_weight\": {\"type\": \"random\"}, \"conv_bias\": {\"type\": \"random\"}, \"out_proj_weight\": {\"type\": \"random\"}, \"out_proj_bias\": {\"type\": \"random\"}}, \"tolerance\": {\"max_atol\": 0.02583570316516786, \"max_rtol\": 0.0078125, \"required_matched_ratio\": 0.99, \"_provenance\": \"max run-to-run error over 10 seeds x 1.25 margin, floored at torch.bfloat16 epsilon\"}}\n{\"uuid\": \"dcc98535-84bd-59c0-8809-bdc3e54137fd\", \"axes\": {\"batch_size\": 2, \"seq_len\": 128}, \"inputs\": {\"x\": {\"type\": \"random\"}, \"in_proj_weight\": {\"type\": \"random\"}, \"in_proj_bias\": {\"type\": \"random\"}, \"conv_weight\": {\"type\": \"random\"}, \"conv_bias\": {\"type\": \"random\"}, \"out_proj_weight\": {\"type\": \"random\"}, \"out_proj_bias\": {\"type\": \"random\"}}, \"tolerance\": {\"max_atol\": 0.026281461965357366, \"max_rtol\": 0.0078125, \"required_matched_ratio\": 0.99, \"_provenance\": \"max run-to-run error over 10 seeds x 1.25 margin, floored at torch.bfloat16 epsilon\"}}\n{\"uuid\": \"d9432839-c38b-58d3-95ae-e3a9e8c36fb4\", \"axes\": {\"batch_size\": 8, \"seq_len\": 997}, \"inputs\": {\"x\": {\"type\": \"random\"}, \"in_proj_weight\": {\"type\": \"random\"}, \"in_proj_bias\": {\"type\": \"random\"}, \"conv_weight\": {\"type\": \"random\"}, \"conv_bias\": {\"type\": \"random\"}, \"out_proj_weight\": {\"type\": \"random\"}, \"out_proj_bias\": {\"type\": \"random\"}}, \"tolerance\": {\"max_atol\": 0.02559975034279008, \"max_rtol\": 0.0078125, \"required_matched_ratio\": 0.99, \"_provenance\": \"max run-to-run error over 10 seeds x 1.25 margin, floored at torch.bfloat16 epsilon\"}}\n{\"uuid\": \"01719394-09fb-5ec2-a70f-282a9c8120e8\", \"axes\": {\"batch_size\