{"type":"item.started","item":{"id":"item_29","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch,triton,kernel\nT=8192;H=2304;d='cuda';G=torch.empty((3,T,H),device=d,dtype=torch.bfloat16);X=torch.empty_like(G);A=torch.empty((T,H),device=d,dtype=torch.bfloat16);PW=torch.empty((9,3),device=d,dtype=torch.bfloat16);CW=torch.empty((3,3),device=d,dtype=torch.bfloat16);RW=torch.empty((3,H),device=d,dtype=torch.bfloat16);NW=torch.empty(H,device=d,dtype=torch.bfloat16);GH=torch.empty_like(G);GA=torch.empty_like(A);S=torch.empty((T,26),device=d)\nkernel._token_kernel[(T,)](G,X,A,PW,CW,RW,NW,GH,GA,S,T,1e-6,BLOCK_H=4096,num_warps=2,waves_per_eu=1)\ntests=[(64,64,2),(64,64,4),(64,64,8),(128,32,2),(128,32,4),(128,64,4),(128,64,8),(64,128,4),(32,128,4),(256,16,4),(256,32,4),(256,32,8)]\nfor BT,BH,nw in tests:\n try:\n  nb=triton.cdiv(T,BT);P=torch.empty((nb,4,H),device=d)\n  grid=(nb,triton.cdiv(H,BH))\n  for _ in range(3):kernel._parameter_partials[grid](X,A,RW,NW,S,P,T,BT=BT,BH=BH,num_warps=nw,waves_per_eu=1)\n  torch.cuda.synchronize();st=torch.cuda.Event(True);en=torch.cuda.Event(True);st.record()\n  for _ in range(20):kernel._parameter_partials[grid](X,A,RW,NW,S,P,T,BT=BT,BH=BH,num_warps=nw,waves_per_eu=1)\n  en.record();en.synchronize();print(BT,BH,nw,st.elapsed_time(en)/20)\n except Exception as e:print('ERR',BT,BH,nw,type(e).__name__,str(e)[:100])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
