{"type":"item.started","item":{"id":"item_52","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch,kernel,reference\n# correctness and routed-value proxy through output errors\nT=256;H=2304;d='cuda';torch.manual_seed(444)\nargs=[torch.randn((3,1,T,H),device=d,dtype=torch.bfloat16),torch.randn((3,1,T,H),device=d,dtype=torch.bfloat16),torch.randn((1,T,H),device=d,dtype=torch.bfloat16),torch.randn((9,3),device=d,dtype=torch.bfloat16),torch.randn((3,3),device=d,dtype=torch.bfloat16),torch.randn((3,H),device=d,dtype=torch.bfloat16),torch.randn(H,device=d,dtype=torch.bfloat16),0,1e-6]\nr=reference.run(*args);k=kernel.run(*args);torch.cuda.synchronize()\nfor i,(a,b) in enumerate(zip(r,k)):\n e=(a.float()-b.float()).abs();tol=.01035+.0078125*a.float().abs();print(i,e.max().item(),(e<=tol).float().mean().item(),(e/tol).max().item())\n# dominant stage timing\nT=8192;G=torch.empty((3,T,H),device=d,dtype=torch.bfloat16);X=torch.empty_like(G);A=torch.empty((T,H),device=d,dtype=torch.bfloat16);PW=torch.empty((9,3),device=d,dtype=torch.bfloat16);CW=torch.empty((3,3),device=d,dtype=torch.bfloat16);RW=torch.empty((3,H),device=d,dtype=torch.bfloat16);NW=torch.empty(H,device=d,dtype=torch.bfloat16);GH=torch.empty_like(G);GA=torch.empty_like(A);S=torch.empty((T,26),device=d);ka=(G,X,A,PW,CW,RW,NW,GH,GA,S,T,1e-6)\nfor _ in range(5):kernel._token_kernel[(T,)](*ka,BLOCK_H=4096,TAIL_H=1,num_warps=2,waves_per_eu=1)\ntorch.cuda.synchronize();st=torch.cuda.Event(True);en=torch.cuda.Event(True);st.record()\nfor _ in range(50):kernel._token_kernel[(T,)](*ka,BLOCK_H=4096,TAIL_H=1,num_warps=2,waves_per_eu=1)\nen.record();en.synchronize();print('token_ms',st.elapsed_time(en)/50)\nfor dc in kernel._token_kernel.device_caches.values():\n for obj in dc[0].values(): print('regs',obj.n_regs,'spills',obj.n_spills)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
