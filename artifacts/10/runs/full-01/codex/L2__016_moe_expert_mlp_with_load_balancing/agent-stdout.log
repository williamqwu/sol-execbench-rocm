{"type":"item.started","item":{"id":"item_62","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch\nfor M in [512,1571,8192]:\n E,T,B=64,8,32;d='cuda';ids=((torch.arange(M,device=d,dtype=torch.int32)[:,None]+torch.arange(T,device=d,dtype=torch.int32)[None,:])%E).contiguous();weights=torch.rand(M,T,device=d);flat=ids.reshape(-1);R=flat.numel();counts=torch.bincount(flat.to(torch.int64),minlength=E);pcounts=((counts+B-1)//B)*B;uoff=torch.cat((counts.new_zeros(1),counts.cumsum(0)));poff=torch.cat((pcounts.new_zeros(1),pcounts.cumsum(0)));order=torch.argsort(flat);es=flat[order].long();local=torch.arange(R,device=d)-uoff[es];target=poff[es]+local;cap=R+E*B;sentinel=(T<<24)|M;sid=torch.full((cap,),sentinel,device=d,dtype=torch.int32);sw=torch.zeros(cap,device=d);enc=(order.remainder(T).to(torch.int32)<<24)|order.div(T,rounding_mode='floor').to(torch.int32);sid[target]=enc;sw[target]=weights.reshape(-1)[order];starts=torch.arange((cap+B-1)//B,device=d,dtype=torch.int64)*B;se=torch.searchsorted(poff[1:],starts,right=True).to(torch.int32);nv=poff[-1:].to(torch.int32);torch.cuda.synchronize();n=int(nv.cpu());valid=sid[:n];real=((valid>>24)<T);print(M,'R',R,'nv',n,'real',int(real.sum().cpu()),'unique enc',int(valid[real].unique().numel()),'expert blocks valid',int((se[:n//B]<E).sum().cpu()),'max target',int(target.max().cpu()))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
