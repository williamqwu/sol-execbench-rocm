{"type":"item.started","item":{"id":"item_86","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch,time,reference\nM,E,T,K,N=512,64,8,4096,2560;d='cuda';torch.manual_seed(123)\nx=torch.randn(1,M,K,device=d,dtype=torch.bfloat16);gw=torch.randn(E,K,device=d,dtype=torch.bfloat16);g=torch.randn(E,N,K,device=d,dtype=torch.bfloat16);u=torch.randn(E,N,K,device=d,dtype=torch.bfloat16);down=torch.randn(E,K,N,device=d,dtype=torch.bfloat16);torch.cuda.synchronize()\nref=reference.run(x,gw,g,u,down);torch.cuda.synchronize();\ndef batched():\n xf=x.reshape(M,K);logits=torch.nn.functional.linear(xf,gw);r=torch.softmax(logits.float(),1,dtype=torch.float32);r,sel=torch.topk(r,T,dim=-1);r=(r/r.sum(1,keepdim=True)).to(torch.bfloat16)\n flat=sel.flatten();order=torch.argsort(flat);es=flat[order];counts=torch.bincount(flat,minlength=E);offs=torch.cat((counts.new_zeros(1),counts.cumsum(0)));local=torch.arange(M*T,device=d)-offs[es];tok=order.div(T,rounding_mode='floor');maxc=int(counts.max().cpu());cur=torch.zeros(E,maxc,K,device=d,dtype=torch.bfloat16);cur[es,local]=xf[tok]\n ga=torch.bmm(cur,g.transpose(1,2));up=torch.bmm(cur,u.transpose(1,2));inter=(ga/(1+torch.exp(-ga.float())).to(torch.bfloat16))*up;y=torch.bmm(inter,down.transpose(1,2));out=torch.zeros(M,K,device=d,dtype=torch.bfloat16);oc=offs.cpu().tolist()\n for e in range(E):\n  a,b=oc[e],oc[e+1];rr=order[a:b];ti=rr.div(T,rounding_mode='floor');sl=rr.remainder(T);out.index_add_(0,ti,y[e,:b-a]*r[ti,sl,None])\n return out.reshape(1,M,K),logits\nt=time.time();out=batched();torch.cuda.synchronize();print('sec',time.time()-t)\nfor i,(a,b) in enumerate(zip(out,ref)):\n df=(a.float()-b.float()).abs();cl=torch.isclose(a,b,atol=.002073651,rtol=.0078125);print(i,'max',df.max().item(),'mean',df.mean().item(),'ratio',cl.float().mean().item(),'bad',(~cl).sum().item())\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
