{"type":"item.started","item":{"id":"item_33","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch,aiter\nM,E,T,B,K,N=16,4,2,32,256,64;d='cuda';torch.manual_seed(1)\nx=torch.randn(M,K,device=d,dtype=torch.bfloat16)*.1;g=torch.randn(E,N,K,device=d,dtype=torch.bfloat16)*.1;u=torch.randn(E,N,K,device=d,dtype=torch.bfloat16)*.1;down=torch.randn(E,K,N,device=d,dtype=torch.bfloat16)*.1\nids=torch.stack([torch.arange(M,device=d,dtype=torch.int32)%E,(torch.arange(M,device=d,dtype=torch.int32)+1)%E],1);ws=torch.ones(M,T,device=d);mp=M*T+E*B;sid=torch.empty(mp,device=d,dtype=torch.int32);sw=torch.empty(mp,device=d);se=torch.empty(mp//B,device=d,dtype=torch.int32);nv=torch.empty(1,device=d,dtype=torch.int32);buf=torch.empty(E,M,device=d,dtype=torch.int32);aiter.moe_sorting_fwd(ids,ws,sid,sw,se,nv,buf,E,B)\nref=torch.empty((M,T,N),device=d,dtype=torch.bfloat16)\nfor m in range(M):\n for t in range(T):\n  e=int(ids[m,t]);ga=torch.nn.functional.linear(x[m],g[e]);up=torch.nn.functional.linear(x[m],u[e]);ref[m,t]=(ga/(1+torch.exp(-ga.float())).to(torch.bfloat16))*up\nrow=torch.cat([g,u],1);NN=2*N;packed=row.reshape(E,NN//16,16,K//16,16).permute(0,1,4,3,2).contiguous().reshape(E,NN,K)\nfor shuf in [False,True]:\n out=torch.empty_like(ref);aiter.ck_moe_stage1(x,packed,down,sid,se,nv,out,T,kernelName='',block_m=B,activation=0,is_shuffled=shuf);torch.cuda.synchronize();df=(out.float()-ref.float()).abs();print('shuf',shuf,'max',df.max().item(),'mean',df.mean().item(),'ratio',torch.isclose(out,ref,atol=.001,rtol=.01).float().mean().item(),out[0,0,:4].cpu().tolist())\nprint('ref',ref[0,0,:4].cpu().tolist())\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
