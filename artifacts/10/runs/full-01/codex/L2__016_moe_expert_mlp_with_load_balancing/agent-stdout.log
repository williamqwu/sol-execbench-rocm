{"type":"item.completed","item":{"id":"item_80","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,280p' kernel.py\"","aggregated_output":"import torch\nimport torch.nn.functional as F\nimport aiter\n\n\n_NUM_EXPERTS = 64\n_TOP_K = 8\n_BLOCK_M = 32\n\n\ndef _pack_ck_b(weight: torch.Tensor) -> torch.Tensor:\n    \"\"\"Pack a row-major bf16 B matrix into CK's gfx950 MFMA layout.\"\"\"\n    experts, out_dim, in_dim = weight.shape\n    return (\n        weight.reshape(\n            experts,\n            out_dim // 16,\n            16,\n            16,\n            in_dim // 128,\n            8,\n        )\n        .permute(0, 1, 3, 4, 2, 5)\n        .contiguous()\n        .reshape(experts, out_dim, in_dim)\n    )\n\n\ndef _sort_routes(selected: torch.Tensor, num_tokens: int):\n    \"\"\"Group routes by expert and pad each expert to a CK M tile.\"\"\"\n    flat_experts = selected.reshape(-1)\n    num_routes = num_tokens * _TOP_K\n\n    counts = torch.bincount(flat_experts, minlength=_NUM_EXPERTS)\n    padded_counts = (\n        (counts + _BLOCK_M - 1) // _BLOCK_M\n    ) * _BLOCK_M\n    offsets = torch.cat((counts.new_zeros(1), counts.cumsum(0)))\n    padded_offsets = torch.cat(\n        (padded_counts.new_zeros(1), padded_counts.cumsum(0))\n    )\n\n    order = torch.argsort(flat_experts)\n    sorted_experts = flat_experts[order]\n    local_rank = torch.arange(\n        num_routes, device=selected.device, dtype=torch.int64\n    ) - offsets[sorted_experts]\n    destinations = padded_offsets[sorted_experts] + local_rank\n\n    max_padded = num_routes + _NUM_EXPERTS * _BLOCK_M\n    sentinel = (_TOP_K << 24) | num_tokens\n    sorted_token_ids = torch.full(\n        (max_padded,), sentinel, device=selected.device, dtype=torch.int32\n    )\n    encoded_routes = (\n        order.remainder(_TOP_K).to(torch.int32) << 24\n    ) | order.div(_TOP_K, rounding_mode=\"floor\").to(torch.int32)\n    sorted_token_ids[destinations] = encoded_routes\n\n    # Stage two uses a top-k of one and treats each original route as its own\n    # output row.  This keeps its bf16 results separate for reference-order\n    # accumulation below.\n    sorted_route_ids = torch.full(\n        (max_padded,),\n        (1 << 24) | num_routes,\n        device=selected.device,\n        dtype=torch.int32,\n    )\n    sorted_route_ids[destinations] = order.to(torch.int32)\n\n    block_starts = torch.arange(\n        (max_padded + _BLOCK_M - 1) // _BLOCK_M,\n        device=selected.device,\n        dtype=torch.int64,\n    ) * _BLOCK_M\n    sorted_expert_ids = torch.searchsorted(\n        padded_offsets[1:], block_starts, right=True\n    ).to(torch.int32)\n    num_valid_ids = padded_offsets[-1:].to(torch.int32)\n    return (\n        sorted_token_ids,\n        sorted_route_ids,\n        sorted_expert_ids,\n        num_valid_ids,\n    )\n\n\n@torch.no_grad()\ndef run(\n    hidden_states: torch.Tensor,\n    gate_weight: torch.Tensor,\n    expert_gate_proj_weights: torch.Tensor,\n    expert_up_proj_weights: torch.Tensor,\n    expert_down_proj_weights: torch.Tensor,\n):\n    batch_size, sequence_length, hidden_dim = hidden_states.shape\n    num_tokens = batch_size * sequence_length\n    hidden_states_flat = hidden_states.reshape(num_tokens, hidden_dim)\n\n    # Keep routing identical to the reference, including its fp32 softmax and\n    # the bf16 rounding point after top-k renormalization.\n    router_logits = F.linear(hidden_states_flat, gate_weight)\n    routing = F.softmax(router_logits.float(), dim=1, dtype=torch.float32)\n    routing, selected = torch.topk(routing, _TOP_K, dim=-1)\n    routing = routing / routing.sum(dim=-1, keepdim=True)\n    routing = routing.to(torch.bfloat16).float()\n    (\n        sorted_token_ids,\n        sorted_route_ids,\n        sorted_expert_ids,\n        num_valid_ids,\n    ) = _sort_routes(\n        selected,\n        num_tokens,\n    )\n\n    # CK consumes the two SwiGLU projections as the two halves of one matrix.\n    # Pack both GEMM weights into its native 16x256 bf16 MFMA tile layout.\n    gate_up = _pack_ck_b(\n        torch.cat((expert_gate_proj_weights, expert_up_proj_weights), dim=1)\n    )\n    down = _pack_ck_b(expert_down_proj_weights)\n\n    intermediate = torch.empty(\n        (num_tokens, _TOP_K, 2560),\n        device=hidden_states.device,\n        dtype=torch.bfloat16,\n    )\n    aiter.ck_moe_stage1(\n        hidden_states_flat,\n        gate_up,\n        down,\n        sorted_token_ids,\n        sorted_expert_ids,\n        num_valid_ids,\n        intermediate,\n        _TOP_K,\n        kernelName=\"\",\n        block_m=_BLOCK_M,\n        activation=0,\n        is_shuffled=False,\n    )\n\n    num_routes = num_tokens * _TOP_K\n    route_hidden_states = torch.zeros(\n        (num_routes, hidden_dim),\n        device=hidden_states.device,\n        dtype=torch.bfloat16,\n    )\n    aiter.ck_moe_stage2(\n        intermediate.reshape(num_routes, 1, 2560),\n        gate_up,\n        down,\n        sorted_route_ids,\n        sorted_expert_ids,\n        num_valid_ids,\n        route_hidden_states,\n        1,\n        kernelName=\"\",\n        block_m=_BLOCK_M,\n        sorted_weights=None,\n        activation=0,\n        is_shuffled=False,\n    )\n\n    # Match the reference's observable bf16 accumulation order: experts are\n    # visited from 0 through 63, with a rounding after weighting and after\n    # every index_add_.\n    final_hidden_states = torch.zeros(\n        (num_tokens, hidden_dim),\n        device=hidden_states.device,\n        dtype=torch.bfloat16,\n    )\n    route_hidden_states = route_hidden_states.reshape(\n        num_tokens, _TOP_K, hidden_dim\n    )\n    routing_bf16 = routing.to(torch.bfloat16)\n    for expert_idx in range(_NUM_EXPERTS):\n        topk_slot, token_idx = torch.where(\n            (selected == expert_idx).transpose(0, 1)\n        )\n        weighted = route_hidden_states[token_idx, topk_slot] * routing_bf16[\n            token_idx, topk_slot, None\n        ]\n        final_hidden_states.index_add_(0, token_idx, weighted)\n\n    return (\n        final_hidden_states.reshape(batch_size, sequence_length, hidden_dim),\n        router_logits,\n    )\n","exit_code":0,"status":"completed"}}
