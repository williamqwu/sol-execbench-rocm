{"type":"item.completed","item":{"id":"item_50","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,360p' kernel.py && sed -n '1,160p' solution.json\"","aggregated_output":"import torch\nimport triton\nimport triton.language as tl\n\n\n_INNER_DIM = 2432\n\n\n@triton.jit\ndef _linear_ieee(\n    temb_ptr,\n    weight_ptr,\n    bias_ptr,\n    modulation_ptr,\n    batch,\n    BM: tl.constexpr,\n    BN: tl.constexpr,\n    BK: tl.constexpr,\n):\n    pid = tl.program_id(0)\n    ms = tl.arange(0, BM)\n    ns = pid * BN + tl.arange(0, BN)\n    acc = tl.zeros((BM, BN), dtype=tl.float32)\n    for k0 in range(0, 2432, BK):\n        ks = k0 + tl.arange(0, BK)\n        a = tl.load(\n            temb_ptr + ms[:, None] * 2432 + ks[None, :],\n            mask=(ms[:, None] < batch) & (ks[None, :] < 2432),\n            other=0.0,\n        )\n        w = tl.load(\n            weight_ptr + ns[None, :] * 2432 + ks[:, None],\n            mask=(ks[:, None] < 2432) & (ns[None, :] < 4864),\n            other=0.0,\n        )\n        acc += tl.dot(a, w, input_precision=\"ieee\")\n    acc += tl.load(bias_ptr + ns, mask=ns < 4864, other=0.0)[None, :]\n    tl.store(\n        modulation_ptr + ms[:, None] * 4864 + ns[None, :],\n        acc,\n        mask=(ms[:, None] < batch) & (ns[None, :] < 4864),\n    )\n\n\n@triton.jit\ndef _layer_norm_modulate(\n    x_ptr,\n    modulation_ptr,\n    out_ptr,\n    eps,\n    n_rows: tl.constexpr,\n    n_cols: tl.constexpr,\n    BLOCK: tl.constexpr,\n):\n    row = tl.program_id(0)\n    cols = tl.arange(0, BLOCK)\n    mask = cols < n_cols\n\n    x = tl.load(x_ptr + row * n_cols + cols, mask=mask, other=0.0)\n    mean = tl.sum(x, axis=0) / n_cols\n    centered = tl.where(mask, x - mean, 0.0)\n    variance = tl.sum(centered * centered, axis=0) / n_cols\n    normalized = centered / tl.sqrt(variance + eps)\n\n    batch = row // n_rows\n    mod_base = batch * (2 * n_cols)\n    scale = tl.load(modulation_ptr + mod_base + cols, mask=mask)\n    shift = tl.load(modulation_ptr + mod_base + n_cols + cols, mask=mask)\n    result = normalized * (1.0 + scale) + shift\n    tl.store(out_ptr + row * n_cols + cols, result, mask=mask)\n\n\n@triton.jit\ndef _layer_norm_modulate_2d(\n    x_ptr,\n    modulation_ptr,\n    out_ptr,\n    eps,\n    seq_len: tl.constexpr,\n    n_cols: tl.constexpr,\n    BLOCK: tl.constexpr,\n):\n    seq = tl.program_id(0)\n    batch = tl.program_id(1)\n    row = batch * seq_len + seq\n    cols = tl.arange(0, BLOCK)\n    mask = cols < n_cols\n    x = tl.load(x_ptr + row * n_cols + cols, mask=mask, other=0.0)\n    mean = tl.sum(x, axis=0) / n_cols\n    centered = tl.where(mask, x - mean, 0.0)\n    variance = tl.sum(centered * centered, axis=0) / n_cols\n    normalized = centered / tl.sqrt(variance + eps)\n    mod_base = batch * (2 * n_cols)\n    scale = tl.load(modulation_ptr + mod_base + cols, mask=mask)\n    shift = tl.load(modulation_ptr + mod_base + n_cols + cols, mask=mask)\n    result = normalized * (1.0 + scale) + shift\n    tl.store(out_ptr + row * n_cols + cols, result, mask=mask)\n\n\n@triton.jit\ndef _layer_norm_modulate_transposed(\n    x_ptr,\n    modulation_t_ptr,\n    bias_ptr,\n    out_ptr,\n    eps,\n    batch_size: tl.constexpr,\n    seq_len: tl.constexpr,\n    n_cols: tl.constexpr,\n    BLOCK: tl.constexpr,\n):\n    row = tl.program_id(0)\n    cols = tl.arange(0, BLOCK)\n    mask = cols < n_cols\n    x = tl.load(x_ptr + row * n_cols + cols, mask=mask, other=0.0)\n    mean = tl.sum(x, axis=0) / n_cols\n    centered = tl.where(mask, x - mean, 0.0)\n    variance = tl.sum(centered * centered, axis=0) / n_cols\n    normalized = centered / tl.sqrt(variance + eps)\n    batch = row // seq_len\n    scale = tl.load(\n        modulation_t_ptr + cols * batch_size + batch, mask=mask\n    ) + tl.load(bias_ptr + cols, mask=mask)\n    shift = tl.load(\n        modulation_t_ptr + (n_cols + cols) * batch_size + batch, mask=mask\n    ) + tl.load(bias_ptr + n_cols + cols, mask=mask)\n    result = normalized * (1.0 + scale) + shift\n    tl.store(out_ptr + row * n_cols + cols, result, mask=mask)\n\n\n@triton.jit\ndef _layer_norm_modulate_split(\n    x_ptr,\n    modulation_ptr,\n    out_ptr,\n    eps,\n    seq_len: tl.constexpr,\n):\n    row = tl.program_id(0)\n    cols = tl.arange(0, 2048)\n    tail_mask = cols < 384\n    base = row * 2432\n\n    x0 = tl.load(x_ptr + base + cols)\n    x1 = tl.load(x_ptr + base + 2048 + cols, mask=tail_mask, other=0.0)\n    mean = tl.sum(x0 + x1, axis=0) / 2432.0\n    centered0 = x0 - mean\n    centered1 = tl.where(tail_mask, x1 - mean, 0.0)\n    variance = tl.sum(\n        centered0 * centered0 + centered1 * centered1, axis=0\n    ) / 2432.0\n    denom = tl.sqrt(variance + eps)\n\n    batch = row // seq_len\n    mod_base = batch * 4864\n    scale0 = tl.load(modulation_ptr + mod_base + cols)\n    shift0 = tl.load(modulation_ptr + mod_base + 2432 + cols)\n    scale1 = tl.load(\n        modulation_ptr + mod_base + 2048 + cols, mask=tail_mask\n    )\n    shift1 = tl.load(\n        modulation_ptr + mod_base + 4480 + cols, mask=tail_mask\n    )\n    out0 = (centered0 / denom) * (1.0 + scale0) + shift0\n    out1 = (centered1 / denom) * (1.0 + scale1) + shift1\n    tl.store(out_ptr + base + cols, out0)\n    tl.store(out_ptr + base + 2048 + cols, out1, mask=tail_mask)\n\n\n@triton.jit\ndef _layer_norm_modulate_grouped(\n    x_ptr,\n    modulation_ptr,\n    out_ptr,\n    eps,\n    seq_len: tl.constexpr,\n    n_cols: tl.constexpr,\n    ROWS: tl.constexpr,\n    BLOCK: tl.constexpr,\n):\n    seq_block = tl.program_id(0)\n    batch = tl.program_id(1)\n    rows = seq_block * ROWS + tl.arange(0, ROWS)\n    cols = tl.arange(0, BLOCK)\n    row_mask = rows < seq_len\n    col_mask = cols < n_cols\n    mask = row_mask[:, None] & col_mask[None, :]\n    offsets = (batch * seq_len + rows[:, None]) * n_cols + cols[None, :]\n\n    x = tl.load(x_ptr + offsets, mask=mask, other=0.0)\n    mean = tl.sum(x, axis=1) / n_cols\n    centered = tl.where(mask, x - mean[:, None], 0.0)\n    variance = tl.sum(centered * centered, axis=1) / n_cols\n    normalized = centered / tl.sqrt(variance[:, None] + eps)\n\n    mod_base = batch * (2 * n_cols)\n    scale = tl.load(modulation_ptr + mod_base + cols, mask=col_mask)\n    shift = tl.load(modulation_ptr + mod_base + n_cols + cols, mask=col_mask)\n    result = normalized * (1.0 + scale[None, :]) + shift[None, :]\n    tl.store(out_ptr + offsets, result, mask=mask)\n\n\n@triton.jit\ndef _layer_norm_modulate_sequential(\n    x_ptr,\n    modulation_ptr,\n    out_ptr,\n    eps,\n    seq_len: tl.constexpr,\n    n_cols: tl.constexpr,\n    ROWS: tl.constexpr,\n    BLOCK: tl.constexpr,\n):\n    seq_block = tl.program_id(0)\n    batch = tl.program_id(1)\n    cols = tl.arange(0, BLOCK)\n    col_mask = cols < n_cols\n    mod_base = batch * (2 * n_cols)\n    scale = tl.load(modulation_ptr + mod_base + cols, mask=col_mask)\n    shift = tl.load(modulation_ptr + mod_base + n_cols + cols, mask=col_mask)\n    for r in tl.static_range(ROWS):\n        seq = seq_block * ROWS + r\n        row_mask = seq < seq_len\n        mask = row_mask & col_mask\n        offsets = (batch * seq_len + seq) * n_cols + cols\n        x = tl.load(x_ptr + offsets, mask=mask, other=0.0)\n        mean = tl.sum(x, axis=0) / n_cols\n        centered = tl.where(mask, x - mean, 0.0)\n        variance = tl.sum(centered * centered, axis=0) / n_cols\n        normalized = centered / tl.sqrt(variance + eps)\n        result = normalized * (1.0 + scale) + shift\n        tl.store(out_ptr + offsets, result, mask=mask)\n\n\ndef run(hidden_states, temb, linear_weight, linear_bias, eps):\n    modulation = torch.nn.functional.linear(temb, linear_weight, linear_bias)\n    output = torch.empty_like(hidden_states)\n    batch, seq_len, inner_dim = hidden_states.shape\n    assert inner_dim == _INNER_DIM\n    _layer_norm_modulate_2d[(seq_len, batch)](\n        hidden_states,\n        modulation,\n        output,\n        eps,\n        seq_len=seq_len,\n        n_cols=inner_dim,\n        BLOCK=4096,\n        num_warps=4,\n        num_stages=5,\n        waves_per_eu=8,\n    )\n    return output\n{\n  \"name\": \"080_adaptive_layernorm_continuous_with_modulation_agent\",\n  \"definition\": \"080_adaptive_layernorm_continuous_with_modulation\",\n  \"author\": \"agent\",\n  \"spec\": {\n    \"languages\": [\"triton\"],\n    \"target_hardware\": [\"MI355X\", \"LOCAL\"],\n    \"entry_point\": \"kernel.py::run\",\n    \"dependencies\": [\"torch\", \"triton\"],\n    \"destination_passing_style\": false\n  },\n  \"sources\": [\n    {\"path\": \"kernel.py\", \"content\": \"\"}\n  ]\n}\n","exit_code":0,"status":"completed"}}
