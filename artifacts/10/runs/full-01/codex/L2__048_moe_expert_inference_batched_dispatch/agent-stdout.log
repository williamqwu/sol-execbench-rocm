{"type":"item.started","item":{"id":"item_68","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch\nfrom kernel import _run_raw, run\nM,E,H,I,T=64,256,4096,1024,8\ntorch.manual_seed(4); x=torch.randn(M,H,device='cuda',dtype=torch.bfloat16); ids=torch.stack([torch.randperm(E,device='cuda')[:T] for _ in range(M)]).long(); r=torch.rand(M,T,device='cuda'); wt=(r/r.sum(1,keepdim=True)).bfloat16(); g=torch.randn(E,I,H,device='cuda',dtype=torch.bfloat16)*.02; u=torch.randn(E,I,H,device='cuda',dtype=torch.bfloat16)*.02; d=torch.randn(E,H,I,device='cuda',dtype=torch.bfloat16)*.02\nfor name,fn in [('raw',_run_raw),('ck',run)]:\n try:\n  for _ in range(2): y=fn(x,ids,wt,g,u,d)\n  torch.cuda.synchronize();ts=[]\n  for _ in range(5):\n   a=torch.cuda.Event(True);b=torch.cuda.Event(True);a.record();y=fn(x,ids,wt,g,u,d);b.record();b.synchronize();ts.append(a.elapsed_time(b))\n  print(name,sorted(ts)[2],y.float().abs().mean().item(),y.float().abs().max().item());\n  if name=='raw': yr=y.clone()\n  else: yc=y.clone()\n except Exception as e: print('ERR',name,type(e).__name__,e)\nif 'yr' in globals() and 'yc' in globals():\n diff=(yr.float()-yc.float()).abs(); allow=.0020755+.0078125*yc.float().abs(); print('diff',diff.max().item(),diff.mean().item(),(diff<=allow).float().mean().item())\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
