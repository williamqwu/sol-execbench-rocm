{"type":"item.completed","item":{"id":"item_39","type":"agent_message","text":"All 16 workloads pass at about 7.6 ms. Profiling shows performance is almost flat with token count, confirming that rearranging 6 GiB of weights—not the MoE math—is now the bottleneck. I’m replacing the separate concatenate-plus-two-permute sequence with one direct GPU packing pass that reads the supplied gate/up/down tensors once and writes the exact CK tile layout."}}
{"type":"item.started","item":{"id":"item_40","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport time, torch, triton, triton.language as tl\nfrom aiter.ops.shuffle import shuffle_weight\n\n@triton.jit\ndef pack_all(g, u, d, guo, do, BN: tl.constexpr, BK: tl.constexpr, NW: tl.constexpr):\n    pid=tl.program_id(0)\n    GU_N: tl.constexpr=2048; GU_K: tl.constexpr=4096\n    D_N: tl.constexpr=4096; D_K: tl.constexpr=1024\n    E: tl.constexpr=256; I: tl.constexpr=1024\n    GU_NT: tl.constexpr=GU_N//BN; GU_KT: tl.constexpr=GU_K//BK\n    GU_P: tl.constexpr=E*GU_NT*GU_KT\n    offs=tl.arange(0,BN*BK)\n    ni=offs//BK; ki=offs%BK\n    if pid < GU_P:\n        e=pid//(GU_NT*GU_KT); q=pid%(GU_NT*GU_KT); nt=q//GU_KT; kt=q%GU_KT\n        n=nt*BN+ni; k=kt*BK+ki\n        isup=n>=I; sn=tl.where(isup,n-I,n)\n        sp=tl.where(isup,u,g)+e*I*GU_K+sn*GU_K+k\n        x=tl.load(sp)\n        nb=n//16; nl=n%16; kb=k//32; kg=(k%32)//8; kl=k%8\n        oo=(((((e*(GU_N//16)+nb)*(GU_K//32)+kb)*4+kg)*16+nl)*8+kl)\n        tl.store(guo+oo,x)\n    else:\n        p=pid-GU_P\n        D_NT: tl.constexpr=D_N//BN; D_KT: tl.constexpr=D_K//BK\n        e=p//(D_NT*D_KT); q=p%(D_NT*D_KT); nt=q//D_KT; kt=q%D_KT\n        n=nt*BN+ni; k=kt*BK+ki\n        x=tl.load(d+e*D_N*D_K+n*D_K+k)\n        nb=n//16; nl=n%16; kb=k//32; kg=(k%32)//8; kl=k%8\n        oo=(((((e*(D_N//16)+nb)*(D_K//32)+kb)*4+kg)*16+nl)*8+kl)\n        tl.store(do+oo,x)\n\ndef launch(g,u,d,bn,bk,nw):\n    gu=torch.empty((256,2048,4096),device='cuda',dtype=torch.bfloat16)\n    ds=torch.empty_like(d)\n    progs=256*(2048//bn)*(4096//bk)+256*(4096//bn)*(1024//bk)\n    pack_all[(progs,)](g,u,d,gu,ds,BN=bn,BK=bk,NW=nw,num_warps=nw)\n    return gu,ds\n\ndef bench(fn,n=6):\n    for _ in range(2): z=fn()\n    torch.cuda.synchronize(); ts=[]\n    for _ in range(n):\n      a=torch.cuda.Event(True); b=torch.cuda.Event(True); a.record(); z=fn(); b.record(); b.synchronize(); ts.append(a.elapsed_time(b))\n    return sorted(ts)[len(ts)//2],z\n\ndev='cuda'; E=256; I=1024; H=4096\ng=torch.empty((E,I,H),device=dev,dtype=torch.bfloat16).normal_(); u=torch.empty_like(g).normal_(); d=torch.empty((E,H,I),device=dev,dtype=torch.bfloat16).normal_()\nms,z=bench(lambda:(shuffle_weight(torch.cat((g,u),1),(16,16)),shuffle_weight(d,(16,16))),4); ref=z\nprint('stock',ms)\nfor bn,bk,nw in [(16,32,4),(32,64,4),(64,64,8),(64,128,8),(128,64,8),(128,128,8),(256,64,8)]:\n try:\n  ms,z=bench(lambda bn=bn,bk=bk,nw=nw:launch(g,u,d,bn,bk,nw),4)\n  ok1=torch.equal(z[0][::51,::127,::251],ref[0][::51,::127,::251]); ok2=torch.equal(z[1][::51,::127,::251],ref[1][::51,::127,::251])\n  print(bn,bk,nw,ms,ok1,ok2)\n  del z\n except Exception as e: print('ERR',bn,bk,nw,type(e).__name__,str(e)[:500])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
