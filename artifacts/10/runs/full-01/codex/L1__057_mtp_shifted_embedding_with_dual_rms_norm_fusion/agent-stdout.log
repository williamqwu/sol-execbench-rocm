{"type":"item.started","item":{"id":"item_63","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch,triton,aiter\naiter.hipb_create_extension();m=128;k=8192;n=4096\na=torch.randn((m,k),device='cuda',dtype=torch.bfloat16);w=torch.randn((n,k),device='cuda',dtype=torch.bfloat16)*.02\nsols=aiter.hipb_findallsols(a,w.t())\nref=torch.mm(a,w.t())\nfor sol in sols[:10]:\n try:\n  y=aiter.hipb_mm(a,w.t(),sol)\n  torch.cuda.synchronize()\n  d=(y-ref).abs(); print(sol,y.shape,d.max().item(),round(triton.testing.do_bench(lambda:aiter.hipb_mm(a,w.t(),sol),warmup=10,rep=50),4))\n except Exception as e: print(sol,'ERR',repr(e)[:150])\naiter.hipb_destroy_extension()\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
