{"type":"item.started","item":{"id":"item_69","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch,triton,aiter,kernel\naiter.hipb_create_extension();H=4096;K=8192;N=4096;MAX=8192\nids=torch.randint(0,157184,(MAX,),device='cuda',dtype=torch.int64);h=torch.empty((MAX,H),device='cuda',dtype=torch.bfloat16);e=torch.empty((157184,H),device='cuda',dtype=torch.bfloat16);ew=torch.ones(H,device='cuda',dtype=torch.bfloat16);hw=ew.clone();w=torch.empty((N,K),device='cuda',dtype=torch.bfloat16)\nsols={512:439118,1024:438976,2048:439189,8192:439365}\nfor m in sols:\n def base():\n  p=torch.empty((m,K),device='cuda',dtype=torch.bfloat16);kernel._prepare_kernel[(m,2)](ids,h,e,ew,hw,p,m,128,1e-6,H,H,num_warps=8);return torch.mm(p,w.t())\n def hipb():\n  p=torch.empty((m,K),device='cuda',dtype=torch.bfloat16);kernel._prepare_kernel[(m,2)](ids,h,e,ew,hw,p,m,128,1e-6,H,H,num_warps=8);return aiter.hipb_mm(p,w.t(),sols[m])\n print(m,'torch',[round(triton.testing.do_bench(base,warmup=20,rep=100),4) for _ in range(3)],'hipb',[round(triton.testing.do_bench(hipb,warmup=20,rep=100),4) for _ in range(3)])\naiter.hipb_destroy_extension()\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
