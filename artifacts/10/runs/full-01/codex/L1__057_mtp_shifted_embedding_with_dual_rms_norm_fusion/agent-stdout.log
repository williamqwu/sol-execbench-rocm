{"type":"item.started","item":{"id":"item_20","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch,triton,kernel\nK=8192; N=4096\nids=torch.zeros(8192,device='cuda',dtype=torch.int64)\nh=torch.empty((8192,4096),device='cuda',dtype=torch.bfloat16)\ne=torch.empty((1,4096),device='cuda',dtype=torch.bfloat16)\new=torch.ones(4096,device='cuda',dtype=torch.bfloat16); hw=ew.clone()\nw=torch.empty((N,K),device='cuda',dtype=torch.bfloat16)\ndef cur(m):\n p=torch.empty((m,K),device='cuda',dtype=torch.bfloat16)\n kernel._prepare_kernel[(m,2)](ids,h,e,ew,hw,p,m,128,1e-6,4096,4096,num_warps=8)\n return torch.mm(p,w.t())\ndef one(m):\n buf=torch.empty((m*(K+N),),device='cuda',dtype=torch.bfloat16)\n p=buf[:m*K].view(m,K); o=buf[m*K:].view(m,N)\n kernel._prepare_kernel[(m,2)](ids,h,e,ew,hw,p,m,128,1e-6,4096,4096,num_warps=8)\n torch.mm(p,w.t(),out=o)\n return o\nfor m in [128,256,512,1024,2048,4096,8192]:\n a=triton.testing.do_bench(lambda:cur(m),warmup=20,rep=100)\n b=triton.testing.do_bench(lambda:one(m),warmup=20,rep=100)\n print(m,round(a,4),round(b,4))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
