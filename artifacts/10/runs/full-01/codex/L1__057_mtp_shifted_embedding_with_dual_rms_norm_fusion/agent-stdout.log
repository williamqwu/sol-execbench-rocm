{"type":"item.started","item":{"id":"item_31","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch,triton,aiter\nN=4096;K=8192\nw=torch.empty((N,K),device='cuda',dtype=torch.bfloat16)\nfor m in [128,2048]:\n a=torch.empty((1,m,K),device='cuda',dtype=torch.bfloat16); o=torch.empty((1,m,N),device='cuda',dtype=torch.bfloat16)\n print('M',m)\n for kid in range(10):\n  vals=[]\n  for sk in ([0] if kid<4 else [1,2,4,8]):\n   try:\n    fn=lambda kid=kid,sk=sk:aiter.opus_gemm_a16w16_tune(a,w,o,kernelId=kid,splitK=sk)\n    t=triton.testing.do_bench(fn,warmup=5,rep=20)\n    vals.append((sk,round(t,4)))\n   except Exception as e: vals.append((sk,'ERR:'+str(e).splitlines()[-1][:25]))\n  print(kid,vals)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
