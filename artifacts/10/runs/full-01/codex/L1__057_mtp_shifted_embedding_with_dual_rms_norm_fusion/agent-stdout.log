{"type":"item.started","item":{"id":"item_10","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch\nimport triton\nimport kernel\n\ndev='cuda'\nids=torch.zeros((8192,),device=dev,dtype=torch.int64)\nh=torch.empty((8192,4096),device=dev,dtype=torch.bfloat16)\ne=torch.empty((1,4096),device=dev,dtype=torch.bfloat16)\new=torch.ones((4096,),device=dev,dtype=torch.bfloat16)\nhw=torch.ones((4096,),device=dev,dtype=torch.bfloat16)\np=torch.empty((8192,8192),device=dev,dtype=torch.bfloat16)\nw=torch.empty((4096,8192),device=dev,dtype=torch.bfloat16)\nfor m in [128,256,512,1024,2048,4096,8192]:\n    def prep():\n        kernel._prepare_kernel[(m,2)](ids,h,e,ew,hw,p,m,128,1e-6,4096,4096,num_warps=8)\n    def mm():\n        torch.mm(p[:m],w.t())\n    pt=triton.testing.do_bench(prep, warmup=20, rep=100)\n    mt=triton.testing.do_bench(mm, warmup=20, rep=100)\n    print(m, 'prep', round(pt,4), 'mm', round(mt,4), 'sum', round(pt+mt,4))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
