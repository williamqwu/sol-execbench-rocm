{"type":"item.started","item":{"id":"item_15","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch, math\nimport reference\n\ntorch.manual_seed(3); d='cuda'; M=7; B=1; P=7\ndef r(sh,s=1):return torch.rand(sh,device=d)*s\nargs=[r((B,P,256)),r((B,P,4,256))]\nargs += [r((1024,256)),r((1024,)),r((1024,1024)),r((1024,)),r((4,1024)),r((4,))]\nfor _ in range(4): args += [r((256,256)),r((256,)),r((256,256)),r((256,)),r((32,256)),r((32,))]\n\ndef act(x,w,b):\n    sh=x.shape\n    try:x=x.view(-1,sh[-1])\n    except:x=x.reshape(-1,sh[-1])\n    return torch.ops.aten._addmm_activation.default(b,x,w.t(),beta=1,alpha=1,use_gelu=False).view(*sh[:-1],w.shape[0])\ndef lin(x,w,b):return torch.nn.functional.linear(x,w,b)\n\ndef fused(*a):\n x=act(a[0],a[2],a[3]);x=act(x,a[4],a[5]);io=lin(x,a[6],a[7]); hs=[]\n for j in range(4):\n  k=8+6*j;x=act(a[1][:,:,j,:],a[k],a[k+1]);x=act(x,a[k+2],a[k+3]);hs.append(lin(x,a[k+4],a[k+5]))\n return io,torch.stack(hs,2)\nss=[torch.cuda.Stream() for _ in range(5)]\ndef streamed(*a):\n cur=torch.cuda.current_stream(); ys=[]\n for s in ss:s.wait_stream(cur)\n with torch.cuda.stream(ss[0]):\n  x=act(a[0],a[2],a[3]);x=act(x,a[4],a[5]);io=lin(x,a[6],a[7])\n for j in range(4):\n  with torch.cuda.stream(ss[j+1]):\n   k=8+6*j;x=act(a[1][:,:,j,:],a[k],a[k+1]);x=act(x,a[k+2],a[k+3]);ys.append(lin(x,a[k+4],a[k+5]))\n for s in ss:cur.wait_stream(s)\n return io,torch.stack(ys,2)\n\nyr=reference.run(*args); yf=fused(*args); ys_=streamed(*args);torch.cuda.synchronize()\nfor name,y in [('fused',yf),('streamed',ys_)]:print(name,[((u-v).abs().max().item(),torch.equal(u,v)) for u,v in zip(yr,y)])\ndef bench(fn,n=1000):\n for _ in range(20):fn(*args)\n torch.cuda.synchronize();s=torch.cuda.Event(True);e=torch.cuda.Event(True);s.record()\n for _ in range(n):fn(*args)\n e.record();e.synchronize();return s.elapsed_time(e)/n\nprint('ref',bench(reference.run)); print('fused',bench(fused));print('streamed',bench(streamed))\nPY\"","aggregated_outpu