{"type":"item.started","item":{"id":"item_37","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch\nD='cuda';B,P=1,7\ndef r(s):return torch.randn(s,device=D)\na=[r((B,P,256)),r((B,P,4,256)),r((1024,256)),r((1024,)),r((1024,1024)),r((1024,)),r((4,1024)),r((4,))]\nfor _ in range(4):a += [r((256,256)),r((256,)),r((256,256)),r((256,)),r((32,256)),r((32,))]\ndef act(x,w,b):sh=x.shape;return torch.ops.aten._addmm_activation.default(b,x.view(-1,sh[-1]),w.t(),beta=1,alpha=1,use_gelu=False).view(*sh[:-1],w.shape[0])\ndef serial(*a):\n x=act(a[0],a[2],a[3]);x=act(x,a[4],a[5]);io=torch.nn.functional.linear(x,a[6],a[7]);ys=[]\n for j in range(4):\n  k=8+6*j;x=act(a[1][:,:,j,:],a[k],a[k+1]);x=act(x,a[k+2],a[k+3]);ys.append(torch.nn.functional.linear(x,a[k+4],a[k+5]))\n return io,torch.stack(ys,2)\ndef group(x,ws,bs,relu):\n G,M,K=x.shape;N=ws[0].shape[0];w=torch.stack(ws).transpose(1,2);off=torch.tensor([M,2*M,3*M,4*M],device=x.device,dtype=torch.int32);y=torch._grouped_mm(x.reshape(G*M,K),w,off).view(G,M,N);y=y+torch.stack(bs)[:,None,:];return torch.relu(y) if relu else y\ndef grouped(*a):\n x=act(a[0],a[2],a[3]);x=act(x,a[4],a[5]);io=torch.nn.functional.linear(x,a[6],a[7]);B,P=a[0].shape[:2];M=B*P;x=a[1].permute(2,0,1,3).reshape(4,M,256).contiguous();x=group(x,[a[8],a[14],a[20],a[26]],[a[9],a[15],a[21],a[27]],True);x=group(x,[a[10],a[16],a[22],a[28]],[a[11],a[17],a[23],a[29]],True);x=group(x,[a[12],a[18],a[24],a[30]],[a[13],a[19],a[25],a[31]],False);return io,x.view(4,B,P,32).permute(1,2,0,3)\ndef bench(f,n=1000):\n for _ in range(20):f(*a)\n torch.cuda.synchronize();s=torch.cuda.Event(True);e=torch.cuda.Event(True);s.record()\n for _ in range(n):f(*a)\n e.record();e.synchronize();return s.elapsed_time(e)/n\nprint('serial',bench(serial));print('grouped',bench(grouped))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
