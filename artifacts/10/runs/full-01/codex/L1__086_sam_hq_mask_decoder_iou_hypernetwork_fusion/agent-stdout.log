{"type":"item.started","item":{"id":"item_16","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch, math\nimport reference\nD='cuda'; torch.manual_seed(4)\ndef r(s):return torch.randn(s,device=D)\ndef make(B,P):\n a=[r((B,P,256)),r((B,P,4,256)),r((1024,256)),r((1024,)),r((1024,1024)),r((1024,)),r((4,1024)),r((4,))]\n for _ in range(4):a += [r((256,256)),r((256,)),r((256,256)),r((256,)),r((32,256)),r((32,))]\n return a\ndef act(x,w,b):\n sh=x.shape;x=x.view(-1,sh[-1]);return torch.ops.aten._addmm_activation.default(b,x,w.t(),beta=1,alpha=1,use_gelu=False).view(*sh[:-1],w.shape[0])\ndef fn(a):\n x=act(a[0],a[2],a[3]);x=act(x,a[4],a[5]);io=torch.nn.functional.linear(x,a[6],a[7]);ys=[]\n for j in range(4):\n  k=8+6*j;x=act(a[1][:,:,j,:],a[k],a[k+1]);x=act(x,a[k+2],a[k+3]);ys.append(torch.nn.functional.linear(x,a[k+4],a[k+5]))\n return io,torch.stack(ys,2)\naux=torch.cuda.Stream()\ndef fn2(a):\n cur=torch.cuda.current_stream();aux.wait_stream(cur)\n with torch.cuda.stream(aux):\n  x=act(a[0],a[2],a[3]);x=act(x,a[4],a[5]);io=torch.nn.functional.linear(x,a[6],a[7])\n ys=[]\n for j in range(4):\n  k=8+6*j;x=act(a[1][:,:,j,:],a[k],a[k+1]);x=act(x,a[k+2],a[k+3]);ys.append(torch.nn.functional.linear(x,a[k+4],a[k+5]))\n cur.wait_stream(aux)\n return io,torch.stack(ys,2)\ndef bench(f,a,n=500):\n for _ in range(20):f(a)\n torch.cuda.synchronize();s=torch.cuda.Event(True);e=torch.cuda.Event(True);s.record()\n for _ in range(n):f(a)\n e.record();e.synchronize();return s.elapsed_time(e)/n\nfor B,P in [(1,1),(1,7),(8,4),(64,2)]:\n a=make(B,P); y=fn(a);z=fn2(a);torch.cuda.synchronize();print(B,P,'eq',all(torch.equal(x,q) for x,q in zip(y,z)),'serial',bench(fn,a),'2stream',bench(fn2,a))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
