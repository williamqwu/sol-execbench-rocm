{"type":"item.started","item":{"id":"item_35","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch,reference\nD='cuda';torch.manual_seed(7)\ndef r(s):return torch.randn(s,device=D)\nweights=[r((1024,256)),r((1024,)),r((1024,1024)),r((1024,)),r((4,1024)),r((4,))]\nfor _ in range(4):weights += [r((256,256)),r((256,)),r((256,256)),r((256,)),r((32,256)),r((32,))]\ndef act(x,w,b):\n sh=x.shape;return torch.ops.aten._addmm_activation.default(b,x.view(-1,sh[-1]),w.t(),beta=1,alpha=1,use_gelu=False).view(*sh[:-1],w.shape[0])\ndef group(x,ws,bs,relu):\n G,M,K=x.shape;N=ws[0].shape[0]\n w=torch.stack(ws).transpose(1,2)\n off=torch.tensor([M,2*M,3*M,4*M],device=x.device,dtype=torch.int32)\n y=torch._grouped_mm(x.reshape(G*M,K),w,off).view(G,M,N)\n y=y+torch.stack(bs)[:,None,:]\n return torch.relu(y) if relu else y\ndef body(*a):\n x=act(a[0],a[2],a[3]);x=act(x,a[4],a[5]);io=torch.nn.functional.linear(x,a[6],a[7])\n B,P=a[0].shape[:2];M=B*P\n x=a[1].permute(2,0,1,3).reshape(4,M,256).contiguous()\n ws=[a[8+6*j] for j in range(4)];bs=[a[9+6*j] for j in range(4)];x=group(x,ws,bs,True)\n ws=[a[10+6*j] for j in range(4)];bs=[a[11+6*j] for j in range(4)];x=group(x,ws,bs,True)\n ws=[a[12+6*j] for j in range(4)];bs=[a[13+6*j] for j in range(4)];x=group(x,ws,bs,False)\n return io,x.view(4,B,P,32).permute(1,2,0,3)\nfor B,P in [(1,7),(8,4),(2,2),(32,1),(4,4),(16,4),(1,1),(64,2),(2,3),(1,10)]:\n a=[r((B,P,256)),r((B,P,4,256)),*weights];y=reference.run(*a);z=body(*a);torch.cuda.synchronize();print(B,P,[torch.equal(u,v) for u,v in zip(y,z)],[float((u-v).abs().max()) for u,v in zip(y,z)])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
