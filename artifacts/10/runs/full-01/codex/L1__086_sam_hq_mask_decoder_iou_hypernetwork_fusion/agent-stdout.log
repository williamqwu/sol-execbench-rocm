{"type":"item.started","item":{"id":"item_41","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch,triton\nfrom experiment import linear\nD='cuda';torch.manual_seed(11)\nfor M,K,N in [(7,256,32),(7,1024,4),(128,256,32),(128,1024,4),(1,256,32),(1,1024,4)]:\n x=torch.randn(M,K,device=D);w=torch.randn(N,K,device=D);b=torch.randn(N,device=D);ref=torch.nn.functional.linear(x,w,b)\n print('\\\\nshape',M,K,N)\n for BM,BN,BK,nw in [(16,16,K,1),(16,16,K,2),(16,16,32,1),(16,16,32,2),(16,32,K,2),(16,32,K,1),(32,16,K,2),(32,32,K,4)]:\n  if BM*BK>65536 or BN*BK>65536:continue\n  y=torch.empty_like(ref)\n  try:\n   linear[(triton.cdiv(M,BM),triton.cdiv(N,BN))](x,w,b,y,M,K,N,BM,BN,BK,num_warps=nw)\n   torch.cuda.synchronize();q=(ref-y).abs();tol=1.63e-7+1.1921e-7*ref.abs();print((BM,BN,BK,nw),'max',float(q.max()),'eq',torch.equal(ref,y),'ratio',float((q<=tol).float().mean()))\n  except Exception as e:print((BM,BN,BK,nw),'ERR',str(e).splitlines()[0])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
