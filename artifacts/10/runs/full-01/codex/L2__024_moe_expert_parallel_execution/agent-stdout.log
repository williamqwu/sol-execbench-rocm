{"type":"item.started","item":{"id":"item_29","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch, torch.nn.functional as F\nfrom aiter.fused_moe import fused_moe\n\ntorch.manual_seed(2); d='cuda'; M=8; E=4; H=4096; I=2048; K=8\nx=torch.randn(M,H,device=d,dtype=torch.bfloat16); ids=torch.randint(0,E,(M,K),device=d,dtype=torch.int64); tw=F.softmax(torch.randn(M,K,device=d,dtype=torch.bfloat16).float(),-1).bfloat16()\ng=torch.randn(E,I,H,device=d,dtype=torch.bfloat16)*.02; u=torch.randn(E,I,H,device=d,dtype=torch.bfloat16)*.02; dw=torch.randn(E,H,I,device=d,dtype=torch.bfloat16)*.02\nxf=x[:,None,:].expand(M,K,H).reshape(-1,H).float(); e=ids.reshape(-1)\ngv=torch.bmm(g[e].float(),xf[:,:,None]).squeeze(-1); uv=torch.bmm(u[e].float(),xf[:,:,None]).squeeze(-1)\ny=torch.bmm(dw[e].float(),(F.silu(gv)*uv)[:,:,None]).squeeze(-1)\nref=(y.reshape(M,K,H)*tw.float().unsqueeze(-1)).sum(1).bfloat16()\nfor name,w in [('GU',torch.cat((g,u),1)),('UG',torch.cat((u,g),1))]:\n out=fused_moe(x,w,dw,tw.float(),ids.int())\n diff=(out.float()-ref.float()).abs(); close=torch.isclose(out.float(),ref.float(),atol=.0048828125,rtol=.0095)\n print(name,'range',out.float().abs().max().item(),out.float().abs().mean().item(),'diff',diff.max().item(),diff.mean().item(),'close',close.float().mean().item())\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
