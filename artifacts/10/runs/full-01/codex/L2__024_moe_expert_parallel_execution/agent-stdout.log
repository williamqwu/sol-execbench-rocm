{"type":"item.started","item":{"id":"item_61","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch\nimport kernel\n\ndevice='cuda'\nE,H,I,K=256,4096,2048,8\n# Empty weights are sufficient for timing; all memory traffic and GEMM work is real.\ng=torch.empty((E,I,H),device=device,dtype=torch.bfloat16)\nu=torch.empty_like(g)\nd=torch.empty((E,H,I),device=device,dtype=torch.bfloat16)\nconfigs=[\n ('m32n128w8',32,128,64,1,8,2,0),\n ('m32n256w8',32,256,64,1,8,2,0),\n ('m64n128w4',64,128,64,1,4,2,1),\n ('m64n128w8',64,128,64,1,8,2,0),\n ('m64n256w8',64,256,64,1,8,2,0),\n ('m128n128k128w4',128,128,128,1,4,1,2),\n ('m128n256w8',128,256,64,1,8,2,0),\n]\nfor M in (2048,8192):\n x=torch.randn((M,H),device=device,dtype=torch.bfloat16)\n ids=torch.randint(0,E,(M,K),device=device,dtype=torch.int64)\n wt=torch.rand((M,K),device=device,dtype=torch.bfloat16)\n print('M',M,flush=True)\n for name,bm,bn,bk,group,nw,stages,waves in configs:\n  kernel.BLOCK_M=bm\n  kernel.GEMM_CONFIG.clear(); kernel.GEMM_CONFIG.update({\n   'BLOCK_SIZE_M':bm,'BLOCK_SIZE_N':bn,'BLOCK_SIZE_K':bk,\n   'GROUP_SIZE_M':group,'num_warps':nw,'num_stages':stages,\n   'waves_per_eu':waves,'matrix_instr_nonkdim':16,'kpack':1})\n  y=kernel.run(x,ids,wt,g,u,d)\n  torch.cuda.synchronize()\n  vals=[]\n  for _ in range(3):\n   s=torch.cuda.Event(enable_timing=True); e=torch.cuda.Event(enable_timing=True)\n   s.record(); y=kernel.run(x,ids,wt,g,u,d); e.record(); e.synchronize()\n   vals.append(s.elapsed_time(e))\n  print(name, ['%.3f'%v for v in vals], 'min %.3f'%min(vals),flush=True)\n del x,ids,wt,y\n torch.cuda.empty_cache()\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
