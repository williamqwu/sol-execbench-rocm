{"type":"item.completed","item":{"id":"item_13","type":"agent_message","text":"Native GEMM remains best through the medium sizes. For the three 8192-row workloads, though, a larger fused tile is already faster than the vendor GEMM while producing the required contiguous layout, so I’m tuning that branch specifically before deciding on a size-based hybrid."}}
{"type":"item.started","item":{"id":"item_14","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch,triton\nimport kernel\nS=128; B=64\nx=torch.randn((B,S,5120),device='cuda',dtype=torch.bfloat16)\nw=torch.randn((1024,5120),device='cuda',dtype=torch.bfloat16)\ny=torch.empty((B,8,S,128),device='cuda',dtype=torch.bfloat16)\ndef m(c):\n bm,bn,bk,nw,ns,wave=c\n def f():\n  grid=(triton.cdiv(S,bm),B,triton.cdiv(1024,bn))\n  kw={} if wave==0 else {'waves_per_eu':wave}\n  kernel._value_projection_kernel[grid](x,w,y,S,BLOCK_M=bm,BLOCK_N=bn,BLOCK_K=bk,num_warps=nw,num_stages=ns,**kw)\n return triton.testing.do_bench(f,warmup=10,rep=40)*1000\ncases=[]\nfor bk in (32,64,128):\n for nw in (4,8):\n  for ns in (2,3,4): cases.append((128,128,bk,nw,ns,0))\nfor bm,bn in ((64,256),(128,256),(256,128),(256,64),(64,128)):\n for bk in (64,128):\n  for nw in (4,8): cases.append((bm,bn,bk,nw,3,0))\nfor wave in (1,2,3,4): cases.append((128,128,64,8,3,wave))\nfor c in cases:\n try: print(c,f'{m(c):.1f}',flush=True)\n except Exception as e: print(c,type(e).__name__,str(e)[:180],flush=True)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
