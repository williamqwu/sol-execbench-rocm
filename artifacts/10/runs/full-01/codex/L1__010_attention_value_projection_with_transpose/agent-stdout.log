{"type":"item.started","item":{"id":"item_16","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch,triton\nimport kernel\nfor B,S in ((64,128),(1,8192),(8,1024)):\n x=torch.randn((B,S,5120),device='cuda',dtype=torch.bfloat16)\n w=torch.randn((1024,5120),device='cuda',dtype=torch.bfloat16)\n def custom():\n  y=torch.empty((B,8,S,128),device='cuda',dtype=torch.bfloat16)\n  kernel._value_projection_kernel[(triton.cdiv(S,128),B,4)](x,w,y,S,BLOCK_M=128,BLOCK_N=256,BLOCK_K=64,num_warps=8,num_stages=3)\n  return y\n def native(): return torch.nn.functional.linear(x,w).view(B,S,8,128).transpose(1,2)\n y=custom(); ref=native().contiguous(); torch.cuda.synchronize()\n diff=(y.float()-ref.float()).abs(); close=torch.isclose(y,ref,atol=0.00782,rtol=0.0078125)\n a=triton.testing.do_bench(custom,warmup=10,rep=40)*1000\n n=triton.testing.do_bench(native,warmup=10,rep=40)*1000\n print((B,S),f'custom={a:.1f} native={n:.1f} max={diff.max().item():.5g} ratio={close.float().mean().item():.7f}',flush=True)\n del x,w,y,ref,diff,close\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
