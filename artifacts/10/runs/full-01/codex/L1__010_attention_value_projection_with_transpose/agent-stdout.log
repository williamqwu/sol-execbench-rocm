{"type":"item.started","item":{"id":"item_7","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch, triton\nimport kernel\n\nS = 128\nx = torch.randn((64, S, 5120), device='cuda', dtype=torch.bfloat16)\nw = torch.randn((1024, 5120), device='cuda', dtype=torch.bfloat16)\ny = torch.empty((64, 8, S, 128), device='cuda', dtype=torch.bfloat16)\nconfigs = [\n    (16,32,32,4), (16,64,32,4), (16,64,32,8), (16,128,32,4),\n    (32,32,32,4), (32,64,32,4), (32,64,32,8), (32,128,32,8),\n    (64,64,32,4), (64,64,32,8), (64,128,32,8),\n    (16,64,64,4), (32,64,64,4), (64,64,64,4),\n]\nfor cfg in configs:\n    bm,bn,bk,nw = cfg\n    def launch(B=1):\n        grid=(triton.cdiv(S,bm), B, triton.cdiv(1024,bn))\n        kernel._value_projection_kernel[grid](x,w,y,S,BLOCK_M=bm,BLOCK_N=bn,BLOCK_K=bk,num_warps=nw,num_stages=2)\n    try:\n        vals=[]\n        for B in (1,2,4,8,16,32,64):\n            ms=triton.testing.do_bench(lambda B=B: launch(B), warmup=10, rep=30)\n            vals.append(ms*1000)\n        print(cfg, ' '.join(f'{v:6.1f}' for v in vals), flush=True)\n    except Exception as e:\n        print(cfg, type(e).__name__, str(e)[:300], flush=True)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
