{"type":"item.started","item":{"id":"item_33","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch,triton,aiter\nfor M in (128,256,512,1024,1571,2048,2164,4096,8192):\n x=torch.randn((M,5120),device='cuda',dtype=torch.bfloat16)\n w=torch.randn((1024,5120),device='cuda',dtype=torch.bfloat16)\n try:\n  y=aiter.gemm_a16w16_opus(x,w)\n  ref=torch.nn.functional.linear(x,w)\n  torch.cuda.synchronize()\n  close=torch.isclose(y,ref,atol=.00782,rtol=.0078125).float().mean().item()\n  mx=(y.float()-ref.float()).abs().max().item()\n  a=triton.testing.do_bench(lambda:aiter.gemm_a16w16_opus(x,w),warmup=10,rep=50)*1000\n  n=triton.testing.do_bench(lambda:torch.nn.functional.linear(x,w),warmup=10,rep=50)*1000\n  print(M,f'aiter={a:.1f} native={n:.1f} max={mx:g} ratio={close:.7f}',flush=True)\n except Exception as e: print(M,type(e).__name__,str(e)[:300],flush=True)\n del x,w\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
