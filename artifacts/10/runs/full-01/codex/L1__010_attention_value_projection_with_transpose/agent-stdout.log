{"type":"item.started","item":{"id":"item_12","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch, triton\nimport kernel\nS=128\nx=torch.randn((64,S,5120),device='cuda',dtype=torch.bfloat16)\nw=torch.randn((1024,5120),device='cuda',dtype=torch.bfloat16)\ny=torch.empty((64,8,S,128),device='cuda',dtype=torch.bfloat16)\n\ndef measure(tag,bm,bn,bk,nw,ns=2,**opts):\n    def launch(B):\n        grid=(triton.cdiv(S,bm),B,triton.cdiv(1024,bn))\n        kernel._value_projection_kernel[grid](x,w,y,S,BLOCK_M=bm,BLOCK_N=bn,BLOCK_K=bk,num_warps=nw,num_stages=ns,**opts)\n    vals=[]\n    for B in (1,4,16,64):\n        vals.append(triton.testing.do_bench(lambda B=B:launch(B),warmup=8,rep=25)*1000)\n    print(f'{tag:24s}', ' '.join(f'{v:6.1f}' for v in vals),flush=True)\n\ncases=[\n ('16x64x64 w4',16,64,64,4,2,{}),\n ('32x64x64 w4',32,64,64,4,2,{}),\n ('64x64x64 w4',64,64,64,4,2,{}),\n ('64x128x64 w4',64,128,64,4,2,{}),\n ('64x128x64 w8',64,128,64,8,2,{}),\n ('128x64x64 w4',128,64,64,4,2,{}),\n ('128x64x64 w8',128,64,64,8,2,{}),\n ('128x128x64 w8',128,128,64,8,2,{}),\n ('64x64x128 w4',64,64,128,4,2,{}),\n ('32x64x128 w4',32,64,128,4,2,{}),\n]\nfor c in cases:\n    try: measure(*c[:-1],**c[-1])\n    except Exception as e: print(c[0],type(e).__name__,str(e)[:200],flush=True)\nfor wave in (1,2,3,4):\n  for mi in (16,32):\n    try: measure(f'64cube wave{wave} mi{mi}',64,64,64,4,2,waves_per_eu=wave,matrix_instr_nonkdim=mi)\n    except Exception as e: print('flag',wave,mi,type(e).__name__,str(e)[:200],flush=True)\nfor kp in (1,2):\n    try: measure(f'64cube kpack{kp}',64,64,64,4,2,kpack=kp)\n    except Exception as e: print('kpack',kp,type(e).__name__,str(e)[:200],flush=True)\nfor ns in (1,3,4):\n    try: measure(f'64cube stages{ns}',64,64,64,4,ns)\n    except Exception as e: print('stages',ns,type(e).__name__,str(e)[:200],flush=True)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
