"tolerance\": {\"max_atol\": 8.429369694834519e-08, \"max_rtol\": 1.1920928955078125e-07, \"required_matched_ratio\": 0.99, \"_provenance\": \"max run-to-run error over 10 seeds x 1.25 margin, floored at torch.float32 epsilon\"}}\n{\"uuid\": \"fec2b005-bdf8-5d6b-9739-64ed9642c79a\", \"axes\": {\"seq_len\": 1087}, \"inputs\": {\"ids\": {\"type\": \"random\"}, \"theta\": {\"type\": \"scalar\", \"value\": 10000.0}}, \"tolerance\": {\"max_atol\": 8.429369695455812e-08, \"max_rtol\": 1.1920928955078125e-07, \"required_matched_ratio\": 0.99, \"_provenance\": \"max run-to-run error over 10 seeds x 1.25 margin, floored at torch.float32 epsilon\"}}\n{\"uuid\": \"d8d69b70-6743-5ca3-bff0-8bab350a7c4b\", \"axes\": {\"seq_len\": 4093}, \"inputs\": {\"ids\": {\"type\": \"random\"}, \"theta\": {\"type\": \"scalar\", \"value\": 10000.0}}, \"tolerance\": {\"max_atol\": 8.429369695313523e-08, \"max_rtol\": 1.1920928955078125e-07, \"required_matched_ratio\": 0.99, \"_provenance\": \"max run-to-run error over 10 seeds x 1.25 margin, floored at torch.float32 epsilon\"}}\n{\"uuid\": \"861be0dd-9fb8-520b-a2d7-5d86e7e27873\", \"axes\": {\"seq_len\": 3011}, \"inputs\": {\"ids\": {\"type\": \"random\"}, \"theta\": {\"type\": \"scalar\", \"value\": 10000.0}}, \"tolerance\": {\"max_atol\": 8.429369695339498e-08, \"max_rtol\": 1.1920928955078125e-07, \"required_matched_ratio\": 0.99, \"_provenance\": \"max run-to-run error over 10 seeds x 1.25 margin, floored at torch.float32 epsilon\"}}\n","exit_code":0,"status":"completed"}}
