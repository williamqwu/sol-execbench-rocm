{"type":"item.started","item":{"id":"item_16","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch, triton\nimport kernel, reference\n\ndef launch_rows(x, a, b, rpp, fast=False):\n    n=x.shape[0]\n    kernel._rope_kernel_rows[(triton.cdiv(n,rpp),)](x,a,b,n_rows=n,theta=10000.0,ROWS_PER_PROGRAM=rpp,USE_FAST_POW=fast,num_warps=1)\n\nfor n in (131, 373, 997, 4096):\n    x=torch.randn((n,3),device='cuda',dtype=torch.float32)\n    a=torch.empty((n,128),device='cuda'); b=torch.empty_like(a)\n    refa,refb=reference.run(x,10000.0)\n    print('n',n)\n    for rpp in (1,2,4,8):\n        launch_rows(x,a,b,rpp,False); torch.cuda.synchronize()\n        d1=(a-refa).abs(); d2=(b-refb).abs()\n        ok=((d1 <= 8.43e-8+1.193e-7*refa.abs()).sum()+(d2 <= 8.43e-8+1.193e-7*refb.abs()).sum()).float()/(2*n*128)\n        ms=triton.testing.do_bench(lambda: launch_rows(x,a,b,rpp,False), warmup=20, rep=100)\n        print(' rpp',rpp,'us',float(ms)*1000,'match',float(ok))\n    launch_rows(x,a,b,1,True); torch.cuda.synchronize()\n    d1=(a-refa).abs(); d2=(b-refb).abs()\n    ok=((d1 <= 8.43e-8+1.193e-7*refa.abs()).sum()+(d2 <= 8.43e-8+1.193e-7*refb.abs()).sum()).float()/(2*n*128)\n    ms=triton.testing.do_bench(lambda: launch_rows(x,a,b,1,True), warmup=20, rep=100)\n    print(' fastpow us',float(ms)*1000,'match',float(ok),'max',float(torch.maximum(d1.max(),d2.max())))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
