{"type":"item.completed","item":{"id":"item_25","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,180p' kernel.py\"","aggregated_output":"import torch\nimport triton\nimport triton.language as tl\nfrom triton.language.extra import libdevice\n\n\n@triton.jit\ndef _rope_kernel(\n    ids,\n    out_cos,\n    out_sin,\n    n_rows: tl.constexpr,\n    theta: tl.constexpr,\n):\n    row = tl.program_id(0)\n    band = tl.arange(0, 64)\n\n    # The three half-dimensions are 8, 28, and 28.  Their doubled,\n    # interleaved destinations happen to be simply 2 * band throughout.\n    axis = tl.where(band < 8, 0, tl.where(band < 36, 1, 2))\n    exponent = tl.where(band < 8, band, tl.where(band < 36, band - 8, band - 36))\n    half_dim = tl.where(band < 8, 8.0, 28.0)\n\n    p0 = tl.load(ids + row * 3)\n    p1 = tl.load(ids + row * 3 + 1)\n    p2 = tl.load(ids + row * 3 + 2)\n    position = tl.where(axis == 0, p0, tl.where(axis == 1, p1, p2))\n\n    freq = 1.0 / libdevice.pow(theta, exponent.to(tl.float32) / half_dim)\n    angle = position * freq\n    c = libdevice.cos(angle)\n    s = libdevice.sin(angle)\n\n    dst = row * 128 + 2 * band\n    tl.store(out_cos + dst, c)\n    tl.store(out_cos + dst + 1, c)\n    tl.store(out_sin + dst, s)\n    tl.store(out_sin + dst + 1, s)\n\n\n@triton.jit\ndef _rope_kernel_rows(\n    ids,\n    out_cos,\n    out_sin,\n    n_rows: tl.constexpr,\n    theta,\n    ROWS_PER_PROGRAM: tl.constexpr,\n    USE_EXP2: tl.constexpr,\n    INTERLEAVED_STORE: tl.constexpr,\n):\n    band = tl.arange(0, 64)\n    exponent = tl.where(band < 8, band, tl.where(band < 36, band - 8, band - 36))\n    half_dim = tl.where(band < 8, 8.0, 28.0)\n    power = exponent.to(tl.float32) / half_dim\n    if USE_EXP2:\n        # In this experimental branch, `theta` is log2(theta), computed by\n        # the Python wrapper from its scalar argument.\n        freq = tl.exp2(-power * theta)\n    else:\n        freq = 1.0 / libdevice.pow(theta, power)\n\n    for row_in_program in range(ROWS_PER_PROGRAM):\n        row = tl.program_id(0) * ROWS_PER_PROGRAM + row_in_program\n        valid = row < n_rows\n        p0 = tl.load(ids + row * 3, mask=valid)\n        p1 = tl.load(ids + row * 3 + 1, mask=valid)\n        p2 = tl.load(ids + row * 3 + 2, mask=valid)\n        position = tl.where(band < 8, p0, tl.where(band < 36, p1, p2))\n        angle = position * freq\n        c = libdevice.cos(angle)\n        s = libdevice.sin(angle)\n        dst = row * 128 + 2 * band\n        if INTERLEAVED_STORE:\n            out_col = tl.arange(0, 128)\n            tl.store(out_cos + row * 128 + out_col, tl.interleave(c, c), mask=valid)\n            tl.store(out_sin + row * 128 + out_col, tl.interleave(s, s), mask=valid)\n        else:\n            tl.store(out_cos + dst, c, mask=valid)\n            tl.store(out_cos + dst + 1, c, mask=valid)\n            tl.store(out_sin + dst, s, mask=valid)\n            tl.store(out_sin + dst + 1, s, mask=valid)\n\n\ndef run(ids: torch.Tensor, theta: float):\n    n_rows = ids.shape[0]\n    out_cos = torch.empty((n_rows, 128), device=ids.device, dtype=torch.float32)\n    out_sin = torch.empty_like(out_cos)\n    _rope_kernel[(n_rows,)](\n        ids,\n        out_cos,\n        out_sin,\n        n_rows=n_rows,\n        theta=theta,\n        num_warps=1,\n    )\n    return out_cos, out_sin\n","exit_code":0,"status":"completed"}}
