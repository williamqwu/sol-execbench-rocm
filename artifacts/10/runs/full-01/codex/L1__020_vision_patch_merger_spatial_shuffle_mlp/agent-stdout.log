{"type":"item.completed","item":{"id":"item_53","type":"agent_message","text":"AITER exposes 2,081 supported hipBLASLt solutions for the large fused FC1, far beyond the single heuristic PyTorch uses. I’m timing those solution IDs locally with one warm pass and one event-timed pass, then re-benchmarking only the fastest few. If none clearly beats the current 1.08 ms fused FC1, I’ll keep the verified path."}}
{"type":"item.started","item":{"id":"item_54","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch,aiter,triton,time\nimport reference\nA=reference.get_inputs({'num_patches':65536,'num_merged_patches':16384,'num_grids':4},torch.device('cuda:0'))\nx=torch.randn((16384,6144),dtype=torch.bfloat16,device='cuda'); w=A['fc1_weight'].t();b=A['fc1_bias']\ntorch.ops.aiter.hipb_create_extension(x)\nsols=torch.ops.aiter.hipb_findallsols(x,w,b,use_gelu=True)\nprint('solutions',len(sols),flush=True)\n# One pass initializes each hipBLASLt solution.\nfor i,s in enumerate(sols):\n try: torch.ops.aiter.hipb_mm(x,w,s,bias=b,use_gelu=True)\n except RuntimeError: pass\ntorch.cuda.synchronize();print('warm done',flush=True)\nresults=[]\nfor s in sols:\n try:\n  st=torch.cuda.Event(enable_timing=True);en=torch.cuda.Event(enable_timing=True)\n  st.record();y=torch.ops.aiter.hipb_mm(x,w,s,bias=b,use_gelu=True);en.record();results.append((st,en,s))\n except RuntimeError: pass\ntorch.cuda.synchronize()\ntimes=sorted((st.elapsed_time(en),s) for st,en,s in results)\nprint('event top',times[:20],flush=True)\ndef bench(s):return triton.testing.do_bench(lambda:torch.ops.aiter.hipb_mm(x,w,s,bias=b,use_gelu=True),warmup=50,rep=150,return_mode='median')\nrobust=sorted((bench(s),s) for _,s in times[:12])\nprint('robust',robust,flush=True)\nprint('torch',triton.testing.do_bench(lambda:torch.ops.aten._addmm_activation(b,x,w,use_gelu=True),warmup=50,rep=150,return_mode='median'))\ntorch.ops.aiter.hipb_destroy_extension(x)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
