{"type":"item.started","item":{"id":"item_32","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch,triton\nimport torch.nn.functional as F\nimport kernel,reference\n\ndef bench(f):return triton.testing.do_bench(f,warmup=100,rep=300,return_mode='median')\na=reference.get_inputs({'num_patches':1024,'num_merged_patches':256,'num_grids':1},torch.device('cuda:0'))\nfor m in (128,144,256,400):\n x=torch.randn((m,6144),dtype=torch.bfloat16,device='cuda'); out=torch.empty_like(x)\n def custom():kernel._small_fc1_gelu[(triton.cdiv(m,64)*(6144//64),)](x,a['fc1_weight'],a['fc1_bias'],out,m,BLOCK_M=64,BLOCK_N=64,BLOCK_K=256,GROUP_M=4,num_warps=8,num_stages=2,kpack=2,matrix_instr_nonkdim=16,waves_per_eu=0)\n try:\n  custom(); ref=torch.ops.aten._addmm_activation(a['fc1_bias'],x,a['fc1_weight'].t(),use_gelu=True);torch.cuda.synchronize()\n  d=(out.float()-ref.float()).abs();lim=.01+.0078125*ref.float().abs()\n  print(m,'custom',bench(custom),'vendor',bench(lambda:torch.ops.aten._addmm_activation(a['fc1_bias'],x,a['fc1_weight'].t(),use_gelu=True)),'max',d.max().item(),'match',(d<=lim).float().mean().item(),'exact',(out==ref).float().mean().item())\n except Exception as e:print('ERR',m,type(e).__name__,e)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
