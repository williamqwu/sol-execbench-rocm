{"type":"item.started","item":{"id":"item_33","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch,triton\nimport torch.nn.functional as F\nfrom triton.testing import do_bench\nfrom kernel import _normalize_kernel,_affine_kernel\nfor B,H in [(1,28),(4,28),(16,14),(16,56),(64,56)]:\n torch.manual_seed(9);f=torch.randn;d='cuda';S=H*H\n hs=f(B,H,H,128,device=d);w1=f(512,128,device=d);b1=f(512,device=d);gw=f(1,1,1,512,device=d);gb=f(1,1,1,512,device=d);w2=f(128,512,device=d);b2=f(128,device=d);eps=1e-6\n z=F.linear(hs,w1,b1);x=F.gelu(z);g=torch.linalg.vector_norm(x,ord=2,dim=(1,2),keepdim=True);n=g/(g.mean(-1,keepdim=True)+eps);y=gw*(x*n)+gb+x;ref=F.linear(y,w2,b2)\n gc=g.clone();xc=x.clone();_normalize_kernel[(B,)](gc,eps=eps,num_warps=8);_affine_kernel[(triton.cdiv(x.numel(),256),)](xc,gc,gw,gb,n_elements=x.numel(),batch_stride=S*512,BLOCK=256,num_warps=4);o=F.linear(xc,w2,b2);torch.cuda.synchronize()\n dg=(gc-n).abs();do=(o-ref).abs();q=torch.isclose(o,ref,atol=1.85e-7,rtol=1.1920928955078125e-7)\n print(B,H,'normmax',dg.max().item(),'normexact',(gc==n).float().mean().item(),'outmax',do.max().item(),'close',q.float().mean().item(),'exact',(o==ref).float().mean().item())\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
