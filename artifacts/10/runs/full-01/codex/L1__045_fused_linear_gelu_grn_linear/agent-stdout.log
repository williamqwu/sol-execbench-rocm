{"type":"item.started","item":{"id":"item_10","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch\nimport torch.nn.functional as F\n\ntorch.manual_seed(0)\ndev='cuda'\nB,H,W=4,28,28\nhs=torch.rand(B,H,W,128,device=dev)\nw1=torch.rand(512,128,device=dev)\nb1=torch.rand(512,device=dev)\ngw=torch.rand(1,1,1,512,device=dev)\ngb=torch.rand(1,1,1,512,device=dev)\nw2=torch.rand(128,512,device=dev)\nb2=torch.rand(128,device=dev)\neps=1e-6\n\ndef eager_aff(x,n,gw,gb): return gw*(x*n)+gb+x\n@torch.compile(fullgraph=True)\ndef comp_aff(x,n,gw,gb): return gw*(x*n)+gb+x\n@torch.compile(fullgraph=True)\ndef comp_norm(g, eps): return g/(g.mean(dim=-1,keepdim=True)+eps)\n@torch.compile(fullgraph=True)\ndef comp_ga(x): return F.gelu(x)\n\ndef stats(a,b,name):\n d=(a-b).abs(); ok=torch.isclose(a,b,atol=1.85e-7,rtol=1.1920928955078125e-7)\n print(name, 'max',d.max().item(),'exact', (a==b).float().mean().item(),'close',ok.float().mean().item())\n\nz=F.linear(hs,w1,b1)\nx=F.gelu(z)\ng=torch.linalg.vector_norm(x,ord=2,dim=(1,2),keepdim=True)\nn=g/(g.mean(dim=-1,keepdim=True)+eps)\ny=eager_aff(x,n,gw,gb)\no=F.linear(y,w2,b2)\n\nxc=comp_ga(z); stats(xc,x,'gelu')\nnc=comp_norm(g,eps); stats(nc,n,'norm')\nyc=comp_aff(x,n,gw,gb); stats(yc,y,'aff')\nfor name, yy in [('gelu-out', eager_aff(xc, torch.linalg.vector_norm(xc,ord=2,dim=(1,2),keepdim=True)/(torch.linalg.vector_norm(xc,ord=2,dim=(1,2),keepdim=True).mean(dim=-1,keepdim=True)+eps),gw,gb)),('norm-out',eager_aff(x,nc,gw,gb)),('aff-out',yc)]:\n oo=F.linear(yy,w2,b2); stats(oo,o,name)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
