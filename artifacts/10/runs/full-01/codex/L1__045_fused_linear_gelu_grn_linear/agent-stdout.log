{"type":"item.started","item":{"id":"item_11","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch\nimport torch.nn.functional as F\n\ntorch.manual_seed(1); d='cuda'; B,H,W=4,28,28\nT=lambda *s: torch.randn(*s,device=d)\nhs=T(B,H,W,128); w1=T(512,128); b1=T(512); gw=T(1,1,1,512); gb=T(1,1,1,512); w2=T(128,512); b2=T(128); eps=1e-6\n@torch.compile(fullgraph=True)\ndef post(x,g,gw,gb,eps):\n n=g/(g.mean(dim=-1,keepdim=True)+eps)\n return gw*(x*n)+gb+x\n@torch.compile(fullgraph=True)\ndef aff(x,n,gw,gb): return gw*(x*n)+gb+x\nz=F.linear(hs,w1,b1); x=F.gelu(z); g=torch.linalg.vector_norm(x,ord=2,dim=(1,2),keepdim=True); n=g/(g.mean(dim=-1,keepdim=True)+eps); y=gw*(x*n)+gb+x; o=F.linear(y,w2,b2)\ndef st(a,b,nm):\n q=torch.isclose(a,b,atol=1.85e-7,rtol=1.1920928955078125e-7); z=(a-b).abs(); print(nm,z.max().item(),q.float().mean().item(),(a==b).float().mean().item())\nfor nm,yy in [('aff',aff(x,n,gw,gb)),('post',post(x,g,gw,gb,eps))]: st(F.linear(yy,w2,b2),o,nm)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
