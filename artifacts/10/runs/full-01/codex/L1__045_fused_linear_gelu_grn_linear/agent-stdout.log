{"type":"item.started","item":{"id":"item_26","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch,triton\nimport torch.nn.functional as F\nfrom triton.testing import do_bench\nimport reference\nfrom kernel import _final_linear_kernel\n\ndef setup(B,H,kind='randn'):\n torch.manual_seed(7); f=getattr(torch,kind);d='cuda';W=H\n a=[f(B,H,W,128,device=d),f(512,128,device=d),f(512,device=d),f(1,1,1,512,device=d),f(1,1,1,512,device=d),f(128,512,device=d),f(128,device=d),1e-6]\n x=F.gelu(F.linear(a[0],a[1],a[2]));g=torch.linalg.vector_norm(x,ord=2,dim=(1,2),keepdim=True);m=g.mean(-1,keepdim=True)\n return a,x,g,m\n\ndef custom(a,x,g,m,BM,BN,BK,NW):\n M=x.numel()//512;S=x.shape[1]*x.shape[2];o=torch.empty((*x.shape[:-1],128),device=x.device)\n _final_linear_kernel[(triton.cdiv(M,BM),triton.cdiv(128,BN))](x,g,m,a[3],a[4],a[5],a[6],o,n_rows=M,n_spatial=S,eps=a[7],BLOCK_M=BM,BLOCK_N=BN,BLOCK_K=BK,num_warps=NW)\n return o\nfor kind in ['rand','randn']:\n a,x,g,m=setup(4,28,kind); ref=reference.run(*a)\n print('KIND',kind)\n for c in [(16,32,32,4),(32,32,32,4),(32,64,32,4),(64,32,32,4),(64,64,32,8)]:\n  try:\n   o=custom(a,x,g,m,*c);torch.cuda.synchronize();d=(o-ref).abs();q=torch.isclose(o,ref,atol=1.85e-7,rtol=1.1920928955078125e-7)\n   print(c,'max',d.max().item(),'close',q.float().mean().item(),'exact',(o==ref).float().mean().item())\n  except Exception as e: print(c,type(e).__name__,str(e)[:300])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
