{"type":"item.started","item":{"id":"item_21","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch, triton\nimport torch.nn.functional as F\nfrom triton.testing import do_bench\nfrom kernel import _post_grn_kernel\n\ndef setup(B,H):\n f=torch.rand; d='cuda'; W=H\n return [f(B,H,W,128,device=d),f(512,128,device=d),f(512,device=d),f(1,1,1,512,device=d),f(1,1,1,512,device=d),f(128,512,device=d),f(128,device=d),1e-6]\ndef run(a,BM,BC,NW):\n hs,w1,b1,gw,gb,w2,b2,eps=a\n x=F.gelu(F.linear(hs,w1,b1)); g=torch.linalg.vector_norm(x,ord=2,dim=(1,2),keepdim=True); m=g.mean(dim=-1,keepdim=True)\n B,S=x.shape[0],x.shape[1]*x.shape[2]; grid=B*triton.cdiv(S,BM)*triton.cdiv(512,BC)\n _post_grn_kernel[(grid,)](x,g,m,gw,gb,n_spatial=S,batch_stride=S*512,eps=eps,BLOCK_M=BM,BLOCK_C=BC,num_warps=NW)\n return F.linear(x,w2,b2)\nconfigs=[(1,256,4),(2,128,4),(4,64,4),(8,32,4),(16,16,4),(2,64,2),(4,32,2),(4,128,8),(8,64,8)]\nfor B,H in [(1,28),(16,14),(16,56),(64,56)]:\n a=setup(B,H); print('SHAPE',B,H)\n for c in configs:\n  run(a,*c); torch.cuda.synchronize()\n  t=do_bench(lambda:run(a,*c),warmup=10,rep=30)\n  print(c,round(t,6))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
