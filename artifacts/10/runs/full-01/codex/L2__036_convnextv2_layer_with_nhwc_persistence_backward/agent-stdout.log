n   157\t    x_normalized,\n   158\t    x_ln,\n   159\t    x_expanded,\n   160\t    x_gelu,\n   161\t    global_features,\n   162\t    gf_mean,\n   163\t    norm_features,\n   164\t    x_grn_scaled,\n   165\t    x_grn,\n   166\t    dwconv_weight,\n   167\t    layernorm_weight,\n   168\t    pwconv1_weight,\n   169\t    grn_weight,\n   170\t    pwconv2_weight,\n   171\t    drop_mask,\n   172\t    drop_path_prob,\n   173\t    eps,\n   174\t):\n   175\t    B, C, H, W = grad_output.shape\n   176\t    current_stream = torch.cuda.current_stream()\n   177\t    streams = _dw_streams()\n   178\t\n   179\t    grad_residual = grad_output\n   180\t    grad_x_nchw = grad_output\n   181\t    if drop_path_prob > 0.0:\n   182\t        keep_prob = 1.0 - drop_path_prob\n   183\t        grad_x_nchw = grad_x_nchw * drop_mask / keep_prob\n   184\t\n   185\t    grad_x_projected = grad_x_nchw.permute(0, 2, 3, 1)\n   186\t    grad_x_grn = F.linear(grad_x_projected, pwconv2_weight.t())\n   187\t    grad_x_projected_flat = grad_x_projected.reshape(-1, C)\n   188\t    x_grn_flat = x_grn.reshape(-1, 4 * C)\n   189\t    grad_pwconv2_weight = grad_x_projected_flat.t() @ x_grn_flat\n   190\t    grad_pwconv2_bias = grad_x_projected.sum(dim=(0, 1, 2))\n","exit_code":0,"status":"completed"}}
