ight = (grad_x_grn * x_grn_scaled).sum(dim=(0, 1, 2), keepdim=True)\n    60\t    grad_grn_bias = grad_x_grn.sum(dim=(0, 1, 2), keepdim=True)\n    61\t    grad_x_gelu_from_scaled = grad_x_grn_scaled * norm_features\n    62\t    grad_norm_features = (grad_x_grn_scaled * x_gelu).sum(dim=(1, 2), keepdim=True)\n    63\t    grad_x_gelu = grad_x_gelu_from_grn + grad_x_gelu_from_scaled\n    64\t\n    65\t    grad_global_features = grad_norm_features / (gf_mean + eps)\n    66\t    grad_gf_mean = -grad_norm_features * global_features / ((gf_mean + eps) ** 2)\n    67\t    grad_global_features = grad_global_features + grad_gf_mean / global_features.shape[-1]\n    68\t    grad_x_gelu = grad_x_gelu + x_gelu * grad_global_features / (global_features + eps)\n    69\t\n    70\t    sqrt_2_over_pi = 0.7978845608028654\n    71\t    cdf_coeff = 0.044715\n    72\t    inner = sqrt_2_over_pi * (x_expanded + cdf_coeff * x_expanded.pow(3))\n    73\t    tanh_inner = torch.tanh(inner)\n    74\t    cdf_approx = 0.5 * (1.0 + tanh_inner)\n    75\t    pdf_approx = (\n    76\t        0.5\n    77\t        * (1.0 - tanh_inner.pow(2))\n    78\t        * sqrt_2_over_pi\n    79\t        * (1.0 + 3.0 * cdf_coeff * x_expanded.pow(2))\n    80\t    )\n    81\t    gelu_grad = cdf_approx + x_expanded * pdf_approx\n    82\t    grad_x_expanded = grad_x_gelu * gelu_grad\n    83\t\n    84\t    grad_x_ln = F.linear(grad_x_expanded, pwconv1_weight.t())\n    85\t    grad_x_expanded_flat = grad_x_expanded.reshape(-1, 4 * C)\n    86\t    x_ln_flat = x_ln.reshape(-1, C)\n    87\t    grad_pwconv1_weight = grad_x_expanded_flat.t() @ x_ln_flat\n    88\t    grad_pwconv1_bias = grad_x_expanded.sum(dim=(0, 1, 2))\n    89\t\n    90\t    grad_x_normalized = grad_x_ln * layernorm_weight\n    91\t    grad_layernorm_weight = (grad_x_ln * x_normalized).sum(dim=(0, 1, 2))\n    92\t    grad_layernorm_bias = grad_x_ln.sum(dim=(0, 1, 2))\n    93\t\n    94\t    std = torch.sqrt(var + eps)\n    95\t    grad_x_nhwc = grad_x_normalized / 