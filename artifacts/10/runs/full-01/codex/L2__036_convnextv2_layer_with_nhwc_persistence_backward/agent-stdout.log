entwise(\n    58\t        \"ds_bpermute_b32 $0, $1, $2\",\n    59\t        \"=v,v,v\",\n    60\t        [byte_index, x],\n    61\t        dtype=tl.float32,\n    62\t        is_pure=True,\n    63\t        pack=1,\n    64\t    )\n    65\t\n    66\t\n    67\t@triton.jit\n    68\tdef _lane_id(x):\n    69\t    return tl.inline_asm_elementwise(\n    70\t        \"v_mbcnt_lo_u32_b32 $0, -1, 0; v_mbcnt_hi_u32_b32 $0, -1, $0\",\n    71\t        \"=v,v\",\n    72\t        [x],\n    73\t        dtype=tl.int32,\n    74\t        is_pure=True,\n    75\t        pack=1,\n    76\t    )\n    77\t\n    78\t\n    79\t@triton.jit\n    80\tdef _lane_test_kernel(output):\n    81\t    lanes = tl.arange(0, 64)\n    82\t    ids = _lane_id(lanes)\n    83\t    tl.store(output + lanes, ids)\n    84\t\n    85\t\n    86\t@triton.jit\n    87\tdef _dw_sum_kernel(\n    88\t    products,\n    89\t    output,\n    90\t    N,\n    91\t    BLOCK: tl.constexpr,\n    92\t    CONTIGUOUS: tl.constexpr = False,\n    93\t    REDUCE_STYLE: tl.constexpr = 0,\n    94\t):\n    95\t    c = tl.program_id(0)\n    96\t    tap = tl.program_id(1)\n    97\t    lane = tl.arange(0, BLOCK)\n    98\t    acc = tl.zeros((BLOCK,), dtype=tl.float32)\n    99\t    k = 0\n   100\t    chunk = tl.cdiv(N, BLOCK)\n   101\t    while k < chunk:\n   102\t        if CONTIGUOUS:\n   103\t            n = lane * chunk + k\n   104\t        else:\n   105\t            n = k * BLOCK + lane\n   106\t        x = tl.load(products + (c * N + n) * 49 + tap, mask=n < N, other=0.0)\n   107\t        acc += x\n   108\t        k += 1\n   109\t    if REDUCE_STYLE == 3:\n   110\t        wave_lane = _lane_id(acc)\n   111\t        for offset in tl.static_range(32, 0, -16):\n   112\t            source_lane = tl.where(wave_lane < offset, wave_lane + offset, 0)\n   113\t            other = _ds_bpermute(acc, source_lane * 4)\n   114\t            acc = tl.where(wave_lane < offset, acc + other, acc)\n   115\t        source_lane = tl.where(wave_lane < 8, wave_lane +