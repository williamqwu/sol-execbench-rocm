{"type":"item.started","item":{"id":"item_36","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch, triton\nimport kernel\n\ndef bench(args, configs):\n    b,q,p=args; z=q+p; shape=(b,64,q,z)\n    f=torch.empty(shape,dtype=torch.bool,device='cuda'); s=torch.empty_like(f)\n    nw=f.numel()//8; wpr=z//8\n    a=torch.cuda.Event(enable_timing=True); e=torch.cuda.Event(enable_timing=True)\n    for block,warps,wpe in configs:\n        grid=(triton.cdiv(nw,block),)\n        kw=dict(BLOCK=block,num_warps=warps,num_stages=1)\n        if wpe is not None: kw['waves_per_eu']=wpe\n        kernel._prepare_masks_flat_packed64_kernel[grid](f,s,nw,q,wpr,p,**kw)\n        torch.cuda.synchronize(); ts=[]\n        for _ in range(7):\n            a.record(); kernel._prepare_masks_flat_packed64_kernel[grid](f,s,nw,q,wpr,p,**kw); e.record(); e.synchronize(); ts.append(a.elapsed_time(e))\n        print(args,(block,warps,wpe),ts[2:],sum(ts[2:])/5)\n\ncfg=[(512,8,None),(1024,8,None),(2048,8,None),(4096,8,None),(8192,8,None),\n     (1024,4,None),(2048,4,None),(4096,4,None),\n     (2048,8,1),(2048,8,2),(2048,8,3),(2048,8,4)]\nbench((8,1024,1024),cfg)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
