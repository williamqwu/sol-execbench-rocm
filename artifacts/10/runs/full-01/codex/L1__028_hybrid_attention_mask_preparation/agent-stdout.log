{"type":"item.started","item":{"id":"item_44","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport gc,torch,triton\nimport kernel\n\ndef bench(args):\n b,q,p=args;z=q+p;shape=(b,64,q,z);f=torch.empty(shape,dtype=torch.bool,device='cuda');s=torch.empty_like(f);nw=f.numel()//8;wpr=z//8;nr=b*64*q;a=torch.cuda.Event(enable_timing=True);e=torch.cuda.Event(enable_timing=True)\n cfgs=[('one',512,0),('two',512,128),('two',512,256),('two',512,512),('two',512,1024),('one',256,0),('two',256,256)]\n for mode,mb,fb in cfgs:\n  mg=(triton.cdiv(nw,mb),)\n  def launch():\n   if mode=='one': kernel._prepare_masks_flat_packed64_kernel[mg](f,s,nw,q,wpr,p,BLOCK=mb,num_warps=8 if mb==512 else 4,num_stages=1)\n   else:\n    kernel._prepare_masks_flat_coarse_kernel[mg](f,s,nw,q,wpr,p,BLOCK=mb,num_warps=8 if mb==512 else 4,num_stages=1)\n    kernel._fix_mask_boundary_kernel[(triton.cdiv(nr,fb),)](f,nr,q,wpr,p,BLOCK=fb,num_warps=8 if fb>=512 else (4 if fb>=256 else 2),num_stages=1)\n  launch();torch.cuda.synchronize();ts=[]\n  for _ in range(8):a.record();launch();e.record();e.synchronize();ts.append(a.elapsed_time(e))\n  vals=ts[3:];print(args,(mode,mb,fb),vals,sorted(vals)[2])\n del f,s;gc.collect();torch.cuda.empty_cache()\nbench((8,1024,1024))\nbench((16,2048,0))\nbench((32,256,128))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
