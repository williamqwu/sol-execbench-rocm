{"type":"item.started","item":{"id":"item_8","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch\nimport triton\nimport kernel\n\nfor b in (7, 539, 14521):\n    x = torch.randn((b, 512), device='cuda', dtype=torch.bfloat16)\n    w = torch.randn((512,), device='cuda', dtype=torch.bfloat16)\n    ref = ((x.float() * torch.rsqrt(x.float().pow(2).mean(-1, keepdim=True) + 1e-6)) * w.float()).bfloat16()\n    out = torch.empty_like(x)\n    p = min(b, 1024)\n    kernel._rmsnorm_kernel[(p,)](x, w, out, n_rows=b, n_programs=p, num_warps=4)\n    torch.cuda.synchronize()\n    print('correct', b, torch.equal(out, ref), (out.float() - ref.float()).abs().max().item())\n\nb = 14521\nx = torch.randn((b, 512), device='cuda', dtype=torch.bfloat16)\nw = torch.randn((512,), device='cuda', dtype=torch.bfloat16)\nout = torch.empty_like(x)\nfor nw in (2, 4, 8):\n    for cap in (256, 512, 768, 1024, 1536, 2048, 4096, b):\n        p = min(b, cap)\n        fn = lambda p=p, nw=nw: kernel._rmsnorm_kernel[(p,)](x, w, out, n_rows=b, n_programs=p, num_warps=nw)\n        ms = triton.testing.do_bench(fn, warmup=20, rep=100)\n        print('bench', nw, p, f'{ms:.6f}')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
