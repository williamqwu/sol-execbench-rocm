{"type":"item.started","item":{"id":"item_10","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch\nimport triton\nimport kernel\n\ntorch.manual_seed(1)\nfor b in (11949, 14521):\n    x = torch.randn((b, 512), device='cuda', dtype=torch.bfloat16)\n    w = torch.randn((512,), device='cuda', dtype=torch.bfloat16)\n    out = torch.empty_like(x)\n    print('shape', b)\n    for nw in (1, 2):\n        for cap in (2048, 2560, 3072, 3584, 4096, 5120, 6144, 8192, b):\n            p = min(b, cap)\n            fn = lambda p=p, nw=nw: kernel._rmsnorm_kernel[(p,)](x, w, out, n_rows=b, n_programs=p, num_warps=nw)\n            ms = triton.testing.do_bench(fn, warmup=30, rep=200)\n            print(nw, p, f'{ms:.6f}')\n\nprint('small shapes')\nfor b in (1, 7, 18, 32, 64, 539):\n    x = torch.randn((b, 512), device='cuda', dtype=torch.bfloat16)\n    w = torch.randn((512,), device='cuda', dtype=torch.bfloat16)\n    out = torch.empty_like(x)\n    vals=[]\n    for nw in (1, 2, 4):\n        fn = lambda nw=nw: kernel._rmsnorm_kernel[(b,)](x, w, out, n_rows=b, n_programs=b, num_warps=nw)\n        vals.append(triton.testing.do_bench(fn, warmup=30, rep=200))\n    print(b, *(f'{v:.6f}' for v in vals))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
