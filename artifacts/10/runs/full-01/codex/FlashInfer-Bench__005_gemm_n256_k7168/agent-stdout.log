{"type":"item.started","item":{"id":"item_47","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch,triton\nimport kernel\n\ntorch.manual_seed(8)\nB=torch.randn((256,7168),device='cuda',dtype=torch.float16)\nfor M in (4,14,16,32,58,80):\n A=torch.randn((M,7168),device='cuda',dtype=torch.float16)\n R=A@B.T\n if M<=16: cfg=(14,16,16,256,4,1)\n else: cfg=(7,32,16,256,4,2)\n s,bm,bn,bk,nw,w=cfg\n C=torch.empty((M,256),device='cuda',dtype=torch.float16)\n def fn():\n  C.zero_()\n  kernel._launch_splitk_atomic(A,B,C,s,bm,bn,bk,nw,w)\n try:\n  fn();torch.cuda.synchronize()\n  ratio=torch.isclose(C,R,atol=.044,rtol=.0009765625).float().mean().item()\n  mx=(C.float()-R.float()).abs().max().item()\n  ms=triton.testing.do_bench(fn,warmup=10,rep=50)\n  C2=fn();torch.cuda.synchronize()\n  ratio2=torch.isclose(C,R,atol=.044,rtol=.0009765625).float().mean().item()\n  print(M,f'{ms:.4f}',f'close={ratio:.5f}/{ratio2:.5f}',f'max={mx}',flush=True)\n except Exception as e:\n  print(M,'ERROR',type(e).__name__,str(e).splitlines()[0],flush=True)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
