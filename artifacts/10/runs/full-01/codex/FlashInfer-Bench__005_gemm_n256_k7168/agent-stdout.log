{"type":"item.started","item":{"id":"item_28","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch,triton\nimport kernel\n\ntorch.manual_seed(5)\nB=torch.randn((256,7168),device='cuda',dtype=torch.float16)\nconfigs=[]\nfor s in (7,8,14,16,28,32):\n for nw in (1,2,4):\n  configs.append((s,16,16,256,nw,1))\nconfigs += [(14,16,16,128,4,1),(14,16,32,256,4,1),(14,16,16,256,4,2),(28,16,16,256,4,2)]\nfor M in (4,14,16):\n A=torch.randn((M,7168),device='cuda',dtype=torch.float16)\n C=torch.empty((M,256),device='cuda',dtype=torch.float16)\n R=torch.matmul(A,B.T)\n ref=triton.testing.do_bench(lambda:torch.matmul(A,B.T),warmup=10,rep=50)\n print(f'--- M={M} ref={ref:.4f}',flush=True)\n for cfg in configs:\n  s,bm,bn,bk,nw,w=cfg\n  P=torch.empty((s,M,256),device='cuda',dtype=torch.float32)\n  try:\n   fn=lambda:kernel._launch_splitk(A,B,C,P,s,bm,bn,bk,nw,w)\n   fn();torch.cuda.synchronize()\n   ratio=torch.isclose(C,R,atol=0.0440,rtol=0.0009765625).float().mean().item()\n   ms=triton.testing.do_bench(fn,warmup=10,rep=50)\n   print(cfg,f'{ms:.4f} close={ratio:.5f}',flush=True)\n  except Exception as e:\n   print(cfg,'ERROR',type(e).__name__,str(e).splitlines()[0],flush=True)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
