{"type":"item.started","item":{"id":"item_48","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch,triton\nimport kernel\nB=torch.randn((256,7168),device='cuda',dtype=torch.float16)\nfor M in (4,16,58,80):\n A=torch.randn((M,7168),device='cuda',dtype=torch.float16)\n C=torch.empty((M,256),device='cuda',dtype=torch.float16)\n s,bm,bn,bk,w = ((14,16,16,256,1) if M<=16 else (7,32,16,256,2))\n P=torch.empty((s,M,256),device='cuda',dtype=torch.float32)\n grid=(s*triton.cdiv(M,bm)*triton.cdiv(256,bn),)\n def first():\n  kernel._splitk_gemm_kernel[grid](A,B,P,M=M,TOTAL_N=256,TOTAL_K=7168,SPLIT_K=s,ATOMIC=False,BLOCK_M=bm,BLOCK_N=bn,BLOCK_K=bk,num_warps=4,num_stages=1,waves_per_eu=w,matrix_instr_nonkdim=16)\n print('---',M,flush=True)\n for bs in (128,256,512,1024,2048,4096):\n  for nw in (1,2,4,8):\n   if bs<64*nw: continue\n   try:\n    def fn():\n     first()\n     kernel._splitk_reduce_kernel[(triton.cdiv(M*256,bs),)](P,C,NUMEL=M*256,SPLIT_K=s,BLOCK_SIZE=bs,num_warps=nw)\n    ms=triton.testing.do_bench(fn,warmup=10,rep=50)\n    print(bs,nw,f'{ms:.5f}',flush=True)\n   except Exception as e:\n    print(bs,nw,'ERROR',type(e).__name__,str(e).splitlines()[0],flush=True)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
