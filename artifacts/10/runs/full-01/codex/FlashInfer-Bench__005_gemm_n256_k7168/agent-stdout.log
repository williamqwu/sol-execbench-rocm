{"type":"item.started","item":{"id":"item_22","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch,triton\nimport kernel\n\ntorch.manual_seed(3)\nB=torch.randn((256,7168),device='cuda',dtype=torch.float16)\nconfigs=[(1,128,4),(1,256,4),(2,128,4),(2,256,4),(4,64,4),(4,128,4),(4,256,4),(4,128,8),(4,256,8),(8,64,4),(8,128,4),(8,128,8)]\nfor M,BM in ((1,1),(4,4),(14,16),(16,16)):\n A=torch.randn((M,7168),device='cuda',dtype=torch.float16)\n C=torch.empty((M,256),device='cuda',dtype=torch.float16)\n R=torch.matmul(A,B.T)\n base=triton.testing.do_bench(lambda: torch.matmul(A,B.T),warmup=10,rep=30)\n print(f'--- M={M}, ref={base:.4f}',flush=True)\n for BN,BK,NW in configs:\n  try:\n   def fn():\n    kernel._small_m_kernel[(triton.cdiv(256,BN),)](A,B,C,M=M,TOTAL_N=256,TOTAL_K=7168,BLOCK_M=BM,BLOCK_N=BN,BLOCK_K=BK,num_warps=NW)\n   fn(); torch.cuda.synchronize()\n   close=torch.isclose(C,R,atol=0.0442,rtol=0.0009765625).float().mean().item()\n   mx=(C.float()-R.float()).abs().max().item()\n   ms=triton.testing.do_bench(fn,warmup=10,rep=30)\n   print((BN,BK,NW),f'{ms:.4f} close={close:.5f} max={mx:.4f}',flush=True)\n  except Exception as e:\n   print((BN,BK,NW),'ERROR',type(e).__name__,str(e).splitlines()[0],flush=True)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
