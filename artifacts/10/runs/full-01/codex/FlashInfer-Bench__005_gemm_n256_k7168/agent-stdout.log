{"type":"item.started","item":{"id":"item_52","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch,triton\nimport kernel\nB=torch.randn((256,7168),device='cuda',dtype=torch.float16)\nfor M in (4,14,16,32):\n A=torch.randn((M,7168),device='cuda',dtype=torch.float16)\n C=torch.empty((M,256),device='cuda',dtype=torch.float16)\n print('---',M,flush=True)\n configs=[]\n if M<=16:\n  for s in (8,14,16):\n   for ns in (1,2,3,4): configs.append((s,16,16,256,4,1,ns))\n else:\n  for s in (7,8,14):\n   for ns in (1,2,3,4): configs.append((s,32,16,256,4,2,ns))\n for s,bm,bn,bk,nw,w,ns in configs:\n  P=torch.empty((s,M,256),device='cuda',dtype=torch.float32)\n  grid=(s*triton.cdiv(M,bm)*triton.cdiv(256,bn),)\n  try:\n   def fn():\n    kernel._splitk_gemm_kernel[grid](A,B,P,M=M,TOTAL_N=256,TOTAL_K=7168,SPLIT_K=s,ATOMIC=False,N_MAJOR=False,BLOCK_M=bm,BLOCK_N=bn,BLOCK_K=bk,num_warps=nw,num_stages=ns,waves_per_eu=w,matrix_instr_nonkdim=16)\n    kernel._splitk_reduce_kernel[(triton.cdiv(M*256,256),)](P,C,NUMEL=M*256,SPLIT_K=s,BLOCK_SIZE=256,num_warps=1)\n   ms=triton.testing.do_bench(fn,warmup=10,rep=80)\n   print((s,ns),f'{ms:.5f}',flush=True)\n  except Exception as e:\n   print((s,ns),'ERROR',type(e).__name__,str(e).splitlines()[0],flush=True)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
