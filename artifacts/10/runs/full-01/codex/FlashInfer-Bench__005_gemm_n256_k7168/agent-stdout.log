{"type":"item.started","item":{"id":"item_13","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch\nimport triton\nimport kernel\n\ntorch.manual_seed(0)\nB = torch.randn((256, 7168), device='cuda', dtype=torch.float16)\nfor M in (1, 4, 16, 32, 58, 80, 901, 11948, 14104):\n    A = torch.randn((M, 7168), device='cuda', dtype=torch.float16)\n    try:\n        C = kernel.run(A, B)\n        R = torch.matmul(A, B.T)\n        torch.cuda.synchronize()\n        d = (C.float() - R.float()).abs()\n        close = torch.isclose(C, R, atol=0.0442, rtol=0.0009765625).float().mean().item()\n        ours = triton.testing.do_bench(lambda: kernel.run(A, B), warmup=20, rep=50)\n        ref = triton.testing.do_bench(lambda: torch.matmul(A, B.T), warmup=20, rep=50)\n        print(f'M={M:5d} max={d.max().item():.6f} close={close:.6f} ours={ours:.4f} ref={ref:.4f} speedup={ref/ours:.2f}')\n    except Exception as e:\n        print(f'M={M} ERROR {type(e).__name__}: {e}')\n        raise\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
