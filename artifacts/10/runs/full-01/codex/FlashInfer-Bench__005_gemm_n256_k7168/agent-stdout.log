{"type":"item.started","item":{"id":"item_26","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch,triton\nimport kernel\n\ntorch.manual_seed(4)\nB=torch.randn((256,7168),device='cuda',dtype=torch.float16)\nfor M in (14,16,32,58,80):\n A=torch.randn((M,7168),device='cuda',dtype=torch.float16)\n C=torch.empty((M,256),device='cuda',dtype=torch.float16)\n R=torch.matmul(A,B.T)\n configs=[\n  (4,16,16,256,4,1),(7,16,16,256,4,1),(8,16,16,256,4,1),(14,16,16,256,4,1),\n  (7,16,16,128,4,1),(7,16,32,256,4,1),\n ]\n if M>=32:\n  configs += [(7,32,16,256,4,1),(8,32,16,256,4,1),(7,32,32,128,4,1)]\n ref=triton.testing.do_bench(lambda: torch.matmul(A,B.T),warmup=10,rep=30)\n print(f'--- M={M} ref={ref:.4f}',flush=True)\n for s,bm,bn,bk,nw,w in configs:\n  P=torch.empty((s,M,256),device='cuda',dtype=torch.float32)\n  try:\n   fn=lambda: kernel._launch_splitk(A,B,C,P,s,bm,bn,bk,nw,w)\n   fn(); torch.cuda.synchronize()\n   close=torch.isclose(C,R,atol=0.0442,rtol=0.0009765625).float().mean().item()\n   mx=(C.float()-R.float()).abs().max().item()\n   ms=triton.testing.do_bench(fn,warmup=10,rep=30)\n   print((s,bm,bn,bk,nw,w),f'{ms:.4f} close={close:.5f} max={mx:.4f}',flush=True)\n  except Exception as e:\n   print((s,bm,bn,bk,nw,w),'ERROR',type(e).__name__,str(e).splitlines()[0],flush=True)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
