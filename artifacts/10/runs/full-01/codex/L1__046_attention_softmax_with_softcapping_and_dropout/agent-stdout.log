{"type":"item.started","item":{"id":"item_15","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch,triton\nimport kernel\nfor b,q,n in [(64,128,128),(16,256,256),(8,512,512),(2,1024,1024),(2,2048,2048),(4,1,853)]:\n x=torch.randn((b,8,q,n),device='cuda',dtype=torch.bfloat16); o=torch.empty_like(x)\n rows=x.numel()//n; bn=triton.next_power_of_2(n); nw=4 if bn<=256 else 8\n def go(fast): kernel._softcap_softmax_kernel[(rows,)](x,o,N_COLS=n,BLOCK_N=bn,USE_FAST=fast,num_warps=nw,num_stages=1)\n go(False);go(True);torch.cuda.synchronize()\n a=triton.testing.do_bench(lambda:go(False),warmup=100,rep=500)\n c=triton.testing.do_bench(lambda:go(True),warmup=100,rep=500)\n print((b,q,n),'tanh',a,'fast',c)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
