{"type":"item.started","item":{"id":"item_22","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch,triton\nimport kernel\ncases=[\n ((64,128,128),[(1,1),(1,2),(1,4),(1,8),(2,1),(2,2),(2,4),(2,8),(4,2),(4,4),(4,8),(8,4),(8,8),(16,8)]),\n ((16,256,256),[(1,2),(1,4),(1,8),(2,2),(2,4),(2,8),(4,4),(4,8),(8,8)]),\n ((8,512,512),[(1,4),(1,8),(2,4),(2,8),(4,8)]),\n ((2,1024,1024),[(1,4),(1,8),(2,8)]),\n ((2,2048,2048),[(1,4),(1,8),(2,8)]),\n ((1,293,293),[(1,4),(1,8),(2,4),(2,8),(4,8)]),\n ((1,691,691),[(1,4),(1,8),(2,8)]),\n ((4,1,853),[(1,4),(1,8),(2,8)]),\n]\nfor (b,q,n),configs in cases:\n x=torch.randn((b,8,q,n),device='cuda',dtype=torch.bfloat16); o=torch.empty_like(x); rows=x.numel()//n; bn=triton.next_power_of_2(n)\n vals=[]\n for bm,nw in configs:\n  def go(): kernel._softcap_softmax_kernel[(triton.cdiv(rows,bm),)](x,o,rows,N_COLS=n,BLOCK_M=bm,BLOCK_N=bn,TANH_MODE=1,num_warps=nw,num_stages=1)\n  try:\n   go();torch.cuda.synchronize(); t=triton.testing.do_bench(go,warmup=30,rep=150)\n   vals.append((round(t,5),bm,nw))\n  except Exception as e: vals.append((999,bm,nw,type(e).__name__))\n print((b,q,n), sorted(vals)[:], flush=True)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
