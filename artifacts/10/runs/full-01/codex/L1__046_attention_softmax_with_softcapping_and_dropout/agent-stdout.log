{"type":"item.started","item":{"id":"item_18","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport json, torch, triton\nimport kernel\nfrom reference import run as ref\nfor i,line in enumerate(open('workload.jsonl')):\n d=json.loads(line); a=d['axes']; t=d['tolerance']; b,q,n=a['batch_size'],a['seq_len_q'],a['seq_len_k']\n torch.manual_seed(5678+i); x=torch.randn((b,8,q,n),device='cuda',dtype=torch.bfloat16)\n y=kernel.run(x); z=ref(x); close=torch.isclose(y,z,atol=t['max_atol'],rtol=t['max_rtol'])\n torch.cuda.synchronize(); print(i,n,float(close.float().mean()),float((y.float()-z.float()).abs().max()))\n del x,y,z,close\nprint('bench exact/poly')\nfor b,q,n in [(64,128,128),(16,256,256),(8,512,512),(2,1024,1024),(2,2048,2048),(4,1,853)]:\n x=torch.randn((b,8,q,n),device='cuda',dtype=torch.bfloat16); o=torch.empty_like(x)\n rows=x.numel()//n; bn=triton.next_power_of_2(n); nw=4 if bn<=256 else 8\n def go(m): kernel._softcap_softmax_kernel[(rows,)](x,o,N_COLS=n,BLOCK_N=bn,TANH_MODE=m,num_warps=nw,num_stages=1)\n go(0);go(1);torch.cuda.synchronize()\n a=triton.testing.do_bench(lambda:go(0),warmup=100,rep=500); c=triton.testing.do_bench(lambda:go(1),warmup=100,rep=500)\n print((b,q,n),a,c)\n del x,o\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
