{"type":"item.started","item":{"id":"item_35","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch,triton\nimport kernel\ncases=[(64,128,128,32,8,3),(16,256,256,8,4,3),(8,512,512,1,1,3),(2,1024,1024,1,1,3),(2,2048,2048,2,1,1),(1,691,691,1,1,3)]\nfor b,q,n,bm,nw,mode in cases:\n rows=b*8*q;bn=triton.next_power_of_2(n);x=torch.randn((b,8,q,n),device='cuda',dtype=torch.bfloat16);o=torch.empty_like(x);vals=[]\n for wpe in [1,2,3,4,0]:\n  def go():\n   kw={} if wpe==0 else {'waves_per_eu':wpe}\n   kernel._softcap_softmax_kernel[(triton.cdiv(rows,bm),)](x,o,rows,N_COLS=n,BLOCK_M=bm,BLOCK_N=bn,TANH_MODE=mode,STABLE=False,num_warps=nw,num_stages=1,**kw)\n  try:\n   go();torch.cuda.synchronize();t=triton.testing.do_bench(go,warmup=100,rep=700);vals.append((round(t,5),wpe))\n  except Exception as e: vals.append((999,wpe,type(e).__name__,str(e)[:50]))\n print((b,q,n),sorted(vals),flush=True)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
