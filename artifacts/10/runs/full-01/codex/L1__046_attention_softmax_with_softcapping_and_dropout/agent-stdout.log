{"type":"item.started","item":{"id":"item_8","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch\nimport kernel\nfrom reference import run as ref\nfor shape in [(4,8,1,853),(1,8,293,293),(1,8,2048,2048)]:\n    torch.manual_seed(0)\n    x=torch.randn(shape,device='cuda',dtype=torch.bfloat16)\n    try:\n        y=kernel.run(x)\n        z=ref(x)\n        torch.cuda.synchronize()\n        d=(y.float()-z.float()).abs()\n        tol=3.82e-6 if shape[-1]==2048 else 2.67e-5 if shape[-1]==293 else 9.18e-6\n        matched=torch.isclose(y.float(),z.float(),atol=tol,rtol=0.0078125).float().mean()\n        print(shape, 'max',d.max().item(),'mean',d.mean().item(),'match',matched.item())\n    except Exception as e:\n        import traceback; traceback.print_exc(); break\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
