{"type":"item.started","item":{"id":"item_13","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport json, torch, triton\nimport kernel\nfrom reference import run as ref\nwork=[]\nfor line in open('workload.jsonl'):\n d=json.loads(line); a=d['axes']; t=d['tolerance']; work.append((a['batch_size'],a['seq_len_q'],a['seq_len_k'],t['max_atol'],t['max_rtol']))\nfor i,(b,q,k,atol,rtol) in enumerate(work):\n torch.manual_seed(1234+i)\n x=torch.randn((b,8,q,k),device='cuda',dtype=torch.bfloat16)\n y=kernel.run(x); z=ref(x)\n close=torch.isclose(y,z,atol=atol,rtol=rtol)\n torch.cuda.synchronize()\n print(i, k, float(close.float().mean()), float((y.float()-z.float()).abs().max()))\n del x,y,z,close\nprint('bench')\nfor b,q,k in [(64,128,128),(16,256,256),(8,512,512),(2,1024,1024),(2,2048,2048),(4,1,853)]:\n x=torch.randn((b,8,q,k),device='cuda',dtype=torch.bfloat16)\n kernel.run(x); torch.cuda.synchronize()\n print((b,q,k), triton.testing.do_bench(lambda: kernel.run(x), warmup=50, rep=200))\n del x\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
