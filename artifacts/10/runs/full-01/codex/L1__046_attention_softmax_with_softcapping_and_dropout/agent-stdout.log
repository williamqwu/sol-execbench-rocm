{"type":"item.started","item":{"id":"item_32","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport json,torch,triton\nimport kernel\nfrom reference import run as ref\nfor i,line in enumerate(open('workload.jsonl')):\n d=json.loads(line);a=d['axes'];t=d['tolerance'];b,q,n=a['batch_size'],a['seq_len_q'],a['seq_len_k'];rows=b*8*q;bn=triton.next_power_of_2(n)\n if n==128: bm,nw=((32,8) if rows>=65536 else (8,4) if rows>=32768 else (16,4))\n elif n==256:bm,nw=((8,4) if rows>=32768 else (4,4))\n elif n==512:bm,nw=((1,1) if rows>=32768 else (4,4))\n elif n==2048:bm,nw=2,1\n else:bm,nw=1,1\n torch.manual_seed(12000+i);x=torch.randn((b,8,q,n),device='cuda',dtype=torch.bfloat16);y=torch.empty_like(x)\n kernel._softcap_softmax_kernel[(triton.cdiv(rows,bm),)](x,y,rows,N_COLS=n,BLOCK_M=bm,BLOCK_N=bn,TANH_MODE=3,STABLE=False,num_warps=nw,num_stages=1)\n z=ref(x);c=torch.isclose(y,z,atol=t['max_atol'],rtol=t['max_rtol']);torch.cuda.synchronize()\n print(i,n,float(c.float().mean()),float((y.float()-z.float()).abs().max()),flush=True)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
