{"type":"item.started","item":{"id":"item_14","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch, kernel\nfrom torch.nn import functional as F\n\ndef cand(go,x,t,qw,qb,kw,kb,vw,vb,ow,ob,scale):\n B,N,D=x.shape; T=t.shape[1]; H=16; d=64\n q=F.linear(x,qw,qb).view(B,N,H,d).transpose(1,2)\n k=F.linear(t,kw,kb).view(B,T,H,d).transpose(1,2)\n v=F.linear(t,vw,vb).view(B,T,H,d).transpose(1,2)\n c,lse,seed,offset=torch.ops.aten._scaled_dot_product_efficient_attention(q,k,v,None,True,0.,False,scale=scale)\n context=c.transpose(1,2).contiguous().view(B,N,D)\n gc=go@ow\n gch=gc.view(B,N,H,d).transpose(1,2)\n dummy=qb[:1].view(1,1,1,1)\n gq,gk,gv,_=torch.ops.aten._scaled_dot_product_efficient_attention_backward(gch,q,k,v,dummy,c,lse,seed,offset,0.,[True,True,True,False],False,scale=scale)\n gq=gq.transpose(1,2).contiguous().view(B,N,D)\n gk=gk.transpose(1,2).contiguous().view(B,T,D)\n gv=gv.transpose(1,2).contiguous().view(B,T,D)\n return (gq@qw, gk@kw+gv@vw, torch.einsum('bnd,bnk->dk',gq,x),gq.sum((0,1)),torch.einsum('bnd,bnk->dk',gk,t),gk.sum((0,1)),torch.einsum('bnd,bnk->dk',gv,t),gv.sum((0,1)),torch.einsum('bnd,bnk->dk',go,context),go.sum((0,1)))\n\ntorch.manual_seed(1)\nB,N,T,D=1,128,77,1024\nfor sig in (0.02,0.1,1.0):\n xs=[torch.randn(sh,device='cuda')*sig for sh in [(B,N,D),(B,N,D),(B,T,D),(D,D),(D),(D,D),(D),(D,D),(D),(D,D),(D)]]\n with torch.no_grad():\n  a=kernel.run(*xs,0.125); b=cand(*xs,0.125)\n torch.cuda.synchronize()\n print('SIG',sig)\n for i,(aa,bb) in enumerate(zip(a,b)):\n  err=(aa-bb).abs(); close=torch.isclose(aa,bb,atol=1.5e-6,rtol=1.1920928955078125e-7)\n  print(i,'max',err.max().item(),'ratio',close.float().mean().item(),'amean',aa.abs().mean().item())\n del xs,a,b\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
