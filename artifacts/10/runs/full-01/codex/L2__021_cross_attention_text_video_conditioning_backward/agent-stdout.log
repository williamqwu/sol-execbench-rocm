{"type":"item.started","item":{"id":"item_35","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY' 2>/dev/null\nimport torch, reference\nfrom torch.nn import functional as F\nstreams=[torch.cuda.Stream() for _ in range(4)]\n@torch.no_grad()\ndef concurrent(go,x,t,qw,qb,kw,kb,vw,vb,ow,ob,scale):\n B,N,D=x.shape; T=t.shape[1]; H=16; d=64; cur=torch.cuda.current_stream()\n for s in streams: s.wait_stream(cur)\n with torch.cuda.stream(streams[0]): q=F.linear(x,qw,qb).view(B,N,H,d).transpose(1,2)\n with torch.cuda.stream(streams[1]): k=F.linear(t,kw,kb).view(B,T,H,d).transpose(1,2)\n with torch.cuda.stream(streams[2]): v=F.linear(t,vw,vb).view(B,T,H,d).transpose(1,2)\n with torch.cuda.stream(streams[3]):\n  gc=go@ow; gob=go.sum((0,1))\n for s in streams: cur.wait_stream(s)\n scores=q@k.transpose(-2,-1)*scale; p=F.softmax(scores,-1,dtype=torch.float32); c=p@v; context=c.transpose(1,2).contiguous().view(B,N,D)\n gch=gc.view(B,N,H,d).transpose(1,2)\n for s in streams[:3]: s.wait_stream(cur)\n with torch.cuda.stream(streams[0]): gp=gch@v.transpose(-2,-1)\n with torch.cuda.stream(streams[1]): gv=p.transpose(-2,-1)@gch\n with torch.cuda.stream(streams[2]): gow=torch.einsum('bnd,bnk->dk',go,context)\n cur.wait_stream(streams[0]); cur.wait_stream(streams[1]); cur.wait_stream(streams[2])\n sm=(gp*p).sum(-1,keepdim=True); gs=p*(gp-sm); gs=gs*scale\n streams[0].wait_stream(cur); streams[1].wait_stream(cur)\n with torch.cuda.stream(streams[0]): gq=gs@k\n with torch.cuda.stream(streams[1]): gk=gs.transpose(-2,-1)@q\n cur.wait_stream(streams[0]); cur.wait_stream(streams[1])\n gq=gq.transpose(1,2).contiguous().view(B,N,D); gk=gk.transpose(1,2).contiguous().view(B,T,D); gv=gv.transpose(1,2).contiguous().view(B,T,D)\n for s in streams[:3]: s.wait_stream(cur)\n with torch.cuda.stream(streams[0]):\n  gx=gq@qw; gqw=torch.einsum('bnd,bnk->dk',gq,x); gqb=gq.sum((0,1))\n with torch.cuda.stream(streams[1]):\n  gtk=gk@kw; gkw=torch.einsum('bnd,bnk->dk',gk,t); gkb=gk.sum((0,1))\n