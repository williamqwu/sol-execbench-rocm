{"type":"item.started","item":{"id":"item_44","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch,triton,kernel\nvariants=[(128,2),(256,4),(512,8),(1024,8)]\nfor B,S in [(1,256),(8,256),(1,3136),(64,128)]:\n q=torch.randn(B,S,24,128,device='cuda');k=torch.randn_like(q)\n ps=[torch.randint(0,16 if i==0 else 56,(S,),device='cuda',dtype=torch.int64) for i in range(3)]\n tabs=[]\n for n in (16,56,56): tabs += [torch.randn(n,42,device='cuda'),torch.randn(n,42,device='cuda')]\n n=B*S*24*3*21; reps=100 if B*S<=2048 else 30\n print('shape',B,S)\n for block,warps in variants:\n  grid=(triton.cdiv(n,block),)\n  args=(q,k,*ps,*tabs,n)\n  for _ in range(5):kernel._rope_qk_kernel[grid](*args,SEQ_LEN=S,BLOCK=block,num_warps=warps,enable_fp_fusion=False)\n  torch.cuda.synchronize();st=torch.cuda.Event(True);en=torch.cuda.Event(True);st.record()\n  for _ in range(reps):kernel._rope_qk_kernel[grid](*args,SEQ_LEN=S,BLOCK=block,num_warps=warps,enable_fp_fusion=False)\n  en.record();en.synchronize();print(block,warps,round(st.elapsed_time(en)*1000/reps,2),'us')\n del q,k,ps,tabs;torch.cuda.empty_cache()\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
