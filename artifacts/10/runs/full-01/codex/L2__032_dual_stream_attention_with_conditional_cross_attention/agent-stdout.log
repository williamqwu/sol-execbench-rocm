"to_v_weight\": {\n      \"shape\": [\n        \"hidden_size\",\n        \"hidden_size\"\n      ],\n      \"dtype\": \"float32\",\n      \"description\": \"Value projection weight\"\n    },\n    \"to_v_bias\": {\n      \"shape\": [\n        \"hidden_size\"\n      ],\n      \"dtype\": \"float32\",\n      \"description\": \"Value projection bias\"\n    },\n    \"to_k_context_weight\": {\n      \"shape\": [\n        \"hidden_size\",\n        \"joint_attention_dim\"\n      ],\n      \"dtype\": \"float32\",\n      \"description\": \"Context key projection weight\"\n    },\n    \"to_k_context_bias\": {\n      \"shape\": [\n        \"hidden_size\"\n      ],\n      \"dtype\": \"float32\",\n      \"description\": \"Context key projection bias\"\n    },\n    \"to_v_context_weight\": {\n      \"shape\": [\n        \"hidden_size\",\n        \"joint_attention_dim\"\n      ],\n      \"dtype\": \"float32\",\n      \"description\": \"Context value projection weight\"\n    },\n    \"to_v_context_bias\": {\n      \"shape\": [\n        \"hidden_size\"\n      ],\n      \"dtype\": \"float32\",\n      \"description\": \"Context value projection bias\"\n    },\n    \"to_out_weight\": {\n      \"shape\": [\n        \"hidden_size\",\n        \"hidden_size\"\n      ],\n      \"dtype\": \"float32\",\n      \"description\": \"Output projection weight\"\n    },\n    \"to_out_bias\": {\n      \"shape\": [\n        \"hidden_size\"\n      ],\n      \"dtype\": \"float32\",\n      \"description\": \"Output projection bias\"\n    },\n    \"pos_idx_axis0\": {\n      \"shape\": [\n        \"seq_len\"\n      ],\n      \"dtype\": \"int64\",\n      \"description\": \"Position indices for RoPE axis 0\"\n    },\n    \"pos_idx_axis1\": {\n      \"shape\": [\n        \"seq_len\"\n      ],\n      \"dtype\": \"int64\",\n      \"description\": \"Position indices for RoPE axis 1\"\n    },\n    \"pos_idx_axis2\": {\n      \"shape\": [\n        \"seq_len\"\n      ],\n      \"dtype\": \"int64\",\n      \"description