{"type":"item.started","item":{"id":"item_41","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch,triton,kernel\nshapes=[(1,256),(1,512),(1,613),(1,997),(1,1973),(1,3136),(2,256),(2,2048),(4,512),(4,541),(4,1024),(8,256),(32,256),(64,128)]\nfor B,S in shapes:\n x=torch.randn(B,24,S,128,device='cuda');n=B*S*3072\n def eager(): return x.transpose(1,2).contiguous().view(B,S,3072)\n def tri():\n  o=torch.empty((B,S,3072),device='cuda');kernel._attention_transpose_kernel[(triton.cdiv(n,256),)](x,o,n,SEQ_LEN=S,BLOCK=256,num_warps=4);return o\n for f in (eager,tri):\n  for _ in range(5):f()\n  torch.cuda.synchronize();st=torch.cuda.Event(True);en=torch.cuda.Event(True);st.record()\n  for _ in range(100):f()\n  en.record();en.synchronize();t=st.elapsed_time(en)/100\n  print(B,S,f.__name__,round(t*1000,2),'us')\n del x;torch.cuda.empty_cache()\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
