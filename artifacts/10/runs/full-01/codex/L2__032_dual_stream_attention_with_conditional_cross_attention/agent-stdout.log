= offsets % 3072\n   155\t    batch = offsets // (SEQ_LEN * 3072)\n   156\t    attn = tl.load(attn_ptr + offsets, mask=mask)\n   157\t    residual = tl.load(residual_ptr + offsets, mask=mask)\n   158\t    gate = tl.load(gate_ptr + batch * 18432 + dim, mask=mask)\n   159\t    gated = gate * attn\n   160\t    tl.store(attn_ptr + offsets, residual + gated, mask=mask)\n   161\t\n   162\t\n   163\t@triton.jit\n   164\tdef _concat_context_kv_kernel(\n   165\t    k_image_ptr,\n   166\t    k_context_ptr,\n   167\t    v_image_ptr,\n   168\t    v_context_ptr,\n   169\t    k_out_ptr,\n   170\t    v_out_ptr,\n   171\t    n_elements,\n   172\t    IMAGE_LEN: tl.constexpr,\n   173\t    CONTEXT_LEN: tl.constexpr,\n   174\t    TOTAL_LEN: tl.constexpr,\n   175\t    BLOCK: tl.constexpr,\n   176\t):\n   177\t    offsets = tl.program_id(0) * BLOCK + tl.arange(0, BLOCK)\n   178\t    valid = offsets < n_elements\n   179\t    dim = offsets % 3072\n   180\t    work = offsets // 3072\n   181\t    pos = work % TOTAL_LEN\n   182\t    batch = work // TOTAL_LEN\n   183\t    from_image = pos < IMAGE_LEN\n   184\t    image_offset = (batch * IMAGE_LEN + pos) * 3072 + dim\n   185\t    context_offset = (batch * CONTEXT_LEN + pos - IMAGE_LEN) * 3072 + dim\n   186\t    k_image = tl.load(\n   187\t        k_image_ptr + image_offset, mask=valid & from_image, other=0.0\n   188\t    )\n   189\t    v_image = tl.load(\n   190\t        v_image_ptr + image_offset, mask=valid & from_image, other=0.0\n   191\t    )\n   192\t    k_context = tl.load(\n   193\t        k_context_ptr + context_offset, mask=valid & ~from_image, other=0.0\n   194\t    )\n   195\t    v_context = tl.load(\n   196\t        v_context_ptr + context_offset, mask=valid & ~from_image, other=0.0\n   197\t    )\n   198\t    tl.store(k_out_ptr + offsets, tl.where(from_image, k_image, k_context), mask=valid)\n   199\t    tl.store(v_out_ptr + offsets, tl.where(from_image, v_image, v_context), mask=valid)\n   200\t\n   201\t\n   202\t@torch.no_grad(