{"type":"item.completed","item":{"id":"item_11","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,170p' kernel.py && python -m py_compile kernel.py\"","aggregated_output":"import math\n\nimport torch\nimport torch.nn.functional as F\n\n\ndef _apply_rope_axis(x_part, cos_gathered, sin_gathered):\n    half_dim = x_part.shape[-1] // 2\n    x_first = x_part[..., :half_dim]\n    x_second = x_part[..., half_dim:]\n    cos_first = cos_gathered[..., :half_dim]\n    sin_first = sin_gathered[..., :half_dim]\n    rotated_first = x_first * cos_first - x_second * sin_first\n    rotated_second = x_first * sin_first + x_second * cos_first\n    return torch.cat((rotated_first, rotated_second), dim=-1)\n\n\n@torch.no_grad()\ndef run(\n    hidden_states,\n    timestep_embedding,\n    encoder_hidden_states,\n    adaln_linear_weight,\n    adaln_linear_bias,\n    to_q_weight,\n    to_q_bias,\n    to_k_weight,\n    to_k_bias,\n    to_v_weight,\n    to_v_bias,\n    to_k_context_weight,\n    to_k_context_bias,\n    to_v_context_weight,\n    to_v_context_bias,\n    to_out_weight,\n    to_out_bias,\n    pos_idx_axis0,\n    pos_idx_axis1,\n    pos_idx_axis2,\n    rope_cos_axis0,\n    rope_sin_axis0,\n    rope_cos_axis1,\n    rope_sin_axis1,\n    rope_cos_axis2,\n    rope_sin_axis2,\n    is_joint_block,\n):\n    batch, seq_len, hidden_size = hidden_states.shape\n    num_heads = 24\n    head_dim = 128\n    rope_dim_per_axis = 42\n    residual = hidden_states\n\n    timestep_activated = timestep_embedding * torch.sigmoid(timestep_embedding)\n    modulation = F.linear(\n        timestep_activated, adaln_linear_weight, adaln_linear_bias\n    )\n    scale_msa, shift_msa, gate_msa, _, _, _ = modulation.chunk(6, dim=-1)\n\n    hidden_states_normalized = F.layer_norm(hidden_states, (hidden_size,))\n    hidden_states_modulated = (\n        hidden_states_normalized * (1 + scale_msa.unsqueeze(1))\n        + shift_msa.unsqueeze(1)\n    )\n\n    q = F.linear(hidden_states_modulated, to_q_weight, to_q_bias)\n    k = F.linear(hidden_states_modulated, to_k_weight, to_k_bias)\n    v = F.linear(hidden_states_modulated, to_v_weight, to_v_bias)\n    q = q.view(batch, seq_len, num_heads, head_dim)\n    k = k.view(batch, seq_len, num_heads, head_dim)\n    v = v.view(batch, seq_len, num_heads, head_dim)\n\n    cos0 = rope_cos_axis0[pos_idx_axis0].unsqueeze(0).unsqueeze(2)\n    sin0 = rope_sin_axis0[pos_idx_axis0].unsqueeze(0).unsqueeze(2)\n    cos1 = rope_cos_axis1[pos_idx_axis1].unsqueeze(0).unsqueeze(2)\n    sin1 = rope_sin_axis1[pos_idx_axis1].unsqueeze(0).unsqueeze(2)\n    cos2 = rope_cos_axis2[pos_idx_axis2].unsqueeze(0).unsqueeze(2)\n    sin2 = rope_sin_axis2[pos_idx_axis2].unsqueeze(0).unsqueeze(2)\n\n    q_axis0_rot = _apply_rope_axis(q[..., :rope_dim_per_axis], cos0, sin0)\n    q_axis1_rot = _apply_rope_axis(\n        q[..., rope_dim_per_axis : 2 * rope_dim_per_axis],\n        cos1,\n        sin1,\n    )\n    q_axis2_rot = _apply_rope_axis(\n        q[..., 2 * rope_dim_per_axis : 3 * rope_dim_per_axis],\n        cos2,\n        sin2,\n    )\n    k_axis0_rot = _apply_rope_axis(\n        k[..., :rope_dim_per_axis], cos0, sin0\n    )\n    k_axis1_rot = _apply_rope_axis(\n        k[..., rope_dim_per_axis : 2 * rope_dim_per_axis],\n        cos1,\n        sin1,\n    )\n    k_axis2_rot = _apply_rope_axis(\n        k[..., 2 * rope_dim_per_axis : 3 * rope_dim_per_axis],\n        cos2,\n        sin2,\n    )\n    q = torch.cat(\n        (q_axis0_rot, q_axis1_rot, q_axis2_rot, q[..., 3 * rope_dim_per_axis :]),\n        dim=-1,\n    )\n    k = torch.cat(\n        (k_axis0_rot, k_axis1_rot, k_axis2_rot, k[..., 3 * rope_dim_per_axis :]),\n        dim=-1,\n    )\n\n    if is_joint_block == 1:\n        text_seq_len = encoder_hidden_states.shape[1]\n        encoder_hidden_states_normalized = F.layer_norm(\n            encoder_hidden_states, (4096,)\n        )\n        k_context = F.linear(\n            encoder_hidden_states_normalized,\n            to_k_context_weight,\n            to_k_context_bias,\n        ).view(batch, text_seq_len, num_heads, head_dim)\n        v_context = F.linear(\n            encoder_hidden_states_normalized,\n            to_v_context_weight,\n            to_v_context_bias,\n        ).view(batch, text_seq_len, num_heads, head_dim)\n        k = torch.cat((k, k_context), dim=1)\n        v = torch.cat((v, v_context), dim=1)\n\n    q = q.transpose(1, 2)\n    k = k.transpose(1, 2)\n    v = v.transpose(1, 2)\n    attn_scores = torch.matmul(q, k.transpose(-2, -1)) * (1.0 / math.sqrt(128))\n    attn_probs = F.softmax(attn_scores, dim=-1)\n    attn_output = torch.matmul(attn_probs, v)\n    attn_output = (\n        attn_output.transpose(1, 2)\n        .contiguous()\n        .view(batch, seq_len, hidden_size)\n    )\n    attn_output = F.linear(attn_output, to_out_weight, to_out_bias)\n    return residual + gate_msa.unsqueeze(1) * attn_output\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_12","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch, reference, kernel\nfor axes in [\n {'batch_size':1,'seq_len':256,'text_seq_len':64,'is_joint_block':0},\n {'batch_size':8,'seq_len':256,'text_seq_len':64,'is_joint_block':1},\n]:\n torch.manual_seed(321); a=reference.get_inputs(axes,torch.device('cuda:0')); x=list(a.values())\n r=reference.run(*x); g=kernel.run(*x); torch.cuda.synchronize(); d=(g-r).abs()\n print(axes, 'max',d.max().item(),'exact',(d==0).float().mean().item())\n for f in [reference.run,kernel.run]:\n  for _ in range(5): f(*x)\n  torch.cuda.synchronize(); times=[]\n  for _ in range(5):\n   s=torch.cuda.Event(True); e=torch.cuda.Event(True); s.record()\n   for i in range(20): f(*x)\n   e.record();e.synchronize();times.append(s.elapsed_time(e)/20)\n  print(f.__module__, times)\n del a,x,r,g,d;torch.cuda.empty_cache()\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
