{"type":"item.started","item":{"id":"item_8","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch, torch.nn.functional as F\nfrom reference import run as ref\n\ntorch.manual_seed(1)\nd='cuda'\nB,S=2,128\n# Test realistic small initialization and two mask styles.\nh=torch.randn(B,S,4096,device=d,dtype=torch.bfloat16)*0.02\nweights=[torch.randn(m,4096,device=d,dtype=torch.bfloat16)*0.02 for m in (4096,1024,1024,4096)]\ncos=torch.randn(B,S,128,device=d,dtype=torch.bfloat16)\nsin=torch.randn(B,S,128,device=d,dtype=torch.bfloat16)\nqn=torch.randn(128,device=d,dtype=torch.bfloat16)*0.02\nkn=torch.randn(128,device=d,dtype=torch.bfloat16)*0.02\n\ndef cand(mask):\n q=F.linear(h,weights[0]).view(B,S,32,128); k=F.linear(h,weights[1]).view(B,S,8,128); v=F.linear(h,weights[2]).view(B,S,8,128)\n qf=q.float(); kf=k.float()\n q=qn*(qf*torch.rsqrt(qf.square().mean(-1,keepdim=True)+1e-6)).bfloat16()\n k=kn*(kf*torch.rsqrt(kf.square().mean(-1,keepdim=True)+1e-6)).bfloat16()\n q=q.transpose(1,2);k=k.transpose(1,2);v=v.transpose(1,2); c=cos[:,None];s=sin[:,None]\n q=q*c+torch.cat((-q[...,64:],q[...,:64]),-1)*s\n k=k*c+torch.cat((-k[...,64:],k[...,:64]),-1)*s\n x=F.scaled_dot_product_attention(q,k,v,attn_mask=mask,dropout_p=0.0,scale=0.08838834764831843,enable_gqa=True)\n return F.linear(x.transpose(1,2).contiguous().reshape(B,S,4096),weights[3])\nfor kind in ('random','causal'):\n if kind=='random': mask=torch.randn(B,1,S,S,device=d,dtype=torch.bfloat16)*0.02\n else:\n  mask=torch.zeros(B,1,S,S,device=d,dtype=torch.bfloat16).masked_fill(torch.ones(S,S,device=d,dtype=torch.bool).triu(1),float('-inf'))\n a=ref(h,cos,sin,mask,*weights,qn,kn,1e-6,0.08838834764831843)\n b=cand(mask)\n diff=(a.float()-b.float()).abs(); rel=diff/a.float().abs().clamp_min(1e-30)\n ok=(diff<=0.0022441483)|(rel<=0.0078125)\n print(kind,'maxabs',diff.max().item(),'mean',diff.mean().item(),'maxrel',rel.max().item(),'match',ok.float().mean().item(),'exact',(a==b).float().mean().item())\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
