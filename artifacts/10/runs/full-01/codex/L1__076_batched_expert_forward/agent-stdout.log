{"type":"item.started","item":{"id":"item_11","type":"command_execution","command":"/bin/bash -lc 'TORCHINDUCTOR_CACHE_DIR=\"$PWD/.torchinductor\" TRITON_CACHE_DIR=\"$PWD/.triton\" python3 - <<'\"'PY'\nimport torch, time\nprint(torch.__version__)\nprint(torch.cuda.get_device_name(0))\ntorch.manual_seed(1)\ndevice='cuda'\nE,T,H,D=4,32,2880,2880\nx=torch.randn(T,H,device=device)*0.01\nw1=torch.randn(E,H,2*D,device=device)*0.01\nb1=torch.randn(E,2*D,device=device)*0.01\nw2=torch.randn(E,D,H,device=device)*0.01\nb2=torch.randn(E,H,device=device)*0.01\nr=torch.randn(T,E,device=device)*0.01\nalpha=1.702; limit=7.0\n\ndef eager(x,r,w1,b1,w2,b2):\n    xb=x.repeat(E,1).view(E,-1,H)\n    gu=torch.bmm(xb,w1)\n    gu=gu+b1[:,None,:]\n    g=gu[...,::2].clamp(max=limit)\n    u=gu[...,1::2].clamp(-limit,limit)\n    go=(u+1)*(g*torch.sigmoid(g*alpha))\n    eo=torch.bmm(go,w2)\n    eo=eo+b2[:,None,:]\n    return (eo*r.T[:,:,None]).sum(0)\n\ndef expand(x,r,w1,b1,w2,b2):\n    xb=x[None,:,:].expand(E,-1,-1)\n    gu=torch.bmm(xb,w1)\n    gu=gu+b1[:,None,:]\n    g=gu[...,::2].clamp(max=limit)\n    u=gu[...,1::2].clamp(-limit,limit)\n    go=(u+1)*(g*torch.sigmoid(g*alpha))\n    eo=torch.bmm(go,w2)\n    eo=eo+b2[:,None,:]\n    return (eo*r.T[:,:,None]).sum(0)\n\ndef badd(x,r,w1,b1,w2,b2):\n    xb=x[None,:,:].expand(E,-1,-1)\n    gu=torch.baddbmm(b1[:,None,:],xb,w1)\n    g=gu[...,::2].clamp(max=limit)\n    u=gu[...,1::2].clamp(-limit,limit)\n    go=(u+1)*(g*torch.sigmoid(g*alpha))\n    eo=torch.baddbmm(b2[:,None,:],go,w2)\n    return (eo*r.T[:,:,None]).sum(0)\n\nref=eager(x,r,w1,b1,w2,b2)\nfor name,fn in [('expand',expand),('badd',badd)]:\n    try:\n        y=fn(x,r,w1,b1,w2,b2)\n        torch.cuda.synchronize()\n        d=(y-ref).abs()\n        print(name,'max',d.max().item(),'neq',(d\"'!=0).float().mean().item())\n        for _ in range(3): fn(x,r,w1,b1,w2,b2)\n        torch.cuda.synchronize(); s=time.perf_counter()\n        for _ in range(10): fn(x,r,w1,b1,w2,b2)\n        torch.cuda.synchronize(); print(name,'\"'ms',(time.perf_counter()-s)*100)\n    except Exception as ex: print(name,'ERROR',repr(ex))\nfor name,fn in [('eager',eager)]:\n    for _ in range(3): fn(x,r,w1,b1,w2,b2)\n    torch.cuda.synchronize(); s=time.perf_counter()\n    for _ in range(10): fn(x,r,w1,b1,w2,b2)\n    torch.cuda.synchronize(); print(name,'ms',(time.perf_counter()-s)*100)\ntry:\n    comp=torch.compile(expand, fullgraph=True, dynamic=False)\n    y=comp(x,r,w1,b1,w2,b2); torch.cuda.synchronize()\n    d=(y-ref).abs(); print('compile max',d.max().item(),'neq',(d\"'!=0).float().mean().item())\n    for _ in range(3): comp(x,r,w1,b1,w2,b2)\n    torch.cuda.synchronize(); s=time.perf_counter()\n    for _ in range(10): comp(x,r,w1,b1,w2,b2)\n    torch.cuda.synchronize(); print('\"'compile ms',(time.perf_counter()-s)*100)\nexcept Exception as ex: print('compile ERROR',repr(ex))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
