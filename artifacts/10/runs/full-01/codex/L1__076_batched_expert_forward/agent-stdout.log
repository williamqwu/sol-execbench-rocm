{"type":"item.completed","item":{"id":"item_13","type":"agent_message","text":"The safe compiled path is 14/14-equivalent on a full 128-expert synthetic case and about 6% faster. I’m now checking the one route that could materially beat the FP32 ceiling on this GPU: compensated BF16 GEMMs with float32 outputs. This preserves float32 information through high/residual components; the test will tell us whether its accumulated error can meet the one-ULP-style tolerance before it ever reaches `./verify`."}}
{"type":"item.started","item":{"id":"item_14","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport torch,time\nE,T,K,N=128,128,2880,5760\nprint('alloc')\nA=torch.empty((E,T,K),device='cuda').uniform_(-.01,.01)\nB=torch.empty((E,K,N),device='cuda').uniform_(-.01,.01)\nprint('ref')\nC=torch.bmm(A,B); torch.cuda.synchronize()\n\ndef mm(a,b): return torch.bmm(a,b,out_dtype=torch.float32)\ntry:\n    a0=A.to(torch.bfloat16); b0=B.to(torch.bfloat16)\n    C0=mm(a0,b0); torch.cuda.synchronize()\n    print('bf16 error', (C0-C).abs().max().item(), ((C0-C).abs()/(C.abs()+1e-30)).median().item())\n    for _ in range(3): mm(a0,b0)\n    torch.cuda.synchronize(); s=time.perf_counter()\n    for _ in range(10): mm(a0,b0)\n    torch.cuda.synchronize(); print('bf16 cached ms',(time.perf_counter()-s)*100)\nexcept Exception as ex:\n    print('bf16 ERROR',repr(ex)); raise SystemExit\n\ndef split3(x):\n    x0=x.to(torch.bfloat16)\n    r=x-x0\n    x1=r.to(torch.bfloat16)\n    x2=(r-x1).to(torch.bfloat16)\n    return x0,x1,x2\nprint('split')\na0,a1,a2=split3(A); b0,b1,b2=split3(B)\nprint('six')\n# Diagonal groups, accumulate small to large to retain lows.\nt2=mm(a0,b2)+mm(a1,b1)+mm(a2,b0)\nt1=mm(a0,b1)+mm(a1,b0)\ny6=t2+t1\ny6.add_(mm(a0,b0))\ntorch.cuda.synchronize()\nd=(y6-C).abs(); allow=2.8e-8+1.1920928955078125e-7*C.abs()\nprint('six max',d.max().item(),'mean',d.mean().item(),'matched',(d<=allow).float().mean().item(),'relmed',(d/(C.abs()+1e-30)).median().item(),'Cmax',C.abs().max().item())\nprint('nine')\nt3=mm(a1,b2)+mm(a2,b1)+mm(a2,b2)\ny9=t3+t2\ny9.add_(t1); y9.add_(mm(a0,b0)); torch.cuda.synchronize()\nd=(y9-C).abs(); print('nine max',d.max().item(),'mean',d.mean().item(),'matched',(d<=allow).float().mean().item(),'relmed',(d/(C.abs()+1e-30)).median().item())\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
