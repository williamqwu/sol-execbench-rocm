{"type":"item.started","item":{"id":"item_16","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch, torch.nn.functional as F, time\n\ndef base(x,w1,b1,w2,b2): return F.conv2d(F.conv2d(x,w1,b1,padding=1),w2,b2,padding=1)+x\ndef inp(x,w1,b1,w2,b2):\n y=F.conv2d(F.conv2d(x,w1,b1,padding=1),w2,b2,padding=1)\n return y.add_(x)\n\ndef fn(x,w1,b1,w2,b2): return F.conv2d(F.conv2d(x,w1,b1,padding=1),w2,b2,padding=1)+x\ncfn=torch.compile(fn, fullgraph=True)\n\ndef bench(f,args,its=100):\n for _ in range(10): y=f(*args)\n torch.cuda.synchronize(); s=torch.cuda.Event(True); e=torch.cuda.Event(True); s.record()\n for _ in range(its): y=f(*args)\n e.record(); e.synchronize(); return s.elapsed_time(e)/its\nfor shape in [(1,64,64),(1,128,128),(16,128,128),(8,512,512)]:\n B,H,W=shape\n args=(torch.randn(B,3,H,W,device='cuda'),torch.randn(32,3,3,3,device='cuda'),torch.randn(32,device='cuda'),torch.randn(3,32,3,3,device='cuda'),torch.randn(3,device='cuda'))\n # compile and check\n yc=cfn(*args); yr=base(*args); torch.cuda.synchronize()\n print(shape,'compile diff',(yc-yr).abs().max().item())\n its=200 if B*H*W<300000 else 50\n print('  base',bench(base,args,its),'inplace',bench(inp,args,its),'compile',bench(cfn,args,its))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
