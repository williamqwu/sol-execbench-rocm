{"type":"item.started","item":{"id":"item_17","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch, torch.nn.functional as F, triton, triton.language as tl\n@triton.jit\ndef addk(y,x,n:tl.constexpr,B:tl.constexpr):\n i=tl.program_id(0)*B+tl.arange(0,B); m=i<n\n tl.store(y+i,tl.load(y+i,mask=m)+tl.load(x+i,mask=m),mask=m)\ndef tri(x,w1,b1,w2,b2):\n y=F.conv2d(F.conv2d(x,w1,b1,padding=1),w2,b2,padding=1)\n n=x.numel(); addk[(triton.cdiv(n,1024),)](y,x,n,B=1024,num_warps=8)\n return y\ndef base(x,w1,b1,w2,b2): return F.conv2d(F.conv2d(x,w1,b1,padding=1),w2,b2,padding=1)+x\ndef inp(x,w1,b1,w2,b2):\n y=F.conv2d(F.conv2d(x,w1,b1,padding=1),w2,b2,padding=1); return y.add_(x)\ndef bench(f,args,its):\n for _ in range(20):z=f(*args)\n torch.cuda.synchronize();s=torch.cuda.Event(True);e=torch.cuda.Event(True);s.record()\n for _ in range(its):z=f(*args)\n e.record();e.synchronize();return s.elapsed_time(e)/its\nfor sh in [(1,64,64),(2,64,64),(1,128,128),(16,64,64),(16,128,128),(8,512,512)]:\n B,H,W=sh;args=(torch.randn(B,3,H,W,device='cuda'),torch.randn(32,3,3,3,device='cuda'),torch.randn(32,device='cuda'),torch.randn(3,32,3,3,device='cuda'),torch.randn(3,device='cuda'))\n y=tri(*args);r=base(*args);torch.cuda.synchronize();print(sh,(y-r).abs().max().item())\n its=500 if B*H*W<1e5 else 100\n print(' ',bench(base,args,its),bench(inp,args,its),bench(tri,args,its))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
