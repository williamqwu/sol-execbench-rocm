{"type":"item.started","item":{"id":"item_40","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch,torch.nn.functional as F\n\ndef base(x,w1,b1,w2,b2): return F.conv2d(F.conv2d(x,w1,b1,padding=1),w2,b2,padding=1)+x\ndef cl(x,w1,b1,w2,b2):\n xx=x.contiguous(memory_format=torch.channels_last); ww1=w1.contiguous(memory_format=torch.channels_last); ww2=w2.contiguous(memory_format=torch.channels_last)\n y=F.conv2d(F.conv2d(xx,ww1,b1,padding=1),ww2,b2,padding=1)\n return y.contiguous()+x\ndef clx(x,w1,b1,w2,b2):\n xx=x.contiguous(memory_format=torch.channels_last)\n y=F.conv2d(F.conv2d(xx,w1,b1,padding=1),w2,b2,padding=1)\n return y.contiguous()+x\ndef bench(f,a,it):\n for _ in range(10):f(*a)\n torch.cuda.synchronize();s=torch.cuda.Event(True);e=torch.cuda.Event(True);s.record()\n for _ in range(it):f(*a)\n e.record();e.synchronize();return s.elapsed_time(e)/it\nfor sh in [(1,64,64),(16,128,128),(8,512,512)]:\n B,H,W=sh;a=(torch.randn(B,3,H,W,device='cuda'),torch.randn(32,3,3,3,device='cuda'),torch.randn(32,device='cuda'),torch.randn(3,32,3,3,device='cuda'),torch.randn(3,device='cuda'))\n r=base(*a)\n print(sh)\n for f in [cl,clx]:\n  y=f(*a);d=(y-r).abs();close=d<=3.8e-6+1.1920928955078125e-7*r.abs();print(f.__name__,d.max().item(),close.float().mean().item(),bench(f,a,100 if B*H*W>1e5 else 300))\n print('base',bench(base,a,100 if B*H*W>1e5 else 300))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
