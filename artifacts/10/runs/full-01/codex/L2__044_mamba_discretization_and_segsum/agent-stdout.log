{"type":"item.started","item":{"id":"item_83","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport torch,triton,kernel\nN=256;H=16;kw={'device':'cuda:0','dtype':torch.bfloat16}\n\ndef inputs(bc): return (torch.randn((bc,1,N,H),**kw),torch.randn((H,),**kw),torch.randn((bc,1,N,1,N),**kw),torch.randn((bc,1,N,1,N),**kw))\ndef alloc(bc):\n full=bc*H*N*N; ge=bc*N*N; be=2*full+ge; fe=2*bc*H*N\n raw=torch.empty((be*2+fe*4,),device='cuda:0',dtype=torch.uint8); bb=be*2\n bf=raw[:bb].view(torch.bfloat16); ff=raw[bb:].view(torch.float32).view(2,bc,H,N)\n return raw,bf[:full].view(bc,H,N,N),bf[full:2*full].view(bc,H,N,N),bf[2*full:].view(bc,N,N),ff\n\ndef fused(bc,x):\n dt,a,b,c=x;raw,l,m,g,f=alloc(bc)\n kernel._discretize_kernel[(bc,H)](dt,a,f[0],f[1],BLOCK=N,N_HEADS=H,num_warps=1)\n if bc==1: bm,bn,bk,hb,nw=32,16,32,4,8\n else: bm,bn,bk,hb,nw=32,16,128,16,8\n tiles=(N//bm)*(N//bn)\n kernel._g_l_m_kernel[(tiles,bc,H//hb)](b,c,f[0],l,g,m,BLOCK_M=bm,BLOCK_N=bn,BLOCK_K=bk,N=N,K=N,N_HEADS=H,HEAD_BLOCK=hb,num_warps=nw,num_stages=1)\n return raw\n\ndef mixed(bc,x,bm,bn,bk,nw,lr,lw):\n dt,a,b,c=x;raw,l,m,g,f=alloc(bc);tiles=(N//bm)*(N//bn)\n kernel._g_and_discretize_kernel[(bc*(H+tiles),)](dt,a,b,c,f[0],f[1],g,BLOCK_M=bm,BLOCK_N=bn,BLOCK_K=bk,N=N,K=N,N_HEADS=H,NUM_CHUNKS=bc,num_warps=nw,num_stages=1)\n kernel._l_m_tile_kernel[(N//lr,bc*H)](f[0],g,l,m,N=N,N_HEADS=H,BLOCK_ROWS=lr,num_warps=lw)\n return raw\nconfigs=[(32,32,64,4,16,2),(32,32,64,8,16,2),(32,64,64,8,16,2),(64,32,64,8,16,2),(64,64,64,8,16,2),(32,32,64,8,8,2),(32,32,64,8,32,4)]\nfor bc in [1,2,3,4]:\n x=inputs(bc);fused(bc,x);torch.cuda.synchronize();fv=triton.testing.do_bench(lambda:fused(bc,x),warmup=20,rep=100);print('bc',bc,'fused',f'{fv:.5f}')\n for cfg in configs:\n  try:\n   mixed(bc,x,*cfg);torch.cuda.synchronize();v=triton.testing.do_bench(lambda:mixed(bc,x,*cfg),warmup=15,rep=60);print(' ',cfg,f'{v:.5f}',flush=True)\n  except Exception as e:print(' ',cfg,'ERR',str(e).splitlines()[-1],flush=True)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
