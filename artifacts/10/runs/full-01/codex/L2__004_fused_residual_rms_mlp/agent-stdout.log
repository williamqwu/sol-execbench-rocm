{"type":"item.started","item":{"id":"item_19","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch,aiter,torch.nn.functional as F\nD='cuda';K=16384;N=53248\nB1=torch.empty((N,K),device=D,dtype=torch.bfloat16).uniform_(-.02,.02);B2=torch.empty_like(B1).uniform_(-.02,.02)\nAmax=torch.empty((4096,K),device=D,dtype=torch.bfloat16).uniform_(-1,1)\n@torch.no_grad()\ndef base(A):\n g=F.linear(A,B1);u=F.linear(A,B2);return F.silu(g)*u\n@torch.no_grad()\ndef packed(A):\n p=torch.empty((A.shape[0],2*N),device=A.device,dtype=A.dtype)\n torch.mm(A,B1.t(),out=p[:,:N]);torch.mm(A,B2.t(),out=p[:,N:])\n o=torch.empty((A.shape[0],N),device=A.device,dtype=A.dtype);aiter.silu_and_mul(o,p);return o\n\ndef tm(fn,warm=3,it=10):\n for _ in range(warm):y=fn()\n torch.cuda.synchronize();a=torch.cuda.Event(True);b=torch.cuda.Event(True);a.record()\n for _ in range(it):y=fn()\n b.record();b.synchronize();return a.elapsed_time(b)/it,y\nfor m in (256,997,4096):\n A=Amax[:m];t0,y0=tm(lambda:base(A));t1,y1=tm(lambda:packed(A));d=(y0.float()-y1.float()).abs()\n print(m,'base',t0,'packed',t1,'ratio',t0/t1,'max',d.max().item(),'eq',(d==0).float().mean().item(),'mean',d.mean().item())\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
