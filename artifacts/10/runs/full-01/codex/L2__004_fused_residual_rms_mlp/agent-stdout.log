ary']\n['_BlasBackend', '_cuda_clearCublasWorkspaces', '_cuda_getCurrentBlasHandle', '_get_blas_preferred_backend', '_get_cublas_allow_bf16_reduced_precision_reduction', '_get_cublas_allow_fp16_accumulation', '_get_cublas_allow_fp16_reduced_precision_reduction', '_get_cublas_allow_tf32', '_set_blas_preferred_backend', '_set_cublas_allow_bf16_reduced_precision_reduction', '_set_cublas_allow_fp16_accumulation', '_set_cublas_allow_fp16_reduced_precision_reduction', '_set_cublas_allow_tf32']\n[W805 23:34:18.099693110 AllocatorConfig.cpp:28] Warning: PYTORCH_CUDA_ALLOC_CONF is deprecated, use PYTORCH_ALLOC_CONF instead (function operator())\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_12","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch\nD='cuda'; K=16384; N=53248\nB=torch.empty((N,K),device=D,dtype=torch.bfloat16).uniform_(-.02,.02)\nAmax=torch.empty((4096,K),device=D,dtype=torch.bfloat16).uniform_(-1,1)\ndef tm(fn, warm=2, it=5):\n for _ in range(warm): y=fn()\n torch.cuda.synchronize(); s=torch.cuda.Event(True); e=torch.cuda.Event(True); s.record()\n for _ in range(it): y=fn()\n e.record(); e.synchronize(); return s.elapsed_time(e)/it,y\nfor lib in ('cublaslt','cublas','ck'):\n try:\n  torch.backends.cuda.preferred_blas_library(lib)\n  print('LIB',lib,torch.backends.cuda.preferred_blas_library())\n  for m in (256,997,4096):\n   t,y=tm(lambda: torch.nn.functional.linear(Amax[:m],B))\n   print('up',m,t)\n except Exception as ex: print('FAIL',lib,repr(ex))\ndel B,Amax; torch.cuda.empty_cache()\nK=53248; N=16384\nB=torch.empty((N,K),device=D,dtype=torch.bfloat16).uniform_(-.02,.02)\nAmax=torch.empty((4096,K),device=D,dtype=torch.bfloat16).uniform_(-.2,.2)\nfor lib in ('cublaslt','cublas','ck'):\n try:\n  torch.backends.cuda.preferred_blas_library(lib)\n  print('LIB',lib,torch.backends.cuda.preferred_blas_library())\n  for m in (256,997,4096):\n   t,y=tm(lambda: torch.nn.functional.linear(Amax[:m],B))\n   print('down',m,t)\n except Exception as ex: print('FAIL',lib,repr(ex))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
