{"type":"item.started","item":{"id":"item_21","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch,torch.nn.functional as F,aiter\nD='cuda';H=16384;I=53248\n@torch.no_grad()\ndef norm_e(h,r,w):\n x=h+r;xf=x.float();return (w*(xf*torch.rsqrt(xf.square().mean(-1,keepdim=True)+1e-5))).bfloat16()\n@torch.no_grad()\ndef norm_a(h,r,w):\n o=torch.empty_like(h);rr=torch.empty_like(h);aiter.rmsnorm2d_fwd_with_add_opus(o,h,r,rr,w,1e-5);return o\n@torch.no_grad()\ndef exact(h,r,w,g,u,d,anorm=False):\n x=norm_a(h,r,w) if anorm else norm_e(h,r,w);go=F.linear(x,g);uo=F.linear(x,u);return F.linear(F.silu(go)*uo,d)\n@torch.no_grad()\ndef pact(h,r,w,g,u,d,anorm=False):\n x=norm_a(h,r,w) if anorm else norm_e(h,r,w);m=x.shape[0];p=torch.empty((m,2*I),device=x.device,dtype=x.dtype);torch.mm(x,g.t(),out=p[:,:I]);torch.mm(x,u.t(),out=p[:,I:]);z=torch.empty((m,I),device=x.device,dtype=x.dtype);aiter.silu_and_mul(z,p);return F.linear(z,d)\ndef tm(fn,warm=3,it=8):\n for _ in range(warm):y=fn()\n torch.cuda.synchronize();a=torch.cuda.Event(True);b=torch.cuda.Event(True);a.record()\n for _ in range(it):y=fn()\n b.record();b.synchronize();return a.elapsed_time(b)/it,y\nw=torch.empty(H,device=D,dtype=torch.bfloat16).uniform_(-1,1);g=torch.empty((I,H),device=D,dtype=torch.bfloat16).uniform_(-.02,.02);u=torch.empty_like(g).uniform_(-.02,.02);d=torch.empty((H,I),device=D,dtype=torch.bfloat16).uniform_(-.02,.02)\nfor m in (256,997,4096):\n h=torch.empty((m,H),device=D,dtype=torch.bfloat16).uniform_(-1,1);r=torch.empty_like(h).uniform_(-1,1)\n t0,y0=tm(lambda:exact(h,r,w,g,u,d,False))\n for name,fn in [('anorm',lambda:exact(h,r,w,g,u,d,True)),('pact',lambda:pact(h,r,w,g,u,d,False)),('both',lambda:pact(h,r,w,g,u,d,True))]:\n  t,y=tm(fn);di=(y0.float()-y.float()).abs();close=torch.isclose(y0.float(),y.float(),atol=.00466,rtol=.0078125);print(m,name,'t',t,'speed',t0/t,'max',di.max().item(),'mean',di.mean().item(),'match',close.float().mean().item())\n print(m,'base',t0)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
