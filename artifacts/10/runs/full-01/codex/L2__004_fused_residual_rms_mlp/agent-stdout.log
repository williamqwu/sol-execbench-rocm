{"type":"item.started","item":{"id":"item_44","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch,kernel,aiter\nD='cuda';H=16384;I=53248\nw=torch.empty(H,device=D,dtype=torch.bfloat16).uniform_(-1,1);g=torch.empty((I,H),device=D,dtype=torch.bfloat16).uniform_(-.02,.02);u=torch.empty_like(g).uniform_(-.02,.02);d=torch.empty((H,I),device=D,dtype=torch.bfloat16).uniform_(-.02,.02)\n@torch.no_grad()\ndef v(h,r,asm):\n x=kernel._rms_norm(h,r,w,1e-5).reshape(-1,H);gg=kernel._wide_linear(x,g);uu=kernel._wide_linear(x,u);z=kernel._silu_mul(gg,uu)\n if asm:\n  o=torch.empty((x.shape[0],H),device=D,dtype=torch.bfloat16);aiter.gemm_a16w16_asm(z,d,o);return o\n return torch.nn.functional.linear(z,d)\ndef tm(fn,warm=4,it=10):\n for _ in range(warm):fn()\n torch.cuda.synchronize();s=torch.cuda.Event(True);e=torch.cuda.Event(True);s.record()\n for _ in range(it):fn()\n e.record();e.synchronize();return s.elapsed_time(e)/it\nfor m in (1492,1571,2048,2053,4096,8192):\n h=torch.empty((m,H),device=D,dtype=torch.bfloat16).uniform_(-1,1);r=torch.empty_like(h).uniform_(-1,1)\n # Alternate ordering once, then report a second stable pair.\n tm(lambda:v(h,r,False),2,3);tm(lambda:v(h,r,True),2,3)\n print(m,tm(lambda:v(h,r,False)),tm(lambda:v(h,r,True)))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
