{"type":"item.started","item":{"id":"item_20","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch, torch.nn.functional as F\nD='cuda';H=16384;I=53248\n@torch.no_grad()\ndef eager(h,r,w,g,u,d,eps):\n x=h+r;xf=x.float();x=(w*(xf*torch.rsqrt(xf.square().mean(-1,keepdim=True)+eps))).to(h.dtype);go=F.linear(x,g);uo=F.linear(x,u);z=F.silu(go)*uo;return F.linear(z,d)\n@torch.compile(dynamic=True)\n@torch.no_grad()\ndef comp(h,r,w,g,u,d,eps):\n x=h+r;xf=x.float();x=(w*(xf*torch.rsqrt(xf.square().mean(-1,keepdim=True)+eps))).to(h.dtype);go=F.linear(x,g);uo=F.linear(x,u);z=F.silu(go)*uo;return F.linear(z,d)\ndef tm(fn,warm=3,it=8):\n for _ in range(warm):y=fn()\n torch.cuda.synchronize();a=torch.cuda.Event(True);b=torch.cuda.Event(True);a.record()\n for _ in range(it):y=fn()\n b.record();b.synchronize();return a.elapsed_time(b)/it,y\nw=torch.empty(H,device=D,dtype=torch.bfloat16).uniform_(-1,1)\ng=torch.empty((I,H),device=D,dtype=torch.bfloat16).uniform_(-.02,.02);u=torch.empty_like(g).uniform_(-.02,.02);d=torch.empty((H,I),device=D,dtype=torch.bfloat16).uniform_(-.02,.02)\nfor m in (256,997,4096):\n h=torch.empty((m,H),device=D,dtype=torch.bfloat16).uniform_(-1,1);r=torch.empty_like(h).uniform_(-1,1)\n t0,y0=tm(lambda:eager(h,r,w,g,u,d,1e-5));t1,y1=tm(lambda:comp(h,r,w,g,u,d,1e-5));di=(y0.float()-y1.float()).abs();close=torch.isclose(y0.float(),y1.float(),atol=.00466,rtol=.0078125)\n print(m,t0,t1,t0/t1,'max',di.max().item(),'mean',di.mean().item(),'match',close.float().mean().item())\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
