{"type":"item.started","item":{"id":"item_10","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch, aiter, time\nD='cuda'\ntorch.manual_seed(1)\nK=16384; N=53248\nB=torch.empty((N,K),device=D,dtype=torch.bfloat16).uniform_(-.02,.02)\nAmax=torch.empty((4096,K),device=D,dtype=torch.bfloat16).uniform_(-1,1)\n\ndef tm(fn, warm=2, it=5):\n    for _ in range(warm): y=fn()\n    torch.cuda.synchronize()\n    s=torch.cuda.Event(enable_timing=True); e=torch.cuda.Event(enable_timing=True)\n    s.record()\n    for _ in range(it): y=fn()\n    e.record(); e.synchronize()\n    return s.elapsed_time(e)/it, y\nfor m in (256,997,2048,4096):\n A=Amax[:m]\n t0,y0=tm(lambda: torch.nn.functional.linear(A,B))\n try:\n  t1,y1=tm(lambda: aiter.gemm_a16w16_opus(A,B))\n  diff=(y0.float()-y1.float()).abs()\n  print('up',m,'torch',t0,'opus',t1,'ratio',t0/t1,'max',diff.max().item(),'mean',diff.mean().item())\n except Exception as ex: print('up opus failed',m,repr(ex))\n del y0\n\ndel B,Amax; torch.cuda.empty_cache()\nK=53248; N=16384\nB=torch.empty((N,K),device=D,dtype=torch.bfloat16).uniform_(-.02,.02)\nAmax=torch.empty((4096,K),device=D,dtype=torch.bfloat16).uniform_(-.2,.2)\nfor m in (256,997,2048,4096):\n A=Amax[:m]\n t0,y0=tm(lambda: torch.nn.functional.linear(A,B))\n try:\n  t1,y1=tm(lambda: aiter.gemm_a16w16_opus(A,B))\n  diff=(y0.float()-y1.float()).abs()\n  print('down',m,'torch',t0,'opus',t1,'ratio',t0/t1,'max',diff.max().item(),'mean',diff.mean().item())\n except Exception as ex: print('down opus failed',m,repr(ex))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
