{"type":"item.started","item":{"id":"item_50","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch,kernel\nD='cuda';H=16384\ndef eager(h,r,w):\n x=h+r;xf=x.float();return (w*(xf*torch.rsqrt(xf.square().mean(-1,keepdim=True)+1e-5))).bfloat16()\ndef tm(fn,warm=4,it=15):\n for _ in range(warm):y=fn()\n torch.cuda.synchronize();a=torch.cuda.Event(True);b=torch.cuda.Event(True);a.record()\n for _ in range(it):y=fn()\n b.record();b.synchronize();return a.elapsed_time(b)/it,y\nfor m in (256,997,4096,8192):\n h=torch.empty((m,H),device=D,dtype=torch.bfloat16).uniform_(-1,1);r=torch.empty_like(h).uniform_(-1,1);w=torch.empty(H,device=D,dtype=torch.bfloat16).uniform_(-1,1)\n t0,y0=tm(lambda:eager(h,r,w));print('M',m,'eager',t0)\n for nw in (4,8,16):\n  try:\n   t,y=tm(lambda nw=nw:kernel._rms_norm_fused(h,r,w,1e-5,nw));d=(y0.float()-y.float()).abs();print(nw,t,'max',d.max().item(),'eq',(d==0).float().mean().item(),'mean',d.mean().item())\n  except Exception as e: print('FAIL',nw,type(e).__name__,str(e)[:500])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
