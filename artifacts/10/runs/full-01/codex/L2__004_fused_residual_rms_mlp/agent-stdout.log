{"type":"item.completed","item":{"id":"item_13","type":"agent_message","text":"The native library alternatives are slower for these unusually wide matrices, and hipBLASLt is already the best backend. I’m narrowing the next change to two safe fusions around those GEMMs: residual+RMSNorm and SiLU×up. This keeps the proven GEMM numerics while removing temporary traffic and launches."}}
{"type":"item.started","item":{"id":"item_14","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch, torch.nn.functional as F\nD='cuda'; H=16384; I=53248\n@torch.compile(dynamic=True)\ndef cnorm(h,r,w,eps):\n x=h+r; xf=x.float(); v=xf.square().mean(-1,keepdim=True); return (w*(xf*torch.rsqrt(v+eps))).to(h.dtype)\n@torch.compile(dynamic=True)\ndef cact(g,u):\n return F.silu(g)*u\n\ndef enorm(h,r,w,eps):\n x=h+r; xf=x.float(); v=xf.square().mean(-1,keepdim=True); return (w*(xf*torch.rsqrt(v+eps))).to(h.dtype)\ndef eact(g,u): return F.silu(g)*u\n\ndef tm(fn,warm=5,it=20):\n for _ in range(warm): y=fn()\n torch.cuda.synchronize(); a=torch.cuda.Event(True);b=torch.cuda.Event(True);a.record()\n for _ in range(it): y=fn()\n b.record();b.synchronize();return a.elapsed_time(b)/it,y\nfor m in (256,997,4096,8192):\n h=torch.empty((m,H),device=D,dtype=torch.bfloat16).uniform_(-1,1);r=torch.empty_like(h).uniform_(-1,1);w=torch.empty(H,device=D,dtype=torch.bfloat16).uniform_(-1,1)\n t0,y0=tm(lambda:enorm(h,r,w,1e-5));t1,y1=tm(lambda:cnorm(h,r,w,1e-5)); d=(y0.float()-y1.float()).abs()\n print('norm',m,t0,t1,'speedup',t0/t1,'max',d.max().item(),'ratioeq',(d==0).float().mean().item())\n del h,r,w,y0,y1\n g=torch.empty((m,I),device=D,dtype=torch.bfloat16).uniform_(-1,1);u=torch.empty_like(g).uniform_(-1,1)\n t0,y0=tm(lambda:eact(g,u));t1,y1=tm(lambda:cact(g,u)); d=(y0.float()-y1.float()).abs()\n print('act',m,t0,t1,'speedup',t0/t1,'max',d.max().item(),'ratioeq',(d==0).float().mean().item())\n del g,u,y0,y1\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
