{"type":"item.started","item":{"id":"item_42","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch,triton,kernel,reference\nconfigs=[(32,4),(64,4),(64,8),(128,4),(128,8),(256,4),(256,8)]\nfor n in (19984,39232,54592,65536,91072,131072):\n args=[torch.randn((1,n,40),device='cuda',dtype=torch.bfloat16) for _ in range(3)]\n vals=[]\n for br,nw in configs:\n  def fn(ret=False):\n   nparts=triton.cdiv(n,br);gd=torch.empty_like(args[0]);p=torch.empty((nparts,40),device='cuda',dtype=torch.float32);gb=torch.empty(40,device='cuda',dtype=torch.bfloat16)\n   kernel._grad_and_partial_32_8_kernel[(nparts,)](*args,gd,p,n,.001,.1,BLOCK_R=br,num_warps=nw)\n   kernel._finish_bias_kernel[(40,)](p,gb,nparts,BLOCK_P=triton.next_power_of_2(nparts),num_warps=1 if nparts<=512 else 8)\n   return gd,gb\n  got=fn(True)\n  if br==128:\n   ref=reference.run(*args,.001,.1);torch.cuda.synchronize();err=max((x.float()-y.float()).abs().max().item() for x,y in zip(got,ref))\n  else:err=0\n  t=triton.testing.do_bench(fn,warmup=10,rep=100)*1000;vals.append((t,br,nw,err))\n print('n',n,' '.join(f'r{br}w{nw}={t:.2f}' for t,br,nw,e in vals),'err128',[(e) for t,b,w,e in vals if b==128])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
