{"type":"item.started","item":{"id":"item_9","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch\nimport triton\nimport kernel\nimport reference\n\n\ndef old_run(go, x, a, lo, hi):\n    n = go.numel() // 40\n    br = 64\n    nparts = triton.cdiv(n, br)\n    gd = torch.empty_like(go)\n    p = torch.empty((nparts, 40), device=go.device, dtype=torch.float32)\n    gb = torch.empty((40,), device=go.device, dtype=torch.bfloat16)\n    kernel._grad_and_partial_kernel[(nparts,)](go, x, a, gd, p, n, lo, hi,\n        BLOCK_R=br, N_HEADS=40, BLOCK_H=64, num_warps=8)\n    kernel._finish_bias_kernel[(40,)](p, gb, nparts,\n        BLOCK_P=triton.next_power_of_2(nparts), num_warps=8)\n    return gd, gb\n\nfor n in (131, 422, 512, 919):\n    args = [torch.randn((n, 40), device='cuda', dtype=torch.bfloat16) for _ in range(3)]\n    got = kernel.run(*args, 0.001, 0.1)\n    ref = reference.run(*args, 0.001, 0.1)\n    torch.cuda.synchronize()\n    errs = [(g.float() - r.float()).abs().max().item() for g, r in zip(got, ref)]\n    tnew = triton.testing.do_bench(lambda: kernel.run(*args, 0.001, 0.1), warmup=20, rep=100)\n    told = triton.testing.do_bench(lambda: old_run(*args, 0.001, 0.1), warmup=20, rep=100)\n    print(n, 'errors', errs, 'small_ms', tnew, 'two_stage_ms', told)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
