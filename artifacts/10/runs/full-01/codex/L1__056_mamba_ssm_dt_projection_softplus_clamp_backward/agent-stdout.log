{"type":"item.started","item":{"id":"item_53","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch,triton,kernel,reference\nfor n in (39232,54592,91072,131072):\n args=[torch.randn((1,n,40),device='cuda',dtype=torch.bfloat16) for _ in range(3)]\n for atomic in (False,True):\n  def fn(ret=False):\n   nparts=triton.cdiv(n,128);gd=torch.empty_like(args[0]);p=(torch.zeros(40,device='cuda',dtype=torch.float32) if atomic else torch.empty((nparts,40),device='cuda',dtype=torch.float32));gb=torch.empty(40,device='cuda',dtype=torch.bfloat16)\n   kernel._grad_and_partial_32_8_kernel[(nparts,)](*args,gd,p,n,.001,.1,BLOCK_R=128,ATOMIC=atomic,num_warps=4,waves_per_eu=6)\n   kernel._finish_bias_kernel[(40,)](p,gb,1 if atomic else nparts,BLOCK_P=1 if atomic else triton.next_power_of_2(nparts),num_warps=1 if atomic or nparts<=512 else 8)\n   return gd,gb\n  got=fn(True);ref=reference.run(*args,.001,.1);torch.cuda.synchronize();stats=[]\n  for x,y in zip(got,ref):\n   d=(x.float()-y.float()).abs();ok=d<=.0012+.0078125*y.float().abs();stats.append((d.max().item(),ok.float().mean().item()))\n  ts=[triton.testing.do_bench(fn,warmup=20,rep=200)*1000 for _ in range(3)]\n  print(n,'atomic',atomic,'times',ts,'stats',stats)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
