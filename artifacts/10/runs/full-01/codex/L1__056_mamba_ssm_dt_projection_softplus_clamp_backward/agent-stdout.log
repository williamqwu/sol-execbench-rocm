{"type":"item.started","item":{"id":"item_12","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch\nimport triton\nimport kernel\n\nconfigs = [(16,2),(16,4),(16,8),(32,2),(32,4),(32,8),(64,2),(64,4),(64,8),(128,4),(128,8)]\nsizes = (131, 3142, 19984, 131072)\n\nfor n in sizes:\n    args = [torch.randn((n, 40), device='cuda', dtype=torch.bfloat16) for _ in range(3)]\n    timings = []\n    for br, nw in configs:\n        def run_cfg():\n            nparts = triton.cdiv(n, br)\n            gd = torch.empty_like(args[0])\n            p = torch.empty((nparts,40), device='cuda', dtype=torch.float32)\n            gb = torch.empty((40,), device='cuda', dtype=torch.bfloat16)\n            kernel._grad_and_partial_kernel[(nparts,)](*args, gd, p, n, 0.001, 0.1,\n                BLOCK_R=br, N_HEADS=40, BLOCK_H=64, num_warps=nw)\n            kernel._finish_bias_kernel[(40,)](p, gb, nparts,\n                BLOCK_P=triton.next_power_of_2(nparts), num_warps=8)\n        t = triton.testing.do_bench(run_cfg, warmup=10, rep=50)\n        timings.append((t,br,nw))\n    print('n', n, ' '.join(f'br{br}w{nw}={t*1000:.2f}us' for t,br,nw in timings))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
