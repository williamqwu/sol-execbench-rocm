{"type":"item.started","item":{"id":"item_34","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport numpy as np, torch\nfrom numpy.polynomial import Chebyshev, Polynomial\ncandidates={}\nfor R in (2.5,3.0,3.5,4.0):\n for deg in (5,7,9,11):\n  ch=Chebyshev.interpolate(lambda x:1/(1+np.exp(-x)),deg,domain=[-R,R])\n  p=ch.convert(kind=Polynomial)\n  co=p.coef\n  candidates[(R,deg)]=co\n  xx=np.linspace(-R,R,100001); err=np.max(np.abs(p(xx)-1/(1+np.exp(-xx))))\n  print('coef',R,deg,'max',err,'odd',[float(co[i]) for i in range(1,len(co),2)])\nprint('SIM')\nfor n in (19984,131072):\n go=torch.randn((1,n,40),device='cuda',dtype=torch.bfloat16).float();x=torch.randn_like(go).bfloat16().float();a=torch.randn_like(go).bfloat16().float();m=(a>.001)&(a<.1)\n exact=torch.where(m,go*torch.sigmoid(x),0.); eb=exact.bfloat16().float(); ebs=exact.sum((0,1)).bfloat16().float()\n for (R,deg),co in candidates.items():\n  xc=x.clamp(-R,R); y=torch.full_like(xc,float(co[deg]))\n  for j in range(deg-1,-1,-1): y=y*xc+float(co[j])\n  appr=torch.where(m,go*y,0.); ab=appr.bfloat16().float();absum=appr.sum((0,1)).bfloat16().float()\n  ok=((eb-ab).abs()<=.0012+.0078125*eb.abs()).float().mean().item()\n  bok=((ebs-absum).abs()<=.0012+.0078125*ebs.abs()).sum().item()\n  if deg in (5,7,9): print('sim',n,R,deg,'ok',ok,'bias',bok,'bmax',(ebs-absum).abs().max().item())\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
