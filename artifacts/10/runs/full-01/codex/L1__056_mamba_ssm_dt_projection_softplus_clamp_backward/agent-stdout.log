{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' definition.json && printf '\\\\nREFERENCE\\\\n' && sed -n '1,320p' reference.py && printf '\\\\nWORKLOADS\\\\n' && sed -n '1,240p' workload.jsonl\"","aggregated_output":"{\n  \"name\": \"056_mamba_ssm_dt_projection_softplus_clamp_backward\",\n  \"description\": \"Backward pass for Mamba SSM dt projection with softplus and clamp. Computes gradients through clamp, softplus, and bias addition operations.\",\n  \"hf_id\": \"ibm-granite/granite-4.0-micro\",\n  \"custom_inputs_entrypoint\": null,\n  \"axes\": {\n    \"batch_size\": {\n      \"type\": \"var\"\n    },\n    \"seq_len\": {\n      \"type\": \"var\"\n    },\n    \"num_heads\": {\n      \"type\": \"const\",\n      \"value\": 40\n    }\n  },\n  \"inputs\": {\n    \"grad_output\": {\n      \"shape\": [\n        \"batch_size\",\n        \"seq_len\",\n        \"num_heads\"\n      ],\n      \"dtype\": \"bfloat16\",\n      \"description\": \"Gradient from downstream layer\"\n    },\n    \"dt_with_bias\": {\n      \"shape\": [\n        \"batch_size\",\n        \"seq_len\",\n        \"num_heads\"\n      ],\n      \"dtype\": \"bfloat16\",\n      \"description\": \"Saved tensor: dt + dt_bias from forward pass\"\n    },\n    \"dt_activated\": {\n      \"shape\": [\n        \"batch_size\",\n        \"seq_len\",\n        \"num_heads\"\n      ],\n      \"dtype\": \"bfloat16\",\n      \"description\": \"Saved tensor: softplus(dt + dt_bias) from forward pass\"\n    },\n    \"time_step_min\": {\n      \"shape\": null,\n      \"dtype\": \"float32\",\n      \"description\": \"Minimum clamp value\"\n    },\n    \"time_step_max\": {\n      \"shape\": null,\n      \"dtype\": \"float32\",\n      \"description\": \"Maximum clamp value\"\n    }\n  },\n  \"outputs\": {\n    \"grad_dt\": {\n      \"shape\": [\n        \"batch_size\",\n        \"seq_len\",\n        \"num_heads\"\n      ],\n      \"dtype\": \"bfloat16\",\n      \"description\": \"Gradient with respect to dt input\"\n    },\n    \"grad_dt_bias\": {\n      \"shape\": [\n        \"num_heads\"\n      ],\n      \"dtype\": \"bfloat16\",\n      \"description\": \"Gradient with respect to dt_bias parameter\"\n    }\n  },\n  \"reference\": \"import torch\\n\\n@torch.no_grad()\\ndef run(\\n    grad_output: torch.Tensor,\\n    dt_with_bias: torch.Tensor,\\n    dt_activated: torch.Tensor,\\n    time_step_min: float,\\n    time_step_max: float,\\n):\\n    \\\"\\\"\\\"\\n    Backward pass for fused dt projection with bias, softplus, and clamping.\\n    \\n    Computes gradients through:\\n    1. Clamp operation: gradient passes through only if value is strictly within bounds\\n    2. Softplus operation: gradient is sigmoid(dt_with_bias)\\n    3. Bias addition: gradient passes through for dt, summed over batch/seq for bias\\n    \\n    Args:\\n        grad_output: Gradient from downstream [batch_size, seq_len, num_heads]\\n        dt_with_bias: Saved tensor dt + dt_bias from forward [batch_size, seq_len, num_heads]\\n        dt_activated: Saved tensor softplus(dt + dt_bias) from forward [batch_size, seq_len, num_heads]\\n        time_step_min: Minimum clamp value (0.001)\\n        time_step_max: Maximum clamp value (0.1)\\n    \\n    Returns:\\n        grad_dt: Gradient w.r.t. dt input [batch_size, seq_len, num_heads]\\n        grad_dt_bias: Gradient w.r.t. dt_bias [num_heads]\\n    \\\"\\\"\\\"\\n    # Convert to float32 for numerical stability\\n    grad = grad_output.to(torch.float32)\\n    dt_with_bias_f32 = dt_with_bias.to(torch.float32)\\n    dt_activated_f32 = dt_activated.to(torch.float32)\\n    \\n    # Step 1: Gradient through clamp operation\\n    # Gradient passes through only if value is strictly within bounds\\n    # If clamped to min or max, gradient is zero (non-differentiable boundary)\\n    clamp_mask = (dt_activated_f32 > time_step_min) & (dt_activated_f32 < time_step_max)\\n    grad = grad * clamp_mask.to(grad.dtype)\\n    \\n    # Step 2: Gradient through softplus operation\\n    # d/dx softplus(x) = sigmoid(x) = 1 / (1 + exp(-x))\\n    softplus_grad = torch.sigmoid(dt_with_bias_f32)\\n    grad = grad * softplus_grad\\n    \\n    # Step 3: Gradient through bias addition\\n    # For dt input: gradient passes through directly (d(x+b)/dx = 1)\\n    grad_dt = grad.to(torch.bfloat16)\\n    \\n    # For dt_bias: sum gradients over batch and sequence dimensions\\n    # dt_bias shape: [num_heads]\\n    # grad shape: [batch, seq_len, num_heads] -> [num_heads]\\n    grad_dt_bias = grad.sum(dim=(0, 1)).to(torch.bfloat16)\\n    \\n    return grad_dt, grad_dt_bias\\n\"\n}\n\nREFERENCE\nimport torch\n\n@torch.no_grad()\ndef run(\n    grad_output: torch.Tensor,\n    dt_with_bias: torch.Tensor,\n    dt_activated: torch.Tensor,\n    time_step_min: float,\n    time_step_max: float,\n):\n    \"\"\"\n    Backward pass for fused dt projection with bias, softplus, and clamping.\n    \n    Computes gradients through:\n    1. Clamp operation: gradient passes through only if value is strictly within bounds\n    2. Softplus operation: gradient is sigmoid(dt_with_bias)\n    3. Bias addition: gradient passes through for dt, summed over batch/seq for bias\n    \n    Args:\n        grad_output: Gradient from downstream [batch_size, seq_len, num_heads]\n        dt_with_bias: Saved tensor dt + dt_bias from forward [batch_size, seq_len, num_heads]\n        dt_activated: Saved tensor softplus(dt + dt_bias) from forward [batch_size, seq_len, num_heads]\n        time_step_min: Minimum clamp value (0.001)\n        time_step_max: Maximum clamp value (0.1)\n    \n    Returns:\n        grad_dt: Gradient w.r.t. dt input [batch_size, seq_len, num_heads]\n        grad_dt_bias: Gradient w.r.t. dt_bias [num_heads]\n    \"\"\"\n    # Convert to float32 for numerical stability\n    grad = grad_output.to(torch.float32)\n    dt_with_bias_f32 = dt_with_bias.to(torch.float32)\n    dt_activated_f32 = dt_activated.to(torch.float32)\n    \n    # Step 1: Gradient through clamp operation\n    # Gradient passes through only if value is strictly within bounds\n    # If clamped to min or max, gradient is zero (non-differentiable boundary)\n    clamp_mask = (dt_activated_f32 > time_step_min) & (dt_activated_f32 < time_step_max)\n    grad = grad * clamp_mask.to(grad.dtype)\n    \n    # Step 2: Gradient through softplus operation\n    # d/dx softplus(x) = sigmoid(x) = 1 / (1 + exp(-x))\n    softplus_grad = torch.sigmoid(dt_with_bias_f32)\n    grad = grad * softplus_grad\n    \n    # Step 3: Gradient through bias addition\n    # For dt input: gradient passes through directly (d(x+b)/dx = 1)\n    grad_dt = grad.to(torch.bfloat16)\n    \n    # For dt_bias: sum gradients over batch and sequence dimensions\n    # dt_bias shape: [num_heads]\n    # grad shape: [batch, seq_len, num_heads] -> [num_heads]\n    grad_dt_bias = grad.sum(dim=(0, 1)).to(torch.bfloat16)\n    \n    return grad_dt, grad_dt_bias\n\nWORKLOADS\n{\"uuid\": \"81b4cc8b-2f2f-5359-a8dd-9fd291f0eaff\", \"axes\": {\"batch_size\": 2, \"seq_len\": 1571}, \"inputs\": {\"grad_output\": {\"type\": \"random\"}, \"dt_with_bias\": {\"type\": \"random\"}, \"dt_activated\": {\"type\": \"random\"}, \"time_step_min\": {\"type\": \"scalar\", \"value\": 0.001}, \"time_step_max\": {\"type\": \"scalar\", \"value\": 0.1}}, \"tolerance\": {\"max_atol\": 0.0012312240231244528, \"max_rtol\": 0.0078125, \"required_matched_ratio\": 0.99, \"_provenance\": \"max run-to-run error over 10 seeds x 1.25 margin, floored at torch.bfloat16 epsilon\"}}\n{\"uuid\": \"8eff0220-ab4f-590b-8948-effbaa9ab1cc\", \"axes\": {\"batch_size\": 32, \"seq_len\": 4096}, \"inputs\": {\"grad_output\": {\"type\": \"random\"}, \"dt_with_bias\": {\"type\": \"random\"}, \"dt_activated\": {\"type\": \"random\"}, \"time_step_min\": {\"type\": \"scalar\", \"value\": 0.001}, \"time_step_max\": {\"type\": \"scalar\", \"value\": 0.1}}, \"tolerance\": {\"max_atol\": 0.0011269314839615157, \"max_rtol\": 0.0078125, \"required_matched_ratio\": 0.99, \"_provenance\": \"max run-to-run error over 10 seeds x 1.25 margin, floored at torch.bfloat16 epsilon\"}}\n{\"uuid\": \"7cd4e438-549f-5da2-a655-fd6d099e169a\", \"axes\": {\"batch_size\": 16, \"seq_len\": 1249}, \"inputs\": {\"grad_output\": {\"type\": \"random\"}, \"dt_with_bias\": {\"type\": \"random\"}, \"dt_activated\": {\"type\": \"random\"}, \"time_step_min\": {\"type\": \"scalar\", \"value\": 0.001}, \"time_step_max\": {\"type\": \"scalar\", \"value\": 0.1}}, \"tolerance\": {\"max_atol\": 0.001330447348339071, \"max_rtol\": 0.0078125, \"required_matched_ratio\": 0.99, \"_provenance\": \"max run-to-run error over 10 seeds x 1.25 margin, floored at torch.bfloat16 epsilon\"}}\n{\"uuid\": \"2a14e80c-4a59-5b23-9da3-d4ccd2f503c7\", \"axes\": {\"batch_size\": 64, \"seq_len\": 853}, \"inputs\": {\"grad_output\": {\"type\": \"random\"}, \"dt_with_bias\": {\"type\": \"random\"}, \"dt_activated\": {\"type\": \"random\"}, \"time_step_min\": {\"type\": \"scalar\", \"value\": 0.001}, \"time_step_max\": {\"type\": \"scalar\", \"value\": 0.1}}, \"tolerance\": {\"max_atol\": 0.0012642919544118374, \"max_rtol\": 0.0078125, \"required_matched_ratio\": 0.99, \"_provenance\": \"max run-to-run error over 10 seeds x 1.25 margin, floored at torch.bfloat16 epsilon\"}}\n{\"uuid\": \"caa083fd-0485-59ac-b40e-60646b6a14aa\", \"axes\": {\"batch_size\": 4, \"seq_len\": 293}, \"inputs\": {\"grad_output\": {\"type\": \"random\"}, \"dt_with_bias\": {\"type\": \"random\"}, \"dt_activated\": {\"type\": \"random\"}, \"time_step_min\": {\"type\": \"scalar\", \"value\": 0.001}, \"time_step_max\": {\"type\": \"scalar\", \"value\": 0.1}}, \"tolerance\": {\"max_atol\": 0.0012839563692689769, \"max_rtol\": 0.0078125, \"required_matched_ratio\": 0.99, \"_provenance\": \"max run-to-run error over 10 seeds x 1.25 margin, floored at torch.bfloat16 epsilon\"}}\n{\"uuid\": \"5565f90f-3caf-5fb5-8397-cdf1b4e8bcf1\", \"axes\": {\"batch_size\": 8, \"seq_len\": 10