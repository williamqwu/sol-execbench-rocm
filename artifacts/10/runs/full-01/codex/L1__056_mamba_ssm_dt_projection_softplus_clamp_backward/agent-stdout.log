{"type":"item.started","item":{"id":"item_19","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch\nimport triton\nimport kernel\n\ncases=[(131,8,512,8),(8192,16,256,4),(19984,8,512,8),(39232,32,128,4),(65536,16,256,4),(131072,64,128,4)]\nfor n,bh,br,nw in cases:\n  args=[torch.randn((n,40),device='cuda',dtype=torch.bfloat16) for _ in range(3)]\n  variants=[('old1',1),('old2',2),('old4',4),('old8',8)]\n  bp=triton.next_power_of_2(triton.cdiv(n,br))\n  for fh in (2,4,8,16,32,64):\n    if bp*fh <= 8192: variants.append((f'tile{fh}',fh))\n  vals=[]\n  for name,v in variants:\n    def fn():\n      nparts=triton.cdiv(n,br)\n      gd=torch.empty_like(args[0]); p=torch.empty((nparts,40),device='cuda',dtype=torch.float32); gb=torch.empty((40,),device='cuda',dtype=torch.bfloat16)\n      kernel._grad_and_partial_kernel[(nparts,triton.cdiv(40,bh))](*args,gd,p,n,0.001,0.1,BLOCK_R=br,N_HEADS=40,BLOCK_H=bh,num_warps=nw)\n      if name.startswith('old'):\n        kernel._finish_bias_kernel[(40,)](p,gb,nparts,BLOCK_P=bp,num_warps=v)\n      else:\n        kernel._finish_bias_tiled_kernel[(triton.cdiv(40,v),)](p,gb,nparts,BLOCK_P=bp,BLOCK_H=v,num_warps=8)\n    vals.append(triton.testing.do_bench(fn,warmup=10,rep=100)*1000)\n  print('n',n,'parts',triton.cdiv(n,br),' '.join(f'{x[0]}={t:.2f}' for x,t in zip(variants,vals)))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
