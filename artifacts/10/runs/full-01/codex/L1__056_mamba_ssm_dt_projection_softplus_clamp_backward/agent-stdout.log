{"type":"item.started","item":{"id":"item_39","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport json,torch\nwith open('workload.jsonl') as f: ws=[json.loads(x) for x in f]\nfor i,w in enumerate(ws):\n b=w['axes']['batch_size'];s=w['axes']['seq_len'];tol=w['tolerance'];bad=0;worst=0;worst_rel=0\n for seed in range(10):\n  torch.manual_seed(seed+i*100)\n  go=torch.randn((b,s,40),device='cuda',dtype=torch.bfloat16).float();x=torch.randn_like(go).bfloat16().float();a=torch.randn_like(go).bfloat16().float()\n  g=torch.where((a>.001)&(a<.1),go*torch.sigmoid(x),0.)\n  ref=g.sum((0,1)).bfloat16().float();alt=g.bfloat16().float().sum((0,1)).bfloat16().float()\n  d=(ref-alt).abs();ok=d<=tol['max_atol']+tol['max_rtol']*ref.abs();bad+=int((~ok).sum());worst=max(worst,d.max().item());worst_rel=max(worst_rel,(d/(ref.abs()+1e-30)).max().item())\n print(i,b*s,'bad_bias_entries/400',bad,'max_abs',worst,'max_rel',worst_rel)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
