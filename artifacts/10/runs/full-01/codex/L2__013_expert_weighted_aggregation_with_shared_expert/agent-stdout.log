{"type":"item.started","item":{"id":"item_54","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport torch,aiter,reference\nD='cuda';B=8;K=10;E=512;H=2048;I=512;block=32;R=B*K;M=R+E*block\ntorch.manual_seed(13);x=torch.randn(B,H,device=D,dtype=torch.bfloat16);q=torch.rand(B,K,device=D,dtype=torch.bfloat16);rw=q/q.sum(-1,keepdim=True);ids64=torch.arange(K,device=D,dtype=torch.int64).repeat(B,1);ids=ids64.int();wf=rw.float()\nsi=torch.empty(M,device=D,dtype=torch.int32);swt=torch.empty(M,device=D,dtype=torch.float32);sex=torch.empty((M+block-1)//block,device=D,dtype=torch.int32);nv=torch.zeros(1,device=D,dtype=torch.int32);buf=torch.empty(E*4,device=D,dtype=torch.int32);aiter.moe_sorting_fwd(ids,wf,si,swt,sex,nv,buf,E,block)\ng=torch.empty(E,I,H,device=D,dtype=torch.bfloat16);u=torch.empty_like(g);d=torch.empty(E,H,I,device=D,dtype=torch.bfloat16)\nfor z in (g[:K],u[:K],d[:K]):z.normal_().mul_(.02)\ninter=torch.full((R,I),float('nan'),device=D,dtype=torch.bfloat16);y=torch.full((B,K,H),float('nan'),device=D,dtype=torch.bfloat16);out=torch.empty(B,H,device=D,dtype=torch.bfloat16)\naiter.ck_moe_stage1(x,g,u,si,sex,nv,inter,K,kernelName='',block_m=block,activation=0,is_shuffled=False)\naiter.ck_moe_stage2(inter,d,d,si,sex,nv,y,K,kernelName='',block_m=block,sorted_weights=swt,activation=0,is_shuffled=False)\naiter.moe_sum(y,out)\nzero1=torch.zeros(I,H,device=D,dtype=torch.bfloat16);zero2=torch.zeros(H,I,device=D,dtype=torch.bfloat16);zero3=torch.zeros(1,H,device=D,dtype=torch.bfloat16)\nref=reference.run(x,rw,ids64,g,u,d,zero1,zero1,zero2,zero3);torch.cuda.synchronize()\nprint('finite',torch.isfinite(inter).float().mean().item(),torch.isfinite(y).float().mean().item(),torch.isfinite(out).all().item())\ne=(out.float()-ref.float()).abs();tol=.0011+.0078125*ref.float().abs();print('max',e.max().item(),'mean',e.mean().item(),'ratio',(e<=tol).float().mean().item(),'out',out.flatten()[:5].tolist(),'ref',ref.flatten()[:5].tolist())\nPY\"","aggregated_outp