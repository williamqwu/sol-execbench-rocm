{"type":"item.completed","item":{"id":"item_18","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' kernel.py | nl -ba\"","aggregated_output":"     1\timport torch\n     2\timport triton\n     3\timport triton.language as tl\n     4\t\n     5\t\n     6\t@triton.jit\n     7\tdef _grad_weights_kernel(\n     8\t    grad_out_ptr,\n     9\t    value_ptr,\n    10\t    mask_ptr,\n    11\t    grad_weights_ptr,\n    12\t    Q: tl.constexpr,\n    13\t    K: tl.constexpr,\n    14\t    KEEP_PROB,\n    15\t    BLOCK_M: tl.constexpr,\n    16\t    BLOCK_N: tl.constexpr,\n    17\t    BLOCK_D: tl.constexpr,\n    18\t):\n    19\t    tile = tl.program_id(0)\n    20\t    bh = tl.program_id(1)\n    21\t    num_n = tl.cdiv(K, BLOCK_N)\n    22\t    tile_m = tile // num_n\n    23\t    tile_n = tile - tile_m * num_n\n    24\t\n    25\t    b = bh // 80\n    26\t    h = bh - b * 80\n    27\t    kv_h = h // 10\n    28\t\n    29\t    offs_m = tile_m * BLOCK_M + tl.arange(0, BLOCK_M)\n    30\t    offs_n = tile_n * BLOCK_N + tl.arange(0, BLOCK_N)\n    31\t    offs_d = tl.arange(0, BLOCK_D)\n    32\t\n    33\t    # grad_out is [B, Q, 80, 128], value is [B, 8, K, 128].\n    34\t    g_ptrs = (\n    35\t        grad_out_ptr\n    36\t        + ((b * Q + offs_m[:, None]) * 80 + h) * 128\n    37\t        + offs_d[None, :]\n    38\t    )\n    39\t    v_ptrs = (\n    40\t        value_ptr\n    41\t        + ((b * 8 + kv_h) * K + offs_n[:, None]) * 128\n    42\t        + offs_d[None, :]\n    43\t    )\n    44\t    g = tl.load(g_ptrs, mask=offs_m[:, None] < Q, other=0.0)\n    45\t    v = tl.load(v_ptrs, mask=offs_n[:, None] < K, other=0.0)\n    46\t    acc = tl.dot(g, tl.trans(v))\n    47\t\n    48\t    out_offsets = (bh * Q + offs_m[:, None]) * K + offs_n[None, :]\n    49\t    valid = (offs_m[:, None] < Q) & (offs_n[None, :] < K)\n    50\t    keep = tl.load(mask_ptr + out_offsets, mask=valid, other=0)\n    51\t    # This is the reference's multiply-by-mask followed by division.\n    52\t    dropped = tl.where(keep, acc / KEEP_PROB, 0.0)\n    53\t    tl.store(grad_weights_ptr + out_offsets, dropped, mask=valid)\n    54\t\n    55\t\n    56\t@triton.jit\n    57\tdef _grad_scores_fused_kernel(\n    58\t    grad_out_ptr,\n    59\t    value_ptr,\n    60\t    mask_ptr,\n    61\t    weights_ptr,\n    62\t    grad_scores_ptr,\n    63\t    Q: tl.constexpr,\n    64\t    K: tl.constexpr,\n    65\t    KEEP_PROB,\n    66\t    BLOCK_M: tl.constexpr,\n    67\t    BLOCK_N: tl.constexpr,\n    68\t    BLOCK_D: tl.constexpr,\n    69\t):\n    70\t    tile_m = tl.program_id(0)\n    71\t    bh = tl.program_id(1)\n    72\t    b = bh // 80\n    73\t    h = bh - b * 80\n    74\t    kv_h = h // 10\n    75\t\n    76\t    offs_m = tile_m * BLOCK_M + tl.arange(0, BLOCK_M)\n    77\t    offs_n = tl.arange(0, BLOCK_N)\n    78\t    offs_d = tl.arange(0, BLOCK_D)\n    79\t    acc = tl.zeros((BLOCK_M, BLOCK_N), tl.float32)\n    80\t    for d_start in range(0, 128, BLOCK_D):\n    81\t        ds = d_start + offs_d\n    82\t        g_ptrs = (\n    83\t            grad_out_ptr\n    84\t            + ((b * Q + offs_m[:, None]) * 80 + h) * 128\n    85\t            + ds[None, :]\n    86\t        )\n    87\t        v_ptrs = (\n    88\t            value_ptr\n    89\t            + ((b * 8 + kv_h) * K + offs_n[:, None]) * 128\n    90\t            + ds[None, :]\n    91\t        )\n    92\t        g = tl.load(g_ptrs, mask=offs_m[:, None] < Q, other=0.0)\n    93\t        v = tl.load(v_ptrs, mask=offs_n[:, None] < K, other=0.0)\n    94\t        acc += tl.dot(g, tl.trans(v))\n    95\t\n    96\t    out_offsets = (bh * Q + offs_m[:, None]) * K + offs_n[None, :]\n    97\t    valid = (offs_m[:, None] < Q) & (offs_n[None, :] < K)\n    98\t    keep = tl.load(mask_ptr + out_offsets, mask=valid, other=0)\n    99\t    x = tl.where(keep, acc / KEEP_PROB, 0.0)\n   100\t    w = tl.load(weights_ptr + out_offsets, mask=valid, other=0.0).to(tl.float32)\n   101\t    sum_term = tl.sum(x * w, axis=1)\n   102\t    result = w * (x - sum_term[:, None])\n   103\t    tl.store(grad_scores_ptr + out_offsets, result, mask=valid)\n   104\t\n   105\t\n   106\t@triton.jit\n   107\tdef _softmax_backward_kernel(\n   108\t    grad_weights_ptr,\n   109\t    weights_ptr,\n   110\t    grad_scores_ptr,\n   111\t    K: tl.constexpr,\n   112\t    BLOCK_K: tl.constexpr,\n   113\t):\n   114\t    row = tl.program_id(0)\n   115\t    offs = tl.arange(0, BLOCK_K)\n   116\t    valid = offs < K\n   117\t    x = tl.load(grad_weights_ptr + row * K + offs, mask=valid, other=0.0)\n   118\t    w = tl.load(weights_ptr + row * K + offs, mask=valid, other=0.0).to(tl.float32)\n   119\t    sum_term = tl.sum(x * w, axis=0)\n   120\t    result = w * (x - sum_term)\n   121\t    tl.store(grad_scores_ptr + row * K + offs, result, mask=valid)\n   122\t\n   123\t\n   124\t@triton.jit\n   125\tdef _grad_value_kernel(\n   126\t    dropped_weights_ptr,\n   127\t    grad_out_ptr,\n   128\t    grad_value_ptr,\n   129\t    Q: tl.constexpr,\n   130\t    K: tl.constexpr,\n   131\t    BLOCK_K: tl.constexpr,\n   132\t    BLOCK_D: tl.constexpr,\n   133\t    BLOCK_Q: tl.constexpr,\n   134\t):\n   135\t    tile = tl.program_id(0)\n   136\t    bkv = tl.program_id(1)\n   137\t    num_d = tl.cdiv(128, BLOCK_D)\n   138\t    tile_k = tile // num_d\n   139\t    tile_d = tile - tile_k * num_d\n   140\t\n   141\t    b = bkv // 8\n   142\t    kv_h = bkv - b * 8\n   143\t    offs_k = tile_k * BLOCK_K + tl.arange(0, BLOCK_K)\n   144\t    offs_d = tile_d * BLOCK_D + tl.arange(0, BLOCK_D)\n   145\t\n   146\t    total = tl.zeros((BLOCK_K, BLOCK_D), tl.float32)\n   147\t    # Keeping one accumulator per attention head mirrors the two-stage\n   148\t    # reference: Q reduction in each GEMM, followed by the 10-head GQA sum.\n   149\t    for group in range(10):\n   150\t        h = kv_h * 10 + group\n   151\t        part = tl.zeros((BLOCK_K, BLOCK_D), tl.float32)\n   152\t        for q_start in range(0, Q, BLOCK_Q):\n   153\t            offs_q = q_start + tl.arange(0, BLOCK_Q)\n   154\t            w_ptrs = (\n   155\t                dropped_weights_ptr\n   156\t                + ((b * 80 + h) * Q + offs_q[:, None]) * K\n   157\t                + offs_k[None, :]\n   158\t            )\n   159\t            g_ptrs = (\n   160\t                grad_out_ptr\n   161\t                + ((b * Q + offs_q[:, None]) * 80 + h) * 128\n   162\t                + offs_d[None, :]\n   163\t            )\n   164\t            w = tl.load(\n   165\t                w_ptrs,\n   166\t                mask=(offs_q[:, None] < Q) & (offs_k[None, :] < K),\n   167\t                other=0.0,\n   168\t            )\n   169\t            g = tl.load(\n   170\t                g_ptrs,\n   171\t                mask=(offs_q[:, None] < Q) & (offs_d[None, :] < 128),\n   172\t                other=0.0,\n   173\t            )\n   174\t            part += tl.dot(tl.trans(w), g)\n   175\t        total += part\n   176\t\n   177\t    out_ptrs = (\n   178\t        grad_value_ptr\n   179\t        + ((b * 8 + kv_h) * K + offs_k[:, None]) * 128\n   180\t        + offs_d[None, :]\n   181\t    )\n   182\t    tl.store(\n   183\t        out_ptrs,\n   184\t        total,\n   185\t        mask=(offs_k[:, None] < K) & (offs_d[None, :] < 128),\n   186\t    )\n   187\t\n   188\t\n   189\t@torch.no_grad()\n   190\tdef run(\n   191\t    grad_attn_output,\n   192\t    attn_weights,\n   193\t    attn_weights_dropped,\n   194\t    value_states,\n   195\t    dropout_mask,\n   196\t    attention_dropout,\n   197\t):\n   198\t    batch_size, q_len, _, _ = grad_attn_output.shape\n   199\t    k_len = value_states.shape[2]\n   200\t\n   201\t    grad_scores = torch.empty_like(attn_weights)\n   202\t    grad_value = torch.empty_like(value_states)\n   203\t\n   204\t    if k_len <= 1024:\n   205\t        block_n = triton.next_power_of_2(k_len)\n   206\t        # Keep the accumulator at 16K elements while maximizing reuse of V.\n   207\t        block_m = 16384 // block_n\n   208\t   