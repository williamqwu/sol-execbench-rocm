{"type":"item.started","item":{"id":"item_38","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch,triton\nfrom kernel import _gqa_attention_kernel\nB,S=1,541\nfor scale in [1.,2.]:\n q=torch.randn(B,S,3584,device='cuda',dtype=torch.bfloat16)*scale;k=torch.randn(B,S,512,device='cuda',dtype=torch.bfloat16)*scale;v=torch.randn_like(k);m=torch.randn(B,1,S,S,device='cuda',dtype=torch.bfloat16);o=torch.empty_like(q)\n qv=q.view(B,S,28,128).transpose(1,2);kv=k.view(B,S,4,128).transpose(1,2);vv=v.view(B,S,4,128).transpose(1,2);kr=kv[:,:,None].expand(B,4,7,S,128).reshape(B,28,S,128);vr=vv[:,:,None].expand(B,4,7,S,128).reshape(B,28,S,128);ref=(torch.softmax(qv@kr.transpose(2,3)*(128**-.5)+m,dim=-1,dtype=torch.float32).to(torch.bfloat16)@vr).transpose(1,2).contiguous().view(B,S,3584)\n print('scale',scale)\n for bm,bn,nw in [(128,64,4),(32,16,2)]:\n  _gqa_attention_kernel[(triton.cdiv(S,bm),B*28)](q,k,v,m,o,N_CTX=S,BLOCK_M=bm,BLOCK_N=bn,ROUND_SCORES=False,num_warps=nw,num_stages=1,matrix_instr_nonkdim=16)\n  torch.cuda.synchronize();d=(o.float()-ref.float()).abs();print((bm,bn),d.max().item(),d.mean().item(),torch.isclose(o.float(),ref.float(),atol=.00769,rtol=.0078125).float().mean().item())\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
