{"type":"item.started","item":{"id":"item_35","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch,triton\nfrom kernel import _gqa_attention_kernel,_rope_qk_kernel\nB,S=32,541\nq=torch.randn(B,S,3584,device='cuda',dtype=torch.bfloat16);k=torch.randn(B,S,512,device='cuda',dtype=torch.bfloat16);v=torch.randn_like(k);m=torch.randn(B,1,S,S,device='cuda',dtype=torch.bfloat16);o=torch.empty_like(q)\nconfigs=[]\nfor bm,nw in [(64,4),(128,4),(256,4),(256,8)]:\n for bn in [32,64]:\n  for ns in [1,2,3]:\n   for mi in [0,16]: configs.append((bm,bn,nw,ns,mi))\nfor bm,bn,nw,ns,mi in configs:\n kw=dict(N_CTX=S,BLOCK_M=bm,BLOCK_N=bn,ROUND_SCORES=False,num_warps=nw,num_stages=ns)\n if mi:kw['matrix_instr_nonkdim']=mi\n grid=(triton.cdiv(S,bm),B*28)\n try:\n  for _ in range(2):_gqa_attention_kernel[grid](q,k,v,m,o,**kw)\n  torch.cuda.synchronize();a=torch.cuda.Event(True);b=torch.cuda.Event(True);a.record()\n  for _ in range(8):_gqa_attention_kernel[grid](q,k,v,m,o,**kw)\n  b.record();b.synchronize();val=a.elapsed_time(b)/8\n  if val<1.65:print((bm,bn,nw,ns,mi),val)\n except Exception as e: pass\nprint('rope')\nfor B,S in [(1,128),(4,128),(1,256),(1,512),(8,128)]:\n tok=B*S;q=torch.randn(B,S,3584,device='cuda',dtype=torch.bfloat16);k=torch.randn(B,S,512,device='cuda',dtype=torch.bfloat16);c=torch.randn(3,B,S,128,device='cuda',dtype=torch.bfloat16);s=torch.randn_like(c);qo=torch.empty_like(q);ko=torch.empty_like(k);nq=tok*3584;nk=tok*512\n vals=[]\n for block in [128,256,512,1024]:\n  grid=(triton.cdiv(nq+nk,block),)\n  for _ in range(2):_rope_qk_kernel[grid](q,k,c,s,qo,ko,nq,nk,tok,BLOCK=block,num_warps=4)\n  torch.cuda.synchronize();a=torch.cuda.Event(True);b=torch.cuda.Event(True);a.record()\n  for _ in range(30):_rope_qk_kernel[grid](q,k,c,s,qo,ko,nq,nk,tok,BLOCK=block,num_warps=4)\n  b.record();b.synchronize();vals.append((block,a.elapsed_time(b)/30))\n print((B,S),vals)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
