{"type":"item.started","item":{"id":"item_19","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch\nimport torch.nn.functional as F\nD='cuda'\nfor B,S in [(1,128),(1,613),(32,541),(64,256)]:\n x=torch.randn(B,S,3584,device=D,dtype=torch.bfloat16)\n qw=torch.randn(3584,3584,device=D,dtype=torch.bfloat16); qb=torch.randn(3584,device=D,dtype=torch.bfloat16)\n kw=torch.randn(512,3584,device=D,dtype=torch.bfloat16); kb=torch.randn(512,device=D,dtype=torch.bfloat16)\n vw=torch.randn(512,3584,device=D,dtype=torch.bfloat16); vb=torch.randn(512,device=D,dtype=torch.bfloat16)\n def sep(): return F.linear(x,qw,qb),F.linear(x,kw,kb),F.linear(x,vw,vb)\n def kv():\n  w=torch.cat((kw,vw),0); b=torch.cat((kb,vb),0); z=F.linear(x,w,b)\n  return F.linear(x,qw,qb),z[...,:512],z[...,512:]\n def all():\n  w=torch.cat((qw,kw,vw),0); b=torch.cat((qb,kb,vb),0); z=F.linear(x,w,b)\n  return z[...,:3584],z[...,3584:4096],z[...,4096:]\n print('shape',B,S)\n for name,fn in [('sep',sep),('kv',kv),('all',all)]:\n  for _ in range(3): fn()\n  torch.cuda.synchronize(); a=torch.cuda.Event(True); b=torch.cuda.Event(True); a.record()\n  for _ in range(20): fn()\n  b.record();b.synchronize();print(name,a.elapsed_time(b)/20)\n del x,qw,qb,kw,kb,vw,vb\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
