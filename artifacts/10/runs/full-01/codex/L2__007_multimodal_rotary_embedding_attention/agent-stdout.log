{"type":"item.started","item":{"id":"item_9","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch\nimport torch.nn.functional as F\nfrom torch.nn.attention import sdpa_kernel, SDPBackend\n\ntorch.set_default_device('cuda')\nB,S,D=1,4096,128\nq=torch.randn(B,28,S,D,dtype=torch.bfloat16)\nk=torch.randn(B,4,S,D,dtype=torch.bfloat16)\nv=torch.randn(B,4,S,D,dtype=torch.bfloat16)\nm=torch.randn(B,1,S,S,dtype=torch.bfloat16)\nkr=k[:,:,None].expand(B,4,7,S,D).reshape(B,28,S,D)\nvr=v[:,:,None].expand(B,4,7,S,D).reshape(B,28,S,D)\n\ndef ref():\n    p=torch.softmax(torch.matmul(q,kr.transpose(2,3))*(D**-0.5)+m,dim=-1,dtype=torch.float32).to(q.dtype)\n    return torch.matmul(p,vr)\ndef gqa(): return F.scaled_dot_product_attention(q,k,v,attn_mask=m,scale=D**-0.5,enable_gqa=True)\ndef equal(): return F.scaled_dot_product_attention(q,kr,vr,attn_mask=m,scale=D**-0.5)\ndef flash():\n    with sdpa_kernel(SDPBackend.FLASH_ATTENTION):\n        return F.scaled_dot_product_attention(q,kr,vr,attn_mask=m,scale=D**-0.5)\n\ndef bench(name,fn):\n    try:\n        for _ in range(2): fn()\n        torch.cuda.synchronize()\n        a=torch.cuda.Event(True); b=torch.cuda.Event(True)\n        a.record()\n        for _ in range(5): fn()\n        b.record(); b.synchronize()\n        print(name, a.elapsed_time(b)/5)\n    except Exception as e: print(name,'ERR',type(e).__name__,str(e)[:300])\nfor x in [('ref',ref),('gqa',gqa),('equal',equal),('flash',flash)]: bench(*x)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
