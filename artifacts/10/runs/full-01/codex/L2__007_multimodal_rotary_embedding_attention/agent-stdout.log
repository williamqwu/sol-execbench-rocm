{"type":"item.started","item":{"id":"item_20","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch,triton\nfrom kernel import _gqa_attention_kernel\n\ndef bench(B,S,configs):\n q=torch.randn(B,S,3584,device='cuda',dtype=torch.bfloat16)\n k=torch.randn(B,S,512,device='cuda',dtype=torch.bfloat16)\n v=torch.randn_like(k); m=torch.randn(B,1,S,S,device='cuda',dtype=torch.bfloat16); o=torch.empty_like(q)\n print('shape',B,S)\n for bm,bn,nw,wpe in configs:\n  kw=dict(N_CTX=S,BLOCK_M=bm,BLOCK_N=bn,num_warps=nw,num_stages=1)\n  if wpe: kw['waves_per_eu']=wpe\n  try:\n   grid=(triton.cdiv(S,bm),B*28)\n   for _ in range(3): _gqa_attention_kernel[grid](q,k,v,m,o,**kw)\n   torch.cuda.synchronize(); a=torch.cuda.Event(True);b=torch.cuda.Event(True);a.record()\n   for _ in range(10): _gqa_attention_kernel[grid](q,k,v,m,o,**kw)\n   b.record();b.synchronize();print((bm,bn,nw,wpe),a.elapsed_time(b)/10)\n  except Exception as e: print((bm,bn,nw,wpe),'ERR',str(e)[:160])\nconfigs=[(64,64,4,0),(64,64,4,1),(64,64,4,2),(64,64,4,3),(64,64,4,4),(32,64,4,0),(128,64,4,0),(64,128,4,0),(32,128,4,0),(128,128,8,0)]\nbench(32,541,configs)\nbench(1,4096,configs)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
