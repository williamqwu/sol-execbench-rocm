{"type":"item.completed","item":{"id":"item_23","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' kernel.py\"","aggregated_output":"import torch\nimport triton\nimport triton.language as tl\nfrom triton.language.extra import libdevice\n\n\nINNER_DIM = 5120\nINPUT_DIM = 10240\n\n\n@triton.jit\ndef _geglu_kernel(x_ptr, out_ptr, INNER: tl.constexpr,\n                  BLOCK: tl.constexpr, TANH_MODE: tl.constexpr,\n                  FORM_MODE: tl.constexpr):\n    row = tl.program_id(1)\n    cols = tl.program_id(0) * BLOCK + tl.arange(0, BLOCK)\n    mask = cols < INNER\n\n    gate = tl.load(x_ptr + row * (2 * INNER) + cols, mask=mask)\n    linear = tl.load(x_ptr + row * (2 * INNER) + INNER + cols, mask=mask)\n\n    if FORM_MODE == 1:\n        arg = gate * (0.7978845608028654 + 0.035677408136300125 * gate * gate)\n    else:\n        gate3 = gate * gate * gate\n        arg = 0.7978845608028654 * (gate + 0.044715 * gate3)\n    if TANH_MODE == 1:\n        tanh_arg = libdevice.fast_tanhf(arg)\n    elif TANH_MODE == 2:\n        exp_arg = libdevice.fast_expf(-2.0 * arg)\n        tanh_arg = 2.0 / (1.0 + exp_arg) - 1.0\n    else:\n        tanh_arg = libdevice.tanh(arg)\n    gelu = 0.5 * gate * (1.0 + tanh_arg)\n    tl.store(out_ptr + row * INNER + cols, gelu * linear, mask=mask)\n\n\n@triton.jit\ndef _geglu_grouped_kernel(x_ptr, out_ptr, n_rows,\n                          INNER: tl.constexpr, COLS: tl.constexpr,\n                          ROWS: tl.constexpr, BLOCK: tl.constexpr):\n    offsets = tl.arange(0, BLOCK)\n    local_row = offsets // COLS\n    row = tl.program_id(1) * ROWS + local_row\n    col = tl.program_id(0) * COLS + offsets % COLS\n    mask = (row < n_rows) & (col < INNER)\n\n    gate = tl.load(x_ptr + row * (2 * INNER) + col, mask=mask)\n    linear = tl.load(x_ptr + row * (2 * INNER) + INNER + col, mask=mask)\n    gate3 = gate * gate * gate\n    arg = 0.7978845608028654 * (gate + 0.044715 * gate3)\n    gelu = 0.5 * gate * (1.0 + libdevice.tanh(arg))\n    tl.store(out_ptr + row * INNER + col, gelu * linear, mask=mask)\n\n\ndef run(x: torch.Tensor) -> torch.Tensor:\n    rows = x.numel() // INPUT_DIM\n    out = torch.empty((*x.shape[:-1], INNER_DIM), device=x.device, dtype=x.dtype)\n    _geglu_kernel[(triton.cdiv(INNER_DIM, 256), rows)](\n        x, out, INNER_DIM, BLOCK=256, TANH_MODE=0, FORM_MODE=0,\n        num_warps=4\n    )\n    return out\n","exit_code":0,"status":"completed"}}
