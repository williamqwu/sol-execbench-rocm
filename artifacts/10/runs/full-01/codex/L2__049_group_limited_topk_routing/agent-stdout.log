{"type":"item.started","item":{"id":"item_89","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport torch\nimport torch.nn.functional as F\nfrom triton.testing import do_bench\nfor M in [2080,2112,2176,2272,2851,3557,4093,6144,8192,12288,16384]:\n h=torch.randn(M,4096,device='cuda',dtype=torch.bfloat16);w=torch.randn(256,4096,device='cuda',dtype=torch.bfloat16);hf=h.float();wf=w.float();ref=F.linear(hf,wf)\n def split2048():\n  out=torch.empty(M,256,device='cuda')\n  for st in range(0,M,2048): torch.mm(hf[st:st+2048],wf.T,out=out[st:st+2048])\n  return out\n o=split2048();print(M,'exact',torch.equal(o,ref),(o==ref).float().mean().item(),'full',do_bench(lambda:F.linear(hf,wf),warmup=20,rep=100),'split',do_bench(split2048,warmup=20,rep=100),flush=True)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
