{"type":"item.started","item":{"id":"item_87","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport torch,numpy as np\nimport torch.nn.functional as F\ntorch.manual_seed(11);M=1;N=256;h=torch.randn(M,4096,device='cuda',dtype=torch.bfloat16);w=torch.randn(N,4096,device='cuda',dtype=torch.bfloat16);ref=F.linear(h.float(),w.float()).cpu().numpy().reshape(N);a=h.cpu().float().numpy()[0];b=w.cpu().float().numpy();p=(b*a[None,:]).astype(np.float32)\ndef reduce_pair(x):\n while x.shape[1]>1:\n  if x.shape[1]%2: x=np.concatenate([x,np.zeros((x.shape[0],1),np.float32)],1)\n  x=(x[:,0::2]+x[:,1::2]).astype(np.float32)\n return x[:,0]\ndef report(n,x): print(n,np.mean(x==ref),np.max(np.abs(x-ref)),np.mean(np.abs(x-ref)))\nreport('pairall',reduce_pair(p.copy()))\nacc=np.zeros(N,np.float32)\nfor k in range(4096):acc=(acc+p[:,k]).astype(np.float32)\nreport('sequential',acc)\nfor P in [2,4,8,16,32,64]:\n accs=np.zeros((N,P),np.float32)\n for k in range(4096):\n  q=k%P;accs[:,q]=(accs[:,q]+p[:,k]).astype(np.float32)\n report('inter_pair'+str(P),reduce_pair(accs.copy()))\n q=accs[:,0]\n for j in range(1,P):q=(q+accs[:,j]).astype(np.float32)\n report('inter_seq'+str(P),q)\nfor G in [2,4,8,16,32,64,128,256]:\n acc=np.zeros(N,np.float32)\n for start in range(0,4096,G):\n  chunk=reduce_pair(p[:,start:start+G].copy())\n  acc=(acc+chunk).astype(np.float32)\n report('group_pair'+str(G),acc)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
