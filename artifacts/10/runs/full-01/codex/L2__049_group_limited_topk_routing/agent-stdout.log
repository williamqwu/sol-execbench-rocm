{"type":"item.started","item":{"id":"item_8","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport torch, time\nimport torch.nn.functional as F\n\ntorch.manual_seed(1)\nM=2048\nh=torch.randn(M,4096,device='cuda',dtype=torch.bfloat16)\nw=torch.randn(256,4096,device='cuda',dtype=torch.bfloat16)\nb=torch.randn(256,device='cuda',dtype=torch.bfloat16)\n\ndef route(logits):\n s=torch.sigmoid(logits); r=s+b.float(); gr=r.view(M,8,32)\n gs=torch.topk(gr,2,-1,sorted=False).values.sum(-1)\n gi=torch.topk(gs,4,-1,sorted=False).indices\n gm=torch.zeros_like(gs).scatter_(1,gi,1)\n masked=r.masked_fill(gm[:,:,None].expand_as(gr).reshape_as(r)==0,torch.finfo(torch.float32).min)\n idx=torch.topk(masked,8,-1,sorted=False).indices\n ss=torch.gather(s,1,idx); ow=ss/(ss.sum(-1,keepdim=True)+1e-20)*2.5\n return idx,ow\nlr=F.linear(h.float(),w.float()); ir,wr=route(lr)\nfor name, l in [('bf16_fp32',torch.mm(h,w.T,out_dtype=torch.float32)),('bf16',F.linear(h,w).float())]:\n i,ww=route(l)\n print(name,'log max/mean', (l-lr).abs().max().item(),(l-lr).abs().mean().item(), 'idx exact', (i==ir).float().mean().item(), 'rows', (i==ir).all(1).float().mean().item(),'w exact',(ww==wr).float().mean().item(),'werr',(ww-wr).abs().max().item())\n print('ref w unique approx',torch.unique(wr).numel(), 'saturated selected', ((wr==0.3125)).float().mean().item())\nfor fn in [lambda:F.linear(h.float(),w.float()),lambda:torch.mm(h,w.T,out_dtype=torch.float32),lambda:F.linear(h,w)]:\n for _ in range(2): fn()\n torch.cuda.synchronize(); t=time.perf_counter()\n for _ in range(10): fn()\n torch.cuda.synchronize(); print((time.perf_counter()-t)*100)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
