{"type":"item.completed","item":{"id":"item_55","type":"agent_message","text":"A safe vendor-kernel alternative emerged: rocBLAS produces bit-identical columns for 128-expert GEMMs, so the 256 experts can be split into two exact halves. I’m measuring those halves concurrently on separate GPU streams; this preserves full semantics and may shorten the dominant GEMM without changing any arithmetic."}}
{"type":"item.started","item":{"id":"item_56","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport torch\nimport torch.nn.functional as F\nfrom triton.testing import do_bench\nfor M in [2048,4093,16384]:\n h=torch.randn(M,4096,device='cuda',dtype=torch.bfloat16);w=torch.randn(256,4096,device='cuda',dtype=torch.bfloat16);hf=h.float();w0=w[:128].float();w1=w[128:].float();s0=torch.cuda.Stream();s1=torch.cuda.Stream();cur=torch.cuda.current_stream()\n def split():\n  hf=h.float(); s0.wait_stream(cur);s1.wait_stream(cur)\n  with torch.cuda.stream(s0): a=F.linear(hf,w[:128].float());a=torch.sigmoid(a)\n  with torch.cuda.stream(s1): b=F.linear(hf,w[128:].float());b=torch.sigmoid(b)\n  cur.wait_stream(s0);cur.wait_stream(s1)\n  return a,b\n def split_pre():\n  s0.wait_stream(cur);s1.wait_stream(cur)\n  with torch.cuda.stream(s0): a=F.linear(hf,w0)\n  with torch.cuda.stream(s1): b=F.linear(hf,w1)\n  cur.wait_stream(s0);cur.wait_stream(s1)\n  return a,b\n print('M',M,'n128',do_bench(lambda:F.linear(hf,w0),warmup=20,rep=100),'n256',do_bench(lambda:F.linear(hf,w.float()),warmup=20,rep=100),'splitpre',do_bench(split_pre,warmup=20,rep=100),'split',do_bench(split,warmup=20,rep=100),'base lin sig',do_bench(lambda:torch.sigmoid(F.linear(h.float(),w.float())),warmup=20,rep=100))\n a,b=split();r=torch.sigmoid(F.linear(h.float(),w.float()));print('exact',torch.equal(a,r[:,:128]),torch.equal(b,r[:,128:]))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
