{"type":"item.started","item":{"id":"item_15","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport torch, importlib.util, triton\nimport torch.nn.functional as F\nfrom triton.testing import do_bench\nspec=importlib.util.spec_from_file_location('k','kernel.py'); k=importlib.util.module_from_spec(spec); spec.loader.exec_module(k)\nfor M in (2048,16384):\n h=torch.randn(M,4096,device='cuda',dtype=torch.bfloat16); w=torch.randn(256,4096,device='cuda',dtype=torch.bfloat16); b=torch.randn(256,device='cuda',dtype=torch.bfloat16)\n s=torch.sigmoid(F.linear(h.float(),w.float())); o=torch.empty(M,8,device='cuda',dtype=torch.int64)\n print('M',M)\n for nw in (1,2,4,8):\n  try:\n   fn=lambda nw=nw:k._select_kernel[(M,)](s,b,o,M,num_warps=nw)\n   print('select nw',nw,do_bench(fn, warmup=20,rep=100))\n  except Exception as e: print('err',nw,e)\n print('ours full',do_bench(lambda:k.run(h,w,b,2.5),warmup=20,rep=100))\n def ref():\n  logits=F.linear(h.float(),w.float()); scores=torch.sigmoid(logits); routing=scores+b.float(); grouped=routing.view(M,8,32); gs=torch.topk(grouped,2,-1,sorted=False).values.sum(-1); gi=torch.topk(gs,4,-1,sorted=False).indices; gm=torch.zeros_like(gs);gm.scatter_(1,gi,1.); mask=gm[:,:,None].expand(M,8,32).reshape(M,256); masked=routing.masked_fill(mask==0,torch.finfo(torch.float32).min); idx=torch.topk(masked,8,-1,sorted=False).indices; ss=torch.gather(scores,1,idx); tw=ss/(ss.sum(-1,keepdim=True)+1e-20); return idx,tw*2.5\n print('ref full',do_bench(ref,warmup=20,rep=100))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
