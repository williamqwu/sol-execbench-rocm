{"type":"item.started","item":{"id":"item_95","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport torch\nimport torch.nn.functional as F\nfrom triton.testing import do_bench\n\ndef eager(h,w): return F.linear(h.float(),w.float()).sigmoid_()\nfor dynamic in [False,True]:\n try:\n  comp=torch.compile(eager,fullgraph=True,dynamic=dynamic)\n  for M in [2048,4093,16384]:\n   h=torch.randn(M,4096,device='cuda',dtype=torch.bfloat16);w=torch.randn(256,4096,device='cuda',dtype=torch.bfloat16);r=eager(h,w);o=comp(h,w);torch.cuda.synchronize();print('dyn',dynamic,M,'exact',torch.equal(o,r),'eager',do_bench(lambda:eager(h,w),warmup=30,rep=100),'comp',do_bench(lambda:comp(h,w),warmup=30,rep=100),flush=True)\n except Exception as e:print('ERR',dynamic,type(e).__name__,str(e)[:1000])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
