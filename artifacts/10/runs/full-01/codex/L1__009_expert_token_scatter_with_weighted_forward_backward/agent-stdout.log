{"type":"item.started","item":{"id":"item_10","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch, reference\n\ndef eager(*a):\n    (grad_output, token_indices, selected_tokens, w1_output, gate_output,\n     up_output, gated_output, expert_output, selected_weights,\n     w1_weight, w2_weight, w3_weight) = a\n    B=grad_output.shape[0]\n    go=grad_output[token_indices]\n    ge=go*selected_weights[:,None]\n    gw2=ge.T@gated_output\n    gg=ge@w2_weight\n    gu=gg*gate_output\n    z=w1_output.float(); s=torch.sigmoid(z)\n    g1=(gg.float()*up_output.float()*(s*(1+z*(1-s)))).bfloat16()\n    gw1=g1.T@selected_tokens\n    gw3=gu.T@selected_tokens\n    gx=torch.addmm(gu@w3_weight,g1,w1_weight)\n    gh=torch.zeros_like(grad_output); gh[token_indices]=gx\n    gr=torch.zeros(B,dtype=torch.bfloat16,device=grad_output.device)\n    gr[token_indices]=(go.float()*expert_output.float()).sum(-1).bfloat16()\n    return gh,gr,gw1,gw2,gw3\n\ncompiled=torch.compile(eager,fullgraph=True,dynamic=True)\nfor B,M in [(512,64),(1024,512),(4096,2048)]:\n a=reference.get_inputs(dict(batch_seq_len=B,num_tokens=M,hidden_dim=4096,ffn_dim=14336),torch.device('cuda'))\n print('compile/run',B,M,flush=True)\n for _ in range(3): o=compiled(*a.values())\n torch.cuda.synchronize()\n ts=[]\n for _ in range(10):\n  st=torch.cuda.Event(True); en=torch.cuda.Event(True); st.record(); o=compiled(*a.values()); en.record(); en.synchronize();ts.append(st.elapsed_time(en))\n print(B,M,ts,flush=True)\n del a,o\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
