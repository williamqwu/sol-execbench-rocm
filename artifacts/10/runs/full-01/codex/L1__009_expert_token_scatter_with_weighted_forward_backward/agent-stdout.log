{"type":"item.started","item":{"id":"item_6","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport json, torch\nimport reference\n\ndef opt(*a):\n    (grad_output, token_indices, selected_tokens, w1_output, gate_output,\n     up_output, gated_output, expert_output, selected_weights,\n     w1_weight, w2_weight, w3_weight) = a\n    go = grad_output[token_indices]\n    ge = go * selected_weights[:,None]\n    gw2 = ge.T @ gated_output\n    gg = ge @ w2_weight\n    gu = gg * gate_output\n    gg1 = gg.float() * up_output.float()\n    z = w1_output.float(); s = torch.sigmoid(z)\n    g1 = (gg1 * (s * (1 + z * (1-s)))).bfloat16()\n    gw1 = g1.T @ selected_tokens\n    gw3 = gu.T @ selected_tokens\n    gx = g1 @ w1_weight + gu @ w3_weight\n    gh = torch.zeros_like(grad_output); gh[token_indices] = gx\n    grs = (go.float()*expert_output.float()).sum(-1).bfloat16()\n    gr = torch.zeros(grad_output.shape[0],device='cuda',dtype=torch.bfloat16); gr[token_indices]=grs\n    return gh,gr,gw1,gw2,gw3\n\ndef check(B,M,atol):\n    a=reference.get_inputs(dict(batch_seq_len=B,num_tokens=M,hidden_dim=4096,ffn_dim=14336),torch.device('cuda'))\n    r=reference.run(*a.values()); o=opt(*a.values()); torch.cuda.synchronize()\n    print('shape',B,M)\n    for i,(x,y) in enumerate(zip(o,r)):\n        d=(x.float()-y.float()).abs(); ok=torch.isclose(x.float(),y.float(),atol=atol,rtol=.0078125)\n        print(i,'ratio',ok.float().mean().item(),'max',d.max().item(),'mean',d.mean().item())\n    del a,r,o\ncheck(512,64,.02615093657433834)\ncheck(512,256,.05212943003988751)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
