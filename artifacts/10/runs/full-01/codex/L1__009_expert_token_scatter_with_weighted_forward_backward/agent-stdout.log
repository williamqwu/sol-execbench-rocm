{"type":"item.started","item":{"id":"item_36","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch,reference\n@torch.no_grad()\ndef opt(*a):\n go0,ids,x,z0,gate,up,gated,expert,sw,w1,w2,w3=a;go=go0[ids];ge=go*sw[:,None];gw2=ge.T@gated;gg=ge@w2;gu=gg*gate;z=z0.float();s=torch.sigmoid(z);g1=((gg*up).float()*(s*(1+z*(1-s)))).bfloat16();gw1=g1.T@x;gw3=gu.T@x;gx=torch.addmm(gu@w3,g1,w1);gh=torch.zeros_like(go0);gh[ids]=gx;gr=torch.zeros(go0.shape[0],device='cuda',dtype=torch.bfloat16);gr[ids]=(go.float()*expert.float()).sum(-1).bfloat16();return gh,gr,gw1,gw2,gw3\nfor B,M,at in [(512,64,.0261509),(512,256,.0521294),(4096,2048,.1399878)]:\n a=reference.get_inputs(dict(batch_seq_len=B,num_tokens=M,hidden_dim=4096,ffn_dim=14336),torch.device('cuda'));r=reference.run(*a.values());o=opt(*a.values());print(B,M)\n for i,(u,v) in enumerate(zip(o,r)):\n  ok=torch.isclose(u.float(),v.float(),atol=at,rtol=.0078125);print(i,ok.float().mean().item(),(u.float()-v.float()).abs().max().item())\n del a,r,o\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
