{"type":"item.started","item":{"id":"item_35","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch\n\ndef cur(gg,up,z0,gate,x,w1,w3):\n gu=gg*gate;z=z0.float();s=torch.sigmoid(z);g1=(gg.float()*up.float()*(s*(1+z*(1-s)))).bfloat16();p=torch.cat((g1,gu),1).T@x;gx=torch.addmm(gu@w3,g1,w1);return p,gx\n\ndef lay(gg,up,z0,gate,x,w1,w3):\n gu=gg*gate;z=z0.float();s=torch.sigmoid(z);g1=(gg.float()*up.float()*(s*(1+z*(1-s)))).bfloat16();pair=torch.stack((g1.T,gu.T),0); flat=pair.reshape(-1,gg.shape[0]);p=flat@x;gx=torch.addmm(pair[1].T@w3,pair[0].T,w1);return p,gx\nfc=torch.compile(cur,fullgraph=True,dynamic=True);fl=torch.compile(lay,fullgraph=True,dynamic=True)\nF=14336;H=4096;w1=torch.randn((F,H),device='cuda',dtype=torch.bfloat16);w3=torch.randn_like(w1)\nfor M in [64,128,256,512,2048]:\n gg=torch.randn((M,F),device='cuda',dtype=torch.bfloat16);up=torch.randn_like(gg);z=torch.randn_like(gg);gate=torch.randn_like(gg);x=torch.randn((M,H),device='cuda',dtype=torch.bfloat16)\n print('M',M,flush=True)\n for _ in range(3):fc(gg,up,z,gate,x,w1,w3);fl(gg,up,z,gate,x,w1,w3)\n torch.cuda.synchronize();out={}\n for name,f in [('cur',fc),('layout',fl)]:\n  ts=[]\n  for _ in range(15):\n   st=torch.cuda.Event(True);en=torch.cuda.Event(True);st.record();o=f(gg,up,z,gate,x,w1,w3);en.record();en.synchronize();ts.append(st.elapsed_time(en))\n  out[name]=sum(sorted(ts)[3:12])/9\n print(out,flush=True);del gg,up,z,gate,x,o\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
