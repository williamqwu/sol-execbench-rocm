{"type":"item.started","item":{"id":"item_11","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch, reference\n\ndef combo(*a):\n    (grad_output, token_indices, x, z0, gate, up, gated, expert,\n     sw, w1, w2, w3) = a\n    B=grad_output.shape[0]\n    go=grad_output[token_indices]\n    ge=go*sw[:,None]\n    gw2=ge.T@gated\n    gg=ge@w2\n    gu=gg*gate\n    z=z0.float(); s=torch.sigmoid(z)\n    g1=(gg.float()*up.float()*(s*(1+z*(1-s)))).bfloat16()\n    both=torch.cat((g1,gu),1)\n    gw13=both.T@x\n    gx=torch.addmm(gu@w3,g1,w1)\n    gh=torch.zeros_like(grad_output); gh[token_indices]=gx\n    gr=torch.zeros(B,dtype=torch.bfloat16,device=grad_output.device)\n    gr[token_indices]=(go.float()*expert.float()).sum(-1).bfloat16()\n    F=z0.shape[1]\n    return gh,gr,gw13[:F],gw2,gw13[F:]\n\ncompiled=torch.compile(combo,fullgraph=True,dynamic=True)\nfor B,M in [(512,64),(1024,512),(4096,2048)]:\n a=reference.get_inputs(dict(batch_seq_len=B,num_tokens=M,hidden_dim=4096,ffn_dim=14336),torch.device('cuda'))\n print('run',B,M,flush=True)\n for _ in range(3): o=compiled(*a.values())\n torch.cuda.synchronize(); ts=[]\n for _ in range(10):\n  st=torch.cuda.Event(True);en=torch.cuda.Event(True);st.record();o=compiled(*a.values());en.record();en.synchronize();ts.append(st.elapsed_time(en))\n print(ts,flush=True)\n del a,o\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
