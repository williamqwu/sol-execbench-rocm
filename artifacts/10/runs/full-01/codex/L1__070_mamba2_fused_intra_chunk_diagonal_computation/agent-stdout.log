{"type":"item.started","item":{"id":"item_67","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch,triton,kernel,reference\ncfg=[(32,64,32,4),(32,128,32,4),(64,32,32,4),(64,64,32,4),(64,64,64,4),(64,64,128,4),(64,64,128,8),(64,128,32,4)]\nfor z in [1,2,4,8]:\n x=torch.randn((1,z,128,32,128),device='cuda',dtype=torch.bfloat16);a=torch.randn((1,32,z,128),device='cuda',dtype=torch.bfloat16)*.01;b=torch.randn((1,z,128,8,128),device='cuda',dtype=torch.bfloat16);c=torch.randn_like(b);y=torch.empty_like(x)\n vals=[]\n for bm,bd,sb,nw in cfg:\n  def fn():kernel._fully_fused_kernel[((128//bm)*(128//bd),z*32)](x,a,b,c,y,num_chunks=z,BLOCK_M=bm,BLOCK_D=bd,BLOCK_K=bm,STATE_BLOCK=sb,num_warps=nw,num_stages=1)\n  try:\n   fn();torch.cuda.synchronize();vals.append(round(triton.testing.do_bench(fn,warmup=20,rep=80),5))\n  except Exception as e:vals.append('E:'+str(e).splitlines()[-1])\n print(z,'fused',vals,'two',round(triton.testing.do_bench(lambda:kernel.run(x,a,b,c),warmup=20,rep=80),5))\n if z==1:\n  fn();r=reference.run(x,a,b,c);d=(y.float()-r.float()).abs();tol=.093+.0078125*r.float().abs();print('ratio last',float((d<=tol).float().mean()))\nprint(cfg)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
