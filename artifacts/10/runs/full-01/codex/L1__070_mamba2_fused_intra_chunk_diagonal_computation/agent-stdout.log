{"type":"item.started","item":{"id":"item_17","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch, triton\nimport kernel, reference\nfor seed in range(3):\n torch.manual_seed(seed)\n x=torch.randn((1,1,128,32,128),device='cuda',dtype=torch.bfloat16)\n a=torch.randn((1,32,1,128),device='cuda',dtype=torch.bfloat16)*.01\n b=torch.randn((1,1,128,8,128),device='cuda',dtype=torch.bfloat16)\n c=torch.randn_like(b)\n y=kernel.run(x,a,b,c); r=reference.run(x,a,b,c)\n d=(y.float()-r.float()).abs(); tol=.093 + .0078125*r.float().abs()\n print(seed,'ratio',float((d<=tol).float().mean()),'mean',float(d.mean()),'max',float(d.max()),'exact',float((y==r).float().mean()))\nfor b,nc in [(1,1),(1,8),(4,16)]:\n x=torch.randn((b,nc,128,32,128),device='cuda',dtype=torch.bfloat16)\n a=torch.randn((b,32,nc,128),device='cuda',dtype=torch.bfloat16)*.01\n bb=torch.randn((b,nc,128,8,128),device='cuda',dtype=torch.bfloat16)\n c=torch.randn_like(bb)\n for _ in range(2): kernel.run(x,a,bb,c)\n ms=triton.testing.do_bench(lambda: kernel.run(x,a,bb,c),warmup=30,rep=100)\n print('bench',b,nc,ms)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
