{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' definition.json && sed -n '1,320p' reference.py && sed -n '1,240p' workload.jsonl\"","aggregated_output":"{\n  \"name\": \"077_sam_hq_vision_encoder_window_partition_attention\",\n  \"description\": \"SAM-HQ's windowed attention mechanism that fuses window partitioning, multi-head attention with 2D relative position embeddings, window unpartitioning, residual connections, layer normalization, and MLP block. Processes image patches in 14x14 windows for efficient local attention computation.\",\n  \"hf_id\": \"syscv-community/sam-hq-vit-base\",\n  \"custom_inputs_entrypoint\": null,\n  \"axes\": {\n    \"batch_size\": {\n      \"type\": \"var\"\n    },\n    \"height\": {\n      \"type\": \"var\"\n    },\n    \"width\": {\n      \"type\": \"var\"\n    },\n    \"hidden_size\": {\n      \"type\": \"const\",\n      \"value\": 768\n    },\n    \"num_attention_heads\": {\n      \"type\": \"const\",\n      \"value\": 12\n    },\n    \"head_dim\": {\n      \"type\": \"const\",\n      \"value\": 64\n    },\n    \"window_size\": {\n      \"type\": \"const\",\n      \"value\": 14\n    },\n    \"mlp_dim\": {\n      \"type\": \"const\",\n      \"value\": 3072\n    },\n    \"rel_pos_size\": {\n      \"type\": \"const\",\n      \"value\": 27\n    },\n    \"qkv_out_size\": {\n      \"type\": \"const\",\n      \"value\": 2304\n    }\n  },\n  \"inputs\": {\n    \"hidden_states\": {\n      \"shape\": [\n        \"batch_size\",\n        \"height\",\n        \"width\",\n        \"hidden_size\"\n      ],\n      \"dtype\": \"float32\",\n      \"description\": \"Input hidden states from previous layer\"\n    },\n    \"qkv_weight\": {\n      \"shape\": [\n        \"qkv_out_size\",\n        \"hidden_size\"\n      ],\n      \"dtype\": \"float32\",\n      \"description\": \"QKV projection weight (768*3, 768)\"\n    },\n    \"qkv_bias\": {\n      \"shape\": [\n        \"qkv_out_size\"\n      ],\n      \"dtype\": \"float32\",\n      \"description\": \"QKV projection bias\"\n    },\n    \"proj_weight\": {\n      \"shape\": [\n        \"hidden_size\",\n        \"hidden_size\"\n      ],\n      \"dtype\": \"float32\",\n      \"description\": \"Output projection weight\"\n    },\n    \"proj_bias\": {\n      \"shape\": [\n        \"hidden_size\"\n      ],\n      \"dtype\": \"float32\",\n      \"description\": \"Output projection bias\"\n    },\n    \"rel_pos_h\": {\n      \"shape\": [\n        \"rel_pos_size\",\n        \"head_dim\"\n      ],\n      \"dtype\": \"float32\",\n      \"description\": \"Relative position embeddings for height (2*window_size-1, head_dim)\"\n    },\n    \"rel_pos_w\": {\n      \"shape\": [\n        \"rel_pos_size\",\n        \"head_dim\"\n      ],\n      \"dtype\": \"float32\",\n      \"description\": \"Relative position embeddings for width (2*window_size-1, head_dim)\"\n    },\n    \"layer_norm1_weight\": {\n      \"shape\": [\n        \"hidden_size\"\n      ],\n      \"dtype\": \"float32\",\n      \"description\": \"Layer norm 1 weight\"\n    },\n    \"layer_norm1_bias\": {\n      \"shape\": [\n        \"hidden_size\"\n      ],\n      \"dtype\": \"float32\",\n      \"description\": \"Layer norm 1 bias\"\n    },\n    \"layer_norm2_weight\": {\n      \"shape\": [\n        \"hidden_size\"\n      ],\n      \"dtype\": \"float32\",\n      \"description\": \"Layer norm 2 weight\"\n    },\n    \"layer_norm2_bias\": {\n      \"shape\": [\n        \"hidden_size\"\n      ],\n      \"dtype\": \"float32\",\n      \"description\": \"Layer norm 2 bias\"\n    },\n    \"mlp_lin1_weight\": {\n      \"shape\": [\n        \"mlp_dim\",\n        \"hidden_size\"\n      ],\n      \"dtype\": \"float32\",\n      \"description\": \"MLP first linear weight\"\n    },\n    \"mlp_lin1_bias\": {\n      \"shape\": [\n        \"mlp_dim\"\n      ],\n      \"dtype\": \"float32\",\n      \"description\": \"MLP first linear bias\"\n    },\n    \"mlp_lin2_weight\": {\n      \"shape\": [\n        \"hidden_size\",\n        \"mlp_dim\"\n      ],\n      \"dtype\": \"float32\",\n      \"description\": \"MLP second linear weight\"\n    },\n    \"mlp_lin2_bias\": {\n      \"shape\": [\n        \"hidden_size\"\n      ],\n      \"dtype\": \"float32\",\n      \"description\": \"MLP second linear bias\"\n    },\n    \"layer_norm_eps\": {\n      \"shape\": null,\n      \"dtype\": \"float32\",\n      \"description\": \"Layer normalization epsilon\"\n    }\n  },\n  \"outputs\": {\n    \"output\": {\n      \"shape\": [\n        \"batch_size\",\n        \"height\",\n        \"width\",\n        \"hidden_size\"\n      ],\n      \"dtype\": \"float32\",\n      \"description\": \"Output hidden states after windowed attention and MLP\"\n    }\n  },\n  \"reference\": \"import torch\\nimport torch.nn.functional as F\\n\\n@torch.no_grad()\\ndef run(\\n    hidden_states: torch.Tensor,\\n    qkv_weight: torch.Tensor,\\n    qkv_bias: torch.Tensor,\\n    proj_weight: torch.Tensor,\\n    proj_bias: torch.Tensor,\\n    rel_pos_h: torch.Tensor,\\n    rel_pos_w: torch.Tensor,\\n    layer_norm1_weight: torch.Tensor,\\n    layer_norm1_bias: torch.Tensor,\\n    layer_norm2_weight: torch.Tensor,\\n    layer_norm2_bias: torch.Tensor,\\n    mlp_lin1_weight: torch.Tensor,\\n    mlp_lin1_bias: torch.Tensor,\\n    mlp_lin2_weight: torch.Tensor,\\n    mlp_lin2_bias: torch.Tensor,\\n    layer_norm_eps: float,\\n):\\n    # Constants\\n    window_size = 14\\n    num_attention_heads = 12\\n    head_dim = 64\\n    scale = head_dim ** -0.5\\n    \\n    batch_size, height, width, channels = hidden_states.shape\\n    \\n    # Store for residual\\n    residual = hidden_states\\n    \\n    # Layer norm 1\\n    mean = hidden_states.mean(dim=-1, keepdim=True)\\n    var = hidden_states.var(dim=-1, keepdim=True, unbiased=False)\\n    hidden_states = (hidden_states - mean) / torch.sqrt(var + layer_norm_eps)\\n    hidden_states = hidden_states * layer_norm1_weight + layer_norm1_bias\\n    \\n    # Window partition with padding\\n    pad_h = (window_size - height % window_size) % window_size\\n    pad_w = (window_size - width % window_size) % window_size\\n    \\n    if pad_h > 0 or pad_w > 0:\\n        hidden_states = F.pad(hidden_states, (0, 0, 0, pad_w, 0, pad_h))\\n    \\n    pad_height = height + pad_h\\n    pad_width = width + pad_w\\n    \\n    # Reshape into windows\\n    hidden_states = hidden_states.reshape(\\n        batch_size,\\n        pad_height // window_size,\\n        window_size,\\n        pad_width // window_size,\\n        window_size,\\n        channels\\n    )\\n    windows = hidden_states.permute(0, 1, 3, 2, 4, 5).contiguous()\\n    windows = windows.reshape(-1, window_size, window_size, channels)\\n    \\n    batch_windows = windows.shape[0]\\n    window_h = window_size\\n    window_w = window_size\\n    \\n    # QKV projection\\n    qkv = F.linear(windows, qkv_weight, qkv_bias)\\n    qkv = qkv.reshape(batch_windows, window_h * window_w, 3, num_attention_heads, head_dim)\\n    qkv = qkv.permute(2, 0, 3, 1, 4)  # (3, batch_windows, num_heads, seq_len, head_dim)\\n    \\n    query, key, value = qkv[0], qkv[1], qkv[2]\\n    \\n    # Attention scores\\n    attn_weights = (query @ key.transpose(-2, -1)) * scale\\n    \\n    # Compute relative position bias\\n    coords_h = torch.arange(window_h, device=rel_pos_h.device)\\n    coords_w = torch.arange(window_w, device=rel_pos_w.device)\\n    \\n    rel_coords_h = coords_h[:, None] - coords_h[None, :]\\n    rel_coords_w = coords_w[:, None] - coords_w[None, :]\\n    \\n    rel_coords_h = rel_coords_h + window_h - 1\\n    rel_coords_w = rel_coords_w + window_w - 1\\n    \\n    # rel_pos_h_emb shape: [window_h, window_h, head_dim] where first dim is query pos, second is key pos\\n    rel_pos_h_emb = rel_pos_h[rel_coords_h.flatten()].reshape(\\n        window_h, window_h, head_dim\\n    )\\n    # rel_pos_w_emb shape: [window_w, window_w, head_dim]\\n    rel_pos_w_emb = rel_pos_w[rel_coords_w.flatten()].reshape(\\n        window_w, window_w, head_dim\\n    )\\n    \\n    # Reshape query for bias computation\\n    # query shape: [batch_windows, num_heads, window_h * window_w, head_dim]\\n    query_for_bias = query.reshape(\\n        batch_windows, num_attention_heads, window_h, window_w, head_dim\\n    )\\n    \\n    # Compute height bias: query_for_bias[b,n,qh,qw,c] * rel_pos_h_emb[qh,kh,c] -> [b,n,qh,qw,kh]\\n    # Using einsum with distinct subscripts\\n    rel_h = torch.einsum('bnijc,ikc->bnijk', query_for_bias, rel_pos_h_emb)\\n    # Compute width bias: query_for_bias[b,n,qh,qw,c] * rel_pos_w_emb[qw,kw,c] -> [b,n,qh,qw,kw]\\n    rel_w = torch.einsum('bnijc,jkc->bnijk', query_for_bias, rel_pos_w_emb)\\n    \\n    # Combine biases: [b,n,qh,qw,kh] + [b,n,qh,qw,kw] -> [b,n,qh,qw,kh,kw]\\n    rel_pos_bias = rel_h[:, :, :, :, :, None] + rel_w[:, :, :, :, None, :]\\n    rel_pos_bias = rel_pos_bias.reshape(\\n        batch_windows, num_attention_heads, window_h * window_w, window_h * window_w\\n    )\\n    \\n    attn_weights = attn_weights + rel_pos_bias\\n    \\n    # Softmax\\n    attn_weights = F.softmax(attn_weights, dim=-1, dtype=torch.float32).to(query.dtype)\\n    \\n    # Apply attention to values\\n    attn_output = attn_weights @ value\\n    attn_output = attn_output.transpose(1, 2).reshape(batch_windows, window_h, window_w, channels)\\n    \\n    # Output projection\\n    attn_output = F.linear(attn_output, proj_weight, proj_bias)\\n    \\n    # Window unpartition\\n    num_windows_h = pad_height // window_size\\n    num_windows_w = pad_width // window_size\\n    \\n    attn_output = attn_output.reshape(\\n        batch_size,\\n        num_windows_h,\\n        num_windows_w,\\n        window_size,\\n        window_size,\\n        -1\\n    )\\n    attn_output = attn_output.permute(0, 1, 3, 2, 4, 5).contiguous()\\n    attn_output = attn_output.reshape(batch_size, pad_height, pad_width, -1)\\n    \\n    # Remove padding\\n    attn_output = attn_output[:, :height, :width, :].contiguous()\\n    \\n    # First residual connection\\n    hidden_states = residual + attn_output\\n    \\n    # MLP block with second residual\\n    residual = hidden_states\\n    \\n    # Layer norm 2\\n    mean = hidden_states.mean(dim=-1, keepdim=True)\\n    var = hidden_states.var(dim=-1, keepdim=True, unbiased=False)\\n    hidden_states = (hidden_states - mean) / torch.sqrt(var + layer_norm_eps)\\n    hidden_states = hidden_states * layer_norm2_weight + layer_norm2_bias\\n    \\n    # MLP\\n    hidden_states = F.linear(hidden_states, mlp_lin1_weight, mlp_lin1_bias)\\n    hidden_states = F.gelu(hidden_states)\\n    hidden_states = F.linear(hidden_states, mlp_lin2_weight, mlp_lin2_bias)\\n    \\n    # Second residual connection\\n    output = residual + hidden_states\\n    \\n    return output\\n\"\n}\nimport torch\nimport torch.nn.functional as F\n\n@torch.no_grad()\ndef run(\n    hidden_states: torch.Tensor,\n    qkv_weight: torch.Tensor,\n    qkv_bias: torch.Tensor,\n    proj_weight: torch.Tensor,\n    proj_bias: torch.Tensor,\n    rel_pos_h: torch.Tensor,\n    rel_pos_w: torch.Tensor,\n    layer_norm1_weight: torch.Tensor,\n    layer_norm1_bias: torch.Tensor,\n    layer_norm2_weight: torch.Tensor,\n    layer_norm2_bias: torch.Tensor,\n    mlp_lin1_weight: torch.Tensor,\n    mlp_lin1_bias: torch.Tensor,\n    mlp_lin2_weight: torch.Tensor,\n    mlp_lin2_bias: torch.Tensor,\n    layer_norm_eps: float,\n):\n    # Constants\n    window_size = 14\n    num_attention_heads = 12\n    head_dim = 64\n    scale = head_dim ** -0.5\n    \n    batch_size, height, width, channels = hidden_states.shape\n    \n    # Store for residual\n    residual = hidden_states\n    \n    # Layer norm 1\n    mean = hidden_states.mean(dim=-1, keepdim=True)\n    var = hidden_states.var(dim=-1, keepdim=True, unbiased=False)\n    hidden_states = (hidden_states - mean) / torch.sqrt(var + layer_norm_eps)\n    hidden_states = hidden_states * layer_norm1_weight + layer_norm1_bias\n    \n    # Window partition with padding\n    pad_h = (window_size - height % window_size) % window_size\n    pad_w = (window_size - width % window_size) % window_size\n    \n    if pad_h > 0 or pad_w > 0:\n        hidden_states = F.pad(hidden_states, (0, 0, 0, pad_w, 0, pad_h))\n    \n    pad_height = height + pad_h\n    pad_width = width + pad_w\n    \n    # Reshape into windows\n    hidden_states = hidden_states.reshape(\n        batch_size,\n        pad_height // window_size,\n        window_size,\n        pad_width // window_size,\n        window_size,\n        channels\n    )\n    windows = hidden_states.permute(0, 1, 3, 2, 4, 5).contiguous()\n    windows = windows.reshape(-1, window_size, window_size, channels)\n    \n    batch_windows = windows.shape[0]\n    window_h = window_size\n    window_w = window_size\n    \n    # QKV projection\n    qkv = F.linear(windows, qkv_weight, qkv_bias)\n    qkv = qkv.reshape(batch_windows, window_h * window_w, 3, num_attention_heads, head_dim)\n    qkv = qkv.permute(2, 0, 3, 1, 4)  # (3, batch_windows, num_heads, seq_len, head_dim)\n    \n    query, key, value = qkv[0], qkv[1], qkv[2]\n    \n    # Attention scores\n    attn_weights = (query @ key.transpose(-2, -1)) * scale\n    \n    # Compute relative position bias\n    coords_h = torch.arange(window_h, device=rel_pos_h.device)\n    coords_w = torch.arange(window_w, device=rel_pos_w.device)\n    \n    rel_coords_h = coords_h[:, None] - coords_h[None, :]\n    rel_coords_w = coords_w[:, None] - coords_w[None, :]\n    \n    rel_coords_h = rel_coords_h + window_h - 1\n    rel_coords_w = rel_coords_w + window_w - 1\n    \n    # rel_pos_h_emb shape: [window_h, window_h, head_dim] where first dim is query pos, second is key pos\n    rel_pos_h_emb = rel_pos_h[rel_coords_h.flatten()].reshape(\n        window_h, window_h, head_dim\n    )\n    # rel_pos_w_emb shape: [window_w, window_w, head_dim]\n    rel_pos_w_emb = rel_pos_w[rel_coords_w.flatten()].reshape(\n        window_w, window_w, head_dim\n    )\n    \n    # Reshape query for bias computation\n    # query shape: [batch_windows, num_heads, window_h * window_w, head_dim]\n    query_for_bias = query.reshape(\n        batch_windows, num_attention_heads, window_h, window_w, head_dim\n    )\n    \n    # Compute height bias: query_for_bias[b,n,qh,qw,c] * rel_pos_h_emb[qh,kh,c] -> [b,n,qh,qw,kh]\n    # Using einsum with distinct subscripts\n    rel_h = torch.einsum('bnijc,ikc->bnijk', query_for_bias, rel_pos_h_emb)\n    # Compute width bias: query_for_bias[b,n,qh,qw,c] * rel_pos_w_emb[qw,kw,c] -> [b,n,qh,qw,kw]\n    rel_w = torch.einsum('bnijc,jkc->bnijk', query_for_bias, rel_pos_w_emb)\n    \n    # Combine biases: [b,n,qh,qw,kh] + [b,n,qh,qw,kw] -> [b,n,qh,qw,kh,kw]\n    rel_pos_bias = rel_h[:, :, :, :, :, None] + rel_w[:, :, :, :, None, :]\n    rel_pos_bias = rel_pos_bias.reshape(\n        batch_windows, num_attention_heads, window_h * window_w, window_h * window_w\n    )\n    \n    attn_weights = attn_weights + rel_pos_bias\n    \n    # Softmax\n    attn_weights = F.softmax(attn_weights, dim=-1, dtype=torch.float32).to(query.dtype)\n    \n    # Apply attention to values\n    attn_output = attn_weights @ value\n    attn_output = attn_output.transpose(1, 2).reshape(batch_windows, window_h, window_w, channels)\n    \n    # Output projection\n    attn_output = F.linear(attn_output, proj_weight, proj_bias)\n    \n    # Window unpartition\n    num_windows_h = pad_height // window_size\n    num_windows_w = pad_width // window_size\n    \n    attn_output = attn_output.reshape(\n        batch_size,\n        num_windows_h,\n        num_windows_w,\n        window_size,\n        window_size,\n        -1\n    )\n    attn_output = attn_output.permute(0, 1, 3, 2, 4, 5).contiguous()\n    attn_output = attn_output.reshape(batch_size, pad_height, pad_width, -1)\n    \n    # Remove padding\n    attn_output = attn_output[:, :height, :width, :].contiguous()\n    \n    # First residual connection\n    hidden_states = residual + attn_output\n    \n    # MLP block with second residual\n    residual = hidden_states\n    \n    # Layer norm 2\n    mean = hidden_states.mean(dim=-1, keepdim=True)\n    var = hidden_states.var(dim=-1, keepdim=True, unbiased=False)\n    hidden_states = (hidden_states - mean) / torch.sqrt(var + layer_norm_eps)\n    hidden_states = hidden_states * layer_norm2_weight + layer_norm2_bias\n    \n    # MLP\n    hidden_states = F.linear(hidden_states, mlp_lin1_weight, mlp_lin1_bias)\n    hidden_states = F.gelu(hidden_states)\n    hidden_states = F.linear(hidden_states, mlp_lin2_weight, mlp_lin2_bias)\n    \n    # Second residual connection\n    output = residual + hidden_states\n    \n    return output\n{\"uuid\": \"79a71771-3ae7-5a70-9a09-04a5f4409005\", \"axes\": {\"batch_size\": 1, \"height\": 613, \"width\": 613}, \"inputs\": {\"hidden_states\": {\"type\": \"random\"}, \"qkv_weight\": {\"type\": \"random\"}, \"qkv_bias\": {\"type\": \"random\"}, \"proj_weight\": {\"type\": \"random\"}, \"proj_bias\": {\"type\": \"random\"}, \"rel_pos_h\": {\"type\": \"random\"}, \"rel_pos_w\": {\"type\": \"random\"}, \"layer_norm1_weight\": {\"type\": \"random\"}, \"layer_norm1_bias\": {\"type\": \"random\"}, \"layer_norm2_weight\": {\"type\": \"random\"}, \"layer_norm2_bias\": {\"type\": \"random\"}, \"mlp_lin1_weight\": {\"type\": \"random\"}, \"mlp_lin1_bias\": {\"type\": \"random\"}, \"mlp_lin2_weight\": {\"type\": \"random\"}, \"mlp_lin2_bias\": {\"type\": \"random\"}, \"layer_norm_eps\": {\"type\": \"scalar\", \"value\": 1e-06}}, \"tolerance\": {\"max_atol\": 2.768196054440815e-07, \"max_rtol\": 1.1920928955078125e-07, \"required_matched_ratio\": 0.99, \"_provenance\": \"max run-to-run error over 10 seeds x 1.25 margin, floored at torch.float32 epsilon\"}}\n{\"uuid\": \"e0c9d304-e607-5a14-822a-393cb39ce8af\", \"axes\": {\"batch_size\": 1, \"height\": 131, \"width\": 131}, \"inputs\": {\"hidden_states\": {\"type\": \"random\"}, \"qkv_weig