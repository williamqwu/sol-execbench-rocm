{"type":"item.started","item":{"id":"item_16","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch\nfrom torch.nn.attention.flex_attention import flex_attention\nB,H,K,G,L,D=1,64,8,8,128,128\ns=1/(D**.5)\ntorch.manual_seed(2)\nq=(torch.randn(B,H,L,D,device='cuda')*90).to(torch.bfloat16)\nk=(torch.randn(B,K,L,D,device='cuda')*90).to(torch.bfloat16)\nv=(torch.randn(B,K,L,D,device='cuda')*90).to(torch.bfloat16)\nda=(torch.randn(B,H,L,D,device='cuda')*90).to(torch.bfloat16)\nkx=k[:,:,None].expand(B,K,G,L,D).reshape(B,H,L,D); vx=v[:,:,None].expand(B,K,G,L,D).reshape(B,H,L,D)\nsc=(q@kx.transpose(2,3))*s; sc=sc.masked_fill(torch.ones(L,L,device='cuda',dtype=torch.bool).triu(1)[None,None],-torch.inf)\npf=torch.softmax(sc.float(),-1); p=pf.to(torch.bfloat16); out=p@vx\ndp=da@vx.transpose(2,3); dvx=p.transpose(2,3)@da; ds=pf*(dp.float()-(dp.float()*pf).sum(-1,keepdim=True)); ds=ds*s\ndq=ds.to(torch.bfloat16)@kx; dkx=(q.transpose(2,3)@ds.to(torch.bfloat16)).transpose(2,3); dk=dkx.view(B,K,G,L,D).sum(2); dv=dvx.view(B,K,G,L,D).sum(2)\ndef mod(score,b,h,qi,ki):\n score=score.to(torch.bfloat16); score=(score*s).to(torch.bfloat16); return torch.where(qi>=ki,score,-float('inf'))\ndef fn(q,k,v): return flex_attention(q,k,v,score_mod=mod,scale=1.0,enable_gqa=True,kernel_options={'BLOCK_M':64,'BLOCK_N':64})\nfn=torch.compile(fn,fullgraph=True)\nq2=q.detach().requires_grad_(); k2=k.detach().requires_grad_(); v2=v.detach().requires_grad_(); out2=fn(q2,k2,v2); out2.backward(da); torch.cuda.synchronize()\nfor name,a,b in [('out',out,out2),('dq',dq,q2.grad),('dk',dk,k2.grad),('dv',dv,v2.grad)]:\n d=(a.float()-b.float()).abs(); tol=.03+.0078125*b.float().abs(); print(name,d.max().item(),d.mean().item(),(d<=tol).float().mean().item(),(d==0).float().mean().item())\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
