ires_grad_()\n   105\t    v = v.detach().requires_grad_()\n   106\t\n   107\t    with torch.enable_grad():\n   108\t        attn_heads = F.scaled_dot_product_attention(\n   109\t            q, k, v, is_causal=True, scale=scaling, enable_gqa=True)\n   110\t    attn = attn_heads.transpose(1, 2).contiguous().reshape(batch_size, seq_len, hidden_size)\n   111\t\n   112\t    da = F.linear(grad_output, o_weight.t())\n   113\t    dow = grad_output.reshape(-1, hidden_size).t() @ attn.reshape(-1, hidden_size)\n   114\t    da_heads = da.view(batch_size, seq_len, nh, hd).transpose(1, 2)\n   115\t    dq, dk, dv = torch.autograd.grad(attn_heads, (q, k, v), da_heads)\n   116\t\n   117\t    dqf = dq.float()\n   118\t    dq_out = dqf * cos\n   119\t    dq_rot = (dqf * sin).view(*dqf.shape[:-1], hd // 2, 2)\n   120\t    dq_out[..., 0::2] = dq_out[..., 0::2] + dq_rot[..., 1]\n   121\t    dq_out[..., 1::2] = dq_out[..., 1::2] - dq_rot[..., 0]\n   122\t    dq = dq_out.to(dtype)\n   123\t\n   124\t    dkf = dk.float()\n   125\t    dk_out = dkf * cos\n   126\t    dk_rot = (dkf * sin).view(*dkf.shape[:-1], hd // 2, 2)\n   127\t    dk_out[..., 0::2] = dk_out[..., 0::2] + dk_rot[..., 1]\n   128\t    dk_out[..., 1::2] = dk_out[..., 1::2] - dk_rot[..., 0]\n   129\t    dk = dk_out.to(dtype)\n   130\t\n   131\t    dq = dq.transpose(1, 2).contiguous().view(batch_size, seq_len, hidden_size)\n   132\t    dk = dk.transpose(1, 2).contiguous().view(batch_size, seq_len, nkh * hd)\n   133\t    dv = dv.transpose(1, 2).contiguous().view(batch_size, seq_len, nkh * hd)\n   134\t\n   135\t    dxq = F.linear(dq, q_weight.t())\n   136\t    dxk = F.linear(dk, k_weight.t())\n   137\t    dxv = F.linear(dv, v_weight.t())\n   138\t    dx = dxq + dxk + dxv\n   139\t    x2 = hidden_states.reshape(-1, hidden_size)\n   140\t    dqw = dq.reshape(-1, hidden_size).t() @ x2\n   141\t    dkw = dk.reshape(-1, nkh * hd).t() @ x2\n   142\t    dvw = dv.reshape(-1, nkh * hd).t() @ x2\n   143\t    return dx.to(dtype), dqw.to(dtype), dkw.to(dtype), dvw.to(dtype), dow.to(dtype)\n","exit_code":0,"status":"completed"}}
