{"type":"item.started","item":{"id":"item_35","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch,triton,kernel,json\nH=kernel._handle\n\ndef f(x,ip,two):\n s=x.shape[-1];n=2*s;rows=x.numel()//s;pitch=n+2 if ip else n;p=torch.empty((*x.shape[:-1],pitch),device=x.device);bs=1024\n if two:kernel._pad_2d_kernel[(rows,triton.cdiv(pitch,bs))](x,p,SEQ=s,PITCH=pitch,BLOCK=bs,num_warps=4)\n else:\n  t=p.numel();kernel._pad_kernel[(triton.cdiv(t,bs),)](x,p,TOTAL=t,SEQ=s,FFT=pitch,BLOCK=bs,num_warps=4)\n plan,info,w=kernel._get_plan(x.device.index,rows,n,ip);kernel._check(kernel._rocfft.rocfft_execution_info_set_stream(info,H(torch.cuda.current_stream(x.device).cuda_stream)));ins=(H*1)(p.data_ptr())\n if ip:kernel._check(kernel._rocfft.rocfft_execute(plan,ins,None,info));o=torch.view_as_complex(p.reshape(*x.shape[:-1],s+1,2))\n else:o=torch.empty((*x.shape[:-1],s+1),dtype=torch.complex64,device=x.device);kernel._check(kernel._rocfft.rocfft_execute(plan,ins,(H*1)(o.data_ptr()),info))\n return o.real,o.imag\n\ndef bench(fn,x,it):\n for _ in range(6):fn(x)\n torch.cuda.synchronize();v=[]\n for _ in range(7):\n  a=torch.cuda.Event(True);b=torch.cuda.Event(True);a.record()\n  for _ in range(it):fn(x)\n  b.record();b.synchronize();v.append(a.elapsed_time(b)/it)\n return sorted(v)[3]\nfor i,r in enumerate(map(json.loads,open('workload.jsonl'))):\n b=r['axes']['batch_size'];s=r['axes']['seqlen'];x=torch.randn(b,256,s,device='cuda');size=b*s;it=80 if size<3000 else 30 if size<30000 else 8 if size<200000 else 3\n d={}\n for ip,two,name in [(0,0,'of'),(0,1,'o2'),(1,0,'if'),(1,1,'i2')]:d[name]=round(bench(lambda x,ip=ip,two=two:f(x,ip,two),x,it),5)\n print(i,(b,s),d)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
