{"type":"item.started","item":{"id":"item_8","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch\n\ndef bench(fn,x,it=100):\n    for _ in range(10): fn(x)\n    torch.cuda.synchronize()\n    a=torch.cuda.Event(enable_timing=True); b=torch.cuda.Event(enable_timing=True)\n    ts=[]\n    for _ in range(7):\n        a.record()\n        for _ in range(it): y=fn(x)\n        b.record(); b.synchronize()\n        ts.append(a.elapsed_time(b)/it)\n    return sorted(ts)[3]\n\nfor bs,s,it in [(2,256,300),(8,1024,200),(16,1423,100),(32,4096,30),(2,32768,50),(64,8192,10)]:\n    x=torch.randn(bs,256,s,device='cuda')\n    n=2*s\n    funcs={\n      'default':lambda x: torch.fft.rfft(x,n=n),\n      'forward':lambda x: torch.fft.rfft(x,n=n,norm='forward'),\n      'ortho':lambda x: torch.fft.rfft(x,n=n,norm='ortho'),\n      'explicit':lambda x: torch.fft.rfft(x,n=n)/n,\n    }\n    print((bs,s), {k:round(bench(f,x,it),5) for k,f in funcs.items()})\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
