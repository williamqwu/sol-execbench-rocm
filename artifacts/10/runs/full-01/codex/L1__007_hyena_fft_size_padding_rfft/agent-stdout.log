{"type":"item.started","item":{"id":"item_13","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch,triton,kernel\n\ndef f(x,bs,nw):\n n=2*x.shape[-1]; p=torch.empty((*x.shape[:-1],n),device=x.device,dtype=x.dtype); t=p.numel()\n kernel._pad_scale_kernel[(triton.cdiv(t,bs),)](x,p,TOTAL=t,SEQ=x.shape[-1],FFT=n,BLOCK=bs,num_warps=nw)\n return torch.fft.rfft(p)\ndef bench(fn,x,it):\n for _ in range(8): fn(x)\n torch.cuda.synchronize(); vals=[]\n for _ in range(7):\n  a=torch.cuda.Event(True);b=torch.cuda.Event(True);a.record()\n  for _ in range(it):fn(x)\n  b.record();b.synchronize();vals.append(a.elapsed_time(b)/it)\n return sorted(vals)[3]\nopts=[(256,4),(512,4),(512,8),(1024,4),(1024,8),(2048,8)]\nfor b,s,it in [(4,512,200),(8,1024,150),(16,2048,60),(32,4096,20),(64,8192,5),(2,32768,30)]:\n x=torch.randn(b,256,s,device='cuda')\n print((b,s),{str(o):round(bench(lambda x,o=o:f(x,*o),x,it),6) for o in opts})\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
