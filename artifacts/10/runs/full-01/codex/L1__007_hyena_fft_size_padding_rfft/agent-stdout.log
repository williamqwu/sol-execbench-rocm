=[json.loads(x) for x in open('workload.jsonl')]\nfor ix in [0,1,2,3,6,7,8,9,10,11,12,14,15]:\n r=rows[ix];b=r['axes']['batch_size'];s=r['axes']['seqlen'];x=torch.randn(b,256,s,device='cuda');st=mk(b*256,2*s);ref=torch.fft.rfft(x,n=2*s)/(2*s);z=go(x,st);torch.cuda.synchronize();aa=r['tolerance']['max_atol'];rr=r['tolerance']['max_rtol'];mr=[]\n for q,v in [(ref.real,z.real),(ref.imag,z.imag)]:mr.append(round(((q-v).abs()<=aa+rr*q.abs()).float().mean().item(),7))\n it=100 if b*s<50000 else 15 if b*s<300000 else 4\n print(ix,(b,s),'match',mr,'direct',round(bench(lambda x:go(x,st),x,it),5),'current',round(bench(kernel.run,x,it),5))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
