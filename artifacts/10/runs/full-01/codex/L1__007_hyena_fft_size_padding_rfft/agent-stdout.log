{"type":"item.started","item":{"id":"item_23","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport ctypes as C, torch, triton, kernel\nL=C.CDLL('librocfft.so.0')\nH=C.c_void_p; SZ=C.c_size_t\nL.rocfft_setup.restype=C.c_int\nfor name,args in {\n'rocfft_plan_description_create':[C.POINTER(H)],\n'rocfft_plan_description_set_scale_factor':[H,C.c_double],\n'rocfft_plan_create':[C.POINTER(H),C.c_int,C.c_int,C.c_int,SZ,C.POINTER(SZ),SZ,H],\n'rocfft_plan_get_work_buffer_size':[H,C.POINTER(SZ)],\n'rocfft_execution_info_create':[C.POINTER(H)],\n'rocfft_execution_info_set_work_buffer':[H,H,SZ],\n'rocfft_execution_info_set_stream':[H,H],\n'rocfft_execute':[H,C.POINTER(H),C.POINTER(H),H],\n}.items():\n f=getattr(L,name);f.argtypes=args;f.restype=C.c_int\nprint('setup',L.rocfft_setup())\n\ndef check(st,name):\n if st: raise RuntimeError(name,st)\n\ndef plan(rows,n):\n d=H();check(L.rocfft_plan_description_create(C.byref(d)),'desc')\n check(L.rocfft_plan_description_set_scale_factor(d,C.c_double(1.0/n)),'scale')\n p=H(); lens=(SZ*1)(n)\n check(L.rocfft_plan_create(C.byref(p),1,2,0,1,lens,rows,d),'plan')\n ws=SZ();check(L.rocfft_plan_get_work_buffer_size(p,C.byref(ws)),'wss')\n info=H();check(L.rocfft_execution_info_create(C.byref(info)),'info')\n w=torch.empty(ws.value,dtype=torch.uint8,device='cuda') if ws.value else None\n if w is not None:check(L.rocfft_execution_info_set_work_buffer(info,H(w.data_ptr()),ws),'setws')\n return p,info,w\n\ndef run(x,p,info):\n n=2*x.shape[-1]; pad=torch.empty((*x.shape[:-1],n),device=x.device);t=pad.numel();bs=1024\n kernel._pad_scale_kernel[(triton.cdiv(t,bs),)](x,pad,TOTAL=t,SEQ=x.shape[-1],FFT=n,SCALE=1.0,BLOCK=bs,num_warps=4)\n out=torch.empty((*x.shape[:-1],x.shape[-1]+1),dtype=torch.complex64,device=x.device)\n check(L.rocfft_execution_info_set_stream(info,H(torch.cuda.current_stream().cuda_stream)),'stream')\n ia=(H*1)(pad.data_ptr());oa=(H*1)(out.data_ptr());check(L.rocfft_execute(p,ia,oa,info),'exec')\n return out\nfor b,s in [(1,131),(2,256),(16,1423),(8,1024)]:\n x=torch.randn(b,256,s,device='cuda');p,i,w=plan(b*256,2*s)\n y=torch.fft.rfft(x,n=2*s)/(2*s);z=run(x,p,i);torch.cuda.synchronize()\n d=(y-z).abs();print((b,s),'equal',torch.equal(y,z),'max',d.max().item(),'neq',(d\"'!=0).float().mean().item(),'\"'ws',0 if w is None else w.numel())\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
