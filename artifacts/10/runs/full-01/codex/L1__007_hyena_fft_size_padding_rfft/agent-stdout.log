{"type":"item.started","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch, time, json\n\ndef ref(x):\n    n=2*x.shape[-1]\n    y=torch.fft.rfft(x,n=n)\n    y=y/n\n    return y.real.contiguous(),y.imag.contiguous()\n\ndef cand(x):\n    n=2*x.shape[-1]\n    y=torch.fft.rfft(x,n=n,norm='forward')\n    return y.real,y.imag\nfor b,s in [(1,131),(2,211),(2,256),(2,773),(8,1024),(16,1423),(4,1801),(2,32768)]:\n    torch.manual_seed(0)\n    x=torch.randn((b,256,s),device='cuda',dtype=torch.float32)\n    a=ref(x); c=cand(x); torch.cuda.synchronize()\n    ds=[]\n    eq=[]\n    for aa,cc in zip(a,c):\n        d=(aa-cc).abs()\n        ds.append((d.max().item(), (d\"'!=0).float().mean().item()))\n        eq.append(torch.equal(aa,cc))\n    print((b,s), '\"'equal',eq,'max/nonzero',ds,'strides',c[0].stride())\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
