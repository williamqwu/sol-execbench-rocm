{"type":"item.started","item":{"id":"item_48","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch,triton,kernel\n\ndef launch(x,b,w):\n n=x.numel(); nt=triton.cdiv(n,b)\n tiles=torch.empty(n,dtype=torch.int32,device=x.device);meta=torch.empty(nt*256,dtype=torch.int32,device=x.device)\n order=torch.empty(n,dtype=torch.int32,device=x.device);offs=torch.empty(257,dtype=torch.int32,device=x.device)\n kernel._sort_tiles[(nt,)](x,tiles,meta,N=n,BLOCK=b,META_PACK=b,num_warps=w)\n kernel._prefix_tiles[(1,)](meta,offs,N=n,NUM_TILES=nt,META_PACK=b,num_warps=4)\n kernel._scatter_tiles[(nt,)](tiles,meta,order,N=n,BLOCK=b,META_PACK=b,num_warps=w)\n return order,offs\nfor n in (16384,16640,16896,17408,17920,18432,32768):\n x=torch.randint(0,256,(n,),dtype=torch.int32,device='cuda')\n print('N',n,end=' ')\n for b,w in ((512,8),(1024,16)):\n  launch(x,b,w);torch.cuda.synchronize()\n  us=triton.testing.do_bench(lambda:launch(x,b,w),warmup=40,rep=200)*1000\n  print('B'+str(b),round(us,2),end=' ')\n print()\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
