{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -lc \"ls -la && sed -n '1,220p' kernel.py && sed -n '1,120p' solution.json\"","aggregated_output":"total 56\ndrwxr-xr-x 2 root root  4096 Aug  5 23:05 .\ndrwxr-xr-x 3 root root    28 Aug  5 23:05 ..\n-rw-r--r-- 1 root root   646 Aug  5 23:05 .packet.json\n-rw-r--r-- 1 root root  5586 Aug  5 23:05 TASK.md\n-rw-r--r-- 1 root root  7117 Aug  4 07:19 definition.json\n-rw-r--r-- 1 root root  2396 Aug  5 23:05 kernel.py\n-rw-r--r-- 1 root root  3726 Aug  5 23:05 reference.py\n-rw-r--r-- 1 root root   383 Aug  5 23:05 solution.json\n-rwxr-xr-x 1 root root   442 Aug  5 23:05 verify\n-rw-r--r-- 1 root root 12485 Aug  5 23:05 workload.jsonl\nimport torch\nimport torch.nn.functional as F\n\n\n@torch.no_grad()\ndef run(\n    hidden_states,\n    q_proj_weight,\n    q_proj_bias,\n    k_proj_weight,\n    k_proj_bias,\n    v_proj_weight,\n    v_proj_bias,\n    o_proj_weight,\n    q_norm_weight,\n    k_norm_weight,\n    cos,\n    sin,\n    rms_norm_eps,\n):\n    batch_size, seq_length, _ = hidden_states.shape\n\n    query_states = F.linear(hidden_states, q_proj_weight, q_proj_bias)\n    key_states = F.linear(hidden_states, k_proj_weight, k_proj_bias)\n    value_states = F.linear(hidden_states, v_proj_weight, v_proj_bias)\n\n    query_states = query_states.view(batch_size, seq_length, 96, 128)\n    key_states = key_states.view(batch_size, seq_length, 8, 128)\n    value_states = value_states.view(batch_size, seq_length, 8, 128)\n\n    def rms_norm(x, weight):\n        input_dtype = x.dtype\n        x = x.float()\n        variance = x.pow(2).mean(-1, keepdim=True)\n        x = x * torch.rsqrt(variance + rms_norm_eps)\n        return (weight * x).to(input_dtype)\n\n    query_states = rms_norm(query_states, q_norm_weight).transpose(1, 2)\n    key_states = rms_norm(key_states, k_norm_weight).transpose(1, 2)\n    value_states = value_states.transpose(1, 2)\n\n    cos_expanded = cos.unsqueeze(1)\n    sin_expanded = sin.unsqueeze(1)\n    q1, q2 = query_states[..., :64], query_states[..., 64:]\n    query_states = query_states * cos_expanded + torch.cat((-q2, q1), dim=-1) * sin_expanded\n    k1, k2 = key_states[..., :64], key_states[..., 64:]\n    key_states = key_states * cos_expanded + torch.cat((-k2, k1), dim=-1) * sin_expanded\n\n    key_states = key_states[:, :, None].expand(batch_size, 8, 12, seq_length, 128).reshape(batch_size, 96, seq_length, 128)\n    value_states = value_states[:, :, None].expand(batch_size, 8, 12, seq_length, 128).reshape(batch_size, 96, seq_length, 128)\n\n    attn_weights = torch.matmul(query_states, key_states.transpose(2, 3)) * (128 ** -0.5)\n    causal_mask = torch.triu(\n        torch.full((seq_length, seq_length), float(\"-inf\"), device=hidden_states.device, dtype=attn_weights.dtype),\n        diagonal=1,\n    )\n    attn_weights = F.softmax(attn_weights + causal_mask, dim=-1, dtype=torch.float32).to(query_states.dtype)\n    attn_output = torch.matmul(attn_weights, value_states)\n    attn_output = attn_output.transpose(1, 2).contiguous().reshape(batch_size, seq_length, 96 * 128)\n    return F.linear(attn_output, o_proj_weight, None)\n{\n  \"name\": \"092_gqa_attention_with_qk_norm_agent\",\n  \"definition\": \"092_gqa_attention_with_qk_norm\",\n  \"author\": \"agent\",\n  \"spec\": {\n    \"languages\": [\"pytorch\"],\n    \"target_hardware\": [\"MI355X\", \"LOCAL\"],\n    \"entry_point\": \"kernel.py::run\",\n    \"dependencies\": [\"torch\"],\n    \"destination_passing_style\": false\n  },\n  \"sources\": [\n    {\"path\": \"kernel.py\", \"content\": \"\"}\n  ]\n}\n","exit_code":0,"status":"completed"}}
