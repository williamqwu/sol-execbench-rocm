{"type":"item.started","item":{"id":"item_25","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport torch, triton\nimport kernel\nfor B,T,N in [(2,131,40),(16,2053,40),(32,8192,160),(64,541,80)]:\n    lm=torch.randn(B,T,4096,device='cuda',dtype=torch.bfloat16)\n    pos=torch.arange(N,device='cuda',dtype=torch.int64).expand(B,-1).contiguous()\n    audio=torch.randn(B*((N+39)//40),4096,device='cuda',dtype=torch.bfloat16)\n    out=torch.empty_like(lm)\n    vals=[]\n    configs=[(512,4),(1024,4),(2048,4),(4096,4),(1024,8),(2048,8),(4096,8)]\n    reps=10 if B*T>100000 else 30\n    for block,nw in configs:\n        grid=(B*T,triton.cdiv(4096,block))\n        for _ in range(3): kernel._fuse_output[grid](audio,pos,lm,out,batch_size=B,num_tokens=N,text_len=T,hidden_size=4096,search_steps=N.bit_length(),BLOCK_H=block,num_warps=nw)\n        torch.cuda.synchronize(); s=torch.cuda.Event(True); e=torch.cuda.Event(True); s.record()\n        for _ in range(reps): kernel._fuse_output[grid](audio,pos,lm,out,batch_size=B,num_tokens=N,text_len=T,hidden_size=4096,search_steps=N.bit_length(),BLOCK_H=block,num_warps=nw)\n        e.record(); e.synchronize(); vals.append(round(s.elapsed_time(e)/reps,4))\n    print((B,T,N), list(zip(configs,vals)))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
