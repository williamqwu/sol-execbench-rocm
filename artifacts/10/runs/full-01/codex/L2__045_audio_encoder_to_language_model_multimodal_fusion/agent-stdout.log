{"type":"item.started","item":{"id":"item_22","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport torch\nimport triton\nimport reference, kernel\nB,T,N = 32,8192,160\ninputs = reference.get_inputs({'batch_size':B,'audio_seq_len':1280,'text_seq_len':T,'num_audio_tokens':N}, torch.device('cuda:0'))\nlm=inputs['lm_embeddings']; pos=inputs['audio_token_positions']; audio=torch.randn(B*(N//40),4096,device='cuda',dtype=torch.bfloat16)\nout=torch.empty_like(lm)\nfor nw in (4, 8, 16):\n    try:\n        for _ in range(3):\n            kernel._fuse_output[(B*T,)](audio,pos,lm,out,batch_size=B,num_tokens=N,text_len=T,hidden_size=4096,search_steps=N.bit_length(),BLOCK_H=4096,num_warps=nw)\n        torch.cuda.synchronize()\n        start=torch.cuda.Event(enable_timing=True); end=torch.cuda.Event(enable_timing=True)\n        start.record()\n        for _ in range(20):\n            kernel._fuse_output[(B*T,)](audio,pos,lm,out,batch_size=B,num_tokens=N,text_len=T,hidden_size=4096,search_steps=N.bit_length(),BLOCK_H=4096,num_warps=nw)\n        end.record(); end.synchronize()\n        print(nw, start.elapsed_time(end)/20)\n    except Exception as e:\n        print(nw, type(e).__name__, str(e)[:300])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
