{"type":"item.started","item":{"id":"item_29","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport torch, triton\nimport torch.nn.functional as F\nimport reference, kernel\n\ndef old(args):\n    x,lm,pos,wi,bi,wo,bo,wm,bm,q,wq,bq,wk,bk,wv,bv,wout,bout,wp,bp=args\n    B=x.shape[0]; T=lm.shape[1]; N=pos.shape[1]; nb=(N+39)//40\n    feat=x[:,:nb*15].view(B,nb,15,80).mean(2)\n    h=F.linear(feat,wi,bi); v=F.linear(h,wv,bv); qo=F.linear(v,wout,bout); a=F.linear(qo,wp,bp)\n    o=torch.empty_like(lm)\n    kernel._fuse_output[(B*T,1)](a,pos,lm,o,batch_size=B,num_tokens=N,text_len=T,hidden_size=4096,search_steps=N.bit_length(),BLOCK_H=4096,num_warps=4)\n    return o\nfor axes in [\n {'batch_size':2,'audio_seq_len':320,'text_seq_len':131,'num_audio_tokens':40},\n {'batch_size':16,'audio_seq_len':320,'text_seq_len':2053,'num_audio_tokens':40},\n {'batch_size':64,'audio_seq_len':640,'text_seq_len':541,'num_audio_tokens':80},\n {'batch_size':32,'audio_seq_len':1280,'text_seq_len':8192,'num_audio_tokens':160},\n]:\n    inp=reference.get_inputs(axes,torch.device('cuda')); args=list(inp.values()); reps=20 if axes['text_seq_len']<8000 else 10\n    vals=[]\n    for fn in (old, lambda a: kernel.run(*a)):\n      for _ in range(4): fn(args)\n      torch.cuda.synchronize(); s=torch.cuda.Event(True); e=torch.cuda.Event(True); s.record()\n      for _ in range(reps): fn(args)\n      e.record();e.synchronize();vals.append(s.elapsed_time(e)/reps)\n    print(axes, vals)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
