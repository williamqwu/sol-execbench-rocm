{"type":"item.started","item":{"id":"item_14","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch\nK=3072\ntorch.manual_seed(1)\nw1=torch.randn(K,K,device='cuda',dtype=torch.bfloat16);w2=torch.randn_like(w1)\ndef bench(fn,n):\n for _ in range(5): fn()\n torch.cuda.synchronize();a=torch.cuda.Event(True);z=torch.cuda.Event(True);a.record()\n for _ in range(n): fn()\n z.record();z.synchronize();return a.elapsed_time(z)*1000/n\nfor m in (128,613,8192,17312):\n h=torch.randn((3,m,K),device='cuda',dtype=torch.bfloat16)\n x=h[1:]\n def mm2():\n  a=torch.mm(x[0],w1.t(),out_dtype=torch.float32)\n  b=torch.mm(x[1],w2.t(),out_dtype=torch.float32)\n  return a,b\n def bmmstack():\n  w=torch.stack((w1,w2),0)\n  return torch.bmm(x,w.transpose(1,2),out_dtype=torch.float32)\n w=torch.stack((w1,w2),0)\n def bmmpre(): return torch.bmm(x,w.transpose(1,2),out_dtype=torch.float32)\n n=100 if m<1000 else 20\n print('M',m,'mm2',bench(mm2,n),'stack+bmm',bench(bmmstack,n),'bmm pre',bench(bmmpre,n),'stack only',bench(lambda:torch.stack((w1,w2),0),n))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
