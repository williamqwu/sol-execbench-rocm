{"type":"item.started","item":{"id":"item_52","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch,triton\nfrom kernel import _project_kernel\nH=3072\n\ndef bench(fn,n=150):\n for _ in range(4):fn()\n torch.cuda.synchronize();a=torch.cuda.Event(True);z=torch.cuda.Event(True);a.record()\n for _ in range(n):fn()\n z.record();z.synchronize();return a.elapsed_time(z)*1000/n\nconfigs=[\n(64,64,64,4,1,1,16),(64,64,64,4,2,1,16),(64,64,64,4,2,2,16),(64,64,64,4,2,4,16),(64,64,64,4,2,1,32),\n(64,64,128,4,1,1,16),(64,64,128,4,2,1,16),\n(128,32,64,4,2,1,16),(128,64,64,4,2,1,16),(128,64,64,8,2,1,16),(128,128,64,8,2,1,16),\n(32,128,64,4,2,1,16),(64,128,64,4,2,1,16),(64,128,64,8,2,1,16)]\nfor M in (128,131,256):\n h=torch.randn((3,M,H),device='cuda',dtype=torch.bfloat16);w1=torch.randn((H,H),device='cuda',dtype=torch.bfloat16);w2=torch.randn_like(w1);p=torch.empty((2,M,H),device='cuda',dtype=torch.float32)\n print('M',M)\n for c in configs:\n  bm,bn,bk,nw,ns,wpe,mi=c;grid=(2*triton.cdiv(M,bm)*triton.cdiv(H,bn),)\n  fn=lambda c=c,grid=grid:_project_kernel[grid](h,w1,w2,p,M,H=H,BLOCK_M=c[0],BLOCK_N=c[1],BLOCK_K=c[2],GROUP_M=8,num_warps=c[3],num_stages=c[4],waves_per_eu=c[5],matrix_instr_nonkdim=c[6])\n  try:print(c,round(bench(fn),2))\n  except Exception as e:print(c,'ERR',str(e)[:120])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
