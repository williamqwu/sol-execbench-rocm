{"type":"item.started","item":{"id":"item_53","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch,triton,statistics\nfrom kernel import run,_project_kernel,_collapse_kernel\nfrom reference import run as ref\nK=3072\n\ndef custom(h,w1,w2,eps):\n m=h.numel()//(3*K);p=torch.empty((2,m,K),device=h.device,dtype=torch.float32)\n if m==128:c=(64,64,128,4,2,1)\n else:c=(64,64,64,4,2,2)\n bm,bn,bk,nw,ns,wpe=c;grid=(2*triton.cdiv(m,bm)*triton.cdiv(K,bn),)\n _project_kernel[grid](h,w1,w2,p,m,H=K,BLOCK_M=bm,BLOCK_N=bn,BLOCK_K=bk,GROUP_M=8,num_warps=nw,num_stages=ns,waves_per_eu=wpe,matrix_instr_nonkdim=16)\n o=torch.empty_like(h[0]);_collapse_kernel[(m,)](h,p[0],p[1],o,eps,H=K,BLOCK=4096,num_warps=4);return o\n\ndef one(fn,n=100):\n a=torch.cuda.Event(True);z=torch.cuda.Event(True);a.record()\n for _ in range(n):fn()\n z.record();z.synchronize();return a.elapsed_time(z)*1000/n\nfor m in (128,131,256):\n h=torch.randn((3,1,m,K),device='cuda',dtype=torch.bfloat16);w1=torch.randn((K,K),device='cuda',dtype=torch.bfloat16);w2=torch.randn_like(w1)\n for _ in range(5):run(h,w1,w2,1e-5);custom(h,w1,w2,1e-5)\n a=[one(lambda:run(h,w1,w2,1e-5)) for _ in range(5)];b=[one(lambda:custom(h,w1,w2,1e-5)) for _ in range(5)]\n y=custom(h,w1,w2,1e-5);z=ref(h,w1,w2,1e-5);torch.cuda.synchronize();d=(y.float()-z.float()).abs();close=torch.isclose(y.float(),z.float(),atol=.00449,rtol=.0078125)\n print('M',m,'current',statistics.median(a),a,'custom',statistics.median(b),b,'err',d.max().item(),close.float().mean().item(),(d==0).float().mean().item())\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
