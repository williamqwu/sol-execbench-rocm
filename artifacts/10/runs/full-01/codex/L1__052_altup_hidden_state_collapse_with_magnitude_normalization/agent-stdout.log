{"type":"item.started","item":{"id":"item_12","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch\nfrom kernel import _collapse_kernel, HIDDEN_SIZE\nfrom reference import run as ref\n\ndef alt(h,w1,w2,eps,out_f32):\n  m=h.numel()//(3*3072)\n  kw={'out_dtype':torch.float32} if out_f32 else {}\n  p1=torch.mm(h[1].reshape(m,3072),w1.t(),**kw)\n  p2=torch.mm(h[2].reshape(m,3072),w2.t(),**kw)\n  o=torch.empty_like(h[0])\n  _collapse_kernel[(m,)](h,p1,p2,o,eps,H=3072,BLOCK=4096,num_warps=8)\n  return o\n\ndef bench(fn,n=40):\n  for _ in range(5): fn()\n  torch.cuda.synchronize(); a=torch.cuda.Event(True); z=torch.cuda.Event(True); a.record()\n  for _ in range(n): fn()\n  z.record(); z.synchronize(); return a.elapsed_time(z)*1000/n\n\ntorch.manual_seed(42)\nw1=torch.randn((3072,3072),device='cuda',dtype=torch.bfloat16)\nw2=torch.randn((3072,3072),device='cuda',dtype=torch.bfloat16)\nfor m in (128,613,8192,17312):\n  h=torch.randn((3,1,m,3072),device='cuda',dtype=torch.bfloat16)\n  n=80 if m<1000 else 20\n  t32=bench(lambda:alt(h,w1,w2,1e-5,True),n)\n  t16=bench(lambda:alt(h,w1,w2,1e-5,False),n)\n  print('M',m,'f32temp_us',t32,'bf16temp_us',t16)\n  if m<=613:\n    yr=ref(h,w1,w2,1e-5); y=alt(h,w1,w2,1e-5,False); torch.cuda.synchronize()\n    d=(y.float()-yr.float()).abs(); c=torch.isclose(y.float(),yr.float(),atol=.00449,rtol=.0078125)\n    print(' error max/mean/matched/exact',d.max().item(),d.mean().item(),c.float().mean().item(),(d==0).float().mean().item())\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
