{"type":"item.started","item":{"id":"item_33","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch,statistics\nfrom kernel import _collapse_kernel\nK=3072;w1=torch.randn((K,K),device='cuda',dtype=torch.bfloat16);w2=torch.randn_like(w1)\ndef runx(h,f32):\n m=h.shape[1]\n if f32:\n  p1=torch.mm(h[1],w1.t(),out_dtype=torch.float32);p2=torch.mm(h[2],w2.t(),out_dtype=torch.float32)\n else:\n  p1=torch.mm(h[1],w1.t());p2=torch.mm(h[2],w2.t())\n o=torch.empty_like(h[0]);_collapse_kernel[(m,)](h,p1,p2,o,1e-5,H=K,BLOCK=4096,num_warps=8);return o\ndef one(fn,n):\n a=torch.cuda.Event(True);z=torch.cuda.Event(True);a.record()\n for _ in range(n):fn()\n z.record();z.synchronize();return a.elapsed_time(z)*1000/n\nfor m in (128,131,256,422,613,2048,2984,4096,7184,8192,16384,17312):\n h=torch.randn((3,m,K),device='cuda',dtype=torch.bfloat16);n=40 if m<1000 else (12 if m<9000 else 6)\n for _ in range(5):runx(h,True);runx(h,False)\n torch.cuda.synchronize();a=[];b=[]\n for i in range(5):\n  if i%2:a.append(one(lambda:runx(h,True),n));b.append(one(lambda:runx(h,False),n))\n  else:b.append(one(lambda:runx(h,False),n));a.append(one(lambda:runx(h,True),n))\n print('M',m,'f32',round(statistics.median(a),2),[round(x,1) for x in a],'bf16',round(statistics.median(b),2),[round(x,1) for x in b])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
