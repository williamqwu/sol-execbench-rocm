{"type":"item.started","item":{"id":"item_20","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch\nK=3072\nw1=torch.randn((K,K),device='cuda',dtype=torch.bfloat16);w2=torch.randn_like(w1)\ns1=torch.cuda.Stream();s2=torch.cuda.Stream()\ndef seq(h):\n p=torch.empty((2,h.shape[1],K),device=h.device,dtype=torch.float32)\n torch.mm(h[1],w1.t(),out_dtype=torch.float32,out=p[0])\n torch.mm(h[2],w2.t(),out_dtype=torch.float32,out=p[1])\n return p\ndef par(h):\n m=h.shape[1];cur=torch.cuda.current_stream();p=torch.empty((2,m,K),device=h.device,dtype=torch.float32)\n s1.wait_stream(cur);s2.wait_stream(cur)\n with torch.cuda.stream(s1): torch.mm(h[1],w1.t(),out_dtype=torch.float32,out=p[0])\n with torch.cuda.stream(s2): torch.mm(h[2],w2.t(),out_dtype=torch.float32,out=p[1])\n cur.wait_stream(s1);cur.wait_stream(s2)\n return p\n\ndef bench(fn,n):\n for _ in range(5):fn()\n torch.cuda.synchronize();a=torch.cuda.Event(True);z=torch.cuda.Event(True);a.record()\n for _ in range(n):fn()\n z.record();z.synchronize();return a.elapsed_time(z)*1000/n\nfor m in (128,131,256,422,613,2048,4096,8192,17312):\n h=torch.randn((3,m,K),device='cuda',dtype=torch.bfloat16);n=100 if m<1000 else 30\n try:\n  q=par(h);r=seq(h);torch.cuda.synchronize();print('M',m,'maxdiff', (q-r).abs().max().item(),'seq',bench(lambda:seq(h),n),'par',bench(lambda:par(h),n))\n except Exception as e:print('M',m,'ERROR',type(e).__name__,e)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
