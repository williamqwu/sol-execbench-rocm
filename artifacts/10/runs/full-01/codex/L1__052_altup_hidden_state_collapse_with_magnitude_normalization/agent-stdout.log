{"type":"item.started","item":{"id":"item_37","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch,triton,statistics\nfrom kernel import _pack_weights_kernel,_collapse_kernel\nK=3072;N=K*K;w1=torch.randn((K,K),device='cuda',dtype=torch.bfloat16);w2=torch.randn_like(w1)\ndef current(h):\n m=h.shape[1];p1=torch.mm(h[1],w1.t(),out_dtype=torch.float32);p2=torch.mm(h[2],w2.t(),out_dtype=torch.float32);o=torch.empty_like(h[0]);_collapse_kernel[(m,)](h,p1,p2,o,1e-5,H=K,BLOCK=4096,num_warps=8);return o\ndef opt8192(h):\n m=h.shape[1];wp=torch.empty((2,K,K),device='cuda',dtype=torch.bfloat16);_pack_weights_kernel[(triton.cdiv(N,4096),)](w1,w2,wp,N=N,BLOCK=4096,num_warps=4);p=torch.bmm(h[1:],wp.transpose(1,2));o=torch.empty_like(h[0]);_collapse_kernel[(m,)](h,p[0],p[1],o,1e-5,H=K,BLOCK=4096,num_warps=4);return o\ndef opt16384(h):\n m=h.shape[1];p1=torch.mm(h[1],w1.t());p2=torch.mm(h[2],w2.t());o=torch.empty_like(h[0]);_collapse_kernel[(m,)](h,p1,p2,o,1e-5,H=K,BLOCK=4096,num_warps=4);return o\ndef one(fn,n):\n a=torch.cuda.Event(True);z=torch.cuda.Event(True);a.record()\n for _ in range(n):fn()\n z.record();z.synchronize();return a.elapsed_time(z)*1000/n\nfor m,opt in ((8192,opt8192),(16384,opt16384)):\n h=torch.randn((3,m,K),device='cuda',dtype=torch.bfloat16)\n for _ in range(6):current(h);opt(h)\n torch.cuda.synchronize();a=[];b=[]\n for i in range(7):\n  if i%2:a.append(one(lambda:current(h),8));b.append(one(lambda:opt(h),8))\n  else:b.append(one(lambda:opt(h),8));a.append(one(lambda:current(h),8))\n print('M',m,'current',statistics.median(a),a,'opt',statistics.median(b),b)\n y=opt(h);yr=current(h);torch.cuda.synchronize();d=(y.float()-yr.float()).abs();close=torch.isclose(y.float(),yr.float(),atol=.0045,rtol=.0078125);print('relative-to-current max mean matched exact',d.max().item(),d.mean().item(),close.float().mean().item(),(d==0).float().mean().item())\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
