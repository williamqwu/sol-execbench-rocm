{"type":"item.started","item":{"id":"item_26","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport json, torch, reference, kernel\nrows=[json.loads(x) for x in open('workload.jsonl')]\nfor j,w in enumerate(rows):\n T=w['axes']['total_seq_len'];C=w['axes']['num_chunks'];tol=w['tolerance'];\n axes={'total_seq_len':T,'num_chunks':C,'d_model':1280,'num_heads':20,'head_dim':64};torch.manual_seed(8800+j)\n inp=reference.get_inputs(axes,torch.device('cuda'));ref=reference.run(**inp);got=kernel.run(**inp);torch.cuda.synchronize()\n rs=[]; mx=[]\n for a,b in zip(got,ref):\n  err=(a.float()-b.float()).abs(); ok=err<=tol['max_atol']+tol['max_rtol']*b.float().abs();rs.append(ok.float().mean().item());mx.append(err.max().item())\n for _ in range(3):kernel.run(**inp)\n torch.cuda.synchronize();s=torch.cuda.Event(True);e=torch.cuda.Event(True);s.record()\n for _ in range(20):kernel.run(**inp)\n e.record();e.synchronize()\n print(j,T,C,'min',round(min(rs),6),'ratios',','.join(f'{x:.5f}' for x in rs),'max',max(mx),'ms',round(s.elapsed_time(e)/20,4))\n del inp,ref,got\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
