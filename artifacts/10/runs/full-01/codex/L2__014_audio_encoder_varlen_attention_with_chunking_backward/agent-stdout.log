{"type":"item.started","item":{"id":"item_74","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport json,torch,reference,kernel\nrows=[json.loads(x) for x in open('workload.jsonl')]\nfor j,w in enumerate(rows):\n T=w['axes']['total_seq_len'];C=w['axes']['num_chunks'];z=w['tolerance'];a={'total_seq_len':T,'num_chunks':C,'d_model':1280,'num_heads':20,'head_dim':64};torch.manual_seed(15000+j)\n x=reference.get_inputs(a,torch.device('cuda'));r=reference.run(**x);y=kernel.run(**x);torch.cuda.synchronize();rat=[];mx=[]\n for u,v in zip(y,r):\n  er=(u.float()-v.float()).abs();rat.append((er<=z['max_atol']+z['max_rtol']*v.float().abs()).float().mean().item());mx.append(er.max().item())\n [kernel.run(**x) for _ in range(5)];torch.cuda.synchronize();s=torch.cuda.Event(True);e=torch.cuda.Event(True);s.record();[kernel.run(**x) for _ in range(100)];e.record();e.synchronize();print(j,T,C,'min',f'{min(rat):.7f}','rat',','.join(f'{q:.6f}' for q in rat),'max',max(mx),'ms',round(s.elapsed_time(e)/100,4))\n del x,r,y\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
