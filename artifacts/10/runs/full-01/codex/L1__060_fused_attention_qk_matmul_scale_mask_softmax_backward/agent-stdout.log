{"type":"item.started","item":{"id":"item_32","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch,triton\nimport kernel\n\ndef bench(fn,rep=20): return triton.testing.do_bench(fn,warmup=10,rep=rep)\nB=1;H=128;M=N=2048;D=128;bh=B*H\nz=torch.randn((bh,M,N),device='cuda',dtype=torch.bfloat16);q=torch.randn((bh,M,D),device='cuda',dtype=torch.bfloat16);k=torch.randn((bh,N,D),device='cuda',dtype=torch.bfloat16);oq=torch.empty_like(q);ok=torch.empty_like(k)\nconfigs=[(32,64,32,4),(64,64,32,4),(64,64,32,8),(64,128,32,8),(32,128,32,8),(64,64,64,8)]\nfor bm,bn,bk,nw in configs:\n gridq=(triton.cdiv(M,bm)*triton.cdiv(128,bn),bh);gridk=(triton.cdiv(N,bm)*triton.cdiv(128,bn),bh)\n fq=lambda:kernel._bmm_128[gridq](z,k,oq,A_ROWS=M,A_COLS=N,OUT_ROWS=M,RED=N,TRANS_A=False,BLOCK_M=bm,BLOCK_N=bn,BLOCK_K=bk,num_warps=nw)\n fk=lambda:kernel._bmm_128[gridk](z,q,ok,A_ROWS=M,A_COLS=N,OUT_ROWS=N,RED=M,TRANS_A=True,BLOCK_M=bm,BLOCK_N=bn,BLOCK_K=bk,num_warps=nw)\n try:\n  tq=bench(fq);tk=bench(fk);fq();fk()\n  rq=torch.bmm(z,k);rk=torch.bmm(z.transpose(1,2),q)\n  eq=(oq==rq).float().mean().item();ek=(ok==rk).float().mean().item()\n  print((bm,bn,bk,nw),f'{tq:.3f}+{tk:.3f}={tq+tk:.3f}',eq,ek,flush=True)\n except Exception as e: print((bm,bn,bk,nw),'ERR',type(e).__name__,str(e)[:100],flush=True)\ntq=bench(lambda:torch.bmm(z,k));tk=bench(lambda:torch.bmm(z.transpose(1,2),q));print('torch',tq,tk,tq+tk)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
