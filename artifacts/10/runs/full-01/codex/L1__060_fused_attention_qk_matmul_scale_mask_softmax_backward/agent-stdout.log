{"type":"item.started","item":{"id":"item_38","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch,triton\nimport kernel\n\ndef bench(fn,rep=40):return triton.testing.do_bench(fn,warmup=10,rep=rep)\nfor B,M,N in [(2,128,256),(1,256,512),(2,256,512)]:\n H=D=128;bh=B*H;s=.08838834764831845\n g=torch.randn((B,H,M,N),device='cuda',dtype=torch.bfloat16);w=torch.randn_like(g);q=torch.randn((B,H,M,D),device='cuda',dtype=torch.bfloat16);k=torch.randn((B,H,N,D),device='cuda',dtype=torch.bfloat16);z=torch.empty_like(g);oq=torch.empty_like(q);ok=torch.empty_like(k)\n vals=[]\n for bm,nw in [(16,4),(16,8)]:\n  fn=lambda bm=bm,nw=nw:kernel._fused_square_stream[(bh,)](g,w,q,k,z,oq,ok,s,M=M,N=N,BLOCK_N=triton.next_power_of_2(N),BLOCK_M=bm,num_warps=nw)\n  try:\n   t=bench(fn);fn()\n   # official reference calculation\n   sm=(g.float()*w.float()).sum(-1,keepdim=True);d=(w.float()*(g.float()-sm)).bfloat16()*s\n   rq=torch.matmul(d,k);rk=torch.matmul(d.transpose(-2,-1),q)\n   eq=torch.isclose(oq,rq,atol=6e-5,rtol=.0078125).float().mean().item();ek=torch.isclose(ok,rk,atol=6e-5,rtol=.0078125).float().mean().item()\n   vals.append(f'm{bm}w{nw}={t:.3f}/{eq:.3f},{ek:.3f}')\n  except Exception as e:vals.append(f'm{bm}w{nw}=ERR:{type(e).__name__}:{str(e)[:30]}')\n vals.append(f'old={bench(lambda:kernel.run(g,q,k,w,s)):.3f}')\n print((B,M,N),*vals,flush=True)\n del g,w,q,k,z,oq,ok\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
