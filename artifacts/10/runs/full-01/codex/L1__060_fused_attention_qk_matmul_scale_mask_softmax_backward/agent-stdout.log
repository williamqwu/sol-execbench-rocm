{"type":"item.started","item":{"id":"item_25","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch,triton\nimport kernel\n\ndef bench(fn,rep=30): return triton.testing.do_bench(fn,warmup=10,rep=rep)\nfor B in (1,8,32):\n H=M=N=D=128;bh=B*H;s=.08838834764831845\n g=torch.randn((B,H,M,N),device='cuda',dtype=torch.bfloat16);w=torch.randn_like(g)\n q=torch.randn((B,H,M,D),device='cuda',dtype=torch.bfloat16);k=torch.randn_like(q)\n z=torch.empty_like(g);oq=torch.empty_like(q);ok=torch.empty_like(k)\n vals=[]\n for nw in (4,8):\n  fn=lambda nw=nw: kernel._fused_small_square[(bh,)](g,w,q,k,z,oq,ok,s,M=M,N=N,BLOCK=128,num_warps=nw)\n  try:\n   t=bench(fn,rep=20);fn()\n   # Compare against current path.\n   zr=torch.empty_like(z);oqr=torch.empty_like(q)\n   kernel._fused_softmax_dq[(triton.cdiv(M,16),bh)](g,w,k,zr,oqr,s,M=M,N=N,BLOCK_M=16,BLOCK_K=64,num_warps=8)\n   okr=torch.bmm(zr.view(bh,M,N).transpose(1,2),q.view(bh,M,D)).view_as(k)\n   eq=torch.isclose(oq,oqr,atol=1e-4,rtol=.0078125).float().mean().item();ek=torch.isclose(ok,okr,atol=1e-4,rtol=.0078125).float().mean().item()\n   vals.append(f'w{nw}={t:.3f}/{eq:.3f},{ek:.3f}')\n  except Exception as e: vals.append(f'w{nw}=ERR:{type(e).__name__}:{str(e)[:80]}')\n # current full path\n fnold=lambda: kernel.run(g,q,k,w,s)\n vals.append(f'old={bench(fnold,rep=20):.3f}')\n print(B,*vals,flush=True)\n del g,w,q,k,z,oq,ok\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
