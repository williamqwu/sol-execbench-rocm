{"type":"item.started","item":{"id":"item_10","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch, triton\nimport kernel\n\ndef bench(fn, warmup=10, rep=30):\n    return triton.testing.do_bench(fn, warmup=warmup, rep=rep)\n\nfor B,M,N in [(8,128,128),(4,256,256),(1,512,512),(1,1024,1024),(1,2048,2048),(2,449,449)]:\n    H,D=128,128; bh=B*H\n    g=torch.randn((B,H,M,N),device='cuda',dtype=torch.bfloat16)\n    w=torch.randn_like(g)\n    q=torch.randn((B,H,M,D),device='cuda',dtype=torch.bfloat16)\n    k=torch.randn((B,H,N,D),device='cuda',dtype=torch.bfloat16)\n    z=torch.empty_like(g)\n    bn=triton.next_power_of_2(N)\n    vals=[]\n    for nw in (1,2,4,8):\n      try:\n        t=bench(lambda nw=nw: kernel._softmax_backward_scale[(bh*M,)](g,w,z,0.08838834764831845,n_cols=N,BLOCK_N=bn,num_warps=nw),rep=20)\n        vals.append(f's{nw}={t:.3f}')\n      except Exception as e: vals.append(f's{nw}=ERR')\n    tq=bench(lambda: torch.bmm(z.view(bh,M,N), k.view(bh,N,D)),rep=20)\n    tk=bench(lambda: torch.bmm(z.view(bh,M,N).transpose(1,2), q.view(bh,M,D)),rep=20)\n    tr=bench(lambda: kernel.run(g,q,k,w,0.08838834764831845),rep=20)\n    print((B,M,N),*vals,f'q={tq:.3f} k={tk:.3f} run={tr:.3f}',flush=True)\n    del g,w,q,k,z\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
