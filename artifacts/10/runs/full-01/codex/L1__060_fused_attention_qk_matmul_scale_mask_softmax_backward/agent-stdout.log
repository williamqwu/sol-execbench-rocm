{"type":"item.started","item":{"id":"item_19","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch\nfor B,M,N,atol in [(1,211,211,7.52e-5),(1,512,512,4.94e-5),(1,2048,2048,2.51e-5)]:\n H,D=128,128;s=.08838834764831845\n g=torch.randn(B,H,M,N,device='cuda',dtype=torch.bfloat16)\n w=torch.randn_like(g);q=torch.randn(B,H,M,D,device='cuda',dtype=torch.bfloat16);k=torch.randn(B,H,N,D,device='cuda',dtype=torch.bfloat16)\n sm=(g.float()*w.float()).sum(-1,keepdim=True)\n l=(w.float()*(g.float()-sm)).bfloat16()\n d=l*s\n refq=torch.matmul(d,k);refk=torch.matmul(d.transpose(-2,-1),q)\n altq=(torch.matmul(l,k).float()*s).bfloat16();altk=(torch.matmul(l.transpose(-2,-1),q).float()*s).bfloat16()\n cq=torch.isclose(altq,refq,atol=atol,rtol=.0078125).float().mean().item();ck=torch.isclose(altk,refk,atol=atol,rtol=.0078125).float().mean().item()\n print((B,M,N),cq,ck,(altq-refq).abs().max().item(),flush=True)\n del g,w,q,k,sm,l,d,refq,refk,altq,altk\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
