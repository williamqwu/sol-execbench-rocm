{"type":"item.started","item":{"id":"item_15","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch,triton\nimport kernel\n\ndef bench(fn,rep=25): return triton.testing.do_bench(fn,warmup=10,rep=rep)\nfor B,M,N in [(1,211,211),(8,128,128),(32,128,128),(4,256,256),(8,256,256),(16,256,256),(2,128,256)]:\n H=D=128;bh=B*H\n g=torch.randn((B,H,M,N),device='cuda',dtype=torch.bfloat16);w=torch.randn_like(g)\n q=torch.randn((B,H,M,D),device='cuda',dtype=torch.bfloat16);k=torch.randn((B,H,N,D),device='cuda',dtype=torch.bfloat16)\n z=torch.empty_like(g);oq=torch.empty_like(q)\n bn=triton.next_power_of_2(N)\n oldsoft=lambda: kernel._softmax_backward_scale[(bh*M,)](g,w,z,.08838834764831845,n_cols=N,BLOCK_N=bn,num_warps=1)\n oldsoft()\n oldq=lambda: torch.bmm(z.view(bh,M,N),k.view(bh,N,D))\n vals=[]\n for bm,bk,nw in [(16,64,8),(16,64,4),(16,32,4)]:\n  grid=(triton.cdiv(M,bm),bh)\n  fn=lambda bm=bm,bk=bk,nw=nw,grid=grid: kernel._fused_softmax_dq[grid](g,w,k,z,oq,.08838834764831845,M=M,N=N,BLOCK_M=bm,BLOCK_K=bk,num_warps=nw)\n  vals.append(f'b{bm}k{bk}w{nw}={bench(fn):.3f}')\n print((B,M,N),*vals,f'old={bench(oldsoft)+bench(oldq):.3f}',flush=True)\n del g,w,q,k,z,oq\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
