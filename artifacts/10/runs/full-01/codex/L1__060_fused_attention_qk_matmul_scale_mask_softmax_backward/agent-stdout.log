{"type":"item.started","item":{"id":"item_35","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch,triton\nimport kernel\n\ndef bench(fn,rep=25): return triton.testing.do_bench(fn,warmup=10,rep=rep)\nfor B,S in [(1,211),(4,256),(8,256),(16,256)]:\n H=D=128;bh=B*H;s=.08838834764831845\n g=torch.randn((B,H,S,S),device='cuda',dtype=torch.bfloat16);w=torch.randn_like(g);q=torch.randn((B,H,S,D),device='cuda',dtype=torch.bfloat16);k=torch.randn_like(q);z=torch.empty_like(g);oq=torch.empty_like(q);ok=torch.empty_like(k)\n vals=[]\n for bm,nw in [(8,8),(16,4),(16,8),(32,8)]:\n  fn=lambda bm=bm,nw=nw:kernel._fused_square_stream[(bh,)](g,w,q,k,z,oq,ok,s,SIZE=S,BLOCK_N=triton.next_power_of_2(S),BLOCK_M=bm,num_warps=nw)\n  try:\n   t=bench(fn,rep=20);fn()\n   # use reference torch semantics for closeness on first config only\n   vals.append(f'm{bm}w{nw}={t:.3f}')\n  except Exception as e:vals.append(f'm{bm}w{nw}=ERR:{type(e).__name__}:{str(e)[:40]}')\n old=bench(lambda:kernel.run(g,q,k,w,s),rep=20)\n print((B,S),*vals,f'old={old:.3f}',flush=True)\n del g,w,q,k,z,oq,ok\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
