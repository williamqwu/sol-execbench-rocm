{"type":"item.started","item":{"id":"item_19","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch\nimport torch.nn.functional as F\ntorch.manual_seed(4); d='cuda'\ndef bench(fn,n=50):\n for _ in range(5):fn()\n torch.cuda.synchronize(); a=torch.cuda.Event(True);z=torch.cuda.Event(True);a.record()\n for _ in range(n):fn()\n z.record();z.synchronize();return a.elapsed_time(z)/n\nfor b in [1,8,32]:\n x=torch.randn(b,16,128,128,device=d);w=torch.randn(2432,16,2,2,device=d);bias=torch.randn(2432,device=d);pos=torch.randn(1,4096,2432,device=d)\n ref=F.conv2d(x,w,bias,stride=2).flatten(2).transpose(1,2)+pos\n def reshape_method():\n  p=x.reshape(b,16,64,2,64,2).permute(0,2,4,1,3,5).reshape(b,4096,64)\n  return F.linear(p,w.reshape(2432,64),bias)+pos\n def unfold_method():\n  p=F.unfold(x,2,stride=2).transpose(1,2)\n  return F.linear(p,w.reshape(2432,64),bias)+pos\n for name,fn in [('ref',lambda:F.conv2d(x,w,bias,stride=2).flatten(2).transpose(1,2)+pos),('reshape',reshape_method),('unfold',unfold_method)]:\n  o=fn(); q=(o-ref).abs();tol=6.5e-7+1.1920928955078125e-7*ref.abs()\n  print(b,name,bench(fn,20),'max',q.max().item(),'ratio',(q<=tol).float().mean().item(),'exact',(q==0).float().mean().item(),o.stride())\n del x,w,bias,pos,ref\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
