{"type":"item.started","item":{"id":"item_7","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch\nimport torch.nn.functional as F\n\ntorch.manual_seed(0)\nd='cuda'\n# Shared weights; normal scale is irrelevant to timing.\npw=torch.randn(2432,16,2,2,device=d)\npb=torch.randn(2432,device=d)\npos=torch.randn(1,4096,2432,device=d)\ncw=torch.randn(2432,4096,device=d)\ncb=torch.randn(2432,device=d)\ntw1=torch.randn(2432,256,device=d); tb1=torch.randn(2432,device=d)\ntw2=torch.randn(2432,2432,device=d); tb2=torch.randn(2432,device=d)\nqw1=torch.randn(2432,2048,device=d); qb1=torch.randn(2432,device=d)\nqw2=torch.randn(2432,2432,device=d); qb2=torch.randn(2432,device=d)\nfreq=torch.randn(128,device=d)\n\ndef bench(fn, n=30):\n    for _ in range(5): fn()\n    torch.cuda.synchronize()\n    a=torch.cuda.Event(enable_timing=True); z=torch.cuda.Event(enable_timing=True)\n    a.record()\n    for _ in range(n): fn()\n    z.record(); z.synchronize()\n    return a.elapsed_time(z)/n\nfor b,s in [(1,77),(2,211),(8,77),(32,541)]:\n    x=torch.randn(b,16,128,128,device=d)\n    e=torch.randn(b,s,4096,device=d)\n    p=torch.randn(b,2048,device=d)\n    t=torch.randn(b,device=d)\n    conv=lambda:F.conv2d(x,pw,pb,stride=2)\n    cv=conv()\n    patch=lambda:conv().flatten(2).transpose(1,2)+pos\n    context=lambda:F.linear(e,cw,cb)\n    def cond():\n        a=t[:,None]*freq[None,:]\n        ts=torch.cat((torch.cos(a),torch.sin(a)),dim=1)\n        te=F.linear(F.silu(F.linear(ts,tw1,tb1)),tw2,tb2)\n        pe=F.linear(F.silu(F.linear(p,qw1,qb1)),qw2,qb2)\n        return te+pe\n    print(b,s,'conv',bench(conv),'patch',bench(patch),'ctx',bench(context),'cond',bench(cond))\n    del x,e,p,t,cv\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
