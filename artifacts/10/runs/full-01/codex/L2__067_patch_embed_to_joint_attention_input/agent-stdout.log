{"type":"item.started","item":{"id":"item_45","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch,triton\nfrom kernel import _transpose_add_kernel\ntorch.manual_seed(20);d='cuda';pos=torch.randn(1,4096,2432,device=d)\ndef make(cv,bp,bn,nw):\n def f():\n  out=torch.empty((cv.shape[0],4096,2432),device=d)\n  _transpose_add_kernel[(triton.cdiv(4096,bp),triton.cdiv(2432,bn),cv.shape[0])](cv,pos,out,PATCHES=4096,WIDTH=2432,BLOCK_P=bp,BLOCK_N=bn,num_warps=nw)\n  return out\n return f\ndef bench(fn,n):\n for _ in range(3):fn()\n torch.cuda.synchronize();a=torch.cuda.Event(True);z=torch.cuda.Event(True);a.record()\n for _ in range(n):fn()\n z.record();z.synchronize();return a.elapsed_time(z)/n\nconfigs=[(16,16,4),(16,32,4),(32,16,4),(32,32,4),(32,32,8),(16,64,4),(64,16,4),(32,64,4),(64,32,4),(32,64,8),(64,32,8),(64,64,4),(64,64,8),(128,32,8),(32,128,8)]\nfor b in [1,8,32,64]:\n cv=torch.randn(b,2432,64,64,device=d);print('B',b)\n for cfg in configs:\n  try:print(cfg,bench(make(cv,*cfg),30 if b<32 else 10))\n  except Exception as e:print(cfg,'ERR',type(e).__name__,str(e)[:100])\n del cv\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
