{"type":"item.started","item":{"id":"item_57","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch,torch.nn.functional as F\nfrom kernel import _sincos\ntorch.manual_seed(24);d='cuda';tw1=torch.randn(2432,256,device=d);tb1=torch.randn(2432,device=d);tw2=torch.randn(2432,2432,device=d);tb2=torch.randn(2432,device=d);qw1=torch.randn(2432,2048,device=d);qb1=torch.randn(2432,device=d);qw2=torch.randn(2432,2432,device=d);qb2=torch.randn(2432,device=d);freq=torch.randn(128,device=d);sp=torch.cuda.Stream()\ndef bench(fn,n=100):\n for _ in range(10):fn()\n torch.cuda.synchronize();a=torch.cuda.Event(True);z=torch.cuda.Event(True);a.record()\n for _ in range(n):fn()\n z.record();z.synchronize();return a.elapsed_time(z)/n\nfor b in [1,2,4,8,16,32,64]:\n t=torch.randn(b,device=d);p=torch.randn(b,2048,device=d)\n def seq():\n  ts=_sincos(t,freq);te=F.linear(F.silu(F.linear(ts,tw1,tb1)),tw2,tb2);pe=F.linear(F.silu(F.linear(p,qw1,qb1)),qw2,qb2);return te+pe\n def par():\n  cur=torch.cuda.current_stream();sp.wait_stream(cur)\n  with torch.cuda.stream(sp):pe=F.linear(F.silu(F.linear(p,qw1,qb1)),qw2,qb2)\n  ts=_sincos(t,freq);te=F.linear(F.silu(F.linear(ts,tw1,tb1)),tw2,tb2);cur.wait_stream(sp);return te+pe\n r=seq();o=par();torch.cuda.synchronize();print(b,torch.equal(r,o),bench(seq),bench(par));del t,p,r,o\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
