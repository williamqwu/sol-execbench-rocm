{"type":"item.started","item":{"id":"item_39","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch,torch.nn.functional as F\nfrom kernel import _sincos\ntorch.manual_seed(19);d='cuda';tw1=torch.randn(2432,256,device=d);tb1=torch.randn(2432,device=d);tw2=torch.randn(2432,2432,device=d);tb2=torch.randn(2432,device=d);qw1=torch.randn(2432,2048,device=d);qb1=torch.randn(2432,device=d);qw2=torch.randn(2432,2432,device=d);qb2=torch.randn(2432,device=d);freq=torch.randn(128,device=d)\ndef bench(fn,n=100):\n for _ in range(10):fn()\n torch.cuda.synchronize();a=torch.cuda.Event(True);z=torch.cuda.Event(True);a.record()\n for _ in range(n):fn()\n z.record();z.synchronize();return a.elapsed_time(z)/n\nfor b in [1,2,4,8,16,32,64]:\n t=torch.randn(b,device=d);p=torch.randn(b,2048,device=d)\n def e():\n  a=t[:,None]*freq[None,:];ts=torch.cat((torch.cos(a),torch.sin(a)),1);te=F.linear(F.silu(F.linear(ts,tw1,tb1)),tw2,tb2);pe=F.linear(F.silu(F.linear(p,qw1,qb1)),qw2,qb2);return te+pe\n def c():\n  ts=_sincos(t,freq);te=F.linear(F.silu(F.linear(ts,tw1,tb1)),tw2,tb2);pe=F.linear(F.silu(F.linear(p,qw1,qb1)),qw2,qb2);return te+pe\n er=t[:,None]*freq[None,:];fr=torch.cat((torch.cos(er),torch.sin(er)),1);fo=_sincos(t,freq);r=e();o=c();q=(r-o).abs();tol=6.2e-7+1.1920928955078125e-7*r.abs()\n print(b,'feat',torch.equal(fr,fo),(fr-fo).abs().max().item(),'out',q.max().item(),(q<=tol).float().mean().item(),(q==0).float().mean().item(),'time',bench(e),bench(c));del t,p\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
