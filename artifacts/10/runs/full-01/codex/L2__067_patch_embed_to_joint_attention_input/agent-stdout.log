{"type":"item.started","item":{"id":"item_30","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch\nimport torch.nn.functional as F\nfrom kernel import _transpose_add\n\ntorch.manual_seed(12);d='cuda'\npw=torch.randn(2432,16,2,2,device=d);pb=torch.randn(2432,device=d);pos=torch.randn(1,4096,2432,device=d)\ncw=torch.randn(2432,4096,device=d);cb=torch.randn(2432,device=d)\ntw1=torch.randn(2432,256,device=d);tb1=torch.randn(2432,device=d);tw2=torch.randn(2432,2432,device=d);tb2=torch.randn(2432,device=d)\nqw1=torch.randn(2432,2048,device=d);qb1=torch.randn(2432,device=d);qw2=torch.randn(2432,2432,device=d);qb2=torch.randn(2432,device=d);freq=torch.randn(128,device=d)\ns1=torch.cuda.Stream();s2=torch.cuda.Stream();s3=torch.cuda.Stream()\ndef bench(fn,n):\n for _ in range(5):fn()\n torch.cuda.synchronize();cur=torch.cuda.current_stream();a=torch.cuda.Event(True);z=torch.cuda.Event(True);a.record()\n for _ in range(n):fn()\n z.record();z.synchronize();return a.elapsed_time(z)/n\nfor b,s in [(1,77),(2,211),(8,77),(32,541),(64,1489)]:\n x=torch.randn(b,16,128,128,device=d);e=torch.randn(b,s,4096,device=d);p=torch.randn(b,2048,device=d);t=torch.randn(b,device=d)\n def tseq():\n  patch=_transpose_add(F.conv2d(x,pw,pb,stride=2),pos)\n  a=t[:,None]*freq[None,:];ts=torch.cat((torch.cos(a),torch.sin(a)),1)\n  te=F.linear(F.silu(F.linear(ts,tw1,tb1)),tw2,tb2)\n  pe=F.linear(F.silu(F.linear(p,qw1,qb1)),qw2,qb2)\n  return patch,te+pe,F.linear(e,cw,cb)\n def tpar():\n  cur=torch.cuda.current_stream();s1.wait_stream(cur);s2.wait_stream(cur);s3.wait_stream(cur)\n  with torch.cuda.stream(s1):\n   ctx=F.linear(e,cw,cb)\n  with torch.cuda.stream(s2):\n   a=t[:,None]*freq[None,:];ts=torch.cat((torch.cos(a),torch.sin(a)),1)\n   te=F.linear(F.silu(F.linear(ts,tw1,tb1)),tw2,tb2)\n  with torch.cuda.stream(s3):\n   pe=F.linear(F.silu(F.linear(p,qw1,qb1)),qw2,qb2)\n  patch=_transpose_add(F.conv2d(x,pw,pb,stride=2),pos)\n  cur.wait_stream(s1);cur.wait_stream(s2);cur.wait_stream(s3)\n  return patch,te+pe,ctx\n r=tseq();o=tpar();torch.cuda.synchronize();print('equal',b,s,[torch.equal(a,q) for a,q in zip(r,o)])\n print('time',b,s,bench(tseq,20 if b<32 else 8),bench(tpar,20 if b<32 else 8))\n del x,e,p,t,r,o\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
