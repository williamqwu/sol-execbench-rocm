n_states,\n            expert_outputs,\n            token_indices,\n            buckets,\n            num_tokens=num_tokens,\n            num_selected=num_selected,\n            hidden_size=hidden_size,\n            CAPACITY=capacity,\n            BLOCK_H=block_h,\n            PAIR_ROWS=num_tokens < 8192,\n            num_warps=warps,\n        )\n    return output\n","exit_code":0,"status":"completed"}}
