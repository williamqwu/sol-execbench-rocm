{"type":"item.started","item":{"id":"item_31","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch\nimport triton\nimport kernel\nfor n in (131,256,512,1024,2048,4096,8192):\n    h=3072; m=8*n; cap=32\n    x=torch.randn((n,h),device='cuda',dtype=torch.bfloat16)\n    e=torch.randn((m,h),device='cuda',dtype=torch.bfloat16)\n    i=torch.randint(0,n,(m,),device='cuda',dtype=torch.int64)\n    o=torch.empty_like(x); b=torch.empty(n*(cap+1),device='cuda',dtype=torch.int32)\n    kernel._fill_counts[(triton.cdiv(n,256),)](b,num_tokens=n,BLOCK=256,num_warps=4)\n    kernel._build_buckets[(triton.cdiv(m,256),)](b,i,num_tokens=n,num_selected=m,CAPACITY=cap,BLOCK=256,num_warps=4)\n    def s3(): kernel._gather_buckets[(3,n)](o,x,e,b,num_tokens=n,hidden_size=h,CAPACITY=cap,BLOCK_H=1024,num_warps=8)\n    def t512(): kernel._gather_token_512[(n,)](o,x,e,b,num_tokens=n,hidden_size=h,CAPACITY=cap,BLOCK_H=512,num_warps=8)\n    def t1w4(): kernel._gather_token_1024[(n,)](o,x,e,b,num_tokens=n,hidden_size=h,CAPACITY=cap,BLOCK_H=1024,num_warps=4)\n    def t1w8(): kernel._gather_token_1024[(n,)](o,x,e,b,num_tokens=n,hidden_size=h,CAPACITY=cap,BLOCK_H=1024,num_warps=8)\n    vals=[triton.testing.do_bench(f,warmup=20,rep=100) for f in (s3,t512,t1w4,t1w8)]\n    print(n, 's3/t512/t1w4/t1w8', *vals)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
