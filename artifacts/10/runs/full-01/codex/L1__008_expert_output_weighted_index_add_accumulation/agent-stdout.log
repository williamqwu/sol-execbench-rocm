{"type":"item.started","item":{"id":"item_32","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch\nimport triton\nimport kernel\n\ndef make_inputs(n):\n h=3072; m=8*n\n return (torch.randn((n,h),device='cuda',dtype=torch.bfloat16),torch.randn((m,h),device='cuda',dtype=torch.bfloat16),torch.randint(0,n,(m,),device='cuda',dtype=torch.int64))\ndef prep(x,e,i):\n n=x.shape[0]; m=e.shape[0]; b=torch.empty(n*33,device=x.device,dtype=torch.int32); o=torch.empty_like(x)\n kernel._fill_counts[(triton.cdiv(n,256),)](b,num_tokens=n,BLOCK=256,num_warps=4)\n kernel._build_buckets[(triton.cdiv(m,256),)](b,i,num_tokens=n,num_selected=m,CAPACITY=32,BLOCK=256,num_warps=4)\n return o,b\ndef rs(x,e,i):\n o,b=prep(x,e,i); n=x.shape[0]\n kernel._gather_buckets[(3,n)](o,x,e,b,num_tokens=n,hidden_size=3072,CAPACITY=32,BLOCK_H=1024,num_warps=8)\n return o\ndef rt(x,e,i):\n o,b=prep(x,e,i); n=x.shape[0]\n kernel._gather_token_1024[(n,)](o,x,e,b,num_tokens=n,hidden_size=3072,CAPACITY=32,BLOCK_H=1024,num_warps=8)\n return o\nfor n in (131,256,512):\n x,e,i=make_inputs(n)\n a=triton.testing.do_bench(lambda:rs(x,e,i),warmup=50,rep=300)\n b=triton.testing.do_bench(lambda:rt(x,e,i),warmup=50,rep=300)\n c=triton.testing.do_bench(lambda:rs(x,e,i),warmup=50,rep=300)\n d=triton.testing.do_bench(lambda:rt(x,e,i),warmup=50,rep=300)\n print(n,a,b,c,d)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
