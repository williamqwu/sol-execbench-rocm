{"type":"item.started","item":{"id":"item_9","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch\nfor s in (256,1024,2048):\n b=1\n q=(torch.rand((b,16,s,64),device='cuda')-.2)*700; k=(torch.rand((b,4,s,64),device='cuda')-.2)*700; v=torch.rand((b,4,s,64),device='cuda')*600\n kr=k[:,:,None].expand(b,4,4,s,64).reshape(b,16,s,64); vr=v[:,:,None].expand(b,4,4,s,64).reshape(b,16,s,64)\n def manual(): return torch.softmax(torch.matmul(q,kr.transpose(2,3))/8,dim=-1,dtype=torch.float32)@vr\n q5=q.view(b,4,4,s,64)\n def grouped():\n  a=torch.softmax(torch.matmul(q5,k.unsqueeze(2).transpose(-2,-1))/8,dim=-1,dtype=torch.float32)\n  return torch.matmul(a,v.unsqueeze(2)).view(b,16,s,64)\n ref=manual(); out=grouped(); d=(out-ref).abs(); rel=d/ref.abs().clamp_min(1e-30)\n print('s',s,'maxabs',d.max().item(),'match',((d<=1.4e-7)|(rel<=1.1920929e-7)).float().mean().item())\n for fn,name in ((manual,'manual'),(grouped,'grouped')):\n  for _ in range(3):fn()\n  st=torch.cuda.Event(True);en=torch.cuda.Event(True);st.record()\n  for _ in range(20):fn()\n  en.record();en.synchronize();print(name,st.elapsed_time(en)/20)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
