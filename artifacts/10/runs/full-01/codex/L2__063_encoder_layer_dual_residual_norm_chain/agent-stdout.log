{"type":"item.completed","item":{"id":"item_28","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,280p' kernel.py\"","aggregated_output":"import torch\nimport triton\nimport triton.language as tl\n\n\n@triton.jit\ndef _norm_mul_kernel(x, inv_rms, weight, out, n_tokens: tl.constexpr):\n    token = tl.program_id(0)\n    d = tl.arange(0, 1024)\n    xval = tl.load(x + token * 1024 + d)\n    scale = tl.load(inv_rms + token)\n    w = tl.load(weight + d)\n    # Keep the same two rounded multiplies as the eager expression.\n    y = xval * scale\n    y = w * y\n    tl.store(out + token * 1024 + d, y)\n\n\n@triton.jit\ndef _qkv_rope_repeat_kernel(q_proj, k_proj, v_proj, cos, sin, q_out, k_out, v_out):\n    row = tl.program_id(0)\n    token = row // 16\n    head = row - token * 16\n    kv_head = head // 4\n    d = tl.arange(0, 64)\n    rd = tl.where(d < 32, d + 32, d - 32)\n\n    q_base = token * 1024 + head * 64\n    kv_base = token * 256 + kv_head * 64\n    pos_base = token * 64\n\n    q = tl.load(q_proj + q_base + d)\n    qr = tl.load(q_proj + q_base + rd)\n    k = tl.load(k_proj + kv_base + d)\n    kr = tl.load(k_proj + kv_base + rd)\n    c = tl.load(cos + pos_base + d)\n    s = tl.load(sin + pos_base + d)\n    qrot = tl.where(d < 32, -qr, qr)\n    krot = tl.where(d < 32, -kr, kr)\n\n    out_base = row * 64\n    tl.store(q_out + out_base + d, q * c + qrot * s)\n    tl.store(k_out + out_base + d, k * c + krot * s)\n    tl.store(v_out + out_base + d, tl.load(v_proj + kv_base + d))\n\n\n@triton.jit\ndef _softmax_inplace_kernel(x, n_cols: tl.constexpr, BLOCK: tl.constexpr):\n    row = tl.program_id(0)\n    cols = tl.arange(0, BLOCK)\n    mask = cols < n_cols\n    z = tl.load(x + row * n_cols + cols, mask=mask, other=-float(\"inf\"))\n    z = z * 0.125\n    z = z - tl.max(z, axis=0)\n    numerator = tl.exp(z)\n    denominator = tl.sum(numerator, axis=0)\n    tl.store(x + row * n_cols + cols, numerator / denominator, mask=mask)\n\n\n@triton.jit\ndef _silu_mul_kernel(gate_up, out, n_elements: tl.constexpr, BLOCK: tl.constexpr):\n    offs = tl.program_id(0) * BLOCK + tl.arange(0, BLOCK)\n    mask = offs < n_elements\n    token = offs // 4096\n    d = offs - token * 4096\n    gate = tl.load(gate_up + token * 8192 + d, mask=mask)\n    up = tl.load(gate_up + token * 8192 + 4096 + d, mask=mask)\n    silu = gate * tl.sigmoid(gate)\n    tl.store(out + offs, up * silu, mask=mask)\n\n\ndef _rms_norm(x, weight, eps):\n    shape = x.shape\n    flat = x.reshape(-1, 1024)\n    variance = flat.pow(2).mean(-1, keepdim=True)\n    inv_rms = torch.rsqrt(variance + eps)\n    out = torch.empty_like(flat)\n    _norm_mul_kernel[(flat.shape[0],)](\n        flat, inv_rms, weight, out, flat.shape[0], num_warps=4\n    )\n    return out.view(shape)\n\n\n@torch.no_grad()\ndef run(\n    hidden_states,\n    cos,\n    sin,\n    pre_sa_norm_weight,\n    q_proj_weight,\n    k_proj_weight,\n    v_proj_weight,\n    o_proj_weight,\n    post_sa_norm_weight,\n    gate_up_proj_weight,\n    down_proj_weight,\n    norm_eps,\n):\n    batch_size, seq_len, _ = hidden_states.shape\n    n_tokens = batch_size * seq_len\n\n    normed_1 = _rms_norm(hidden_states, pre_sa_norm_weight, norm_eps)\n\n    q_proj = torch.matmul(normed_1, q_proj_weight.t()).view(n_tokens, 1024)\n    k_proj = torch.matmul(normed_1, k_proj_weight.t()).view(n_tokens, 256)\n    v_proj = torch.matmul(normed_1, v_proj_weight.t()).view(n_tokens, 256)\n\n    q = torch.empty(\n        (batch_size, 16, seq_len, 64), device=hidden_states.device, dtype=hidden_states.dtype\n    )\n    k = torch.empty_like(q)\n    v = torch.empty_like(q)\n    _qkv_rope_repeat_kernel[(n_tokens * 16,)](\n        q_proj, k_proj, v_proj, cos, sin, q, k, v, num_warps=1\n    )\n\n    attn_weights = torch.matmul(q, k.transpose(2, 3))\n    softmax_block = triton.next_power_of_2(seq_len)\n    softmax_warps = 8 if softmax_block >= 2048 else 4\n    _softmax_inplace_kernel[(batch_size * 16 * seq_len,)](\n        attn_weights,\n        n_cols=seq_len,\n        BLOCK=softmax_block,\n        num_warps=softmax_warps,\n    )\n    attn_output = torch.matmul(attn_weights, v)\n    attn_output = (\n        attn_output.transpose(1, 2).contiguous().view(n_tokens, 1024)\n    )\n\n    residual_1_2d = hidden_states.view(n_tokens, 1024)\n    residual_2 = torch.addmm(residual_1_2d, attn_output, o_proj_weight.t())\n    residual_2_3d = residual_2.view(batch_size, seq_len, 1024)\n\n    normed_2 = _rms_norm(residual_2_3d, post_sa_norm_weight, norm_eps)\n    gate_up = torch.matmul(normed_2, gate_up_proj_weight.t()).view(n_tokens, 8192)\n    activated = torch.empty(\n        (n_tokens, 4096), device=hidden_states.device, dtype=hidden_states.dtype\n    )\n    n_act = n_tokens * 4096\n    _silu_mul_kernel[(triton.cdiv(n_act, 256),)](\n        gate_up, activated, n_elements=n_act, BLOCK=256, num_warps=4\n    )\n    output = torch.addmm(residual_2, activated, down_proj_weight.t())\n    return output.view(batch_size, seq_len, 1024)\n","exit_code":0,"status":"completed"}}
