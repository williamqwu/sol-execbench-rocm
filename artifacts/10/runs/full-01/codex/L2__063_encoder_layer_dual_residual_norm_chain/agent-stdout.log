{"type":"item.started","item":{"id":"item_8","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch, torch.nn.functional as F, time\nfor s in (256, 1024, 2048):\n    b=1\n    q=(torch.rand((b,16,s,64),device='cuda')-.2)*700\n    k=(torch.rand((b,4,s,64),device='cuda')-.2)*700\n    v=torch.rand((b,4,s,64),device='cuda')*600\n    kr=k[:,:,None].expand(b,4,4,s,64).reshape(b,16,s,64)\n    vr=v[:,:,None].expand(b,4,4,s,64).reshape(b,16,s,64)\n    ref=torch.softmax(torch.matmul(q,kr.transpose(2,3))/8,dim=-1,dtype=torch.float32).to(q.dtype) @ vr\n    try:\n      out=F.scaled_dot_product_attention(q,k,v,scale=0.125,enable_gqa=True)\n    except Exception as e:\n      print('s',s,'ERROR',type(e).__name__,e)\n      continue\n    d=(out-ref).abs(); rel=d/ref.abs().clamp_min(1e-30)\n    print('s',s,'maxabs',d.max().item(),'maxrel',rel.max().item(),'p99rel',torch.quantile(rel.flatten(),.99).item(),'match',((d<=1.4e-7)|(rel<=1.1920929e-7)).float().mean().item())\n    for fn,name in [(lambda: torch.softmax(torch.matmul(q,kr.transpose(2,3))/8,dim=-1,dtype=torch.float32)@vr,'manual'),(lambda:F.scaled_dot_product_attention(q,k,v,scale=.125,enable_gqa=True),'sdpa')]:\n      for _ in range(3): fn()\n      torch.cuda.synchronize(); st=torch.cuda.Event(True); en=torch.cuda.Event(True); st.record()\n      for _ in range(10): fn()\n      en.record(); en.synchronize()\n      print(name,st.elapsed_time(en)/10)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
