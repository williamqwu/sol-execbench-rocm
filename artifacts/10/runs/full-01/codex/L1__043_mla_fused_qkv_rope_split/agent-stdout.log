{"type":"item.started","item":{"id":"item_24","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch\nimport torch.nn.functional as F\nfrom kernel import _rmsnorm_inplace_kernel\n\ntorch.manual_seed(5)\nwa=torch.randn((1536,7168),device='cuda',dtype=torch.bfloat16)\nwln=torch.randn((1536,),device='cuda',dtype=torch.bfloat16)\nwb=torch.randn((24576,1536),device='cuda',dtype=torch.bfloat16)\nwkv=torch.randn((576,7168),device='cuda',dtype=torch.bfloat16)\nfor M in (131,256,1024,1492,4096,8192):\n x=torch.randn((M,7168),device='cuda',dtype=torch.bfloat16)\n print('M',M)\n for backend in ('hipblaslt','hipblas','ck'):\n  try:\n   torch.backends.cuda.preferred_blas_library(backend)\n   def f():\n    kv=F.linear(x,wkv); a=F.linear(x,wa)\n    _rmsnorm_inplace_kernel[(M,)](a,wln,1e-6,BLOCK=2048,num_warps=1)\n    q=F.linear(a,wb); return q,kv\n   for _ in range(8): f()\n   torch.cuda.synchronize(); ts=[]\n   for _ in range(30):\n    st=torch.cuda.Event(enable_timing=True); en=torch.cuda.Event(enable_timing=True)\n    st.record(); y=f(); en.record(); en.synchronize(); ts.append(st.elapsed_time(en))\n   print(backend,sorted(ts)[15],min(ts))\n  except Exception as e:\n   print(backend,'ERROR',type(e).__name__,str(e)[:200])\n torch.backends.cuda.preferred_blas_library('hipblaslt')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
