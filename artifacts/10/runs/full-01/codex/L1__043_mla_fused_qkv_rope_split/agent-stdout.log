{"type":"item.started","item":{"id":"item_18","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch\nimport torch.nn.functional as F\nfrom kernel import _rmsnorm_inplace_kernel\n\ntorch.manual_seed(3)\nwa=torch.randn((1536,7168),device='cuda',dtype=torch.bfloat16)\nwln=torch.randn((1536,),device='cuda',dtype=torch.bfloat16)\nwb=torch.randn((24576,1536),device='cuda',dtype=torch.bfloat16)\nwkv=torch.randn((576,7168),device='cuda',dtype=torch.bfloat16)\n\ndef measure(M):\n    x=torch.randn((M,7168),device='cuda',dtype=torch.bfloat16)\n    def current():\n        a=F.linear(x,wa)\n        _rmsnorm_inplace_kernel[(M,)](a,wln,1e-6,BLOCK=2048,num_warps=4)\n        q=F.linear(a,wb)\n        kv=F.linear(x,wkv)\n        return q,kv\n    def reordered():\n        a=F.linear(x,wa)\n        kv=F.linear(x,wkv)\n        _rmsnorm_inplace_kernel[(M,)](a,wln,1e-6,BLOCK=2048,num_warps=4)\n        q=F.linear(a,wb)\n        return q,kv\n    ans=[]\n    for f in (current,reordered):\n        for _ in range(8): f()\n        torch.cuda.synchronize()\n        ts=[]\n        for _ in range(40):\n            st=torch.cuda.Event(enable_timing=True); en=torch.cuda.Event(enable_timing=True)\n            st.record(); y=f(); en.record(); en.synchronize(); ts.append(st.elapsed_time(en))\n        ans.append((sorted(ts)[len(ts)//2],min(ts)))\n    print(M,ans)\nfor M in (131,256,1024,1492,4096,8192): measure(M)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
