{"type":"item.started","item":{"id":"item_33","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch, aiter\nimport torch.nn.functional as F\n\ntorch.manual_seed(8)\nwa=torch.randn((1536,7168),device='cuda',dtype=torch.bfloat16)\nwb=torch.randn((24576,1536),device='cuda',dtype=torch.bfloat16)\nwkv=torch.randn((576,7168),device='cuda',dtype=torch.bfloat16)\nfor M in (131,256,1024,1492,4096,8192):\n print('M',M)\n for tag,K,N,w in [('qa',7168,1536,wa),('qb',1536,24576,wb),('kv',7168,576,wkv)]:\n  a=torch.randn((M,K),device='cuda',dtype=torch.bfloat16)\n  ref=F.linear(a,w)\n  for name,f in [('lt',lambda:F.linear(a,w)),('opus',lambda:aiter.gemm_a16w16_opus(a,w))]:\n   try:\n    for _ in range(5): out=f()\n    torch.cuda.synchronize(); ts=[]\n    for _ in range(30):\n     s=torch.cuda.Event(enable_timing=True);e=torch.cuda.Event(enable_timing=True);s.record();out=f();e.record();e.synchronize();ts.append(s.elapsed_time(e))\n    match=torch.isclose(out.float(),ref.float(),atol=.007813,rtol=.0078125).float().mean().item()\n    print(tag,name,sorted(ts)[15],min(ts),'match',match,'max',(out.float()-ref.float()).abs().max().item())\n   except Exception as ex: print(tag,name,'ERR',type(ex).__name__,str(ex)[:200])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
