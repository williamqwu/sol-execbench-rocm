{"type":"item.completed","item":{"id":"item_26","type":"agent_message","text":"hipBLASLt wins decisively among packaged BLAS backends. I’m doing one bounded prototype of a direct Triton query-B matmul—the only remaining hotspot—with a handful of CDNA-friendly tiles. If it cannot match hipBLASLt, I’ll keep the proven library GEMM and spend the final verification on the smaller launch/cache refinements."}}
{"type":"item.started","item":{"id":"item_27","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch, triton\nimport triton.language as tl\nimport torch.nn.functional as F\n\n@triton.jit\ndef mm_kernel(a,b,c,M:tl.constexpr,N:tl.constexpr,K:tl.constexpr,\n              BM:tl.constexpr,BN:tl.constexpr,BK:tl.constexpr,GROUP_M:tl.constexpr):\n    pid=tl.program_id(0)\n    n_pm=tl.cdiv(M,BM); n_pn=tl.cdiv(N,BN); group=GROUP_M*n_pn\n    gid=pid//group; first_m=gid*GROUP_M; actual=tl.minimum(n_pm-first_m,GROUP_M)\n    pm=first_m+(pid%group)%actual; pn=(pid%group)//actual\n    im=pm*BM+tl.arange(0,BM); jn=pn*BN+tl.arange(0,BN); kk=tl.arange(0,BK)\n    ap=a+im[:,None]*K+kk[None,:]\n    bp=b+jn[None,:]*K+kk[:,None]\n    acc=tl.zeros((BM,BN),tl.float32)\n    for k in range(0,K,BK):\n        av=tl.load(ap,mask=im[:,None]<M,other=0.)\n        bv=tl.load(bp)\n        acc+=tl.dot(av,bv)\n        ap+=BK; bp+=BK\n    tl.store(c+im[:,None]*N+jn[None,:],acc,mask=(im[:,None]<M)&(jn[None,:]<N))\n\ntorch.manual_seed(7)\nN=24576; K=1536\nb=torch.randn((N,K),device='cuda',dtype=torch.bfloat16)\nconfigs=[(16,128,32,4,2),(32,128,32,4,2),(64,128,32,4,2),(64,128,64,4,2),(64,256,32,8,2),(128,128,32,8,2),(32,256,32,8,2)]\nfor M in (256,1024,4096):\n a=torch.randn((M,K),device='cuda',dtype=torch.bfloat16); ref=F.linear(a,b); out=torch.empty((M,N),device='cuda',dtype=torch.bfloat16)\n for _ in range(5): F.linear(a,b)\n torch.cuda.synchronize(); ts=[]\n for _ in range(30):\n  s=torch.cuda.Event(enable_timing=True);e=torch.cuda.Event(enable_timing=True);s.record();z=F.linear(a,b);e.record();e.synchronize();ts.append(s.elapsed_time(e))\n print('M',M,'hipblaslt',sorted(ts)[15])\n for BM,BN,BK,nw,ns in configs:\n  grid=(triton.cdiv(M,BM)*triton.cdiv(N,BN),)\n  try:\n   for _ in range(3): mm_kernel[grid](a,b,out,M=M,N=N,K=K,BM=BM,BN=BN,BK=BK,GROUP_M=8,num_warps=nw,num_stages=ns)\n   torch.cuda.synchronize(); ts=[]\n   for _ in range(15):\n    s=torch.cuda.Event(enable_timing=True);e=torch.cuda.Event(enable_timing=True);s.record();mm_kernel[grid](a,b,out,M=M,N=N,K=K,BM=BM,BN=BN,BK=BK,GROUP_M=8,num_warps=nw,num_stages=ns);e.record();e.synchronize();ts.append(s.elapsed_time(e))\n   diff=(out.float()-ref.float()).abs(); close=torch.isclose(out.float(),ref.float(),atol=.007813,rtol=.0078125).float().mean().item()\n   print((BM,BN,BK,nw,ns),sorted(ts)[7],'match',close,'max',diff.max().item())\n  except Exception as ex: print((BM,BN,BK,nw,ns),'ERR',type(ex).__name__,str(ex)[:120])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
