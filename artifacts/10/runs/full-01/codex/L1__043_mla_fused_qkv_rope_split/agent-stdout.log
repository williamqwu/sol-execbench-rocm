{"type":"item.started","item":{"id":"item_12","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch\nimport reference, kernel\n\ntorch.manual_seed(2)\nM=256\ndev='cuda'\nx=torch.randn((1,M,7168),device=dev,dtype=torch.bfloat16)\nwa=torch.randn((1536,7168),device=dev,dtype=torch.bfloat16)\nwln=torch.randn((1536,),device=dev,dtype=torch.bfloat16)\nwb=torch.randn((24576,1536),device=dev,dtype=torch.bfloat16)\nwkv=torch.randn((576,7168),device=dev,dtype=torch.bfloat16)\nargs=(x,wa,wln,wb,wkv,1e-6)\ny_ref=reference.run(*args)\ny=kernel.run(*args)\ntorch.cuda.synchronize()\nfor i,(a,b) in enumerate(zip(y,y_ref)):\n    af=a.float(); bf=b.float()\n    close=torch.isclose(af,bf,atol=0.007813,rtol=0.0078125)\n    print(i, 'shape',tuple(a.shape),'match',close.float().mean().item(),'maxabs',(af-bf).abs().max().item())\nfor name,f in [('reference',reference.run),('custom',kernel.run)]:\n    for _ in range(5): f(*args)\n    torch.cuda.synchronize()\n    ts=[]\n    for _ in range(30):\n        st=torch.cuda.Event(enable_timing=True); en=torch.cuda.Event(enable_timing=True)\n        st.record(); z=f(*args); en.record(); en.synchronize(); ts.append(st.elapsed_time(en))\n    print(name, sorted(ts)[len(ts)//2], min(ts))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
