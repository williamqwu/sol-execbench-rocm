{"type":"item.started","item":{"id":"item_10","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch\nimport torch.nn.functional as F\n\ntorch.manual_seed(1)\ndev='cuda'\nM=1024\nx=torch.randn((M,7168),device=dev,dtype=torch.bfloat16)\nwa=torch.randn((1536,7168),device=dev,dtype=torch.bfloat16)\nwln=torch.randn((1536,),device=dev,dtype=torch.bfloat16)\nwb=torch.randn((24576,1536),device=dev,dtype=torch.bfloat16)\nwkv=torch.randn((576,7168),device=dev,dtype=torch.bfloat16)\n\ndef serial():\n    a=F.linear(x,wa)\n    af=a.float(); v=af.square().mean(-1,keepdim=True)\n    a=wln*(af*torch.rsqrt(v+1e-6)).to(a.dtype)\n    q=F.linear(a,wb).view(M,128,192)\n    kv=F.linear(x,wkv)\n    return q[...,:128],q[...,128:],kv[...,:512],kv[...,512:]\n\nsq=torch.cuda.Stream()\nskv=torch.cuda.Stream()\ndef overlap():\n    cur=torch.cuda.current_stream()\n    sq.wait_stream(cur); skv.wait_stream(cur)\n    with torch.cuda.stream(sq):\n        a=F.linear(x,wa)\n        af=a.float(); v=af.square().mean(-1,keepdim=True)\n        a=wln*(af*torch.rsqrt(v+1e-6)).to(a.dtype)\n        q=F.linear(a,wb).view(M,128,192)\n    with torch.cuda.stream(skv):\n        kv=F.linear(x,wkv)\n    cur.wait_stream(sq); cur.wait_stream(skv)\n    return q[...,:128],q[...,128:],kv[...,:512],kv[...,512:]\n\nfor f in (serial,overlap):\n    for _ in range(5): f()\n    torch.cuda.synchronize()\n    times=[]\n    for _ in range(30):\n        st=torch.cuda.Event(enable_timing=True); en=torch.cuda.Event(enable_timing=True)\n        st.record(); y=f(); en.record(); en.synchronize(); times.append(st.elapsed_time(en))\n    print(f.__name__, sorted(times)[len(times)//2], min(times))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
