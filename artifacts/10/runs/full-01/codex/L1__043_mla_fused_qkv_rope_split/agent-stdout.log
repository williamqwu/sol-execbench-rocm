{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"cat definition.json && printf '\\\\n--- reference.py ---\\\\n' && cat reference.py && printf '\\\\n--- workload.jsonl ---\\\\n' && cat workload.jsonl\"","aggregated_output":"{\n  \"name\": \"043_mla_fused_qkv_rope_split\",\n  \"description\": \"Fused Multi-head Latent Attention (MLA) QKV projection with RoPE split. Combines query low-rank projection (q_a_proj -> RMSNorm -> q_b_proj) with tensor splitting and key-value joint projection with split into a single operation. Eliminates intermediate memory writes for the latent representations.\",\n  \"hf_id\": \"deepseek-ai/DeepSeek-V3\",\n  \"custom_inputs_entrypoint\": null,\n  \"axes\": {\n    \"batch_size\": {\n      \"type\": \"var\",\n      \"description\": \"Batch size\"\n    },\n    \"seq_len\": {\n      \"type\": \"var\",\n      \"description\": \"Sequence length\"\n    },\n    \"hidden_size\": {\n      \"type\": \"const\",\n      \"value\": 7168,\n      \"description\": \"Hidden dimension\"\n    },\n    \"num_heads\": {\n      \"type\": \"const\",\n      \"value\": 128,\n      \"description\": \"Number of attention heads\"\n    },\n    \"q_lora_rank\": {\n      \"type\": \"const\",\n      \"value\": 1536,\n      \"description\": \"Query LoRA rank\"\n    },\n    \"qk_nope_head_dim\": {\n      \"type\": \"const\",\n      \"value\": 128,\n      \"description\": \"Query/Key non-positional head dimension\"\n    },\n    \"qk_rope_head_dim\": {\n      \"type\": \"const\",\n      \"value\": 64,\n      \"description\": \"Query/Key RoPE head dimension\"\n    },\n    \"q_head_dim\": {\n      \"type\": \"const\",\n      \"value\": 192,\n      \"description\": \"Total query head dimension (nope + rope)\"\n    },\n    \"kv_lora_rank\": {\n      \"type\": \"const\",\n      \"value\": 512,\n      \"description\": \"KV LoRA rank\"\n    },\n    \"kv_proj_out_dim\": {\n      \"type\": \"const\",\n      \"value\": 576,\n      \"description\": \"KV projection output dimension (kv_lora_rank + qk_rope_head_dim)\"\n    },\n    \"q_proj_out_dim\": {\n      \"type\": \"const\",\n      \"value\": 24576,\n      \"description\": \"Q projection output dimension (num_heads * q_head_dim)\"\n    }\n  },\n  \"inputs\": {\n    \"hidden_states\": {\n      \"shape\": [\n        \"batch_size\",\n        \"seq_len\",\n        \"hidden_size\"\n      ],\n      \"dtype\": \"bfloat16\",\n      \"description\": \"Input hidden states\"\n    },\n    \"q_a_proj_weight\": {\n      \"shape\": [\n        \"q_lora_rank\",\n        \"hidden_size\"\n      ],\n      \"dtype\": \"bfloat16\",\n      \"description\": \"Query A projection weight\"\n    },\n    \"q_a_layernorm_weight\": {\n      \"shape\": [\n        \"q_lora_rank\"\n      ],\n      \"dtype\": \"bfloat16\",\n      \"description\": \"Query A layernorm weight\"\n    },\n    \"q_b_proj_weight\": {\n      \"shape\": [\n        \"q_proj_out_dim\",\n        \"q_lora_rank\"\n      ],\n      \"dtype\": \"bfloat16\",\n      \"description\": \"Query B projection weight\"\n    },\n    \"kv_a_proj_weight\": {\n      \"shape\": [\n        \"kv_proj_out_dim\",\n        \"hidden_size\"\n      ],\n      \"dtype\": \"bfloat16\",\n      \"description\": \"KV A projection weight\"\n    },\n    \"rms_norm_eps\": {\n      \"shape\": null,\n      \"dtype\": \"float32\",\n      \"description\": \"RMSNorm epsilon\"\n    }\n  },\n  \"outputs\": {\n    \"q_nope\": {\n      \"shape\": [\n        \"batch_size\",\n        \"seq_len\",\n        \"num_heads\",\n        \"qk_nope_head_dim\"\n      ],\n      \"dtype\": \"bfloat16\",\n      \"description\": \"Query non-positional component\"\n    },\n    \"q_pe\": {\n      \"shape\": [\n        \"batch_size\",\n        \"seq_len\",\n        \"num_heads\",\n        \"qk_rope_head_dim\"\n      ],\n      \"dtype\": \"bfloat16\",\n      \"description\": \"Query positional component\"\n    },\n    \"compressed_kv\": {\n      \"shape\": [\n        \"batch_size\",\n        \"seq_len\",\n        \"kv_lora_rank\"\n      ],\n      \"dtype\": \"bfloat16\",\n      \"description\": \"Compressed KV latent\"\n    },\n    \"k_pe\": {\n      \"shape\": [\n        \"batch_size\",\n        \"seq_len\",\n        \"1\",\n        \"qk_rope_head_dim\"\n      ],\n      \"dtype\": \"bfloat16\",\n      \"description\": \"Key positional component\"\n    }\n  },\n  \"reference\": \"import torch\\nimport torch.nn.functional as F\\n\\n@torch.no_grad()\\ndef run(\\n    hidden_states: torch.Tensor,\\n    q_a_proj_weight: torch.Tensor,\\n    q_a_layernorm_weight: torch.Tensor,\\n    q_b_proj_weight: torch.Tensor,\\n    kv_a_proj_weight: torch.Tensor,\\n    rms_norm_eps: float,\\n):\\n    \\\"\\\"\\\"\\n    Fused MLA QKV projection with RoPE split.\\n    \\n    Query path: hidden -> q_a_proj -> RMSNorm -> q_b_proj -> split(q_nope, q_pe)\\n    KV path: hidden -> kv_a_proj -> split(compressed_kv, k_pe)\\n    \\\"\\\"\\\"\\n    # Constants\\n    num_heads = 128\\n    qk_nope_head_dim = 128\\n    qk_rope_head_dim = 64\\n    q_head_dim = 192  # qk_nope_head_dim + qk_rope_head_dim\\n    kv_lora_rank = 512\\n    \\n    bsz, seq_len, _ = hidden_states.shape\\n    \\n    # Query pathway: hidden -> q_a_proj -> layernorm -> q_b_proj -> split\\n    # q_a_proj: Linear(7168, 1536)\\n    q_latent = F.linear(hidden_states, q_a_proj_weight)  # (bsz, seq_len, 1536)\\n    \\n    # RMSNorm on q_latent\\n    input_dtype = q_latent.dtype\\n    q_latent_fp32 = q_latent.to(torch.float32)\\n    variance = q_latent_fp32.pow(2).mean(-1, keepdim=True)\\n    q_latent_normed = q_latent_fp32 * torch.rsqrt(variance + rms_norm_eps)\\n    q_latent = (q_a_layernorm_weight * q_latent_normed.to(input_dtype))\\n    \\n    # q_b_proj: Linear(1536, 24576)\\n    q = F.linear(q_latent, q_b_proj_weight)  # (bsz, seq_len, 24576)\\n    q = q.view(bsz, seq_len, num_heads, q_head_dim)  # (bsz, seq_len, 128, 192)\\n    \\n    # Split query into nope and pe components\\n    q_nope = q[..., :qk_nope_head_dim].contiguous()  # (bsz, seq_len, 128, 128)\\n    q_pe = q[..., qk_nope_head_dim:].contiguous()  # (bsz, seq_len, 128, 64)\\n    \\n    # KV pathway: hidden -> kv_a_proj -> split\\n    # kv_a_proj: Linear(7168, 576)\\n    kv_combined = F.linear(hidden_states, kv_a_proj_weight)  # (bsz, seq_len, 576)\\n    \\n    # Split into compressed_kv and k_pe\\n    compressed_kv = kv_combined[..., :kv_lora_rank].contiguous()  # (bsz, seq_len, 512)\\n    k_pe = kv_combined[..., kv_lora_rank:].contiguous()  # (bsz, seq_len, 64)\\n    k_pe = k_pe.view(bsz, seq_len, 1, qk_rope_head_dim)  # (bsz, seq_len, 1, 64)\\n    \\n    return q_nope, q_pe, compressed_kv, k_pe\\n\"\n}\n\n--- reference.py ---\nimport torch\nimport torch.nn.functional as F\n\n@torch.no_grad()\ndef run(\n    hidden_states: torch.Tensor,\n    q_a_proj_weight: torch.Tensor,\n    q_a_layernorm_weight: torch.Tensor,\n    q_b_proj_weight: torch.Tensor,\n    kv_a_proj_weight: torch.Tensor,\n    rms_norm_eps: float,\n):\n    \"\"\"\n    Fused MLA QKV projection with RoPE split.\n    \n    Query path: hidden -> q_a_proj -> RMSNorm -> q_b_proj -> split(q_nope, q_pe)\n    KV path: hidden -> kv_a_proj -> split(compressed_kv, k_pe)\n    \"\"\"\n    # Constants\n    num_heads = 128\n    qk_nope_head_dim = 128\n    qk_rope_head_dim = 64\n    q_head_dim = 192  # qk_nope_head_dim + qk_rope_head_dim\n    kv_lora_rank = 512\n    \n    bsz, seq_len, _ = hidden_states.shape\n    \n    # Query pathway: hidden -> q_a_proj -> layernorm -> q_b_proj -> split\n    # q_a_proj: Linear(7168, 1536)\n    q_latent = F.linear(hidden_states, q_a_proj_weight)  # (bsz, seq_len, 1536)\n    \n    # RMSNorm on q_latent\n    input_dtype = q_latent.dtype\n    q_latent_fp32 = q_latent.to(torch.float32)\n    variance = q_latent_fp32.pow(2).mean(-1, keepdim=True)\n    q_latent_normed = q_latent_fp32 * torch.rsqrt(variance + rms_norm_eps)\n    q_latent = (q_a_layernorm_weight * q_latent_normed.to(input_dtype))\n    \n    # q_b_proj: Linear(1536, 24576)\n    q = F.linear(q_latent, q_b_proj_weight)  # (bsz, seq_len, 24576)\n    q = q.view(bsz, seq_len, num_heads, q_head_dim)  # (bsz, seq_len, 128, 192)\n    \n    # Split query into nope and pe components\n    q_nope = q[..., :qk_nope_head_dim].contiguous()  # (bsz, seq_len, 128, 128)\n    q_pe = q[..., qk_nope_head_dim:].contiguous()  # (bsz, seq_len, 128, 64)\n    \n    # KV pathway: hidden -> kv_a_proj -> split\n    # kv_a_proj: Linear(7168, 576)\n    kv_combined = F.linear(hidden_states, kv_a_proj_weight)  # (bsz, seq_len, 576)\n    \n    # Split into compressed_kv and k_pe\n    compressed_kv = kv_combined[..., :kv_lora_rank].contiguous()  # (bsz, seq_len, 512)\n    k_pe = kv_combined[..., kv_lora_rank:].contiguous()  # (bsz, seq_len, 64)\n    k_pe = k_pe.view(bsz, seq_len, 1, qk_rope_head_dim)  # (bsz, seq_len, 1, 64)\n    \n    return q_nope, q_pe, compressed_kv, k_pe\n\n--- workload.jsonl ---\n{\"uuid\": \"8c17ec2a-7114-5acc-a716-940b57cf47a9\", \"axes\": {\"batch_size\": 4, \"seq_len\": 373}, \"inputs\": {\"hidden_states\": {\"type\": \"random\"}, \"q_a_proj_weight\": {\"type\": \"random\"}, \"q_a_layernorm_weight\": {\"type\": \"random\"}, \"q_b_proj_weight\": {\"type\": \"random\"}, \"kv_a_proj_weight\": {\"type\": \"random\"}, \"rms_norm_eps\": {\"type\": \"scalar\", \"value\": 1e-06}}, \"tolerance\": {\"max_atol\": 0.007812787690444039, \"max_rtol\": 0.0078125, \"required_matched_ratio\": 0.99, \"_provenance\": \"max run-to-run error over 10 seeds x 1.25 margin, floored at torch.bfloat16 epsilon\"}}\n{\"uuid\": \"66932843-7d54-5585-940a-89b8181dea29\", \"axes\": {\"batch_size\": 1, \"seq_len\": 1024}, \"inputs\": {\"hidden_states\": {\"type\": \"random\"}, \"q_a_proj_weight\": {\"type\": \"random\"}, \"q_a_layernorm_weight\": {\"type\": \"random\"}, \"q_b_proj_weight\": {\"type\": \"random\"}, \"kv_a_proj_weight\": {\"type\": \"random\"}, \"rms_norm_eps\": {\"type\": \"scalar\", \"value\": 1e-06}}, \"tolerance\": {\"max_atol\": 0.007813258944176369, \"max_rtol\": 0.0078125, \"required_matched_ratio\": 0.99, \"_provenance\": \"max run-to-run error over 10 seeds x 1.25 margin, floored at torch.bfloat16 epsilon\"}}\n{\"uuid\": \"9d514166-2677-5c52-bbd0-626ece2ec8ff\", \"axes\": {\"batch_size\": 2, \"seq_len\": 4096}, \"inputs\": {\"hidden_states\": {\"type\": \"random\"}, \"q_a_proj_weight\": {\"type\": \"random\"}, \"q_a_layernorm_weight\": {\"type\": \"random\"}, \"q_b_proj_weight\": {\"type\": \"random\"}, \"kv_a_proj_weight\": {\"type\": \"random\"}, \"rms_norm_eps\": {\"type\": \"scalar\", \"value\": 1e-06}}, \"tolerance\": {\"max_atol\": 0.007811862757472985, \"max_rtol\": 0.0078125, \"required_matched_ratio\": 0.99, \"_provenance\": \"max run-to-run error over 10 seeds x 1.25 margin, floored at torch.bfloat16 epsilon\"}}\n{\"uuid\": \"6af5e7a0-79ca-54c3-a631-6b3e6fc0014d\", \"axes\": {\"batch_size\": 4, \"seq_len\": 1024}, \"inputs\": {\"hidden_states\": {\"type\": \"random\"}, \"q_a_proj_weight\": {\"type\": \"random\"}, \"q_a_layernorm_weight\": {\"type\": \"random\"}, \"q_b_proj_weight\": {\"type\": \"random\"}, \"kv_a_proj_weight\": {\"type\": \"random\"}, \"rms_norm_eps\": {\"type\": \"scalar\", \"value\": 1e-06}}, \"tolerance\": {\"max_atol\": 0.0078123692823222615, \"max_rtol\": 0.0078125, \"required_matched_ratio\": 0.99, \"_provenance\": \"max run-to-run error over 10 seeds x 1.25 margin, floored at torch.bfloat16 epsilon\"}}\n{\"uuid\": \"7c2c2a28-a755-546a-b31f-1d8e4edd6385\", \"axes\": {\"batch_size\": 32, \"seq_len\": 128}, \"inputs\": {\"hidden_states\": {\"type\": \"random\"}, \"q_a_proj_weight\": {\"type\": \"random\"}, \"q_a_layernorm_weight\": {\"type\": \"random\"}, \"q_b_proj_weight\": {\"type\": \"random\"}, \"kv_a_proj_weight\": {\"type\": \"random\"}, \"rms_norm_eps\": {\"type\": \"scalar\", \"value\": 1e-06}}, \"tolerance\": {\"max_atol\": 0.0078123692823222615, \"max_rtol\": 0.0078125, \"required_matched_ratio\": 0.99, \"_provenance\": \"max run-to-run error over 10 seeds x 1