{"type":"item.started","item":{"id":"item_60","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch,triton,kernel\n\ndef bench(fn):\n    for _ in range(5): fn()\n    s=torch.cuda.Event(enable_timing=True); e=torch.cuda.Event(enable_timing=True)\n    s.record()\n    for _ in range(50): fn()\n    e.record(); e.synchronize()\n    return s.elapsed_time(e)/50\nfor count,length in ((4,256),(15,196)):\n    tokens=count*length; h=3584; d=128\n    attn=torch.randn(count,28,length,d,device='cuda'); out=torch.empty(tokens,h,device='cuda')\n    gq=torch.randn_like(attn); gk=torch.randn_like(attn); gv=torch.randn_like(attn); gqkv=torch.empty(tokens,3*h,device='cuda'); cos=torch.randn(tokens,d,device='cuda'); sin=torch.randn_like(cos)\n    print('shape',count,length)\n    for block,warps in ((128,2),(256,4),(512,8),(1024,8)):\n        f=lambda b=block,w=warps: kernel._attention_output_pack_kernel[(triton.cdiv(h,b),tokens)](attn,out,0,HIDDEN=h,HEAD_DIM=d,LENGTH=length,BLOCK=b,num_warps=w)\n        b=lambda bs=block,w=warps: kernel._backward_rope_pack_group_kernel[(triton.cdiv(h,bs),tokens)](gq,gk,gv,gqkv,cos,sin,0,HIDDEN=h,HEAD_DIM=d,LENGTH=length,BLOCK=bs,num_warps=w)\n        print(block,bench(f),bench(b))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
