{"type":"item.completed","item":{"id":"item_32","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,420p' kernel.py\"","aggregated_output":"import torch\nimport torch.nn.functional as F\nimport triton\nimport triton.language as tl\n\n\n_AUX_STREAMS = {}\n\n\ndef _get_aux_streams(device, count):\n    key = device.index\n    streams = _AUX_STREAMS.get(key)\n    if streams is None:\n        streams = [torch.cuda.Stream(device=device) for _ in range(4)]\n        _AUX_STREAMS[key] = streams\n    return streams[: min(count, len(streams))]\n\n\n@triton.jit\ndef _mul_rn(a, b):\n    return tl.inline_asm_elementwise(\n        \"v_mul_f32 $0, $1, $2\",\n        \"=v,v,v\",\n        [a, b],\n        dtype=tl.float32,\n        is_pure=True,\n        pack=1,\n    )\n\n\n@triton.jit\ndef _add_rn(a, b):\n    return tl.inline_asm_elementwise(\n        \"v_add_f32 $0, $1, $2\",\n        \"=v,v,v\",\n        [a, b],\n        dtype=tl.float32,\n        is_pure=True,\n        pack=1,\n    )\n\n\n@triton.jit\ndef _forward_rope_kernel(\n    qkv_ptr,\n    qk_out_ptr,\n    cos_ptr,\n    sin_ptr,\n    n_tokens,\n    HIDDEN: tl.constexpr,\n    HEAD_DIM: tl.constexpr,\n    BLOCK: tl.constexpr,\n):\n    block = tl.program_id(0)\n    token = tl.program_id(1)\n    x = block * BLOCK + tl.arange(0, BLOCK)\n    mask = x < HIDDEN\n    d = x & (HEAD_DIM - 1)\n    rotated_x = x ^ (HEAD_DIM // 2)\n    base = token * (3 * HIDDEN)\n    emb_off = token * HEAD_DIM + d\n\n    c = tl.load(cos_ptr + emb_off, mask=mask, other=0.0)\n    s = tl.load(sin_ptr + emb_off, mask=mask, other=0.0)\n\n    q = tl.load(qkv_ptr + base + x, mask=mask, other=0.0)\n    qr = tl.load(qkv_ptr + base + rotated_x, mask=mask, other=0.0)\n    qr = tl.where(d < HEAD_DIM // 2, -qr, qr)\n    q_out = _add_rn(_mul_rn(q, c), _mul_rn(qr, s))\n\n    k = tl.load(qkv_ptr + base + HIDDEN + x, mask=mask, other=0.0)\n    kr = tl.load(qkv_ptr + base + HIDDEN + rotated_x, mask=mask, other=0.0)\n    kr = tl.where(d < HEAD_DIM // 2, -kr, kr)\n    k_out = _add_rn(_mul_rn(k, c), _mul_rn(kr, s))\n\n    out_off = token * HIDDEN + x\n    tl.store(qk_out_ptr + out_off, q_out, mask=mask)\n    tl.store(qk_out_ptr + n_tokens * HIDDEN + out_off, k_out, mask=mask)\n\n\n@triton.jit\ndef _backward_rope_pack_kernel(\n    grad_q_ptr,\n    grad_k_ptr,\n    grad_v_ptr,\n    grad_qkv_ptr,\n    cos_ptr,\n    sin_ptr,\n    q_stride_t,\n    q_stride_h,\n    k_stride_t,\n    k_stride_h,\n    v_stride_t,\n    v_stride_h,\n    HIDDEN: tl.constexpr,\n    HEAD_DIM: tl.constexpr,\n    BLOCK: tl.constexpr,\n):\n    block = tl.program_id(0)\n    token = tl.program_id(1)\n    x = block * BLOCK + tl.arange(0, BLOCK)\n    mask = x < HIDDEN\n    d = x & (HEAD_DIM - 1)\n    h = x // HEAD_DIM\n    rotated_d = d ^ (HEAD_DIM // 2)\n    emb_base = token * HEAD_DIM\n\n    c = tl.load(cos_ptr + emb_base + d, mask=mask, other=0.0)\n    sr = tl.load(sin_ptr + emb_base + (d ^ (HEAD_DIM // 2)), mask=mask, other=0.0)\n\n    q_base = token * q_stride_t + h * q_stride_h\n    gq = tl.load(grad_q_ptr + q_base + d, mask=mask, other=0.0)\n    gqr = tl.load(grad_q_ptr + q_base + rotated_d, mask=mask, other=0.0)\n    q_rot_term = _mul_rn(gqr, sr)\n    q_rot_term = tl.where(d < HEAD_DIM // 2, q_rot_term, -q_rot_term)\n    q_out = _add_rn(_mul_rn(gq, c), q_rot_term)\n\n    k_base = token * k_stride_t + h * k_stride_h\n    gk = tl.load(grad_k_ptr + k_base + d, mask=mask, other=0.0)\n    gkr = tl.load(grad_k_ptr + k_base + rotated_d, mask=mask, other=0.0)\n    k_rot_term = _mul_rn(gkr, sr)\n    k_rot_term = tl.where(d < HEAD_DIM // 2, k_rot_term, -k_rot_term)\n    k_out = _add_rn(_mul_rn(gk, c), k_rot_term)\n    v_base = token * v_stride_t + h * v_stride_h\n    gv = tl.load(grad_v_ptr + v_base + d, mask=mask, other=0.0)\n\n    out_base = token * (3 * HIDDEN)\n    tl.store(grad_qkv_ptr + out_base + x, q_out, mask=mask)\n    tl.store(grad_qkv_ptr + out_base + HIDDEN + x, k_out, mask=mask)\n    tl.store(grad_qkv_ptr + out_base + 2 * HIDDEN + x, gv, mask=mask)\n\n\n@torch.no_grad()\ndef run(\n    grad_output,\n    hidden_states,\n    qkv_weight,\n    qkv_bias,\n    proj_weight,\n    proj_bias,\n    cos,\n    sin,\n    cu_seqlens,\n    attention_dropout,\n    scaling,\n):\n    seq_length = hidden_states.shape[0]\n    hidden_size = hidden_states.shape[1]\n    num_heads = 28\n    head_dim = 128\n\n    qkv = F.linear(hidden_states, qkv_weight, qkv_bias)\n    qkv = qkv.reshape(seq_length, 3, num_heads, head_dim)\n    query_states, key_states, value_states = qkv.permute(1, 0, 2, 3).unbind(0)\n\n    qk_states_rope = torch.empty(\n        (2, seq_length, num_heads, head_dim),\n        dtype=qkv.dtype,\n        device=qkv.device,\n    )\n    _forward_rope_kernel[\n        (triton.cdiv(hidden_size, 256), seq_length)\n    ](\n        qkv,\n        qk_states_rope,\n        cos,\n        sin,\n        seq_length,\n        HIDDEN=hidden_size,\n        HEAD_DIM=head_dim,\n        BLOCK=256,\n        num_warps=4,\n    )\n    query_states_rope, key_states_rope = qk_states_rope.unbind(0)\n\n    lengths = cu_seqlens[1:] - cu_seqlens[:-1]\n    lengths_list = lengths.tolist()\n\n    # Adjacent sequences of an equal length are one strided-batched GEMM.  The\n    # input generator makes almost every batch uniform, while this grouping\n    # still handles arbitrary cu_seqlens correctly.\n    groups = []\n    seq_idx = 0\n    token_idx = 0\n    while seq_idx < len(lengths_list):\n        length = lengths_list[seq_idx]\n        run_count = 1\n        while (\n            seq_idx + run_count < len(lengths_list)\n            and lengths_list[seq_idx + run_count] == length\n        ):\n            run_count += 1\n        # rocBLAS changes SGEMM's reduction schedule above these batch sizes.\n        # Keeping the same schedule as the per-sequence reference is required\n        # by the tight fp32 tolerance.\n        max_group = 4 if length >= 224 else 15\n        remaining = run_count\n        while remaining:\n            count = min(remaining, max_group)\n            groups.append((token_idx, count, length))\n            token_idx += count * length\n            remaining -= count\n        seq_idx += run_count\n\n    attn_outputs = []\n    attn_weights_list = []\n    qkv_groups = []\n    current_stream = torch.cuda.current_stream(qkv.device)\n    aux_streams = _get_aux_streams(qkv.device, len(groups)) if len(groups) > 1 else []\n    for stream in aux_streams:\n        stream.wait_stream(current_stream)\n    for group_idx, (token_idx, count, length) in enumerate(groups):\n        stream = (\n            aux_streams[group_idx % len(aux_streams)]\n            if aux_streams\n            else current_stream\n        )\n        with torch.cuda.stream(stream):\n            tokens = count * length\n            q = (\n                query_states_rope.narrow(0, token_idx, tokens)\n                .reshape(count, length, num_heads, head_dim)\n                .permute(0, 2, 1, 3)\n            )\n            k = (\n                key_states_rope.narrow(0, token_idx, tokens)\n                .reshape(count, length, num_heads, head_dim)\n                .permute(0, 2, 1, 3)\n            )\n            v = (\n                value_states.narrow(0, token_idx, tokens)\n                .reshape(count, length, num_heads, head_dim)\n                .permute(0, 2, 1, 3)\n            )\n            attn_weights = torch.matmul(q, k.transpose(2, 3)) * scaling\n            attn_weights = F.softmax(\n                attn_weights, dim=-1, dtype=torch.float32\n            ).to(q.dtype)\n            attn_output_group = torch.matmul(attn_weights, v)\n            attn_output_group = (\n                attn_output_group.permute(0, 2, 1, 3)\n                .reshape(tokens, hidden_size)\n            )\n            attn_outputs.append(attn_output_group)\n            attn_weights_list.append(attn_weights)\n            qkv_groups.append((q, k, v))\n    for stream in aux_streams:\n        current_stream.wait_stream(stream)\n    for output in attn_outputs:\n        output.record_stream(current_stream)\n\n    attn_output_reshaped = (\n        attn_outputs[0]\n        if len(attn_outputs) == 1\n        else torch.cat(attn_outputs, dim=0)\n    ).contiguous()\n\n    grad_proj_bias = grad_output.sum(dim=0)\n    grad_proj_weight = grad_output.t() @ attn_output_reshaped\n    grad_attn_output = grad_output @ proj_weight\n    grad_query_splits = []\n    grad_key_splits = []\n    grad_value_splits = []\n    for stream in aux_streams:\n        stream.wait_stream(current_stream)\n    for group_idx, ((token_idx, count, length), attn_weights, (q, k, v)) in enumerate(\n        zip(groups, attn_weights_list, qkv_groups)\n    ):\n        stream = (\n            aux_streams[group_idx % len(aux_streams)]\n            if aux_streams\n            else current_stream\n        )\n        with torch.cuda.stream(stream):\n            tokens = count * length\n            grad_attn_out = (\n                grad_attn_output.narrow(0, token_idx, tokens)\n                .reshape(count, length, num_heads, head_dim)\n                .permute(0, 2, 1, 3)\n            )\n            grad_attn_weights = torch.matmul(grad_attn_out, v.transpose(2, 3))\n            grad_v = torch.matmul(attn_weights.transpose(2, 3), grad_attn_out)\n            sum_grad = (grad_attn_weights * attn_weights).sum(dim=-1, keepdim=True)\n            grad_attn_scores = attn_weights * (grad_attn_weights - sum_grad)\n            grad_attn_scores = grad_attn_scores * scaling\n            grad_q = torch.matmul(grad_attn_scores, k)\n            grad_k = torch.matmul(grad_attn_scores.transpose(2, 3), q)\n            grad_q = grad_q.permute(0, 2, 1, 3).reshape(\n                tokens, num_heads, head_dim\n            )\n            grad_k = grad_k.permute(0, 2, 1, 3).reshape(\n                tokens, num_heads, head_dim\n            )\n            grad_v = grad_v.permute(0, 2, 1, 3).reshape(\n                tokens, num_heads, head_dim\n            )\n            grad_query_splits.append(grad_q)\n            grad_key_splits.append(grad_k)\n            grad_value_splits.append(grad_v)\n    for stream in aux_streams:\n        current_stream.wait_stream(stream)\n    for output in grad_query_splits + grad_key_splits + grad_value_splits:\n        output.record_stream(current_stream)\n\n    grad_query_states = (\n        grad_query_splits[0]\n        if len(grad_query_splits) == 1\n        else torch.cat(grad_query_splits, dim=0)\n    )\n    grad_key_states = (\n        grad_key_splits[0]\n        if len(grad_key_splits) == 1\n        else torch.cat(grad_key_splits, dim=0)\n    )\n    grad_value_states = (\n        grad_value_splits[0]\n        if len(grad_value_splits) == 1\n        else torch.cat(grad_value_splits, dim=0)\n    )\n\n    grad_qkv = torch.empty(\n        (seq_length, 3 * hidden_size),\n        dtype=grad_query_states.dtype,\n        device=grad_query_states.device,\n    )\n    _backward_rope_pack_kernel[\n        (triton.cdiv(hidden_size, 256), seq_length)\n    ](\n        grad_query_states,\n        grad_key_states,\n        grad_value_states,\n        grad_qkv,\n        cos,\n        sin,\n        grad_query_states.stride(0),\n        grad_query_states.stride(1),\n        grad_key_states.stride(0),\n        grad_key_states.stride(1),\n        grad_value_states.stride(0),\n        grad_value_states.stride(1),\n        HIDDEN=hidden_size,\n        HEAD_DIM=head_dim,\n        BLOCK=256,\n        num_warps=4,\n    )\n    grad_hidden_states = grad_qkv @ qkv_weight\n    grad_qkv_weight = grad_qkv.t() @ hidden_states\n    grad_qkv_bias = grad_qkv.sum(dim=0)\n    return (\n        grad_hidden_states,\n        grad_qkv_weight,\n        grad_qkv_bias,\n        grad_proj_weight,\n        grad_proj_bias,\n    )\n","exit_code":0,"status":"completed"}}
