{"type":"item.started","item":{"id":"item_27","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch\nimport kernel\nimport reference\n\ndef check(batch, lengths, seed, atol):\n    torch.manual_seed(seed)\n    total = sum(lengths)\n    pages = max(total + 17, 32)\n    q = torch.randn((batch, 32, 128), device='cuda', dtype=torch.bfloat16)\n    k = torch.randn((pages, 1, 8, 128), device='cuda', dtype=torch.bfloat16)\n    v = torch.randn_like(k)\n    indptr = torch.tensor([0] + list(torch.tensor(lengths).cumsum(0).tolist()), device='cuda', dtype=torch.int32)\n    indices = torch.randperm(pages, device='cuda', dtype=torch.int32)[:total]\n    scale = 0.08838834764831843\n    got_o, got_l = kernel.run(q, k, v, indptr, indices, scale)\n    ref_o, ref_l = reference.run(q, k, v, indptr, indices, scale)\n    torch.cuda.synchronize()\n    od = (got_o.float() - ref_o.float()).abs()\n    ld = (got_l - ref_l).abs()\n    om = torch.isclose(got_o.float(), ref_o.float(), atol=atol, rtol=0.0078125)\n    lm = torch.isclose(got_l, ref_l, atol=atol, rtol=0.0078125)\n    return od.max().item(), om.float().mean().item(), ld.max().item(), lm.float().mean().item()\n\ncases = [\n    (1, [2], 0.00435),\n    (1, [14], 0.00435),\n    (1, [50], 0.00465),\n    (1, [173], 0.00566),\n    (1, [547], 0.00675),\n    (16, [64 + (i % 3) for i in range(16)], 0.00478),\n    (16, [805 + (i % 7) for i in range(16)], 0.00641),\n]\nfor case_id, (batch, lengths, atol) in enumerate(cases):\n    worst = [0.0, 1.0, 0.0, 1.0]\n    seeds = range(5) if lengths[0] <= 50 else range(2)\n    for seed in seeds:\n        vals = check(batch, lengths, seed + case_id * 10, atol)\n        worst[0] = max(worst[0], vals[0])\n        worst[1] = min(worst[1], vals[1])\n        worst[2] = max(worst[2], vals[2])\n        worst[3] = min(worst[3], vals[3])\n    print(f'b={batch} len~{lengths[0]}: out max={worst[0]:.6g} match={worst[1]:.6f}; lse max={worst[2]:.6g} match={worst[3]:.6f}', flush=True)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
