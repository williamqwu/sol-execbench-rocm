{"type":"item.started","item":{"id":"item_38","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch\nimport kernel\n\ntorch.manual_seed(3)\n\ndef make_case(lengths):\n    batch = len(lengths)\n    total = sum(lengths)\n    pages = total + 257\n    q = torch.randn((batch, 32, 128), device='cuda', dtype=torch.bfloat16)\n    k = torch.randn((pages, 1, 8, 128), device='cuda', dtype=torch.bfloat16)\n    v = torch.randn_like(k)\n    indptr = torch.tensor([0] + list(torch.tensor(lengths).cumsum(0).tolist()), device='cuda', dtype=torch.int32)\n    indices = torch.randperm(pages, device='cuda', dtype=torch.int32)[:total]\n    out = torch.empty_like(q)\n    lse = torch.empty((batch, 32), device='cuda', dtype=torch.float32)\n    return batch, q, k, v, indptr, indices, out, lse\n\ndef measure(case, splits, block, repeats=150):\n    batch, q, k, v, indptr, indices, out, lse = case\n    if splits == 1:\n        def launch():\n            kernel._gqa_decode_kernel[(batch * 8,)](\n                q, k, v, indptr, indices, out, lse, 0.08838834764831843,\n                BLOCK_N=block, num_warps=4,\n            )\n    else:\n        count = batch * 8 * splits\n        pa = torch.empty((count, 4, 128), device='cuda', dtype=torch.float32)\n        pm = torch.empty((count, 4), device='cuda', dtype=torch.float32)\n        pz = torch.empty_like(pm)\n        def launch():\n            kernel._gqa_decode_split_kernel[(count,)](\n                q, k, v, indptr, indices, pa, pm, pz, 0.08838834764831843,\n                SPLITS=splits, BLOCK_N=block, num_warps=4,\n            )\n            kernel._merge_splits_kernel[(batch * 8,)](\n                pa, pm, pz, indptr, out, lse, SPLITS=splits, num_warps=4,\n            )\n    launch()\n    torch.cuda.synchronize()\n    s = torch.cuda.Event(enable_timing=True)\n    e = torch.cuda.Event(enable_timing=True)\n    s.record()\n    for _ in range(repeats):\n        launch()\n    e.record()\n    e.synchronize()\n    return s.elapsed_time(e) / repeats\n\ncases = [\n    ('b1-547', [547]),\n    ('b16-uniform', [810] * 16),\n    ('b16-ragged', [50 + i * 101 for i in range(16)]),\n    ('b64-uniform', [920] * 64),\n    ('b64-ragged', [100 + i * 26 for i in range(64)]),\n]\nfor name, lengths in cases:\n    case = make_case(lengths)\n    configs = [(1, 128)] + [(s, b) for s in (2, 4, 8) for b in (32, 64, 128)]\n    vals = []\n    for splits, block in configs:\n        try:\n            ms = measure(case, splits, block)\n            vals.append(f's{splits}b{block}={ms:.5f}')\n        except Exception as exc:\n            vals.append(f's{splits}b{block}=ERR({type(exc).__name__})')\n    print(name + ' avg=' + str(sum(lengths)//len(lengths)) + ': ' + ' '.join(vals), flush=True)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
