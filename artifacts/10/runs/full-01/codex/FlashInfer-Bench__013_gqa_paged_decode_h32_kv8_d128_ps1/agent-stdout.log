{"type":"item.completed","item":{"id":"item_42","type":"command_execution","command":"/bin/bash -lc 'python -m py_compile kernel.py && tail -n 110 kernel.py'","aggregated_output":"@triton.jit\ndef _merge_splits_kernel(\n    partial_acc_ptr,\n    partial_m_ptr,\n    partial_z_ptr,\n    indptr_ptr,\n    out_ptr,\n    lse_ptr,\n    SPLITS: tl.constexpr,\n):\n    group = tl.program_id(0)\n    batch = group // 8\n    kv_head = group % 8\n    split = tl.arange(0, SPLITS)\n    row = tl.arange(0, 4)\n    d = tl.arange(0, 128)\n    partial = group * SPLITS + split\n\n    pm = tl.load(partial_m_ptr + partial[:, None] * 4 + row[None, :])\n    pz = tl.load(partial_z_ptr + partial[:, None] * 4 + row[None, :])\n    global_m = tl.max(pm, axis=0)\n    alpha = tl.exp(pm - global_m[None, :])\n    denominator = tl.sum(pz * alpha, axis=0)\n    pa = tl.load(\n        partial_acc_ptr\n        + partial[:, None, None] * (4 * 128)\n        + row[None, :, None] * 128\n        + d[None, None, :]\n    )\n    numerator = tl.sum(pa * alpha[:, :, None], axis=0)\n    nonempty = tl.load(indptr_ptr + batch + 1) > tl.load(indptr_ptr + batch)\n    out = tl.where(nonempty, numerator / denominator[:, None], 0.0)\n    out_base = batch * (32 * 128) + kv_head * (4 * 128)\n    tl.store(out_ptr + out_base + row[:, None] * 128 + d[None, :], out)\n\n    log2e: tl.constexpr = 1.4426950408889634\n    lse = tl.where(\n        nonempty,\n        (global_m + tl.log(denominator)) * log2e,\n        -float(\"inf\"),\n    )\n    tl.store(lse_ptr + batch * 32 + kv_head * 4 + row, lse)\n\n\ndef run(q, k_cache, v_cache, kv_indptr, kv_indices, sm_scale):\n    batch_size = q.shape[0]\n    output = torch.empty_like(q)\n    lse = torch.empty((batch_size, 32), dtype=torch.float32, device=q.device)\n    average_length = kv_indices.shape[0] // batch_size\n\n    if batch_size == 64 or (batch_size == 16 and average_length > 600):\n        splits = 4 if batch_size == 64 else 8\n        partial_count = batch_size * 8 * splits\n        acc_elements = partial_count * 4 * 128\n        stat_elements = partial_count * 4\n        workspace = torch.empty(\n            acc_elements + 2 * stat_elements,\n            dtype=torch.float32,\n            device=q.device,\n        )\n        partial_acc = workspace[:acc_elements]\n        partial_m = workspace[acc_elements : acc_elements + stat_elements]\n        partial_z = workspace[acc_elements + stat_elements :]\n        _gqa_decode_split_kernel[(partial_count,)](\n            q,\n            k_cache,\n            v_cache,\n            kv_indptr,\n            kv_indices,\n            partial_acc,\n            partial_m,\n            partial_z,\n            sm_scale,\n            SPLITS=splits,\n            BLOCK_N=64,\n            num_warps=4,\n        )\n        _merge_splits_kernel[(batch_size * 8,)](\n            partial_acc,\n            partial_m,\n            partial_z,\n            kv_indptr,\n            output,\n            lse,\n            SPLITS=splits,\n            num_warps=4,\n        )\n        return output, lse\n\n    if average_length <= 64:\n        block_n = 16\n    elif average_length <= 256:\n        block_n = 32\n    elif average_length <= 600:\n        block_n = 64\n    else:\n        block_n = 128\n    _gqa_decode_kernel[(batch_size * 8,)](\n        q,\n        k_cache,\n        v_cache,\n        kv_indptr,\n        kv_indices,\n        output,\n        lse,\n        sm_scale,\n        BLOCK_N=block_n,\n        num_warps=4,\n    )\n    return output, lse\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_43","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch\nimport kernel\nimport reference\n\ndef check(lengths, seed, atol):\n    torch.manual_seed(seed)\n    batch=len(lengths); total=sum(lengths); pages=max(total+113,128)\n    q=torch.randn((batch,32,128),device='cuda',dtype=torch.bfloat16)\n    k=torch.randn((pages,1,8,128),device='cuda',dtype=torch.bfloat16); v=torch.randn_like(k)\n    indptr=torch.tensor([0]+list(torch.tensor(lengths).cumsum(0).tolist()),device='cuda',dtype=torch.int32)\n    indices=torch.randperm(pages,device='cuda',dtype=torch.int32)[:total]\n    got_o,got_l=kernel.run(q,k,v,indptr,indices,0.08838834764831843)\n    ref_o,ref_l=reference.run(q,k,v,indptr,indices,0.08838834764831843)\n    torch.cuda.synchronize()\n    od=(got_o.float()-ref_o.float()).abs()\n    finite=torch.isfinite(got_l)&torch.isfinite(ref_l)\n    ld=(got_l[finite]-ref_l[finite]).abs()\n    om=torch.isclose(got_o.float(),ref_o.float(),atol=atol,rtol=.0078125).float().mean().item()\n    lm=torch.isclose(got_l,ref_l,atol=atol,rtol=.0078125).float().mean().item()\n    print(f'b={batch} avg={total//batch}: out max={od.max().item():.6g} match={om:.6f}; lse max={ld.max().item() if ld.numel() else 0:.6g} match={lm:.6f}')\n\ncheck([50+i*101 for i in range(16)],10,.00641)\ncheck([0]+[1+(i%7) for i in range(63)],11,.00692)\ncheck([100+i*26 for i in range(64)],12,.00711)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
