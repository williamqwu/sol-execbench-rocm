ze\":64,\"num_pages\":67853,\"num_kv_indices\":58582,\"atol\":0.007104851117407975,\"rtol\":0.0078125,\"ratio\":0.99},{\"batch_size\":64,\"num_pages\":66253,\"num_kv_indices\":56982,\"atol\":0.007068818506923685,\"rtol\":0.0078125,\"ratio\":0.99},{\"batch_size\":64,\"num_pages\":68237,\"num_kv_indices\":58966,\"atol\":0.00711336461119779,\"rtol\":0.0078125,\"ratio\":0.99},{\"batch_size\":64,\"num_pages\":64205,\"num_kv_indices\":54934,\"atol\":0.00702051334495076,\"rtol\":0.0078125,\"ratio\":0.99}]}\nimport torch\nimport triton\nimport triton.language as tl\n\n\n@triton.jit\ndef _gqa_decode_kernel(\n    q_ptr,\n    k_ptr,\n    v_ptr,\n    indptr_ptr,\n    indices_ptr,\n    out_ptr,\n    lse_ptr,\n    sm_scale,\n    BLOCK_N: tl.constexpr,\n):\n    # One program handles the four query heads which share a KV head.  This\n    # makes each paged K/V vector get fetched only once.\n    pid = tl.program_id(0)\n    batch = pid // 8\n    kv_head = pid % 8\n\n    d = tl.arange(0, 128)\n    q_base = batch * (32 * 128) + kv_head * (4 * 128)\n    q0 = tl.load(q_ptr + q_base + d).to(tl.float32)\n    q1 = tl.load(q_ptr + q_base + 128 + d).to(tl.float32)\n    q2 = tl.load(q_ptr + q_base + 256 + d).to(tl.float32)\n    q3 = tl.load(q_ptr + q_base + 384 + d).to(tl.float32)\n\n    acc0 = tl.zeros([128], tl.float32)\n    acc1 = tl.zeros([128], tl.float32)\n    acc2 = tl.zeros([128], tl.float32)\n    acc3 = tl.zeros([128], tl.float32)\n    m0 = -float(\"inf\")\n    m1 = -float(\"inf\")\n    m2 = -float(\"inf\")\n    m3 = -float(\"inf\")\n    z0 = 0.0\n    z1 = 0.0\n    z2 = 0.0\n    z3 = 0.0\n\n    begin = tl.load(indptr_ptr + batch)\n    end = tl.load(indptr_ptr + batch + 1)\n    length = end - begin\n    block_start = 0\n    n_lane = tl.arange(0, BLOCK_N)\n\n    while block_start < length:\n        n = block_start + n_lane\n        valid = n < length\n        page = tl.load(indices_ptr + begin + n, mask=valid, other=0)\n        cache_off = page[:, None] * (8 * 128) + kv_head * 128 + d[None, :]\n        k = tl.load(k_ptr + cache_off, mask=valid[:, None], other=0.0).to(tl.float32)\n\n        s0 = tl.sum(k * q0[None, :], axis=1) * sm_scale\n        s1 = tl.sum(k * q1[None, :], axis=1) * sm_scale\n        s2 = tl.sum(k * q2[None, :], axis=1) * sm_scale\n        s3 = tl.sum(k * q3[None, :], axis=1) * sm_scale\n        s0 = tl.where(valid, s0, -float(\"inf\"))\n        s1 = tl.where(valid, s1, -float(\"inf\"))\n        s2 = tl.where(valid, s2, -float(\"inf\"))\n        s3 = tl.where(valid, s3, -float(\"inf\"))\n\n        nm0 = tl.maximum(m0, tl.max(s0, axis=0))\n        nm1 = tl.maximum(m1, tl.max(s1, axis=0))\n        nm2 = tl.maximum(m2, tl.max(s2, axis=0))\n        nm3 = tl.maximum(m3, tl.max(s3, axis=0))\n        a0 = tl.exp(m0 - nm0)\n        a1 = tl.exp(m1 - nm1)\n        a2 = tl.exp(m2 - nm2)\n        a3 = tl.exp(m3 - nm3)\n        p0 = tl.exp(s0 - nm0)\n        p1 = tl.exp(s1 - nm1)\n        p2 = tl.exp(s2 - nm2)\n        p3 = tl.exp(s3 - nm3)\n\n        v = tl.load(v_ptr + cache_off, mask=valid[:, None], other=0.0).to(tl.float32)\n        acc0 = acc0 * a0 + tl.sum(p0[:, None] * v, axis=0)\n        acc1 = acc1 * a1 + tl.sum(p1[:, None] * v, axis=0)\n        acc2 = acc2 * a2 + tl.sum(p2[:, None] * v, axis=0)\n        acc3 = acc3 * a3 + tl.sum(p3[:, None] * v, axis=0)\n        z0 = z0 * a0 + tl.sum(p0, axis=0)\n        z1 = z1 * a1 + tl.sum(p1, axis=0)\n        z2 = z2 * a2 + tl.sum(p2, axis=0)\n        z3 = z3 * a3 + tl.sum(p3, axis=0)\n        m0 = nm0\n        m1 = nm1\n        m2 = nm2\n        m3 = nm3\n        block_start += BLOCK_N\n\n    nonempty = length > 0\n    out0 = tl.where(nonempty, acc0 / z0, 0.0)\n    out1 = tl.where(nonempty, acc1 / z1, 0.0)\n    out2 = tl.where(nonempty, acc2 / z2, 0.0)\n    out3 = tl.where(nonempty, acc3 / z3, 0.0)\n    tl.store(out_ptr + q_base + d, out0)\n    tl.store(out_ptr + q_base + 128 + d, out1)\n    tl.store(out_ptr + q_base + 256 + d, out2)\n    tl.store(out_ptr + q_base + 384 + d, out3)\n\n    log2e: tl.constexpr = 1.4426950408889634\n    lse_base = batch * 32 + kv_head * 4\n    tl.store(lse_ptr + lse_base, tl.where(nonempty, (m0 + tl.log(z0)) * log2e, -float(\"inf\")))\n    tl.store(lse_ptr + lse_base + 1, tl.where(nonempty, (m1 + tl.log(z1)) * log2e, -float(\"inf\")))\n    tl.store(lse_ptr + lse_base + 2, tl.where(nonempty, (m2 + tl.log(z2)) * log2e, -float(\"inf\")))\n    tl.store(lse_ptr + lse_base + 3, tl.where(nonempty, (m3 + tl.log(z3)) * log2e, -float(\"inf\")))\n\n\ndef run(q, k_cache, v_cache, kv_indptr, kv_indices, sm_scale):\n    output = torch.empty_like(q)\n    lse = torch.empty((q.shape[0], 32), dtype=torch.float32, device=q.device)\n    _gqa_decode_kernel[(q.shape[0] * 8,)](\n        q,\n        k_cache,\n        v_cache,\n        kv_indptr,\n        kv_indices,\n        output,\n        lse,\n        sm_scale,\n        BLOCK_N=16,\n        num_warps=8,\n    )\n    return output, lse\n{\n  \"name\": \"013_gqa_paged_decode_h32_kv8_d128_ps1_agent\",\n  \"definition\": \"013_gqa_paged_decode_h32_kv8_d128_ps1\",\n  \"author\": \"agent\",\n  \"spec\": {\n    \"languages\": [\n      \"triton\"\n    ],\n    \"target_hardware\": [\n      \"MI355X\",\n      \"LOCAL\"\n    ],\n    \"entry_point\": \"kernel.py::run\",\n    \"dependencies\": [\n      \"torch\",\n      \"triton\"\n    ],\n    \"destination_passing_style\": false\n  },\n  \"sources\": [\n    {\n      \"path\": \"kernel.py\",\n      \"content\": \"\"\n    }\n  ]\n}\n","exit_code":0,"status":"completed"}}
