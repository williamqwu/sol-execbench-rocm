}, \"in_proj_weight\": {\"type\": \"random\"}, \"conv1d_weight\": {\"type\": \"random\"}, \"conv1d_bias\": {\"type\": \"random\"}, \"dt_bias\": {\"type\": \"random\"}, \"A_log\": {\"type\": \"random\"}, \"D\": {\"type\": \"random\"}, \"norm_weight\": {\"type\": \"random\"}, \"out_proj_weight\": {\"type\": \"random\"}, \"time_step_limit_min\": {\"type\": \"scalar\", \"value\": 0.0}, \"time_step_limit_max\": {\"type\": \"scalar\", \"value\": 1000000.0}, \"layer_norm_epsilon\": {\"type\": \"scalar\", \"value\": 1e-05}}, \"tolerance\": {\"max_atol\": 0.004656906378585956, \"max_rtol\": 0.0078125, \"required_matched_ratio\": 0.99, \"_provenance\": \"max run-to-run error over 10 seeds x 1.25 margin, floored at torch.bfloat16 epsilon\"}}\n{\"uuid\": \"98b78c46-6a20-5513-ab56-04736c08da19\", \"axes\": {\"batch_size\": 2, \"seq_len\": 3072}, \"inputs\": {\"hidden_states\": {\"type\": \"random\"}, \"in_proj_weight\": {\"type\": \"random\"}, \"conv1d_weight\": {\"type\": \"random\"}, \"conv1d_bias\": {\"type\": \"random\"}, \"dt_bias\": {\"type\": \"random\"}, \"A_log\": {\"type\": \"random\"}, \"D\": {\"type\": \"random\"}, \"norm_weight\": {\"type\": \"random\"}, \"out_proj_weight\": {\"type\": \"random\"}, \"time_step_limit_min\": {\"type\": \"scalar\", \"value\": 0.0}, \"time_step_limit_max\": {\"type\": \"scalar\", \"value\": 1000000.0}, \"layer_norm_epsilon\": {\"type\": \"scalar\", \"value\": 1e-05}}, \"tolerance\": {\"max_atol\": 0.004664624316605625, \"max_rtol\": 0.0078125, \"required_matched_ratio\": 0.99, \"_provenance\": \"max run-to-run error over 10 seeds x 1.25 margin, floored at torch.bfloat16 epsilon\"}}\n","exit_code":0,"status":"completed"}}
