{"type":"item.started","item":{"id":"item_27","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch,triton,kernel\nshapes=[(4,541),(4,1879),(2,512),(8,1024),(2,293),(4,2048),(2,1321),(4,1024)]\nfor b,n in shapes:\n nc=(n+255)//256; dev='cuda:0'; ne=b*n*1024\n x=torch.zeros((b,n,16,64),device=dev,dtype=torch.bfloat16); a=torch.zeros((b,16,n),device=dev,dtype=torch.bfloat16)\n bv=torch.zeros((b,n,1,256),device=dev,dtype=torch.bfloat16); cv=torch.zeros_like(bv); d=torch.zeros(16,device=dev,dtype=torch.bfloat16)\n ini=torch.zeros((b,16,64,256),device=dev,dtype=torch.bfloat16); fin=torch.empty_like(ini); out=torch.empty((b,n,1024),device=dev,dtype=torch.bfloat16)\n part=torch.empty((b,nc,16,64,256),device=dev); dec=torch.empty((b,16,nc),device=dev)\n print('shape',b,n,'q',b*nc)\n for bd in (16,32,64):\n  nw=8; grid=(b*16*(64//bd),nc)\n  def old():\n   kernel._chunk_contrib_kernel[grid](x,a,bv,part,dec,n,nc,BLOCK_D=bd,num_warps=nw)\n   kernel._propagate_kernel[(grid[0],)](part,dec,ini,fin,nc,BLOCK_D=bd,num_warps=nw)\n   kernel._output_kernel[grid](x,a,bv,cv,d,part,out,n,nc,BLOCK_D=bd,num_warps=nw)\n  print(' old',bd,round(triton.testing.do_bench(old,warmup=5,rep=15),4))\n for bs,bd,nw in [(64,16,4),(64,32,8),(64,64,8),(128,16,4),(128,32,8),(128,64,8)]:\n  ns=256//bs; parts=torch.empty((b,n,1024,ns),device=dev); grid=(b*16*(64//bd),nc,ns)\n  def spl():\n   kernel._chunk_contrib_split_kernel[grid](x,a,bv,part,dec,n,nc,BLOCK_D=bd,BLOCK_S=bs,num_warps=nw)\n   kernel._propagate_split_kernel[(grid[0],ns)](part,dec,ini,fin,nc,BLOCK_D=bd,BLOCK_S=bs,num_warps=nw)\n   kernel._output_split_kernel[grid](x,a,bv,cv,part,parts,n,nc,BLOCK_D=bd,BLOCK_S=bs,N_ST=ns,num_warps=nw)\n   kernel._finish_split_kernel[(triton.cdiv(ne,256),)](x,d,parts,out,n_elements=ne,N_ST=ns,num_warps=4)\n  print(' spl',bs,bd,nw,round(triton.testing.do_bench(spl,warmup=5,rep=15),4))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
