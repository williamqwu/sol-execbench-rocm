{"type":"item.started","item":{"id":"item_17","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch, triton\nimport kernel\n\ndef bench(b,n):\n    dev='cuda:0'; nc=(n+255)//256\n    x=torch.zeros((b,n,16,64),device=dev,dtype=torch.bfloat16)\n    a=torch.zeros((b,16,n),device=dev,dtype=torch.bfloat16)\n    bv=torch.zeros((b,n,1,256),device=dev,dtype=torch.bfloat16)\n    cv=torch.zeros_like(bv); d=torch.zeros((16,),device=dev,dtype=torch.bfloat16)\n    ini=torch.zeros((b,16,64,256),device=dev,dtype=torch.bfloat16)\n    out=torch.empty((b,n,1024),device=dev,dtype=torch.bfloat16)\n    final=torch.empty_like(ini)\n    partial=torch.empty((b,nc,16,64,256),device=dev,dtype=torch.float32)\n    dec=torch.empty((b,16,nc),device=dev,dtype=torch.float32)\n    print('shape',b,n)\n    for bd in (4,8,16,32,64):\n      for nw in ((4,8) if bd>=16 else (4,)):\n        grid=(b*16*(64//bd),nc)\n        def go():\n          kernel._chunk_contrib_kernel[grid](x,a,bv,partial,dec,n,nc,BLOCK_D=bd,num_warps=nw)\n          kernel._propagate_kernel[(grid[0],)](partial,dec,ini,final,nc,BLOCK_D=bd,num_warps=nw)\n          kernel._output_kernel[grid](x,a,bv,cv,d,partial,out,n,nc,BLOCK_D=bd,num_warps=nw)\n        try:\n          ms=triton.testing.do_bench(go,warmup=10,rep=30)\n          print(' ',bd,nw,round(ms,4))\n        except Exception as e: print(' ERR',bd,nw,type(e).__name__,str(e)[-160:])\n    del x,a,bv,cv,d,ini,out,final,partial,dec\n\nfor shape in ((1,256),(1,1024),(16,512),(1,4096),(32,256)):\n    bench(*shape)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
