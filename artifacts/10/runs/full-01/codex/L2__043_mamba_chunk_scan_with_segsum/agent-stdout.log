{"type":"item.started","item":{"id":"item_30","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch\nimport kernel, reference\n\ndef check(b,n,atol):\n dev='cuda:0'; torch.manual_seed(1000+b+n)\n x=torch.randn((b,n,16,64),device=dev,dtype=torch.bfloat16)\n a=-torch.rand((b,16,n),device=dev,dtype=torch.bfloat16)*0.01\n bv=torch.randn((b,n,1,256),device=dev,dtype=torch.bfloat16)\n cv=torch.randn_like(bv); d=torch.randn(16,device=dev,dtype=torch.bfloat16)\n ini=torch.randn((b,16,64,256),device=dev,dtype=torch.bfloat16)\n y0,f0=reference.run(x,a,bv,cv,d,ini); y1,f1=kernel.run(x,a,bv,cv,d,ini); torch.cuda.synchronize()\n print('shape',b,n)\n for name,u,v in [('y',y0,y1),('f',f0,f1)]:\n  e=(u.float()-v.float()).abs(); ok=e <= atol+0.0078125*u.float().abs()\n  print(name,'ratio',ok.float().mean().item(),'max',e.max().item(),'mean',e.mean().item())\n del x,a,bv,cv,d,ini,y0,f0,y1,f1\n\ncheck(1,256,.118)\ncheck(2,293,.121)\ncheck(2,600,.14)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
