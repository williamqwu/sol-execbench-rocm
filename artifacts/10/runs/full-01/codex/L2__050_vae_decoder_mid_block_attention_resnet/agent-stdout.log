{"type":"item.started","item":{"id":"item_8","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch, importlib.util, time\nimport kernel, reference\n\ndef make(B,H,W):\n    C=512\n    r=lambda *s: torch.randn(s, device='cuda', dtype=torch.float32)\n    a=[r(B,C,H,W),r(B,C)]\n    a += [r(C),r(C),r(C,C,3,3),r(C),r(C,C),r(C),r(C),r(C),r(C,C,3,3),r(C)]\n    a += [r(C),r(C),r(C,C),r(C),r(C,C),r(C),r(C,C),r(C),r(C,C),r(C)]\n    a += [r(C),r(C),r(C,C,3,3),r(C),r(C,C),r(C),r(C),r(C),r(C,C,3,3),r(C),1e-6]\n    return a\n\ndef bench(fn,a,n=10):\n    for _ in range(2): fn(*a)\n    torch.cuda.synchronize()\n    t=time.perf_counter()\n    for _ in range(n): fn(*a)\n    torch.cuda.synchronize()\n    return (time.perf_counter()-t)*1000/n\n\nfor B,H,W,atol,rtol in [(1,16,16,9.536743e-5,.203947),(4,16,16,1.144409e-4,.222081),(1,48,48,1.0490417e-4,.295455),(1,32,32,3.8823e-6,1.1921e-7)]:\n    a=make(B,H,W)\n    ref=reference.run(*a)\n    def amp(*x):\n      with torch.autocast('cuda', dtype=torch.float16):\n        return kernel.run(*x)\n    out=amp(*a)\n    d=(out-ref).abs(); rel=d/ref.abs().clamp_min(1e-30)\n    ok=(d <= atol + rtol*ref.abs()).float().mean().item()\n    print((B,H,W),'ratio',ok,'maxabs',d.max().item(),'maxrel',rel.max().item(),'eager',bench(kernel.run,a),'amp',bench(amp,a))\n    del a,ref,out\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
