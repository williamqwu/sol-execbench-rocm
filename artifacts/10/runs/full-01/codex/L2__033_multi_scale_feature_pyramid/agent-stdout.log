{"type":"item.started","item":{"id":"item_9","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch, reference\nF=torch.nn.functional\n\ndef go(a,dt):\n x,*p=a;p=[v.to(dt) for v in p]\n w0,b0,wd0,bd0,w1,b1,wd1,bd1,w2,b2,wb,bb,wu0,bu0,wdec0,bdec0,wu1,bu1,wdec1,bdec1,wo,bo=p\n z0=F.conv2d(x.to(dt),w0,b0,padding=1);d0=F.conv2d(z0,wd0,bd0,stride=2,padding=1);z1=F.conv2d(d0,w1,b1,padding=1);d1=F.conv2d(z1,wd1,bd1,stride=2,padding=1);z2=F.conv2d(d1,w2,b2,padding=1);z=F.conv2d(z2,wb,bb,padding=1);u0=F.conv_transpose2d(z,wu0,bu0,stride=2);d=F.conv2d(torch.cat((u0,z1),1),wdec0,bdec0,padding=1);u1=F.conv_transpose2d(d,wu1,bu1,stride=2);d=F.conv2d(torch.cat((u1,z0),1),wdec1,bdec1,padding=1);return F.conv2d(d,wo,bo,padding=1).float()\ndef bench(fn):\n for _ in range(5):y=fn()\n torch.cuda.synchronize();s=torch.cuda.Event(1);e=torch.cuda.Event(1);q=[]\n for _ in range(20):s.record();y=fn();e.record();e.synchronize();q.append(s.elapsed_time(e))\n return sorted(q)[10],y\nfor B,H in [(1,128),(16,64),(2,256),(8,256)]:\n a=list(reference.get_inputs({'batch_size':B,'height':H,'width':H},torch.device('cuda')).values())\n t0,y=bench(lambda:reference.run(*a))\n for dt in [torch.float16,torch.bfloat16]:\n  t,z=bench(lambda:go(a,dt)); d=(y-z).abs(); print((B,H),dt,t,'speed',t0/t,'max',d.max().item())\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
