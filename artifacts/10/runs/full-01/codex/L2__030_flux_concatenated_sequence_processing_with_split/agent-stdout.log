{"type":"item.started","item":{"id":"item_12","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport torch, gc\nshapes = [(1,128,256), (1,77,4096), (1,77,1024), (1,1087,1163), (1,256,512), (2,128,256), (4,211,449)]\ntorch.manual_seed(0)\nprint(torch.__version__, torch.version.hip, torch.backends.cuda.matmul.allow_tf32)\nfor b, t, i in shapes:\n    h = torch.rand((b,i,3072), device=\\\"cuda\\\", dtype=torch.float32)\n    e = torch.rand((b,t,3072), device=\\\"cuda\\\", dtype=torch.float32)\n    w = torch.rand((3072,3072), device=\\\"cuda\\\", dtype=torch.float32)\n    c = torch.cat((e,h), 1)\n    ref = c @ w.t()\n    a = e @ w.t()\n    d = h @ w.t()\n    torch.cuda.synchronize()\n    re, rh = ref[:,:t], ref[:,t:]\n    de, dh = (a-re).abs(), (d-rh).abs()\n    print((b,t,i), \\\"enc\\\", de.max().item(), (a==re).float().mean().item(), \\\"img\\\", dh.max().item(), (d==rh).float().mean().item())\n    del h,e,w,c,ref,a,d,re,rh,de,dh\n    gc.collect()\n    torch.cuda.empty_cache()\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
