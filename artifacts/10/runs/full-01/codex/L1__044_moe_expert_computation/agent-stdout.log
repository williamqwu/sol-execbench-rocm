{"type":"item.started","item":{"id":"item_28","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch,aiter,traceback\nD='cuda'; T,H,I,E,KTOP,B=32,64,32,4,2,32\nx=torch.randn(T,H,device=D,dtype=torch.bfloat16)\nids=torch.stack([torch.randperm(E,device=D)[:KTOP] for _ in range(T)]).to(torch.int32)\nrw=torch.rand(T,KTOP,device=D,dtype=torch.bfloat16)\ng=torch.randn(E,I,H,device=D,dtype=torch.bfloat16)\nu=torch.randn(E,I,H,device=D,dtype=torch.bfloat16)\nd=torch.randn(E,H,I,device=D,dtype=torch.bfloat16)\nw1=torch.cat([g,u],dim=1)\nL=ids.numel()+E*B-KTOP\nst=torch.empty(L,device=D,dtype=torch.int32); sw=torch.empty(L,device=D,dtype=rw.dtype); se=torch.empty((L+B-1)//B,device=D,dtype=torch.int32); nv=torch.empty(1,device=D,dtype=torch.int32); mb=torch.empty(E,device=D,dtype=torch.int32)\naiter.moe_sorting_fwd(ids,rw,st,sw,se,nv,mb,E,B)\nfor shape in [(T*KTOP,I),(L,I),(T,KTOP,I)]:\n out=torch.full(shape,float('nan'),device=D,dtype=torch.bfloat16)\n try:\n  y=aiter.ck_moe_stage1_fwd(x,w1,d,st,se,nv,out,KTOP,block_m=B)\n  torch.cuda.synchronize(); print('shape',shape,'OK',y.shape,'nv',nv.item(),'nan',torch.isnan(y).sum().item())\n  yy=y.reshape(-1,I)[:T*KTOP]\n  ref=torch.empty_like(yy)\n  for t in range(T):\n   for k in range(KTOP):\n    e=int(ids[t,k]); ref[t*KTOP+k]=torch.nn.functional.silu(x[t]@g[e].T)*(x[t]@u[e].T)\n  print('err', (yy-ref).abs().max().item(), 'match', torch.isclose(yy,ref,rtol=.01,atol=.01).float().mean().item())\n except Exception as e: print('shape',shape,'ERR',type(e).__name__,str(e)[:2000])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
