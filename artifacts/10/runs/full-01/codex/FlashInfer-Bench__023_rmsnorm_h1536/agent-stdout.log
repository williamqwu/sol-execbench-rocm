{"type":"item.started","item":{"id":"item_16","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch\nimport triton\nimport kernel\nfor n in (11949, 14521):\n    x = torch.randn((n, 1536), device='cuda', dtype=torch.bfloat16)\n    w = torch.randn((1536,), device='cuda', dtype=torch.bfloat16)\n    ref = ((x.float() * torch.rsqrt(x.float().square().mean(-1, keepdim=True) + 1e-6)) * w.float()).bfloat16()\n    print(f'n={n}')\n    for name, kern in [('padded', kernel._rmsnorm_kernel), ('split', kernel._rmsnorm_split_kernel)]:\n      y = torch.empty_like(x)\n      for nw in (1, 2, 4):\n        vals=[]\n        for cap in (2048, 2560, 3072, 4096, n):\n          p=min(n, cap)\n          if name == 'padded':\n            def launch(): kern[(p,)](x,w,y,n_rows=n,H=1536,BLOCK=2048,ROW_STRIDE=p,num_warps=nw)\n          else:\n            def launch(): kern[(p,)](x,w,y,n_rows=n,H=1536,ROW_STRIDE=p,num_warps=nw)\n          launch(); torch.cuda.synchronize()\n          us=triton.testing.do_bench(launch,warmup=50,rep=200)*1000\n          vals.append(f'{cap}:{us:.2f}')\n        match=torch.isclose(y,ref,atol=.008,rtol=.0078125).float().mean().item()\n        print(f'  {name:6s} nw={nw}: ' + ' '.join(vals) + f' match={match:.6f}')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
