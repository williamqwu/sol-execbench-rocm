{"type":"item.started","item":{"id":"item_17","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport random\nimport torch\nimport kernel\nn=14521\nx=torch.randn((n,1536),device='cuda',dtype=torch.bfloat16)\nw=torch.randn((1536,),device='cuda',dtype=torch.bfloat16)\ny=torch.empty_like(x)\n\ndef make(kern,nw,cap,split):\n    p=min(n,cap)\n    if split:\n      return lambda: kern[(p,)](x,w,y,n_rows=n,H=1536,ROW_STRIDE=p,num_warps=nw)\n    return lambda: kern[(p,)](x,w,y,n_rows=n,H=1536,BLOCK=2048,ROW_STRIDE=p,num_warps=nw)\ncs={\n 'pad1_all':make(kernel._rmsnorm_kernel,1,n,False),\n 'spl1_all':make(kernel._rmsnorm_split_kernel,1,n,True),\n 'pad2_all':make(kernel._rmsnorm_kernel,2,n,False),\n 'spl2_all':make(kernel._rmsnorm_split_kernel,2,n,True),\n 'pad1_3072':make(kernel._rmsnorm_kernel,1,3072,False),\n 'spl1_3072':make(kernel._rmsnorm_split_kernel,1,3072,True),\n}\nfor f in cs.values():\n  for _ in range(20): f()\ntorch.cuda.synchronize()\nres={k:[] for k in cs}\nfor trial in range(8):\n  names=list(cs); random.Random(trial).shuffle(names)\n  events=[]\n  for name in names:\n    s=torch.cuda.Event(enable_timing=True); e=torch.cuda.Event(enable_timing=True)\n    s.record()\n    for _ in range(500): cs[name]()\n    e.record(); events.append((name,s,e))\n  torch.cuda.synchronize()\n  for name,s,e in events: res[name].append(s.elapsed_time(e)*2.0)\nfor k,v in res.items(): print(f'{k:10s}: ' + ' '.join(f'{x:.3f}' for x in v) + f' mean={sum(v)/len(v):.3f} us')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
