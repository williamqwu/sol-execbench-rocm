{"type":"item.completed","item":{"id":"item_80","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,\"'$p'\"' kernel.py\"","aggregated_output":"import torch\nimport triton\nimport triton.language as tl\n\n\n@triton.jit\ndef _rmsnorm_kernel(x_ptr, w_ptr, out_ptr, n_rows,\n                    H: tl.constexpr, BLOCK: tl.constexpr,\n                    ROW_STRIDE: tl.constexpr):\n    row = tl.program_id(0)\n    cols = tl.arange(0, BLOCK)\n    mask = cols < H\n    weight = tl.load(w_ptr + cols, mask=mask, other=0.0).to(tl.float32)\n\n    while row < n_rows:\n        x = tl.load(x_ptr + row * H + cols, mask=mask, other=0.0).to(tl.float32)\n        mean_square = tl.sum(x * x, axis=0) / H\n        inv_rms = tl.rsqrt(mean_square + 1.0e-6)\n        out = x * inv_rms * weight\n        tl.store(out_ptr + row * H + cols, out, mask=mask)\n        row += ROW_STRIDE\n\n\n@triton.jit\ndef _rmsnorm_split_kernel(x_ptr, w_ptr, out_ptr, n_rows,\n                          H: tl.constexpr, ROW_STRIDE: tl.constexpr):\n    row = tl.program_id(0)\n    cols0 = tl.arange(0, 1024)\n    cols1 = 1024 + tl.arange(0, 512)\n    weight0 = tl.load(w_ptr + cols0).to(tl.float32)\n    weight1 = tl.load(w_ptr + cols1).to(tl.float32)\n\n    while row < n_rows:\n        row_start = row * H\n        x0 = tl.load(x_ptr + row_start + cols0).to(tl.float32)\n        x1 = tl.load(x_ptr + row_start + cols1).to(tl.float32)\n        square_sum = tl.sum(x0 * x0, axis=0) + tl.sum(x1 * x1, axis=0)\n        inv_rms = tl.rsqrt(square_sum / H + 1.0e-6)\n        tl.store(out_ptr + row_start + cols0, x0 * inv_rms * weight0)\n        tl.store(out_ptr + row_start + cols1, x1 * inv_rms * weight1)\n        row += ROW_STRIDE\n\n\n@triton.jit\ndef _rmsnorm_reread_kernel(x_ptr, w_ptr, out_ptr, n_rows,\n                           H: tl.constexpr, ROW_STRIDE: tl.constexpr):\n    row = tl.program_id(0)\n    cols0 = tl.arange(0, 1024)\n    cols1 = 1024 + tl.arange(0, 512)\n\n    while row < n_rows:\n        row_start = row * H\n        r0 = tl.load(x_ptr + row_start + cols0).to(tl.float32)\n        sum0 = tl.sum(r0 * r0, axis=0)\n        r1 = tl.load(x_ptr + row_start + cols1).to(tl.float32)\n        sum1 = tl.sum(r1 * r1, axis=0)\n        inv_rms = tl.rsqrt((sum0 + sum1) / H + 1.0e-6)\n\n        x0 = tl.load(x_ptr + row_start + cols0).to(tl.float32)\n        w0 = tl.load(w_ptr + cols0).to(tl.float32)\n        tl.store(out_ptr + row_start + cols0, x0 * inv_rms * w0)\n        x1 = tl.load(x_ptr + row_start + cols1).to(tl.float32)\n        w1 = tl.load(w_ptr + cols1).to(tl.float32)\n        tl.store(out_ptr + row_start + cols1, x1 * inv_rms * w1)\n        row += ROW_STRIDE\n\n\n@triton.jit\ndef _rmsnorm_reread3_kernel(x_ptr, w_ptr, out_ptr, n_rows,\n                            H: tl.constexpr, ROW_STRIDE: tl.constexpr):\n    row = tl.program_id(0)\n    cols = tl.arange(0, 512)\n\n    while row < n_rows:\n        row_start = row * H\n        r0 = tl.load(x_ptr + row_start + cols).to(tl.float32)\n        sum0 = tl.sum(r0 * r0, axis=0)\n        r1 = tl.load(x_ptr + row_start + 512 + cols).to(tl.float32)\n        sum1 = tl.sum(r1 * r1, axis=0)\n        r2 = tl.load(x_ptr + row_start + 1024 + cols).to(tl.float32)\n        sum2 = tl.sum(r2 * r2, axis=0)\n        inv_rms = tl.rsqrt((sum0 + sum1 + sum2) / H + 1.0e-6)\n\n        x0 = tl.load(x_ptr + row_start + cols).to(tl.float32)\n        w0 = tl.load(w_ptr + cols).to(tl.float32)\n        tl.store(out_ptr + row_start + cols, x0 * inv_rms * w0)\n        x1 = tl.load(x_ptr + row_start + 512 + cols).to(tl.float32)\n        w1 = tl.load(w_ptr + 512 + cols).to(tl.float32)\n        tl.store(out_ptr + row_start + 512 + cols, x1 * inv_rms * w1)\n        x2 = tl.load(x_ptr + row_start + 1024 + cols).to(tl.float32)\n        w2 = tl.load(w_ptr + 1024 + cols).to(tl.float32)\n        tl.store(out_ptr + row_start + 1024 + cols, x2 * inv_rms * w2)\n        row += ROW_STRIDE\n\n\n@triton.jit\ndef _rmsnorm_bf16_kernel(x_ptr, w_ptr, out_ptr, n_rows,\n                         H: tl.constexpr, ROW_STRIDE: tl.constexpr):\n    row = tl.program_id(0)\n    cols0 = tl.arange(0, 1024)\n    cols1 = 1024 + tl.arange(0, 512)\n    weight0 = tl.load(w_ptr + cols0)\n    weight1 = tl.load(w_ptr + cols1)\n\n    while row < n_rows:\n        row_start = row * H\n        x0 = tl.load(x_ptr + row_start + cols0)\n        x1 = tl.load(x_ptr + row_start + cols1)\n        sum0 = tl.sum(x0.to(tl.float32) * x0.to(tl.float32), axis=0)\n        sum1 = tl.sum(x1.to(tl.float32) * x1.to(tl.float32), axis=0)\n        inv_rms = tl.rsqrt((sum0 + sum1) / H + 1.0e-6)\n        tl.store(out_ptr + row_start + cols0,\n                 x0.to(tl.float32) * inv_rms * weight0.to(tl.float32))\n        tl.store(out_ptr + row_start + cols1,\n                 x1.to(tl.float32) * inv_rms * weight1.to(tl.float32))\n        row += ROW_STRIDE\n\n\n@triton.jit\ndef _rmsnorm_streamw_kernel(x_ptr, w_ptr, out_ptr, n_rows,\n                            H: tl.constexpr, ROW_STRIDE: tl.constexpr):\n    row = tl.program_id(0)\n    cols0 = tl.arange(0, 1024)\n    cols1 = 1024 + tl.arange(0, 512)\n\n    while row < n_rows:\n        row_start = row * H\n        x0 = tl.load(x_ptr + row_start + cols0).to(tl.float32)\n        x1 = tl.load(x_ptr + row_start + cols1).to(tl.float32)\n        sum0 = tl.sum(x0 * x0, axis=0)\n        sum1 = tl.sum(x1 * x1, axis=0)\n        inv_rms = tl.rsqrt((sum0 + sum1) / H + 1.0e-6)\n        w0 = tl.load(w_ptr + cols0).to(tl.float32)\n        tl.store(out_ptr + row_start + cols0, x0 * inv_rms * w0)\n        w1 = tl.load(w_ptr + cols1).to(tl.float32)\n        tl.store(out_ptr + row_start + cols1, x1 * inv_rms * w1)\n        row += ROW_STRIDE\n\n\n@triton.jit\ndef _rmsnorm_packed_kernel(x_ptr, w_ptr, out_ptr, n_rows,\n                           H: tl.constexpr, ROW_STRIDE: tl.constexpr):\n    row = tl.program_id(0)\n    pair0 = tl.arange(0, 512)\n    pair1 = 512 + tl.arange(0, 256)\n    x_u32 = tl.cast(x_ptr, tl.pointer_type(tl.uint32), bitcast=True)\n    w_u32 = tl.cast(w_ptr, tl.pointer_type(tl.uint32), bitcast=True)\n    out_u32 = tl.cast(out_ptr, tl.pointer_type(tl.uint32), bitcast=True)\n    wp0 = tl.load(w_u32 + pair0)\n    wp1 = tl.load(w_u32 + pair1)\n\n    while row < n_rows:\n        pair_start = row * (H // 2)\n        xp0 = tl.load(x_u32 + pair_start + pair0)\n        xp1 = tl.load(x_u32 + pair_start + pair1)\n\n        x0l = (xp0 & 0xffff).to(tl.uint16).to(tl.bfloat16, bitcast=True).to(tl.float32)\n        x0h = (xp0 >> 16).to(tl.uint16).to(tl.bfloat16, bitcast=True).to(tl.float32)\n        x1l = (xp1 & 0xffff).to(tl.uint16).to(tl.bfloat16, bitcast=True).to(tl.float32)\n        x1h = (xp1 >> 16).to(tl.uint16).to(tl.bfloat16, bitcast=True).to(tl.float32)\n        square_sum = tl.sum(x0l * x0l + x0h * x0h, axis=0)\n        square_sum += tl.sum(x1l * x1l + x1h * x1h, axis=0)\n        inv_rms = tl.rsqrt(square_sum / H + 1.0e-6)\n\n        w0l = (wp0 & 0xffff).to(tl.uint16).to(tl.bfloat16, bitcast=True).to(tl.float32)\n        w0h = (wp0 >> 16).to(tl.uint16).to(tl.bfloat16, bitcast=True).to(tl.float32)\n        o0l = (x0l * inv_rms * w0l).to(tl.bfloat16).to(tl.uint16, bitcast=True).to(tl.uint32)\n        o0h = (x0h * inv_rms * w0h).to(tl.bfloat16).to(tl.uint16, bitcast=True).to(tl.uint32)\n        tl.store(out_u32 + pair_start + pair0, o0l | (o0h << 16))\n\n        w1l = (wp1 & 0xffff).to(tl.uint16).to(tl.bfloat16, bitcast=True).to(tl.float32)\n        w1h = (wp1 >> 16).to(tl.uint16).to(tl.bfloat16, bitcast=True).to(tl.float32)\n        o1l = (x1l * inv_rms * w1l).to(tl.bfloat16).to(tl.uint16, bitcast=True).to(tl.uint32)\n        o1h = (x1h * inv_rms * w1h).to(tl.bfloat16).to(tl.uint16, bitcast=True).to(tl.uint32)\n        tl.store(out_u32 + pair_start + pair1, o1l | (o1h << 16))\n        row += ROW_STRIDE\n\n\n@triton.jit\ndef _rmsnorm_rows_kernel(x_ptr, w_ptr, out_ptr, n_rows,\n                         H: tl.constexpr, ROWS: tl.constexpr,\n                         GROUP_STRIDE: tl.constexpr):\n    group = tl.program_id(0)\n    row_in_group = tl.arange(0, ROWS)\n    cols0 = tl.arange(0, 1024)\n    cols1 = tl.arange(0, 512)\n    weight0 = tl.load(w_ptr + cols0)[None, :].to(tl.float32)\n    weight1 = tl.load(w_ptr + 1024 + cols1)[None, :].to(tl.float32)\n\n    while group * ROWS < n_rows:\n        rows = group * ROWS + row_in_group\n        row_mask = rows < n_rows\n        offs0 = rows[:, None] * H + cols0[None, :]\n        offs1 = rows[:, None] * H + 1024 + cols1[None, :]\n        x0 = tl.load(x_ptr + offs0, mask=row_mask[:, None], other=0.0).to(tl.float32)\n        x1 = tl.load(x_ptr + offs1, mask=row_mask[:, None], other=0.0).to(tl.float32)\n        square_sum = tl.sum(x0 * x0, axis=1) + tl.sum(x1 * x1, axis=1)\n        inv_rms = tl.rsqrt(square_sum / H + 1.0e-6)\n        tl.store(out_ptr + offs0, x0 * inv_rms[:, None] * weight0,\n                 mask=row_mask[:, None])\n        tl.store(out_ptr + offs1, x1 * inv_rms[:, None] * weight1,\n                 mask=row_mask[:, None])\n        group += GROUP_STRIDE\n\n\n@triton.jit\ndef _rmsnorm_rows_bf16_kernel(x_ptr, w_ptr, out_ptr, n_rows,\n                              H: tl.constexpr, ROWS: tl.constexpr,\n                              GROUP_STRIDE: tl.constexpr):\n    group = tl.program_id(0)\n    row_in_group = tl.arange(0, ROWS)\n    cols0 = tl.arange(0, 1024)\n    cols1 = tl.arange(0, 512)\n    weight0 = tl.load(w_ptr + cols0)[None, :]\n    weight1 = tl.load(w_ptr + 1024 + cols1)[None, :]\n\n    while group * ROWS < n_rows:\n        rows = group * ROWS + row_in_group\n        row_mask = rows < n_rows\n        offs0 = rows[:, None] * H + cols0[None, :]\n        offs1 = rows[:, None] * H + 1024 + cols1[None, :]\n        x0 = tl.load(x_ptr + offs0, mask=row_mask[:, None], other=0.0)\n        x1 = tl.load(x_ptr + offs1, mask=row_mask[:, None], other=0.0)\n        x0f = x0.to(tl.float32)\n        x1f = x1.to(tl.float32)\n        square_sum = tl.sum(x0f * x0f, axis=1) + tl.sum(x1f * x1f, axis=1)\n        inv_rms = tl.rsqrt(square_sum / H + 1.0e-6)\n        tl.store(out_ptr + offs0,\n                 x0.to(tl.float32) * inv_rms[:, None] * weight0.to(tl.float32),\n                 mask=row_mask[:, None])\n        tl.store(out_ptr + offs1,\n                 x1.to(tl.float32) * inv_rms[:, None] * weight1.to(tl.float32),\n                 mask=row_mask[:, None])\n        group += GROUP_STRIDE\n\n\n@triton.jit\ndef _rmsnorm_two_kernel(x_ptr, w_ptr, out_ptr, n_rows,\n                        H: tl.constexpr):\n    group = tl.program_id(0)\n    row0 = group * 2\n    row1 = tl.minimum(row0 + 1, n_rows - 1)\n    cols0 = tl.arange(0, 1024)\n    cols1 = 1024 + tl.arange(0, 512)\n    weight0 = tl.load(w_ptr + cols0).to(tl.float32)\n    weight1 = tl.load(w_ptr + cols1).to(tl.float32)\n\n    a0 = tl.load(x_ptr + row0 * H + cols0).to(tl.float32)\n    a1 = tl.load(x_ptr + row0 * H + cols1).to(tl.float32)\n    suma = tl.sum(a0 * a0, axis=0) + tl.sum(a1 * a1, axis=0)\n    inva = tl.rsqrt(suma / H + 1.0e-6)\n\n    b0 = tl.load(x_ptr + row1 * H + cols0).to(tl.float32)\n    b1 = tl.load(x_ptr + row1 * H + cols1).to(tl.float32)\n    sumb = tl.sum(b0 * b0, axis=0) + tl.sum(b1 * b1, axis=0)\n    invb = tl.rsqrt(sumb / H + 1.0e-6)\n\n    tl.store(out_ptr + row0 * H + cols0, a0 * inva * weight0)\n    tl.store(out_ptr + row0 * H + cols1, a1 * inva * weight1)\n    tl.store(out_ptr + row1 * H + cols0, b0 * invb * weight0)\n    tl.store(out_ptr + row1 * H + cols1, b1 * invb * weight1)\n\n\n@triton.jit\ndef _rmsnorm_two_seq_kernel(x_ptr, w_ptr, out_ptr, n_rows,\n                            H: tl.constexpr):\n    group = tl.program_id(0)\n    row0 = group * 2\n    row1 = tl.minimum(row0 + 1, n_rows - 1)\n    cols0 = tl.arange(0, 1024)\n    cols1 = 1024 + tl.arange(0, 512)\n    weight0 = tl.load(w_ptr + cols0).to(tl.float32)\n    weight1 = tl.load(w_ptr + cols1).to(tl.float32)\n\n    a0 = tl.load(x_ptr + row0 * H + cols0).to(tl.float32)\n    a1 = tl.load(x_ptr + row0 * H + cols1).to(tl.float32)\n    suma = tl.sum(a0 * a0, axis=0) + tl.sum(a1 * a1, axis=0)\n    inva = tl.rsqrt(suma / H + 1.0e-6)\n    tl.store(out_ptr + row0 * H + cols0, a0 * inva * weight0)\n    tl.store(out_ptr + row0 * H + cols1, a1 * inva * weight1)\n\n    b0 = tl.load(x_ptr + row1 * H + cols0).to(tl.float32)\n    b1 = tl.load(x_ptr + row1 * H + cols1).to(tl.float32)\n    sumb = tl.sum(b0 * b0, axis=0) + tl.sum(b1 * b1, axis=0)\n    invb = tl.rsqrt(sumb / H + 1.0e-6)\n    tl.store(out_ptr + row1 * H + cols0, b0 * invb * weight0)\n    tl.store(out_ptr + row1 * H + cols1, b1 * invb * weight1)\n\n\n@triton.jit\ndef _rmsnorm_seq_kernel(x_ptr, w_ptr, out_ptr, n_rows,\n                        H: tl.constexpr, ROWS: tl.constexpr):\n    row = tl.program_id(0) * ROWS\n    end = tl.minimum(row + ROWS, n_rows)\n    cols0 = tl.arange(0, 1024)\n    cols1 = 1024 + tl.arange(0, 512)\n    weight0 = tl.load(w_ptr + cols0).to(tl.float32)\n    weight1 = tl.load(w_ptr + cols1).to(tl.float32)\n\n    while row < end:\n        x0 = tl.load(x_ptr + row * H + cols0).to(tl.float32)\n        x1 = tl.load(x_ptr + row * H + cols1).to(tl.float32)\n        square_sum = tl.sum(x0 * x0, axis=0) + tl.sum(x1 * x1, axis=0)\n        inv_rms = tl.rsqrt(square_sum / H + 1.0e-6)\n        tl.store(out_ptr + row * H + cols0, x0 * inv_rms * weight0)\n        tl.store(out_ptr + row * H + cols1, x1 * inv_rms * weight1)\n        row += 1\n\n\n@triton.jit\ndef _rmsnorm_rows_512_kernel(x_ptr, w_ptr, out_ptr, n_rows,\n                             H: tl.constexpr, ROWS: tl.constexpr,\n                             GROUP_STRIDE: tl.constexpr):\n    group = tl.program_id(0)\n    row_in_group = tl.arange(0, ROWS)\n    cols = tl.arange(0, 512)\n    weight0 = tl.load(w_ptr + cols)[None, :].to(tl.float32)\n    weight1 = tl.load(w_ptr + 512 + cols)[None, :].to(tl.float32)\n    weight2 = tl.load(w_ptr + 1024 + cols)[None, :].to(tl.float32)\n\n    while group * ROWS < n_rows:\n        rows = group * ROWS + row_in_group\n        row_mask = rows < n_rows\n        base = rows[:, None] * H + cols[None, :]\n        x0 = tl.load(x_ptr + base, mask=row_mask[:, None], other=0.0).to(tl.float32)\n        x1 = tl.load(x_ptr + base + 512, mask=row_mask[:, None], other=0.0).to(tl.float32)\n        x2 = tl.load(x_ptr + base + 1024, mask=row_mask[:, None], other=0.0).to(tl.float32)\n        square_sum = tl.sum(x0 * x0, axis=1)\n        square_sum += tl.sum(x1 * x1, axis=1)\n        square_sum += tl.sum(x2 * x2, axis=1)\n        inv_rms = tl.rsqrt(square_sum / H + 1.0e-6)\n        tl.store(out_ptr + base, x0 * inv_rms[:, None] * weight0,\n                 mask=row_mask[:, None])\n        tl.store(out_ptr + base + 512, x1 * inv_rms[:, None] * weight1,\n                 mask=row_mask[:, None])\n        tl.store(out_ptr + base + 1024, x2 * inv_rms[:, None] * weight2,\n                 mask=row_mask[:, None])\n        group += GROUP_STRIDE\n\n\ndef run(hidden_states: torch.Tensor, weight: torch.Tensor):\n    assert hidden_states.shape[1] == 1536\n    output = torch.empty_like(hidden_states)\n    n_rows = hidden_states.shape[0]\n    n_programs = min(triton.cdiv(n_rows, 2), 1792)\n    _rmsnorm_rows_kernel[(n_programs,)](\n        hidden_states, weight, output,\n        n_rows=n_rows, H=1536, ROWS=2,\n        GROUP_STRIDE=n_programs,\n        num_warps=1,\n        num_stages=2,\n        waves_per_eu=4,\n    )\n    return output\n","exit_code":0,"status":"completed"}}
