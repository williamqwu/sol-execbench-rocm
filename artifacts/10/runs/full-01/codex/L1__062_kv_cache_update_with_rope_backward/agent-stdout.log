{"type":"item.started","item":{"id":"item_7","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch, triton\nfrom kernel import _copy_caches\n\ndef bench(n):\n    a=torch.empty(n, device='cuda', dtype=torch.bfloat16)\n    b=torch.empty_like(a); c=torch.empty_like(a); d=torch.empty_like(a)\n    print('n', n)\n    for block, warps in [(256,4),(512,4),(512,8),(1024,4),(1024,8),(2048,4),(2048,8),(4096,4),(4096,8),(8192,8)]:\n        try:\n            fn=lambda: _copy_caches[(triton.cdiv(n,block),)](a,b,c,d,n,BLOCK=block,num_warps=warps)\n            ms=triton.testing.do_bench(fn, warmup=10, rep=30)\n            print(block, warps, f'{ms:.5f} ms')\n        except Exception as e:\n            print(block, warps, type(e).__name__, str(e).splitlines()[0])\n    del a,b,c,d\n\nbench(32*8*2048*128)\nbench(32*8*8192*128)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
