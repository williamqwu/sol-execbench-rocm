{"type":"item.started","item":{"id":"item_16","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch,triton\nimport triton.language as tl\n\n@triton.jit\ndef inter(a,b,c,d,n:tl.constexpr,B:tl.constexpr):\n o=tl.program_id(0)*B+tl.arange(0,B);m=o<n\n av=tl.load(a+o,mask=m);bv=tl.load(b+o,mask=m)\n tl.store(c+o,av,mask=m);tl.store(d+o,bv,mask=m)\n@triton.jit\ndef cg(a,b,c,d,n:tl.constexpr,B:tl.constexpr):\n o=tl.program_id(0)*B+tl.arange(0,B);m=o<n\n av=tl.load(a+o,mask=m,cache_modifier='.cg');bv=tl.load(b+o,mask=m,cache_modifier='.cg')\n tl.store(c+o,av,mask=m,cache_modifier='.cs');tl.store(d+o,bv,mask=m,cache_modifier='.cs')\n@triton.jit\ndef split(a,b,c,d,n:tl.constexpr,B:tl.constexpr):\n o=tl.program_id(0)*B+tl.arange(0,B);m=o<n; which=tl.program_id(1)\n src=tl.where(which==0,a,b);dst=tl.where(which==0,c,d)\n tl.store(dst+o,tl.load(src+o,mask=m),mask=m)\n@triton.jit\ndef loop2(a,b,c,d,n:tl.constexpr,B:tl.constexpr):\n base=tl.program_id(0)*(B*2);o=base+tl.arange(0,B);m=o<n\n av=tl.load(a+o,mask=m);bv=tl.load(b+o,mask=m);tl.store(c+o,av,mask=m);tl.store(d+o,bv,mask=m)\n o+=B;m=o<n\n av=tl.load(a+o,mask=m);bv=tl.load(b+o,mask=m);tl.store(c+o,av,mask=m);tl.store(d+o,bv,mask=m)\n\ndef go(n):\n a=torch.empty(n,device='cuda',dtype=torch.bfloat16);b=torch.empty_like(a);c=torch.empty_like(a);d=torch.empty_like(a)\n print('n',n)\n variants=[\n ('inter256',lambda:inter[(triton.cdiv(n,256),)](a,b,c,d,n,B=256,num_warps=1)),\n ('inter512',lambda:inter[(triton.cdiv(n,512),)](a,b,c,d,n,B=512,num_warps=1)),\n ('cg256',lambda:cg[(triton.cdiv(n,256),)](a,b,c,d,n,B=256,num_warps=1)),\n ('split256',lambda:split[(triton.cdiv(n,256),2)](a,b,c,d,n,B=256,num_warps=1)),\n ('loop2x256',lambda:loop2[(triton.cdiv(n,512),)](a,b,c,d,n,B=256,num_warps=1)),\n ('loop2x512',lambda:loop2[(triton.cdiv(n,1024),)](a,b,c,d,n,B=512,num_warps=1)),\n ]\n for name,f in variants:\n  try: print(name,triton.testing.do_bench(f,warmup=10,rep=30))\n  except Exception as e: print(name