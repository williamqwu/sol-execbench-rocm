{"type":"item.started","item":{"id":"item_20","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch, triton\nimport kernel\n\ntorch.manual_seed(1)\nH,T=2048,512\nconfigs={\n 1:[(1,1),(2,1),(4,1),(8,1),(16,1)],\n 2:[(1,1),(2,1),(4,1),(8,1),(16,1)],\n 4:[(2,1),(4,1),(8,1),(16,1),(32,1)],\n 8:[(4,1),(8,1),(16,1),(32,1),(64,1)],\n 16:[(8,1),(16,1),(32,1),(64,1),(128,1),(128,2)],\n 32:[(16,1),(32,1),(64,1),(128,1),(128,2),(256,1),(256,2)],\n 64:[(32,1),(64,1),(128,1),(128,2),(256,1),(256,2),(256,4)],\n}\nfor B,cfgs in configs.items():\n key=torch.randn(B,T,H,device='cuda'); value=torch.randn_like(key)\n decay=torch.randn(H,device='cuda'); first=torch.randn(H,device='cuda')\n ms=torch.zeros(B,H,device='cuda'); ns=torch.zeros_like(ms); ds=torch.zeros_like(ms)\n out=torch.empty_like(key); mo=torch.empty_like(ms); no=torch.empty_like(ms); do=torch.empty_like(ms)\n def launch(bl,nw):\n  kernel._time_decay_kernel[(B,triton.cdiv(H,bl))](decay,key,first,value,ms,ns,ds,out,mo,no,do,T,hidden_size=H,BLOCK=bl,num_warps=nw,enable_fp_fusion=False)\n results=[]\n for bl,nw in cfgs:\n  launch(bl,nw); torch.cuda.synchronize()\n  for _ in range(3): launch(bl,nw)\n  s=torch.cuda.Event(enable_timing=True); e=torch.cuda.Event(enable_timing=True)\n  s.record()\n  for _ in range(30): launch(bl,nw)\n  e.record(); e.synchronize()\n  results.append((s.elapsed_time(e)/30,bl,nw))\n print('B',B,' '.join(f'b{bl}w{nw}={msv:.4f}' for msv,bl,nw in results),'best',min(results))\n del key,value,decay,first,ms,ns,ds,out,mo,no,do\n torch.cuda.empty_cache()\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
