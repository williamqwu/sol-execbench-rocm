{"type":"item.started","item":{"id":"item_83","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport kernel,torch,triton\nfor n,h in [(1,131),(1,384),(1,512),(16,384),(64,128),(2,1024)]:\n s=((h+1)//2)**2;num=n*64*s;y=torch.zeros(num,device='cuda');b=torch.rand(64,device='cuda');print('\\\\n',n,h,num)\n for block,warps in [(512,4),(1024,4),(2048,4),(2048,8),(4096,4),(4096,8),(8192,4),(8192,8)]:\n  for waves in [None,1,2,4]:\n   kw={'num_warps':warps}\n   if waves is not None:kw['waves_per_eu']=waves\n   try:\n    f=lambda block=block,kw=kw:kernel._bias_add_2d[(triton.cdiv(s,block),n*64)](y,b,SPATIAL=s,BLOCK=block,**kw)\n    t=triton.testing.do_bench(f,warmup=30,rep=150,return_mode='median')\n    print(block,warps,'w',waves,t)\n   except Exception as e: print(block,warps,'w',waves,'ERR',str(e).splitlines()[-1])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
