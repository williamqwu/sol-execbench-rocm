{"type":"item.started","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch, triton\nprint('torch', torch.__version__, 'triton', triton.__version__)\nprint(torch.cuda.get_device_name(0), torch.cuda.get_device_properties(0))\nfor n,h in [(1,131),(1,384),(1,512),(2,1024),(16,384),(64,128)]:\n    x=torch.rand((n,32,h,h),device='cuda',dtype=torch.float32)\n    w=torch.rand((64,32,3,3),device='cuda',dtype=torch.float32)\n    b=torch.rand((64,),device='cuda',dtype=torch.float32)\n    for _ in range(5): y=torch.nn.functional.conv2d(x,w,b,stride=2,padding=1)\n    torch.cuda.synchronize()\n    import time\n    st=time.perf_counter()\n    for _ in range(20): y=torch.nn.functional.conv2d(x,w,b,stride=2,padding=1)\n    torch.cuda.synchronize()\n    print((n,h), y.shape, (time.perf_counter()-st)*1000/20)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
