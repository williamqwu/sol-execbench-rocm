{"type":"item.started","item":{"id":"item_51","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch,numpy as np\nh=131; torch.manual_seed(19); x=torch.ones((1,32,h,h),device='cuda'); w=torch.rand((64,32,3,3),device='cuda'); y=torch.nn.functional.conv2d(x,w,None,stride=2,padding=1); torch.cuda.synchronize(); A=w.reshape(64,288).cpu().numpy(); T=y[0,:,10,10].cpu().numpy()\ndef seq(v):\n s=np.float32(0)\n for q in v:s=np.float32(s+q)\n return s\ndef tree(v):\n v=list(v)\n while len(v)>1:v=[np.float32(v[i]+v[i+1]) if i+1<len(v) else v[i] for i in range(0,len(v),2)]\n return v[0]\ndef alg(v,n,kind,red):\n s=np.zeros(n,np.float32)\n for i,q in enumerate(v):\n  if kind=='inter': j=i%n\n  elif kind=='contig': j=min(i//((len(v)+n-1)//n),n-1)\n  elif kind=='block': j=(i//4)%n\n  s[j]=np.float32(s[j]+q)\n return seq(s) if red=='seq' else tree(s)\ndef score(name,F):\n z=np.array([F(v) for v in A],np.float32); du=np.abs(z.view(np.int32)-T.view(np.int32)); print(name,'eq',np.mean(z==T),'meanulp',du.mean(),'max',du.max())\nscore('seq',seq);score('rev',lambda v:seq(v[::-1]));score('tree',tree);score('npsum',lambda v:np.sum(v,dtype=np.float32))\nfor n in [2,3,4,6,8,9,12,16,18,24,32,36,64,72]:\n for kind in ['inter','contig','block']:\n  for red in ['seq','tree']:score(f'{n}-{kind}-{red}',lambda v,n=n,kind=kind,red=red:alg(v,n,kind,red))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
