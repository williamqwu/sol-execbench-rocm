{"type":"item.started","item":{"id":"item_50","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch, numpy as np\nh=131; torch.manual_seed(7); x=torch.ones((1,32,h,h),device='cuda'); w=torch.rand((64,32,3,3),device='cuda'); b=torch.zeros(64,device='cuda'); y=torch.nn.functional.conv2d(x,w,b,stride=2,padding=1); torch.cuda.synchronize()\na=w[0].flatten().cpu().numpy().astype(np.float32); target=np.float32(y[0,0,10,10].item())\nprint('target',target,hex(target.view(np.uint32)))\ndef seq(v):\n s=np.float32(0)\n for q in v: s=np.float32(s+q)\n return s\ndef multi(v,n,inter=True):\n s=np.zeros(n,np.float32)\n for i,q in enumerate(v):\n  j=i%n if inter else min(i//((len(v)+n-1)//n),n-1)\n  s[j]=np.float32(s[j]+q)\n return seq(s)\ndef tree(v):\n v=list(v)\n while len(v)>1:\n  v=[np.float32(v[i]+v[i+1]) if i+1<len(v) else v[i] for i in range(0,len(v),2)]\n return v[0]\nfor name,z in [('seq',seq(a)),('rev',seq(a[::-1])),('tree',tree(a))]: print(name,z,hex(z.view(np.uint32)),int(z.view(np.uint32))-int(target.view(np.uint32)))\nfor n in [2,4,8,16,32,64]:\n for inter in [True,False]:\n  z=multi(a,n,inter); print('multi',n,inter,z,int(z.view(np.uint32))-int(target.view(np.uint32)))\n# sums by dot-4 then accumulate, with common internal associations\nfor assoc in range(4):\n s=np.float32(0)\n for i in range(0,288,4):\n  q=a[i:i+4]\n  if assoc==0: t=seq(q)\n  elif assoc==1: t=np.float32(np.float32(q[0]+q[1])+np.float32(q[2]+q[3]))\n  elif assoc==2: t=np.float32(q[0]+np.float32(q[1]+np.float32(q[2]+q[3])))\n  else: t=seq(q[::-1])\n  s=np.float32(s+t)\n print('dot4',assoc,s,int(s.view(np.uint32))-int(target.view(np.uint32)))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
