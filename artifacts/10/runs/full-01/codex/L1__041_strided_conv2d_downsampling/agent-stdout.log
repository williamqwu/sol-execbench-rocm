{"type":"item.started","item":{"id":"item_61","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch,triton\nops={\n'F':lambda x,w,b:torch.nn.functional.conv2d(x,w,b,stride=2,padding=1),\n'torch':lambda x,w,b:torch.conv2d(x,w,b,stride=2,padding=1),\n'atenconv':lambda x,w,b:torch.ops.aten.conv2d.default(x,w,b,[2,2],[1,1],[1,1],1),\n'miopen':lambda x,w,b:torch.ops.aten.miopen_convolution.default(x,w,b,[1,1],[2,2],[1,1],1,False,False),\n}\nfor n,h in [(1,131),(1,384),(1,512),(16,384),(2,1024)]:\n x=torch.rand((n,32,h,h),device='cuda');w=torch.rand((64,32,3,3),device='cuda');b=torch.rand(64,device='cuda');ref=ops['F'](x,w,b)\n print('\\\\n',n,h)\n for name,f in ops.items():\n  y=f(x,w,b);torch.cuda.synchronize();print(name,'eq',(y==ref).all().item(),'ms',triton.testing.do_bench(lambda:f(x,w,b),warmup=25,rep=100,return_mode='median'))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
