{"type":"item.started","item":{"id":"item_21","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch, gc\nT,H,I,E,K=2048,2880,2880,128,4; d='cuda'\n# Empty weights are sufficient for kernel timing and avoid costly random initialization.\nhs=torch.empty((T,H),device=d); ri=torch.randint(E,(T,K),device=d); rw=torch.empty((T,E),device=d)\ngu=torch.empty((E,H,2*I),device=d); gb=torch.empty((E,2*I),device=d)\ndp=torch.empty((E,I,H),device=d); db=torch.empty((E,H),device=d)\n\ndef once():\n ev=[torch.cuda.Event(enable_timing=True) for _ in range(12)]; labels=[]; ev[0].record(); j=1\n rex=ri.T.contiguous().view(-1); rt=torch.arange(T,device=d).repeat(K); se,order=torch.sort(rex,stable=True); st=rt[order]; off=torch.bincount(rex,minlength=E).cumsum(0).to(torch.int32); ev[j].record();labels.append('dispatch');j+=1\n cs=hs[st]; ev[j].record();labels.append('gather');j+=1\n x=torch._grouped_mm(cs,gu,off); ev[j].record();labels.append('gemm1');j+=1\n x.add_(gb[se]); ev[j].record();labels.append('bias1');j+=1\n g=x[...,::2].clamp(max=7); u=x[...,1::2].clamp(-7,7); glu=g*torch.sigmoid(g*1.702); y=(u+1)*glu; ev[j].record();labels.append('activation');j+=1\n z=torch._grouped_mm(y,dp,off); ev[j].record();labels.append('gemm2');j+=1\n z.add_(db[se]); z.mul_(rw[st,se,None]); ev[j].record();labels.append('bias_weight');j+=1\n br=torch.empty_like(z);br[order]=z;br=br.view(K,T,H).permute(1,0,2);so=torch.argsort(ri,dim=1,stable=True);o=torch.gather(br,1,so[...,None].expand(-1,-1,H));out=o[:,0]+o[:,1];out.add_(o[:,2]);out.add_(o[:,3]);ev[j].record();labels.append('combine');j+=1\n torch.cuda.synchronize(); return labels,[ev[q].elapsed_time(ev[q+1]) for q in range(j-1)]\nfor q in range(3):\n labels,t=once(); print(q, ' '.join(f'{a}={b:.3f}' for a,b in zip(labels,t)), 'total',sum(t))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
