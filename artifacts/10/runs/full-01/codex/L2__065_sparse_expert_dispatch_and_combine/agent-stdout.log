{"type":"item.started","item":{"id":"item_24","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch, reference\n@torch.no_grad()\ndef bmmrun(hs,ri,rw,gu,gb,dp,db):\n T,H=hs.shape; E=gu.shape[0]; K=ri.shape[1]\n rex=ri.T.contiguous().view(-1);rt=torch.arange(T,device='cuda').repeat(K);se,o=torch.sort(rex,stable=True);st=rt[o]\n cnt=torch.bincount(rex,minlength=E);off=cnt.cumsum(0);beg=off-cnt;loc=torch.arange(T*K,device='cuda')-beg[se]\n M=int(cnt.max().item()); M=(M+15)//16*16\n a=torch.zeros(E,M,H,device='cuda');a[se,loc]=hs[st]\n x=torch.bmm(a,gu);x.add_(gb[:,None]);g=x[...,::2].clamp(max=7);u=x[...,1::2].clamp(-7,7);y=(u+1)*(g*torch.sigmoid(g*1.702))\n z=torch.bmm(y,dp);z=z[se,loc];z.add_(db[se]);z.mul_(rw[st,se,None])\n br=torch.empty_like(z);br[o]=z;br=br.view(K,T,H).permute(1,0,2);so=torch.argsort(ri,1,stable=True);q=torch.gather(br,1,so[...,None].expand(-1,-1,H));out=q[:,0]+q[:,1];out.add_(q[:,2]);out.add_(q[:,3]);return out\nfor seed in range(2):\n torch.manual_seed(seed);d='cuda';T,H,I,E,K=128,2880,2880,8,4\n hs=torch.randn(T,H,device=d);ri=torch.randint(E,(T,K),device=d);rw=torch.softmax(torch.randn(T,E,device=d),-1)\n gu=torch.randn(E,H,2*I,device=d)*.02;gb=torch.zeros(E,2*I,device=d);dp=torch.randn(E,I,H,device=d)*.02;db=torch.zeros(E,H,device=d)\n a=reference.run(hs,ri,rw,gu,gb,dp,db);b=bmmrun(hs,ri,rw,gu,gb,dp,db);torch.cuda.synchronize();diff=(a-b).abs(); rel=diff/a.abs().clamp_min(1e-30)\n print(seed,'max',diff.max().item(),rel.max().item(),'eq',(diff==0).float().mean().item())\n for atol,rtol in [(3.4e-9,1.1920929e-7),(3.725e-8,1.6e-4),(1.86e-8,4.13e-5),(3.725e-8,1e-3)]:print(atol,rtol,(diff<=atol+rtol*a.abs()).float().mean().item())\n del hs,ri,rw,gu,gb,dp,db,a,b\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
