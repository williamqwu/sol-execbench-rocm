{"type":"item.started","item":{"id":"item_10","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch\nimport torch.nn.functional as F\n\ndef bench(fn, warm=5, iters=20):\n    for _ in range(warm): fn()\n    torch.cuda.synchronize()\n    a=torch.cuda.Event(True); b=torch.cuda.Event(True)\n    a.record()\n    for _ in range(iters): fn()\n    b.record(); b.synchronize()\n    return a.elapsed_time(b)/iters\n\nfor s in (256, 1024, 4096):\n    q=torch.randn((1,32,s,128),device='cuda',dtype=torch.bfloat16)\n    kb=torch.randn((1,8,s,128),device='cuda',dtype=torch.bfloat16)\n    vb=torch.randn((1,8,s,128),device='cuda',dtype=torch.bfloat16)\n    k=kb[:,:,None].expand(1,8,4,s,128).reshape(1,32,s,128)\n    v=vb[:,:,None].expand(1,8,4,s,128).reshape(1,32,s,128)\n    m=torch.randn((1,1,s,s),device='cuda',dtype=torch.bfloat16)\n    explicit=lambda: torch.matmul(F.softmax(torch.matmul(q,k.transpose(2,3))*(128**-0.5)+m,dim=-1,dtype=torch.float32).to(q.dtype),v)\n    sdpa=lambda: F.scaled_dot_product_attention(q,k,v,attn_mask=m,dropout_p=0.0,scale=128**-0.5)\n    gqa=lambda: F.scaled_dot_product_attention(q,kb,vb,attn_mask=m,dropout_p=0.0,scale=128**-0.5,enable_gqa=True)\n    print(s, 'explicit',bench(explicit),'sdpa32',bench(sdpa),'gqa',bench(gqa), flush=True)\n    del q,kb,vb,k,v,m\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
