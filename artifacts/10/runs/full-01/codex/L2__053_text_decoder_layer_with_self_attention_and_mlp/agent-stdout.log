{"type":"item.started","item":{"id":"item_39","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch\nimport torch.nn.functional as F\n\ndef bench(fn,n=100):\n for _ in range(10): y=fn()\n torch.cuda.synchronize(); a=torch.cuda.Event(True); z=torch.cuda.Event(True); a.record()\n for _ in range(n): y=fn()\n z.record(); z.synchronize(); return a.elapsed_time(z)/n,y\nfor b,s in ((1,256),(2,256),(1,1024),(1,4096)):\n q=torch.randn((b,32,s,128),device='cuda',dtype=torch.bfloat16)\n k=torch.randn((b,8,s,128),device='cuda',dtype=torch.bfloat16); v=torch.randn_like(k)\n m=torch.randn((b,1,s,s),device='cuda',dtype=torch.bfloat16)\n kr=k[:,:,None].expand(b,8,4,s,128).reshape(b,32,s,128); vr=v[:,:,None].expand(b,8,4,s,128).reshape(b,32,s,128)\n ref=lambda:F.scaled_dot_product_attention(q,kr,vr,attn_mask=m,dropout_p=0.0,scale=128**-0.5)\n qg=q.view(b,8,4,s,128); kg=k[:,:,None].expand(b,8,4,s,128); vg=v[:,:,None].expand(b,8,4,s,128)\n grouped=lambda:F.scaled_dot_product_attention(qg,kg,vg,attn_mask=m[:,None],dropout_p=0.0,scale=128**-0.5)\n try:\n  a,ya=bench(ref,30); c,yc=bench(grouped,30)\n  print((b,s),a,c,'max',(ya.view_as(yc).float()-yc.float()).abs().max().item(),flush=True)\n except Exception as e: print((b,s),'error',repr(e),flush=True)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
