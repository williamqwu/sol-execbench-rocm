{"type":"item.started","item":{"id":"item_15","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch\nimport torch.nn.functional as F\n\ndef bench(fn, warm=10, iters=50):\n    for _ in range(warm): y=fn()\n    torch.cuda.synchronize()\n    a=torch.cuda.Event(True); b=torch.cuda.Event(True)\n    a.record()\n    for _ in range(iters): y=fn()\n    b.record(); b.synchronize()\n    return a.elapsed_time(b)/iters, y\n\ndef rms(x,w):\n    xf=x.float(); return w*(xf*torch.rsqrt(xf.square().mean(-1,keepdim=True)+1e-5)).to(x.dtype)\n\ndef add_rms(x,r,w):\n    y=x+r\n    yf=y.float()\n    z=w*(yf*torch.rsqrt(yf.square().mean(-1,keepdim=True)+1e-5)).to(y.dtype)\n    return y,z\n\ndef swiglu(g,u): return F.silu(g)*u\n\ncrms=torch.compile(rms, fullgraph=True)\ncadd=torch.compile(add_rms, fullgraph=True)\ncswi=torch.compile(swiglu, fullgraph=True)\n\nx=torch.randn((1024,4096),device='cuda',dtype=torch.bfloat16)\nr=torch.randn_like(x); w=torch.randn((4096,),device='cuda',dtype=torch.bfloat16)\nfor name, eager, compiled in [('rms',lambda:rms(x,w),lambda:crms(x,w)),('add_rms',lambda:add_rms(x,r,w),lambda:cadd(x,r,w))]:\n    te,ye=bench(eager); tc,yc=bench(compiled)\n    if isinstance(ye,tuple):\n        diff=max((a.float()-b.float()).abs().max().item() for a,b in zip(ye,yc))\n    else: diff=(ye.float()-yc.float()).abs().max().item()\n    print(name,te,tc,'diff',diff,flush=True)\ng=torch.randn((1024,14336),device='cuda',dtype=torch.bfloat16); u=torch.randn_like(g)\nte,ye=bench(lambda:swiglu(g,u)); tc,yc=bench(lambda:cswi(g,u))\nprint('swiglu',te,tc,'diff',(ye.float()-yc.float()).abs().max().item(),flush=True)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
