{"type":"item.started","item":{"id":"item_17","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch\n\ndef rope(q,k,theta):\n    s=q.shape[2]\n    inv=1.0/(theta**(torch.arange(0,128,2,dtype=torch.float32,device=q.device)/128))\n    pos=torch.arange(s,device=q.device,dtype=torch.float32)\n    f=(inv[:,None]@pos[None,:]).T\n    e=torch.cat((f,f),-1); c=e.cos()[None,None]; si=e.sin()[None,None]\n    qr=torch.cat((-q[...,64:],q[...,:64]),-1); kr=torch.cat((-k[...,64:],k[...,:64]),-1)\n    return (q*c+qr*si).to(q.dtype),(k*c+kr*si).to(k.dtype)\ncr=torch.compile(rope,fullgraph=True,dynamic=True)\n\ndef bench(fn,args,n=100):\n    for _ in range(10): y=fn(*args)\n    torch.cuda.synchronize(); a=torch.cuda.Event(True); z=torch.cuda.Event(True); a.record()\n    for _ in range(n): y=fn(*args)\n    z.record(); z.synchronize(); return a.elapsed_time(z)/n,y\nfor b,s in ((1,131),(8,128),(1,1024),(1,4096)):\n    q=torch.randn((b,32,s,128),device='cuda',dtype=torch.bfloat16)\n    k=torch.randn((b,8,s,128),device='cuda',dtype=torch.bfloat16)\n    te,ye=bench(rope,(q,k,500000.0)); tc,yc=bench(cr,(q,k,500000.0))\n    dif=max((a.float()-z.float()).abs().max().item() for a,z in zip(ye,yc))\n    ratio=sum(torch.isclose(a,z,atol=1e-3,rtol=1e-3).float().mean().item() for a,z in zip(ye,yc))/2\n    print((b,s),te,tc,dif,ratio,flush=True)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
