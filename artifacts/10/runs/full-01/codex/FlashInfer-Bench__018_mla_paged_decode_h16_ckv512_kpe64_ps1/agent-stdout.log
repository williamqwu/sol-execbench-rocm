{"type":"item.started","item":{"id":"item_11","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport math, torch, aiter\nfrom aiter.mla import mla_decode_fwd_v4_nm\n\ntorch.manual_seed(1)\nd='cuda:0'; B=1; H=16; D=512; R=64; P=32; L=8\nq=torch.randn(B,H,D,device=d,dtype=torch.bfloat16)\nqr=torch.randn(B,H,R,device=d,dtype=torch.bfloat16)\nk=torch.randn(P,1,D,device=d,dtype=torch.bfloat16)\nkr=torch.randn(P,1,R,device=d,dtype=torch.bfloat16)\nidx=torch.randperm(P,device=d,dtype=torch.int64)[:L].to(torch.int32)\nki=torch.tensor([0,L],device=d,dtype=torch.int32)\nqi=torch.tensor([0,1],device=d,dtype=torch.int32)\no=torch.empty_like(q)\nsink=torch.full((H,),-float('inf'),device=d,dtype=torch.float32)\ntry:\n    logits,lse=mla_decode_fwd_v4_nm(q,qr,k,kr,o,qi,ki,idx,1,sink=sink,sm_scale=0.1352337747812271,num_kv_splits=1)\n    torch.cuda.synchronize()\n    print('shapes',o.shape,o.dtype,logits.shape,logits.dtype,lse.shape,lse.dtype)\n    pages=idx.long(); kc=k[:,0].float()[pages]; kp=kr[:,0].float()[pages]\n    scores=(q[0].float()@kc.T+qr[0].float()@kp.T)*0.1352337747812271\n    ro=(scores.softmax(-1)@kc).bfloat16()\n    re=torch.logsumexp(scores,-1)/math.log(2)\n    print('out max', (o[0].float()-ro.float()).abs().max().item(), 'ratio', torch.isclose(o[0].float(),ro.float(),atol=.006,rtol=.0078125).float().mean().item())\n    print('lse vals first',lse.flatten()[:8].tolist())\n    print('ref lse first',re[:8].tolist())\n    for transform in ('raw','divln2','mulln2'):\n      x=lse.reshape(-1)[:H]\n      if transform=='divln2': x=x/math.log(2)\n      if transform=='mulln2': x=x*math.log(2)\n      print(transform,(x-re).abs().max().item())\nexcept Exception as e:\n    import traceback; traceback.print_exc()\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
