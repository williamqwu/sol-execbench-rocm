{"type":"item.started","item":{"id":"item_31","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch\nimport kernel\n\ndef ref(im,co,w,b):\n x=torch.cat((im,co),1);return torch.matmul(torch.cat((x,x),-1),w.t())+b\n\ndef bench(fn,n=40):\n for _ in range(6):fn()\n torch.cuda.synchronize();v=[]\n for _ in range(n):\n  s=torch.cuda.Event(True);e=torch.cuda.Event(True);s.record();fn();e.record();e.synchronize();v.append(s.elapsed_time(e))\n return sorted(v)[n//2]\nk=2432\nfor shape in [(1,512,128),(1,1879,449),(4,1024,77),(1,8192,154),(64,128,77)]:\n b,i,c=shape;im=torch.rand((b,i,k),device='cuda');co=torch.rand((b,c,k),device='cuda');w=torch.rand((k,2*k),device='cuda');bias=torch.rand(k,device='cuda')\n r=ref(im,co,w,bias);oi,oc=kernel.run(im,co,w,bias);g=torch.cat((oi,oc),1);torch.cuda.synchronize()\n print(shape,'eq',torch.equal(r,g),'ref',bench(lambda:ref(im,co,w,bias)),'opt',bench(lambda:kernel.run(im,co,w,bias)))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
