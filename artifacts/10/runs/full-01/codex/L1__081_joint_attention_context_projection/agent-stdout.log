{"type":"item.started","item":{"id":"item_32","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport json,torch,triton\nimport kernel\n\ndef bench(fn,n=35):\n for _ in range(5):fn()\n torch.cuda.synchronize();v=[]\n for _ in range(n):\n  s=torch.cuda.Event(True);e=torch.cuda.Event(True);s.record();fn();e.record();e.synchronize();v.append(s.elapsed_time(e))\n return sorted(v)[n//2]\nk=2432; cfgs=[(256,2),(512,2),(512,4),(1024,4),(4096,4)]\nfor line in open('workload.jsonl'):\n a=json.loads(line)['axes'];b,i,c=a['batch_size'],a['image_seq_len'],a['context_seq_len'];rows=b*(i+c)\n im=torch.empty((b,i,k),device='cuda');co=torch.empty((b,c,k),device='cuda');out=torch.empty((rows,2*k),device='cuda')\n vals=[]\n for block,warps in cfgs:\n  fn=lambda block=block,warps=warps:kernel._pack_duplicated_kernel[(triton.cdiv(k,block),i+c,b)](im,co,out,image_seq_len=i,context_seq_len=c,inner_dim=k,BLOCK=block,num_warps=warps)\n  vals.append(bench(fn))\n best=min(range(len(vals)),key=vals.__getitem__)\n print(f'{b:2} {i:4} {c:3} rows={rows:5}:', ' '.join(f'{x:.4f}' for x in vals),'best',cfgs[best])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
