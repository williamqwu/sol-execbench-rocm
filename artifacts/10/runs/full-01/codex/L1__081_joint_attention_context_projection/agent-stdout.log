{"type":"item.started","item":{"id":"item_60","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch,triton,kernel\n\ndef run_cfg(im,co,w,bias,bl,nw):\n bs,i,k=im.shape;c=co.shape[1];rows=bs*(i+c);p=im.new_empty((rows,2*k))\n kernel._pack_duplicated_kernel[(triton.cdiv(k,bl),i+c,bs)](im,co,p,image_seq_len=i,context_seq_len=c,inner_dim=k,BLOCK=bl,num_warps=nw)\n y=torch._C._nn.linear(p,w,bias).view(bs,i+c,k);return y[:,:i],y[:,i:]\ndef bench(fn,n=60):\n for _ in range(8):fn()\n torch.cuda.synchronize();v=[]\n for _ in range(n):\n  s=torch.cuda.Event(True);e=torch.cuda.Event(True);s.record();fn();e.record();e.synchronize();v.append(s.elapsed_time(e))\n v.sort();return v[n//2],sum(v[n//4:3*n//4])/(n//2)\nk=2432\nfor bs,i,c in [(8,1571,154),(64,128,77),(1,512,128)]:\n im=torch.rand((bs,i,k),device='cuda');co=torch.rand((bs,c,k),device='cuda');w=torch.rand((k,2*k),device='cuda');bias=torch.rand(k,device='cuda')\n print((bs,i,c))\n for cfg in [(128,1),(256,2),(512,2),(1024,4),(4096,4)]:print(cfg,bench(lambda cfg=cfg:run_cfg(im,co,w,bias,*cfg)))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
