{"type":"item.started","item":{"id":"item_7","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch\nimport torch.nn.functional as F\nprint(torch.__version__, torch.version.hip)\nfor s in (131, 512, 2048):\n    torch.manual_seed(1)\n    q=torch.randn((1,32,s,128),device='cuda',dtype=torch.float32)*0.02\n    k=torch.randn((1,8,s,128),device='cuda',dtype=torch.float32)*0.02\n    v=torch.randn((1,8,s,128),device='cuda',dtype=torch.float32)*0.02\n    m=torch.randn((1,1,s,s),device='cuda',dtype=torch.float32)*0.02\n    kr=k[:,:,None].expand(1,8,4,s,128).reshape(1,32,s,128)\n    vr=v[:,:,None].expand(1,8,4,s,128).reshape(1,32,s,128)\n    ref=torch.softmax(torch.matmul(q,kr.transpose(2,3))*(128**-0.5)+m,dim=-1,dtype=torch.float32)\n    ref=torch.matmul(ref,vr)\n    try:\n        out=F.scaled_dot_product_attention(q,k,v,attn_mask=m,dropout_p=0.0,scale=128**-0.5,enable_gqa=True)\n        d=(out-ref).abs()\n        rel=d/ref.abs().clamp_min(1e-30)\n        ok=((d<=1.4e-7)|(rel<=1.1921e-7)).float().mean()\n        print(s, d.max().item(), rel.max().item(), ok.item())\n    except Exception as e:\n        print(s,type(e).__name__,str(e)[:500])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
