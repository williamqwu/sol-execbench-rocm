{"type":"item.started","item":{"id":"item_36","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch\nimport torch.nn.functional as F\n\ndef ref(q,k,v,m,B,S):\n kr=k[:,:,None].expand(B,8,4,S,128).reshape(B,32,S,128);vr=v[:,:,None].expand(B,8,4,S,128).reshape(B,32,S,128)\n a=torch.matmul(q,kr.transpose(2,3))*(128**-.5);a=F.softmax(a+m,-1,dtype=torch.float32);return torch.matmul(a,vr)\ndef grp(q,k,v,m,B,S):\n a=torch.matmul(q.view(B,8,4,S,128),k[:,:,None].transpose(-2,-1))*(128**-.5);a=F.softmax(a+m[:,None],-1,dtype=torch.float32);return torch.matmul(a,v[:,:,None]).reshape(B,32,S,128)\ndef bench(fn,n=10):\n for _ in range(2):y=fn()\n torch.cuda.synchronize();a=torch.cuda.Event(True);b=torch.cuda.Event(True);a.record()\n for _ in range(n):y=fn()\n b.record();b.synchronize();return a.elapsed_time(b)/n\nfor B,S in ((1,131),(4,128),(2,1024),(2,2048),(1,4096)):\n q=torch.randn((B,32,S,128),device='cuda')*.01;k=torch.randn((B,8,S,128),device='cuda')*.01;v=torch.randn_like(k);m=torch.randn((B,1,S,S),device='cuda')*.01\n print(B,S,bench(lambda:ref(q,k,v,m,B,S),3),bench(lambda:grp(q,k,v,m,B,S),3))\n del q,k,v,m\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
