{"type":"item.started","item":{"id":"item_35","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch,triton\nfrom kernel import _rope_qk_kernel\n\ndef eager(q,k,c,s,B,S):\n q=q.view(B,S,32,128).transpose(1,2);k=k.view(B,S,8,128).transpose(1,2);c=c[:,None];s=s[:,None]\n q1=q[...,:64];q2=q[...,64:]; qo=q*c+torch.cat((-q2,q1),-1)*s\n k1=k[...,:64];k2=k[...,64:]; ko=k*c+torch.cat((-k2,k1),-1)*s\n return qo,ko\n\ndef bench(fn,n=20):\n for _ in range(3): y=fn()\n torch.cuda.synchronize();a=torch.cuda.Event(True);b=torch.cuda.Event(True);a.record()\n for _ in range(n):y=fn()\n b.record();b.synchronize();return a.elapsed_time(b)/n\nfor B,S in ((1,131),(2,1024),(32,256),(2,8192)):\n torch.manual_seed(8);q=torch.randn((B,S,4096),device='cuda')*.1;k=torch.randn((B,S,1024),device='cuda')*.1;c=torch.randn((B,S,128),device='cuda')*.1;s=torch.randn_like(c)\n qr,kr=eager(q,k,c,s,B,S);qg=q.clone();kg=k.clone();T=B*S;qp=T*32*64;kp=T*8*64\n launch=lambda:_rope_qk_kernel[(triton.cdiv(qp,256),)](qg,kg,c,s,qp,kp,BLOCK=256,num_warps=4,enable_fp_fusion=False)\n launch();qv=qg.view(B,S,32,128).transpose(1,2);kv=kg.view(B,S,8,128).transpose(1,2)\n print(B,S,torch.equal(qr,qv),torch.equal(kr,kv),'eager',bench(lambda:eager(q,k,c,s,B,S),5),'tri',bench(launch,5))\n del q,k,c,s,qr,kr,qg,kg,qv,kv\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
