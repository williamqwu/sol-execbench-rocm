{"type":"item.started","item":{"id":"item_39","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch,triton\nfrom kernel import _fused_key_value_grads\n\ndef evt(fn,n=50):\n for _ in range(4):fn()\n torch.cuda.synchronize();a=torch.cuda.Event(True);z=torch.cuda.Event(True);a.record()\n for _ in range(n):fn()\n z.record();z.synchronize();return a.elapsed_time(z)/n\nfor b,s in [(1,128),(2,128),(16,128),(1,131)]:\n h=32;d=128;ds=torch.randn((b,h,s,s),device='cuda',dtype=torch.bfloat16);a=torch.randn_like(ds);q=torch.randn((b,h,s,d),device='cuda',dtype=torch.bfloat16);raw=torch.randn((b,s,h,d),device='cuda',dtype=torch.bfloat16);do=raw.transpose(1,2);dk=torch.empty_like(q);dv=torch.empty_like(q)\n vals=[]\n for bm,bn,w in [(16,32,2),(16,32,4),(32,32,4),(32,64,4)]:\n  def fused(bm=bm,bn=bn,w=w):_fused_key_value_grads[(triton.cdiv(s,bm),b*h)](ds,q,a,do,dk,dv,N_CTX=s,BLOCK_M=bm,BLOCK_N=bn,HEAD_DIM=128,num_warps=w)\n  vals.append(((bm,bn,w),evt(fused)))\n def old():\n  x=torch.matmul(ds.transpose(2,3),q);y=torch.matmul(a.transpose(2,3),do);return x,y\n vals.append(('old',evt(old)))\n print('B,S',b,s,[(x,round(y,5)) for x,y in vals])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
