{"type":"item.started","item":{"id":"item_25","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch, triton\nfrom kernel import _fused_scores_query\nfor s in [128,131,512]:\n b=1; h=32; d=128; scale=0.08838834764831845\n base=torch.randn((b,s,h,d),device='cuda',dtype=torch.bfloat16)\n do=base.transpose(1,2)\n v=torch.randn((b,h,s,d),device='cuda',dtype=torch.bfloat16)\n k=torch.randn_like(v)\n a=torch.randn((b,h,s,s),device='cuda',dtype=torch.bfloat16)\n ds=torch.empty_like(a); dq=torch.empty_like(v)\n _fused_scores_query[(triton.cdiv(s,16),b*h)](do,v,a,k,ds,dq,N_CTX=s,SCALE=scale,BLOCK_M=16,BLOCK_N=32,HEAD_DIM=128,num_warps=4)\n ga=torch.matmul(do,v.transpose(2,3))\n af=a.float(); gf=ga.float(); corr=(af*gf).sum(-1,keepdim=True)\n dsr=(af*(gf-corr)).to(torch.bfloat16)*scale\n dqr=torch.matmul(dsr,k)\n torch.cuda.synchronize()\n for name,x,y in [('ds',ds,dsr),('dq',dq,dqr)]:\n   diff=(x.float()-y.float()).abs(); tol=0.08+0.0078125*y.float().abs()\n   print(s,name,'max',diff.max().item(),'ratio',(diff<=tol).float().mean().item(),'eq',(x==y).float().mean().item())\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
