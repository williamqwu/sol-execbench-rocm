{"type":"item.started","item":{"id":"item_17","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch\n\ntorch.manual_seed(0)\ndevice='cuda'\nq_w=torch.randn((4096,5120),device=device,dtype=torch.bfloat16)\nk_w=torch.randn((1024,5120),device=device,dtype=torch.bfloat16)\nv_w=torch.randn((1024,5120),device=device,dtype=torch.bfloat16)\n\ndef bench(fn, n=30):\n    for _ in range(5):\n        y=fn()\n    torch.cuda.synchronize()\n    a=torch.cuda.Event(enable_timing=True); b=torch.cuda.Event(enable_timing=True)\n    a.record()\n    for _ in range(n): y=fn()\n    b.record(); b.synchronize()\n    return a.elapsed_time(b)/n\n\nfor m in [128, 512, 2048, 4096]:\n    p=torch.randn((m,6144),device=device,dtype=torch.bfloat16)\n    def separate():\n        return p[:,:4096]@q_w + p[:,4096:5120]@k_w + p[:,5120:]@v_w\n    def addmms():\n        x=p[:,:4096]@q_w\n        x=torch.addmm(x,p[:,4096:5120],k_w)\n        return torch.addmm(x,p[:,5120:],v_w)\n    def kvcat():\n        w=torch.cat((k_w,v_w),dim=0)\n        return p[:,:4096]@q_w + p[:,4096:]@w\n    def allcat():\n        w=torch.cat((q_w,k_w,v_w),dim=0)\n        return p@w\n    vals=[('separate',separate),('addmm',addmms),('kvcat',kvcat),('allcat',allcat)]\n    print('M',m,[(name,round(bench(fn),4)) for name,fn in vals])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
