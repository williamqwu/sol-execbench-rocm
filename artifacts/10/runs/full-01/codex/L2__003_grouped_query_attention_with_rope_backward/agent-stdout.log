{"type":"item.started","item":{"id":"item_27","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch,triton\nfrom kernel import _fused_scores_query,_softmax_backward_scale\n\ndef evt(fn,n=40):\n for _ in range(3):fn()\n torch.cuda.synchronize();x=torch.cuda.Event(True);y=torch.cuda.Event(True);x.record()\n for _ in range(n):fn()\n y.record();y.synchronize();return x.elapsed_time(y)/n\nfor s in [128,131,256,293,384,449]:\n b=1;h=32;d=128\n raw=torch.randn((b,s,h,d),device='cuda',dtype=torch.bfloat16);do=raw.transpose(1,2)\n v=torch.randn((b,h,s,d),device='cuda',dtype=torch.bfloat16);k=torch.randn_like(v);a=torch.randn((b,h,s,s),device='cuda',dtype=torch.bfloat16)\n ds=torch.empty_like(a);dq=torch.empty_like(v)\n vals=[]\n for bm,bn,w in [(16,32,2),(32,32,4),(32,64,4)]:\n  def fused(bm=bm,bn=bn,w=w):_fused_scores_query[(triton.cdiv(s,bm),b*h)](do,v,a,k,ds,dq,N_CTX=s,SCALE=.08838834764831845,BLOCK_M=bm,BLOCK_N=bn,HEAD_DIM=128,num_warps=w)\n  vals.append(((bm,bn,w),evt(fused)))\n def old():\n  ga=torch.matmul(do,v.transpose(2,3));block=triton.next_power_of_2(s)\n  _softmax_backward_scale[(b*h*s,)](ga,a,ds,N_COLS=s,SCALE=.08838834764831845,BLOCK=block,num_warps=2 if s>128 else 1)\n  torch.matmul(ds,k,out=dq)\n vals.append(('old',evt(old)))\n print(s,[(x,round(y,4)) for x,y in vals])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
