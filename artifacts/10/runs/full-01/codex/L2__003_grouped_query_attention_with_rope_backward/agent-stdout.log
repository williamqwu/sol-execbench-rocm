{"type":"item.started","item":{"id":"item_26","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch,triton\nfrom kernel import _fused_scores_query\n\ndef bench(s,bm,bn,w,n=30):\n b=1;h=32;d=128\n raw=torch.randn((b,s,h,d),device='cuda',dtype=torch.bfloat16); do=raw.transpose(1,2)\n v=torch.randn((b,h,s,d),device='cuda',dtype=torch.bfloat16); k=torch.randn_like(v)\n a=torch.randn((b,h,s,s),device='cuda',dtype=torch.bfloat16); ds=torch.empty_like(a);dq=torch.empty_like(v)\n def fn(): _fused_scores_query[(triton.cdiv(s,bm),b*h)](do,v,a,k,ds,dq,N_CTX=s,SCALE=0.08838834764831845,BLOCK_M=bm,BLOCK_N=bn,HEAD_DIM=128,num_warps=w)\n for _ in range(3):fn()\n torch.cuda.synchronize();st=torch.cuda.Event(True);en=torch.cuda.Event(True);st.record()\n for _ in range(n):fn()\n en.record();en.synchronize();return st.elapsed_time(en)/n\nfor s in [128,512,1024,2048]:\n vals=[]\n for cfg in [(16,32,2),(16,32,4),(16,64,4),(32,32,4),(32,64,4),(32,64,8)]:\n  try: vals.append((cfg,round(bench(s,*cfg,n=20 if s>=1024 else 30),4)))\n  except Exception as e: vals.append((cfg,type(e).__name__+':'+str(e)[:50]))\n print('S',s,vals)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
