{"type":"item.started","item":{"id":"item_22","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch,triton\nimport kernel\nshapes=[(2,128),(32,128),(64,128),(1,256),(8,256),(16,256),(32,256),(2,293),(1,512),(8,512),(32,512),(1,1024),(16,1024),(1,2048),(4,2048),(4,4096)]\nfor b,l in shapes:\n u=torch.randn((b,768,l),device='cuda');w=torch.randn((768,1,3),device='cuda');bias=torch.randn(768,device='cuda')\n outs=[torch.empty((b,256,l),device='cuda') for _ in range(3)]\n block=triton.next_power_of_2(l)\n vals=[]\n for nw in [1,2,4,8]:\n  if nw*64>block*2 and nw>2: pass\n  def go(nw=nw):\n   kernel._hyena_short_conv_kernel[(b*256,)](u,w,bias,*outs,seq_len=l,BLOCK=block,num_warps=nw)\n  try: vals.append((nw,triton.testing.do_bench(go,warmup=20,rep=200)))\n  except Exception as e: vals.append((nw,str(e).splitlines()[-1]))\n print(f'{b:2d}x{l:4d} block{block:4d}',vals)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
