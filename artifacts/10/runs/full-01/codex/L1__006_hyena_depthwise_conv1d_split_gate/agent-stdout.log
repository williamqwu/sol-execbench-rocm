{"type":"item.started","item":{"id":"item_12","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch\nimport torch.nn.functional as F\nb,l,c=1,293,64; torch.manual_seed(321)\nuall=torch.randn((b,768,l),device='cuda'); wall=torch.randn((768,1,3),device='cuda'); ball=torch.randn(768,device='cuda')\nref=F.conv1d(uall,wall,ball,padding=2,groups=768)[...,:l][:,:c]\nu=uall[:,:c];w=wall[:c];bias=ball[:c]\npad=torch.cat((torch.zeros((b,c,2),device='cuda'),u),-1); a=[pad[...,i:i+l] for i in range(3)]; ww=[w[:,0,i][None,:,None] for i in range(3)]\n# Terms: 0=bias, 1..3=products. Each candidate is (expression, value).\nvals={1:[('b',bias[None,:,None].expand_as(ref))]}\nfor i in range(3): vals[1<<(i+1)]=[(f'p{i}',a[i]*ww[i])]\nfor size in range(2,5):\n for mask in range(1,16):\n  if mask.bit_count()\"'!=size: continue\n  out=[]\n  # Canonical unordered binary partitions.\n  sub=(mask-1)&mask\n  while sub:\n   other=mask''^sub\n   if sub < other:\n    for na,va in vals[sub]:\n     for nb,vb in vals[other]:\n      out.append((f'\"'({na}+{nb})',va+vb))\n   sub=(sub-1)&mask\n  # A product singleton can be fused into any expression for the remainder.\n  for i in range(3):\n   bit=1<<(i+1)\n   if mask&bit:\n    rest=mask\"'^bit\n    if rest:\n     for nr,vr in vals[rest]:\n      out.append((f'\"'f{i}({nr})',torch.addcmul(vr,a[i],ww[i])))\n  vals[mask]=out\nfull=vals[15]\nprint('candidates',len(full))\nbest=[]\nfor name,y in full:\n d=(y-ref).abs(); ex=d.eq(0).float().mean().item(); close=torch.isclose(y,ref,atol=1.982e-7,rtol=1.1920928955078125e-7).float().mean().item()\n best.append((ex,close,d.max().item(),name))\nfor row in sorted(best,reverse=True)[:30]: print(f'exact={row[0]:.6f} close={row[1]:.6f} max={row[2]:.3g} {row[3]}')\n# Exact union over all candidates in chunks\nunion=torch.zeros_like(ref,dtype=torch.bool)\nfor _,y in full: union |= y.eq(ref)\nprint('union exact',union.float().mean().item())\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
