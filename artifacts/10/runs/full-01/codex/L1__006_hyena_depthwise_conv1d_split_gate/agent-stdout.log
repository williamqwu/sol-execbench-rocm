{"type":"item.started","item":{"id":"item_10","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport itertools, torch\nimport torch.nn.functional as F\nb,l=2,293; torch.manual_seed(123)\nu=torch.randn((b,768,l),device='cuda');w=torch.randn((768,1,3),device='cuda');bias=torch.randn(768,device='cuda')\nref=F.conv1d(u,w,bias,padding=2,groups=768)[...,:l]\npad=torch.cat((torch.zeros((b,768,2),device='cuda'),u),-1);a=[pad[...,i:i+l] for i in range(3)];ww=[w[:,0,i][None,:,None] for i in range(3)]\ncands=[]; names=[]\nfor kind in ['first','last']:\n for p in itertools.permutations(range(3)):\n  if kind=='first':\n   y=bias[None,:,None].expand_as(ref)\n   for k in p:y=torch.addcmul(y,a[k],ww[k])\n  else:\n   y=a[p[0]]*ww[p[0]]\n   for k in p[1:]:y=torch.addcmul(y,a[k],ww[k])\n   y=y+bias[None,:,None]\n  cands.append(y);names.append(kind+''.join(map(str,p)))\ncs=torch.stack(cands)\neq=cs.eq(ref)\nprint('union exact',eq.any(0).float().mean().item())\n# Assign first exact candidate and report counts\nfor n,e in zip(names,eq): print(n,e.float().mean().item())\nprint('by t mod patterns union/exact candidates')\nfor m in range(8):\n sl=eq[...,m::8]\n print('tmod8',m,'union',sl.any(0).float().mean().item(), 'best',names[sl.float().mean((1,2,3)).argmax()],sl.float().mean((1,2,3)).max().item())\nprint('channel mod8 union')\nfor m in range(8):\n sl=eq[:,:,m::8,:]\n print(m,sl.any(0).float().mean().item(),names[sl.float().mean((1,2,3)).argmax()],sl.float().mean((1,2,3)).max().item())\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
