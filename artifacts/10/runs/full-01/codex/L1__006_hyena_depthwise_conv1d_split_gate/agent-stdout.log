{"type":"item.started","item":{"id":"item_27","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch,triton\nimport kernel,reference\nshapes=[(1,512),(4,2048),(64,128),(1,1024),(4,4096),(32,256),(32,512),(1,2048),(16,1024),(2,293),(32,128),(8,512),(16,256),(1,256),(8,256),(2,128)]\nfor i,(b,l) in enumerate(shapes):\n torch.manual_seed(1000+i);u=torch.randn((b,768,l),device='cuda');w=torch.randn((768,1,3),device='cuda');bias=torch.randn(768,device='cuda')\n got=kernel.run(u,w,bias);ref=reference.run(u,w,bias);torch.cuda.synchronize();tol=dict(atol=1.969e-7,rtol=1.1920928955078125e-7)\n rates=[torch.isclose(a,z,**tol).float().mean().item() for a,z in zip(got,ref)]\n ms=triton.testing.do_bench(lambda:kernel.run(u,w,bias),warmup=20,rep=100)\n print(f'{i:2d} {b:2d}x{l:4d} agg={sum(rates)/3:.6f} parts={[round(x,6) for x in rates]} ms={ms:.5f}')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
