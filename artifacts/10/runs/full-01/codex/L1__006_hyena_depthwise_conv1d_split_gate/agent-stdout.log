{"type":"item.started","item":{"id":"item_24","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch,triton\nimport kernel\nshapes=[(64,128),(32,256),(32,512),(16,1024),(4,2048),(4,4096),(1,2048),(1,512),(2,293)]\nconfigs=[(64,1),(64,2),(128,1),(128,2),(128,4),(256,2),(256,4),(256,8),(512,4),(512,8),(1024,4),(1024,8),(2048,8),(4096,8)]\nfor b,l in shapes:\n u=torch.randn((b,768,l),device='cuda');w=torch.randn((768,1,3),device='cuda');bias=torch.randn(768,device='cuda');outs=[torch.empty((b,256,l),device='cuda') for _ in range(3)]\n vals=[]\n for block,nw in configs:\n  if block>triton.next_power_of_2(l): continue\n  def go(block=block,nw=nw): kernel._hyena_short_conv_kernel[(b*256,triton.cdiv(l,block))](u,w,bias,*outs,seq_len=l,BLOCK=block,num_warps=nw)\n  try: vals.append((triton.testing.do_bench(go,warmup=20,rep=200),block,nw))\n  except Exception as e: vals.append((999,block,nw))\n vals.sort()\n print(f'{b:2d}x{l:4d}',[(round(x,5),bl,nw) for x,bl,nw in vals])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
