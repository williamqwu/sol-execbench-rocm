{"type":"item.started","item":{"id":"item_9","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport itertools, torch\nimport torch.nn.functional as F\nfor b,l in [(2,293),(1,512),(4,2048)]:\n torch.manual_seed(123)\n u=torch.randn((b,768,l),device='cuda',dtype=torch.float32); w=torch.randn((768,1,3),device='cuda'); bias=torch.randn((768,),device='cuda')\n ref=F.conv1d(u,w,bias,padding=2,groups=768)[...,:l]\n rg=ref[:,512:]*ref[:,:256]\n z=torch.zeros((b,768,2),device='cuda'); pad=torch.cat((z,u),-1); a=[pad[...,i:i+l] for i in range(3)]; ww=[w[:,0,i][None,:,None] for i in range(3)]\n tol=dict(atol=1.982e-7,rtol=1.1920928955078125e-7)\n def evaluate(kind,perm):\n  if kind=='first':\n   y=bias[None,:,None].expand_as(ref)\n   for k in perm:y=torch.addcmul(y,a[k],ww[k])\n  else:\n   y=a[perm[0]]*ww[perm[0]]\n   for k in perm[1:]:y=torch.addcmul(y,a[k],ww[k])\n   y=y+bias[None,:,None]\n  g=y[:,512:]*y[:,:256]\n  cs=[torch.isclose(g,rg,**tol).float().mean(),torch.isclose(y[:,:256],ref[:,:256],**tol).float().mean(),torch.isclose(y[:,256:512],ref[:,256:512],**tol).float().mean()]\n  return [x.item() for x in cs]+[torch.stack(cs).mean().item()]\n print('\\\\nshape',b,l)\n for kind in ['first','last']:\n  for p in itertools.permutations(range(3)):\n   q=evaluate(kind,p)\n   print(kind,''.join(map(str,p)),*(f'{x:.6f}' for x in q))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
