{"type":"item.started","item":{"id":"item_8","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport itertools, torch\nimport torch.nn.functional as F\nb,l=2,293\ntorch.manual_seed(123)\nu=torch.randn((b,768,l),device='cuda',dtype=torch.float32)\nw=torch.randn((768,1,3),device='cuda',dtype=torch.float32)\nbias=torch.randn((768,),device='cuda',dtype=torch.float32)\nref=F.conv1d(u,w,bias,padding=2,groups=768)[...,:l]\nz=torch.zeros((b,768,2),device='cuda')\npad=torch.cat((z,u),dim=-1)\na=[pad[...,i:i+l] for i in range(3)]\nww=[w[:,0,i][None,:,None] for i in range(3)]\ntol=dict(atol=1.982e-7,rtol=1.1920928955078125e-7)\ndef score(name,y):\n d=(y-ref).abs(); ok=torch.isclose(y,ref,**tol)\n print(f'{name:24s} exact={d.eq(0).float().mean().item():.6f} close={ok.float().mean().item():.6f} max={d.max().item():.3g}')\nscore('reference',ref)\nfor perm in itertools.permutations(range(3)):\n    # fma chain initialized from bias\n    y=bias[None,:,None].expand_as(ref)\n    for k in perm: y=torch.addcmul(y,a[k],ww[k])\n    score('b first '+''.join(map(str,perm)),y)\nfor perm in itertools.permutations(range(3)):\n    y=a[perm[0]]*ww[perm[0]]\n    for k in perm[1:]: y=torch.addcmul(y,a[k],ww[k])\n    y=y+bias[None,:,None]\n    score('b last '+''.join(map(str,perm)),y)\n# all multiplies separately, different sums\np=[a[k]*ww[k] for k in range(3)]\nfor perm in itertools.permutations(range(3)):\n    y=((p[perm[0]]+p[perm[1]])+p[perm[2]])+bias[None,:,None]\n    score('sep last '+''.join(map(str,perm)),y)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
