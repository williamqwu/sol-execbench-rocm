{"type":"item.started","item":{"id":"item_31","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch,triton\nimport kernel\nfor b,l in [(64,128),(32,256),(32,512),(16,1024),(4,2048),(4,4096),(1,2048)]:\n u=torch.randn((b,768,l),device='cuda');w=torch.randn((768,1,3),device='cuda');bias=torch.randn(768,device='cuda');outs=[torch.empty((b,256,l),device='cuda') for _ in range(3)]\n block=min(256,triton.next_power_of_2(l));nw=2 if block<=128 else 4; vals=[]\n for wpe in [None,1,2,3,4,5,6,8]:\n  kw={} if wpe is None else {'waves_per_eu':wpe}\n  def go(kw=kw):kernel._hyena_short_conv_kernel[(b*256,triton.cdiv(l,block))](u,w,bias,*outs,seq_len=l,BLOCK=block,num_warps=nw,**kw)\n  try: vals.append((wpe,triton.testing.do_bench(go,warmup=20,rep=300)))\n  except Exception as e: vals.append((wpe,'ERR '+str(e).splitlines()[-1]))\n print(b,l,vals)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
