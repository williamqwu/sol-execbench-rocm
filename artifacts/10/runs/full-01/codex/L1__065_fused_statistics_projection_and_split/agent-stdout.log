{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' definition.json && printf '\\\\n--- reference.py ---\\\\n' && sed -n '1,320p' reference.py && printf '\\\\n--- workload.jsonl ---\\\\n' && sed -n '1,240p' workload.jsonl\"","aggregated_output":"{\n  \"name\": \"065_fused_statistics_projection_and_split\",\n  \"description\": \"Fused Conv1d projection to 2x channels followed by channel-wise split into mean and log-variance statistics. Performs a single Conv1d with output channels = 2*out_channels, then splits the result along the channel dimension into separate mean and logs tensors.\",\n  \"hf_id\": \"myshell-ai/OpenVoice\",\n  \"custom_inputs_entrypoint\": null,\n  \"axes\": {\n    \"batch_size\": {\n      \"type\": \"var\",\n      \"description\": \"Batch size\"\n    },\n    \"time\": {\n      \"type\": \"var\",\n      \"description\": \"Temporal/sequence dimension\"\n    },\n    \"in_channels\": {\n      \"type\": \"const\",\n      \"value\": 192,\n      \"description\": \"Number of input channels\"\n    },\n    \"out_channels\": {\n      \"type\": \"const\",\n      \"value\": 192,\n      \"description\": \"Number of output channels for each of mean and logs\"\n    },\n    \"kernel_size\": {\n      \"type\": \"const\",\n      \"value\": 1,\n      \"description\": \"Convolution kernel size\"\n    },\n    \"out_channels_2\": {\n      \"type\": \"expr\",\n      \"expression\": \"out_channels * 2\",\n      \"description\": \"Total output channels before split\"\n    }\n  },\n  \"inputs\": {\n    \"x\": {\n      \"shape\": [\n        \"batch_size\",\n        \"in_channels\",\n        \"time\"\n      ],\n      \"dtype\": \"float32\",\n      \"description\": \"Input tensor\"\n    },\n    \"weight\": {\n      \"shape\": [\n        \"out_channels_2\",\n        \"in_channels\",\n        \"kernel_size\"\n      ],\n      \"dtype\": \"float32\",\n      \"description\": \"Conv1d weight tensor projecting to 2x channels\"\n    },\n    \"bias\": {\n      \"shape\": [\n        \"out_channels_2\"\n      ],\n      \"dtype\": \"float32\",\n      \"description\": \"Conv1d bias tensor\"\n    }\n  },\n  \"outputs\": {\n    \"mean\": {\n      \"shape\": [\n        \"batch_size\",\n        \"out_channels\",\n        \"time\"\n      ],\n      \"dtype\": \"float32\",\n      \"description\": \"Mean statistics\"\n    },\n    \"logs\": {\n      \"shape\": [\n        \"batch_size\",\n        \"out_channels\",\n        \"time\"\n      ],\n      \"dtype\": \"float32\",\n      \"description\": \"Log-variance statistics\"\n    }\n  },\n  \"reference\": \"import torch\\nimport torch.nn.functional as F\\n\\n@torch.no_grad()\\ndef run(x: torch.Tensor, weight: torch.Tensor, bias: torch.Tensor):\\n    \\\"\\\"\\\"\\n    Fused Conv1d projection and split.\\n    \\n    Args:\\n        x: Input tensor of shape [batch_size, in_channels, time]\\n        weight: Conv1d weight of shape [out_channels*2, in_channels, kernel_size]\\n        bias: Conv1d bias of shape [out_channels*2]\\n    \\n    Returns:\\n        mean: Mean statistics of shape [batch_size, out_channels, time]\\n        logs: Log-variance statistics of shape [batch_size, out_channels, time]\\n    \\\"\\\"\\\"\\n    # Perform Conv1d projection to 2x channels\\n    # For kernel_size=1, no padding needed\\n    # Shape: [batch_size, out_channels*2, time]\\n    stats = F.conv1d(x, weight, bias, padding=0)\\n    \\n    # Split along channel dimension into mean and logs\\n    out_channels = weight.shape[0] // 2\\n    mean, logs = torch.split(stats, out_channels, dim=1)\\n    \\n    return mean, logs\\n\"\n}\n\n--- reference.py ---\nimport torch\nimport torch.nn.functional as F\n\n@torch.no_grad()\ndef run(x: torch.Tensor, weight: torch.Tensor, bias: torch.Tensor):\n    \"\"\"\n    Fused Conv1d projection and split.\n    \n    Args:\n        x: Input tensor of shape [batch_size, in_channels, time]\n        weight: Conv1d weight of shape [out_channels*2, in_channels, kernel_size]\n        bias: Conv1d bias of shape [out_channels*2]\n    \n    Returns:\n        mean: Mean statistics of shape [batch_size, out_channels, time]\n        logs: Log-variance statistics of shape [batch_size, out_channels, time]\n    \"\"\"\n    # Perform Conv1d projection to 2x channels\n    # For kernel_size=1, no padding needed\n    # Shape: [batch_size, out_channels*2, time]\n    stats = F.conv1d(x, weight, bias, padding=0)\n    \n    # Split along channel dimension into mean and logs\n    out_channels = weight.shape[0] // 2\n    mean, logs = torch.split(stats, out_channels, dim=1)\n    \n    return mean, logs\n\n--- workload.jsonl ---\n{\"uuid\": \"a4e6d004-4532-5fb8-a7d9-7da221435103\", \"axes\": {\"batch_size\": 8, \"time\": 1571}, \"inputs\": {\"x\": {\"type\": \"random\"}, \"weight\": {\"type\": \"random\"}, \"bias\": {\"type\": \"random\"}}, \"tolerance\": {\"max_atol\": 1.6546497702681237e-06, \"max_rtol\": 1.1920928955078125e-07, \"required_matched_ratio\": 0.99, \"_provenance\": \"max run-to-run error over 10 seeds x 1.25 margin, floored at torch.float32 epsilon\"}}\n{\"uuid\": \"2f360ba1-9ad6-51da-af69-1f7ab37cbcc2\", \"axes\": {\"batch_size\": 4, \"time\": 293}, \"inputs\": {\"x\": {\"type\": \"random\"}, \"weight\": {\"type\": \"random\"}, \"bias\": {\"type\": \"random\"}}, \"tolerance\": {\"max_atol\": 1.6540579448287126e-06, \"max_rtol\": 1.1920928955078125e-07, \"required_matched_ratio\": 0.99, \"_provenance\": \"max run-to-run error over 10 seeds x 1.25 margin, floored at torch.float32 epsilon\"}}\n{\"uuid\": \"a0bc6363-a663-56ee-a8ab-d8e1ab5e35fc\", \"axes\": {\"batch_size\": 16, \"time\": 2048}, \"inputs\": {\"x\": {\"type\": \"random\"}, \"weight\": {\"type\": \"random\"}, \"bias\": {\"type\": \"random\"}}, \"tolerance\": {\"max_atol\": 1.656129036310521e-06, \"max_rtol\": 1.1920928955078125e-07, \"required_matched_ratio\": 0.99, \"_provenance\": \"max run-to-run error over 10 seeds x 1.25 margin, floored at torch.float32 epsilon\"}}\n{\"uuid\": \"6525b887-7a87-5ff1-9f6f-48e6129f44da\", \"axes\": {\"batch_size\": 2, \"time\": 211}, \"inputs\": {\"x\": {\"type\": \"random\"}, \"weight\": {\"type\": \"random\"}, \"bias\": {\"type\": \"random\"}}, \"tolerance\": {\"max_atol\": 1.65267641504263e-06, \"max_rtol\": 1.1920928955078125e-07, \"required_matched_ratio\": 0.99, \"_provenance\": \"max run-to-run error over 10 seeds x 1.25 margin, floored at torch.float32 epsilon\"}}\n{\"uuid\": \"59d61bc4-1242-5a29-b23f-a648ea97cdc4\", \"axes\": {\"batch_size\": 16, \"time\": 449}, \"inputs\": {\"x\": {\"type\": \"random\"}, \"weight\": {\"type\": \"random\"}, \"bias\": {\"type\": \"random\"}}, \"tolerance\": {\"max_atol\": 1.6561600701882373e-06, \"max_rtol\": 1.1920928955078125e-07, \"required_matched_ratio\": 0.99, \"_provenance\": \"max run-to-run error over 10 seeds x 1.25 margin, floored at torch.float32 epsilon\"}}\n{\"uuid\": \"c9d57e46-1790-51c9-aa8c-3f460ec51b67\", \"axes\": {\"batch_size\": 16, \"time\": 997}, \"inputs\": {\"x\": {\"type\": \"random\"}, \"weight\": {\"type\": \"random\"}, \"bias\": {\"type\": \"random\"}}, \"tolerance\": {\"max_atol\": 1.6550309796206973e-06, \"max_rtol\": 1.1920928955078125e-07, \"required_matched_ratio\": 0.99, \"_provenance\": \"max run-to-run error over 10 seeds x 1.25 margin, floored at torch.float32 epsilon\"}}\n{\"uuid\": \"6f753666-c142-579f-9d9f-d146b52ccdc1\", \"axes\": {\"batch_size\": 4, \"time\": 512}, \"inputs\": {\"x\": {\"type\": \"random\"}, \"weight\": {\"type\": \"random\"}, \"bias\": {\"type\": \"random\"}}, \"tolerance\": {\"max_atol\": 1.6560877914618894e-06, \"max_rtol\": 1.1920928955078125e-07, \"required_matched_ratio\": 0.99, \"_provenance\": \"max run-to-run error over 10 seeds x 1.25 margin, floored at torch.float32 epsilon\"}}\n{\"uuid\": \"24f588ab-cb03-5aa7-a053-905ba12a26f0\", \"axes\": {\"batch_size\": 2, \"time\": 2447}, \"inputs\": {\"x\": {\"type\": \"random\"}, \"weight\": {\"type\": \"random\"}, \"bias\": {