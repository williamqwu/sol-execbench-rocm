{"type":"item.completed","item":{"id":"item_11","type":"command_execution","command":"/bin/bash -lc \"python3 -m py_compile kernel.py && sed -n '1,240p' kernel.py\"","aggregated_output":"import torch\nimport triton\nimport triton.language as tl\n\n\n@triton.jit\ndef _project_kernel(\n    x_ptr,\n    weight_ptr,\n    bias_ptr,\n    out_ptr,\n    T: tl.constexpr,\n    POINTS: tl.constexpr,\n    BLOCK_M: tl.constexpr,\n    BLOCK_N: tl.constexpr,\n    BLOCK_K: tl.constexpr,\n):\n    pid_n = tl.program_id(0)\n    pid_m = tl.program_id(1)\n\n    # N is the collection of all (batch, time) points.  The explicit\n    # quotient/remainder preserves the NCT storage layout across batches.\n    n = pid_n * BLOCK_N + tl.arange(0, BLOCK_N)\n    batch = n // T\n    time = n - batch * T\n    m = pid_m * BLOCK_M + tl.arange(0, BLOCK_M)\n\n    acc = tl.zeros((BLOCK_M, BLOCK_N), dtype=tl.float32)\n    for k0 in range(0, 192, BLOCK_K):\n        k = k0 + tl.arange(0, BLOCK_K)\n        w = tl.load(\n            weight_ptr + m[:, None] * 192 + k[None, :],\n            mask=m[:, None] < 384,\n            other=0.0,\n        )\n        x = tl.load(\n            x_ptr\n            + batch[None, :] * (192 * T)\n            + k[:, None] * T\n            + time[None, :],\n            mask=n[None, :] < POINTS,\n            other=0.0,\n        )\n        acc += tl.dot(w, x, input_precision=\"ieee\")\n\n    acc += tl.load(bias_ptr + m, mask=m < 384, other=0.0)[:, None]\n    out_offsets = (\n        batch[None, :] * (384 * T)\n        + m[:, None] * T\n        + time[None, :]\n    )\n    tl.store(\n        out_ptr + out_offsets,\n        acc,\n        mask=(m[:, None] < 384) & (n[None, :] < POINTS),\n    )\n\n\n@torch.no_grad()\ndef run(x: torch.Tensor, weight: torch.Tensor, bias: torch.Tensor):\n    batch, _, time = x.shape\n    stats = torch.empty(\n        (batch, 384, time), device=x.device, dtype=torch.float32\n    )\n    points = batch * time\n\n    if points <= 2048:\n        block_m, block_n, num_warps = 32, 32, 4\n    else:\n        block_m, block_n, num_warps = 64, 64, 8\n\n    grid = (triton.cdiv(points, block_n), triton.cdiv(384, block_m))\n    _project_kernel[grid](\n        x,\n        weight,\n        bias,\n        stats,\n        T=time,\n        POINTS=points,\n        BLOCK_M=block_m,\n        BLOCK_N=block_n,\n        BLOCK_K=32,\n        num_warps=num_warps,\n        num_stages=2,\n    )\n    return stats[:, :192, :], stats[:, 192:, :]\n","exit_code":0,"status":"completed"}}
