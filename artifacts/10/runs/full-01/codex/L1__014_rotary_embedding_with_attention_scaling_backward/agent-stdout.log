{"type":"item.started","item":{"id":"item_56","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch,numpy as np\nB,S=1,8192;torch.manual_seed(41);xg=torch.randn(B,S,64,device='cuda');wg=torch.ones(B,64,1,device='cuda');y=(wg.transpose(-2,-1)@xg.transpose(1,2)).squeeze().cpu().numpy();x=xg.squeeze().cpu().numpy()\ndef add(a,b):return np.float32(a+b)\ndef red(v,kind):\n v=v.copy()\n if kind=='seq':\n  z=np.zeros(len(v),np.float32)\n  for j in range(v.shape[1]):z=add(z,v[:,j])\n  return z\n if kind=='rev':\n  z=np.zeros(len(v),np.float32)\n  for j in range(v.shape[1]-1,-1,-1):z=add(z,v[:,j])\n  return z\n if kind=='adj':\n  while v.shape[1]>1:v=add(v[:,0::2],v[:,1::2])\n  return v[:,0]\n if kind=='half':\n  while v.shape[1]>1:\n   n=v.shape[1]//2;v=add(v[:,:n],v[:,n:])\n  return v[:,0]\ndef calc(T,V,mp,rs,rl):\n acc=np.zeros((S,T,V),np.float32)\n for k in range(64):\n  if mp=='chunk':l=(k//V)%T;q=k%V\n  elif mp=='stride':l=k%T;q=(k//T)%V\n  elif mp=='contig':sz=64//T;l=k//sz;q=(k%sz)%V\n  acc[:,l,q]=add(acc[:,l,q],x[:,k])\n av=np.stack([red(acc[:,j,:],rs) for j in range(T)],1)\n return red(av,rl)\nr=[]\nfor T in [1,2,4,8,16,32,64]:\n for V in [1,2,4,8,16,32,64]:\n  if T*V>64 or (64//T)%V:continue\n  for mp in ['chunk','stride','contig']:\n   for rs in ['seq','rev','adj','half']:\n    for rl in ['seq','rev','adj','half']:\n     z=calc(T,V,mp,rs,rl);d=np.abs(z-y);r.append((np.mean(z==y),d.mean(),T,V,mp,rs,rl,d.max()))\nfor q in sorted(r,key=lambda q:(-q[0],q[1]))[:30]:print('exact %.4f mean %.3g T%02d V%02d %-6s %-4s %-4s max %.3g'%q)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
