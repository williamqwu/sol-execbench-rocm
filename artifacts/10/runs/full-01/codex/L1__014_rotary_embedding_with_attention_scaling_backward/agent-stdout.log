{"type":"item.completed","item":{"id":"item_53","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,220p' diag_kernel.py\"","aggregated_output":"import torch\nimport triton\nimport triton.language as tl\n\n\n@triton.jit\ndef _grad_kernel(gc, gs, emb, out, n: tl.constexpr, scale: tl.constexpr, BLOCK: tl.constexpr):\n    idx = tl.program_id(0) * BLOCK + tl.arange(0, BLOCK)\n    mask = idx < n\n    row = idx // 64\n    col = idx % 64\n    base = row * 128 + col\n    gcx = tl.load(gc + base, mask=mask, other=0.).to(tl.float32) + tl.load(gc + base + 64, mask=mask, other=0.).to(tl.float32)\n    gsx = tl.load(gs + base, mask=mask, other=0.).to(tl.float32) + tl.load(gs + base + 64, mask=mask, other=0.).to(tl.float32)\n    e = tl.load(emb + base, mask=mask, other=0.)\n    x = gcx * (-tl.sin(e)) * scale + gsx * tl.cos(e) * scale\n    tl.store(out + idx, x, mask=mask)\n\n\n@triton.jit\ndef _reduce_kernel(x, inv, out, seq: tl.constexpr, BM: tl.constexpr):\n    b = tl.program_id(0)\n    rows = tl.program_id(1) * BM + tl.arange(0, BM)\n    cols = tl.arange(0, 64)\n    mask = rows[:, None] < seq\n    v = tl.load(x + (b * seq + rows[:, None]) * 64 + cols[None, :], mask=mask, other=0.)\n    w = tl.load(inv + b * 64 + cols)\n    y = tl.sum(v * w[None, :], axis=1)\n    tl.store(out + b * seq + rows, y, mask=rows < seq)\n\n\n@triton.jit\ndef _dot_kernel(x, inv, out, seq: tl.constexpr, BN: tl.constexpr):\n    b = tl.program_id(0)\n    n = tl.program_id(1) * BN + tl.arange(0, BN)\n    m = tl.arange(0, 16)\n    k = tl.arange(0, 64)\n    a = tl.load(inv + b * 64 + k[None, :], mask=m[:, None] == 0, other=0.0)\n    xv = tl.load(\n        x + (b * seq + n[None, :]) * 64 + k[:, None],\n        mask=n[None, :] < seq,\n        other=0.0,\n    )\n\n\n@triton.jit\ndef _dot_swap_kernel(x, inv, out, seq: tl.constexpr, BM: tl.constexpr):\n    b = tl.program_id(0)\n    m = tl.program_id(1) * BM + tl.arange(0, BM)\n    n = tl.arange(0, 16)\n    k = tl.arange(0, 64)\n    xv = tl.load(\n        x + (b * seq + m[:, None]) * 64 + k[None, :],\n        mask=m[:, None] < seq,\n        other=0.0,\n    )\n    w = tl.load(inv + b * 64 + k[:, None], mask=n[None, :] == 0, other=0.0)\n    acc = tl.dot(xv, w, input_precision=\"ieee\", out_dtype=tl.float32)\n    tl.store(\n        out + b * seq + m[:, None] + n[None, :] * seq,\n        acc,\n        mask=(m[:, None] < seq) & (n[None, :] == 0),\n    )\n    acc = tl.dot(a, xv, input_precision=\"ieee\", out_dtype=tl.float32)\n    tl.store(\n        out + b * seq + m[:, None] * seq + n[None, :],\n        acc,\n        mask=(m[:, None] == 0) & (n[None, :] < seq),\n    )\n\n\ndef grad(gc, gs, emb, scale):\n    b, s, _ = gc.shape\n    out = torch.empty((b, s, 64), device=gc.device, dtype=torch.float32)\n    n = b * s * 64\n    _grad_kernel[(triton.cdiv(n, 256),)](gc, gs, emb, out, n=n, scale=scale, BLOCK=256)\n    return out\n\n\ndef reduce(x, inv):\n    b, s, _ = x.shape\n    out = torch.empty((b, s), device=x.device, dtype=torch.float32)\n    _reduce_kernel[(b, triton.cdiv(s, 4))](x, inv, out, seq=s, BM=4, num_warps=4)\n    return out\n\n\ndef dot(x, inv, bn=32):\n    b, s, _ = x.shape\n    out = torch.empty((b, s), device=x.device, dtype=torch.float32)\n    _dot_kernel[(b, triton.cdiv(s, bn))](x, inv, out, seq=s, BN=bn, num_warps=4)\n    return out\n\n\ndef dot_swap(x, inv, bm=32):\n    b, s, _ = x.shape\n    out = torch.empty((b, s), device=x.device, dtype=torch.float32)\n    _dot_swap_kernel[(b, triton.cdiv(s, bm))](x, inv, out, seq=s, BM=bm, num_warps=4)\n    return out\n","exit_code":0,"status":"completed"}}
