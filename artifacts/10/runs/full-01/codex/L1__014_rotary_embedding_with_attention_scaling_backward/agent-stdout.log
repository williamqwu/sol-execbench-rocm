{"type":"item.started","item":{"id":"item_63","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch,triton\nfrom kernel import _rope_grad_kernel\nfor B,S in [(1,128),(32,256),(64,3011),(64,8192)]:\n gc=torch.randn(B,S,128,device='cuda',dtype=torch.bfloat16);gs=torch.randn_like(gc);e=torch.randn(B,S,128,device='cuda');inv=torch.randn(B,64,1,device='cuda');n=B*S*64\n def cur():\n  g=torch.empty(B,S,64,device='cuda');_rope_grad_kernel[(triton.cdiv(n,512),)](gc,gs,e,g,n_elements=n,attention_scaling=.125,BLOCK=512,num_warps=4);return (inv.transpose(-2,-1)@g.transpose(1,2)).squeeze(1)\n def combo():\n  q=torch.empty(n+B*S,device='cuda');g=q[:n].view(B,S,64);o=q[n:].view(B,1,S);_rope_grad_kernel[(triton.cdiv(n,512),)](gc,gs,e,g,n_elements=n,attention_scaling=.125,BLOCK=512,num_warps=4);torch.bmm(inv.transpose(-2,-1),g.transpose(1,2),out=o);return o.squeeze(1)\n y=cur();z=combo();print('exact',B,S,(y==z).all().item())\n for name,f in [('cur',cur),('combo',combo)]:\n  t=triton.testing.do_bench(f,warmup=50,rep=300,return_mode='median');print(name,round(t*1000,3))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
