{"type":"item.started","item":{"id":"item_21","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch,numpy as np,diag_kernel\nB,S=1,2048;torch.manual_seed(29);x=torch.randn(B,S,64,device='cuda');w=torch.randn(B,64,1,device='cuda'); yd=diag_kernel.dot(x,w,32).squeeze().cpu().numpy(); xx=x.squeeze().cpu().numpy();ww=w.squeeze().cpu().numpy()\ndef seq(fma):\n z=np.zeros(S,np.float32)\n for k in range(64):\n  z=np.float32(z.astype(np.float64)+xx[:,k].astype(np.float64)*np.float64(ww[k])) if fma else np.float32(z+np.float32(xx[:,k]*ww[k]))\n return z\nfor f in [0,1]:\n z=seq(f); d=np.abs(z-yd); print(f,'exact',np.mean(z==yd),'mean',d.mean(),'max',d.max())\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
