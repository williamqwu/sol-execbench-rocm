{"type":"item.started","item":{"id":"item_14","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch, numpy as np\nB,S,a=1,2048,.125\ntorch.manual_seed(17)\ngc=torch.randn(B,S,128,device='cuda',dtype=torch.bfloat16); gs=torch.randn_like(gc); e=torch.randn(B,S,128,device='cuda'); inv=torch.randn(B,64,1,device='cuda')\ngcf=gc.float(); gsf=gs.float(); gr=(gcf[...,:64]+gcf[...,64:])*(-e[...,:64].sin())*a+(gsf[...,:64]+gsf[...,64:])*e[...,:64].cos()*a\ny=(inv.transpose(-2,-1)@gr.transpose(1,2)).squeeze().cpu().numpy()\nx=gr.squeeze().cpu().numpy(); w=inv.squeeze().cpu().numpy(); vals=np.float32(x*w)\n\ndef seq(row, order, fma=False):\n z=np.float32(0)\n for i in order:\n  z=np.float32(np.float64(z)+np.float64(row[i])*np.float64(w[i])) if fma else np.float32(z+np.float32(row[i]*w[i]))\n return z\n\ndef lanes(row,nacc,mode='stride',fma=False,final='seq'):\n acc=np.zeros(nacc,dtype=np.float32)\n if mode=='stride': groups=[range(j,64,nacc) for j in range(nacc)]\n else:\n  chunk=(64+nacc-1)//nacc; groups=[range(j*chunk,min(64,(j+1)*chunk)) for j in range(nacc)]\n for j,g in enumerate(groups):\n  for i in g:\n   acc[j]=np.float32(np.float64(acc[j])+np.float64(row[i])*np.float64(w[i])) if fma else np.float32(acc[j]+np.float32(row[i]*w[i]))\n if final=='seq':\n  z=np.float32(0)\n  for v in acc: z=np.float32(z+v)\n  return z\n while len(acc)>1:\n  acc=np.float32(acc[0::2]+acc[1::2])\n return acc[0]\n\ndef tree(v, kind):\n v=np.array(v,dtype=np.float32)\n if kind=='adj':\n  while len(v)>1: v=np.float32(v[0::2]+v[1::2])\n elif kind=='xor':\n  step=len(v)//2\n  while step:\n   v[:step]=np.float32(v[:step]+v[step:2*step]); step//=2\n  v=v[:1]\n return v[0]\n\ndef score(name,z):\n d=np.abs(z-y); tol=2e-7+np.float32(1.1920929e-7)*np.abs(y)\n print(f'{name:22s} exact {np.mean(z==y):.4f} ratio {np.mean(d<=tol):.4f} mean {np.mean(d):.3g} max {np.max(d):.3g}')\nscore('np.sum',np.sum(vals,axis=1,dtype=np.float32))\nscore('tree-adj',np.array([tree(v,'adj') for v 