{"type":"item.started","item":{"id":"item_57","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch,numpy as np,itertools\nB,S=1,8192;torch.manual_seed(43);xg=torch.randn(B,S,64,device='cuda');wg=torch.randn(B,64,1,device='cuda');y=(wg.transpose(-2,-1)@xg.transpose(1,2)).squeeze().cpu().numpy();x=xg.squeeze().cpu().numpy();w=wg.squeeze().cpu().numpy()\norders={\n'contig':list(range(64)),\n'block4transpose':sum(([b+i,b+i+4,b+i+8,b+i+12] for b in range(0,64,16) for i in range(4)),[]),\n'stride16':sum(([i,i+16,i+32,i+48] for i in range(16)),[]),\n'stride8':sum(([i+8*j for j in range(8)] for i in range(8)),[]),\n}\ndef calc(order,mode,g=4):\n z=np.zeros(S,np.float32)\n for q in range(0,64,g):\n  ks=order[q:q+g]\n  if mode=='oneround':z=np.float32(z.astype(np.float64)+np.sum(x[:,ks].astype(np.float64)*w[ks].astype(np.float64),axis=1))\n  elif mode=='prodsum':z=np.float32(z+np.sum(np.float32(x[:,ks]*w[ks]),axis=1,dtype=np.float32))\n  elif mode=='pair':\n   p=np.float32(x[:,ks]*w[ks]);u=np.float32(p[:,0]+p[:,1]);v=np.float32(p[:,2]+p[:,3]);z=np.float32(z+np.float32(u+v))\n  elif mode=='fma':\n   for k in ks:z=np.float32(z.astype(np.float64)+x[:,k].astype(np.float64)*np.float64(w[k]))\n return z\nfor name,o in orders.items():\n for mode in ['oneround','prodsum','pair','fma']:\n  for g in ([4] if mode=='pair' else [2,4,8,16]):\n   z=calc(o,mode,g);d=np.abs(z-y);print(f'{name:16} {mode:8} g{g:02} exact {np.mean(z==y):.4f} mean {d.mean():.3g} max {d.max():.3g}')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
