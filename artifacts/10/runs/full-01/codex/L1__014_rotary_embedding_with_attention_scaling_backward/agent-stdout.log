{"type":"item.started","item":{"id":"item_19","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch,numpy as np,itertools\nB,S,a=1,4096,.125;torch.manual_seed(23)\ngc=torch.randn(B,S,128,device='cuda',dtype=torch.bfloat16);gs=torch.randn_like(gc);e=torch.randn(B,S,128,device='cuda');inv=torch.randn(B,64,1,device='cuda')\ngcf=gc.float();gsf=gs.float();gr=(gcf[...,:64]+gcf[...,64:])*(-e[...,:64].sin())*a+(gsf[...,:64]+gsf[...,64:])*e[...,:64].cos()*a\ny=(inv.transpose(-2,-1)@gr.transpose(1,2)).squeeze().cpu().numpy();x=gr.squeeze().cpu().numpy();w=inv.squeeze().cpu().numpy(); P=np.float32(x*w)\n\ndef add(a,b): return np.float32(a+b)\ndef reduce(v,kind,axis=1):\n v=v.copy()\n if kind=='seq':\n  z=np.zeros(v.shape[0],np.float32)\n  for j in range(v.shape[1]):z=add(z,v[:,j])\n  return z\n if kind=='rev':\n  z=np.zeros(v.shape[0],np.float32)\n  for j in range(v.shape[1]-1,-1,-1):z=add(z,v[:,j])\n  return z\n if kind=='adj':\n  while v.shape[1]>1:v=add(v[:,0::2],v[:,1::2])\n  return v[:,0]\n if kind=='half':\n  while v.shape[1]>1:\n   n=v.shape[1]//2;v=add(v[:,:n],v[:,n:])\n  return v[:,0]\n\ndef calc(T,V,mapping,fma,rs,rl):\n acc=np.zeros((S,T,V),np.float32)\n for k in range(64):\n  if mapping=='chunk': lane=(k//V)%T; slot=k%V\n  elif mapping=='stride': lane=k%T;slot=(k//T)%V\n  elif mapping=='contig':\n   q=64//T;lane=k//q;slot=(k%q)%V\n  elif mapping=='chunksrev':lane=(k//V)%T;slot=V-1-k%V\n  if fma: acc[:,lane,slot]=np.float32(acc[:,lane,slot].astype(np.float64)+x[:,k].astype(np.float64)*np.float64(w[k]))\n  else:acc[:,lane,slot]=add(acc[:,lane,slot],P[:,k])\n # reduce slots separately for lanes\n av=np.stack([reduce(acc[:,j,:],rs) for j in range(T)],axis=1)\n return reduce(av,rl)\nres=[]\nfor T in [1,2,4,8,16,32,64]:\n for V in [1,2,4,8,16,32,64]:\n  if T*V>64 or (64//T)%V:continue\n  for mp in ['chunk','stride','contig','chunksrev']:\n   for fma in [0,1]:\n    for rs in ['seq','rev','adj','half']:\n     for rl in ['seq','rev','adj','half']:\n      z=calc(T,V,mp,fma,rs,rl);d=np.abs(z-y)\n      res.append((np.mean(z==y),np.mean(d),np.max(d),T,V,mp,fma,rs,rl,np.mean(d<=2e-7+np.float32(1.1920929e-7)*np.abs(y))))\nfor q in sorted(res,key=lambda q:(-q[0],q[1]))[:40]: print('exact %.4f mean %.3g max %.3g T%02d V%02d %-9s f%d %-4s %-4s ratio %.4f'%q)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
