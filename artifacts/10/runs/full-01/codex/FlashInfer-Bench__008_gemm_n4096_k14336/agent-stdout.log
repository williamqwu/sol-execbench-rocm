{"type":"item.started","item":{"id":"item_17","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch, aiter, time\naiter.hipb_create_extension()\nfor M in [1,2,4,8,16,32,64,128,256,972,2053,2379,8192]:\n A=torch.randn((M,14336),device='cuda',dtype=torch.float16)\n B=torch.randn((4096,14336),device='cuda',dtype=torch.float16)\n sols=aiter.hipb_findallsols(A,B.T)\n print(M,len(sols),sols[:10],sols[-3:])\n if M in (1,256,8192):\n  ref=A@B.T\n  for sid in sols[:5]:\n   try:\n    y=aiter.hipb_mm(A,B.T,sid)\n    torch.cuda.synchronize()\n    print(' ',sid,tuple(y.shape),(y-ref).abs().max().item())\n   except Exception as e: print(' ',sid,'ERR',str(e)[:200])\n del A,B,sols\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
