{"type":"item.started","item":{"id":"item_18","type":"command_execution","command":"/bin/bash -lc \"python -u - <<'PY'\nimport torch, aiter, time, heapq\naiter.hipb_create_extension()\ntorch.manual_seed(1)\nB=torch.randn((4096,14336),device='cuda',dtype=torch.float16)\nfor M in [1,8,16,32,64,128,256,972,2053,8192]:\n    A=torch.randn((M,14336),device='cuda',dtype=torch.float16)\n    sols=aiter.hipb_findallsols(A,B.T)\n    # Prime the runtime and allocator.\n    aiter.hipb_mm(A,B.T,sols[0]); torch.cuda.synchronize()\n    times=[]\n    reps=3 if M <= 256 else 2\n    started=time.time()\n    for i,sid in enumerate(sols):\n        try:\n            aiter.hipb_mm(A,B.T,sid)\n            st=torch.cuda.Event(enable_timing=True); en=torch.cuda.Event(enable_timing=True)\n            st.record()\n            for _ in range(reps): y=aiter.hipb_mm(A,B.T,sid)\n            en.record(); en.synchronize()\n            times.append((st.elapsed_time(en)/reps,sid))\n        except Exception:\n            pass\n    times.sort()\n    ref=A@B.T; torch.cuda.synchronize()\n    checks=[]\n    for ms,sid in times[:10]:\n        y=aiter.hipb_mm(A,B.T,sid); torch.cuda.synchronize()\n        checks.append((round(ms,4),sid,float((y-ref).abs().max())))\n    print('M',M,'tested',len(times),'seconds',round(time.time()-started,1),'top',checks,flush=True)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
