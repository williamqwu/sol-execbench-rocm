{"type":"item.started","item":{"id":"item_21","type":"command_execution","command":"/bin/bash -lc \"python -u - <<'PY'\nimport torch, aiter\naiter.rocb_create_extension()\ntorch.manual_seed(7)\nB=torch.randn((4096,14336),device='cuda',dtype=torch.float16)\nfor M in [1,8,16,32,64,128,256,972,2053,2379,8192]:\n A=torch.randn((M,14336),device='cuda',dtype=torch.float16)\n sols=aiter.rocb_findallsols(A,B.T)\n aiter.rocb_mm(A,B.T,sols[0]); torch.cuda.synchronize()\n vals=[]\n reps=3 if M<=256 else 2\n for sid in sols:\n  try:\n   aiter.rocb_mm(A,B.T,sid)\n   s=torch.cuda.Event(enable_timing=True); e=torch.cuda.Event(enable_timing=True)\n   s.record()\n   for _ in range(reps): y=aiter.rocb_mm(A,B.T,sid)\n   e.record(); e.synchronize(); vals.append((s.elapsed_time(e)/reps,sid))\n  except Exception: pass\n vals.sort()\n fine=[]\n reps=12 if M<=256 else 5\n for _,sid in vals[:20]:\n  s=torch.cuda.Event(enable_timing=True); e=torch.cuda.Event(enable_timing=True); s.record()\n  for _ in range(reps): y=aiter.rocb_mm(A,B.T,sid)\n  e.record(); e.synchronize(); fine.append((s.elapsed_time(e)/reps,sid))\n fine.sort()\n ref=A@B.T; torch.cuda.synchronize()\n out=[]\n for ms,sid in fine[:5]:\n  y=aiter.rocb_mm(A,B.T,sid); torch.cuda.synchronize(); d=(y-ref).abs()\n  out.append((round(ms,5),sid,float(d.max())))\n print(M,out,flush=True)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
