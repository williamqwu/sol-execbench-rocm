{"type":"item.started","item":{"id":"item_20","type":"command_execution","command":"/bin/bash -lc \"python -u - <<'PY'\nimport torch, aiter, time\naiter.hipb_create_extension()\ntorch.manual_seed(2026)\nB=torch.randn((4096,14336),device='cuda',dtype=torch.float16)\nMs=[256,248,240,232,224,216,208,200,192,184,176,168,160,152,144,136,128,120,112,104,96,88,80,72,64,56,48,40,32,24,16,8,4,2,1,7,35,972,70,2053,8192,2379,15]\nfor M in Ms:\n    A=torch.randn((M,14336),device='cuda',dtype=torch.float16)\n    sols=aiter.hipb_findallsols(A,B.T)\n    aiter.hipb_mm(A,B.T,sols[0]); torch.cuda.synchronize()\n    broad=[]\n    reps=2\n    for sid in sols:\n        try:\n            aiter.hipb_mm(A,B.T,sid)\n            st=torch.cuda.Event(enable_timing=True); en=torch.cuda.Event(enable_timing=True)\n            st.record()\n            for _ in range(reps): y=aiter.hipb_mm(A,B.T,sid)\n            en.record(); en.synchronize()\n            broad.append((st.elapsed_time(en)/reps,sid))\n        except Exception:\n            pass\n    broad.sort()\n    fine=[]\n    reps=12 if M <= 256 else 5\n    for _,sid in broad[:24]:\n        st=torch.cuda.Event(enable_timing=True); en=torch.cuda.Event(enable_timing=True)\n        st.record()\n        for _ in range(reps): y=aiter.hipb_mm(A,B.T,sid)\n        en.record(); en.synchronize()\n        fine.append((st.elapsed_time(en)/reps,sid))\n    fine.sort()\n    ref=A@B.T; torch.cuda.synchronize()\n    results=[]\n    atol=0.0685; rtol=0.0009765625\n    for ms,sid in fine[:5]:\n        y=aiter.hipb_mm(A,B.T,sid); torch.cuda.synchronize()\n        d=(y-ref).abs()\n        ratio=(d <= atol + rtol*ref.abs()).float().mean().item()\n        results.append((round(ms,5),sid,round(float(d.max()),4),round(ratio,6)))\n    print(M,results,flush=True)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
