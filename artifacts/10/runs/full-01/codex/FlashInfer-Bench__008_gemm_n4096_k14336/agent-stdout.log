{"type":"item.completed","item":{"id":"item_37","type":"command_execution","command":"/bin/bash -lc \"python -m py_compile kernel.py && jq empty solution.json && sed -n '1,220p' kernel.py && sed -n '1,120p' solution.json\"","aggregated_output":"import torch\nimport aiter\n\n\n# Build the library handles once, outside the measured call.  The selected\n# solution IDs below are all valid for fp16 A[M,14336] @ B[4096,14336].T on\n# gfx950; no search or temporary weight transform is needed at run time.\naiter.hipb_create_extension()\naiter.rocb_create_extension()\n\n\n_HIPBLASLT_SOLUTIONS = {\n    256: 476634,\n    248: 477183,\n    240: 476949,\n    232: 476696,\n    224: 477128,\n    216: 476894,\n    208: 477187,\n    200: 476901,\n    192: 477413,\n    184: 476756,\n    176: 476756,\n    168: 476756,\n    160: 476756,\n    152: 476756,\n    48: 476895,\n    35: 476595,\n    32: 476594,\n    24: 477452,\n    16: 477464,\n    15: 477464,\n    8: 477464,\n    7: 477464,\n    4: 477461,\n    2: 476997,\n    1: 476997,\n    972: 476751,\n    2053: 476860,\n    2379: 476749,\n}\n\n_ROCBLAS_SOLUTIONS = {\n    8192: 476721,\n}\n\n\ndef run(A, B):\n    M = A.shape[0]\n    solution = _HIPBLASLT_SOLUTIONS.get(M)\n    if solution is not None:\n        return aiter.hipb_mm(A, B.T, solution)\n    solution = _ROCBLAS_SOLUTIONS.get(M)\n    if solution is not None:\n        return aiter.rocb_mm(A, B.T, solution)\n    return torch.matmul(A, B.T)\n{\n  \"name\": \"008_gemm_n4096_k14336_agent\",\n  \"definition\": \"008_gemm_n4096_k14336\",\n  \"author\": \"agent\",\n  \"spec\": {\n    \"languages\": [\"aiter\"],\n    \"target_hardware\": [\"MI355X\", \"LOCAL\"],\n    \"entry_point\": \"kernel.py::run\",\n    \"dependencies\": [\"torch\", \"aiter\"],\n    \"destination_passing_style\": false\n  },\n  \"sources\": [\n    {\"path\": \"kernel.py\", \"content\": \"\"}\n  ]\n}\n","exit_code":0,"status":"completed"}}
