{"type":"item.started","item":{"id":"item_33","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch,aiter,statistics,gc\naiter.hipb_create_extension();op=torch.ops.aiter.hipb_mm.default\nms=[8828,11006,12251,12853,14915,16294]\n\ndef idle(f,reps):\n st=torch.cuda.Event(enable_timing=True);en=torch.cuda.Event(enable_timing=True); vals=[]\n y=f();torch.cuda.synchronize();del y\n for _ in range(reps):\n  st.record();y=f();en.record();en.synchronize();vals.append(st.elapsed_time(en));del y\n return statistics.median(vals)\nfor m in ms:\n a=torch.randn((m,2048),device='cuda',dtype=torch.float16);b=torch.randn((5120,2048),device='cuda',dtype=torch.float16);bt=b.T\n vals=[]\n for si in aiter.hipb_findallsols(a,bt):\n  try:vals.append((idle(lambda si=si:op(a,bt,si),2),si))\n  except Exception:pass\n final=[]\n for _,si in sorted(vals)[:50]:\n  try:final.append((idle(lambda si=si:op(a,bt,si),11),si))\n  except Exception:pass\n tt=idle(lambda:torch.mm(a,bt),21)\n print('LARGE',m,'torch',round(tt,6),'top',[(s,round(t,6)) for t,s in sorted(final)[:12]],flush=True)\n del a,b,bt;gc.collect()\naiter.hipb_destroy_extension()\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
