{"type":"item.started","item":{"id":"item_19","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch, aiter, gc, time\naiter.hipb_create_extension()\n\ndef tune(m):\n a=torch.randn((m,2048),device='cuda',dtype=torch.float16); b=torch.randn((5120,2048),device='cuda',dtype=torch.float16); bt=b.T\n sols=aiter.hipb_findallsols(a,bt)\n print('M',m,'solutions',len(sols),flush=True)\n vals=[]\n for j,si in enumerate(sols):\n  try:\n   y=aiter.hipb_mm(a,bt,si); torch.cuda.synchronize(); del y\n   st=torch.cuda.Event(enable_timing=True); en=torch.cuda.Event(enable_timing=True)\n   st.record(); y=aiter.hipb_mm(a,bt,si); en.record(); en.synchronize()\n   vals.append((st.elapsed_time(en),si)); del y\n  except Exception:\n   pass\n shortlist=sorted(vals)[:30]\n precise=[]\n for _,si in shortlist:\n  try:\n   for _ in range(3): y=aiter.hipb_mm(a,bt,si)\n   torch.cuda.synchronize(); del y\n   st=torch.cuda.Event(enable_timing=True); en=torch.cuda.Event(enable_timing=True)\n   st.record()\n   for _ in range(20): y=aiter.hipb_mm(a,bt,si)\n   en.record(); en.synchronize(); precise.append((st.elapsed_time(en)/20,si)); del y\n  except Exception: pass\n # torch comparator\n for _ in range(3): y=torch.mm(a,bt)\n torch.cuda.synchronize(); st=torch.cuda.Event(enable_timing=True);en=torch.cuda.Event(enable_timing=True);st.record()\n for _ in range(20): y=torch.mm(a,bt)\n en.record();en.synchronize(); tt=st.elapsed_time(en)/20\n print('RESULT',m,'torch',round(tt,6),'top',[(round(t,6),s) for t,s in sorted(precise)[:15]],flush=True)\n del a,b,bt,y; gc.collect()\n\nfor m in (1,16,64,128,492,952,8828,16294): tune(m)\naiter.hipb_destroy_extension()\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
