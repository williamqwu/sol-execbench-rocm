{"type":"item.started","item":{"id":"item_28","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch,aiter,json,statistics,gc\naiter.hipb_create_extension(); op=torch.ops.aiter.hipb_mm.default\nms=[]\nfor line in open('workload.jsonl'):\n m=json.loads(line)['axes']['M']\n if m<=952 and m not in ms:ms.append(m)\n\ndef idle_time(f,reps=5):\n vals=[]; st=torch.cuda.Event(enable_timing=True);en=torch.cuda.Event(enable_timing=True)\n y=f();torch.cuda.synchronize();del y\n for _ in range(reps):\n  st.record();y=f();en.record();en.synchronize();vals.append(st.elapsed_time(en));del y\n return statistics.median(vals)\n\npicks={}\nfor m in ms:\n a=torch.randn((m,2048),device='cuda',dtype=torch.float16);b=torch.randn((5120,2048),device='cuda',dtype=torch.float16);bt=b.T\n ss=aiter.hipb_findallsols(a,bt); vals=[]\n for si in ss:\n  try: vals.append((idle_time(lambda si=si:op(a,bt,si),3),si))\n  except Exception: pass\n # Robust remeasure broad top set.\n final=[]\n for _,si in sorted(vals)[:80]:\n  try: final.append((idle_time(lambda si=si:op(a,bt,si),15),si))\n  except Exception:pass\n best=sorted(final); tt=idle_time(lambda:torch.mm(a,bt),30)\n picks[m]=best[0][1]\n print('IDLE',m,'pick',best[0][1],round(best[0][0],6),'torch',round(tt,6),'top10',[(s,round(t,6)) for t,s in best[:10]],flush=True)\n del a,b,bt;gc.collect()\nprint('IDLE_MAP',picks)\naiter.hipb_destroy_extension()\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
