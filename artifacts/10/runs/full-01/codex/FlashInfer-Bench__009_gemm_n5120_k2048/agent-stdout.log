{"type":"item.started","item":{"id":"item_35","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch,aiter,statistics,gc\naiter.rocb_create_extension();op=torch.ops.aiter.rocb_mm.default\n\ndef idle(f,reps):\n st=torch.cuda.Event(enable_timing=True);en=torch.cuda.Event(enable_timing=True);v=[]\n y=f();torch.cuda.synchronize();del y\n for _ in range(reps):st.record();y=f();en.record();en.synchronize();v.append(st.elapsed_time(en));del y\n return statistics.median(v)\nfor m in [172,289,492,952,8828,11006,12251,12853,14915,16294]:\n a=torch.randn((m,2048),device='cuda',dtype=torch.float16);b=torch.randn((5120,2048),device='cuda',dtype=torch.float16);bt=b.T\n try:ss=aiter.rocb_findallsols(a,bt)\n except Exception as e:print('FINDERR',m,e);continue\n vals=[]\n for si in ss:\n  try:vals.append((idle(lambda si=si:op(a,bt,si),2),si))\n  except Exception:pass\n fin=[]\n for _,si in sorted(vals)[:40]:\n  try:fin.append((idle(lambda si=si:op(a,bt,si),9),si))\n  except Exception:pass\n print('ROCB',m,'n',len(ss),'top',[(s,round(t,6)) for t,s in sorted(fin)[:10]],flush=True)\n del a,b,bt;gc.collect()\naiter.rocb_destroy_extension()\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
