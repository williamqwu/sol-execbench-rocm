{"type":"item.completed","item":{"id":"item_20","type":"agent_message","text":"AITER’s direct hipBLASLt solution selection is materially faster: the best tested kernels cut tiny-shape latency to about 12 µs and improve the `M=8828` case by roughly 10%. I’m now tuning the solution index for each of the 25 declared shapes, then I’ll hardcode those choices with a safe vendor fallback and re-run full verification."}}
{"type":"item.started","item":{"id":"item_21","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch, aiter, json, gc\nms=[]\nfor line in open('workload.jsonl'):\n m=json.loads(line)['axes']['M']\n if m not in ms: ms.append(m)\naiter.hipb_create_extension()\nprint('TUNING',ms,flush=True)\n\ndef measure(a,bt,si,reps):\n st=torch.cuda.Event(enable_timing=True); en=torch.cuda.Event(enable_timing=True)\n st.record()\n for _ in range(reps): y=aiter.hipb_mm(a,bt,si)\n en.record(); en.synchronize()\n return st.elapsed_time(en)/reps\n\nresults={}\nfor m in ms:\n a=torch.randn((m,2048),device='cuda',dtype=torch.float16)\n b=torch.randn((5120,2048),device='cuda',dtype=torch.float16); bt=b.T\n sols=aiter.hipb_findallsols(a,bt)\n rough=[]\n for si in sols:\n  try:\n   y=aiter.hipb_mm(a,bt,si); torch.cuda.synchronize(); del y\n   rough.append((measure(a,bt,si,2),si))\n  except Exception: pass\n precise=[]\n for _,si in sorted(rough)[:60]:\n  try:\n   for _ in range(5): y=aiter.hipb_mm(a,bt,si)\n   torch.cuda.synchronize(); del y\n   precise.append((measure(a,bt,si,80),si))\n  except Exception: pass\n best=sorted(precise)\n # Compare against reference and validate best's output on this input.\n for _ in range(5): yr=torch.mm(a,bt)\n torch.cuda.synchronize()\n st=torch.cuda.Event(enable_timing=True);en=torch.cuda.Event(enable_timing=True);st.record()\n for _ in range(80): yr=torch.mm(a,bt)\n en.record();en.synchronize(); rt=st.elapsed_time(en)/80\n y=aiter.hipb_mm(a,bt,best[0][1]); torch.cuda.synchronize()\n delta=(y-yr).abs(); maxabs=float(delta.max()); ratio=float(torch.isclose(y,yr,atol=0.026,rtol=0.0009765625).float().mean())\n results[m]=best[0][1]\n print('PICK',m,best[0][1],round(best[0][0],6),'torch',round(rt,6),'ratio',round(ratio,7),'max',maxabs,'top5',[(s,round(t,6)) for t,s in best[:5]],flush=True)\n del a,b,bt,y,yr,delta; gc.collect()\nprint('MAP',repr(results),flush=True)\naiter.hipb_destroy_extension()\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
