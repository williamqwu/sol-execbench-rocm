{"type":"item.started","item":{"id":"item_45","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch,torch.nn.functional as F\nfrom experiment import custom_moe\nD='cuda';torch.manual_seed(21);T,H,I,E,Q=1280,5120,1536,160,8\nx=torch.randn(T,H,device=D,dtype=torch.bfloat16);ids=torch.topk(torch.randn(T,E,device=D)+torch.randn(E,device=D),Q,-1,sorted=False).indices;w=torch.rand(T,Q,device=D)\ng=torch.empty(E,I,H,device=D,dtype=torch.bfloat16);u=torch.empty_like(g);d=torch.empty(E,H,I,device=D,dtype=torch.bfloat16)\ndef grouped():\n se,p=torch.sort(ids.reshape(-1));ti=p//Q;a=x[ti];offs=torch.cumsum(torch.bincount(se,minlength=E),0,dtype=torch.int32);go=torch._grouped_mm(a,g.transpose(1,2),offs=offs);up=torch._grouped_mm(a,u.transpose(1,2),offs=offs);F.silu(go,inplace=True);go.mul_(up);return torch._grouped_mm(go,d.transpose(1,2),offs=offs)\ndef custom(): return custom_moe(x,ids,w,g,u,d)\nfor f in [grouped,custom]:\n for _ in range(3): z=f()\n torch.cuda.synchronize(); times=[]\n for _ in range(12):\n  s=torch.cuda.Event(enable_timing=True);e=torch.cuda.Event(enable_timing=True);s.record();z=f();e.record();e.synchronize();times.append(s.elapsed_time(e))\n print(f.__name__, 'median',sorted(times)[len(times)//2], 'all', [round(v,3) for v in times])\nprint('max expert count',int(torch.bincount(ids.flatten(),minlength=E).max()),'active',int((torch.bincount(ids.flatten(),minlength=E)>0).sum()))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
