{"type":"item.started","item":{"id":"item_22","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch, torch.nn.functional as F\nD='cuda';torch.manual_seed(3)\nT,E,K,I,TOP=64,160,64,32,8\nx=torch.randn(T,K,device=D,dtype=torch.bfloat16)\ng=torch.randn(E,I,K,device=D,dtype=torch.bfloat16)\nu=torch.randn(E,I,K,device=D,dtype=torch.bfloat16)\nd=torch.randn(E,K,I,device=D,dtype=torch.bfloat16)\nids=torch.randint(0,E,(T,TOP),device=D,dtype=torch.int32)\nw=torch.rand(T,TOP,device=D)\n# sorted grouped path\nsid,perm=torch.sort(ids.reshape(-1))\ntok=torch.div(perm,TOP,rounding_mode='floor')\ngather=x[tok]\ncounts=torch.bincount(sid.long(),minlength=E)\noffs=torch.cumsum(counts,0,dtype=torch.int32)\ngate=torch._grouped_mm(gather,g.transpose(1,2),offs=offs)\nup=torch._grouped_mm(gather,u.transpose(1,2),offs=offs)\ninter=F.silu(gate)*up\ny=torch._grouped_mm(inter,d.transpose(1,2),offs=offs)\n# scatter expert-order like ref\nout=torch.zeros(T,K,device=D)\nout.index_add_(0,tok,y*w.reshape(-1)[perm,None])\n# explicit loop\nref=torch.zeros_like(out)\nids64=ids.long()\nfor e in range(E):\n ti,ki=torch.where(ids64==e)\n if ti.numel():\n  z=F.silu(F.linear(x[ti],g[e]))*F.linear(x[ti],u[e])\n  q=F.linear(z,d[e])\n  ref.index_add_(0,ti,q*w[ti,ki,None])\ntorch.cuda.synchronize()\ndiff=(out-ref).abs()\nprint('max',diff.max().item(),'mean',diff.mean().item(),'exact', (out==ref).float().mean().item())\nprint('finite',torch.isfinite(y).all().item(),'offs end',offs[-1].item())\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
