{"type":"item.started","item":{"id":"item_37","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch,torch.nn.functional as F\nfrom experiment import custom_moe\nD='cuda';torch.manual_seed(17);T,H,I,E,Q=37,64,32,160,8\nx=torch.randn(T,H,device=D,dtype=torch.bfloat16);g=torch.randn(E,I,H,device=D,dtype=torch.bfloat16);u=torch.randn_like(g);d=torch.randn(E,H,I,device=D,dtype=torch.bfloat16);ids=torch.randint(E,(T,Q),device=D,dtype=torch.int32);w=torch.rand(T,Q,device=D)\neo,inv,nv=custom_moe(x,ids,w,g,u,d);torch.cuda.synchronize()\nfor t,k in [(0,0),(0,1),(3,4)]:\n e=int(ids[t,k]); pos=int(inv[t*Q+k]); z=F.silu(F.linear(x[t:t+1],g[e]))*F.linear(x[t:t+1],u[e]);r=F.linear(z,d[e])[0];q=eo[pos]\n print('route',t,k,'e',e,'pos',pos,'max',float((q-r).abs().max()),'q',q[:5].tolist(),'r',r[:5].tolist())\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
