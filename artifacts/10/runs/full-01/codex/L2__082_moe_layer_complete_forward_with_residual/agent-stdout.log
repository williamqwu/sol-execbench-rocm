{"type":"item.started","item":{"id":"item_36","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch,torch.nn.functional as F\nfrom experiment import custom_moe,finish\nD='cuda';torch.manual_seed(17);T,H,I,E,Q=37,64,32,160,8\nx=torch.randn(T,H,device=D,dtype=torch.bfloat16);g=torch.randn(E,I,H,device=D,dtype=torch.bfloat16);u=torch.randn_like(g);d=torch.randn(E,H,I,device=D,dtype=torch.bfloat16);ids=torch.randint(E,(T,Q),device=D,dtype=torch.int32);w=torch.rand(T,Q,device=D);shared=torch.randn(T,H,device=D,dtype=torch.bfloat16)\neo,inv,nv=custom_moe(x,ids,w,g,u,d);y=finish(eo,inv,w,shared)\nref=torch.zeros(T,H,device=D)\nfor e in range(E):\n ti,ki=torch.where(ids==e)\n if ti.numel():\n  z=F.silu(F.linear(x[ti],g[e]))*F.linear(x[ti],u[e]);ref.index_add_(0,ti,F.linear(z,d[e])*w[ti,ki,None])\nref=ref.bfloat16()+shared\ntorch.cuda.synchronize();df=(y.float()-ref.float()).abs();tol=.00625+.0078125*ref.float().abs()\nprint('numvalid',nv.item(),'max',eo.shape[0]);print('max',df.max().item(),'mean',df.mean().item(),'match',float((df<=tol).float().mean()),'exact',float((y==ref).float().mean()))\nprint(y[0,:8],ref[0,:8])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
