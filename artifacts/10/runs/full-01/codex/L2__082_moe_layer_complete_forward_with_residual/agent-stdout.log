{"type":"item.started","item":{"id":"item_70","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch,torch.nn.functional as F\nfrom experiment import custom_moe,finish\nD='cuda';torch.manual_seed(31);T,H,I,E,Q=128,5120,1536,160,8\nx=torch.empty(T,H,device=D,dtype=torch.bfloat16).normal_();ids=torch.topk(torch.sigmoid(torch.randn(T,E,device=D)*70)+torch.randn(E,device=D),Q,-1,sorted=False).indices;w=torch.rand(T,Q,device=D);w=w/w.sum(-1,keepdim=True)*2.5\nprint('allocating initialized weights',flush=True)\ng=torch.empty(E,I,H,device=D,dtype=torch.bfloat16).normal_(0,.01);u=torch.empty_like(g).normal_(0,.01);d=torch.empty(E,H,I,device=D,dtype=torch.bfloat16).normal_(0,.01)\nprint('custom',flush=True)\neo,inv,nv,inter,st,se=custom_moe(x,ids,w,g,u,d,128,64,128,512,8,8,64,64,1,2);shared=torch.zeros(T,H,device=D,dtype=torch.bfloat16);yc=finish(eo,inv,w,shared)\nprint('grouped',flush=True)\nsids,p=torch.sort(ids.flatten());tok=p//Q;a=x[tok];offs=torch.cumsum(torch.bincount(sids,minlength=E),0,dtype=torch.int32);go=torch._grouped_mm(a,g.transpose(1,2),offs=offs);up=torch._grouped_mm(a,u.transpose(1,2),offs=offs);F.silu(go,inplace=True);go.mul_(up);yo=torch._grouped_mm(go,d.transpose(1,2),offs=offs);ref=torch.zeros(T,H,device=D);ref.index_add_(0,tok,yo*w.flatten()[p,None]);ref=ref.bfloat16();torch.cuda.synchronize()\ndf=(yc.float()-ref.float()).abs();tol=.00625+.0078125*ref.float().abs();print('max',df.max().item(),'mean',df.mean().item(),'match',float((df<=tol).float().mean()),'exact',float((yc==ref).float().mean()),'nv',nv.item());\nfor q in [.5,.9,.99,.999,1.]:print(q,float(torch.quantile(df,q)))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
