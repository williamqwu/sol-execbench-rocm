{"type":"item.started","item":{"id":"item_24","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport torch, reference\nfrom aiter.ops.triton.gated_delta_net import gated_delta_rule as gm\nf=gm.chunk_gated_delta_rule_fwd_opt\ngl=f.__globals__\nf1=gl['fused_chunk_local_cumsum_scaled_dot_kkt_fwd']; f2=gl['fused_solve_tril_recompute_w_u']; fh=gl['chunk_gated_delta_rule_fwd_h_opt']; fo=gl['chunk_fwd_o_opt']\n\ndef cand(q0,k0,v0,g0,b0,scale):\n B,HG,T,K=q0.shape; H=v0.shape[1]; V=v0.shape[-1]\n qn=q0*torch.rsqrt((q0*q0).sum(-1,keepdim=True)+1e-6)\n kn=k0*torch.rsqrt((k0*k0).sum(-1,keepdim=True)+1e-6)\n q=qn.transpose(1,2).contiguous(); k=kn.transpose(1,2).contiguous(); v=v0.transpose(1,2).contiguous()\n gt=g0.float().transpose(1,2).contiguous(); bt=b0.float().transpose(1,2).contiguous()\n G,A=f1(k,bt,gt,use_exp2=False)\n # G [B,H,T], A [B,T,H,64]; deliberately use raw gate for w\n raw_h=gt.transpose(1,2).contiguous()\n w,u=f2(A,k,v,bt,raw_h,use_exp2=False)\n h,vn,fs=fh(k,w,u,g=gt,initial_state=None,output_final_state=False)\n Gt=G.transpose(1,2).contiguous()\n o=fo(q,k,vn,h,g=Gt,scale=scale)\n # qh correction, q heads map h mod HG\n NC=(T+63)//64\n qe=q[:, :, None, :, :].expand(B,T,H//HG,HG,K).reshape(B,T,H,K)\n qp=torch.nn.functional.pad(qe,(0,0,0,0,0,NC*64-T)).reshape(B,NC,64,H,K).permute(0,1,3,2,4)\n inter=torch.matmul(qp,h)[:,:,:,:min(64,T),:] if False else torch.matmul(qp,h)\n # inter B,NC,H,64,V\n inter=inter.permute(0,1,3,2,4).reshape(B,NC*64,H,V)[:,:T]\n fac=(gt.exp()-Gt.exp()).unsqueeze(-1)\n return (o.float()+inter.float()*fac*scale).to(q0.dtype), (G,A,w,u,h,vn,o,inter)\n\ntorch.manual_seed(4)\nfor T,B in [(64,1),(128,1),(131,1),(512,2)]:\n q=torch.randn((B,4,T,128),device='cuda',dtype=torch.bfloat16); k=torch.randn_like(q); v=torch.randn((B,16,T,128),device='cuda',dtype=torch.bfloat16); g=torch.nn.functional.logsigmoid(torch.randn((B,16,T),device='cuda')).to(torch.bfloat16); beta=torch.rand_like(g)\n a=reference.run(q,k,v,g,beta,1/128**.5)\n try:\n  b,z=cand(q,k,v,g,beta,1/128**.5)\n  d=(a.float()-b.float()).abs(); tol=.0023+.0078125*a.float().abs()\n  print('shape',T,B,[tuple(x.shape) for x in z], 'max',d.max().item(),'ratio',(d<=tol).float().mean().item(),'eq',(a==b).float().mean().item())\n  for lo in range(0,T,64):\n   dd=d[:,lo:lo+64]; tt=tol[:,lo:lo+64]; print(' chunk',lo,dd.max().item(),(dd<=tt).float().mean().item())\n except Exception as e:\n  import traceback; traceback.print_exc()\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
