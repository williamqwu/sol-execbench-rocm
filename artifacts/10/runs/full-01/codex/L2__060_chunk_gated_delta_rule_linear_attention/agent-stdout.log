{"type":"item.started","item":{"id":"item_32","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport torch, reference, time\nfrom aiter.ops.triton.gated_delta_net import gated_delta_rule as gm\ngl=gm.chunk_gated_delta_rule_fwd_opt.__globals__; f1=gl['fused_chunk_local_cumsum_scaled_dot_kkt_fwd']; f2=gl['fused_solve_tril_recompute_w_u']; fh=gl['chunk_gated_delta_rule_fwd_h_opt']; fo=gl['chunk_fwd_o_opt']\ndef cand2(query,key,value,g,beta,scale):\n B,HK,T,K=query.shape; H,V=value.shape[1],value.shape[-1]; G=H//HK\n qn=query*torch.rsqrt((query*query).sum(-1,keepdim=True)+1e-6); kn=key*torch.rsqrt((key*key).sum(-1,keepdim=True)+1e-6)\n q=qn.transpose(1,2).contiguous(); k=kn.transpose(1,2).contiguous()\n v=value.reshape(B,G,HK,T,V).permute(0,3,2,1,4).contiguous().reshape(B,T,H,V)\n gate=g.float().reshape(B,G,HK,T).permute(0,3,2,1).contiguous().reshape(B,T,H)\n bet=beta.float().reshape(B,G,HK,T).permute(0,3,2,1).contiguous().reshape(B,T,H)\n gc_h,A=f1(k,bet,gate,use_exp2=False); raw_h=gate.transpose(1,2).contiguous(); w,u=f2(A,k,v,bet,raw_h,use_exp2=False); h,vn,_=fh(k,w,u,g=gate,initial_state=None,output_final_state=False); gc=gc_h.transpose(1,2).contiguous(); o=fo(q,k,vn,h,g=gc,scale=scale)\n NC=(T+63)//64; qp=torch.nn.functional.pad(q,(0,0,0,0,0,NC*64-T)).reshape(B,NC,64,HK,K).permute(0,1,3,2,4).unsqueeze(3); hs=h.reshape(B,NC,HK,G,K,V); qh=torch.matmul(qp,hs) # B,N,HK,G,C,V\n qi=qh.permute(0,1,4,2,3,5).reshape(B,NC*64,H,V)[:,:T]\n ri=(o.float()+qi.float()*(gate.exp()-gc.exp()).unsqueeze(-1)*scale).reshape(B,T,HK,G,V)\n return ri.permute(0,1,3,2,4).reshape(B,T,H,V).to(query.dtype)\nfor T,B in [(131,1),(512,2),(373,8),(2048,2),(128,64)]:\n torch.manual_seed(T+B); q=torch.randn((B,4,T,128),device='cuda',dtype=torch.bfloat16); k=torch.randn_like(q); v=torch.randn((B,16,T,128),device='cuda',dtype=torch.bfloat16); g=torch.nn.functional.logsigmoid(torch.randn((B,16,T),device='cuda')).to(torch.bfloat16); beta=torch.rand_like(g)\n a=reference.run(q,k,v,g,beta,1/128**.5); b=cand2(q,k,v,g,beta,1/128**.5); d=(a.float()-b.float()).abs(); tol=.00245+.0078125*a.float().abs(); print('correct',T,B,d.max().item(),(d<=tol).float().mean().item())\n for fn in (reference.run,cand2):\n  for _ in range(2): fn(q,k,v,g,beta,1/128**.5)\n  s=torch.cuda.Event(enable_timing=True); e=torch.cuda.Event(enable_timing=True); s.record()\n  for _ in range(10): fn(q,k,v,g,beta,1/128**.5)\n  e.record(); e.synchronize(); print('time',getattr(fn,'__module__','x'),s.elapsed_time(e)/10)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
