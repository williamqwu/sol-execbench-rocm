{"type":"item.started","item":{"id":"item_9","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport torch, importlib\nimport reference, kernel\n\ntorch.manual_seed(1)\nfor T,B in [(131,1),(512,2),(128,8)]:\n    shape=(B,4,T,128)\n    q=torch.randn(shape,device='cuda',dtype=torch.bfloat16)\n    k=torch.randn(shape,device='cuda',dtype=torch.bfloat16)\n    v=torch.randn((B,16,T,128),device='cuda',dtype=torch.bfloat16)\n    beta=torch.rand((B,16,T),device='cuda',dtype=torch.bfloat16)\n    for mode in ('neg','raw'):\n        g0=torch.randn((B,16,T),device='cuda',dtype=torch.float32)\n        g=torch.nn.functional.logsigmoid(g0).to(torch.bfloat16) if mode=='neg' else (g0*.1).to(torch.bfloat16)\n        a=reference.run(q,k,v,g,beta,1/128**.5)\n        b=kernel.run(q,k,v,g,beta,1/128**.5)\n        finite=torch.isfinite(a)&torch.isfinite(b)\n        d=(a.float()-b.float()).abs()\n        tol=0.0023+0.0078125*a.float().abs()\n        print(T,B,mode,'max',d[finite].max().item(),'ratio',(d<=tol).float().mean().item(),'equal',(a==b).float().mean().item(), 'finite',finite.float().mean().item())\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
