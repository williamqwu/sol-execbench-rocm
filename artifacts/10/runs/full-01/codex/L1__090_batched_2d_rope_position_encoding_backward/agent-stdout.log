{"type":"item.started","item":{"id":"item_30","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch\nimport triton\nfrom kernel import _rope_backward_kernel, _rope_backward_sincos_kernel\n\ntorch.manual_seed(123)\nn = 8_000_000\ngc = torch.randn(n, device='cuda', dtype=torch.bfloat16)\ngs = torch.randn(n, device='cuda', dtype=torch.bfloat16)\nx = torch.randn(n, device='cuda', dtype=torch.float32)\nout = torch.empty_like(x)\n_rope_backward_sincos_kernel[(triton.cdiv(n, 1024),)](gc, gs, x, out, n_elements=n, BLOCK=1024, num_warps=4)\nref = -gc.float() * torch.sin(x) + gs.float() * torch.cos(x)\ndiff = (out - ref).abs()\nmatched = torch.isclose(out, ref, atol=1.192e-7, rtol=1.192e-7)\nprint('combined max_abs', diff.max().item(), 'max_rel', (diff / ref.abs().clamp_min(1e-30)).max().item(), 'matched', matched.float().mean().item())\nfor kernel in (_rope_backward_kernel, _rope_backward_sincos_kernel):\n    fn = lambda: kernel[(triton.cdiv(n, 1024),)](gc, gs, x, out, n_elements=n, BLOCK=1024, num_warps=4)\n    print(kernel.__name__, triton.testing.do_bench(fn, warmup=20, rep=100))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
