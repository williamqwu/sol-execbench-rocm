 },\n    \"layer_norm1_weight\": {\n      \"shape\": [\n        \"hidden_size\"\n      ],\n      \"dtype\": \"float32\"\n    },\n    \"layer_norm1_bias\": {\n      \"shape\": [\n        \"hidden_size\"\n      ],\n      \"dtype\": \"float32\"\n    },\n    \"cross_t2i_q_weight\": {\n      \"shape\": [\n        \"internal_dim\",\n        \"hidden_size\"\n      ],\n      \"dtype\": \"float32\"\n    },\n    \"cross_t2i_q_bias\": {\n      \"shape\": [\n        \"internal_dim\"\n      ],\n      \"dtype\": \"float32\"\n    },\n    \"cross_t2i_k_weight\": {\n      \"shape\": [\n        \"internal_dim\",\n        \"hidden_size\"\n      ],\n      \"dtype\": \"float32\"\n    },\n    \"cross_t2i_k_bias\": {\n      \"shape\": [\n        \"internal_dim\"\n      ],\n      \"dtype\": \"float32\"\n    },\n    \"cross_t2i_v_weight\": {\n      \"shape\": [\n        \"internal_dim\",\n        \"hidden_size\"\n      ],\n      \"dtype\": \"float32\"\n    },\n    \"cross_t2i_v_bias\": {\n      \"shape\": [\n        \"internal_dim\"\n      ],\n      \"dtype\": \"float32\"\n    },\n    \"cross_t2i_out_weight\": {\n      \"shape\": [\n        \"hidden_size\",\n        \"internal_dim\"\n      ],\n      \"dtype\": \"float32\"\n    },\n    \"cross_t2i_out_bias\": {\n      \"shape\": [\n        \"hidden_size\"\n      ],\n      \"dtype\": \"float32\"\n    },\n    \"layer_norm2_weight\": {\n      \"shape\": [\n        \"hidden_size\"\n      ],\n      \"dtype\": \"float32\"\n    },\n    \"layer_norm2_bias\": {\n      \"shape\": [\n        \"hidden_size\"\n      ],\n      \"dtype\": \"float32\"\n    },\n    \"mlp_lin1_weight\": {\n      \"shape\": [\n        \"mlp_dim\",\n        \"hidden_size\"\n      ],\n      \"dtype\": \"float32\"\n    },\n    \"mlp_lin1_bias\": {\n      \"shape\": [\n        \"mlp_dim\"\n      ],\n      \"dtype\": \"float32\"\n    },\n    \"mlp_lin2_weight\": {\n      \"shape\": [\n        \"hidden_size\",\n        \"mlp_dim\"\n      ],\n      \"dtype\": \"float32\"\n    },\n    \"mlp_lin2_bias\": {\n      \"shape\": [\n        \"hidden_size\"\n      ],\n      \"dtype\": \"float32\"\n    },\n    \"layer_norm3_weight\": {\n      \"shape\": [\n        \"hidden_size\"\n      ],\n      \"dtype\": \"float32\"\n    },\n    \"layer_norm3_bias\": {\n      \"shape\": [\n        \"hidden_size\"\n      ],\n      \"dtype\": \"float32\"\n    },\n    \"cross_i2t_q_weight\": {\n      \"shape\": [\n        \"internal_dim\",\n        \"hidden_size\"\n      ],\n      \"dtype\": \"float32\"\n    },\n    \"cross_i2t_q_bias\": {\n      \"shape\": [\n        \"internal_dim\"\n      ],\n      \"dtype\": \"float32\"\n    },\n    \"cross_i2t_k_weight\": {\n      \"shape\": [\n        \"internal_dim\",\n        \"hidden_size\"\n      ],\n      \"dtype\": \"float32\"\n    },\n    \"cross_i2t_k_bias\": {\n      \"shape\": [\n        \"internal_dim\"\n      ],\n      \"dtype\": \"float32\"\n    },\n    \"cross_i2t_v_weight\": {\n      \"shape\": [\n        \"internal_dim\",\n        \"hidden_size\"\n      ],\n      \"dtype\": \"float32\"\n    },\n    \"cross_i2t_v_bias\": {\n      \"shape\": [\n        \"internal_dim\"\n      ],\n      \"dtype\": \"float32\"\n    },\n    \"cross_i2t_out_weight\": {\n      \"shape\": [\n        \"hidden_size\",\n        \"internal_dim\"\n      ],\n      \"dtype\": \"float32\"\n    },\n    \"cross_i2t_out_bias\": {\n      \"shape\": [\n        \"hidden_size\"\n      ],\n      \"dtype\": \"float32\"\n    },\n    \"layer_norm4_weight\": {\n      \"shape\": [\n        \"hidden_size\"\n      ],\n      \"dtype\": \"float32\"\n    },\n    \"layer_norm4_bias\": {\n      \"shape\": [\n        \"hidden_size\"\n      ],\n      \"dtype\": \"float32\"\n    },\n    \"skip_first_layer_pe\": {\n      \"shape\": null,\n      \"dtype\": \"bool\",\n      \"description\": \"Whether to skip positional embedding in first self-attention\"\n    }\n  },\n  \"outputs\": {\n    \"output_queries\": {\n      \"shape\": [\n        \"batch_size\",\n        \"point_batch_size\",\n        \"n_query_tokens\",\n        \"hidden_size\"\n      ],\n      \"dtype\": \"float32\",\n      \"description\": \"Updated sparse prompt token embeddings\"\n    },\n    \"output_keys\": {\n      \"shape\": [\n        \"batch_size\",\n        \"point_batch_size\",\n        \"n_key_tokens\",\n        \"hidden_size\"\n      ],\n      \"dtype\": \"float32\",\n      \"description\": \"Updated dense image embeddings\"\n    }\n  },\n  \"reference\": \"import torch\\nimport torch.nn.functional as F\\n\\n@torch.no_grad()\\ndef run(\\n    queries: torch.Tensor,\\n    keys: torch.Tensor,\\n    query_point_embedding: torch.Tensor,\\n    key_point_embedding: torch.Tensor,\\n    self_attn_q_weight: torch.Tensor,\\n    self_attn_q_bias: torch.Tensor,\\n    self_attn_k_weight: torch.Tensor,\\n    self_attn_k_bias: torch.Tensor,\\n    self_attn_v_weight: torch.Tensor,\\n    self_attn_v_bias: torch.Tensor,\\n    self_attn_out_weight: torch.Tensor,\\n    self_attn_out_bias: torch.Tensor,\\n    layer_norm1_weight: torch.Tensor,\\n    layer_norm1_bias: torch.Tensor,\\n    cross_t2i_q_weight: torch.Tensor,\\n    cross_t2i_q_bias: torch.Tensor,\\n    cross_t2i_k_weight: torch.Tensor,\\n    cross_t2i_k_bias: torch.Tensor,\\n    cross_t2i_v_weight: torch.Tensor,\\n    cross_t2i_v_bias: torch.Tensor,\\n    cross_t2i_out_weight: torch.Tensor,\\n    cross_t2i_out_bias: torch.Tensor,\\n    layer_norm2_weight: torch.Tensor,\\n    layer_norm2_bias: torch.Tensor,\\n    mlp_lin1_weight: torch.Tensor,\\n    mlp_lin1_bias: torch.Tensor,\\n    mlp_lin2_weight: torch.Tensor,\\n    mlp_lin2_bias: torch.Tensor,\\n    layer_norm3_weight: torch.Tensor,\\n    layer_norm3_bias: torch.Tensor,\\n    cross_i2t_q_weight: torch.Tensor,\\n    cross_i2t_q_bias: torch.Tensor,\\n    cross_i2t_k_weight: torch.Tensor,\\n    cross_i2t_k_bias: torch.Tensor,\\n    cross_i2t_v_weight: torch.Tensor,\\n    cross_i2t_v_bias: torch.Tensor,\\n    cross_i2t_out_weight: torch.Tensor,\\n    cross_i2t_out_bias: torch.Tensor,\\n    layer_norm4_weight: torch.Tensor,\\n    layer_norm4_bias: torch.Tensor,\\n    skip_first_layer_pe: bool,\\n):\\n    batch_size, point_batch_size, n_query_tokens, hidden_size = queries.shape\\n    _, _, n_key_tokens, _ = keys.shape\\n    num_heads = 8\\n    head_dim_self = hidden_size // num_heads  # 32 for self-attention\\n    internal_dim = 128\\n    head_dim_cross = internal_dim // num_heads  # 16 for cross-attention\\n    eps = 1e-6\\n    \\n    def separate_heads(x, num_heads, head_dim):\\n        # x: (batch, point_batch, n_tokens, channel)\\n        b, pb, n, c = x.shape\\n        x = x.reshape(b * pb, n, num_heads, head_dim)\\n        return x.transpose(1, 2)  # (b*pb, num_heads, n, head_dim)\\n    \\n    def recombine_heads(x, point_batch_size):\\n        # x: (b*pb, num_heads, n, head_dim)\\n        bpb, nh, n, hd = x.shape\\n        b = bpb // point_batch_size\\n        return x.transpose(1, 2).reshape(b, point_batch_size, n, nh * hd)\\n    \\n    def attention(q, k, v, num_heads, head_dim, point_batch_size):\\n        scaling = head_dim ** -0.5\\n        q = separate_heads(q, num_heads, head_dim)\\n        k = separate_heads(k, num_heads, head_dim)\\n        v = separate_heads(v, num_heads, head_dim)\\n        attn_weights = torch.matmul(q, k.transpose(-2, -1)) * scaling\\n        attn_weights = F.softmax(attn_weights, dim=-1, dtype=torch.float32).to(q.dtype)\\n        attn_output = torch.matmul(attn_weights, v)\\n        return recombine_heads(attn_output, point_batch_size)\\n    \\n    def layer_norm(x, weight, bias):\\n        mean = x.mean(dim=-1, keepdim=True)\\n        var = ((x - mean) ** 2).mean(dim=-1, keepdim=True)\\n        return (x - mean) / torch.sqrt(var + eps) * weight + bias\\n    \\n    # 1. Self-attention on queries\\n    if skip_first_layer_pe:\\n        q_input = queries\\n    else:\\n        q_input = queries + query_point_embedding\\n    \\n    q_proj = F.linear(q_input, self_attn_q_weight, self_attn_q_bias)\\n    k_proj = F.linear(q_input, self_attn_k_weight, self_attn_k_bias)\\n    v_proj = F.linear(queries, self_attn_v_weight, self_attn_v_bias)\\n    \\n    attn_out = attention(q_proj, k_proj, v_proj, num_heads, head_dim_self, point_batch_size)\\n    attn_out = F.linear(attn_out, self_attn_out_weight, self_attn_out_bias)\\n    queries = queries + attn_out\\n    queries = layer_norm(queries, layer_norm1_weight, layer_norm1_bias)\\n    \\n    # 2. Cross-attention: tokens -> image\\n    q_input = queries + query_point_embedding\\n    k_input = keys + key_point_embedding\\n    \\n    q_proj = F.linear(q_input, cross_t2i_q_weight, cross_t2i_q_bias)\\n    k_proj = F.linear(k_input, cross_t2i_k_weight, cross_t2i_k_bias)\\n    v_proj = F.linear(keys, cross_t2i_v_weight, cross_t2i_v_bias)\\n    \\n    attn_out = attention(q_proj, k_proj, v_proj, num_heads, head_dim_cross, point_batch_size)\\n    attn_out = F.linear(attn_out, cross_t2i_out_weight, cross_t2i_out_bias)\\n    queries = queries + attn_out\\n    queries = layer_norm(queries, layer_norm2_weight, layer_norm2_bias)\\n    \\n    # 3. MLP block\\n    mlp_out = F.linear(queries, mlp_lin1_weight, mlp_lin1_bias)\\n    mlp_out = F.relu(mlp_out)\\n    mlp_out = F.linear(mlp_out, mlp_lin2_weight, mlp_lin2_bias)\\n    queries = queries + mlp_out\\n    queries = layer_norm(queries, layer_norm3_weight, layer_norm3_bias)\\n    \\n    # 4. Cross-attention: image -> tokens\\n    q_input = queries + query_point_embedding\\n    k_input = keys + key_point_embedding\\n    \\n    # Note: q is from keys (image), k is from queries (tokens)\\n    q_proj = F.linear(k_input, cross_i2t_q_weight, cross_i2t_q_bias)\\n    k_proj = F.linear(q_input, cross_i2t_k_weight, cross_i2t_k_bias)\\n    v_proj = F.linear(queries, cross_i2t_v_weight, cross_i2t_v_bias)\\n    \\n    attn_out = attention(q_proj, k_proj, v_proj, num_heads, head_dim_cross, point_batch_size)\\n    attn_out = F.linear(attn_out, cross_i2t_out_weight, cross_i2t_out_bias)\\n    keys = keys