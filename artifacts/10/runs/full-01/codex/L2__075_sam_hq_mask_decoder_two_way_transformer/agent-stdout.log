{"type":"item.completed","item":{"id":"item_11","type":"agent_message","text":"Whole-graph compilation cuts latency to about 0.31 ms, but it replaces several small rocBLAS GEMMs with numerically different Triton GEMMs and misses the tolerance badly. I’m narrowing compilation to launch-heavy pointwise/reduction regions while keeping every matrix multiply on the same eager backend as the reference."}}
{"type":"item.started","item":{"id":"item_12","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport time, torch\n\ndef eager_ln(x, w, b):\n    mean = x.mean(-1, keepdim=True)\n    var = ((x - mean) ** 2).mean(-1, keepdim=True)\n    return (x - mean) / torch.sqrt(var + 1e-6) * w + b\n\ndef fused_ln(x, residual, w, b):\n    x = x + residual\n    mean = x.mean(-1, keepdim=True)\n    var = ((x - mean) ** 2).mean(-1, keepdim=True)\n    return (x - mean) / torch.sqrt(var + 1e-6) * w + b\n\ncompiled_ln = torch.compile(eager_ln, fullgraph=True, dynamic=True)\ncompiled_fused = torch.compile(fused_ln, fullgraph=True, dynamic=True)\nfor rows in [4, 12, 64, 4096, 8192, 65536]:\n    torch.manual_seed(rows)\n    x = torch.randn(rows,256,device='cuda'); r = torch.randn_like(x)\n    w = torch.randn(256,device='cuda'); b = torch.randn(256,device='cuda')\n    a=eager_ln(x+r,w,b); c=compiled_fused(x,r,w,b)\n    d=(a-c).abs(); tol=torch.finfo(torch.float32).eps*(1+a.abs())\n    for fn,label in [(lambda: eager_ln(x+r,w,b),'eager'),(lambda: compiled_fused(x,r,w,b),'fused')]:\n      for _ in range(5): fn()\n      torch.cuda.synchronize(); t=time.perf_counter()\n      for _ in range(100): fn()\n      torch.cuda.synchronize(); ms=(time.perf_counter()-t)*10\n      if label=='fused': print(rows, 'max',d.max().item(),'exact',(d==0).float().mean().item(),'within',(d<=tol).float().mean().item(),'eager/fused_ms',prev,ms)\n      else: prev=ms\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
