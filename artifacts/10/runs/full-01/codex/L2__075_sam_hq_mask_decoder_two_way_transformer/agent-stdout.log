{"type":"item.started","item":{"id":"item_9","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport json, time, torch, importlib.util\n\nspec = importlib.util.spec_from_file_location('candidate', 'kernel.py')\ncandidate = importlib.util.module_from_spec(spec); spec.loader.exec_module(candidate)\nspec = importlib.util.spec_from_file_location('reference', 'reference.py')\nreference = importlib.util.module_from_spec(spec); spec.loader.exec_module(reference)\nwith open('definition.json') as f: definition = json.load(f)\naxes = {'batch_size': 2, 'point_batch_size': 1, 'n_query_tokens': 6, 'n_key_tokens': 4096,\n        'hidden_size': 256, 'internal_dim': 128, 'mlp_dim': 2048, 'num_attention_heads': 8}\nargs = []\ntorch.manual_seed(7)\nfor name, desc in definition['inputs'].items():\n    if name == 'skip_first_layer_pe':\n        args.append(True)\n    else:\n        shape = tuple(axes.get(x, x) if isinstance(x, str) else x for x in desc['shape'])\n        args.append(torch.randn(shape, device='cuda', dtype=torch.float32))\ncompiled = torch.compile(candidate.run, fullgraph=True, dynamic=False)\nfor fn, label in [(reference.run, 'ref'), (compiled, 'compiled')]:\n    torch.cuda.synchronize(); t0 = time.perf_counter(); out = fn(*args); torch.cuda.synchronize()\n    print(label, 'first_s', time.perf_counter()-t0)\n    for _ in range(5): out = fn(*args)\n    torch.cuda.synchronize(); t0 = time.perf_counter()\n    for _ in range(100): out = fn(*args)\n    torch.cuda.synchronize(); print(label, 'ms', (time.perf_counter()-t0)*10)\nr = reference.run(*args)\nc = compiled(*args)\nfor i, (x, y) in enumerate(zip(r, c)):\n    d = (x-y).abs(); tol = torch.finfo(torch.float32).eps * (1 + y.abs())\n    print(i, 'max_abs', d.max().item(), 'exact', (d==0).float().mean().item(), 'within', (d <= tol).float().mean().item())\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
