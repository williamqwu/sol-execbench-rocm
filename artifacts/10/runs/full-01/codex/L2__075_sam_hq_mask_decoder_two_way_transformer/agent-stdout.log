{"type":"item.started","item":{"id":"item_41","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport time,torch,torch.nn.functional as F\nfor m in [1024,4096,8192,16384,65536]:\n torch.manual_seed(m);x=torch.randn(m,256,device='cuda');w1=torch.randn(128,256,device='cuda');w2=torch.randn(128,256,device='cuda');b1=torch.randn(128,device='cuda');b2=torch.randn(128,device='cuda')\n a=F.linear(x,w1,b1);b=F.linear(x,w2,b2);wc=torch.cat((w1,w2));bc=torch.cat((b1,b2));c=F.linear(x,wc,bc);torch.cuda.synchronize()\n d1=(a-c[:,:128]).abs();d2=(b-c[:,128:]).abs()\n def sep():return F.linear(x,w1,b1),F.linear(x,w2,b2)\n def comb():\n  return F.linear(x,torch.cat((w1,w2)),torch.cat((b1,b2)))\n for fn,n in [(sep,'sep'),(comb,'comb')]:\n  for _ in range(10):fn()\n  torch.cuda.synchronize();t=time.perf_counter()\n  for _ in range(100):fn()\n  torch.cuda.synchronize();v=(time.perf_counter()-t)*10\n  if n=='sep':s=v\n  else:q=v\n print(m,'exact',float((d1==0).float().mean()),float((d2==0).float().mean()),'max',d1.max().item(),d2.max().item(),'ms',s,q)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
