{"type":"item.started","item":{"id":"item_44","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport gc,torch,triton,aiter,kernel\nN=24576\nfor M in [128,2048,8192]:\n inp=torch.randn((M,2*N),device='cuda',dtype=torch.bfloat16); out=torch.empty((M,N),device='cuda',dtype=torch.bfloat16)\n aiter.gelu_tanh_and_mul(out,inp); torch.cuda.synchronize()\n g=inp[:,:N]; u=inp[:,N:]\n ref=(0.5*g.float()*(1+torch.tanh(0.7978845608028654*(g.float()+0.044715*g.float().pow(3))))).bfloat16()*u\n print(M,'equal',(out==ref).float().mean().item(),'close',torch.isclose(out,ref,atol=.0051,rtol=.0078125).float().mean().item(),'max',(out.float()-ref.float()).abs().max().item(),flush=True)\n t=triton.testing.do_bench(lambda:aiter.gelu_tanh_and_mul(out,inp),warmup=10,rep=30)\n # Compare our kernel with equivalent separate contiguous buffers.\n gs=g.contiguous(); us=u.contiguous(); oo=torch.empty_like(gs); n=gs.numel()\n f=lambda:kernel._swiglu_kernel[(triton.cdiv(n,1024),)](gs,us,oo,n_elements=n,BLOCK=1024,num_warps=2)\n tt=triton.testing.do_bench(f,warmup=10,rep=30)\n print(M,'aiter',round(t,4),'triton',round(tt,4),flush=True)\n del inp,out,g,u,ref,gs,us,oo; gc.collect()\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
