{"type":"item.started","item":{"id":"item_21","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch, triton, kernel\n# Accuracy over the transition region and over realistic wide GEMM outputs.\nfor scale in [1.0, 8.0, 50.0]:\n n=1_000_000\n g=(torch.randn(n,device='cuda')*scale).bfloat16(); u=torch.randn(n,device='cuda',dtype=torch.bfloat16); o=torch.empty_like(g)\n kernel._swiglu_fast_kernel[(triton.cdiv(n,1024),)](g,u,o,n_elements=n,BLOCK=1024,num_warps=8)\n ref=(0.5*g.float()*(1+torch.tanh(0.7978845608028654*(g.float()+0.044715*g.float().pow(3))))).bfloat16()*u\n close=torch.isclose(o,ref,atol=.00509,rtol=.0078125)\n print('scale',scale,'equal',round((o==ref).float().mean().item(),6),'close',round(close.float().mean().item(),6),'max',round((o.float()-ref.float()).abs().max().item(),6),flush=True)\n del g,u,o,ref,close\n# Large-shape epilogue benchmark.\nn=8192*24576\ng=torch.randn(n,device='cuda',dtype=torch.bfloat16); u=torch.randn(n,device='cuda',dtype=torch.bfloat16); o=torch.empty_like(g)\nfor label,fn in [('exact',kernel._swiglu_kernel),('fast',kernel._swiglu_fast_kernel)]:\n for b,w in [(256,4),(512,4),(1024,4),(1024,8),(2048,8)]:\n  call=lambda fn=fn,b=b,w=w: fn[(triton.cdiv(n,b),)](g,u,o,n_elements=n,BLOCK=b,num_warps=w)\n  try: print(label,b,w,round(triton.testing.do_bench(call,warmup=10,rep=30),4),flush=True)\n  except Exception as e: print(label,b,w,type(e).__name__,e,flush=True)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
