{"type":"item.started","item":{"id":"item_23","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport gc, torch, triton, kernel\nN,K=24576,3072\nwg=torch.randn((N,K),device='cuda',dtype=torch.bfloat16)\nwu=torch.randn((N,K),device='cuda',dtype=torch.bfloat16)\ns1=torch.cuda.Stream(); s2=torch.cuda.Stream()\ndef epi(g,u):\n o=torch.empty_like(g); n=g.numel(); kernel._swiglu_kernel[(triton.cdiv(n,1024),)](g,u,o,n_elements=n,BLOCK=1024,num_warps=4); return o\ndef serial(x): return epi(torch.mm(x,wg.T),torch.mm(x,wu.T))\ndef parallel(x):\n cur=torch.cuda.current_stream(); s1.wait_stream(cur); s2.wait_stream(cur)\n with torch.cuda.stream(s1): g=torch.mm(x,wg.T)\n with torch.cuda.stream(s2): u=torch.mm(x,wu.T)\n cur.wait_stream(s1); cur.wait_stream(s2)\n g.record_stream(cur); u.record_stream(cur)\n return epi(g,u)\nfor M in [128,256,512,1024,2048,4096,8192]:\n x=torch.randn((M,K),device='cuda',dtype=torch.bfloat16)\n # Confirm synchronization/lifetime logic and numerical identity once.\n a=serial(x); b=parallel(x); torch.cuda.synchronize(); assert torch.equal(a,b)\n ts=triton.testing.do_bench(lambda:serial(x),warmup=10,rep=30)\n tp=triton.testing.do_bench(lambda:parallel(x),warmup=10,rep=30)\n print(M,'serial',round(ts,4),'parallel',round(tp,4),'ratio',round(tp/ts,3),flush=True)\n del x,a,b; gc.collect()\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
