{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' definition.json && sed -n '1,260p' reference.py && sed -n '1,240p' workload.jsonl\"","aggregated_output":"{\n  \"name\": \"048_fused_gate_up_projection_with_swiglu\",\n  \"description\": \"Gemma3's fused gate and up projection followed by GELU-tanh activation and element-wise multiplication. Computes gelu_tanh(x @ gate_proj.T) * (x @ up_proj.T) where gate_proj and up_proj are weight matrices. This fuses two parallel linear projections from hidden_size=3072 to intermediate_size=24576, followed by GELU activation on gate output and element-wise multiplication with up output.\",\n  \"hf_id\": \"google/gemma-3-12b-it\",\n  \"custom_inputs_entrypoint\": null,\n  \"axes\": {\n    \"batch_size\": {\n      \"type\": \"var\",\n      \"description\": \"Batch size\"\n    },\n    \"seq_len\": {\n      \"type\": \"var\",\n      \"description\": \"Sequence length\"\n    },\n    \"hidden_size\": {\n      \"type\": \"const\",\n      \"value\": 3072,\n      \"description\": \"Input hidden dimension\"\n    },\n    \"intermediate_size\": {\n      \"type\": \"const\",\n      \"value\": 24576,\n      \"description\": \"Intermediate MLP dimension\"\n    }\n  },\n  \"inputs\": {\n    \"x\": {\n      \"shape\": [\n        \"batch_size\",\n        \"seq_len\",\n        \"hidden_size\"\n      ],\n      \"dtype\": \"bfloat16\",\n      \"description\": \"Input hidden states\"\n    },\n    \"gate_proj\": {\n      \"shape\": [\n        \"intermediate_size\",\n        \"hidden_size\"\n      ],\n      \"dtype\": \"bfloat16\",\n      \"description\": \"Gate projection weight matrix\"\n    },\n    \"up_proj\": {\n      \"shape\": [\n        \"intermediate_size\",\n        \"hidden_size\"\n      ],\n      \"dtype\": \"bfloat16\",\n      \"description\": \"Up projection weight matrix\"\n    }\n  },\n  \"outputs\": {\n    \"output\": {\n      \"shape\": [\n        \"batch_size\",\n        \"seq_len\",\n        \"intermediate_size\"\n      ],\n      \"dtype\": \"bfloat16\",\n      \"description\": \"Output after fused gate-up projection with GELU-tanh activation\"\n    }\n  },\n  \"reference\": \"import torch\\nimport math\\n\\n@torch.no_grad()\\ndef run(x: torch.Tensor, gate_proj: torch.Tensor, up_proj: torch.Tensor) -> torch.Tensor:\\n    \\\"\\\"\\\"\\n    Fused gate and up projection with GELU-tanh activation.\\n    \\n    Computes: gelu_tanh(x @ gate_proj.T) * (x @ up_proj.T)\\n    \\n    Args:\\n        x: Input tensor of shape (batch_size, seq_len, hidden_size)\\n        gate_proj: Gate projection weights of shape (intermediate_size, hidden_size)\\n        up_proj: Up projection weights of shape (intermediate_size, hidden_size)\\n    \\n    Returns:\\n        Output tensor of shape (batch_size, seq_len, intermediate_size)\\n    \\\"\\\"\\\"\\n    # Compute gate projection: x @ gate_proj.T\\n    # x: (batch_size, seq_len, hidden_size)\\n    # gate_proj: (intermediate_size, hidden_size)\\n    # gate_output: (batch_size, seq_len, intermediate_size)\\n    gate_output = torch.matmul(x, gate_proj.t())\\n    \\n    # Compute up projection: x @ up_proj.T\\n    # up_output: (batch_size, seq_len, intermediate_size)\\n    up_output = torch.matmul(x, up_proj.t())\\n    \\n    # Apply GELU with tanh approximation to gate output\\n    # GELU_tanh(x) = 0.5 * x * (1 + tanh(sqrt(2/pi) * (x + 0.044715 * x^3)))\\n    sqrt_2_over_pi = math.sqrt(2.0 / math.pi)\\n    gate_float = gate_output.to(torch.float32)\\n    inner = sqrt_2_over_pi * (gate_float + 0.044715 * gate_float.pow(3))\\n    activated_gate = 0.5 * gate_float * (1.0 + torch.tanh(inner))\\n    activated_gate = activated_gate.to(gate_output.dtype)\\n    \\n    # Element-wise multiplication: activated_gate * up_output\\n    output = activated_gate * up_output\\n    \\n    return output\\n\"\n}\nimport torch\nimport math\n\n@torch.no_grad()\ndef run(x: torch.Tensor, gate_proj: torch.Tensor, up_proj: torch.Tensor) -> torch.Tensor:\n    \"\"\"\n    Fused gate and up projection with GELU-tanh activation.\n    \n    Computes: gelu_tanh(x @ gate_proj.T) * (x @ up_proj.T)\n    \n    Args:\n        x: Input tensor of shape (batch_size, seq_len, hidden_size)\n        gate_proj: Gate projection weights of shape (intermediate_size, hidden_size)\n        up_proj: Up projection weights of shape (intermediate_size, hidden_size)\n    \n    Returns:\n        Output tensor of shape (batch_size, seq_len, intermediate_size)\n    \"\"\"\n    # Compute gate projection: x @ gate_proj.T\n    # x: (batch_size, seq_len, hidden_size)\n    # gate_proj: (intermediate_size, hidden_size)\n    # gate_output: (batch_size, seq_len, intermediate_size)\n    gate_output = torch.matmul(x, gate_proj.t())\n    \n    # Compute up projection: x @ up_proj.T\n    # up_output: (batch_size, seq_len, intermediate_size)\n    up_output = torch.matmul(x, up_proj.t())\n    \n    # Apply GELU with tanh approximation to gate output\n    # GELU_tanh(x) = 0.5 * x * (1 + tanh(sqrt(2/pi) * (x + 0.044715 * x^3)))\n    sqrt_2_over_pi = math.sqrt(2.0 / math.pi)\n    gate_float = gate_output.to(torch.float32)\n    inner = sqrt_2_over_pi * (gate_float + 0.044715 * gate_float.pow(3))\n    activated_gate = 0.5 * gate_float * (1.0 + torch.tanh(inner))\n    activated_gate = activated_gate.to(gate_output.dtype)\n    \n    # Element-wise multiplication: activated_gate * up_output\n    output = activated_gate * up_output\n    \n    return output\n{\"uuid\": \"bee6b47b-d132-521a-aa83-5c457ea5972d\", \"axes\": {\"batch_size\": 2, \"seq_len\": 1321}, \"inputs\": {\"x\": {\"type\": \"random\"}, \"gate_proj\": {\"type\": \"random\"}, \"up_proj\": {\"type\": \"random\"}}, \"tolerance\": {\"max_atol\": 0.005090089523819051, \"max_rtol\": 0.0078125, \"required_matched_ratio\": 0.99, \"_provenance\": \"max run-to-run error over 10 seeds x 1.25 margin, floored at torch.bfloat16 epsilon\"}}\n{\"uuid\": \"c660291d-9328-570e-9f96-f345c69603a6\", \"axes\": {\"batch_size\": 2, \"seq_len\": 128}, \"inputs\": {\"x\": {\"type\": \"random\"}, \"gate_proj\": {\"type\": \"random\"}, \"up_proj\": {\"type\": \"random\"}}, \"tolerance\": {\"max_atol\": 0.005100233971196039, \"max_rtol\": 0.0078125, \"required_matched_ratio\": 0.99, \"_provenance\": \"max run-to-run error over 10 seeds x 1.25 margin, floored at torch.bfloat16 epsilon\"}}\n{\"uuid\": \"bd6deba6-cbe1-574f-b413-a4b494b3c19a\", \"axes\": {\"batch_size\": 64, \"seq_len\": 128}, \"inputs\": {\"x\": {\"type\": \"random\"}, \"gate_proj\": {\"type\": \"random\"}, \"up_proj\": {\"type\": \"random\"}}, \"tolerance\": {\"max_atol\": 0.005094236169621066, \"max_rtol\": 0.0078125, \"required_matched_ratio\": 0.99, \"_provenance\": \"max run-to-run error over 10 seeds x 1.25 margin, floored at torch.bfloat16 epsilon\"}}\n{\"uuid\": \"574db0e9-87d6-591c-bc0a-de69fd6fea4c\", \"axes\": {\"batch_size\": 1, \"seq_len\": 8192}, \"inputs\": {\"x\": {\"type\": \"random\"}, \"gate_proj\": {\"type\": \"random\"}, \"up_proj\": {\"type\": \"random\"}}, \"tolerance\": {\"max_atol\": 0.005094236169621066, \"max_rtol\": 0.0078125, \"required_matched_ratio\": 0.99, \"_provenance\": \"max run-to-run error over 10 seeds x 1.25 margin, floored at torch.bfloat16 epsilon\"}}\n{\"uuid\": \"a7af5eee-45cc-5493-96f9-c77c390ea42a\", \"axes\": {\"batch_size\": 4, \"seq_len\": 256}, \"inputs\": {\"x\": {\"type\": \"random\"}, \"gate_proj\": {\"type\": \"random\"}, \"up_proj\": {\"type\": \"random\"}}, \"tolerance\": {\"max_atol\": 0.0050968933126814475, \"max_rtol\": 0.0078125, \"required_matched_ratio\": 0.99, \"_provenance\": \"max run-to-run error over 10 seeds x 1.25 margin, floored at torch.bfloat16 epsilon\"}}\n{\"uuid\": \"84a83d4c-e0a9-5b4b-a639-20f9d68ebcfc\", \"axes\": {\"batch_size\": 4, \"seq_len\": 449}, \"inputs\": {\"x\": {\"type\": \"random\"}, \"gate_proj\": {\"type\": \"random\"}, \"up_proj\": {\"type\": \"random\"}}, \"tolerance\": {\"max_atol\": 0.0050951253754297834, \"ma