{"type":"item.started","item":{"id":"item_29","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch,triton\nimport kernel\nfrom reference import run as ref\nshape=(2,32,128,128); N,C,H,W=shape; S=H*W; NC=N*C; at=6.071973495283414e-7; rt=1.1920928955078125e-7\ntorch.manual_seed(1); go=torch.randn(shape,device='cuda'); x=torch.randn(shape,device='cuda'); w=torch.randn(32,device='cuda'); m=torch.randn((N,C,1,1),device='cuda'); s=torch.randn((N,C,1,1),device='cuda'); target=ref(go,x,w,m,s)[0]; xc=x-m; gos=go*w.view(1,C,1,1)\nesv=(gos*xc).sum((2,3)); esm=(gos/(-s)).sum((2,3)); esc=((-2.)*xc).sum((2,3))\ndef make(sv,sm,sc):\n gv=sv.view(N,C,1,1)*(-.5)*torch.pow(s,-3); gm=sm.view(N,C,1,1)+gv*sc.view(N,C,1,1)/S\n out=gos/s; out=out+gv*2.*xc/S; out=out+gm/S\n return torch.isclose(out,target,atol=at,rtol=rt).float().mean().item()\nfor B in (256,512,1024,2048,4096,8192,16384):\n nb=triton.cdiv(S,B); p=torch.empty((5,NC,nb),device='cuda'); kernel._partial_reduce[(NC*nb,)](go,x,w,m,s,p,SPATIAL=S,NCHUNKS=nb,BLOCK=B,num_warps=8)\n vals=[p[i].sum(-1) for i in range(5)]; sv,sm,sc=vals[2],vals[3],vals[4]\n print('B',B,'all',make(sv,sm,sc),'v',make(sv,esm,esc),'m',make(esv,sm,esc),'c',make(esv,esm,sc),'vm',make(sv,sm,esc),'vc',make(sv,esm,sc),'mc',make(esv,sm,sc))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
