{"type":"item.started","item":{"id":"item_66","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch,triton,reference,kernel\nfor B,T in [(8,1024),(64,1721)]:\n x=reference.get_inputs({'batch_size':B,'seq_len':T,'hidden_size':512,'head_dim':64,'num_timescales':256},torch.device('cuda'));w=torch.cat((x['q_proj_weight'],x['k_proj_weight'],x['v_proj_weight']),0);qkv=x['hidden_states']@w.T;nb=(T+31)//32;kt=torch.empty(B,8,nb,64,160,device='cuda');vv=torch.empty(B,nb,8,160,64,device='cuda');valid=torch.empty(B,nb,160,device='cuda',dtype=torch.bool)\n for bc in (8,16,32,64):\n  for nw in (4,8):\n   try:\n    grid=(B*8*nb,triton.cdiv(160,bc));\n    for _ in range(3):kernel._pack_context[grid](qkv,x['mask'],kt,vv,valid,T,nb,BLOCK_C=bc,num_warps=nw)\n    torch.cuda.synchronize();a=torch.cuda.Event(True);z=torch.cuda.Event(True);a.record()\n    for _ in range(10):kernel._pack_context[grid](qkv,x['mask'],kt,vv,valid,T,nb,BLOCK_C=bc,num_warps=nw)\n    z.record();z.synchronize();print(B,T,bc,nw,round(a.elapsed_time(z)/10,4))\n   except Exception as e:print('ERR',bc,nw,type(e).__name__,str(e).splitlines()[-1])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
