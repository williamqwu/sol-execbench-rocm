{"type":"item.started","item":{"id":"item_9","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch\nimport kernel\nfor b,s in [(1,131),(2,211),(4,128),(1,449),(1,512),(1,1024),(1,2048),(1,4096),(16,512)]:\n    x=torch.randn(b,s,2048,device='cuda',dtype=torch.bfloat16)\n    q=torch.randn(2048,2048,device='cuda',dtype=torch.bfloat16)\n    k=torch.randn(512,2048,device='cuda',dtype=torch.bfloat16)\n    v=torch.randn(512,2048,device='cuda',dtype=torch.bfloat16)\n    try:\n        got=kernel.run(x,q,k,v)\n        ref=(x@q.T,x@k.T,x@v.T)\n        got_flat=[z.transpose(1,2).reshape(b*s,-1) for z in got]\n        torch.cuda.synchronize()\n        ratios=[]; maxes=[]\n        for a,c in zip(got_flat,ref):\n            d=(a.float()-c.float()).abs(); ok=(d <= 0.0078125 + 0.0078125*c.float().abs())\n            ratios.append(ok.float().mean().item()); maxes.append(d.max().item())\n        print((b,s), ratios, maxes)\n    except Exception as e:\n        print(type(e).__name__,e)\n        raise\n    if b*s>=512: break\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
