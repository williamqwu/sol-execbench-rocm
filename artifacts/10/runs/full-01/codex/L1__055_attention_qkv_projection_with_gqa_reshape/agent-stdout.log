{"type":"item.started","item":{"id":"item_31","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch,aiter,time\naiter.hipb_create_extension()\nx=torch.randn(131,2048,device='cuda',dtype=torch.bfloat16); w=torch.randn(2048,3072,device='cuda',dtype=torch.bfloat16)\nsols=aiter.hipb_findallsols(x,w)\nfor i in sols[:8]:\n try:\n  y=aiter.hipb_mm(x,w,i); torch.cuda.synchronize(); d=(y-(x@w)).abs().max();\n  for _ in range(5):aiter.hipb_mm(x,w,i)\n  a=torch.cuda.Event(True);b=torch.cuda.Event(True);a.record()\n  for _ in range(50):aiter.hipb_mm(x,w,i)\n  b.record();b.synchronize(); print(i,y.shape,d.item(),a.elapsed_time(b)/50,aiter.getHipblasltKernelName(i))\n except Exception as e: print('ERR',i,e)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
