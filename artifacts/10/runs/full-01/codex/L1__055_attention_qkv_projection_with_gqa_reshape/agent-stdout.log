{"type":"item.started","item":{"id":"item_6","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch\n\ndef base(x,q,k,v):\n    return x@q.T, x@k.T, x@v.T\n\ndef allcat(x,q,k,v):\n    w=torch.cat((q,k,v),0)\n    y=x@w.T\n    return y[:,:2048],y[:,2048:2560],y[:,2560:]\n\ndef kvcat(x,q,k,v):\n    qw=x@q.T\n    w=torch.cat((k,v),0)\n    y=x@w.T\n    return qw,y[:,:512],y[:,512:]\n\ndef time(fn,args):\n    for _ in range(20): fn(*args)\n    torch.cuda.synchronize()\n    s=torch.cuda.Event(enable_timing=True); e=torch.cuda.Event(enable_timing=True)\n    s.record()\n    for _ in range(200): fn(*args)\n    e.record(); e.synchronize()\n    return s.elapsed_time(e)/200\nq=torch.randn(2048,2048,device='cuda',dtype=torch.bfloat16)\nk=torch.randn(512,2048,device='cuda',dtype=torch.bfloat16)\nv=torch.randn(512,2048,device='cuda',dtype=torch.bfloat16)\nfor m in [131,422,449,512,1024,1082,2048,4096,8192]:\n    x=torch.randn(m,2048,device='cuda',dtype=torch.bfloat16)\n    vals=[time(f,(x,q,k,v)) for f in (base,allcat,kvcat)]\n    print(m, *(f'{z:.4f}' for z in vals))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
