{"type":"item.started","item":{"id":"item_18","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch, kernel\nq=torch.randn(2048,2048,device='cuda',dtype=torch.bfloat16)\nk=torch.randn(512,2048,device='cuda',dtype=torch.bfloat16)\nv=torch.randn(512,2048,device='cuda',dtype=torch.bfloat16)\nfor b,s in [(1,131),(2,211),(1,449),(4,128),(1,1024),(2,541),(1,2048),(1,4096),(16,512)]:\n x=torch.randn(b,s,2048,device='cuda',dtype=torch.bfloat16)\n got=kernel.run(x,q,k,v)\n ref=(x@q.T,x@k.T,x@v.T)\n ratios=[]\n for a,c in zip(got,ref):\n  a=a.transpose(1,2).reshape(b*s,-1)\n  d=(a.float()-c.float()).abs()\n  ratios.append((d <= 0.0078125 + 0.0078125*c.float().abs()).float().mean().item())\n print((b,s),ratios)\n# Ensure a mutation invalidates and rebuilds the packed matrix.\nx=torch.randn(1,131,2048,device='cuda',dtype=torch.bfloat16)\nold=kernel.run(x,q,k,v)[0].clone()\nq.add_(1)\nnew=kernel.run(x,q,k,v)[0]\nref=(x@q.T).view(1,131,16,128).transpose(1,2)\nprint('mutation',torch.equal(old,new),torch.equal(new,ref))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
