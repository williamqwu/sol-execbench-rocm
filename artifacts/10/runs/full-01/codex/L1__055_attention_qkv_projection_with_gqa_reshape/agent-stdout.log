 \"2918fc46-6c9e-535a-aff2-d400afcfed7d\", \"axes\": {\"batch_size\": 1, \"seq_len\": 1024}, \"inputs\": {\"hidden_states\": {\"type\": \"random\"}, \"q_weight\": {\"type\": \"random\"}, \"k_weight\": {\"type\": \"random\"}, \"v_weight\": {\"type\": \"random\"}}, \"tolerance\": {\"max_atol\": 0.007806109572713204, \"max_rtol\": 0.0078125, \"required_matched_ratio\": 0.99, \"_provenance\": \"max run-to-run error over 10 seeds x 1.25 margin, floored at torch.bfloat16 epsilon\"}}\n{\"uuid\": \"ef71c699-174c-5f6f-afc9-b9c22613b56c\", \"axes\": {\"batch_size\": 4, \"seq_len\": 1024}, \"inputs\": {\"hidden_states\": {\"type\": \"random\"}, \"q_weight\": {\"type\": \"random\"}, \"k_weight\": {\"type\": \"random\"}, \"v_weight\": {\"type\": \"random\"}}, \"tolerance\": {\"max_atol\": 0.007805778694835938, \"max_rtol\": 0.0078125, \"required_matched_ratio\": 0.99, \"_provenance\": \"max run-to-run error over 10 seeds x 1.25 margin, floored at torch.bfloat16 epsilon\"}}\n{\"uuid\": \"e2fcec04-3fc5-5b8d-bc4b-641a03bcb325\", \"axes\": {\"batch_size\": 2, \"seq_len\": 2048}, \"inputs\": {\"hidden_states\": {\"type\": \"random\"}, \"q_weight\": {\"type\": \"random\"}, \"k_weight\": {\"type\": \"random\"}, \"v_weight\": {\"type\": \"random\"}}, \"tolerance\": {\"max_atol\": 0.007805778694835938, \"max_rtol\": 0.0078125, \"required_matched_ratio\": 0.99, \"_provenance\": \"max run-to-run error over 10 seeds x 1.25 margin, floored at torch.bfloat16 epsilon\"}}\n{\"uuid\": \"4937ec86-36ba-53a5-8982-1be8f00c1e4b\", \"axes\": {\"batch_size\": 1, \"seq_len\": 2048}, \"inputs\": {\"hidden_states\": {\"type\": \"random\"}, \"q_weight\": {\"type\": \"random\"}, \"k_weight\": {\"type\": \"random\"}, \"v_weight\": {\"type\": \"random\"}}, \"tolerance\": {\"max_atol\": 0.007807922449328886, \"max_rtol\": 0.0078125, \"required_matched_ratio\": 0.99, \"_provenance\": \"max run-to-run error over 10 seeds x 1.25 margin, floored at torch.bfloat16 epsilon\"}}\n{\"uuid\": \"ebd8dec4-357b-593c-b4e7-c