{"type":"item.completed","item":{"id":"item_42","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,280p' kernel.py\"","aggregated_output":"import torch\nimport triton\nimport triton.language as tl\n\n\nHIDDEN_SIZE = 4096\n\n\n@triton.jit\ndef _fused_add_rmsnorm_kernel(\n    hidden_states,\n    residual,\n    weight,\n    output,\n    N_ROWS: tl.constexpr,\n    BLOCK_SIZE: tl.constexpr,\n    SWIZZLE: tl.constexpr,\n    SWIZZLE_MULTIPLIER: tl.constexpr,\n):\n    program = tl.program_id(0)\n    group_start = (program // SWIZZLE) * SWIZZLE\n    local = program - group_start\n    permuted_local = (local * SWIZZLE_MULTIPLIER) & (SWIZZLE - 1)\n    row = tl.where(\n        group_start + SWIZZLE <= N_ROWS,\n        group_start + permuted_local,\n        program,\n    )\n    offsets = tl.arange(0, BLOCK_SIZE)\n    row_offsets = row * BLOCK_SIZE + offsets\n\n    hidden = tl.load(hidden_states + row_offsets).to(tl.float32)\n    res = tl.load(residual + row_offsets).to(tl.float32)\n    x = hidden + res\n    mean_square = tl.sum(x * x, axis=0) * (1.0 / BLOCK_SIZE)\n    inv_rms = tl.rsqrt(mean_square + 1.0e-5)\n    scale = tl.load(weight + offsets).to(tl.float32)\n    y = (x * inv_rms) * scale\n    tl.store(output + row_offsets, y)\n\n\n@triton.jit\ndef _fused_add_rmsnorm_rows_kernel(\n    hidden_states,\n    residual,\n    weight,\n    output,\n    N_ROWS: tl.constexpr,\n    ROWS_PER_PROGRAM: tl.constexpr,\n    BLOCK_SIZE: tl.constexpr,\n):\n    program = tl.program_id(0)\n    offsets = tl.arange(0, BLOCK_SIZE)\n    scale = tl.load(weight + offsets).to(tl.float32)\n\n    for row_index in tl.static_range(0, ROWS_PER_PROGRAM):\n        row = program * ROWS_PER_PROGRAM + row_index\n        row_offsets = row * BLOCK_SIZE + offsets\n        mask = row < N_ROWS\n        hidden = tl.load(hidden_states + row_offsets, mask=mask, other=0.0).to(tl.float32)\n        res = tl.load(residual + row_offsets, mask=mask, other=0.0).to(tl.float32)\n        x = hidden + res\n        mean_square = tl.sum(x * x, axis=0) * (1.0 / BLOCK_SIZE)\n        inv_rms = tl.rsqrt(mean_square + 1.0e-5)\n        y = (x * inv_rms) * scale\n        tl.store(output + row_offsets, y, mask=mask)\n\n\n@triton.jit\ndef _fused_add_rmsnorm_persistent_kernel(\n    hidden_states,\n    residual,\n    weight,\n    output,\n    n_rows,\n    NUM_PROGRAMS: tl.constexpr,\n    BLOCK_SIZE: tl.constexpr,\n):\n    program = tl.program_id(0)\n    offsets = tl.arange(0, BLOCK_SIZE)\n    scale = tl.load(weight + offsets).to(tl.float32)\n    row = program\n    while row < n_rows:\n        row_offsets = row * BLOCK_SIZE + offsets\n        hidden = tl.load(hidden_states + row_offsets).to(tl.float32)\n        res = tl.load(residual + row_offsets).to(tl.float32)\n        x = hidden + res\n        mean_square = tl.sum(x * x, axis=0) * (1.0 / BLOCK_SIZE)\n        inv_rms = tl.rsqrt(mean_square + 1.0e-5)\n        y = (x * inv_rms) * scale\n        tl.store(output + row_offsets, y)\n        row += NUM_PROGRAMS\n\n\n@triton.jit\ndef _fused_add_rmsnorm_cached_kernel(\n    hidden_states,\n    residual,\n    weight,\n    output,\n    BLOCK_SIZE: tl.constexpr,\n    INPUT_CACHE: tl.constexpr,\n    WEIGHT_CACHE: tl.constexpr,\n    OUTPUT_CACHE: tl.constexpr,\n    INPUT_EVICT: tl.constexpr,\n    WEIGHT_EVICT: tl.constexpr,\n    OUTPUT_EVICT: tl.constexpr,\n):\n    row = tl.program_id(0)\n    offsets = tl.arange(0, BLOCK_SIZE)\n    row_offsets = row * BLOCK_SIZE + offsets\n\n    hidden = tl.load(\n        hidden_states + row_offsets,\n        cache_modifier=INPUT_CACHE,\n        eviction_policy=INPUT_EVICT,\n    ).to(tl.float32)\n    res = tl.load(\n        residual + row_offsets,\n        cache_modifier=INPUT_CACHE,\n        eviction_policy=INPUT_EVICT,\n    ).to(tl.float32)\n    x = hidden + res\n    mean_square = tl.sum(x * x, axis=0) * (1.0 / BLOCK_SIZE)\n    inv_rms = tl.rsqrt(mean_square + 1.0e-5)\n    scale = tl.load(\n        weight + offsets,\n        cache_modifier=WEIGHT_CACHE,\n        eviction_policy=WEIGHT_EVICT,\n    ).to(tl.float32)\n    y = (x * inv_rms) * scale\n    tl.store(\n        output + row_offsets,\n        y,\n        cache_modifier=OUTPUT_CACHE,\n        eviction_policy=OUTPUT_EVICT,\n    )\n\n\n@torch.no_grad()\ndef run(hidden_states, residual, weight):\n    output = torch.empty_like(hidden_states)\n    rows = hidden_states.numel() // HIDDEN_SIZE\n    if rows >= 1024:\n        _fused_add_rmsnorm_cached_kernel[(rows,)](\n            hidden_states,\n            residual,\n            weight,\n            output,\n            N_ROWS=rows,\n            BLOCK_SIZE=HIDDEN_SIZE,\n            SWIZZLE=1,\n            SWIZZLE_MULTIPLIER=1,\n            INPUT_CACHE=\".cg\",\n            WEIGHT_CACHE=\".ca\",\n            OUTPUT_CACHE=\".wt\",\n            INPUT_EVICT=\"\",\n            WEIGHT_EVICT=\"\",\n            OUTPUT_EVICT=\"\",\n            num_warps=4,\n            waves_per_eu=8,\n        )\n    else:\n        _fused_add_rmsnorm_cached_kernel[(rows,)](\n            hidden_states,\n            residual,\n            weight,\n            output,\n            N_ROWS=rows,\n            BLOCK_SIZE=HIDDEN_SIZE,\n            SWIZZLE=1,\n            SWIZZLE_MULTIPLIER=1,\n            INPUT_CACHE=\".cg\",\n            WEIGHT_CACHE=\".ca\",\n            OUTPUT_CACHE=\".wt\",\n            INPUT_EVICT=\"\",\n            WEIGHT_EVICT=\"\",\n            OUTPUT_EVICT=\"\",\n            num_warps=8,\n        )\n    return output\n","exit_code":0,"status":"completed"}}
