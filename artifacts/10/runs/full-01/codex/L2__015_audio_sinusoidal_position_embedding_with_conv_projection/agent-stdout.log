{"type":"item.started","item":{"id":"item_9","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch\nimport torch.nn.functional as F\nfrom reference import get_inputs\n\ntorch.set_grad_enabled(False)\ndef med(fn,n=30,w=5):\n for _ in range(w):fn()\n torch.cuda.synchronize(); a=[]\n for _ in range(n):\n  s=torch.cuda.Event(True);e=torch.cuda.Event(True);s.record();fn();e.record();e.synchronize();a.append(s.elapsed_time(e))\n return sorted(a)[n//2]\nfor B,T in [(2,1688),(32,920)]:\n d=get_inputs({'batch_size':B,'time_dim':T},torch.device('cuda')); i=d['input_features']; ws=[d[f'conv2d{j}_weight'] for j in range(1,4)]; bs=[d[f'conv2d{j}_bias'] for j in range(1,4)]; wo=d['conv_out_weight'];pe=d['positional_embedding']\n ic=i.contiguous(memory_format=torch.channels_last); wc=[w.contiguous(memory_format=torch.channels_last) for w in ws]\n x1=F.gelu(F.conv2d(ic,wc[0],bs[0],stride=2,padding=1));x2=F.gelu(F.conv2d(x1,wc[1],bs[1],stride=2,padding=1));x3=F.gelu(F.conv2d(x2,wc[2],bs[2],stride=2,padding=1))\n print('shape',B,T,'istr',ic.stride(),'wstr',wc[1].stride(),'xstr',x1.stride(),x2.stride(),x3.stride())\n print('weight converts',med(lambda:[w.contiguous(memory_format=torch.channels_last) for w in ws]))\n print('conv1',med(lambda:F.gelu(F.conv2d(ic,wc[0],bs[0],stride=2,padding=1))))\n print('conv2',med(lambda:F.gelu(F.conv2d(x1,wc[1],bs[1],stride=2,padding=1))))\n print('conv3',med(lambda:F.gelu(F.conv2d(x2,wc[2],bs[2],stride=2,padding=1))))\n print('pack',med(lambda:x3.permute(0,3,1,2).contiguous()))\n def full():\n  ww=[w.contiguous(memory_format=torch.channels_last) for w in ws]\n  x=i.contiguous(memory_format=torch.channels_last)\n  for w,b in zip(ww,bs):x=F.gelu(F.conv2d(x,w,b,stride=2,padding=1))\n  x=x.permute(0,3,1,2).contiguous().view(B,-1,3840)\n  return F.linear(x,wo)*32+pe[:x.shape[1]]\n print('full',med(full,20,3))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
