{"type":"item.started","item":{"id":"item_17","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch, torch.nn.functional as F\nfrom reference import get_inputs\n\ntorch.set_grad_enabled(False)\ndef med(fn,n=30):\n for _ in range(5):fn()\n torch.cuda.synchronize();a=[]\n for _ in range(n):\n  s=torch.cuda.Event(True);e=torch.cuda.Event(True);s.record();fn();e.record();e.synchronize();a.append(s.elapsed_time(e))\n return sorted(a)[n//2]\nfor B,T in [(2,1688),(32,920)]:\n d=get_inputs({'batch_size':B,'time_dim':T},torch.device('cuda'));i=d['input_features'];w1=d['conv2d1_weight'];b1=d['conv2d1_bias'];w2=d['conv2d2_weight'];b2=d['conv2d2_bias'];w3=d['conv2d3_weight'];b3=d['conv2d3_bias']\n x1=F.relu(F.conv2d(i,w1,b1,stride=2,padding=1));x2=F.relu(F.conv2d(x1,w2,b2,stride=2,padding=1)); tout=T//8\n pack=torch.empty((B,tout,384,10),device='cuda',dtype=torch.bfloat16); out=pack.permute(0,2,3,1)\n def cout(): return torch.ops.aten.miopen_convolution.out(x2,w3,b3,[1,1],[2,2],[1,1],1,False,False,out=out)\n try:\n  y=cout(); std=F.conv2d(x2,w3,b3,stride=2,padding=1);torch.cuda.synchronize();print('shape',B,T,'stride',y.stride(),'diff', (y-std).abs().max().item(),'std',med(lambda:F.conv2d(x2,w3,b3,stride=2,padding=1)),'customout',med(cout),'custom+relu',med(lambda:(cout(),pack.relu_())),flush=True)\n except Exception as e: print('ERROR out',repr(e),flush=True)\n try:\n  def freluout(): return torch.ops.aten.cudnn_convolution_relu.out(x2,w3,b3,[2,2],[1,1],[1,1],1,out=out)\n  y=freluout();torch.cuda.synchronize();print('fusedout diffrelu', (y-F.relu(std)).abs().max().item(),'time',med(freluout),flush=True)\n except Exception as e: print('ERROR fused',repr(e),flush=True)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
