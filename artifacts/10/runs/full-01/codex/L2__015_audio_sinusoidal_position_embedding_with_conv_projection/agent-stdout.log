{"type":"item.started","item":{"id":"item_28","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch,torch.nn.functional as F\nfrom reference import run as ref\n\ntorch.set_grad_enabled(False)\ndef make(B,T):\n torch.manual_seed(321);dt=torch.bfloat16;r=lambda *s:torch.randn(*s,device='cuda',dtype=dt)\n return dict(input_features=r(B,1,80,T),conv2d1_weight=r(384,1,3,3),conv2d1_bias=r(384),conv2d2_weight=r(384,384,3,3),conv2d2_bias=r(384),conv2d3_weight=r(384,384,3,3),conv2d3_bias=r(384),conv_out_weight=r(1024,3840),positional_embedding=r(1500,1024),embed_scale=32.)\ndef alt(d,modes):\n x=d['input_features']\n for j,m in enumerate(modes,1):x=F.gelu(F.conv2d(x,d[f'conv2d{j}_weight'],d[f'conv2d{j}_bias'],stride=2,padding=1),approximate=m)\n B,C,H,T=x.shape;x=x.permute(0,3,1,2).contiguous().view(B,T,C*H);return F.linear(x,d['conv_out_weight'])*32+d['positional_embedding'][:T]\ndef med(f,n=30):\n for _ in range(5):f()\n torch.cuda.synchronize();a=[]\n for _ in range(n):\n  s=torch.cuda.Event(True);e=torch.cuda.Event(True);s.record();f();e.record();e.synchronize();a.append(s.elapsed_time(e))\n return sorted(a)[n//2]\nfor B,T,atol,rtol in [(2,256,320,.03125),(1,1048,204.821,.0078125)]:\n d=make(B,T);yr=ref(**d)\n for modes in [('tanh',)*3,('none','tanh','tanh'),('tanh','none','none'),('none','none','none')]:\n  y=alt(d,modes);cl=torch.isclose(y,yr,atol=atol,rtol=rtol);print(B,T,modes,'ratio',cl.float().mean().item(),'max',(y.float()-yr.float()).abs().max().item(),'time',med(lambda:alt(d,modes),15),flush=True)\n # isolated gelus\n c=F.conv2d(d['input_features'],d['conv2d1_weight'],d['conv2d1_bias'],stride=2,padding=1)\n print('gelu isolated',med(lambda:F.gelu(c),30),med(lambda:F.gelu(c,approximate='tanh'),30), 'outdiff',(F.gelu(c)-F.gelu(c,approximate='tanh')).abs().max().item())\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
