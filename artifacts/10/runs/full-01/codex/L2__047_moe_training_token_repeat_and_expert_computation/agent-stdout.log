{"type":"item.started","item":{"id":"item_31","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch, time\nimport torch.nn.functional as F\nfrom reference import get_inputs\nfrom kernel import run as grouped\nD=torch.device('cuda')\nprint('generating')\na=get_inputs({'batch_seq_len':2048,'hidden_size':8192,'moe_intermediate_size':2048,'num_experts':256,'num_experts_per_tok':8},D)\nprint('generated')\n\ndef batched(x,idx,rw,g,u,d):\n n,h=x.shape;k=idx.shape[1];e=g.shape[0];A=n*k\n se,order=torch.sort(idx.reshape(-1)); counts=torch.bincount(se,minlength=e)\n m=int(counts.max().item())\n starts=counts.cumsum(0)-counts\n within=torch.arange(A,device=x.device)-starts[se]\n xp=torch.zeros((e,m,h),device=x.device,dtype=x.dtype)\n xp[se,within]=x[torch.div(order,k,rounding_mode='floor')]\n ga=torch.bmm(xp,g.transpose(1,2)); up=torch.bmm(xp,u.transpose(1,2))\n mid=F.silu(ga)*up\n yp=torch.bmm(mid,d.transpose(1,2))\n py=yp[se,within]\n y=torch.empty((A,h),device=x.device,dtype=x.dtype);y[order]=py\n return (y.view(n,k,h)*rw.unsqueeze(-1)).sum(1)\n\nfor name,fn in [('grouped',grouped),('batched',batched)]:\n print('warm',name)\n o=fn(a['hidden_states'],a['topk_idx'],a['topk_weight'],a['expert_gate_projs'],a['expert_up_projs'],a['expert_down_projs']);torch.cuda.synchronize()\n ts=[]\n for z in range(3):\n  s=torch.cuda.Event(True);q=torch.cuda.Event(True);s.record();o2=fn(a['hidden_states'],a['topk_idx'],a['topk_weight'],a['expert_gate_projs'],a['expert_up_projs'],a['expert_down_projs']);q.record();q.synchronize();ts.append(s.elapsed_time(q))\n print(name,ts,'shape',o.shape)\n if name=='grouped': truth=o\n else:\n  diff=(o-truth).abs(); print('diff',diff.max().item(),diff.float().mean().item(),(o==truth).float().mean().item())\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
