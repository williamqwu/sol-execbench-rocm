{"type":"item.started","item":{"id":"item_40","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch\nimport torch.nn.functional as F\nfrom reference import get_inputs\nD=torch.device('cuda')\n\ndef runq(a,q):\n x=a['hidden_states'];idx=a['topk_idx'];rw=a['topk_weight'];g=a['expert_gate_projs'];u=a['expert_up_projs'];d=a['expert_down_projs']\n n,h=x.shape;k=idx.shape[1];e=g.shape[0];A=n*k;se,order=torch.sort(idx.reshape(-1));counts=torch.bincount(se,minlength=e);raw=int(counts.max().item());m=((raw+q-1)//q)*q;starts=counts.cumsum(0)-counts;within=torch.arange(A,device=x.device)-starts[se];xp=torch.empty((e,m,h),device=x.device,dtype=x.dtype);xp[se,within]=x[order//k];mid=F.silu(torch.bmm(xp,g.transpose(1,2)))*torch.bmm(xp,u.transpose(1,2));yp=torch.bmm(mid,d.transpose(1,2));y=torch.empty((A,h),device=x.device,dtype=x.dtype);y[order]=yp[se,within];return (y.view(n,k,h)*rw.unsqueeze(-1)).sum(1),raw,m\nfor n in [2048,8192]:\n print('generate',n,flush=True);a=get_inputs({'batch_seq_len':n,'hidden_size':8192,'moe_intermediate_size':2048,'num_experts':256,'num_experts_per_tok':8},D)\n for q in [1,8,16,32,64]:\n  out,raw,m=runq(a,q);torch.cuda.synchronize();ts=[]\n  for _ in range(3):\n   s=torch.cuda.Event(True);z=torch.cuda.Event(True);s.record();out,_,_=runq(a,q);z.record();z.synchronize();ts.append(s.elapsed_time(z))\n  print(n,'q',q,'raw/m',raw,m,'times',ts,flush=True);del out;torch.cuda.empty_cache()\n del a;torch.cuda.empty_cache()\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
