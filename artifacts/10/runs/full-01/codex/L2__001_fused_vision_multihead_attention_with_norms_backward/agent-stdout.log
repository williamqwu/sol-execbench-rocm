{"type":"item.completed","item":{"id":"item_30","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' kernel.py\"","aggregated_output":"import torch\nimport torch.nn.functional as F\nimport triton\nimport triton.language as tl\n\n\n@triton.jit\ndef _pack_qkv_kernel(\n    grad_q,\n    grad_k,\n    grad_v,\n    grad_qkv,\n    scale,\n    N_ROWS: tl.constexpr,\n    SEQ: tl.constexpr,\n    EMBED: tl.constexpr,\n    BLOCK: tl.constexpr,\n):\n    # Each program copies one 1024-wide Q/K/V slice while changing the\n    # [B,H,S,D] layout into [B,S,H*D].  Folding Q's scale into this copy\n    # avoids three materialized transposes and the subsequent cat.\n    pid = tl.program_id(0)\n    row = pid // 3\n    part = pid - row * 3\n    e = tl.arange(0, BLOCK)\n    mask = (row < N_ROWS) & (e < EMBED)\n    b = row // SEQ\n    s = row - b * SEQ\n    h = e // 64\n    d = e - h * 64\n    src = ((b * 16 + h) * SEQ + s) * 64 + d\n    qv = tl.load(grad_q + src, mask=mask & (part == 0), other=0.0) * scale\n    kv = tl.load(grad_k + src, mask=mask & (part == 1), other=0.0)\n    vv = tl.load(grad_v + src, mask=mask & (part == 2), other=0.0)\n    value = qv + kv + vv\n    tl.store(grad_qkv + row * (3 * EMBED) + part * EMBED + e, value, mask=mask)\n\n\n@triton.jit\ndef _softmax_backward_kernel(\n    grad_attn_weights,\n    attn_weights,\n    grad_attn_scores,\n    N_ROWS: tl.constexpr,\n    SEQ: tl.constexpr,\n    BLOCK: tl.constexpr,\n):\n    row = tl.program_id(0)\n    lanes = tl.arange(0, 512)\n    first_offsets = row * SEQ + lanes\n    second_offsets = first_offsets + 512\n    first_mask = (row < N_ROWS) & (lanes < SEQ)\n    second_mask = (row < N_ROWS) & ((lanes + 512) < SEQ)\n    gaw0 = tl.load(grad_attn_weights + first_offsets, mask=first_mask, other=0.0)\n    aw0 = tl.load(attn_weights + first_offsets, mask=first_mask, other=0.0)\n    gaw1 = tl.load(grad_attn_weights + second_offsets, mask=second_mask, other=0.0)\n    aw1 = tl.load(attn_weights + second_offsets, mask=second_mask, other=0.0)\n    thread_sums = gaw0 * aw0 + gaw1 * aw1\n    wave_sums = tl.sum(tl.reshape(thread_sums, (8, 64)), axis=1)\n    row_sum = tl.sum(wave_sums, axis=0)\n\n    columns = tl.arange(0, BLOCK)\n    offsets = row * SEQ + columns\n    mask = (row < N_ROWS) & (columns < SEQ)\n    gaw = tl.load(grad_attn_weights + offsets, mask=mask)\n    aw = tl.load(attn_weights + offsets, mask=mask)\n    centered = gaw - row_sum\n    tl.store(grad_attn_scores + offsets, aw * centered, mask=mask)\n\n\n@triton.jit\ndef _layer_norm_finish_kernel(\n    grad_output,\n    grad_x_from_norm,\n    x_centered,\n    mean_grad,\n    mean_grad_x_centered,\n    grad_x,\n    n_elements: tl.constexpr,\n    EMBED: tl.constexpr,\n    BLOCK: tl.constexpr,\n):\n    offsets = tl.program_id(0) * BLOCK + tl.arange(0, BLOCK)\n    mask = offsets < n_elements\n    row = offsets // EMBED\n    go = tl.load(grad_output + offsets, mask=mask)\n    gx = tl.load(grad_x_from_norm + offsets, mask=mask)\n    xc = tl.load(x_centered + offsets, mask=mask)\n    mg = tl.load(mean_grad + row, mask=mask)\n    mgxc = tl.load(mean_grad_x_centered + row, mask=mask)\n    correction = xc * mgxc\n    gx = gx - mg\n    gx = gx - correction\n    gx = go + gx\n    tl.store(grad_x + offsets, gx, mask=mask)\n\n\n@torch.no_grad()\ndef run(\n    grad_output,\n    x,\n    x_mean,\n    x_var,\n    x_norm,\n    ln_weight,\n    qkv_weight,\n    q,\n    k,\n    v,\n    attn_weights,\n    attn_output,\n    out_weight,\n    scale,\n    norm_eps,\n):\n    batch_size, seq_len, embed_dim = x.shape\n    num_heads = 16\n    head_dim = 64\n\n    grad_attn_output = F.linear(grad_output, out_weight.t())\n    grad_out_weight = torch.matmul(\n        grad_output.reshape(-1, embed_dim).t(),\n        attn_output.reshape(-1, embed_dim),\n    )\n    grad_out_bias = grad_output.sum(dim=(0, 1))\n\n    grad_attn_output_heads = grad_attn_output.view(\n        batch_size, seq_len, num_heads, head_dim\n    ).transpose(1, 2)\n    grad_v = torch.matmul(attn_weights.transpose(-2, -1), grad_attn_output_heads)\n    grad_attn_weights = torch.matmul(\n        grad_attn_output_heads, v.transpose(-2, -1)\n    )\n    grad_attn_scores = torch.empty_like(grad_attn_weights)\n    n_score_rows = batch_size * num_heads * seq_len\n    _softmax_backward_kernel[(n_score_rows,)](\n        grad_attn_weights,\n        attn_weights,\n        grad_attn_scores,\n        N_ROWS=n_score_rows,\n        SEQ=seq_len,\n        BLOCK=1024,\n        num_warps=8,\n        enable_fp_fusion=False,\n    )\n    grad_q = torch.matmul(grad_attn_scores, k)\n    grad_k = torch.matmul(grad_attn_scores.transpose(-2, -1), q * scale)\n\n    grad_qkv = torch.empty(\n        (batch_size, seq_len, 3 * embed_dim),\n        device=x.device,\n        dtype=x.dtype,\n    )\n    n_rows = batch_size * seq_len\n    _pack_qkv_kernel[(n_rows * 3,)](\n        grad_q,\n        grad_k,\n        grad_v,\n        grad_qkv,\n        scale,\n        N_ROWS=n_rows,\n        SEQ=seq_len,\n        EMBED=embed_dim,\n        BLOCK=1024,\n        num_warps=8,\n    )\n\n    grad_x_norm = F.linear(grad_qkv, qkv_weight.t())\n    grad_qkv_weight = torch.matmul(\n        grad_qkv.reshape(-1, 3 * embed_dim).t(),\n        x_norm.reshape(-1, embed_dim),\n    )\n    grad_qkv_bias = grad_qkv.sum(dim=(0, 1))\n\n    std = torch.sqrt(x_var + norm_eps)\n    x_centered = x - x_mean\n    x_normalized = x_centered / std\n    grad_ln_weight = (grad_x_norm * x_normalized).sum(dim=(0, 1))\n    grad_ln_bias = grad_x_norm.sum(dim=(0, 1))\n    grad_x_normalized = grad_x_norm * ln_weight\n    grad_x_from_norm = grad_x_normalized / std\n    mean_grad = grad_x_from_norm.mean(dim=-1, keepdim=True)\n    mean_grad_x_centered = (\n        (grad_x_normalized * x_centered).mean(dim=-1, keepdim=True) / (std ** 2)\n    )\n    grad_x = torch.empty_like(x)\n    n_x = x.numel()\n    _layer_norm_finish_kernel[(triton.cdiv(n_x, 4096),)](\n        grad_output,\n        grad_x_from_norm,\n        x_centered,\n        mean_grad,\n        mean_grad_x_centered,\n        grad_x,\n        n_elements=n_x,\n        EMBED=embed_dim,\n        BLOCK=4096,\n        num_warps=8,\n        enable_fp_fusion=False,\n    )\n\n    return (\n        grad_x,\n        grad_qkv_weight,\n        grad_qkv_bias,\n        grad_out_weight,\n        grad_out_bias,\n        grad_ln_weight,\n        grad_ln_bias,\n    )\n","exit_code":0,"status":"completed"}}
