{"type":"item.started","item":{"id":"item_29","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch,numpy as np\nB,S,E,H,D=1,577,1024,16,64;r=lambda *s:torch.rand(*s,device='cuda')\ngo=r(B,S,E);v=r(B,H,S,D);aw=r(B,H,S,S);ow=r(E,E)\ngao=torch.nn.functional.linear(go,ow.t()).view(B,S,H,D).transpose(1,2)\ngaw=torch.matmul(gao,v.transpose(-2,-1));p=(gaw*aw).reshape(-1,S);ref=p.sum(-1)\nP=p[:128].cpu().numpy();R=ref[:128].cpu().numpy()\n\ndef add(a,b): return np.float32(a+b)\ndef reduce_candidate(x,nt,wave,mapping,initzero=True):\n acc=np.zeros(nt,dtype=np.float32)\n if mapping=='strided':\n  for t in range(nt):\n   if not initzero and t<len(x): acc[t]=x[t]; start=t+nt\n   else: start=t\n   for i in range(start,len(x),nt): acc[t]=add(acc[t],x[i])\n elif mapping.startswith('contig'):\n  chunk=(len(x)+nt-1)//nt\n  for t in range(nt):\n   lo=t*chunk;hi=min(lo+chunk,len(x))\n   if not initzero and lo<hi:acc[t]=x[lo];lo+=1\n   for i in range(lo,hi):acc[t]=add(acc[t],x[i])\n elif mapping.startswith('vec'):\n  vec=int(mapping[3:]);groups=(len(x)+vec-1)//vec\n  for t in range(nt):\n   for g in range(t,groups,nt):\n    for j in range(vec):\n     i=g*vec+j\n     if i<len(x):acc[t]=add(acc[t],x[i])\n # wave shfl down\n nw=(nt+wave-1)//wave\n ws=np.zeros(nw,dtype=np.float32)\n for wi in range(nw):\n  z=np.zeros(wave,dtype=np.float32);n=min(wave,nt-wi*wave);z[:n]=acc[wi*wave:wi*wave+n]\n  off=wave//2\n  while off:\n   old=z.copy()\n   for lane in range(wave-off):z[lane]=add(old[lane],old[lane+off])\n   off//=2\n  ws[wi]=z[0]\n z=np.zeros(wave,dtype=np.float32);z[:nw]=ws\n off=wave//2\n while off:\n  old=z.copy()\n  for lane in range(wave-off):z[lane]=add(old[lane],old[lane+off])\n  off//=2\n return z[0]\n\nbest=[]\nfor wave in (32,64):\n for nt in (32,64,128,256,512,1024):\n  if nt%wave:continue\n  for mapping in ('strided','contig','vec2','vec4','vec8'):\n   for initzero in (True,False):\n    vals=np.array([reduce_candidate(x,nt,wave,mapping,initzero) for x in P],np.float32)\n    matches=(vals.view(np.uint32)==R.view(np.uint32)).sum()\n    maxulp=np.max(np.abs(vals.astype(np.float64)-R.astype(np.float64)))\n    best.append((matches,maxulp,wave,nt,mapping,initzero))\nfor z in sorted(best,key=lambda z:(-z[0],z[1]))[:25]:print(z)\nprint('ref first bits',R[:5].view(np.uint32))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
