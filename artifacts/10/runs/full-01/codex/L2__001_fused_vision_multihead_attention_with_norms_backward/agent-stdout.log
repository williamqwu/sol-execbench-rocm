{"type":"item.started","item":{"id":"item_12","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch\nimport kernel, reference\nB,S,E,H,D=2,577,1024,16,64\nr=lambda *s: torch.rand(*s,device='cuda')\na=[r(B,S,E),r(B,S,E),r(B,S,1),r(B,S,1),r(B,S,E),r(E),r(3*E,E),r(B,H,S,D),r(B,H,S,D),r(B,H,S,D),r(B,H,S,S),r(B,S,E),r(E,E),0.125,1e-5]\ny=kernel.run(*a); y0=reference.run(*a); torch.cuda.synchronize()\natol=1.8048432854465999e-6;rtol=1.1920928955078125e-7\nfor i,(u,w) in enumerate(zip(y,y0)):\n d=(u-w).abs(); ok=d<=atol+rtol*w.abs(); print(i,'max',d.max().item(),'ratio',ok.float().mean().item())\ndef bench(fn):\n for _ in range(5):fn(*a)\n torch.cuda.synchronize(); s=torch.cuda.Event(True);e=torch.cuda.Event(True);s.record()\n for _ in range(50):fn(*a)\n e.record();e.synchronize();return s.elapsed_time(e)/50\nprint('reference',bench(reference.run),'custom',bench(kernel.run))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
