{"type":"item.started","item":{"id":"item_53","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch,triton,kernel\nB,S,E,H,D=2,577,1024,16,64;r=lambda *s:torch.rand(*s,device='cuda')\ndef timing(call,n=100):\n for _ in range(5):call()\n torch.cuda.synchronize();a=torch.cuda.Event(True);b=torch.cuda.Event(True);a.record()\n for _ in range(n):call()\n b.record();b.synchronize();return a.elapsed_time(b)/n\n# softmax finish\nN=B*H*S*S;g=r(N);w=r(N);sm=r(B*H*S);o=torch.empty_like(g)\nfor block in (1024,2048,4096,8192):\n for nw in (4,8):\n  fn=lambda block=block,nw=nw:kernel._softmax_backward_kernel[(triton.cdiv(N,block),)](g,w,sm,o,n_elements=N,SEQ=S,BLOCK=block,num_warps=nw,enable_fp_fusion=False)\n  try:print('soft',block,nw,timing(fn))\n  except Exception as e:print('soft fail',block,nw,str(e)[:100])\ndel g,w,sm,o\n# pack\nrows=B*S;gq=r(B,H,S,D);gk=r(B,H,S,D);gv=r(B,H,S,D);oq=torch.empty(B,S,3*E,device='cuda')\nfor nw in (2,4,8):\n fn=lambda nw=nw:kernel._pack_qkv_kernel[(rows*3,)](gq,gk,gv,oq,.125,N_ROWS=rows,SEQ=S,EMBED=E,BLOCK=1024,num_warps=nw)\n print('pack',nw,timing(fn))\n# layer prepare\nx=r(B,S,E);mean=r(B,S,1);std=r(B,S,1)+.01;gx=r(B,S,E);lw=r(E);outs=[torch.empty_like(x) for _ in range(4)];N=x.numel()\nfor block in (1024,2048,4096,8192):\n for nw in (4,8):\n  fn=lambda block=block,nw=nw:kernel._layer_norm_prepare_kernel[(triton.cdiv(N,block),)](x,mean,std,gx,lw,*outs,n_elements=N,EMBED=E,BLOCK=block,num_warps=nw,enable_fp_fusion=False)\n  try:print('prep',block,nw,timing(fn))\n  except Exception as e:print('prep fail',block,nw,str(e)[:100])\n# finish\nmg=r(B,S,1);mcp=r(B,S,1);go=r(B,S,E);out=torch.empty_like(go)\nfor block in (1024,2048,4096,8192):\n for nw in (4,8):\n  fn=lambda block=block,nw=nw:kernel._layer_norm_finish_kernel[(triton.cdiv(N,block),)](go,outs[2],outs[0],mg,mcp,std,out,n_elements=N,EMBED=E,BLOCK=block,num_warps=nw,enable_fp_fusion=False)\n  try:print('finish',block,nw,timing(fn))\n  except Exception as e:pri