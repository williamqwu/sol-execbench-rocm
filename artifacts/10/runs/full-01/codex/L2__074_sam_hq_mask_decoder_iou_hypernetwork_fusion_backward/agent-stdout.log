{"type":"item.started","item":{"id":"item_72","type":"command_execution","command":"/bin/bash -lc \"python -m py_compile kernel.py && python - <<'PY'\nimport json,torch,kernel,reference\nD=json.load(open('definition.json'));base={'hidden_size':256,'iou_head_hidden_dim':1024,'num_mask_tokens':4,'output_channels':32}\ndef bench(a,n=60):\n for _ in range(8):kernel.run(*a)\n torch.cuda.synchronize();s=torch.cuda.Event(True);e=torch.cuda.Event(True);s.record()\n for _ in range(n):kernel.run(*a)\n e.record();e.synchronize();return s.elapsed_time(e)/n\nfor m in (64,128,131,256,449,512):\n ax={**base,'batch_size':1,'point_batch_size':m};a=[torch.rand(tuple(ax.get(x,x) for x in v['shape']),device='cuda') for v in D['inputs'].values()];r=reference.run(*a);o=kernel.run(*a);torch.cuda.synchronize();errs=[(x-y).abs().max().item() for x,y in zip(r,o)];print(m,all(torch.equal(x,y) for x,y in zip(r,o)),max(errs),bench(a))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
