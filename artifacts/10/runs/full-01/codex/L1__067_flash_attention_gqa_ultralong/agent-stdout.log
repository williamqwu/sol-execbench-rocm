{"type":"item.started","item":{"id":"item_23","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch, torch.nn.functional as F\n\ndef bench(fn,n):\n for _ in range(2): fn()\n torch.cuda.synchronize(); a=torch.cuda.Event(True); b=torch.cuda.Event(True); a.record()\n for _ in range(n): fn()\n b.record(); b.synchronize(); return a.elapsed_time(b)/n\nfor s,nit in [(128,30),(512,20),(2048,10),(8192,3)]:\n q=torch.randn((1,32,s,128),device='cuda')*.1\n k=torch.randn((1,8,s,128),device='cuda')*.1\n v=torch.randn((1,8,s,128),device='cuda')*.1\n def ref():\n  kr=k[:,:,None].expand(1,8,4,s,128).reshape(1,32,s,128)\n  vr=v[:,:,None].expand(1,8,4,s,128).reshape(1,32,s,128)\n  mask=torch.triu(torch.full((s,s),float('-inf'),device='cuda'),1)\n  return F.softmax(q@kr.transpose(2,3)*(128**-.5)+mask,-1,dtype=torch.float32)@vr\n def grp():\n  mask=torch.triu(torch.full((s,s),float('-inf'),device='cuda'),1)\n  w=F.softmax(torch.matmul(q.view(1,8,4,s,128),k[:,:,None].transpose(-2,-1))*(128**-.5)+mask,-1,dtype=torch.float32)\n  return torch.matmul(w,v[:,:,None]).reshape(1,32,s,128)\n print(s,'ref',bench(ref,nit),'grouped',bench(grp,nit))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
