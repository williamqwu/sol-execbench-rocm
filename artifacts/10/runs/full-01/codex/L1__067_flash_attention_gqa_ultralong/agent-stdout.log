{"type":"item.started","item":{"id":"item_8","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch, torch.nn.functional as F, time\nfor scale in (1.0, .01, .001):\n  torch.manual_seed(1)\n  q=torch.randn((1,32,128,128),device='cuda',dtype=torch.float32)*scale\n  k=torch.randn((1,8,128,128),device='cuda',dtype=torch.float32)*scale\n  v=torch.randn((1,8,128,128),device='cuda',dtype=torch.float32)*scale\n  kr=k[:,:,None].expand(1,8,4,128,128).reshape(1,32,128,128)\n  vr=v[:,:,None].expand(1,8,4,128,128).reshape(1,32,128,128)\n  mask=torch.triu(torch.full((128,128),float('-inf'),device='cuda'),diagonal=1)\n  ref=F.softmax(torch.matmul(q,kr.transpose(2,3))*(128**-.5)+mask,dim=-1,dtype=torch.float32)@vr\n  try:\n    out=F.scaled_dot_product_attention(q,k,v,is_causal=True,enable_gqa=True)\n    e=(out-ref).abs(); rel=e/ref.abs().clamp_min(1e-30)\n    print(scale, 'max',e.max().item(),'mean',e.mean().item(),'exact',(out==ref).float().mean().item(),'closeeps',torch.isclose(out,ref,atol=1e-8,rtol=1.1920928955078125e-7).float().mean().item())\n  except Exception as exc: print(type(exc).__name__, exc)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
