{"type":"item.started","item":{"id":"item_26","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch, torch.nn.functional as F\nfrom kernel import _flash_attention\n\ndef rotate(q,k,c,s):\n b,n,_=q.shape; qh=q.view(b,n,32,128).transpose(1,2); kh=k.view(b,n,8,128).transpose(1,2)\n return qh*c[:,None]+torch.cat((-qh[...,64:],qh[...,:64]),-1)*s[:,None], kh*c[:,None]+torch.cat((-kh[...,64:],kh[...,:64]),-1)*s[:,None]\ndef explicit(q,k,v):\n b,_,n,_=q.shape; kr=k[:,:,None].expand(b,8,4,n,128).reshape(b,32,n,128); vr=v.view(b,n,8,128).transpose(1,2)[:,:,None].expand(b,8,4,n,128).reshape(b,32,n,128); mask=torch.triu(torch.full((n,n),float('-inf'),device='cuda'),1)\n return (F.softmax(q@kr.transpose(2,3)*(128**-.5)+mask,-1,dtype=torch.float32)@vr).transpose(1,2).contiguous().reshape(b,n,4096)\ntorch.manual_seed(2)\nfor qs in [.1,.3,1.]:\n q=torch.randn((1,1024,4096),device='cuda')*qs; k=torch.randn((1,1024,1024),device='cuda')*qs; v=torch.randn((1,1024,1024),device='cuda')*qs; c=torch.randn((1,1024,128),device='cuda'); s=torch.randn((1,1024,128),device='cuda')\n qr,kr=rotate(q,k,c,s); a=explicit(qr,kr,v); z=_flash_attention(qr,kr,v,c,s,False); e=(a-z).abs()\n print(qs,'maxerr',e.max().item(),'mean',e.mean().item(),'close',torch.isclose(a,z,atol=1e-8,rtol=1.1920928955078125e-7).float().mean().item())\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
