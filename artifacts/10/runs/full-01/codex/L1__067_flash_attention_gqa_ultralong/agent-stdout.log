{"type":"item.started","item":{"id":"item_16","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch, torch.nn.functional as F\nfrom kernel import _flash_attention\n\ndef explicit(q,k,v,c,s):\n  b,n,_=q.shape\n  q=q.view(b,n,32,128).transpose(1,2)\n  k=k.view(b,n,8,128).transpose(1,2)\n  v=v.view(b,n,8,128).transpose(1,2)\n  qr=torch.cat((-q[...,64:],q[...,:64]),-1)\n  kr=torch.cat((-k[...,64:],k[...,:64]),-1)\n  q=q*c[:,None]+qr*s[:,None]\n  k=k*c[:,None]+kr*s[:,None]\n  k=k[:,:,None].expand(b,8,4,n,128).reshape(b,32,n,128)\n  v=v[:,:,None].expand(b,8,4,n,128).reshape(b,32,n,128)\n  mask=torch.triu(torch.full((n,n),float('-inf'),device='cuda'),1)\n  return (F.softmax(q@k.transpose(2,3)*(128**-.5)+mask,-1,dtype=torch.float32)@v).transpose(1,2).contiguous().reshape(b,n,4096)\n\ntorch.manual_seed(2)\nfor qs in [.001,.01,.1,1.]:\n q=torch.randn((1,1024,4096),device='cuda')*qs\n k=torch.randn((1,1024,1024),device='cuda')*qs\n v=torch.randn((1,1024,1024),device='cuda')*qs\n c=torch.randn((1,1024,128),device='cuda')\n s=torch.randn((1,1024,128),device='cuda')\n a=explicit(q,k,v,c,s); z=_flash_attention(q,k,v,c,s)\n e=(a-z).abs()\n print(qs,'outmax',a.abs().max().item(),'maxerr',e.max().item(),'mean',e.mean().item(),'close 1e-8',torch.isclose(a,z,atol=1e-8,rtol=1.1920928955078125e-7).float().mean().item())\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
