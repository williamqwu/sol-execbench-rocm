{"type":"item.started","item":{"id":"item_7","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch\nimport triton\nfrom kernel import _rms_norm_kernel\n\nN = 8192\nfor m in (131, 256, 512, 1024, 2048, 4096, 8192):\n    h = torch.randn((m, N), device='cuda', dtype=torch.bfloat16)\n    r = torch.randn_like(h)\n    w = torch.randn((N,), device='cuda', dtype=torch.bfloat16)\n    o = torch.empty_like(h)\n    vals = []\n    for nw in (2, 4, 8, 16):\n        try:\n            fn = lambda nw=nw: _rms_norm_kernel[(m,)](h, r, w, o, 1e-5, N=N, BLOCK=N, num_warps=nw)\n            ms = triton.testing.do_bench(fn, warmup=20, rep=100)\n            vals.append(f'{nw}:{ms*1000:.2f}us')\n        except Exception as e:\n            vals.append(f'{nw}:ERR({type(e).__name__})')\n    print(m, ' '.join(vals), flush=True)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
