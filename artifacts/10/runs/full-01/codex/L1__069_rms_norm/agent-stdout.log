id\": \"0d67b22c-1533-5493-bd8b-ca9e78d4558d\", \"axes\": {\"batch_size\": 1, \"seq_len\": 256}, \"inputs\": {\"hidden_states\": {\"type\": \"random\"}, \"residual\": {\"type\": \"random\"}, \"weight\": {\"type\": \"random\"}, \"eps\": {\"type\": \"scalar\", \"value\": 1e-05}}, \"tolerance\": {\"max_atol\": 0.007767874144899929, \"max_rtol\": 0.0078125, \"required_matched_ratio\": 0.99, \"_provenance\": \"max run-to-run error over 10 seeds x 1.25 margin, floored at torch.bfloat16 epsilon\"}}\n{\"uuid\": \"b83f63ed-6058-5ff5-859b-11a570db5db4\", \"axes\": {\"batch_size\": 2, \"seq_len\": 1024}, \"inputs\": {\"hidden_states\": {\"type\": \"random\"}, \"residual\": {\"type\": \"random\"}, \"weight\": {\"type\": \"random\"}, \"eps\": {\"type\": \"scalar\", \"value\": 1e-05}}, \"tolerance\": {\"max_atol\": 0.0077661860378013085, \"max_rtol\": 0.0078125, \"required_matched_ratio\": 0.99, \"_provenance\": \"max run-to-run error over 10 seeds x 1.25 margin, floored at torch.bfloat16 epsilon\"}}\n{\"uuid\": \"9462f440-4f3b-51d2-b71f-af0540a94498\", \"axes\": {\"batch_size\": 1, \"seq_len\": 1024}, \"inputs\": {\"hidden_states\": {\"type\": \"random\"}, \"residual\": {\"type\": \"random\"}, \"weight\": {\"type\": \"random\"}, \"eps\": {\"type\": \"scalar\", \"value\": 1e-05}}, \"tolerance\": {\"max_atol\": 0.007858254165219701, \"max_rtol\": 0.0078125, \"required_matched_ratio\": 0.99, \"_provenance\": \"max run-to-run error over 10 seeds x 1.25 margin, floored at torch.bfloat16 epsilon\"}}\n","exit_code":0,"status":"completed"}}
