{"type":"item.started","item":{"id":"item_60","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch,aiter,triton.language as tl\nfrom aiter.ops.triton.moe.moe_op import fused_moe\nD='cuda';torch.manual_seed(15);M,E,K,N,T=32,8,512,256,2;R=M*T;BM=128\nx=torch.randn(M,K,device=D,dtype=torch.bfloat16)*.05;g=torch.randn(E,N,K,device=D,dtype=torch.bfloat16)*.05;u=torch.randn_like(g);d=torch.randn(E,K,N,device=D,dtype=torch.bfloat16)*.05;ids=torch.rand(M,E,device=D).topk(T,-1).indices;w=torch.rand(M,T,device=D).to(torch.bfloat16);w=(w/w.sum(-1,keepdim=True)).to(torch.bfloat16)\nmx=R+E*BM;sid=torch.full((mx,),R,device=D,dtype=torch.int32);eid=torch.empty((mx+BM-1)//BM,device=D,dtype=torch.int32);tn=torch.zeros(E+1,device=D,dtype=torch.int32);np=torch.zeros(1,device=D,dtype=torch.int32);aiter.moe_align_block_size(ids,E,BM,sid,eid,tn,np)\ncfg={'BLOCK_SIZE_M':BM,'BLOCK_SIZE_N':128,'BLOCK_SIZE_K':64,'GROUP_SIZE_M':1,'num_warps':8,'num_stages':2,'waves_per_eu':0,'matrix_instr_nonkdim':32,'kpack':1};go=torch.empty(M,T,N,device=D,dtype=torch.bfloat16);uo=torch.empty_like(go);com=(None,None,None,w,ids,sid,eid,np)\nfor ww,oo in [(g,go),(u,uo)]:fused_moe(x,ww,oo,*com,False,T,tl.bfloat16,False,False,False,config=cfg)\ninter=torch.nn.functional.silu(go)*uo;o=torch.empty(R,1,K,device=D,dtype=torch.bfloat16);fused_moe(inter.reshape(R,N),d,o,*com,False,1,tl.bfloat16,False,False,False,config=cfg);y=(o.view(M,T,K)*w[...,None]).sum(1);torch.cuda.synchronize();ref=torch.zeros_like(x)\nfor e in range(E):\n ti,wi=torch.where(ids==e)\n if ti.numel():\n  xx=x[ti];z=torch.nn.functional.silu(torch.nn.functional.linear(xx,g[e]))*torch.nn.functional.linear(xx,u[e]);oo=torch.nn.functional.linear(z,d[e]);ref.index_add_(0,ti,oo*w[ti,wi,None])\nerr=(y-ref).abs().float();print('np',np.item(),'max',err.max().item(),'mean',err.mean().item(),'corr',torch.corrcoef(torch.stack((y.float().flatten(),ref.float().flatten())))[0,1].item())\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
