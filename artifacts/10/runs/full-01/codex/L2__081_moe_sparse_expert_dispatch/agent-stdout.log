{"type":"item.started","item":{"id":"item_42","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch, triton.language as tl\nfrom aiter.ops.triton.moe.moe_op import fused_moe\nfrom aiter.ops.triton.moe.moe_align_block_size import moe_align_block_size_triton\n\ntorch.manual_seed(10);D='cuda';M,E,K,N,T=32,8,512,256,2\nx=torch.randn(M,K,device=D,dtype=torch.bfloat16)*.05;g=torch.randn(E,N,K,device=D,dtype=torch.bfloat16)*.05;u=torch.randn_like(g);d=torch.randn(E,K,N,device=D,dtype=torch.bfloat16)*.05\nids=torch.rand(M,E,device=D).topk(T,-1).indices.int();wb=torch.rand(M,T,device=D).to(torch.bfloat16);wb=(wb/wb.sum(-1,keepdim=True)).to(torch.bfloat16);wf=wb.float()\nBM=32;maxp=M*T+E*BM\nsid=torch.empty(maxp,device=D,dtype=torch.int32);eid=torch.empty((maxp+BM-1)//BM,device=D,dtype=torch.int32);npad=torch.empty(1,device=D,dtype=torch.int32)\nmoe_align_block_size_triton(ids,E,BM,sid,eid,npad)\ngo=torch.empty(M,T,N,device=D,dtype=torch.bfloat16);uo=torch.empty_like(go)\ncommon=(None,None,None,wf,ids,sid,eid,npad)\nfor W,C in [(g,go),(u,uo)]:\n fused_moe(x,W,C,*common,False,T,tl.bfloat16,False,False,False,config=None)\ninter=(torch.nn.functional.silu(go)*uo)\nout=torch.empty(M*T,1,K,device=D,dtype=torch.bfloat16)\nfused_moe(inter.reshape(M*T,N),d,out,*common,True,1,tl.bfloat16,False,False,False,config=None)\ny=out.view(M,T,K).sum(1).to(torch.bfloat16);torch.cuda.synchronize()\nref=torch.zeros_like(x)\nfor e in range(E):\n ti,wi=torch.where(ids==e)\n if ti.numel():\n  xx=x[ti]; z=torch.nn.functional.silu(torch.nn.functional.linear(xx,g[e]))*torch.nn.functional.linear(xx,u[e]);o=torch.nn.functional.linear(z,d[e]);ref.index_add_(0,ti,o*wb[ti,wi,None])\nerr=(y-ref).abs().float();print('npad',npad.cpu(),'max',err.max().item(),'mean',err.mean().item(),'corr',torch.corrcoef(torch.stack((y.float().flatten(),ref.float().flatten())))[0,1].item(),'ratio',torch.isclose(y,ref,atol=.005,rtol=.0078125).float().mean().item());print(y[0,:8],ref[0,:8])\nPY\"","ag