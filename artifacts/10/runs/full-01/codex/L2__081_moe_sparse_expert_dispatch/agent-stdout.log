{"type":"item.started","item":{"id":"item_48","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch,triton.language as tl\nfrom aiter.ops.triton.moe.moe_op import fused_moe\nfrom aiter.ops.triton.moe.moe_align_block_size import moe_align_block_size_triton\nD='cuda';M,E,K,N,T=1024,128,4096,1408,8;R=M*T;torch.manual_seed(11)\nx=torch.randn(M,K,device=D,dtype=torch.bfloat16);w1=torch.empty(E,N,K,device=D,dtype=torch.bfloat16);w2=torch.empty(E,K,N,device=D,dtype=torch.bfloat16);ids=torch.rand(M,E,device=D).topk(T,-1).indices.int();tw=torch.ones(M,T,device=D,dtype=torch.bfloat16)/T;o1=torch.empty(M,T,N,device=D,dtype=torch.bfloat16);a2=torch.empty(R,N,device=D,dtype=torch.bfloat16);o2=torch.empty(R,1,K,device=D,dtype=torch.bfloat16)\nvariants=[]\n# bm,bn,bk,nw,gs,st,waves,mi\nfor bm in [32,64]:\n for bn,bk,nw in [(64,64,4),(64,128,4),(128,64,4),(128,64,8),(128,128,4),(128,128,8),(256,64,8),(256,128,8)]: variants.append((bm,bn,bk,nw,1,2,0,16))\n for gs in [4,8]:variants.append((bm,128,64,8,gs,2,0,16))\n for waves in [1,2,3]:variants.append((bm,128,64,8,1,2,waves,16))\n variants.append((bm,128,64,8,1,1,0,16));variants.append((bm,128,64,8,1,3,0,16));variants.append((bm,128,64,8,1,2,0,32))\nfor v in variants:\n bm,bn,bk,nw,gs,st,waves,mi=v;cfg={'BLOCK_SIZE_M':bm,'BLOCK_SIZE_N':bn,'BLOCK_SIZE_K':bk,'GROUP_SIZE_M':gs,'num_warps':nw,'num_stages':st,'waves_per_eu':waves,'matrix_instr_nonkdim':mi,'kpack':1}\n maxp=R+E*bm;sid=torch.full((maxp,),R,device=D,dtype=torch.int32);eid=torch.empty((maxp+bm-1)//bm,device=D,dtype=torch.int32);npad=torch.empty(1,device=D,dtype=torch.int32);moe_align_block_size_triton(ids,E,bm,sid,eid,npad);common=(None,None,None,tw,ids,sid,eid,npad)\n try:\n  f1=lambda:fused_moe(x,w1,o1,*common,False,T,tl.bfloat16,False,False,False,config=cfg);f2=lambda:fused_moe(a2,w2,o2,*common,False,1,tl.bfloat16,False,False,False,config=cfg);f1();f2();torch.cuda.synchronize()\n  def b(fn,n=6):\n   fn();fn();s=torch.cuda.Event(True);e=torch.cuda.Event(True);s.record();[fn() for _ in range(n)];e.record();e.synchronize();return s.elapsed_time(e)/n\n  t1=b(f1);t2=b(f2);print(v,'t1',round(t1,3),'t2',round(t2,3),'sum',round(2*t1+t2,3),'npad',npad.item())\n except Exception as ex: print(v,'ERR',str(ex)[:160])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
