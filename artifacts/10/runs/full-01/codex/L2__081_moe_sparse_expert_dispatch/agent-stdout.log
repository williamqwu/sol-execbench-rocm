{"type":"item.started","item":{"id":"item_47","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch,time,triton.language as tl\nfrom aiter.ops.triton.moe.moe_op import fused_moe\nfrom aiter.ops.triton.moe.moe_align_block_size import moe_align_block_size_triton\nD='cuda';M,E,K,N,T=1024,128,4096,1408,8;R=M*T\nx=torch.randn(M,K,device=D,dtype=torch.bfloat16)\nw1=torch.empty(E,N,K,device=D,dtype=torch.bfloat16)\nw2=torch.empty(E,K,N,device=D,dtype=torch.bfloat16)\nids=((torch.arange(M,device=D)[:,None]*T+torch.arange(T,device=D)[None,:])%E).int();tw=torch.ones(M,T,device=D,dtype=torch.bfloat16)/T\no1=torch.empty(M,T,N,device=D,dtype=torch.bfloat16);a2=torch.empty(R,N,device=D,dtype=torch.bfloat16);o2=torch.empty(R,1,K,device=D,dtype=torch.bfloat16)\nconfigs=[]\nfor bm in [16,32,64]:\n for bn,bk,nw in [(64,32,4),(64,64,4),(128,32,4),(128,64,4),(128,64,8),(256,32,8),(256,64,8)]:\n  configs.append((bm,bn,bk,nw))\nfor bm,bn,bk,nw in configs:\n cfg={'BLOCK_SIZE_M':bm,'BLOCK_SIZE_N':bn,'BLOCK_SIZE_K':bk,'GROUP_SIZE_M':1,'num_warps':nw,'num_stages':2,'waves_per_eu':0,'matrix_instr_nonkdim':16,'kpack':1}\n maxp=R+E*bm;sid=torch.full((maxp,),R,device=D,dtype=torch.int32);eid=torch.empty((maxp+bm-1)//bm,device=D,dtype=torch.int32);npad=torch.empty(1,device=D,dtype=torch.int32);moe_align_block_size_triton(ids,E,bm,sid,eid,npad)\n common=(None,None,None,tw,ids,sid,eid,npad)\n try:\n  fused_moe(x,w1,o1,*common,False,T,tl.bfloat16,False,False,False,config=cfg)\n  fused_moe(a2,w2,o2,*common,False,1,tl.bfloat16,False,False,False,config=cfg)\n  torch.cuda.synchronize()\n  def bench(fn,n=8):\n   for _ in range(2):fn()\n   s=torch.cuda.Event(enable_timing=True);e=torch.cuda.Event(enable_timing=True);s.record()\n   for _ in range(n):fn()\n   e.record();e.synchronize();return s.elapsed_time(e)/n\n  t1=bench(lambda:fused_moe(x,w1,o1,*common,False,T,tl.bfloat16,False,False,False,config=cfg))\n  t2=bench(lambda:fused_moe(a2,w2,o2,*common,False,1,tl.bfloat16,False,