{"type":"item.started","item":{"id":"item_55","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch,torch.nn.functional as F,triton.language as tl\nimport kernel\nfrom aiter.ops.triton.moe.moe_op import fused_moe\nfrom aiter.ops.triton.moe.moe_align_block_size import moe_align_block_size_triton\nD='cuda';E,K,N,T=128,4096,1408,8;torch.manual_seed(14)\nrw=torch.randn(E,K,device=D,dtype=torch.bfloat16)*.01;g=torch.empty(E,N,K,device=D,dtype=torch.bfloat16);u=torch.empty_like(g);d=torch.empty(E,K,N,device=D,dtype=torch.bfloat16);sg=torch.empty(N,K,device=D,dtype=torch.bfloat16);su=torch.empty_like(sg);sd=torch.empty(K,N,device=D,dtype=torch.bfloat16);bias=torch.randn(E,device=D)*.01\n\ndef prof(M):\n h=torch.randn(M,K,device=D,dtype=torch.bfloat16)*.01\n args=(h,rw,g,u,d,sg,su,sd,bias,1.0)\n kernel.run(*args);kernel.run(*args);torch.cuda.synchronize()\n ev=[]; names=[]\n def mark(n): names.append(n);e=torch.cuda.Event(True);e.record();ev.append(e)\n mark('start')\n logits=F.linear(h.float(),rw.float());mark('router_gemm')\n scores=torch.sigmoid(logits); vals,ids=torch.topk(scores+bias[None,:],8,-1,sorted=False); vals=(vals/(vals.sum(-1,keepdim=True)+1e-20)).to(torch.bfloat16);ids=ids.int();mark('route_topk')\n R=M*T;BM=128;mx=R+E*BM;sid=torch.full((mx,),R,device=D,dtype=torch.int32);eid=torch.empty((mx+BM-1)//BM,device=D,dtype=torch.int32);np=torch.empty(1,device=D,dtype=torch.int32);moe_align_block_size_triton(ids,E,BM,sid,eid,np);mark('route_align')\n gate=torch.empty(M,T,N,device=D,dtype=torch.bfloat16);up=torch.empty_like(gate);com=(None,None,None,vals,ids,sid,eid,np)\n fused_moe(h,g,gate,*com,False,T,tl.bfloat16,False,False,False,config=kernel._MOE_CONFIG);mark('expert_gate')\n fused_moe(h,u,up,*com,False,T,tl.bfloat16,False,False,False,config=kernel._MOE_CONFIG);mark('expert_up')\n F.silu(gate,inplace=True);gate.mul_(up);mark('expert_act')\n eo=torch.empty(R,1,K,device=D,dtype=torch.bfloat16);fused_moe(gate.reshape(R,N),d,eo,*com,False,1,tl.bfloat16,False,False,False,config=kernel._MOE_CONFIG);mark('expert_down')\n eo=eo.view(M,T,K);eo.mul_(vals.unsqueeze(-1));final=eo.sum(1);mark('weight_reduce')\n shg=F.silu(F.linear(h,sg));mark('shared_gate')\n shu=F.linear(h,su);mark('shared_up')\n shi=shg*shu;mark('shared_act')\n sho=F.linear(shi,sd);mark('shared_down')\n out=final+sho;mark('add')\n ev[-1].synchronize();ts=[ev[i].elapsed_time(ev[i+1]) for i in range(len(ev)-1)]\n print('\\\\nM',M,'total',round(sum(ts),3));\n for n,t in zip(names[1:],ts):print(n,round(t,4))\nfor m in [1024,4096,10240]:prof(m)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
