{"type":"item.started","item":{"id":"item_21","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch\nfrom aiter.fused_moe import fused_moe\n\ntorch.manual_seed(3); dev='cuda'; M,E,K,N,T=32,8,128,64,2\nx=(torch.randn(M,K,device=dev,dtype=torch.bfloat16)*.1); g=(torch.randn(E,N,K,device=dev,dtype=torch.bfloat16)*.1); u=(torch.randn(E,N,K,device=dev,dtype=torch.bfloat16)*.1); d=(torch.randn(E,K,N,device=dev,dtype=torch.bfloat16)*.1)\nids=torch.rand(M,E,device=dev).topk(T,dim=-1).indices.int()\nwb=torch.rand(M,T,device=dev).to(torch.bfloat16); wb=(wb/wb.sum(-1,keepdim=True)).to(torch.bfloat16); wf=wb.float()\nrefs={}\nfor swap in [False,True]:\n ref=torch.zeros_like(x)\n for e in range(E):\n  ti,wi=torch.where(ids==e)\n  if ti.numel():\n   xx=x[ti]\n   gg=u[e] if swap else g[e]; uu=g[e] if swap else u[e]\n   z=torch.nn.functional.silu(torch.nn.functional.linear(xx,gg))*torch.nn.functional.linear(xx,uu)\n   o=torch.nn.functional.linear(z,d[e]); ref.index_add_(0,ti,o*wb[ti,wi,None])\n refs[swap]=ref\nfor label,p in [('gu',torch.cat((g,u),1)),('ug',torch.cat((u,g),1)),('gu_inter',torch.stack((g,u),2).reshape(E,2*N,K)),('ug_inter',torch.stack((u,g),2).reshape(E,2*N,K))]:\n y=fused_moe(x,p,d,wf,ids); torch.cuda.synchronize()\n for swap,ref in refs.items():\n  err=(y-ref).abs().float(); print(label,'refswap',swap,'max',err.max().item(),'mean',err.mean().item(),'corr',torch.corrcoef(torch.stack((y.float().flatten(),ref.float().flatten())))[0,1].item())\nprint('y0',y[0,:8]); print('r0',refs[False][0,:8]);print('ids0',ids[0],wb[0])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
