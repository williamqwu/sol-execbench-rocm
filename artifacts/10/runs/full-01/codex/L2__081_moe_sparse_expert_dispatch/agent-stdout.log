{"type":"item.started","item":{"id":"item_61","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch,aiter\nfor M in [4,1024,4096,10240]:\n torch.manual_seed(16);x=torch.randn(M,128,device='cuda',dtype=torch.float32);b=torch.randn(128,device='cuda')*.1;w=torch.empty(M,8,device='cuda',dtype=torch.float32);i=torch.empty(M,8,device='cuda',dtype=torch.int32)\n try:\n  ret=aiter.moe_fused_gate(x,b,w,i,1,1,8,0,1.0);torch.cuda.synchronize();print('ret',type(ret),ret if M==4 else '')\n  sc=torch.sigmoid(x);rw,ri=torch.topk(sc+b[None],8,-1,sorted=False);rw=rw/(rw.sum(-1,keepdim=True)+1e-20)\n  # compare after sort ids\n  ai=torch.argsort(i.long(),-1);ar=torch.argsort(ri,-1);isort=i.long().gather(1,ai);rsort=ri.gather(1,ar);ws=w.gather(1,ai);rws=rw.gather(1,ar)\n  print('M',M,'idsmatch',float((isort==rsort).float().mean()),'wmax',float((ws-rws).abs().max()),'wmean',float((ws-rws).abs().mean()))\n  def f():aiter.moe_fused_gate(x,b,w,i,1,1,8,0,1.0)\n  for _ in range(3):f()\n  s=torch.cuda.Event(True);e=torch.cuda.Event(True);s.record();[f() for _ in range(100)];e.record();e.synchronize();print('ms',s.elapsed_time(e)/100)\n except Exception as ex:import traceback;traceback.print_exc()\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
