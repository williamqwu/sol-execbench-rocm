{"type":"item.started","item":{"id":"item_24","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch,time\nfrom aiter.fused_moe import fused_moe\n\ntorch.manual_seed(4); dev='cuda'; M,E,K,N,T=32,4,4096,1408,2\nx=(torch.randn(M,K,device=dev,dtype=torch.bfloat16)*.02); g=(torch.randn(E,N,K,device=dev,dtype=torch.bfloat16)*.02); u=(torch.randn(E,N,K,device=dev,dtype=torch.bfloat16)*.02); d=(torch.randn(E,K,N,device=dev,dtype=torch.bfloat16)*.02)\nids=torch.rand(M,E,device=dev).topk(T,dim=-1).indices.int(); wb=torch.rand(M,T,device=dev).to(torch.bfloat16); wb=(wb/wb.sum(-1,keepdim=True)).to(torch.bfloat16); wf=wb.float()\np=torch.cat((g,u),1)\ny=fused_moe(x,p,d,wf,ids); torch.cuda.synchronize()\nref=torch.zeros_like(x)\nfor e in range(E):\n ti,wi=torch.where(ids==e)\n if ti.numel():\n  xx=x[ti]; z=torch.nn.functional.silu(torch.nn.functional.linear(xx,g[e]))*torch.nn.functional.linear(xx,u[e]); o=torch.nn.functional.linear(z,d[e]); ref.index_add_(0,ti,o*wb[ti,wi,None])\ntorch.cuda.synchronize()\nerr=(y-ref).abs().float(); print('max',err.max().item(),'mean',err.mean().item(),'rms',err.square().mean().sqrt().item(),'ref rms',ref.float().square().mean().sqrt().item(),'corr',torch.corrcoef(torch.stack((y.float().flatten(),ref.float().flatten())))[0,1].item()); print('match',torch.isclose(y,ref,atol=.005,rtol=.0078125).float().mean().item()); print(y[0,:8]);print(ref[0,:8])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
