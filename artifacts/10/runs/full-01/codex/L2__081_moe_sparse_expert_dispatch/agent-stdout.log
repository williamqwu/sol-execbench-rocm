{"type":"item.started","item":{"id":"item_28","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch\nimport aiter.fused_moe as fm\n\ntorch.manual_seed(7); dev='cuda'; M,E,K,N,T=64,8,512,256,2\nx=torch.randn(M,K,device=dev,dtype=torch.bfloat16)*.05; g=torch.randn(E,N,K,device=dev,dtype=torch.bfloat16)*.05; u=torch.randn(E,N,K,device=dev,dtype=torch.bfloat16)*.05; d=torch.randn(E,K,N,device=dev,dtype=torch.bfloat16)*.05\nids=torch.rand(M,E,device=dev).topk(T,-1).indices.int(); wb=torch.rand(M,T,device=dev).to(torch.bfloat16); wb=(wb/wb.sum(-1,keepdim=True)).to(torch.bfloat16); wf=wb.float(); p=torch.cat((g,u),1)\nref=fm.torch_moe(x,p,d,wf,ids)\nfor dw in (False,True):\n for bm in (None,16,32,64):\n  try:\n   y=fm.fused_moe(x,p,d,wf,ids,doweight_stage1=dw,block_size_M=bm);torch.cuda.synchronize();err=(y-ref).abs().float();print('dw',dw,'bm',bm,'mean',err.mean().item(),'corr',torch.corrcoef(torch.stack((y.float().flatten(),ref.float().flatten())))[0,1].item(),'yrms',y.float().square().mean().sqrt().item(),'rrms',ref.float().square().mean().sqrt().item())\n  except Exception as e:print('ERR',dw,bm,repr(e))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
