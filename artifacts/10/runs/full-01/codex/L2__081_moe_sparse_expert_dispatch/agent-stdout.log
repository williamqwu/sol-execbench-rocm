{"type":"item.started","item":{"id":"item_20","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch\nfrom aiter.fused_moe import fused_moe\n\ntorch.manual_seed(2); dev='cuda'; M,E,K,N,T=32,4,128,64,2\nx=(torch.randn(M,K,device=dev,dtype=torch.bfloat16)*.1)\ng=(torch.randn(E,N,K,device=dev,dtype=torch.bfloat16)*.1)\nu=(torch.randn(E,N,K,device=dev,dtype=torch.bfloat16)*.1)\nd=(torch.randn(E,K,N,device=dev,dtype=torch.bfloat16)*.1)\nids=torch.randint(0,E,(M,T),device=dev,dtype=torch.int32)\nwb=torch.rand(M,T,device=dev).to(torch.bfloat16); wb=(wb/wb.sum(-1,keepdim=True)).to(torch.bfloat16); wf=wb.float()\nref=torch.zeros_like(x)\nfor e in range(E):\n ti,wi=torch.where(ids==e)\n if ti.numel():\n  xx=x[ti]; z=torch.nn.functional.silu(torch.nn.functional.linear(xx,g[e]))*torch.nn.functional.linear(xx,u[e]); o=torch.nn.functional.linear(z,d[e]); ref.index_add_(0,ti,o*wb[ti,wi,None])\nfor label,p in [('gu',torch.cat((g,u),1)),('ug',torch.cat((u,g),1)),('gu_inter',torch.stack((g,u),2).reshape(E,2*N,K)),('ug_inter',torch.stack((u,g),2).reshape(E,2*N,K))]:\n for mode in ['separated','interleave']:\n  try:\n   y=fused_moe(x,p,d,wf,ids,gate_mode=mode)\n   torch.cuda.synchronize()\n   err=(y-ref).abs().float(); ratio=torch.isclose(y,ref,atol=.0001,rtol=.0078125).float().mean()\n   print(label,mode,'max',err.max().item(),'mean',err.mean().item(),'ratio',ratio.item(),'corr',torch.corrcoef(torch.stack((y.float().flatten(),ref.float().flatten())))[0,1].item())\n  except Exception as e: print(label,mode,'ERR',repr(e))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
