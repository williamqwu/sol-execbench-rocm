{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"cat definition.json && printf '\\\\nREFERENCE\\\\n' && cat reference.py && printf '\\\\nWORKLOADS\\\\n' && cat workload.jsonl\"","aggregated_output":"{\n  \"name\": \"081_moe_sparse_expert_dispatch\",\n  \"description\": \"Sparse MoE expert computation with top-k routing across 128 routed experts. Each token is routed to 8 experts via sigmoid-based gating with group-wise selection. Includes SwiGLU activation (gate * up projection) and shared expert computation.\",\n  \"hf_id\": \"zai-org/GLM-4.5-Air\",\n  \"custom_inputs_entrypoint\": null,\n  \"axes\": {\n    \"num_tokens\": {\n      \"type\": \"var\",\n      \"description\": \"Total number of tokens (batch_size * seq_len)\"\n    },\n    \"hidden_size\": {\n      \"type\": \"const\",\n      \"value\": 4096\n    },\n    \"moe_intermediate_size\": {\n      \"type\": \"const\",\n      \"value\": 1408\n    },\n    \"n_routed_experts\": {\n      \"type\": \"const\",\n      \"value\": 128\n    },\n    \"num_experts_per_tok\": {\n      \"type\": \"const\",\n      \"value\": 8\n    },\n    \"n_group\": {\n      \"type\": \"const\",\n      \"value\": 1\n    },\n    \"topk_group\": {\n      \"type\": \"const\",\n      \"value\": 1\n    },\n    \"shared_intermediate\": {\n      \"type\": \"const\",\n      \"value\": 1408\n    }\n  },\n  \"inputs\": {\n    \"hidden_states\": {\n      \"shape\": [\n        \"num_tokens\",\n        \"hidden_size\"\n      ],\n      \"dtype\": \"bfloat16\",\n      \"description\": \"Input hidden states\"\n    },\n    \"router_weight\": {\n      \"shape\": [\n        \"n_routed_experts\",\n        \"hidden_size\"\n      ],\n      \"dtype\": \"bfloat16\",\n      \"description\": \"Router projection weights\"\n    },\n    \"expert_gate_weights\": {\n      \"shape\": [\n        \"n_routed_experts\",\n        \"moe_intermediate_size\",\n        \"hidden_size\"\n      ],\n      \"dtype\": \"bfloat16\",\n      \"description\": \"Gate projection weights for all routed experts\"\n    },\n    \"expert_up_weights\": {\n      \"shape\": [\n        \"n_routed_experts\",\n        \"moe_intermediate_size\",\n        \"hidden_size\"\n      ],\n      \"dtype\": \"bfloat16\",\n      \"description\": \"Up projection weights for all routed experts\"\n    },\n    \"expert_down_weights\": {\n      \"shape\": [\n        \"n_routed_experts\",\n        \"hidden_size\",\n        \"moe_intermediate_size\"\n      ],\n      \"dtype\": \"bfloat16\",\n      \"description\": \"Down projection weights for all routed experts\"\n    },\n    \"shared_gate_weight\": {\n      \"shape\": [\n        \"shared_intermediate\",\n        \"hidden_size\"\n      ],\n      \"dtype\": \"bfloat16\",\n      \"description\": \"Shared expert gate projection weight\"\n    },\n    \"shared_up_weight\": {\n      \"shape\": [\n        \"shared_intermediate\",\n        \"hidden_size\"\n      ],\n      \"dtype\": \"bfloat16\",\n      \"description\": \"Shared expert up projection weight\"\n    },\n    \"shared_down_weight\": {\n      \"shape\": [\n        \"hidden_size\",\n        \"shared_intermediate\"\n      ],\n      \"dtype\": \"bfloat16\",\n      \"description\": \"Shared expert down projection weight\"\n    },\n    \"e_score_correction_bias\": {\n      \"shape\": [\n        \"n_routed_experts\"\n      ],\n      \"dtype\": \"float32\",\n      \"description\": \"Expert score correction bias\"\n    },\n    \"routed_scaling_factor\": {\n      \"shape\": null,\n      \"dtype\": \"float32\",\n      \"description\": \"Scaling factor for routed expert weights\"\n    }\n  },\n  \"outputs\": {\n    \"output\": {\n      \"shape\": [\n        \"num_tokens\",\n        \"hidden_size\"\n      ],\n      \"dtype\": \"bfloat16\",\n      \"description\": \"Combined output from routed and shared experts\"\n    }\n  },\n  \"reference\": \"import torch\\nimport torch.nn.functional as F\\n\\n\\n@torch.no_grad()\\ndef run(\\n    hidden_states: torch.Tensor,\\n    router_weight: torch.Tensor,\\n    expert_gate_weights: torch.Tensor,\\n    expert_up_weights: torch.Tensor,\\n    expert_down_weights: torch.Tensor,\\n    shared_gate_weight: torch.Tensor,\\n    shared_up_weight: torch.Tensor,\\n    shared_down_weight: torch.Tensor,\\n    e_score_correction_bias: torch.Tensor,\\n    routed_scaling_factor: float,\\n):\\n    \\\"\\\"\\\"\\n    Sparse MoE expert computation with top-k routing.\\n    \\n    1. Compute routing scores via sigmoid activation\\n    2. Apply group-wise expert selection (n_group=1, topk_group=1 simplifies to global topk)\\n    3. Select top-8 experts per token\\n    4. Compute SwiGLU for each selected expert\\n    5. Combine with shared expert output\\n    \\\"\\\"\\\"\\n    # Constants\\n    n_routed_experts = 128\\n    num_experts_per_tok = 8\\n    n_group = 1\\n    topk_group = 1\\n    norm_topk_prob = True\\n    \\n    num_tokens = hidden_states.shape[0]\\n    hidden_size = hidden_states.shape[1]\\n    \\n    # Router logits: [num_tokens, n_routed_experts]\\n    router_logits = F.linear(hidden_states.float(), router_weight.float())\\n    \\n    # Sigmoid activation for scores\\n    scores = torch.sigmoid(router_logits)\\n    \\n    # Apply score correction bias\\n    scores_for_choice = scores + e_score_correction_bias.unsqueeze(0)\\n    \\n    # Group-wise expert selection\\n    experts_per_group = n_routed_experts // n_group\\n    group_scores = scores_for_choice.view(-1, n_group, experts_per_group)\\n    \\n    # Select top-2 experts per group and sum their scores\\n    group_scores_agg = group_scores.topk(2, dim=-1)[0].sum(dim=-1)  # [num_tokens, n_group]\\n    \\n    # Select top groups\\n    group_idx = torch.topk(group_scores_agg, k=topk_group, dim=-1, sorted=False)[1]\\n    \\n    # Create mask for selected groups\\n    group_mask = torch.zeros_like(group_scores_agg)\\n    group_mask.scatter_(1, group_idx, 1)\\n    \\n    # Expand mask to all experts\\n    score_mask = (\\n        group_mask.unsqueeze(-1)\\n        .expand(-1, n_group, experts_per_group)\\n        .reshape(-1, n_routed_experts)\\n    )\\n    \\n    # Mask out non-selected groups\\n    scores_for_choice = scores_for_choice.masked_fill(~score_mask.bool(), 0.0)\\n    \\n    # Select top-k experts\\n    topk_weights, topk_indices = torch.topk(\\n        scores_for_choice, k=num_experts_per_tok, dim=-1, sorted=False\\n    )\\n    \\n    # Normalize weights if required\\n    if norm_topk_prob:\\n        denominator = topk_weights.sum(dim=-1, keepdim=True) + 1e-20\\n        topk_weights = topk_weights / denominator\\n    \\n    # Apply routing scaling factor\\n    topk_weights = topk_weights * routed_scaling_factor\\n    topk_weights = topk_weights.to(hidden_states.dtype)\\n    \\n    # Compute routed expert outputs\\n    final_hidden_states = torch.zeros_like(hidden_states, dtype=topk_weights.dtype)\\n    \\n    # Create expert mask: [n_routed_experts, num_tokens, num_experts_per_tok]\\n    expert_mask = F.one_hot(topk_indices, num_classes=n_routed_experts)\\n    expert_mask = expert_mask.permute(2, 0, 1)  # [n_routed_experts, num_tokens, num_experts_per_tok]\\n    \\n    # Process each expert\\n    for expert_idx in range(n_routed_experts):\\n        mask = expert_mask[expert_idx]  # [num_tokens, num_experts_per_tok]\\n        token_indices, weight_indices = torch.where(mask)\\n        \\n        if token_indices.numel() > 0:\\n            # Get routing weights for this expert\\n            expert_weights = topk_weights[token_indices, weight_indices]\\n            \\n            # Get input tokens for this expert\\n            expert_input = hidden_states[token_indices]\\n            \\n            # Expert MLP computation: SwiGLU activation\\n            gate_output = F.silu(\\n                F.linear(expert_input, expert_gate_weights[expert_idx])\\n            )\\n            up_output = F.linear(expert_input, expert_up_weights[expert_idx])\\n            intermediate = gate_output * up_output\\n            expert_output = F.linear(intermediate, expert_down_weights[expert_idx])\\n            \\n            # Apply routing weights\\n            weighted_output = expert_output * expert_weights.unsqueeze(-1)\\n            \\n            # Accumulate to final output\\n            final_hidden_states.index_add_(0, token_indices, weighted_output)\\n    \\n    final_hidden_states = final_hidden_states.to(hidden_states.dtype)\\n    \\n    # Compute shared expert output\\n    shared_gate_output = F.silu(F.linear(hidden_states, shared_gate_weight))\\n    shared_up_output = F.linear(hidden_states, shared_up_weight)\\n    shared_intermediate = shared_gate_output * shared_up_output\\n    shared_output = F.linear(shared_intermediate, shared_down_weight)\\n    \\n    # Combine routed and shared experts\\n    output = final_hidden_states + shared_output\\n    \\n    return output\\n\"\n}\n\nREFERENCE\nimport torch\nimport torch.nn.functional as F\n\n\n@torch.no_grad()\ndef run(\n    hidden_states: torch.Tensor,\n    router_weight: torch.Tensor,\n    expert_gate_weights: torch.Tensor,\n    expert_up_weights: torch.Tensor,\n    expert_down_weights: torch.Tensor,\n    shared_gate_weight: torch.Tensor,\n    shared_up_weight: torch.Tensor,\n    shared_down_weight: torch.Tensor,\n    e_score_correction_bias: torch.Tensor,\n    routed_scaling_factor: float,\n):\n    \"\"\"\n    Sparse MoE expert computation with top-k routing.\n    \n    1. Compute routing scores via sigmoid activation\n    2. Apply group-wise expert selection (n_group=1, topk_group=1 simplifies to global topk)\n    3. Select top-8 experts per token\n    4. Compute SwiGLU for each selected expert\n    5. Combine with shared expert output\n    \"\"\"\n    # Constants\n    n_routed_experts = 128\n    num_experts_per_tok = 8\n    n_group = 1\n    topk_group = 1\n    norm_topk_prob = True\n    \n    num_tokens = hidden_states.shape[0]\n    hidden_size = hidden_states.shape[1]\n    \n    # Router logits: [num_tokens, n_routed_experts]\n    router_logits = F.linear(hidden_states.float(), router_weight.float())\n    \n    # Sigmoid activation for scores\n    scores = torch.sigmoid(router_logits)\n    \n    # Apply score correction bias\n    scores_for_choice = scores + e_score_correction_bias.unsqueeze(0)\n    \n    # Group-wise expert selection\n    experts_per_group = n_routed_experts // n_group\n    group_scores = scores_for_choice.view(-1, n_group, experts_per_group)\n    \n    # Select top-2 experts per group and sum their scores\n    group_scores_agg = group_scores.topk(2, dim=-1)[0].sum(dim=-1)  # [num_tokens, n_group]\n    \n    # Select top groups\n    group_idx = torch.topk(group_scores_agg, k=topk_group, dim=-1, sorted=False)[1]\n    \n    # Create mask for selected groups\n    group_mask = torch.zeros_like(group_scores_agg)\n    group_mask.scatter_(1, group_idx, 1)\n    \n    # Expand mask to all experts\n    score_mask = (\n        group_mask.unsqueeze(-1)\n        .expand(-1, n_group, experts_per_group)\n        .reshape(-1, n_routed_experts)\n    )\n    \n    # Mask out non-selected groups\n    scores_for_choice = scores_for_choice.masked_fill(~score_mask.bool(), 0.0)\n    \n    # Select top-k experts\n    topk_weights, topk_indices = torch.topk(\n        scores_for_choice, k=num_experts_per_tok, dim=-1, sorted=False\n    )\n    \n    # Normalize weights if required\n    if norm_topk_prob:\n        denominator = topk_weights.sum(dim=-1, keepdim=True) + 1e-20\n        topk_weights = topk_weights / denominator\n    \n    # Apply routing scaling factor\n    topk_weights = topk_weights * routed_scaling_factor\n    topk_weights = topk_weights.to(hidden_states.dtype)\n    \n    # Compute routed expert outputs\n    final_hidden_states = torch.zeros_like(hidden_states, dtype=topk_weights.dtype)\n    \n    # Create expert mask: [n_routed_experts, num_tokens, num_experts_per_tok]\n    expert_mask = F.one_hot(topk_indices, num_classes=n_routed_experts)\n    expert_mask = expert_mask.permute(2, 0, 1)  # [n_routed_experts, num_tokens, num_experts_per_tok]\n    \n    # Process each expert\n    for expert_idx in range(n_routed_experts):\n        mask = expert_mask[expert_idx]  # [num_tokens, num_experts_per_tok]\n        token_indices, weight_indices = torch.where(mask)\n        \n        if token_indices.numel() > 0:\n            # Get routing weights for this expert\n            expert_weights = topk_weights[token_indices, weight_indices]\n            \n            # Get input tokens for this expert\n            expert_input = hidden_states[token_indices]\n            \n            # Expert MLP computation: SwiGLU activation\n            gate_output = F.silu(\n                F.linear(expert_input, expert_gate_weights[expert_idx])\n            )\n            up_output = F.linear(expert_input, expert_up_weights[expert_idx])\n            intermediate = gate_output * up_output\n            expert_output = F.linear(intermediate, expert_down_weights[expert_idx])\n            \n            # Apply routing weights\n            weighted_output = expert_output * expert_weights.unsqueeze(-1)\n            \n            # Accumulate to final output\n            final_hidden_states.index_add_(0, token_indices, weighted_output)\n    \n    final_hidden_states = final_hidden_states.to(hidden_states.dtype)\n    \n    # Compute shared expert output\n    shared_gate_output = F.silu(F.linear(hidden_states, shared_gate_weight))\n    shared_up_output = F.linear(hidden_states, shared_up_weight)\n    shared_intermediate = shared_gate_output * shared_up_output\n    shared_output = F.linear(shared_intermediate, shared_down_weight)\n    \n    # Combine routed and shared experts\n    output = final_hidden_states + shared_output\n    \n    return output\n\nWORKLOADS\n{\"uuid\": \"b88323ee-9a28-5b47-a35b-a5346efea2c2\", \"axes\": {\"num_tokens\": 10240}, \"inputs\": {\"hidden_states\": {\"type\": \"random\"}, \"router_weight\": {\"type