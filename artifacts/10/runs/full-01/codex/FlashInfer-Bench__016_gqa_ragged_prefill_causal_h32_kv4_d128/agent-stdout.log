{"type":"item.started","item":{"id":"item_9","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport math,time,torch,aiter\nfrom reference import run as ref\n\ndef check(lens):\n    cu=torch.tensor([0]+list(__import__('itertools').accumulate(lens)),device='cuda',dtype=torch.int32)\n    n=sum(lens); m=max(lens)\n    torch.manual_seed(123)\n    q=torch.randn(n,32,128,device='cuda',dtype=torch.bfloat16)\n    k=torch.randn(n,4,128,device='cuda',dtype=torch.bfloat16)\n    v=torch.randn(n,4,128,device='cuda',dtype=torch.bfloat16)\n    s=1/math.sqrt(128)\n    ro,rl=ref(q,k,v,cu,cu,s)\n    funcs=[]\n    for cvt in (0,1,2):\n      funcs.append((f'v3-cvt{cvt}',lambda cvt=cvt: aiter.flash_attn_varlen_func(q,k,v,cu,cu,m,m,softmax_scale=s,causal=True,return_lse=True,how_v3_bf16_cvt=cvt)))\n    funcs.append(('sink-asm',lambda: aiter.fmha_fwd_with_sink_varlen_asm(q,k,v,cu,cu,m,s,True,True)))\n    funcs.append(('opus',lambda: (aiter.fmha_fwd_bf16_opus_varlen_fwd(q,k,v,s,True,cu,cu,m,m),None)))\n    for name,fn in funcs:\n      try:\n       got=fn(); torch.cuda.synchronize(); out,l=got\n       oe=(out.float()-ro.float()).abs(); otol=0.00465513032084137+0.0078125*ro.float().abs()\n       ostr=(oe<=otol).float().mean().item()\n       if l is not None:\n        if l.shape == (32,n): l=l.T\n        l=l/math.log(2)\n        le=(l-rl).abs(); ltol=0.00465513032084137+0.0078125*rl.abs()\n        lstr=(le<=ltol).float().mean().item(); lm=le.max().item()\n       else: lstr=lm=float('nan')\n       for _ in range(10): fn()\n       torch.cuda.synchronize(); t=time.perf_counter()\n       for _ in range(100): fn()\n       torch.cuda.synchronize(); us=(time.perf_counter()-t)*1e4\n       print(lens,name,'out',oe.max().item(),ostr,'lse',lm,lstr,'us',us)\n      except Exception as e: print(lens,name,'ERR',type(e).__name__,e)\ncheck([34])\ncheck([6])\ncheck([1])\ncheck([3,5,17])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
