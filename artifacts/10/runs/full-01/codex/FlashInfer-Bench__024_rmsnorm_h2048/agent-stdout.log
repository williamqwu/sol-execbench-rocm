{"type":"item.started","item":{"id":"item_24","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch,triton,random,statistics\nimport kernel\nfor b in (16254,12383):\n x=torch.randn((b,2048),device='cuda',dtype=torch.bfloat16);w=torch.randn(2048,device='cuda',dtype=torch.bfloat16);y=torch.empty_like(x)\n cases=[]\n for rows in (1,2,3,4,5,6,8):\n  for nw in (1,2,4):\n   grid=(triton.cdiv(b,rows),)\n   if rows==1:\n    opts=dict(X_CACHE='.cg',X_EVICT='evict_first',W_CACHE='.ca',W_EVICT='evict_last',O_CACHE='.cg',O_EVICT='evict_first')\n    fn=lambda nw=nw,grid=grid: kernel._rmsnorm_cache_kernel[grid](x,w,y,num_warps=nw,**opts)\n   else:\n    fn=lambda rows=rows,nw=nw,grid=grid: kernel._rmsnorm_grouped_kernel[grid](x,w,y,b,ROWS_PER_PROGRAM=rows,num_warps=nw)\n   fn();cases.append((rows,nw,fn))\n torch.cuda.synchronize()\n results={(r,n):[] for r,n,_ in cases}\n for seed in range(3):\n  random.Random(seed+b).shuffle(cases)\n  for rows,nw,fn in cases:\n   results[(rows,nw)].append(triton.testing.do_bench(fn,warmup=10,rep=60))\n print('batch',b)\n for (rows,nw),vals in results.items():\n  print(f' rows {rows} nw {nw}: median {statistics.median(vals):.6f} vals', ' '.join(f'{v:.6f}' for v in vals))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
