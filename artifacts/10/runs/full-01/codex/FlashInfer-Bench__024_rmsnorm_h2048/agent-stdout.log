{"type":"item.completed","item":{"id":"item_44","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,280p' kernel.py\"","aggregated_output":"import torch\nimport triton\nimport triton.language as tl\n\n\n@triton.jit\ndef _rmsnorm_kernel(x_ptr, w_ptr, out_ptr):\n    row = tl.program_id(0)\n    cols = tl.arange(0, 2048)\n\n    x = tl.load(x_ptr + row * 2048 + cols).to(tl.float32)\n    variance = tl.sum(x * x, axis=0) * (1.0 / 2048.0)\n    inv_rms = tl.rsqrt(variance + 1.0e-6)\n    weight = tl.load(\n        w_ptr + cols,\n        cache_modifier=\".ca\",\n        eviction_policy=\"evict_last\",\n    ).to(tl.float32)\n    out = (x * inv_rms) * weight\n    tl.store(out_ptr + row * 2048 + cols, out)\n\n\n@triton.jit\ndef _rmsnorm_grouped_kernel(\n    x_ptr,\n    w_ptr,\n    out_ptr,\n    n_rows,\n    ROWS_PER_PROGRAM: tl.constexpr,\n):\n    first_row = tl.program_id(0) * ROWS_PER_PROGRAM\n    cols = tl.arange(0, 2048)\n    weight = tl.load(w_ptr + cols).to(tl.float32)\n\n    for row_offset in tl.static_range(ROWS_PER_PROGRAM):\n        row = first_row + row_offset\n        mask = row < n_rows\n        x = tl.load(\n            x_ptr + row * 2048 + cols,\n            mask=mask,\n            other=0.0,\n            cache_modifier=\".cg\",\n            eviction_policy=\"evict_first\",\n        ).to(tl.float32)\n        variance = tl.sum(x * x, axis=0) * (1.0 / 2048.0)\n        inv_rms = tl.rsqrt(variance + 1.0e-6)\n        out = (x * inv_rms) * weight\n        tl.store(\n            out_ptr + row * 2048 + cols,\n            out,\n            mask=mask,\n            cache_modifier=\".wt\",\n            eviction_policy=\"evict_first\",\n        )\n\n\n@triton.jit\ndef _rmsnorm_cache_kernel(\n    x_ptr,\n    w_ptr,\n    out_ptr,\n    X_CACHE: tl.constexpr,\n    X_EVICT: tl.constexpr,\n    W_CACHE: tl.constexpr,\n    W_EVICT: tl.constexpr,\n    O_CACHE: tl.constexpr,\n    O_EVICT: tl.constexpr,\n):\n    row = tl.program_id(0)\n    cols = tl.arange(0, 2048)\n    x = tl.load(\n        x_ptr + row * 2048 + cols,\n        cache_modifier=X_CACHE,\n        eviction_policy=X_EVICT,\n    ).to(tl.float32)\n    variance = tl.sum(x * x, axis=0) * (1.0 / 2048.0)\n    inv_rms = tl.rsqrt(variance + 1.0e-6)\n    weight = tl.load(\n        w_ptr + cols,\n        cache_modifier=W_CACHE,\n        eviction_policy=W_EVICT,\n    ).to(tl.float32)\n    out = (x * inv_rms) * weight\n    tl.store(\n        out_ptr + row * 2048 + cols,\n        out,\n        cache_modifier=O_CACHE,\n        eviction_policy=O_EVICT,\n    )\n\n\n@triton.jit\ndef _rmsnorm_pair_kernel(\n    x_ptr,\n    w_ptr,\n    out_ptr,\n    n_rows,\n    EVEN_ROWS: tl.constexpr,\n    X_CACHE: tl.constexpr,\n    X_EVICT: tl.constexpr,\n    W_CACHE: tl.constexpr,\n    W_EVICT: tl.constexpr,\n    O_CACHE: tl.constexpr,\n    O_EVICT: tl.constexpr,\n):\n    first_row = tl.program_id(0) * 2\n    cols = tl.arange(0, 2048)\n    weight = tl.load(\n        w_ptr + cols,\n        cache_modifier=W_CACHE,\n        eviction_policy=W_EVICT,\n    ).to(tl.float32)\n\n    x0 = tl.load(\n        x_ptr + first_row * 2048 + cols,\n        cache_modifier=X_CACHE,\n        eviction_policy=X_EVICT,\n    ).to(tl.float32)\n    variance0 = tl.sum(x0 * x0, axis=0) * (1.0 / 2048.0)\n    inv_rms0 = tl.rsqrt(variance0 + 1.0e-6)\n    out0 = (x0 * inv_rms0) * weight\n    tl.store(\n        out_ptr + first_row * 2048 + cols,\n        out0,\n        cache_modifier=O_CACHE,\n        eviction_policy=O_EVICT,\n    )\n\n    second_row = first_row + 1\n    if EVEN_ROWS:\n        x1 = tl.load(\n            x_ptr + second_row * 2048 + cols,\n            cache_modifier=X_CACHE,\n            eviction_policy=X_EVICT,\n        ).to(tl.float32)\n    else:\n        second_valid = second_row < n_rows\n        x1 = tl.load(\n            x_ptr + second_row * 2048 + cols,\n            mask=second_valid,\n            other=0.0,\n            cache_modifier=X_CACHE,\n            eviction_policy=X_EVICT,\n        ).to(tl.float32)\n    variance1 = tl.sum(x1 * x1, axis=0) * (1.0 / 2048.0)\n    inv_rms1 = tl.rsqrt(variance1 + 1.0e-6)\n    out1 = (x1 * inv_rms1) * weight\n    if EVEN_ROWS:\n        tl.store(\n            out_ptr + second_row * 2048 + cols,\n            out1,\n            cache_modifier=O_CACHE,\n            eviction_policy=O_EVICT,\n        )\n    else:\n        tl.store(\n            out_ptr + second_row * 2048 + cols,\n            out1,\n            mask=second_valid,\n            cache_modifier=O_CACHE,\n            eviction_policy=O_EVICT,\n        )\n\n\n@triton.jit\ndef _rmsnorm_2d_kernel(\n    x_ptr,\n    w_ptr,\n    out_ptr,\n    n_rows,\n    ROWS_PER_PROGRAM: tl.constexpr,\n):\n    first_row = tl.program_id(0) * ROWS_PER_PROGRAM\n    row_offsets = tl.arange(0, ROWS_PER_PROGRAM)[:, None]\n    cols = tl.arange(0, 2048)[None, :]\n    rows = first_row + row_offsets\n    mask = rows < n_rows\n\n    x = tl.load(\n        x_ptr + rows * 2048 + cols,\n        mask=mask,\n        other=0.0,\n        cache_modifier=\".cg\",\n        eviction_policy=\"evict_first\",\n    ).to(tl.float32)\n    variance = tl.sum(x * x, axis=1) * (1.0 / 2048.0)\n    inv_rms = tl.rsqrt(variance + 1.0e-6)\n    weight = tl.load(\n        w_ptr + cols,\n        cache_modifier=\".ca\",\n        eviction_policy=\"evict_last\",\n    ).to(tl.float32)\n    out = (x * inv_rms[:, None]) * weight\n    tl.store(\n        out_ptr + rows * 2048 + cols,\n        out,\n        mask=mask,\n        cache_modifier=\".cg\",\n        eviction_policy=\"evict_first\",\n    )\n\n\ndef run(hidden_states, weight):\n    output = torch.empty_like(hidden_states)\n    rows = hidden_states.shape[0]\n    _rmsnorm_grouped_kernel[((rows + 1) // 2,)](\n        hidden_states,\n        weight,\n        output,\n        rows,\n        ROWS_PER_PROGRAM=2,\n        num_warps=2,\n    )\n    return output\n","exit_code":0,"status":"completed"}}
