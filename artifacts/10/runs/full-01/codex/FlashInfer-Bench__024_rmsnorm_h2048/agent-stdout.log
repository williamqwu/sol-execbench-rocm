{"type":"item.started","item":{"id":"item_30","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch,triton,statistics\nimport kernel\nfor b in (12383,16254):\n x=torch.randn((b,2048),device='cuda',dtype=torch.bfloat16);w=torch.randn(2048,device='cuda',dtype=torch.bfloat16);y=torch.empty_like(x);grid=((b+1)//2,)\n print('batch',b)\n for nw in (1,2,4):\n  fpair=lambda nw=nw: kernel._rmsnorm_pair_kernel[grid](x,w,y,b,EVEN_ROWS=(b%2==0),num_warps=nw)\n  fgroup=lambda nw=nw: kernel._rmsnorm_grouped_kernel[grid](x,w,y,b,ROWS_PER_PROGRAM=2,num_warps=nw)\n  fpair();fgroup();torch.cuda.synchronize()\n  for label,fn in (('pair',fpair),('group',fgroup)):\n   vals=[triton.testing.do_bench(fn,warmup=15,rep=100) for _ in range(3)]\n   print(label,'nw',nw,'median',f'{statistics.median(vals):.6f}','vals',' '.join(f'{v:.6f}' for v in vals))\nprint('pair metadata')\nfor key,ck in kernel._rmsnorm_pair_kernel.device_caches[0][0].items():\n print(key,'regs',ck.n_regs,'asm_lines',len(ck.asm['amdgcn'].splitlines()),'shared',ck.metadata.shared)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
