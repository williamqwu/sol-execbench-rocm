{"type":"item.started","item":{"id":"item_42","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch\nl=211;n=422\nu=torch.randn((1,256,l),device='cuda');k=torch.randn((256,l),device='cuda');uf=torch.fft.rfft(u,n=n);kf=torch.fft.rfft(k,n=n)/n; ref=uf*kf.unsqueeze(0)\nur,ui=uf.real,uf.imag;kr,ki=kf.real.unsqueeze(0),kf.imag.unsqueeze(0)\n# each listed torch op launches, forcing rounding\np1=ur*kr;p2=ui*ki; rr=p1-p2\np3=ur*ki;p4=ui*kr; ii=p3+p4\nfor name,a,b in [('real nofma',rr,ref.real),('imag nofma',ii,ref.imag)]:\n d=(a-b).abs();print(name,d.max().item(),d.mean().item(),(d==0).float().mean().item())\n# addcmul c + a*b may use element kernel FMA\nrr2=torch.addcmul(p1,-ui,ki); ii2=torch.addcmul(p3,ui,kr)\nfor name,a,b in [('real addcmul',rr2,ref.real),('imag addcmul',ii2,ref.imag)]:\n d=(a-b).abs();print(name,d.max().item(),d.mean().item(),(d==0).float().mean().item())\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
