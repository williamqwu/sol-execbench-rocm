{"type":"item.completed","item":{"id":"item_19","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,180p' kernel.py && python -m py_compile kernel.py\"","aggregated_output":"import torch\nimport triton\nimport triton.language as tl\n\n\n@triton.jit\ndef _fused_gate_projection(\n    conv_ptr,\n    gated_ptr,\n    x0_ptr,\n    skip_bias_ptr,\n    weight_ptr,\n    out_bias_ptr,\n    output_ptr,\n    L: tl.constexpr,\n    BLOCK_M: tl.constexpr,\n    BLOCK_N: tl.constexpr,\n    BLOCK_K: tl.constexpr,\n):\n    pid_l = tl.program_id(0)\n    pid_n = tl.program_id(1)\n    pid_b = tl.program_id(2)\n    offs_l = pid_l * BLOCK_M + tl.arange(0, BLOCK_M)\n    offs_n = pid_n * BLOCK_N + tl.arange(0, BLOCK_N)\n    accumulator = tl.zeros((BLOCK_M, BLOCK_N), dtype=tl.float32)\n\n    for k_start in range(0, 256, BLOCK_K):\n        offs_k = k_start + tl.arange(0, BLOCK_K)\n        input_offsets = (\n            pid_b * (256 * L)\n            + offs_k[None, :] * L\n            + offs_l[:, None]\n        )\n        input_mask = offs_l[:, None] < L\n        conv = tl.load(conv_ptr + input_offsets, mask=input_mask, other=0.0)\n        gated = tl.load(gated_ptr + input_offsets, mask=input_mask, other=0.0)\n        gate0 = tl.load(x0_ptr + input_offsets, mask=input_mask, other=0.0)\n        skip_bias = tl.load(skip_bias_ptr + offs_k)[None, :]\n        projection_input = (conv + gated * skip_bias) * gate0\n\n        weight_offsets = offs_k[:, None] + offs_n[None, :] * 256\n        weight = tl.load(weight_ptr + weight_offsets)\n        accumulator = tl.dot(\n            projection_input, weight, accumulator, input_precision=\"ieee\"\n        )\n\n    accumulator += tl.load(out_bias_ptr + offs_n)[None, :]\n    output_offsets = (pid_b * L + offs_l[:, None]) * 256 + offs_n[None, :]\n    tl.store(\n        output_ptr + output_offsets,\n        accumulator,\n        mask=offs_l[:, None] < L,\n    )\n\n\n@torch.no_grad()\ndef run(v, x0, x1, k, bias, out_proj_weight, out_proj_bias):\n    batch, _, seqlen = v.shape\n    fft_size = 2 * seqlen\n\n    gated = v * x1\n    k_f = torch.fft.rfft(k[0], n=fft_size) / fft_size\n    u_f = torch.fft.rfft(gated, n=fft_size)\n    conv = torch.fft.irfft(\n        u_f * k_f.unsqueeze(0), n=fft_size, norm=\"forward\"\n    )[..., :seqlen]\n\n    output = torch.empty(\n        (batch, seqlen, 256), device=v.device, dtype=torch.float32\n    )\n    block_m = 64\n    block_n = 64\n    grid = (triton.cdiv(seqlen, block_m), triton.cdiv(256, block_n), batch)\n    _fused_gate_projection[grid](\n        conv,\n        gated,\n        x0,\n        bias,\n        out_proj_weight,\n        out_proj_bias,\n        output,\n        L=seqlen,\n        BLOCK_M=block_m,\n        BLOCK_N=block_n,\n        BLOCK_K=64,\n        num_warps=4,\n        num_stages=2,\n    )\n    return output\n","exit_code":0,"status":"completed"}}
