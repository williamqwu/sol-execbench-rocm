{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' reference.py && sed -n '1,260p' definition.json && sed -n '1,260p' workload.jsonl\"","aggregated_output":"import torch\nimport torch.nn.functional as F\n\n@torch.no_grad()\ndef run(\n    x: torch.Tensor,\n    conv1_weight: torch.Tensor,\n    norm1_weight: torch.Tensor,\n    norm1_bias: torch.Tensor,\n    conv2_weight: torch.Tensor,\n    norm2_weight: torch.Tensor,\n    norm2_bias: torch.Tensor,\n    eps: float,\n):\n    \"\"\"\n    Fused residual block: Conv3x3 -> GroupNorm -> SiLU -> Conv3x3 -> GroupNorm -> SiLU -> Add\n    \n    Args:\n        x: Input tensor of shape (B, C, H, W)\n        conv1_weight: First conv weights (C, C, 3, 3)\n        norm1_weight: First GroupNorm scale (C,)\n        norm1_bias: First GroupNorm bias (C,)\n        conv2_weight: Second conv weights (C, C, 3, 3)\n        norm2_weight: Second GroupNorm scale (C,)\n        norm2_bias: Second GroupNorm bias (C,)\n        eps: Epsilon for GroupNorm numerical stability\n        \n    Returns:\n        Output tensor of shape (B, C, H, W)\n    \"\"\"\n    num_groups = 32\n    \n    # Save residual\n    residual = x\n    \n    # First path: Conv3x3 -> GroupNorm -> SiLU\n    out = F.conv2d(x, conv1_weight, bias=None, stride=1, padding=1)\n    out = F.group_norm(out, num_groups, weight=norm1_weight, bias=norm1_bias, eps=eps)\n    out = F.silu(out)\n    \n    # Second path: Conv3x3 -> GroupNorm -> SiLU\n    out = F.conv2d(out, conv2_weight, bias=None, stride=1, padding=1)\n    out = F.group_norm(out, num_groups, weight=norm2_weight, bias=norm2_bias, eps=eps)\n    out = F.silu(out)\n    \n    # Residual connection\n    out = out + residual\n    \n    return out\n{\n  \"name\": \"002_vae_conv3x3_groupnorm_silu_residual_fused\",\n  \"description\": \"Complete fused residual block combining two sequential Conv3x3->GroupNorm->SiLU operations with residual addition. This is the fundamental building block of Sana's VAE encoder/decoder: input -> Conv3x3 -> GroupNorm -> SiLU -> Conv3x3 -> GroupNorm -> SiLU -> add(input). Processes feature maps with 256 channels and 32 groups for GroupNorm.\",\n  \"hf_id\": \"Efficient-Large-Model/Sana-Sprint-1.6B-1024px\",\n  \"custom_inputs_entrypoint\": null,\n  \"axes\": {\n    \"batch_size\": {\n      \"type\": \"var\",\n      \"description\": \"Batch size\"\n    },\n    \"channels\": {\n      \"type\": \"const\",\n      \"value\": 256,\n      \"description\": \"Number of input/output channels\"\n    },\n    \"height\": {\n      \"type\": \"var\",\n      \"description\": \"Spatial height\"\n    },\n    \"width\": {\n      \"type\": \"var\",\n      \"description\": \"Spatial width\"\n    },\n    \"num_groups\": {\n      \"type\": \"const\",\n      \"value\": 32,\n      \"description\": \"Number of groups for GroupNorm\"\n    },\n    \"kernel_size\": {\n      \"type\": \"const\",\n      \"value\": 3,\n      \"description\": \"Convolution kernel size\"\n    }\n  },\n  \"inputs\": {\n    \"x\": {\n      \"shape\": [\n        \"batch_size\",\n        \"channels\",\n        \"height\",\n        \"width\"\n      ],\n      \"dtype\": \"float32\",\n      \"description\": \"Input feature map\"\n    },\n    \"conv1_weight\": {\n      \"shape\": [\n        \"channels\",\n        \"channels\",\n        \"kernel_size\",\n        \"kernel_size\"\n      ],\n      \"dtype\": \"float32\",\n      \"description\": \"First convolution weights\"\n    },\n    \"norm1_weight\": {\n      \"shape\": [\n        \"channels\"\n      ],\n      \"dtype\": \"float32\",\n      \"description\": \"First GroupNorm scale parameter\"\n    },\n    \"norm1_bias\": {\n      \"shape\": [\n        \"channels\"\n      ],\n      \"dtype\": \"float32\",\n      \"description\": \"First GroupNorm bias parameter\"\n    },\n    \"conv2_weight\": {\n      \"shape\": [\n        \"channels\",\n        \"channels\",\n        \"kernel_size\",\n        \"kernel_size\"\n      ],\n      \"dtype\": \"float32\",\n      \"description\": \"Second convolution weights\"\n    },\n    \"norm2_weight\": {\n      \"shape\": [\n        \"channels\"\n      ],\n      \"dtype\": \"float32\",\n      \"description\": \"Second GroupNorm scale parameter\"\n    },\n    \"norm2_bias\": {\n      \"shape\": [\n        \"channels\"\n      ],\n      \"dtype\": \"float32\",\n      \"description\": \"Second GroupNorm bias parameter\"\n    },\n    \"eps\": {\n      \"shape\": null,\n      \"dtype\": \"float32\",\n      \"description\": \"Epsilon for numerical stability in GroupNorm\"\n    }\n  },\n  \"outputs\": {\n    \"output\": {\n      \"shape\": [\n        \"batch_size\",\n        \"channels\",\n        \"height\",\n        \"width\"\n      ],\n      \"dtype\": \"float32\",\n      \"description\": \"Output feature map after residual block\"\n    }\n  },\n  \"reference\": \"import torch\\nimport torch.nn.functional as F\\n\\n@torch.no_grad()\\ndef run(\\n    x: torch.Tensor,\\n    conv1_weight: torch.Tensor,\\n    norm1_weight: torch.Tensor,\\n    norm1_bias: torch.Tensor,\\n    conv2_weight: torch.Tensor,\\n    norm2_weight: torch.Tensor,\\n    norm2_bias: torch.Tensor,\\n    eps: float,\\n):\\n    \\\"\\\"\\\"\\n    Fused residual block: Conv3x3 -> GroupNorm -> SiLU -> Conv3x3 -> GroupNorm -> SiLU -> Add\\n    \\n    Args:\\n        x: Input tensor of shape (B, C, H, W)\\n        conv1_weight: First conv weights (C, C, 3, 3)\\n        norm1_weight: First GroupNorm scale (C,)\\n        norm1_bias: First GroupNorm bias (C,)\\n        conv2_weight: Second conv weights (C, C, 3, 3)\\n        norm2_weight: Second GroupNorm scale (C,)\\n        norm2_bias: Second GroupNorm bias (C,)\\n        eps: Epsilon for GroupNorm numerical stability\\n        \\n    Returns:\\n        Output tensor of shape (B, C, H, W)\\n    \\\"\\\"\\\"\\n    num_groups = 32\\n    \\n    # Save residual\\n    residual = x\\n    \\n    # First path: Conv3x3 -> GroupNorm -> SiLU\\n    out = F.conv2d(x, conv1_weight, bias=None, stride=1, padding=1)\\n    out = F.group_norm(out, num_groups, weight=norm1_weight, bias=norm1_bias, eps=eps)\\n    out = F.silu(out)\\n    \\n    # Second path: Conv3x3 -> GroupNorm -> SiLU\\n    out = F.conv2d(out, conv2_weight, bias=None, stride=1, padding=1)\\n    out = F.group_norm(out, num_groups, weight=norm2_weight, bias=norm2_bias, eps=eps)\\n    out = F.silu(out)\\n    \\n    # Residual connection\\n    out = out + residual\\n    \\n    return out\\n\"\n}\n{\"uuid\": \"7b00c2c8-1eaa-55ec-a575-64639d605881\", \"axes\": {\"batch_size\": 16, \"height\": 64, \"width\": 64}, \"inputs\": {\"x\": {\"type\": \"random\"}, \"conv1_weight\": {\"type\": \"random\"}, \"norm1_weight\": {\"type\": \"random\"}, \"norm1_bias\": {\"type\": \"random\"}, \"conv2_weight\": {\"type\": \"random\"}, \"norm2_weight\": {\"type\": \"random\"}, \"norm2_bias\": {\"type\": \"random\"}, \"eps\": {\"type\": \"scalar\", \"value\": 1e-06}}, \"tolerance\": {\"max_atol\": 1.3876519720485223e-07, \"max_rtol\": 1.1920928955078125e-07, \"required_matched_ratio\": 0.99, \"_provenance\": \"max run-to-run error over 10 seeds x 1.25 margin, floored at torch.float32 epsilon\"}}\n{\"uuid\": \"a4c930bb-4694-570b-8d51-97ba053f74ac\", \"axes\": {\"batch_size\": 1, \"height\": 128, \"width\": 128}, \"inputs\": {\"x\": {\"type\": \"random\"}, \"conv1_weight\": {\"type\": \"random\"}, \"norm1_weight\": {\"type\": \"random\"}, \"norm1_bias\": {\"type\": \"random\"}, \"conv2_weight\": {\"type\": \"random\"}, \"norm2_weight\": {\"type\": \"random\"}, \"norm2_bias\": {\"type\": \"random\"}, \"eps\": {\"type\": \"scalar\", \"value\": 1e-06}}, \"tolerance\": {\"max_atol\": 1.3865039332374384e-07, \"max_rtol\": 1.1920928955078125e-07, \"required_matched_ratio\": 0.99, \"_provenance\": \"max run-to-run error over 10 seeds x 1.25 margin, floored at torch.float32 epsilon\"}}\n{\"uuid\": \"f1b799bf-831f-5434-98be-68e897f6a219\", \"axes\": {\"batch_size\": 1, \"height\": 131, \"wid