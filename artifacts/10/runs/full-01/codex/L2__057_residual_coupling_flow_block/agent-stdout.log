{"type":"item.started","item":{"id":"item_10","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch\nimport torch.nn.functional as F\nimport reference\n\ndef grouped(x, x_mask, reverse, *p):\n    ts=[p[i:i+6] for i in range(0,24,6)]\n    w0=torch.cat([z[0] for z in ts],0); b0=torch.cat([z[1] for z in ts],0)\n    w1=torch.cat([z[2] for z in ts],0); b1=torch.cat([z[3] for z in ts],0)\n    w2=torch.cat([z[4] for z in ts],0); b2=torch.cat([z[5] for z in ts],0)\n    x0=x[:,:96]; xm=x0*x_mask; xi=torch.cat((x0,xm,xm,xm),1)\n    h=F.relu(F.conv1d(xi,w0,b0,padding=2,groups=4))\n    h=F.relu(F.conv1d(h,w1,b1,padding=2,groups=4))\n    h=F.conv1d(h,w2,b2,padding=2,groups=4).view(x.shape[0],4,96,x.shape[2])\n    x1=x[:,96:]\n    if reverse:\n      for i in range(3,-1,-1): x1=x1-h[:,i]\n    else:\n      for i in range(4): x1=x1+h[:,i]\n    return torch.cat((x0,x1),1)*x_mask\ncompiled=torch.compile(grouped,fullgraph=True)\ndef bench(fn,args,n=20):\n    for _ in range(4): fn(*args)\n    torch.cuda.synchronize(); s=torch.cuda.Event(True); e=torch.cuda.Event(True); s.record()\n    for _ in range(n): fn(*args)\n    e.record(); e.synchronize(); return s.elapsed_time(e)/n\nfor B,T,rev in [(1,128,False),(4,541,False),(16,2447,False),(16,2048,True)]:\n d=reference.get_inputs({'batch_size':B,'time':T},torch.device('cuda'));d['reverse']=rev;a=list(d.values())\n z=compiled(*a); y=reference.run(*a); print((B,T), (y-z).abs().max().item(), bench(grouped,a),bench(compiled,a))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
