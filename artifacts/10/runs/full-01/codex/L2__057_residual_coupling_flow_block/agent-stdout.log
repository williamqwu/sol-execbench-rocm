{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"jq . definition.json && printf '\\\\n--- all workloads (shape, direction, tolerance) ---\\\\n' && jq -r '[.axes.batch_size,.axes.time,.inputs.reverse.value,.tolerance.max_atol,.tolerance.max_rtol,.tolerance.required_matched_ratio] | @tsv' workload.jsonl && printf '\\\\n--- local files ---\\\\n' && rg --files -g '*'\"","aggregated_output":"{\n  \"name\": \"057_residual_coupling_flow_block\",\n  \"description\": \"Residual coupling block for normalizing flow with affine coupling transformations. Splits channels in half, transforms one half conditioned on the other, and combines. Supports forward and reverse passes for flow-based generative modeling.\",\n  \"hf_id\": \"myshell-ai/OpenVoice\",\n  \"custom_inputs_entrypoint\": \"get_inputs\",\n  \"axes\": {\n    \"batch_size\": {\n      \"type\": \"var\",\n      \"description\": \"Batch size\"\n    },\n    \"time\": {\n      \"type\": \"var\",\n      \"description\": \"Sequence/time dimension\"\n    },\n    \"channels\": {\n      \"type\": \"const\",\n      \"value\": 192,\n      \"description\": \"Total number of channels (must be even)\"\n    },\n    \"hidden_channels\": {\n      \"type\": \"const\",\n      \"value\": 192,\n      \"description\": \"Hidden channels in transformation network\"\n    },\n    \"half_channels\": {\n      \"type\": \"const\",\n      \"value\": 96,\n      \"description\": \"Half of total channels for splitting\"\n    },\n    \"kernel_size\": {\n      \"type\": \"const\",\n      \"value\": 5,\n      \"description\": \"Convolution kernel size\"\n    },\n    \"n_layers\": {\n      \"type\": \"const\",\n      \"value\": 4,\n      \"description\": \"Number of coupling layers\"\n    }\n  },\n  \"inputs\": {\n    \"x\": {\n      \"shape\": [\n        \"batch_size\",\n        \"channels\",\n        \"time\"\n      ],\n      \"dtype\": \"float32\",\n      \"description\": \"Input tensor\"\n    },\n    \"x_mask\": {\n      \"shape\": [\n        \"batch_size\",\n        \"1\",\n        \"time\"\n      ],\n      \"dtype\": \"float32\",\n      \"description\": \"Optional mask tensor\"\n    },\n    \"reverse\": {\n      \"shape\": null,\n      \"dtype\": \"bool\",\n      \"description\": \"If True, perform reverse transformation\"\n    },\n    \"transform_0_conv0_weight\": {\n      \"shape\": [\n        \"hidden_channels\",\n        \"half_channels\",\n        \"kernel_size\"\n      ],\n      \"dtype\": \"float32\",\n      \"description\": \"Layer 0 first conv weight\"\n    },\n    \"transform_0_conv0_bias\": {\n      \"shape\": [\n        \"hidden_channels\"\n      ],\n      \"dtype\": \"float32\",\n      \"description\": \"Layer 0 first conv bias\"\n    },\n    \"transform_0_conv1_weight\": {\n      \"shape\": [\n        \"hidden_channels\",\n        \"hidden_channels\",\n        \"kernel_size\"\n      ],\n      \"dtype\": \"float32\",\n      \"description\": \"Layer 0 second conv weight\"\n    },\n    \"transform_0_conv1_bias\": {\n      \"shape\": [\n        \"hidden_channels\"\n      ],\n      \"dtype\": \"float32\",\n      \"description\": \"Layer 0 second conv bias\"\n    },\n    \"transform_0_conv2_weight\": {\n      \"shape\": [\n        \"half_channels\",\n        \"hidden_channels\",\n        \"kernel_size\"\n      ],\n      \"dtype\": \"float32\",\n      \"description\": \"Layer 0 third conv weight\"\n    },\n    \"transform_0_conv2_bias\": {\n      \"shape\": [\n        \"half_channels\"\n      ],\n      \"dtype\": \"float32\",\n      \"description\": \"Layer 0 third conv bias\"\n    },\n    \"transform_1_conv0_weight\": {\n      \"shape\": [\n        \"hidden_channels\",\n        \"half_channels\",\n        \"kernel_size\"\n      ],\n      \"dtype\": \"float32\",\n      \"description\": \"Layer 1 first conv weight\"\n    },\n    \"transform_1_conv0_bias\": {\n      \"shape\": [\n        \"hidden_channels\"\n      ],\n      \"dtype\": \"float32\",\n      \"description\": \"Layer 1 first conv bias\"\n    },\n    \"transform_1_conv1_weight\": {\n      \"shape\": [\n        \"hidden_channels\",\n        \"hidden_channels\",\n        \"kernel_size\"\n      ],\n      \"dtype\": \"float32\",\n      \"description\": \"Layer 1 second conv weight\"\n    },\n    \"transform_1_conv1_bias\": {\n      \"shape\": [\n        \"hidden_channels\"\n      ],\n      \"dtype\": \"float32\",\n      \"description\": \"Layer 1 second conv bias\"\n    },\n    \"transform_1_conv2_weight\": {\n      \"shape\": [\n        \"half_channels\",\n        \"hidden_channels\",\n        \"kernel_size\"\n      ],\n      \"dtype\": \"float32\",\n      \"description\": \"Layer 1 third conv weight\"\n    },\n    \"transform_1_conv2_bias\": {\n      \"shape\": [\n        \"half_channels\"\n      ],\n      \"dtype\": \"float32\",\n      \"description\": \"Layer 1 third conv bias\"\n    },\n    \"transform_2_conv0_weight\": {\n      \"shape\": [\n        \"hidden_channels\",\n        \"half_channels\",\n        \"kernel_size\"\n      ],\n      \"dtype\": \"float32\",\n      \"description\": \"Layer 2 first conv weight\"\n    },\n    \"transform_2_conv0_bias\": {\n      \"shape\": [\n        \"hidden_channels\"\n      ],\n      \"dtype\": \"float32\",\n      \"description\": \"Layer 2 first conv bias\"\n    },\n    \"transform_2_conv1_weight\": {\n      \"shape\": [\n        \"hidden_channels\",\n        \"hidden_channels\",\n        \"kernel_size\"\n      ],\n      \"dtype\": \"float32\",\n      \"description\": \"Layer 2 second conv weight\"\n    },\n    \"transform_2_conv1_bias\": {\n      \"shape\": [\n        \"hidden_channels\"\n      ],\n      \"dtype\": \"float32\",\n      \"description\": \"Layer 2 second conv bias\"\n    },\n    \"transform_2_conv2_weight\": {\n      \"shape\": [\n        \"half_channels\",\n        \"hidden_channels\",\n        \"kernel_size\"\n      ],\n      \"dtype\": \"float32\",\n      \"description\": \"Layer 2 third conv weight\"\n    },\n    \"transform_2_conv2_bias\": {\n      \"shape\": [\n        \"half_channels\"\n      ],\n      \"dtype\": \"float32\",\n      \"description\": \"Layer 2 third conv bias\"\n    },\n    \"transform_3_conv0_weight\": {\n      \"shape\": [\n        \"hidden_channels\",\n        \"half_channels\",\n        \"kernel_size\"\n      ],\n      \"dtype\": \"float32\",\n      \"description\": \"Layer 3 first conv weight\"\n    },\n    \"transform_3_conv0_bias\": {\n      \"shape\": [\n        \"hidden_channels\"\n      ],\n      \"dtype\": \"float32\",\n      \"description\": \"Layer 3 first conv bias\"\n    },\n    \"transform_3_conv1_weight\": {\n      \"shape\": [\n        \"hidden_channels\",\n        \"hidden_channels\",\n        \"kernel_size\"\n      ],\n      \"dtype\": \"float32\",\n      \"description\": \"Layer 3 second conv weight\"\n    },\n    \"transform_3_conv1_bias\": {\n      \"shape\": [\n        \"hidden_channels\"\n      ],\n      \"dtype\": \"float32\",\n      \"description\": \"Layer 3 second conv bias\"\n    },\n    \"transform_3_conv2_weight\": {\n      \"shape\": [\n        \"half_channels\",\n        \"hidden_channels\",\n        \"kernel_size\"\n      ],\n      \"dtype\": \"float32\",\n      \"description\": \"Layer 3 third conv weight\"\n    },\n    \"transform_3_conv2_bias\": {\n      \"shape\": [\n        \"half_channels\"\n      ],\n      \"dtype\": \"float32\",\n      \"description\": \"Layer 3 third conv bias\"\n    }\n  },\n  \"outputs\": {\n    \"output\": {\n      \"shape\": [\n        \"batch_size\",\n        \"channels\",\n        \"time\"\n      ],\n      \"dtype\": \"float32\",\n      \"description\": \"Transformed output tensor\"\n    }\n  },\n  \"reference\": \"import math\\n\\nimport torch\\nimport torch.nn.functional as F\\n\\n\\ndef get_inputs(axes_and_scalars: dict, device: torch.device) -> dict[str, torch.Tensor]:\\n    batch_size = axes_and_scalars[\\\"batch_size\\\"]\\n    time = axes_and_scalars[\\\"time\\\"]\\n    channels = 192\\n    hidden_channels = 192\\n    half_channels = 96\\n    kernel_size = 5\\n\\n    g = torch.Generator(device=device)\\n    g.manual_seed(42)\\n\\n    def kaiming_conv1d(out_c, in_c, k):\\n        fan_in = in_c * k\\n        return torch.randn(out_c, in_c, k, device=device, generator=g) * math.sqrt(2.0 / fan_in)\\n\\n    inputs = {\\n        \\\"x\\\": torch.randn(batch_size, channels, time, device=device, generator=g),\\n        # Binary mask\\n        \\\"x_mask\\\": torch.ones(batch_size, 1, time, device=device),\\n        \\\"reverse\\\": False,\\n    }\\n\\n    # 4 transforms x 3 convs each\\n    for i in range(4):\\n        # conv0: hidden_channels out, half_channels in\\n        inputs[f\\\"transform_{i}_conv0_weight\\\"] = kaiming_conv1d(hidden_channels, half_channels, kernel_size)\\n        inputs[f\\\"transform_{i}_conv0_bias\\\"] = torch.randn(hidden_channels, device=device, generator=g)\\n        # conv1: hidden_channels out, hidden_channels in\\n        inputs[f\\\"transform_{i}_conv1_weight\\\"] = kaiming_conv1d(hidden_channels, hidden_channels, kernel_size)\\n        inputs[f\\\"transform_{i}_conv1_bias\\\"] = torch.randn(hidden_channels, device=device, generator=g)\\n        # conv2: half_channels out, hidden_channels in\\n        inputs[f\\\"transform_{i}_conv2_weight\\\"] = kaiming_conv1d(half_channels, hidden_channels, kernel_size)\\n        inputs[f\\\"transform_{i}_conv2_bias\\\"] = torch.randn(half_channels, device=device, generator=g)\\n\\n    return inputs\\n\\n\\ndef apply_transform(x0, conv0_w, conv0_b, conv1_w, conv1_b, conv2_w, conv2_b):\\n    \\\"\\\"\\\"Apply a single transform: Conv1d -> ReLU -> Conv1d -> ReLU -> Conv1d\\\"\\\"\\\"\\n    # Conv1d with padding\\n    padding = conv0_w.shape[2] // 2\\n    h = F.conv1d(x0, conv0_w, conv0_b, padding=padding)\\n    h = F.relu(h)\\n    h = F.conv1d(h, conv1_w, conv1_b, padding=padding)\\n    h = F.relu(h)\\n    h = F.conv1d(h, conv2_w, conv2_b, padding=padding)\\n    return h\\n\\n\\n@torch.no_grad()\\ndef run(\\n    x: torch.Tensor,\\n    x_mask: torch.Tensor,\\n    reverse: bool,\\n    transform_0_conv0_weight: torch.Tensor,\\n    transform_0_conv0_bias: torch.Tensor,\\n    transform_0_conv1_weight: torch.Tensor,\\n    transform_0_conv1_bias: torch.Tensor,\\n    transform_0_conv2_weight: torch.Tensor,\\n    transform_0_conv2_bias: torch.Tensor,\\n    transform_1_conv0_weight: torch.Tensor,\\n    transform_1_conv0_bias: torch.Tensor,\\n    transform_1_conv1_weight: torch.Tensor,\\n    transform_1_conv1_bias: torch.Tensor,\\n    transform_1_conv2_weight: torch.Tensor,\\n    transform_1_conv2_bias: torch.Tensor,\\n    transform_2_conv0_weight: torch.Tensor,\\n    transform_2_conv0_bias: torch.Tensor,\\n    transform_2_conv1_weight: torch.Tensor,\\n    transform_2_conv1_bias: torch.Tensor,\\n    transform_2_conv2_weight: torch.Tensor,\\n    transform_2_conv2_bias: torch.Tensor,\\n    transform_3_conv0_weight: torch.Tensor,\\n    transform_3_conv0_bias: torch.Tensor,\\n    transform_3_conv1_weight: torch.Tensor,\\n    transform_3_conv1_bias: torch.Tensor,\\n    transform_3_conv2_weight: torch.Tensor,\\n    transform_3_conv2_bias: torch.Tensor,\\n):\\n    \\\"\\\"\\\"\\n    Residual coupling flow block.\\n    \\n    Forward: x1 = x1 + transform(x0) for each layer\\n    Reverse: x1 = x1 - transform(x0) for each layer (in reverse order)\\n    \\\"\\\"\\\"\\n    half_channels = x.shape[1] // 2\\n    \\n    # Collect all transform weights\\n    transforms = [\\n        (transform_0_conv0_weight, transform_0_conv0_bias,\\n         transform_0_conv1_weight, transform_0_conv1_bias,\\n         transform_0_conv2_weight, transform_0_conv2_bias),\\n        (transform_1_conv0_weight, transform_1_conv0_bias,\\n         transform_1_conv1_weight, transform_1_conv1_bias,\\n         transform_1_conv2_weight, transform_1_conv2_bias),\\n        (transform_2_conv0_weight, transform_2_conv0_bias,\\n         transform_2_conv1_weight, transform_2_conv1_bias,\\n         transform_2_conv2_weight, transform_2_conv2_bias),\\n        (transform_3_conv0_weight, transform_3_conv0_bias,\\n         transform_3_conv1_weight, transform_3_conv1_bias,\\n         transform_3_conv2_weight, transform_3_conv2_bias),\\n    ]\\n    \\n    if not reverse:\\n        # Forward pass: apply transformations sequentially\\n        for conv0_w, conv0_b, conv1_w, conv1_b, conv2_w, conv2_b in transforms:\\n            # Split into two halves\\n            x0 = x[:, :half_channels, :]\\n            x1 = x[:, half_channels:, :]\\n            \\n            # Compute transformation conditioned on x0\\n            h = apply_transform(x0, conv0_w, conv0_b, conv1_w, conv1_b, conv2_w, conv2_b)\\n            \\n            # Apply mask\\n            h = h * x_mask\\n            \\n            # Affine coupling: x1 = x1 + h\\n            x1 = x1 + h\\n            \\n            # Concatenate back\\n            x = torch.cat([x0, x1], dim=1)\\n            \\n            # Apply mask to output\\n            x = x * x_mask\\n    else:\\n        # Reverse pass: apply transformations in reverse order\\n        for conv0_w, conv0_b, conv1_w, conv1_b, conv2_w, conv2_b in reversed(transforms):\\n            # Split into two halves\\n            x0 = x[:, :half_channels, :]\\n            x1 = x[:, half_channels:, :]\\n            \\n            # Compute transformation conditioned on x0\\n            h = apply_transform(x0, conv0_w, conv0_b, conv1_w, conv1_b, conv2_w, conv2_b)\\n            \\n            # Apply mask\\n            h = h * x_mask\\n            \\n            # Inverse affine coupling: x1 = x1 - h\\n            x1 = x1 - h\\n            \\n            # Concatenate back\\n            x = torch.cat([x0, x1], dim=1)\\n            \\n            # Apply mask to output\\n            x = x * x_mask\\n    \\n    return x\\n\"\n}\n\n--- all workloads (shape, direction, tolerance) ---\n2\t293\ttrue\t9.547810127483251e-05\t1.1920928955078125e-07\t0.99\n8\t768