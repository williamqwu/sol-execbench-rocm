{"type":"item.started","item":{"id":"item_7","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch\nimport torch.nn.functional as F\nimport reference\n\ndef fused(x, x_mask, reverse, *p):\n    ts=[p[i:i+6] for i in range(0,24,6)]\n    w0=torch.cat([z[0] for z in ts],0); b0=torch.cat([z[1] for z in ts],0)\n    w1=torch.cat([z[2] for z in ts],0); b1=torch.cat([z[3] for z in ts],0)\n    w2=torch.cat([z[4] for z in ts],0); b2=torch.cat([z[5] for z in ts],0)\n    x0=x[:,:96]\n    h=F.relu(F.conv1d(x0,w0,b0,padding=2))\n    h=F.relu(F.conv1d(h,w1,b1,padding=2,groups=4))\n    h=F.conv1d(h,w2,b2,padding=2,groups=4).view(x.shape[0],4,96,x.shape[2])\n    x1=x[:,96:]\n    order=range(3,-1,-1) if reverse else range(4)\n    for i in order:\n        x1 = x1 - h[:,i]*x_mask if reverse else x1 + h[:,i]*x_mask\n    return torch.cat((x0,x1),1)*x_mask\n\ndef vals(d):\n    return [d[k] for k in list(d)[3:]]\n\ndef bench(fn,args,n=10):\n    for _ in range(3): fn(*args)\n    torch.cuda.synchronize()\n    s=torch.cuda.Event(True); e=torch.cuda.Event(True)\n    s.record()\n    for _ in range(n): fn(*args)\n    e.record(); e.synchronize()\n    return s.elapsed_time(e)/n\nfor B,T,rev in [(1,128,False),(4,541,False),(16,2447,False),(16,2048,True),(64,3637,False)]:\n    d=reference.get_inputs({'batch_size':B,'time':T},torch.device('cuda'))\n    d['reverse']=rev\n    args=list(d.values())\n    y=reference.run(*args)\n    z=fused(*args)\n    err=(y-z).abs()\n    print((B,T,rev),'max',err.max().item(),'p99',torch.quantile(err.float(),.99).item(), 'nz', (err>9e-5).float().mean().item())\n    print(' times ref/fused',bench(reference.run,args,5),bench(fused,args,5))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
