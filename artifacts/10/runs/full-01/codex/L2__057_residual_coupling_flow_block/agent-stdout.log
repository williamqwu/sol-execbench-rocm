{"type":"item.started","item":{"id":"item_12","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch\nimport torch.nn.functional as F\nimport reference\n\ndef cols3(x):\n T=x.shape[-1]; xp=F.pad(x,(2,2)); return torch.stack([xp[...,k:k+T] for k in range(5)],-2).flatten(-3,-2)\ndef conv_shared(x,w,b): return torch.matmul(w.flatten(1),cols3(x))+b[None,:,None]\ndef conv_group(x,w,b):\n # x B,G,C,T, w G,O,C,5, b G,O\n B,G,C,T=x.shape\n xp=F.pad(x,(2,2))\n col=torch.stack([xp[...,k:k+T] for k in range(5)],-2).flatten(-3,-2).permute(1,0,2,3)\n y=torch.matmul(w.flatten(2)[:,None],col).permute(1,0,2,3)\n return y+b[None,:,:,None]\ndef gemm(x,x_mask,reverse,*p):\n ts=[p[i:i+6] for i in range(0,24,6)]\n w0=torch.stack([z[0] for z in ts]);b0=torch.stack([z[1] for z in ts])\n w1=torch.stack([z[2] for z in ts]);b1=torch.stack([z[3] for z in ts])\n w2=torch.stack([z[4] for z in ts]);b2=torch.stack([z[5] for z in ts])\n x0=x[:,:96]\n h=F.relu(conv_shared(x0,w0.flatten(0,1),b0.flatten())).view(x.shape[0],4,192,x.shape[2])\n h=F.relu(conv_group(h,w1,b1))\n h=conv_group(h,w2,b2)\n x1=x[:,96:]\n if reverse:\n  for i in range(3,-1,-1):x1=x1-h[:,i]*x_mask\n else:\n  for i in range(4):x1=x1+h[:,i]*x_mask\n return torch.cat((x0,x1),1)*x_mask\n\ndef bench(fn,a,n=10):\n for _ in range(3):fn(*a)\n torch.cuda.synchronize();s=torch.cuda.Event(True);e=torch.cuda.Event(True);s.record()\n for _ in range(n):fn(*a)\n e.record();e.synchronize();return s.elapsed_time(e)/n\nfor B,T,rev,n in [(1,128,False,20),(4,541,False,20),(16,2447,False,10),(16,2048,True,10),(64,3637,False,3),(64,8192,True,2)]:\n d=reference.get_inputs({'batch_size':B,'time':T},torch.device('cuda'));d['reverse']=rev;a=list(d.values());y=reference.run(*a);z=gemm(*a);err=(y-z).abs();\n print((B,T),err.max().item(),(err>9e-5).float().mean().item(),bench(reference.run,a,n),bench(gemm,a,n))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
