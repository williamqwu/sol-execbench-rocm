{"type":"item.started","item":{"id":"item_41","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport time,torch\nimport kernel\n@torch.compile(fullgraph=True,dynamic=True)\ndef tables(q,theta):\n S=q.shape[2]\n inv=1.0/(theta**(torch.arange(0,128,2,dtype=torch.float32,device=q.device)/128))\n f=torch.outer(torch.arange(S,device=q.device).float(),inv);e=torch.cat((f,f),-1)\n return e.cos().to(q.dtype).view(1,1,S,128),e.sin().to(q.dtype).view(1,1,S,128)\n@torch.compile(fullgraph=True,dynamic=True)\ndef rotate(q,k,c,s):\n qr=torch.cat((-q[...,64:],q[...,:64]),-1);kr=torch.cat((-k[...,64:],k[...,:64]),-1)\n return q*c+qr*s,k*c+kr*s\n\ndef split(q,k,t):\n c,s=tables(q,t);return rotate(q,k,c,s)\nfor B,S in [(1,131),(1,256),(8,512),(4,2213),(1,3072)]:\n q=torch.randn(B,16,S,128,device='cuda',dtype=torch.bfloat16);k=torch.randn(B,4,S,128,device='cuda',dtype=torch.bfloat16)\n a,b=kernel._apply_rope(q,k,B,S,10000.);c,d=split(q,k,10000.);torch.cuda.synchronize()\n print(B,S,'diff',(a.float()-c.float()).abs().max().item(),(b.float()-d.float()).abs().max().item())\n vals=[]\n for n,fn in [('current',lambda:kernel._apply_rope(q,k,B,S,10000.)),('split',lambda:split(q,k,10000.))]:\n  for _ in range(10):fn()\n  torch.cuda.synchronize();ts=[]\n  for rep in range(5):\n   t=time.perf_counter()\n   for _ in range(50):fn()\n   torch.cuda.synchronize();ts.append((time.perf_counter()-t)*1e3/50)\n  vals.append((n,min(ts)))\n print(vals)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
