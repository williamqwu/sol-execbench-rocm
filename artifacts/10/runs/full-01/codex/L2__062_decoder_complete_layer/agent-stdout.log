{"type":"item.started","item":{"id":"item_12","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport time, torch\nimport torch.nn.functional as F\nD='cuda'; dt=torch.bfloat16\ntorch.manual_seed(1)\nwg=torch.randn(8192,2048,device=D,dtype=dt)\nwu=torch.randn_like(wg)\nfor M in [128,512,2048,8192]:\n x=torch.randn(M,2048,device=D,dtype=dt)\n def sep(): return F.silu(F.linear(x,wg))*F.linear(x,wu)\n def comb():\n  gu=F.linear(x,torch.cat((wg,wu),dim=0))\n  return F.silu(gu[:,:8192])*gu[:,8192:]\n print('M',M)\n for name,fn in [('sep',sep),('cat',comb)]:\n  for _ in range(4): fn()\n  torch.cuda.synchronize(); t=time.perf_counter()\n  for _ in range(10): fn()\n  torch.cuda.synchronize(); print(name,(time.perf_counter()-t)*1e3/10)\n del x\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
