{"type":"item.started","item":{"id":"item_55","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport time,torch\nimport torch.nn.functional as F\nprint('prefer_ck env default')\nfor B,S,E in [(1,256,512),(4,2213,2560),(16,512,1024),(1,3072,3072)]:\n q=torch.randn(B,16,S,128,device='cuda',dtype=torch.bfloat16);ks=torch.randn(B,4,S,128,device='cuda',dtype=torch.bfloat16);vs=torch.randn_like(ks);kc=torch.randn(B,16,E,128,device='cuda',dtype=torch.bfloat16);vc=torch.randn_like(kc)\n fs=lambda:F.scaled_dot_product_attention(q,ks,vs,is_causal=True,enable_gqa=True)\n fc=lambda:F.scaled_dot_product_attention(q,kc,vc,is_causal=False)\n vals=[]\n for n,f in [('self',fs),('cross',fc)]:\n  for _ in range(10):f()\n  torch.cuda.synchronize();ts=[]\n  for z in range(5):\n   t=time.perf_counter()\n   for _ in range(50):f()\n   torch.cuda.synchronize();ts.append((time.perf_counter()-t)*1e3/50)\n  vals.append((n,min(ts)))\n print(B,S,E,vals)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
