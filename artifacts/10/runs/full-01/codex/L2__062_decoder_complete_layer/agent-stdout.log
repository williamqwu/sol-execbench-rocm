{"type":"item.started","item":{"id":"item_39","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport time,torch,aiter\nimport torch.nn.functional as F\nimport kernel\n@torch.compile(fullgraph=True,dynamic=True)\ndef comb(x):\n g,u=x.chunk(2,-1);return F.silu(g)*u\nfor M in [131,256,512]:\n x=torch.randn(M,16384,device='cuda',dtype=torch.bfloat16);g,u=x.chunk(2,-1);o=torch.empty(M,8192,device='cuda',dtype=torch.bfloat16)\n comb(x);kernel._silu_mul(g,u);aiter.silu_and_mul(o,x);torch.cuda.synchronize()\n vals=[]\n for name,fn in [('eager',lambda:F.silu(g)*u),('current',lambda:kernel._silu_mul(g,u)),('comb',lambda:comb(x)),('aiter',lambda:aiter.silu_and_mul(o,x))]:\n  for _ in range(10):fn()\n  torch.cuda.synchronize();ts=[]\n  for rep in range(5):\n   t=time.perf_counter()\n   for _ in range(100):fn()\n   torch.cuda.synchronize();ts.append((time.perf_counter()-t)*1e3/100)\n  vals.append((name,min(ts)))\n print(M,vals)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
