{"type":"item.started","item":{"id":"item_8","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport math, time, torch\nimport torch.nn.functional as F\nimport aiter\nD='cuda'\ntorch.manual_seed(1)\n# RMSNorm semantics\nx=torch.randn(512,2048,device=D,dtype=torch.bfloat16)\nw=torch.randn(2048,device=D,dtype=torch.bfloat16)\neps=1e-5\nref=(w*(x.float()*torch.rsqrt(x.float().square().mean(-1,keepdim=True)+eps))).to(x.dtype)\nfor name, fn in [\n ('torch_rms',lambda:F.rms_norm(x,(2048,),w,eps)),\n ('aiter_rms',lambda:aiter.rms_norm(x,w,eps)),\n ('aiter_rmsnorm2d',lambda:aiter.rmsnorm2d_fwd(x,w,eps))]:\n try:\n  y=fn(); torch.cuda.synchronize()\n  d=(y.float()-ref.float()).abs()\n  print(name, y.shape, d.max().item(), (d\"'!=0).float().mean().item())\n except Exception as e: print(name,'\"'ERR',repr(e))\n# Attention semantics, including GQA\nB,H,Hkv,S,Dh=2,16,4,128,128\nq=torch.randn(B,H,S,Dh,device=D,dtype=torch.bfloat16)\nk=torch.randn(B,Hkv,S,Dh,device=D,dtype=torch.bfloat16)\nv=torch.randn(B,Hkv,S,Dh,device=D,dtype=torch.bfloat16)\nkr=k[:,:,None].expand(B,Hkv,H//Hkv,S,Dh).reshape(B,H,S,Dh)\nvr=v[:,:,None].expand(B,Hkv,H//Hkv,S,Dh).reshape(B,H,S,Dh)\ns=torch.matmul(q,kr.transpose(2,3))/math.sqrt(Dh)\nmask=torch.triu(torch.full((S,S),-float('inf'),device=D),diagonal=1)\np=F.softmax(s+mask[None,None],-1,dtype=torch.float32).to(q.dtype)\nrefa=torch.matmul(p,vr)\nfor name,fn in [\n ('torch_sdpa',lambda:F.scaled_dot_product_attention(q,k,v,is_causal=True,enable_gqa=True)),\n ('aiter_flash',lambda:aiter.flash_attn_func(q.transpose(1,2),k.transpose(1,2),v.transpose(1,2),causal=True,deterministic=True).transpose(1,2))]:\n try:\n  y=fn(); torch.cuda.synchronize()\n  d=(y.float()-refa.float()).abs(); tol=0.009+0.0078125*refa.float().abs()\n  print(name,y.shape,'max',d.max().item(),'mean',d.mean().item(),'match',(d<=tol).float().mean().item())\n  for _ in range(5): fn()\n  torch.cuda.synchronize(); t=time.perf_counter()\n  for _ in range(20): fn()\n  torch.