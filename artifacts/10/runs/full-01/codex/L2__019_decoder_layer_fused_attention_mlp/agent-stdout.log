{"type":"item.started","item":{"id":"item_49","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch,kernel\nfor S in (128,131,256,373,512,1024,1571,2048,4096,8192):\n b=torch.rand((1,S,S),device='cuda');m=torch.ones((S,S),dtype=torch.bool,device='cuda').triu_(1)\n a=b.clone();a.mul_(128**-0.5);a.masked_fill_(m,float('-inf'))\n c=b.clone();kernel._scale_and_mask(c,S);torch.cuda.synchronize()\n finite=torch.isfinite(a);d=(a[finite]-c[finite]).abs()\n print(S,'equal',torch.equal(a,c),'max',d.max().item())\n del a,b,c,m,d,finite;torch.cuda.empty_cache()\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
