{"type":"item.started","item":{"id":"item_50","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch,kernel\nfor B,S in ((64,128),(32,256),(8,512),(1,1024),(1,2048),(1,4096),(1,8192)):\n bh=B*28;x=torch.rand((bh,S,S),device='cuda');y=x.clone();m=torch.ones((S,S),dtype=torch.bool,device='cuda').triu_(1)\n def ref():x.mul_(128**-0.5);x.masked_fill_(m,float('-inf'))\n def tri():kernel._scale_and_mask(y,S)\n n=30 if S<=512 else 10 if S<=1024 else 5 if S<=2048 else 2 if S<=4096 else 1\n vals=[]\n for fn in (ref,tri):\n  for _ in range(3):fn()\n  torch.cuda.synchronize();st=torch.cuda.Event(True);en=torch.cuda.Event(True);st.record()\n  for _ in range(n):fn()\n  en.record();en.synchronize();vals.append(st.elapsed_time(en)/n)\n print(B,S,'ref',round(vals[0],4),'tri',round(vals[1],4),'x',round(vals[0]/vals[1],3))\n del x,y,m;torch.cuda.empty_cache()\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
