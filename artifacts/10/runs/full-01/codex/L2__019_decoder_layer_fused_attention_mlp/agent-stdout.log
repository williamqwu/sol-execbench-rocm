{"type":"item.started","item":{"id":"item_17","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch, torch.nn.functional as F\ntorch.manual_seed(4); dev='cuda'; D=3584; Q=3584; K=512; I=18944\nfor M in (128,512,2048):\n x=torch.rand((M,D),device=dev); qw=torch.rand((Q,D),device=dev); kw=torch.rand((K,D),device=dev); vw=torch.rand((K,D),device=dev); qb=torch.rand(Q,device=dev); kb=torch.rand(K,device=dev); vb=torch.rand(K,device=dev)\n def sepq(): return F.linear(x,qw,qb),F.linear(x,kw,kb),F.linear(x,vw,vb)\n def catq():\n  z=F.linear(x,torch.cat((qw,kw,vw),0),torch.cat((qb,kb,vb),0)); return z[:,:Q],z[:,Q:Q+K],z[:,Q+K:]\n a=sepq(); b=catq(); print('q exact',M,[torch.equal(i,j) for i,j in zip(a,b)])\n for fn in (sepq,catq):\n  for _ in range(3):fn()\n  torch.cuda.synchronize(); s=torch.cuda.Event(True);e=torch.cuda.Event(True);s.record()\n  for _ in range(20):fn()\n  e.record();e.synchronize();print(M,fn.__name__,s.elapsed_time(e)/20)\n del qw,kw,vw,qb,kb,vb,a,b\n gw=torch.rand((I,D),device=dev); uw=torch.rand((I,D),device=dev)\n def sepm(): return F.linear(x,gw),F.linear(x,uw)\n def catm():\n  z=F.linear(x,torch.cat((gw,uw),0));return z[:,:I],z[:,I:]\n a=sepm();b=catm();print('m exact',M,[torch.equal(i,j) for i,j in zip(a,b)])\n for fn in (sepm,catm):\n  for _ in range(3):fn()\n  torch.cuda.synchronize();s=torch.cuda.Event(True);e=torch.cuda.Event(True);s.record()\n  for _ in range(10):fn()\n  e.record();e.synchronize();print(M,fn.__name__,s.elapsed_time(e)/10)\n del x,gw,uw,a,b\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
