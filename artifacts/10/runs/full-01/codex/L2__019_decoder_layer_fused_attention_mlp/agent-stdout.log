{"type":"item.started","item":{"id":"item_51","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch,triton\nfrom kernel import _scale_causal_kernel\n\ndef call(x,S,target,nw):\n bc=min(triton.next_power_of_2(S),256);br=target//bc\n grid=(triton.cdiv(S,br),triton.cdiv(S,bc),x.numel()//(S*S))\n _scale_causal_kernel[grid](x,seq_len=S,block_rows=br,block_cols=bc,num_warps=nw)\nfor S in (4096,8192):\n x=torch.rand((4,S,S),device='cuda')\n print('S',S)\n for target in (2048,4096,8192,16384):\n  for nw in (4,8,16):\n   try:\n    for _ in range(2):call(x,S,target,nw)\n    torch.cuda.synchronize();st=torch.cuda.Event(True);en=torch.cuda.Event(True);st.record()\n    for _ in range(5):call(x,S,target,nw)\n    en.record();en.synchronize();print(target,nw,round(st.elapsed_time(en)/5,4))\n   except Exception as e:print(target,nw,'ERR',str(e).splitlines()[0])\n del x;torch.cuda.empty_cache()\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
