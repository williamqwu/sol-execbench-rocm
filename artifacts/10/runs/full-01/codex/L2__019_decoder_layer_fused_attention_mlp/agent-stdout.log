{"type":"item.started","item":{"id":"item_25","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch, torch.nn.functional as F\nfrom torch.nn.attention import sdpa_kernel, SDPBackend\nfor S in (128,256,512,1024,2048,4096):\n q=torch.rand((1,28,S,128),device='cuda'); k=torch.rand_like(q);v=torch.rand_like(q);m=torch.ones((S,S),dtype=torch.bool,device='cuda').triu_(1)\n def manual():\n  a=torch.matmul(q,k.transpose(2,3))*(128**-0.5);a.masked_fill_(m,float('-inf'));a=F.softmax(a,dim=-1,dtype=torch.float32);return torch.matmul(a,v)\n def math():\n  with sdpa_kernel([SDPBackend.MATH]): return F.scaled_dot_product_attention(q,k,v,is_causal=True,scale=128**-0.5)\n def default(): return F.scaled_dot_product_attention(q,k,v,is_causal=True,scale=128**-0.5)\n a=manual()\n n=20 if S<=512 else 8 if S<=1024 else 3 if S<=2048 else 1\n for fn in (manual,math,default):\n  b=fn();d=(a-b).abs();rel=d/(a.abs()+1e-30);match=((d<=1.9e-7)|(rel<=1.1920928955078125e-7)).float().mean().item()\n  for _ in range(2):fn()\n  torch.cuda.synchronize();st=torch.cuda.Event(True);en=torch.cuda.Event(True);st.record()\n  for _ in range(n):fn()\n  en.record();en.synchronize();print(S,fn.__name__,st.elapsed_time(en)/n,'match',match,'max',d.max().item())\n del q,k,v,m,a\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
