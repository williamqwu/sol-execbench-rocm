{"type":"item.started","item":{"id":"item_19","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch\nimport reference, kernel\nfor n,s,atol in [(211,2,.0005707361828331407),(3719,30,.0005334020678012652)]:\n torch.manual_seed(100+n)\n inp=reference.get_inputs({'total_seq_len':n,'num_sequences':s,'embed_dim':1152,'num_heads':16,'head_dim':72},torch.device('cuda'))\n # Explicitly check the fused intermediate.\n qkv=torch.nn.functional.linear(inp['hidden_states'],inp['qkv_weight'],inp['qkv_bias']).reshape(n,3,16,72)\n q0,k0,_=qkv.permute(1,0,2,3).unbind(0)\n rot=lambda x: torch.cat((-x[...,36:],x[...,:36]),-1)\n q0=q0*inp['cos']+rot(q0)*inp['sin']; k0=k0*inp['cos']+rot(k0)*inp['sin']\n q1,k1=kernel._rope(qkv,inp['cos'],inp['sin'])\n print((n,s),'rope q exact',float((q0==q1).float().mean()),'max',float((q0.float()-q1.float()).abs().max()),'k exact',float((k0==k1).float().mean()))\n ref=reference.run(**inp); got=kernel.run(**inp)\n d=(got.float()-ref.float()).abs(); tol=atol+.0078125*ref.float().abs()\n print(' full max',float(d.max()),'ratio',float((d<=tol).float().mean()),'exact',float((d==0).float().mean()))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
