{"type":"item.started","item":{"id":"item_40","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch\nfor B,L,H,D in [(8,64,16,72),(19,124,16,72)]:\n p=torch.randn(B,H,L,L,device='cuda',dtype=torch.bfloat16)\n v=torch.randn(B,H,L,D,device='cuda',dtype=torch.bfloat16)\n ref=torch.matmul(p,v)\n dest=torch.empty(B,L,H,D,device='cuda',dtype=torch.bfloat16)\n view=dest.permute(0,2,1,3)\n try:\n  got=torch.matmul(p,v,out=view)\n  torch.cuda.synchronize()\n  print((B,L),'works',got.data_ptr()==dest.data_ptr(),float((got-ref).float().abs().max()),'strides',got.stride())\n  for _ in range(5):torch.matmul(p,v,out=view)\n  a=torch.cuda.Event(True);b=torch.cuda.Event(True);a.record()\n  for _ in range(100):torch.matmul(p,v,out=view)\n  b.record();b.synchronize();direct=b.elapsed_time(a) if False else a.elapsed_time(b)*1000/100\n  a.record()\n  for _ in range(100): ref=torch.matmul(p,v); z=ref.permute(0,2,1,3).contiguous()\n  b.record();b.synchronize();normal=a.elapsed_time(b)*1000/100\n  print(' us direct',direct,'normal+copy',normal)\n except Exception as e: print((B,L),'ERROR',type(e).__name__,e)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
