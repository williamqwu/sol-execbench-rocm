{"type":"item.started","item":{"id":"item_25","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch, torch.nn.functional as F, time\nimport reference,kernel\nfor n,s,atol in [(512,8,.000711107927),(373,4,.000601435472),(3719,30,.000533402068),(1024,4,.000378791647)]:\n torch.manual_seed(900+n)\n x=reference.get_inputs({'total_seq_len':n,'num_sequences':s,'embed_dim':1152,'num_heads':16,'head_dim':72},torch.device('cuda'))\n qkv=F.linear(x['hidden_states'],x['qkv_weight'],x['qkv_bias']).reshape(n,3,16,72)\n q,k=kernel._rope(qkv,x['cos'],x['sin']); v=qkv[:,2]\n ends=x['cu_seqlens'].tolist(); starts=[0]+ends[:-1]; outs=[]\n for a,b in zip(starts,ends):\n  if b>a:\n   qi=q[a:b].transpose(0,1);ki=k[a:b].transpose(0,1);vi=v[a:b].transpose(0,1)\n   p=F.softmax(torch.matmul(qi,ki.transpose(1,2))*72**-.5,-1,dtype=torch.float32).to(torch.bfloat16)\n   outs.append(torch.matmul(p,vi).transpose(0,1))\n refa=torch.cat(outs)\n maxlen=max(b-a for a,b in zip(starts,ends))\n try: got=kernel._attention_triton(q,k,qkv,x['cu_seqlens'],maxlen)\n except Exception as e:\n  print('COMPILE/EXEC ERROR',type(e).__name__,e); raise\n da=(got.float()-refa.float()).abs()\n rf=F.linear(refa.reshape(n,1152),x['proj_weight'],x['proj_bias']); gf=F.linear(got.reshape(n,1152),x['proj_weight'],x['proj_bias'])\n d=(gf.float()-rf.float()).abs(); tol=atol+.0078125*rf.float().abs()\n print((n,s),'attn max',float(da.max()),'exact',float((da==0).float().mean()),'full max',float(d.max()),'ratio',float((d<=tol).float().mean()))\n # compare only attention phase averaged with events\n for _ in range(5): kernel._attention_triton(q,k,qkv,x['cu_seqlens'],maxlen)\n st=torch.cuda.Event(True);en=torch.cuda.Event(True);st.record()\n for _ in range(50): kernel._attention_triton(q,k,qkv,x['cu_seqlens'],maxlen)\n en.record();en.synchronize();print(' triton attn us',st.elapsed_time(en)*1000/50)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
