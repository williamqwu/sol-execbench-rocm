{"type":"item.started","item":{"id":"item_52","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch,torch.nn.functional as F,reference,kernel,triton\nn,s,L=512,8,64\ntorch.manual_seed(777);x=reference.get_inputs({'total_seq_len':n,'num_sequences':s,'embed_dim':1152,'num_heads':16,'head_dim':72},torch.device('cuda'));qkv=F.linear(x['hidden_states'],x['qkv_weight'],x['qkv_bias']).reshape(n,3,16,72)\np1=kernel._pack_qkv(qkv,x['cu_seqlens'],x['cos'],x['sin'],L).view(3,s,16,L,72)\np2=torch.empty_like(p1);grid=(s*16,triton.cdiv(L*72,256));kernel._pack_padded_kernel[grid](qkv,x['cu_seqlens'],x['cos'],x['sin'],p2,MAX_LEN=L,BLOCK=256,num_warps=4)\nfor i in range(3):print('pack',i,float((p1[i]==p2[i]).float().mean()),float((p1[i].float()-p2[i].float()).abs().max()))\nsc1=p1[0]@p1[1].transpose(2,3);sc2=p2[0]@p2[1].transpose(2,3);print('scores',float((sc1==sc2).float().mean()),float((sc1.float()-sc2.float()).abs().max()))\nscale=72**-.5;a=sc1.clone();a.mul_(scale);b=sc2.clone();kernel._scale_mask_kernel[(s*16*L,)](b,x['cu_seqlens'],MAX_LEN=L,BLOCK=64,num_warps=4);print('scaled',float((a==b).float().mean()),float((a.float()-b.float()).abs().max()),'first',a.flatten()[:8],b.flatten()[:8])\npa=F.softmax(a,-1);pb=F.softmax(b,-1);print('prob',float((pa==pb).float().mean()),float((pa.float()-pb.float()).abs().max()))\nha=pa@p1[2];hb=pb@p2[2];print('heads',float((ha==hb).float().mean()),float((ha.float()-hb.float()).abs().max()))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
