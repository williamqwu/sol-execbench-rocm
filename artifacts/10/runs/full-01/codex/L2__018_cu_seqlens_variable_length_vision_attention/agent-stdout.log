{"type":"item.started","item":{"id":"item_46","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch,time,torch.nn.functional as F,reference,kernel\ncases=[(211,2,.0005707361828),(373,4,.0006014354723),(512,8,.000711107927),(3719,30,.0005334020678),(4096,64,.000721040675),(7168,28,.0003802605314)]\nfor n,s,atol in cases:\n torch.manual_seed(5000+n);x=reference.get_inputs({'total_seq_len':n,'num_sequences':s,'embed_dim':1152,'num_heads':16,'head_dim':72},torch.device('cuda'))\n # check packed values sequence by sequence\n qkv=F.linear(x['hidden_states'],x['qkv_weight'],x['qkv_bias']).reshape(n,3,16,72);q0,k0,v0=qkv.permute(1,0,2,3).unbind(0);rot=lambda z:torch.cat((-z[...,36:],z[...,:36]),-1);q0=q0*x['cos']+rot(q0)*x['sin'];k0=k0*x['cos']+rot(k0)*x['sin'];ends=x['cu_seqlens'].tolist();starts=[0]+ends[:-1];mx=max(b-a for a,b in zip(starts,ends));p=kernel._pack_qkv(qkv,x['cu_seqlens'],x['cos'],x['sin'],mx)\n exact=[]\n for sec,orig in zip(range(3),(q0,k0,v0)):\n  chunks=[]\n  for a,b in zip(starts,ends):chunks.append(p[sec,a*1152:b*1152].view(16,b-a,72).transpose(0,1))\n  dec=torch.cat(chunks);exact.append(float((dec==orig).float().mean()))\n r=reference.run(**x);g=kernel.run(**x);d=(g.float()-r.float()).abs();tol=atol+.0078125*r.float().abs();print((n,s),'packed exact',exact,'ratio',float((d<=tol).float().mean()),'exact',float((d==0).float().mean()),'max',float(d.max()))\n for _ in range(5):kernel.run(**x)\n torch.cuda.synchronize();t=time.perf_counter()\n for _ in range(50):kernel.run(**x)\n torch.cuda.synchronize();print(' ms',(time.perf_counter()-t)*20)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
