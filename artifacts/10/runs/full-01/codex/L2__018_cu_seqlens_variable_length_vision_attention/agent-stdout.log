{"type":"item.started","item":{"id":"item_50","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch,time,torch.nn.functional as F,reference,kernel\nfor n,s,atol in [(373,4,.0006014354723),(3719,30,.0005334020678),(4096,64,.000721040675),(7168,28,.0003802605314)]:\n torch.manual_seed(6000+n);x=reference.get_inputs({'total_seq_len':n,'num_sequences':s,'embed_dim':1152,'num_heads':16,'head_dim':72},torch.device('cuda'));base=kernel.run(**x);ends=x['cu_seqlens'].tolist();starts=[0]+ends[:-1];mx=max(b-a for a,b in zip(starts,ends));qkv=F.linear(x['hidden_states'],x['qkv_weight'],x['qkv_bias']).reshape(n,3,16,72);a=kernel._padded_attention(qkv,x['cu_seqlens'],x['cos'],x['sin'],mx);got=F.linear(a.reshape(n,1152),x['proj_weight'],x['proj_bias']);d=(got.float()-base.float()).abs();tol=atol+.0078125*base.float().abs();print((n,s,mx),'ratio-vs-verified',float((d<=tol).float().mean()),'exact',float((d==0).float().mean()),'max',float(d.max()))\n # full candidate timing\n def cand():\n  q=F.linear(x['hidden_states'],x['qkv_weight'],x['qkv_bias']).reshape(n,3,16,72);z=kernel._padded_attention(q,x['cu_seqlens'],x['cos'],x['sin'],mx);return F.linear(z.reshape(n,1152),x['proj_weight'],x['proj_bias'])\n for _ in range(5):cand()\n torch.cuda.synchronize();t=time.perf_counter()\n for _ in range(50):cand()\n torch.cuda.synchronize();print(' candidate ms',(time.perf_counter()-t)*20)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
