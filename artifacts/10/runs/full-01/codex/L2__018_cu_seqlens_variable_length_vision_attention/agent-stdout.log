{"type":"item.started","item":{"id":"item_30","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch,torch.nn.functional as F\nimport reference,kernel\nfor n,s,atol in [(512,8,.000711107927),(373,4,.000601435472),(3719,30,.000533402068),(1024,4,.000378791647),(7168,28,.000380260531)]:\n torch.manual_seed(1200+n);x=reference.get_inputs({'total_seq_len':n,'num_sequences':s,'embed_dim':1152,'num_heads':16,'head_dim':72},torch.device('cuda'))\n qkv=F.linear(x['hidden_states'],x['qkv_weight'],x['qkv_bias']).reshape(n,3,16,72);q,k=kernel._rope(qkv,x['cos'],x['sin']);v=qkv[:,2]\n ends=x['cu_seqlens'].tolist();starts=[0]+ends[:-1];runs=[]\n for a,b in zip(starts,ends):\n  l=b-a\n  if l<=0:continue\n  if runs and runs[-1][1]==a and runs[-1][2]==l:runs[-1]=(runs[-1][0],b,l)\n  else:runs.append((a,b,l))\n refs=[];gots=[];pex=[]\n for a,b,l in runs:\n  c=(b-a)//l;qi=q[a:b].reshape(c,l,16,72).permute(0,2,1,3);ki=k[a:b].reshape(c,l,16,72).permute(0,2,1,3);vi=v[a:b].reshape(c,l,16,72).permute(0,2,1,3)\n  sc=torch.matmul(qi,ki.transpose(2,3));pr=F.softmax(sc*(72**-.5),-1,dtype=torch.float32).to(torch.bfloat16);pg=kernel._scale_softmax(sc)\n  pex.append(float((pr==pg).float().mean()));refs.append(torch.matmul(pr,vi).permute(0,2,1,3).reshape(b-a,16,72));gots.append(torch.matmul(pg,vi).permute(0,2,1,3).reshape(b-a,16,72))\n ra=torch.cat(refs);ga=torch.cat(gots);rf=F.linear(ra.reshape(n,1152),x['proj_weight'],x['proj_bias']);gf=F.linear(ga.reshape(n,1152),x['proj_weight'],x['proj_bias']);d=(gf.float()-rf.float()).abs();tol=atol+.0078125*rf.float().abs()\n print((n,s),'p exact',pex,'attn exact',float((ra==ga).float().mean()),'max',float((ra.float()-ga.float()).abs().max()),'full ratio',float((d<=tol).float().mean()),'max',float(d.max()))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
