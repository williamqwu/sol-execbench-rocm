{"type":"item.started","item":{"id":"item_11","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch, torch.nn.functional as F, time\nfrom torch.nn.attention import sdpa_kernel, SDPBackend\nN,S,L,H,D=512,8,64,16,72\ntorch.manual_seed(123); dev='cuda'\nh=torch.randn(N,1152,device=dev,dtype=torch.bfloat16)\nw=torch.randn(3456,1152,device=dev,dtype=torch.bfloat16)*.02\ncos=torch.randn(N,H,D,device=dev,dtype=torch.bfloat16); sin=torch.randn_like(cos)\npw=torch.randn(1152,1152,device=dev,dtype=torch.bfloat16)*.02\nqkv=F.linear(h,w).reshape(N,3,H,D); q,k,v=qkv.permute(1,0,2,3).unbind(0)\ndef rot(x): return torch.cat((-x[...,36:],x[...,:36]),-1)\nq=q*cos+rot(q)*sin; k=k*cos+rot(k)*sin\nqr=q.reshape(S,L,H,D).permute(0,2,1,3); kr=k.reshape(S,L,H,D).permute(0,2,1,3); vr=v.reshape(S,L,H,D).permute(0,2,1,3)\np=F.softmax(torch.matmul(qr,kr.transpose(-1,-2))*D**-.5,-1,dtype=torch.float32).to(q.dtype)\naref=torch.matmul(p,vr).permute(0,2,1,3).reshape(N,1152)\nfref=F.linear(aref,pw)\nconfigs=[('default',None),('flash',SDPBackend.FLASH_ATTENTION),('efficient',SDPBackend.EFFICIENT_ATTENTION),('math',SDPBackend.MATH)]\nfor name,be in configs:\n try:\n  ctx=sdpa_kernel(be) if be else torch.backends.cuda.sdp_kernel()\n  with ctx:\n   for _ in range(3): out=F.scaled_dot_product_attention(qr,kr,vr,scale=D**-.5)\n   st=torch.cuda.Event(True); en=torch.cuda.Event(True); st.record()\n   for _ in range(20): out=F.scaled_dot_product_attention(qr,kr,vr,scale=D**-.5)\n   en.record(); en.synchronize(); us=st.elapsed_time(en)*1000/20\n  af=out.permute(0,2,1,3).reshape(N,1152)\n  final=F.linear(af,pw); diff=(final.float()-fref.float()).abs(); tol=.000711107927+.0078125*fref.float().abs()\n  print(name,'us',us,'attnmax',float((af.float()-aref.float()).abs().max()),'finalmax',float(diff.max()),'ratio',float((diff<=tol).float().mean()))\n except Exception as e: print(name,'ERROR',type(e).__name__,e)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
