256),)](\n    46\t        qkv, cos, sin, qk, n_elements, BLOCK=256)\n    47\t    return qk[0], qk[1]\n    48\t\n    49\t\n    50\t@triton.jit\n    51\tdef _pack_qkv_kernel(qkv, cu, cos, sin, packed, n_elements: tl.constexpr,\n    52\t                     BLOCK: tl.constexpr):\n    53\t    sh = tl.program_id(0)\n    54\t    seq = sh // 16\n    55\t    head = sh % 16\n    56\t    end = tl.load(cu + seq)\n    57\t    start = tl.where(seq == 0, 0, tl.load(cu + seq - 1))\n    58\t    length = end - start\n    59\t    offs = tl.program_id(1) * BLOCK + tl.arange(0, BLOCK)\n    60\t    pos = offs // 72\n    61\t    d = offs % 72\n    62\t    mask = pos < length\n    63\t    token = start + pos\n    64\t    within = head * 72 + d\n    65\t    base = token * 3456 + within\n    66\t    emb = token * 1152 + within\n    67\t    pair_d = tl.where(d < 36, d + 36, d - 36)\n    68\t    pair = token * 3456 + head * 72 + pair_d\n    69\t    c = tl.load(cos + emb, mask=mask)\n    70\t    s = tl.load(sin + emb, mask=mask)\n    71\t    dst = start * 1152 + head * length * 72 + offs\n    72\t\n    73\t    q0 = tl.load(qkv + base, mask=mask)\n    74\t    qr = tl.load(qkv + pair, mask=mask)\n    75\t    qr = tl.where(d < 36, -qr, qr)\n    76\t    qa = (q0 * c).to(tl.bfloat16)\n    77\t    qb = (qr * s).to(tl.bfloat16)\n    78\t    tl.store(packed + dst, (qa + qb).to(tl.bfloat16), mask=mask)\n    79\t\n    80\t    k0 = tl.load(qkv + base + 1152, mask=mask)\n    81\t    kr = tl.load(qkv + pair + 1152, mask=mask)\n    82\t    kr = tl.where(d < 36, -kr, kr)\n    83\t    ka = (k0 * c).to(tl.bfloat16)\n    84\t    kb = (kr * s).to(tl.bfloat16)\n    85\t    tl.store(packed + n_elements + dst,\n    86\t             (ka + kb).to(tl.bfloat16), mask=mask)\n    87\t    vv = tl.load(qkv + base + 2304, mask=mask)\n    88\t    tl.store(packed + 2 * n_elements + dst, vv, mask=mask)\n    89\t\n    90\t\n    91\tdef _pack_qkv(qkv, cu_seqlens, cos, sin, max_len):\n    92\t    n_elements = cos.numel()\n    93\t    packed = torch.empty((3, n_elements), device=qkv.device, dtype=qkv.dtype)\n    94\t    grid = (cu_seqlens.numel() * 16, triton.cdiv(max_len * 72, 512))\n    95\t    _pack_qkv_kernel[grid](qkv, cu_seqlens, cos, sin, packed, n_elements,\n    96\t                           BLOCK=512, num_warps=4)\n    97\t    return packed\n    98\t\n    99\t\n   100\t@triton.jit\n   101\tdef _pack_padded_kernel(qkv, cu, cos, sin, packed, MAX_LEN: tl.constexpr,\n   102\t                        BLOCK: tl.constexpr):\n   103\t    sh = tl.program_id(0)\n   104\t    seq = sh // 16\n   105\t    head = sh % 16\n   106\t    end = tl.load(cu + seq)\n   107\t    start = tl.where(seq == 0, 0, tl.load(cu + seq - 1))\n   108\t    length = end - start\n   109\t    offs = tl.program_id(1) * BLOCK + tl.arange(0, BLOCK)\n   110\t    pos = offs // 72\n   111\t    d = offs % 72\n   112\t    in_range = pos < MAX_LEN\n   113\t    valid = pos < length\n   114\t    token = start + pos\n   115\t    within = head * 72 + d\n   116\t    base = token * 3456 + within\n   117\t    emb = token * 1152 + within\n   118\t    pair_d = tl.where(d < 36, d + 36, d - 36)\n   119\t    pair = token * 3456 + head * 72 + pair_d\n   120\t    c = tl.load(cos + emb, mask=valid, other=0.0)\n   121\t    s = tl.load(sin + emb, mask=valid, other=0.0)\n   122\t    dst = seq * (16 * MAX_LEN * 72) + head * (MAX_LEN * 72) + offs\n   123\t\n   124\t    q0 = tl.load(qkv + base, mask=valid, other=0.0)\n   125\t    qr = tl.load(qkv + pair, mask=valid, other=0.0)\n   126\t    qr = tl.where(d < 36, -qr, qr)\n   127\t    qa = (q0 * c).to(tl.bfloat16)\n   128\t    qb = (qr * s).to(tl.bfloat16)\n   129\t    tl.store(packed + dst, (qa + qb).to(tl.bfloat16), mask=in_range)\n   130\t\n   131\t    plane = tl.num_programs(0) * MAX_LEN * 72\n   132\t    k0 = tl.load(qkv + base + 1152, mask=valid, other=0.0)\n   133\t    kr = tl.load(qkv + pair + 1152, mask=valid, other=0.0)\n   134\t    kr = tl.where(d < 36, -kr, kr)\n   135\t    ka = (k0 * c).to(tl.bfloat16)\n   136\t    kb = (kr * s).to(tl.bfloat16)\n   137\t    tl.store(packed + plane + dst, (ka + kb).to(tl.bfloat16),\n   138\t             mask=in_range)\n   139\t    vv = tl.load(qkv + base + 2304, mask=valid, other=0.0)\n   140\t    tl.store(packed + 2 * plane + dst, vv, mask=in_range)\n   141\t\n   142\t\n   143\t@triton.jit\n   144\tdef _scale_mask_kernel(scores, cu, MAX_LEN: tl.constexpr,\n   145\t                       BLOCK: tl.constexpr):\n   146\t    row = tl.program_id(0)\n   147\t    seq = row // (16 * MAX_LEN)\n   148\t    end = tl.load(cu + seq)\n   149\t    start = tl.where(seq == 0, 0, tl.load(cu + seq - 1))\n   150\t    length = end - start\n   151\t    cols = tl.arange(0, BLOCK)\n   152\t    mask = cols < MAX_LEN\n   153\t    vals = tl.load(scores + row * MAX_LEN + cols, mask=mask)\n   154\t    vals = (vals.to(tl.float32) * 0.11785113019775793).to(tl.bfloat16)\n   155\t    vals = tl.where(cols < length, vals, -float(\"inf\"))\n   156\t    tl.store(scores + row * MAX_LEN + cols, vals, mask=mask)\n   157\t\n   158\t\n   159\t@triton.jit\n   160\tdef _unpack_kernel(heads, cu, attn, MAX_LEN: tl.constexpr,\n   161\t                   BLOCK: tl.constexpr):\n   162\t    sh = tl.program_id(0)\n   163\t    seq = sh // 16\n   164\t    head = sh % 16\n   165\t    end = tl.load(cu + seq)\n   166\t    start = tl.where(seq == 0, 0, tl.load(cu + seq - 1))\n   167\t    length = end - start\n   168\t    offs = tl.program_id(1) * BLOCK + tl.arange(0, BLOCK)\n   169\t    pos = offs // 72\n   170\t    d = offs % 72\n   171\t    mask = pos < length\n   172\t    src = seq * (16 * MAX_LEN * 72) + head * (MAX_LEN * 72) + offs\n   173\t    dst = (start + pos) * 1152 + head * 72 + d\n   174\t    vals = tl.load(heads + src, mask=mask)\n   175\t    tl.store(attn + dst, vals, mask=mask)\n   176\t\n   177\t\n   178\tdef _padded_attention(qkv, cu_seqlens, cos, sin, max_len):\n   179\t    sequences = cu_seqlens.numel()\n   180\t    packed = torch.empty((3, sequences, 16, max_len, 72),\n   181\t                         device=qkv.device, dtype=qkv.dtype)\n   182\t    grid = (sequences * 16, triton.cdiv(max_len * 72, 512))\n   183\t    _pack_padded_kernel[grid](qkv, cu_seqlens, cos, sin, packed,\n   184\t                              MAX_LEN=max_len, BLOCK=512, num_warps=4)\n   185\t    scores = torch.matmul(packed[0], packed[1].transpose(2, 3))\n   186\t    block = triton.next_power_of_2(max_len)\n   187\t    _scale_mask_kernel[(sequences * 16 * max_len,)](\n   188\t        scores, cu_seqlens, MAX_LEN=max_len, BLOCK=block, num_warps=1)\n   189\t    probs = F.softmax(scores, dim=-1)\n   190\t    heads = torch.matmul(probs, packed[2])\n   191\t    attn = torch.empty((qkv.shape[0], 16, 72), device=qkv.device,\n   192\t                       dtype=qkv.dtype)\n   193\t    _unpack_kernel[grid](heads, cu_seqlens, attn, MAX_LEN=max_len,\n   194\t                         BLOCK=512, num_warps=4)\n   195\t    return attn\n   196\t\n   197\t\n   198\t@triton.jit\n   199\tdef _attention_kernel(q, k, v, cu, out, MAX_LEN: tl.constexpr,\n   200\t                      BLOCK_M: tl.constexpr, BLOCK_D: tl.constexpr):\n   201\t    qblock = tl.program_id(0)\n   202\t    sh = tl.program_id(1)\n   203\t    seq = sh // 16\n   204\t    head = sh % 16\n   205\t    end = tl.load(cu + seq)\n   206\t    start = tl.where(seq == 0, 0, tl.load(cu + seq - 1))\n   207\t    length = end - start\n   208\t\n   209\t    rm = qblock * BLOCK_M + tl.arange(0, BLOCK_M)\n   210\t    rn = tl.arange(0, MAX_LEN)\n   211\t    rd = tl.arange(0, BLOCK_D)\n   212\t    q_rows = start + rm\n   213\t    k_rows = start + rn\n   214\t\n   215\t    qtile = tl.load(\n   216\t        q + q_rows[:, None] * 1152 + head * 72 + rd[None, :],\n   217\t        mask=(rm[:, None] < length) & (rd[None, :] < 72), other=0.0)\n   218\t    ktile = tl.load(\n   219\t        k + k_rows[None, :] * 1152 + head * 72 + rd[:, None],\n   220\t        mask=(rn[None, :] < length) & (rd[:, None] < 72), other=0.0)\n   221\t\n   222\t    # torch.matmul(BF16, BF16) materializes a BF16 score tensor, and the\n   223\t    # following scalar multiply materializes another BF16 tensor.\n   224\t    scores = tl.dot(qtile, ktile).to(tl.bfloat16)\n   225\t    scores = (scores * 0.11785113019775793).to(tl.bfloat16)\n   226\t    scores = tl.where(rn[None, :] < length, scores, -float(\"inf\"))\n   227\t    scores = scores.to(tl.float32)\n   228\t    scores = scores - tl.max(scores, axis=1)[:, None]\n   229\t    probs = tl.exp(scores)\n   230\t    probs = probs / tl.sum(probs, axis=1)[:, None]\n   231\t    probs = probs.to(tl.bfloat16)\n   232\t\n   233\t    vtile = tl.load(\n   234\t        v + k_rows[:, None] * 3456 + 2304 + head * 72 + rd[None, :],\n   235\t        mask=(rn[:, None] < length) & (rd[None, :] < 72), other=0.0)\n   236\t    result = tl.dot(probs, vtile).to(tl.bfloat16)\n   237\t    tl.store(out + q_rows[:, None] * 1152 + head * 72 + rd[None, :],\n   238\t             result,\n   239\t             mask=(rm[:, None] < length) & (rd[None, :] < 72))\n   240\t\n   241\t\n   242\tdef _attention_triton(q, k, qkv, cu_seqlens, max_len):\n   243\t    n = q.shape[0]\n   244\t    block_n = triton.next_power_of_2(max_len)\n   245\t    out = torch.empty_like(q)\n   246\t    _attention_kernel[(triton.cdiv(max_len, 16), cu_seqlens.numel() * 16)](\n   247\t        q, k, qkv, cu_seqlens, out, MAX_LEN=block_n, BLOCK_M=16,\n   248\t        BLOCK_D=128, num_warps=4)\n   249\t    return out\n   250\t\n   251\t\n   252\t@triton.jit\n   253\tdef _scale_softmax_kernel(x, out, n_rows: tl.constexpr, n_cols: tl.constexpr,\n   254\t                          BLOCK: tl.constexpr):\n   255\t    row = tl.program_id(0)\n   256\t    cols = tl.arange(0, BLOCK)\n   257\t    mask = cols < n_cols\n   258\t    vals = tl.load(x + row * n_cols + cols, mask=mask, other=-float(\"inf\"))\n   259\t    # Preserve the eager BF16 result of the scalar multiply.\n   260\t    vals = (vals * 0.11785113019775793).to(tl.bfloat16)\n   261\t    vals = tl.where(mask, vals, -float(\"inf\")).to(tl.float32)\n   262\t    vals = vals - tl.max(vals, axis=0)\n   263\t    numer = libdevice.exp(vals)\n   264\t    probs = (numer / tl.sum(numer, axis=0)).to(tl.bfloat16)\n   265\t    tl.store(out + row * n_cols + cols, probs, mask=mask)\n   266\t\n   267\t\n   268\tdef _scale_softmax(scores):\n   269\t    rows = scores.numel() // scores.shape[-1]\n   270\t    cols = scores.shape[-1]\n   271\t    out = torch.empty_like(scores)\n   272\t    block = triton.next_power_of_2(cols)\n   273\t    _scale_softmax_kernel[(rows,)](scores, out, rows, cols, BLOCK=block,\n   274\t                                   num_warps=4)\n   275\t    return out\n   276\t\n   277\t\n   278\t_cached_cu = None\n   279\t_cached_cu_version = None\n   280\t_cached_desc = None\n   281\t\n   282\t\n   283\tdef _sequence_desc(cu_seqlens):\n   284\t    global _cached_cu, _cached_cu_version, _cached_desc\n   285\t    version = cu_seqlens._version\n   286\t    if cu_seqlens is _cached_cu and version == _cached_cu_version:\n   287\t        return _cached_desc\n   288\t    ends = cu_seqlens.tolist()\n   289\t    starts = [0] + ends[:-1]\n   290\t    runs = []\n   291\t    max_len = 0\n   292\t    for start, end in zip(starts, ends):\n   293\t        length = end - start\n   294\t        if length <= 0:\n   295\t            continue\n   296\t        max_len = max(max_len, length)\n   297\t        if runs and runs[-1][2] == length and runs[-1][1] == start:\n   298\t            runs[-1] = (runs[-1][0], end, length)\n   299\t        else:\n   300\t            runs.append((start, end, length))\n   301\t    _cached_cu = cu_seqlens\n   302\t    _cached_cu_version = version\n   303\t    _cached_desc = (runs, max_len)\n   304\t    return _cached_desc\n   305\t\n   306\t\n   307\t@torch.no_grad()\n   308\tdef run(hidden_states, cu_seqlens, cos, sin, qkv_weight, qkv_bias,\n   309\t        proj_weight, proj_bias):\n   310\t    n = hidden_states.shape[0]\n   311\t    # Fetch the tiny sequence descriptor before launching any compute, so this\n   312\t    # synchronization cannot stall the projection below.  Equal-length runs\n   313\t    # can be evaluated as a single strided-batched GEMM without changing the\n   314\t    # arithmetic performed for any sequence.\n   315\t    runs, max_len = _sequence_desc(cu_seqlens)\n   316\t\n   317\t    if not runs:\n   318\t        return torch.zeros_like(hidden_states)\n   319\t\n   320\t    qkv = F.linear(hidden_states, qkv_weight, qkv_bias).reshape(n, 3, 16, 72)\n   321\t    if len(runs) > 1:\n   322\t        attn = _padded_attention(qkv, cu_seqlens, cos, sin, max_len)\n   323\t        return F.linear(attn.reshape(n, 1152), proj_weight, proj_bias)\n   324\t\n   325\t    packed = _pack_qkv(qkv, cu_seqlens, cos, sin, max_len)\n   326\t\n   327\t    attn = torch.empty((n, 16, 72), device=hidden_states.device,\n   328\t                       dtype=hidden_states.dtype)\n   329\t    scale = 72 ** -0.5\n   330\t    for start, end, length in runs:\n   331\t        count = (end - start) // length\n   332\t        offset = start * 1152\n   333\t        size = (end - start) * 1152\n   334\t        qi = packed[0].narrow(0, offset, size).view(count, 16, length, 72)\n   335\t        ki = packed[1].narrow(0, offset, size).view(count, 16, length, 72)\n   336\t        vi = packed[2].narrow(0, offset, size).view(count, 16, length, 72)\n   337\t        scores = torch.matmul(qi, ki.transpose(2, 3))\n   338\t        scores.mul_(scale)\n   339\t        # The BF16 softmax kernel accumulates in FP32 and directly performs\n   340\t        # the same final BF16 conversion as `.softmax(dtype=float32).to(bf16)`.\n   341\t        probs = F.softmax(scores, dim=-1)\n   342\t        out = torch.matmul(probs, vi).permute(0, 2, 1, 3)\n   343\t        attn[start:end].view(count, length, 16, 72).copy_(out)\n   344\t\n   345\t    return F.linear(attn.reshape(n, 1152), proj_weight, proj_bias)\n","exit_code":0,"status":"completed"}}
