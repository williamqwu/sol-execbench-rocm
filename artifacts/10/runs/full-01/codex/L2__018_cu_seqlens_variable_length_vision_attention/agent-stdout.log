{"type":"item.started","item":{"id":"item_63","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch,triton\nimport reference,kernel\n\ndef evtime(fn,reps=100):\n for _ in range(5):fn()\n a=torch.cuda.Event(True);b=torch.cuda.Event(True);a.record()\n for _ in range(reps):fn()\n b.record();b.synchronize();return a.elapsed_time(b)*1000/reps\nfor n,s,L,padded in [(4096,64,64,False),(7168,28,256,False),(3719,30,124,True)]:\n x=reference.get_inputs({'total_seq_len':n,'num_sequences':s,'embed_dim':1152,'num_heads':16,'head_dim':72},torch.device('cuda'))\n qkv=torch.nn.functional.linear(x['hidden_states'],x['qkv_weight'],x['qkv_bias']).reshape(n,3,16,72)\n print('\\\\nCASE',n,s,L,'padded',padded)\n for B in (128,256,512,1024):\n  for W in (4,8):\n   if padded:\n    out=torch.empty((3,s,16,L,72),device='cuda',dtype=torch.bfloat16);grid=(s*16,triton.cdiv(L*72,B));fn=lambda B=B,W=W:grid and kernel._pack_padded_kernel[grid](qkv,x['cu_seqlens'],x['cos'],x['sin'],out,MAX_LEN=L,BLOCK=B,num_warps=W)\n   else:\n    out=torch.empty((3,n*1152),device='cuda',dtype=torch.bfloat16);grid=(s*16,triton.cdiv(L*72,B));fn=lambda B=B,W=W:grid and kernel._pack_qkv_kernel[grid](qkv,x['cu_seqlens'],x['cos'],x['sin'],out,n*1152,BLOCK=B,num_warps=W)\n   try: print(' pack B',B,'W',W,f'{evtime(fn):.2f} us')\n   except Exception as e: print(' pack ERR',B,W,e)\n # unpack always padded-shaped source (layout same for uniform)\n heads=torch.randn(s,16,L,72,device='cuda',dtype=torch.bfloat16);attn=torch.empty(n,16,72,device='cuda',dtype=torch.bfloat16)\n for B in (128,256,512,1024):\n  for W in (4,8):\n   grid=(s*16,triton.cdiv(L*72,B));fn=lambda B=B,W=W:grid and kernel._unpack_kernel[grid](heads,x['cu_seqlens'],attn,MAX_LEN=L,BLOCK=B,num_warps=W)\n   try: print(' unpack B',B,'W',W,f'{evtime(fn):.2f} us')\n   except Exception as e: print(' unpack ERR',B,W,e)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
