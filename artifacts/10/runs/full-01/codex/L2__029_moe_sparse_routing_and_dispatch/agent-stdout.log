{"type":"item.started","item":{"id":"item_25","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch, torch.nn.functional as F, aiter\nD='cuda'; N,E,H,I,K,B=16,64,8192,3584,8,32\ntorch.manual_seed(1)\nx=torch.randn((N,H),device=D,dtype=torch.bfloat16)*0.02\nw1=torch.empty((E,I,H),device=D,dtype=torch.bfloat16); w2=torch.empty_like(w1); w3=torch.empty((E,H,I),device=D,dtype=torch.bfloat16)\nfor e in range(K):\n w1[e].normal_(0,.01); w2[e].normal_(0,.01); w3[e].normal_(0,.01)\nids=torch.arange(K,device=D,dtype=torch.int32).expand(N,K).contiguous(); weights=torch.full((N,K),1/K,device=D,dtype=torch.bfloat16).float()\nmax_pad=N*K+E*B\nstid=torch.empty(max_pad,device=D,dtype=torch.int32); stw=torch.empty(max_pad,device=D,dtype=torch.float32); seid=torch.empty((max_pad+B-1)//B,device=D,dtype=torch.int32); nvalid=torch.empty(1,device=D,dtype=torch.int32); buf=torch.empty(E,device=D,dtype=torch.int32)\naiter.moe_sorting_fwd(ids,weights,stid,stw,seid,nvalid,buf,E,B)\ninter=torch.empty((N,K,I),device=D,dtype=torch.bfloat16); out=torch.empty((N,K,H),device=D,dtype=torch.bfloat16)\naiter.ck_moe_stage1(x,w1,w2,stid,seid,nvalid,inter,K,'',block_m=B,activation=0,is_shuffled=False)\naiter.ck_moe_stage2(inter,w3,w3,stid,seid,nvalid,out,K,'',block_m=B,sorted_weights=stw,activation=0,is_shuffled=False)\nrefs=[]\nfor e in range(K):\n g=x@w1[e].t(); u=x@w2[e].t(); y=(F.silu(g)*u)@w3[e].t(); refs.append(y*weights[:,e,None].to(torch.bfloat16))\nref=torch.stack(refs,dim=1)\ntorch.cuda.synchronize()\na=(out.float()-ref.float()).abs(); rel=a/ref.float().abs().clamp_min(1e-20)\nprint('nvalid',nvalid.item(),'refmax',ref.abs().max().item(),'maxabs',a.max().item(),'meanabs',a.mean().item(),'ratio rtol',((a<=.005+.0078125*ref.float().abs())).float().mean().item(),'maxrel',rel.max().item())\nprint('inter sample',inter.flatten()[:8].cpu()); print('out sample',out.flatten()[:8].cpu()); print('ref sample',ref.flatten()[:8].cpu())\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
