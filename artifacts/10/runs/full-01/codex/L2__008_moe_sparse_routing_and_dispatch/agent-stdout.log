{"type":"item.started","item":{"id":"item_15","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch, aiter\nD='cuda'; torch.manual_seed(2)\nM,E,H,N,K=64,4,2048,768,2\nx=torch.randn(M,H,device=D,dtype=torch.bfloat16)*.01\ng=torch.randn(E,N,H,device=D,dtype=torch.bfloat16)*.01\nu=torch.randn(E,N,H,device=D,dtype=torch.bfloat16)*.01\nd=torch.randn(E,H,N,device=D,dtype=torch.bfloat16)*.01\nids=torch.randint(E,(M,K),device=D,dtype=torch.int32)\nw=torch.rand(M,K,device=D,dtype=torch.float32); w/=w.sum(1,keepdim=True)\nunit=32; mx=ids.numel()+E*unit-K\nsid=torch.empty(mx,device=D,dtype=torch.int32); sw=torch.empty(mx,device=D,dtype=torch.float32)\nse=torch.empty((mx+unit-1)//unit,device=D,dtype=torch.int32); nv=torch.empty(1,device=D,dtype=torch.int32); buf=torch.empty(E,device=D,dtype=torch.int32)\naiter.moe_sorting_fwd(ids,w,sid,sw,se,nv,buf,E,unit)\nout=torch.empty(M,H,device=D,dtype=torch.bfloat16)\ngup=torch.cat((g,u),dim=1)\ntry:\n aiter.fmoe(out,x,gup,d,sid,sw,se,nv,K)\n torch.cuda.synchronize(); print('ok',nv.cpu(),out.abs().mean().item(),out.abs().max().item())\n # explicit respecting duplicates weird\n ref=torch.zeros_like(x)\n for e in range(E):\n  for t in range(M):\n   for k in range(K):\n    if ids[t,k]==e:\n     gg=x[t].float()@g[e].float().T\n     uu=x[t].float()@u[e].float().T\n     yy=(gg.to(torch.bfloat16)*torch.sigmoid(gg.to(torch.bfloat16))*uu.to(torch.bfloat16)).to(torch.bfloat16).float()@d[e].float().T\n     ref[t]+=(yy.to(torch.bfloat16)*w[t,k].to(torch.bfloat16)).to(torch.bfloat16)\n print('err', (out.float()-ref.float()).abs().max().item(), torch.isclose(out,ref,rtol=.0078125,atol=.0018).float().mean().item())\nexcept Exception as e: print(type(e),e)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
