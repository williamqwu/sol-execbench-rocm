{"type":"item.started","item":{"id":"item_30","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch, aiter\naiter.hipb_create_extension(); n,k=102400,2048\nw=torch.randn((n,k),device='cuda',dtype=torch.bfloat16)*(k**-0.5); b=w.t()\ndef median(fn,reps=7):\n for _ in range(2):out=fn()\n torch.cuda.synchronize();ss=[];es=[]\n for _ in range(reps):\n  s=torch.cuda.Event(enable_timing=True);e=torch.cuda.Event(enable_timing=True);s.record();out=fn();e.record();ss.append(s);es.append(e)\n torch.cuda.synchronize();v=sorted(s.elapsed_time(e) for s,e in zip(ss,es));return v[len(v)//2],out\nfor m in (256,293,691,1024):\n a=torch.randn((m,k),device='cuda',dtype=torch.bfloat16);sols=aiter.hipb_findallsols(a,b);results=[]\n for start in range(0,len(sols),128):\n  ids=sols[start:start+128]\n  for i in ids:out=aiter.hipb_mm(a,b,i)\n  torch.cuda.synchronize();ss=[];es=[]\n  for i in ids:\n   s=torch.cuda.Event(enable_timing=True);e=torch.cuda.Event(enable_timing=True);s.record();out=aiter.hipb_mm(a,b,i);e.record();ss.append(s);es.append(e)\n  torch.cuda.synchronize();results.extend((s.elapsed_time(e),i) for s,e,i in zip(ss,es,ids))\n results.sort(); candidates=[i for _,i in results[:20]]\n refined=[]\n for i in candidates:\n  t,out=median(lambda i=i:aiter.hipb_mm(a,b,i),5);refined.append((t,i))\n refined.sort();bt,_=median(lambda:torch.mm(a,b),7)\n print('M',m,'torch',round(bt,6),'TOP',[(i,round(t,6)) for t,i in refined[:12]],flush=True)\n del a,out\naiter.hipb_destroy_extension()\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
