{"type":"item.started","item":{"id":"item_13","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch, triton\nimport kernel\nm,n,k=4096,102400,2048\na=torch.randn((m,k),device='cuda',dtype=torch.bfloat16)\nw=torch.randn((n,k),device='cuda',dtype=torch.bfloat16)*(k**-0.5)\nout=torch.empty((m,n),device='cuda',dtype=torch.bfloat16)\n\ndef bench(fn,reps=7):\n    for _ in range(2): fn()\n    torch.cuda.synchronize()\n    ss=[torch.cuda.Event(enable_timing=True) for _ in range(reps)]; es=[torch.cuda.Event(enable_timing=True) for _ in range(reps)]\n    for s,e in zip(ss,es): s.record(); fn(); e.record()\n    torch.cuda.synchronize(); v=sorted(s.elapsed_time(e) for s,e in zip(ss,es)); return v[len(v)//2]\n\ndef launch(nw,ns,opts):\n    bm=bn=128; bk=64; grid=(triton.cdiv(m,bm)*triton.cdiv(n,bn),)\n    kernel._lm_head_kernel[grid](a,w,out,M=m,N=n,K=k,BLOCK_M=bm,BLOCK_N=bn,BLOCK_K=bk,GROUP_M=8,num_warps=nw,num_stages=ns,**opts)\nbase=bench(lambda:torch.mm(a,w.t())); print('torch',base,flush=True)\nvariants=[]\nfor nw in (4,8):\n  for ns in (1,2,3): variants.append((nw,ns,{}))\nfor nw in (4,8):\n  for wpe in (1,2,3,4): variants.append((nw,2,{'waves_per_eu':wpe}))\nfor nw in (4,8):\n  for mi in (16,32):\n    for kp in (1,2):\n      for wpe in (1,2,3,4): variants.append((nw,2,{'waves_per_eu':wpe,'matrix_instr_nonkdim':mi,'kpack':kp}))\nseen=set()\nfor nw,ns,opts in variants:\n    key=(nw,ns,tuple(opts.items()))\n    if key in seen: continue\n    seen.add(key)\n    try:\n      t=bench(lambda nw=nw,ns=ns,opts=opts:launch(nw,ns,opts))\n      print(nw,ns,opts,round(t,4),round(base/t,3),flush=True)\n    except Exception as e: print(nw,ns,opts,'ERROR',repr(e).split('\\\\\\\\n')[-1],flush=True)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
