{"type":"item.completed","item":{"id":"item_27","type":"agent_message","text":"The hipBLASLt wrapper exposes 2,084 valid gfx950 algorithms, and spot checks show all preserve the required BF16 accuracy. The default shortlist is not faster than PyTorch, so I’m doing a bounded exhaustive sweep for the smallest shape first, then I’ll carry only the strongest tile families across the remaining `M` values."}}
{"type":"item.started","item":{"id":"item_28","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch, aiter\naiter.hipb_create_extension()\nm,n,k=128,102400,2048\na=torch.randn((m,k),device='cuda',dtype=torch.bfloat16);w=torch.randn((n,k),device='cuda',dtype=torch.bfloat16)*(k**-0.5);b=w.t()\nsols=aiter.hipb_findallsols(a,b)\nresults=[]\nchunk=128\nfor start in range(0,len(sols),chunk):\n ids=sols[start:start+chunk]\n for i in ids: out=aiter.hipb_mm(a,b,i)\n torch.cuda.synchronize()\n ss=[];es=[]\n for i in ids:\n  s=torch.cuda.Event(enable_timing=True);e=torch.cuda.Event(enable_timing=True)\n  s.record();out=aiter.hipb_mm(a,b,i);e.record();ss.append(s);es.append(e)\n torch.cuda.synchronize()\n results.extend((s.elapsed_time(e),i) for s,e,i in zip(ss,es,ids))\n if start%512==0: print('progress',start,'best',min(results),flush=True)\nresults.sort()\nprint('TOP')\nfor t,i in results[:40]: print(i,round(t,6),aiter.getHipblasltKernelName(i).split('_UserArgs')[0],flush=True)\naiter.hipb_destroy_extension()\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
