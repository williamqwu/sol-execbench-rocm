{"type":"item.started","item":{"id":"item_56","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch,aiter\nfor m in (128,293,691,1024,2048,4096):\n n,k=102400,2048;a=torch.randn((1,m,k),device='cuda',dtype=torch.bfloat16);w=torch.randn((1,n,k),device='cuda',dtype=torch.bfloat16)*(k**-0.5);out=torch.empty((1,m,n),device='cuda',dtype=torch.bfloat16);ref=torch.bmm(a,w.transpose(1,2))\n print('M',m,flush=True)\n for kid in (200,1200,1400,1401,1402):\n  for sk in ((1,2,4,8,16,32) if kid in (200,1200) else (0,)):\n   try:\n    fn=lambda:aiter.opus_gemm_a16w16_tune(a,w,out,kernelId=kid,splitK=sk)\n    for _ in range(2):fn()\n    torch.cuda.synchronize();v=[]\n    for _ in range(5):\n     torch.cuda.synchronize();s=torch.cuda.Event(enable_timing=True);e=torch.cuda.Event(enable_timing=True);s.record();fn();e.record();e.synchronize();v.append(s.elapsed_time(e))\n    v.sort();c=torch.isclose(out,ref,atol=.00782,rtol=.0078125).float().mean().item();print(kid,sk,round(v[2],5),round(c,6),flush=True)\n   except Exception as e: print(kid,sk,'ERR',str(e).splitlines()[-1],flush=True)\n del a,w,out,ref\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
