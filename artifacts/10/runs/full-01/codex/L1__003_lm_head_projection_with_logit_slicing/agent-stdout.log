{"type":"item.started","item":{"id":"item_54","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch, aiter\nm,n,k=128,102400,2048\na=torch.randn((1,m,k),device='cuda',dtype=torch.bfloat16);w=torch.randn((1,n,k),device='cuda',dtype=torch.bfloat16)*(k**-0.5);out=torch.empty((1,m,n),device='cuda',dtype=torch.bfloat16);ref=torch.bmm(a,w.transpose(1,2))\ndef fn(kid,sk):return aiter.opus_gemm_a16w16_tune(a,w,out,kernelId=kid,splitK=sk)\ndef bench(kid,sk):\n for _ in range(2):fn(kid,sk)\n torch.cuda.synchronize();v=[]\n for _ in range(5):\n  torch.cuda.synchronize();s=torch.cuda.Event(enable_timing=True);e=torch.cuda.Event(enable_timing=True);s.record();fn(kid,sk);e.record();e.synchronize();v.append(s.elapsed_time(e))\n v.sort();return v[2],torch.isclose(out,ref,atol=.00782,rtol=.0078125).float().mean().item()\nfor kid in list(range(10))+list(range(1400,1405)):\n try:t,c=bench(kid,0);print(kid,round(t,6),round(c,6),flush=True)\n except Exception as e:print(kid,'ERR',str(e).splitlines()[-1],flush=True)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
