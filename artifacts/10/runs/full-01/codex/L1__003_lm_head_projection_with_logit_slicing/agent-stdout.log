{"type":"item.started","item":{"id":"item_9","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch\nimport kernel\n\ntorch.manual_seed(0)\ndevice='cuda:0'\nw = torch.randn((102400, 2048), device=device, dtype=torch.bfloat16) * (2048 ** -0.5)\n\ndef measure(fn, reps):\n    for _ in range(3): fn()\n    torch.cuda.synchronize()\n    starts = [torch.cuda.Event(enable_timing=True) for _ in range(reps)]\n    ends = [torch.cuda.Event(enable_timing=True) for _ in range(reps)]\n    for s,e in zip(starts,ends):\n        s.record(); fn(); e.record()\n    torch.cuda.synchronize()\n    vals=sorted(s.elapsed_time(e) for s,e in zip(starts,ends))\n    return vals[len(vals)//2]\n\nfor m in (128, 256, 1024, 4096, 8192):\n    a = torch.randn((1,m,2048), device=device, dtype=torch.bfloat16)\n    got = kernel.run(a,w)\n    ref = torch.matmul(a,w.t())\n    close = torch.isclose(got,ref,atol=.00782,rtol=.0078125)\n    print('M',m,'maxerr',float((got-ref).abs().max()),'match',float(close.float().mean()))\n    reps=10 if m >= 4096 else 20\n    tk=measure(lambda: kernel.run(a,w),reps)\n    tt=measure(lambda: torch.matmul(a,w.t()),reps)\n    print('  triton',tk,'torch',tt,'speedup',tt/tk)\n    del a,got,ref,close\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
