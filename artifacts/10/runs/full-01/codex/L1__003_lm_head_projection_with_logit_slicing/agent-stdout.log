{"type":"item.started","item":{"id":"item_53","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch, aiter\nm,n,k=128,102400,2048\na=torch.randn((1,m,k),device='cuda',dtype=torch.bfloat16);w=torch.randn((n,k),device='cuda',dtype=torch.bfloat16)*(k**-0.5);out=torch.empty((1,m,n),device='cuda',dtype=torch.bfloat16);ref=torch.mm(a.view(m,k),w.t())\ndef one(kid,sk):\n return aiter.opus_gemm_a16w16_tune(a,w,out,kernelId=kid,splitK=sk)\ndef bench(kid,sk):\n for _ in range(2):one(kid,sk)\n torch.cuda.synchronize();v=[]\n for _ in range(5):\n  torch.cuda.synchronize();s=torch.cuda.Event(enable_timing=True);e=torch.cuda.Event(enable_timing=True);s.record();one(kid,sk);e.record();e.synchronize();v.append(s.elapsed_time(e))\n v.sort();close=torch.isclose(out.view(m,n),ref,atol=.00782,rtol=.0078125).float().mean().item();return v[2],close\nfor kid in list(range(10))+list(range(200,212))+list(range(1200,1212))+list(range(1400,1405))+list(range(10200,10212))+list(range(20000,20012)):\n for sk in ((0,1,2,4,8) if (200<=kid<1300 or kid>=10200) else (0,)):\n  try:\n   t,c=bench(kid,sk);print(kid,sk,round(t,6),round(c,6),flush=True)\n  except Exception as e:print(kid,sk,'ERR',str(e).splitlines()[-1],flush=True)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
