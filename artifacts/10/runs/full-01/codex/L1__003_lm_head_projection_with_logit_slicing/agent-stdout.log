{"type":"item.completed","item":{"id":"item_16","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport aiter, inspect\nnames=['hipb_mm','rocb_mm','gemm_a16w16_asm','gemm_a16w16_opus','getHipblasltKernelName','get_CKGEMM_config']\nfor n in names:\n f=getattr(aiter,n)\n try: sig=inspect.signature(f)\n except Exception as e: sig=f'<{e}>'\n print(n,sig)\n print(getattr(f,'__doc__',None))\nPY\"","aggregated_output":"[aiter] import [module_aiter_core] under /sgl-workspace/aiter/aiter/jit/module_aiter_core.so\nhipb_mm (*args, **kwargs)\nNone\nrocb_mm (*args, **kwargs)\nNone\ngemm_a16w16_asm (A: torch.Tensor, B: torch.Tensor, out: torch.Tensor, bias: torch.Tensor | None = None, splitK: int | None = None, kernelName: str | None = None, bpreshuffle: bool = False)\nNone\ngemm_a16w16_opus (A: torch.Tensor, B: torch.Tensor, bias: torch.Tensor | None = None, dtype: torch.dtype = torch.bfloat16, *, kernelId: int | None = None, splitK: int | None = None, out: torch.Tensor | None = None) -> torch.Tensor\nShape-driven opus a16w16 GEMM.\n\n    Parameters\n    ----------\n    A : [M, K] or [batch, M, K], bf16\n    B : bf16 weight, plain layout (not pre-shuffled). Two accepted shapes:\n        * [N, K]            -- requires batch == 1 (i.e. A is 2D, or A is\n                               3D with leading dim 1).\n        * [batch, N, K]     -- contiguous strides (N*K, K, 1) only.\n                               Broadcast views (e.g. ``B.unsqueeze(0).\n                               expand(batch, -1, -1)``) are rejected\n                               because the opus launcher assumes\n                               ``stride_b_batch == N*K``; pass\n                               ``.contiguous()`` if you need to broadcast\n                               a single-batch weight across A.\n    bias : optional per-output-feature bias (F.linear convention), dtype\n        must equal `dtype` (match_d_out). Accepted shapes:\n        * [N]                  -- broadcast across batch.\n        * [batch, N]           -- per-batch bias vector.\n        bias is consumed by the a16w16 split-barrier (kid 4..9) and the\n        a16w16_flatmm_splitk (kid 200..299) families. CSV-miss requests\n        with bias fall back to the C++ heuristic dispatcher (which only\n        returns bias-aware kids), so any (M, N, K) is supported even\n        without a tuned bias-aware winner -- accuracy is preserved at\n        whatever the heuristic kid achieves; performance may not be\n        optimal until the shape is re-tuned with `--bias`.\n    dtype : output dtype, bf16 or fp32 (any kernel family supports either)\n    kernelId : optional explicit override. When given, bypass CSV / C++\n        dispatch and launch this specific tuned instance via\n        opus_gemm_a16w16_tune.\n    splitK : optional literal KBatch; only honored when kernelId is set.\n    out : optional preallocated [batch, M, N] output; reused instead of\n        allocating a fresh tensor.\n\n    Returns\n    -------\n    Tensor with shape [M, N] when A was 2D, [batch, M, N] when A was 3D.\n    \ngetHipblasltKernelName (*args, **kwargs)\nNone\nget_CKGEMM_config (M: int, N: int, K: int, tuned_file=None)\nNone\n[W805 19:02:49.913378855 AllocatorConfig.cpp:28] Warning: PYTORCH_CUDA_ALLOC_CONF is deprecated, use PYTORCH_ALLOC_CONF instead (function operator())\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_17","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch, aiter\n\ntorch.manual_seed(2); n,k=102400,2048\nw=torch.randn((n,k),device='cuda',dtype=torch.bfloat16)*(k**-0.5)\ndef bench(fn,reps):\n    for _ in range(3): fn()\n    torch.cuda.synchronize(); ss=[torch.cuda.Event(enable_timing=True) for _ in range(reps)]; es=[torch.cuda.Event(enable_timing=True) for _ in range(reps)]\n    for s,e in zip(ss,es): s.record(); fn(); e.record()\n    torch.cuda.synchronize(); v=sorted(s.elapsed_time(e) for s,e in zip(ss,es)); return v[len(v)//2]\nfor m in (128,256,293,691,1024,2048,3011,4096,8192):\n    a=torch.randn((m,k),device='cuda',dtype=torch.bfloat16); out=torch.empty((m,n),device='cuda',dtype=torch.bfloat16)\n    funcs={\n      'torch':lambda:torch.mm(a,w.t(),out=out),\n      'opus':lambda:aiter.gemm_a16w16_opus(a,w,out=out),\n      'asm':lambda:aiter.gemm_a16w16_asm(a,w,out),\n    }\n    print('M',m,flush=True)\n    ref=torch.mm(a,w.t())\n    for name,fn in funcs.items():\n      try:\n        fn(); torch.cuda.synchronize()\n        close=torch.isclose(out,ref,atol=.00782,rtol=.0078125).float().mean().item(); mx=(out-ref).abs().max().item()\n        t=bench(fn,10 if m<2048 else 7)\n        print(' ',name,round(t,4),'match',round(close,7),'max',mx,flush=True)\n      except Exception as e: print(' ',name,'ERROR',repr(e),flush=True)\n    del a,out,ref\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
