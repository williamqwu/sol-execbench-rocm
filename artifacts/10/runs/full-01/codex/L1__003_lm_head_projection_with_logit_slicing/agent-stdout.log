{"type":"item.started","item":{"id":"item_12","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch, triton\nimport kernel\n\ntorch.manual_seed(1)\nm,n,k=4096,102400,2048\na=torch.randn((m,k),device='cuda',dtype=torch.bfloat16)\nw=torch.randn((n,k),device='cuda',dtype=torch.bfloat16)*(k**-0.5)\nout=torch.empty((m,n),device='cuda',dtype=torch.bfloat16)\n\ndef bench(fn,reps=7):\n    for _ in range(2): fn()\n    torch.cuda.synchronize()\n    ss=[torch.cuda.Event(enable_timing=True) for _ in range(reps)]\n    es=[torch.cuda.Event(enable_timing=True) for _ in range(reps)]\n    for s,e in zip(ss,es): s.record(); fn(); e.record()\n    torch.cuda.synchronize()\n    v=sorted(s.elapsed_time(e) for s,e in zip(ss,es))\n    return v[len(v)//2]\n\ndef launch(c):\n    bm,bn,bk,nw,ns,g=c\n    grid=(triton.cdiv(m,bm)*triton.cdiv(n,bn),)\n    kernel._lm_head_kernel[grid](a,w,out,M=m,N=n,K=k,BLOCK_M=bm,BLOCK_N=bn,BLOCK_K=bk,GROUP_M=g,num_warps=nw,num_stages=ns)\n\nconfigs=[\n(32,64,64,4,2,8),(32,128,64,4,2,8),(32,256,64,8,2,8),\n(64,32,64,4,2,8),(64,64,64,4,2,8),(64,64,64,8,2,8),\n(64,128,64,4,2,8),(64,128,64,8,2,8),(64,256,64,8,2,8),\n(128,32,64,4,2,8),(128,64,64,4,2,8),(128,64,64,8,2,8),\n(128,128,64,4,2,8),(128,128,64,8,2,8),(128,256,64,8,2,8),\n(256,32,64,8,2,8),(256,64,64,8,2,8),(256,128,64,8,2,8),\n(64,128,32,8,2,8),(64,128,128,8,2,8),\n(128,128,32,8,2,8),(128,128,128,8,2,8),\n]\nbase=bench(lambda: torch.mm(a,w.t()))\nprint('torch',base,flush=True)\nfor c in configs:\n    try:\n        t=bench(lambda c=c:launch(c))\n        print(c,round(t,4),round(base/t,3),flush=True)\n    except Exception as e:\n        print(c,'ERROR',str(e).splitlines()[-1],flush=True)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
