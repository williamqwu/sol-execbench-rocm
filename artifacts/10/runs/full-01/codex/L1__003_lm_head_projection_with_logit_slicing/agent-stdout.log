{"type":"item.started","item":{"id":"item_26","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch, aiter\naiter.hipb_create_extension()\nm,n,k=128,102400,2048\na=torch.randn((m,k),device='cuda',dtype=torch.bfloat16);w=torch.randn((n,k),device='cuda',dtype=torch.bfloat16)*(k**-0.5);b=w.t();ref=torch.mm(a,b)\nids=[440237,440238,440239,438158,438159,438157,438156,438161,438162,438160,438163,438164,438219,438284,438412,438668,439180,440204,440206,440211,440236]\ndef bench(fn,reps=10):\n for _ in range(2):o=fn()\n torch.cuda.synchronize();ss=[torch.cuda.Event(enable_timing=True) for _ in range(reps)];es=[torch.cuda.Event(enable_timing=True) for _ in range(reps)]\n for s,e in zip(ss,es):s.record();o=fn();e.record()\n torch.cuda.synchronize();v=sorted(s.elapsed_time(e) for s,e in zip(ss,es));return v[len(v)//2],o\nprint('torch',bench(lambda:torch.mm(a,b))[0])\nfor i in ids:\n try:\n  t,o=bench(lambda i=i:aiter.hipb_mm(a,b,i))\n  print(i,round(t,5),float(torch.isclose(o,ref,atol=.00782,rtol=.0078125).float().mean()),float((o-ref).abs().max()))\n except Exception as e:print(i,'ERR',repr(e))\naiter.hipb_destroy_extension()\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
