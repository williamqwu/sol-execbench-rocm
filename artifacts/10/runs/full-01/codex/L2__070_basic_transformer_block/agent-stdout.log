{"type":"item.started","item":{"id":"item_35","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport torch\n\ndef eager(x,w,b,eps):\n m=x.mean(-1,keepdim=True); c=x-m; v=(c**2).mean(-1,keepdim=True); return c/torch.sqrt(v+eps)*w+b\n@torch.compile(fullgraph=True,dynamic=True)\ndef cs(x,m):\n c=x-m\n return c,c*c\n@torch.compile(fullgraph=True,dynamic=True)\ndef finish(c,v,w,b,eps): return c/torch.sqrt(v+eps)*w+b\ndef hybrid(x,w,b,eps):\n m=x.mean(-1,keepdim=True); c,s=cs(x,m); v=s.mean(-1,keepdim=True); return finish(c,v,w,b,eps)\nfor M in [256,2048,8192]:\n x=torch.rand(M,1280,device='cuda')*.2-.1;w=torch.rand(1280,device='cuda')*.2-.1;b=torch.rand(1280,device='cuda')*.2-.1\n a=eager(x,w,b,1e-5);y=hybrid(x,w,b,1e-5);torch.cuda.synchronize();d=(a-y).abs();print(M,d.max().item(),(a==y).float().mean().item())\n for f in [eager,hybrid]:\n  for _ in range(3):f(x,w,b,1e-5)\n  torch.cuda.synchronize();s=torch.cuda.Event(True);e=torch.cuda.Event(True);s.record()\n  for _ in range(100):f(x,w,b,1e-5)\n  e.record();e.synchronize();print(f.__name__,s.elapsed_time(e)/100)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
