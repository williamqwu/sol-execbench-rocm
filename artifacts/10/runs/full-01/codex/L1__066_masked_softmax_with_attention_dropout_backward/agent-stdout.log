{"type":"item.started","item":{"id":"item_20","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch\nimport triton\nimport kernel\nB,H,T=64,8,128\nshape=(B,H,T,T)\ng=torch.empty(shape,device='cuda',dtype=torch.float32)\np=torch.empty(shape,device='cuda',dtype=torch.float32)\nd=torch.empty(shape,device='cuda',dtype=torch.bool)\nm=torch.empty((B,1,T,T),device='cuda',dtype=torch.bool)\no=torch.empty_like(g)\nprint('row',triton.testing.do_bench(lambda: kernel.run(g,p,m,d,0.1),warmup=25,rep=100))\nfor hb,nws in [(2,[1,2,4]),(4,[2,4,8]),(8,[4,8,16])]:\n  for nw in nws:\n    def launch():\n      kernel._masked_softmax_dropout_backward_heads[(H//hb,T,B)](\n        g,p,m,d,o,n_heads=H,seq_len=T,keep_prob=0.9,BLOCK=128,\n        HEAD_BLOCK=hb,WITH_DROPOUT=True,num_warps=nw)\n    try:\n      ms=triton.testing.do_bench(launch,warmup=25,rep=100)\n      print(hb,nw,ms,flush=True)\n    except Exception as e:\n      print(hb,nw,type(e).__name__,str(e)[:120],flush=True)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
