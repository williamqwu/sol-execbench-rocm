{"type":"item.started","item":{"id":"item_27","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport gc\nimport torch\nimport triton\nimport kernel\n\ndef test(B,H,T,drop,nw,waves):\n shape=(B,H,T,T)\n g=torch.empty(shape,device='cuda',dtype=torch.float32);p=torch.empty_like(g)\n d=torch.empty(shape,device='cuda',dtype=torch.bool)\n m=torch.empty((B,1,T,T),device='cuda',dtype=torch.bool);o=torch.empty_like(g)\n block=triton.next_power_of_2(T)\n vals=[]\n for w in waves:\n  def launch(w=w):\n   kernel._masked_softmax_dropout_backward[(B*H*T,)](\n    g,p,m,d,o,n_heads=H,seq_len=T,keep_prob=1-drop,BLOCK=block,\n    WITH_DROPOUT=drop>0,num_warps=nw,waves_per_eu=w)\n  try:\n   ms=triton.testing.do_bench(launch,warmup=30,rep=150)\n   vals.append((w,round(ms,5)))\n  except Exception as e:\n   vals.append((w,type(e).__name__,str(e)[:80]))\n print((B,H,T),vals,flush=True)\n del g,p,d,m,o;gc.collect();torch.cuda.empty_cache()\n\ntest(16,8,2048,.1,8,[1,2,3,4,5,8])\ntest(4,4,4096,.1,16,[1,2,3,4,5,8])\ntest(8,4,613,.1,4,[1,2,3,4,5,8])\ntest(64,8,128,.1,1,[1,2,3,4,5,8])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
