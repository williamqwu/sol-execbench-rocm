{"type":"item.started","item":{"id":"item_8","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport gc\nimport torch\nimport triton\nimport kernel\n\n\ndef bench_shape(B, H, T, warps):\n    shape = (B, H, T, T)\n    g = torch.empty(shape, device='cuda', dtype=torch.float32)\n    p = torch.empty(shape, device='cuda', dtype=torch.float32)\n    d = torch.empty(shape, device='cuda', dtype=torch.bool)\n    m = torch.empty((B, 1, T, T), device='cuda', dtype=torch.bool)\n    o = torch.empty_like(g)\n    block = triton.next_power_of_2(T)\n    def launch(nw):\n        kernel._masked_softmax_dropout_backward[(B*H*T,)](\n            g, p, m, d, o,\n            n_heads=H, seq_len=T, keep_prob=0.9,\n            BLOCK=block, WITH_DROPOUT=True, num_warps=nw)\n    results = []\n    for nw in warps:\n        try:\n            ms = triton.testing.do_bench(lambda nw=nw: launch(nw), warmup=30, rep=100)\n            results.append((nw, round(ms, 5)))\n        except Exception as exc:\n            results.append((nw, type(exc).__name__))\n    print((B,H,T), results, flush=True)\n    del g,p,d,m,o\n    gc.collect()\n    torch.cuda.empty_cache()\n\nfor args in [\n    (64,8,128,[1,2,4,8]),\n    (32,8,256,[1,2,4,8]),\n    (4,8,512,[1,2,4,8]),\n    (8,4,613,[1,2,4,8]),\n    (1,16,919,[1,2,4,8]),\n    (16,8,2048,[2,4,8,16]),\n    (4,4,4096,[4,8,16]),\n]:\n    bench_shape(*args)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
