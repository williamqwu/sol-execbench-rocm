{"type":"item.started","item":{"id":"item_21","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch, triton, kernel\nATOL=0.00778; RTOL=0.0078125\n\ndef launch(kind,rows,h,r,w,o,warps=8,waves=1):\n fn = kernel._fused_add_rmsnorm_kernel if kind=='fp32' else kernel._fused_add_rmsnorm_fp16x_kernel\n fn[(rows,)](h,r,w,o,BLOCK_SIZE=8192,num_warps=warps,waves_per_eu=waves)\n\ndef test(rows):\n torch.manual_seed(9817+rows)\n h=torch.randn((rows,7168),device='cuda',dtype=torch.bfloat16)\n r=torch.randn_like(h); w=torch.randn(7168,device='cuda',dtype=torch.bfloat16); o=torch.empty_like(h)\n x=h.float()+r.float(); ref=((x*torch.rsqrt(x.square().mean(-1,keepdim=True)+1e-6))*w.float()).bfloat16()\n for kind in ('fp32','fp16'):\n  for waves in (1,4):\n   fn=lambda:launch(kind,rows,h,r,w,o,8,waves)\n   fn();torch.cuda.synchronize()\n   d=(o.float()-ref.float()).abs(); close=torch.isclose(o.float(),ref.float(),atol=ATOL,rtol=RTOL)\n   ms=triton.testing.do_bench(fn,warmup=25,rep=100)\n   print(f'rows={rows:5} {kind} e={waves} ms={ms:.6f} max={d.max().item():.6g} ratio={close.float().mean().item():.8f}')\n del h,r,w,o,x,ref,d,close\n\nfor rows in (1,7,64,539,11949,14521):test(rows)\n\nh=torch.zeros((1,7168),device='cuda',dtype=torch.bfloat16);o=torch.empty_like(h);w=torch.ones(7168,device='cuda',dtype=torch.bfloat16)\nfor name,fn in (('fp32',kernel._fused_add_rmsnorm_kernel),('fp16',kernel._fused_add_rmsnorm_fp16x_kernel)):\n k=fn.warmup(h,h,w,o,BLOCK_SIZE=8192,num_warps=8,waves_per_eu=1,grid=(1,));print(name)\n for line in k.asm['amdgcn'].splitlines():\n  if any(s in line for s in ('NumVgprs:','ScratchSize:','Occupancy:')):print(line)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
