{"type":"item.started","item":{"id":"item_17","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch, triton, kernel\n\ndef test(rows):\n h=torch.randn((rows,7168),device='cuda',dtype=torch.bfloat16)\n r=torch.randn_like(h); w=torch.randn(7168,device='cuda',dtype=torch.bfloat16); o=torch.empty_like(h)\n x=h.float()+r.float(); ref=((x*torch.rsqrt(x.square().mean(-1,keepdim=True)+1e-6))*w.float()).bfloat16()\n for name, fn, warps, waves in (\n   ('padded',kernel._fused_add_rmsnorm_kernel,8,1),\n   ('exact',kernel._fused_add_rmsnorm_exact_kernel,8,1),\n   ('exact',kernel._fused_add_rmsnorm_exact_kernel,8,2),\n   ('exact',kernel._fused_add_rmsnorm_exact_kernel,8,4),\n   ('exact',kernel._fused_add_rmsnorm_exact_kernel,4,2),\n   ('exact',kernel._fused_add_rmsnorm_exact_kernel,4,4)):\n  if name=='padded': launch=lambda: fn[(rows,)](h,r,w,o,BLOCK_SIZE=8192,num_warps=warps,waves_per_eu=waves)\n  else: launch=lambda: fn[(rows,)](h,r,w,o,num_warps=warps,waves_per_eu=waves)\n  try:\n   launch(); torch.cuda.synchronize()\n   err=(o.float()-ref.float()).abs().max().item()\n   ms=triton.testing.do_bench(launch,warmup=25,rep=100)\n   print(f'rows={rows:5} {name:6} w={warps} e={waves} ms={ms:.6f} err={err}')\n  except Exception as e: print('ERROR',rows,name,warps,waves,repr(e))\n del h,r,w,o,x,ref\n\nfor rows in (1,7,64,539,14521): test(rows)\n\nh=torch.zeros((1,7168),device='cuda',dtype=torch.bfloat16); o=torch.empty_like(h); w=torch.ones(7168,device='cuda',dtype=torch.bfloat16)\nfor name, fn, kwargs in (\n ('padded',kernel._fused_add_rmsnorm_kernel,dict(BLOCK_SIZE=8192,num_warps=8,waves_per_eu=1)),\n ('exact',kernel._fused_add_rmsnorm_exact_kernel,dict(num_warps=8,waves_per_eu=1))):\n k=fn.warmup(h,h,w,o,grid=(1,),**kwargs); a=k.asm['amdgcn']\n print(name)\n for line in a.splitlines():\n  if any(s in line for s in ('NumVgprs:', 'ScratchSize:', 'Occupancy:')): print(line)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
