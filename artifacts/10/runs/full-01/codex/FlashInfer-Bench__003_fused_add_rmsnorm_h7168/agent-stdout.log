{"type":"item.started","item":{"id":"item_47","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch,triton,kernel,random\ncands=[('w4d',4,0),('w4e4',4,4),('w8d',8,0),('w8e1',8,1),('w2e2',2,2)]\nfor rows in (539,11949,14521):\n h=torch.randn((rows,7168),device='cuda',dtype=torch.bfloat16);r=torch.randn_like(h);w=torch.randn(7168,device='cuda',dtype=torch.bfloat16);o=torch.empty_like(h);sm=2 if rows>1024 else 3\n print('ROWS',rows)\n vals={n:[] for n,_,_ in cands}\n for rnd in range(5):\n  order=cands[:];random.Random(100+rnd).shuffle(order)\n  for name,nw,we in order:\n   kw=dict(BLOCK_SIZE=8192,FP16_X=False,LOAD_MODE=0,WEIGHT_MODE=0,STORE_MODE=sm,num_warps=nw)\n   if we:kw['waves_per_eu']=we\n   fn=lambda kw=kw:kernel._fused_add_rmsnorm_cache_kernel[(rows,)](h,r,w,o,**kw)\n   ms=triton.testing.do_bench(fn,warmup=50,rep=300);vals[name].append(ms)\n for name in vals:print(name,' '.join(f'{v:.6f}' for v in vals[name]),'avg',sum(vals[name])/len(vals[name]))\n del h,r,w,o\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
