{"type":"item.started","item":{"id":"item_22","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch\n\ndef old(qkv):\n bf,s,_,hh=qkv.shape; h=16; d=64\n q,k,v=(z.squeeze(2) for z in qkv.chunk(3,2))\n q=q.view(bf,s,h,d).transpose(1,2); k=k.view(bf,s,h,d).transpose(1,2); v=v.view(bf,s,h,d).transpose(1,2)\n p=torch.softmax((q@k.transpose(-2,-1))*.125,-1)\n return (p@v).transpose(1,2).contiguous()\ndef new(qkv):\n bf,s,_,hh=qkv.shape; h=16; d=64\n z=qkv.view(bf,s,3,h,d).permute(2,0,3,1,4).contiguous()\n q,k,v=z.unbind(0)\n p=torch.softmax((q@k.transpose(-2,-1))*.125,-1)\n return (p@v).transpose(1,2).contiguous()\ndef bench(fn,x,n=10):\n for _ in range(3): fn(x)\n torch.cuda.synchronize(); a=torch.cuda.Event(True); b=torch.cuda.Event(True); a.record()\n for _ in range(n): fn(x)\n b.record(); b.synchronize(); return a.elapsed_time(b)/n\nfor bf,s in [(256,64),(32,512),(8,1024),(1,2048),(64,256)]:\n x=torch.randn((bf,s,3,1024),device='cuda')*.05\n a=old(x); b=new(x); torch.cuda.synchronize()\n print((bf,s),'equal',torch.equal(a,b),'max',(a-b).abs().max().item(),'old',bench(old,x,5),'new',bench(new,x,5))\n del x,a,b\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
