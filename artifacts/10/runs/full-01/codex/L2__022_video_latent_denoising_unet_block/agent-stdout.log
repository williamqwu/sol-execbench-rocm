{"type":"item.started","item":{"id":"item_9","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport math, time, torch\nimport torch.nn.functional as F\nprint('torch', torch.__version__, 'hip', torch.version.hip, 'device', torch.cuda.get_device_name(0))\nfor shape in [(4096,16,4,64),(32,16,512,64),(1,16,2048,64),(1,16,16384,64)]:\n    b,h,n,d=shape\n    q=torch.randn(shape,device='cuda',dtype=torch.float32)*0.1\n    k=torch.randn(shape,device='cuda',dtype=torch.float32)*0.1\n    v=torch.randn(shape,device='cuda',dtype=torch.float32)*0.1\n    scale=1/math.sqrt(d)\n    def explicit():\n        return torch.softmax(torch.matmul(q,k.transpose(-2,-1))*scale,dim=-1)@v\n    def sdpa():\n        return F.scaled_dot_product_attention(q,k,v,scale=scale)\n    a=explicit(); z=sdpa(); torch.cuda.synchronize()\n    diff=(a-z).abs()\n    ratio=((diff<=3.8e-7+1.1920928955078125e-7*z.abs())).float().mean().item()\n    def bench(fn):\n        for _ in range(3): fn()\n        torch.cuda.synchronize(); s=torch.cuda.Event(True); e=torch.cuda.Event(True); s.record()\n        for _ in range(10): fn()\n        e.record(); e.synchronize(); return s.elapsed_time(e)/10\n    print(shape,'max',diff.max().item(),'mean',diff.mean().item(),'match',ratio,'explicit_ms',bench(explicit),'sdpa_ms',bench(sdpa))\n    del q,k,v,a,z,diff\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
