{"type":"item.started","item":{"id":"item_20","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch\n\ndef bench(fn,n=20):\n for _ in range(3): fn()\n torch.cuda.synchronize(); s=torch.cuda.Event(True); e=torch.cuda.Event(True); s.record()\n for _ in range(n): fn()\n e.record(); e.synchronize(); return s.elapsed_time(e)/n\nfor bs,n in [(32,512),(8,1024),(1,2048),(4096,4)]:\n h,d=16,64\n p=torch.softmax(torch.randn((bs,h,n,n),device='cuda')*.125,-1)\n v=torch.randn((bs,h,n,d),device='cuda')\n def old(): return (p@v).transpose(1,2).contiguous()\n dest=torch.empty((bs,n,h,d),device='cuda')\n def direct():\n  torch.matmul(p,v,out=dest.transpose(1,2))\n  return dest\n a=old(); z=direct(); torch.cuda.synchronize()\n print((bs,n),'equal',torch.equal(a,z),'max',(a-z).abs().max().item(),'old',bench(old,5),'out',bench(direct,5))\n del p,v,a,z,dest\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
