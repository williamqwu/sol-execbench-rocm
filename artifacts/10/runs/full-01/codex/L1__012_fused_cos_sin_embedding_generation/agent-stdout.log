{"type":"item.started","item":{"id":"item_8","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch\nimport triton\nimport kernel\n\nconfigs = [(64,1),(128,2),(256,4),(512,4),(512,8),(1024,4),(1024,8),(2048,8),(4096,8)]\nfor b,s in [(1,512),(16,512),(64,541)]:\n    x = torch.randn((b,s,64), device='cuda', dtype=torch.float32)\n    n = x.numel()\n    print('shape', (b,s), 'n', n)\n    for block, warps in configs:\n        def fn():\n            co = torch.empty((*x.shape[:-1],128), device=x.device, dtype=torch.bfloat16)\n            si = torch.empty_like(co)\n            kernel._cos_sin_kernel[(triton.cdiv(n, block),)](\n                x, co, si, n, 1.0, BLOCK_SIZE=block, num_warps=warps)\n            return co, si\n        try:\n            us = triton.testing.do_bench(fn, warmup=50, rep=200) * 1000\n            print(f'  B{block:4} W{warps}: {us:7.3f} us')\n        except Exception as exc:\n            print(f'  B{block:4} W{warps}: ERROR {type(exc).__name__}: {exc}')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
