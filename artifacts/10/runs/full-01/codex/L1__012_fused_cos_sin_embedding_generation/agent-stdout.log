{"type":"item.started","item":{"id":"item_21","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch\nimport triton\nimport kernel\n\ndef packed_run(x, block):\n    n=x.numel()\n    buf=torch.empty((*x.shape[:-1],128),device=x.device,dtype=torch.int32)\n    kernel._cos_sin_packed_kernel[(triton.cdiv(n,block),)](x,buf,n,1.0,BLOCK_SIZE=block,num_warps=4)\n    pairs=buf.view(torch.bfloat16).view(*x.shape[:-1],128,2)\n    return pairs[...,0],pairs[...,1]\nfor b,s in [(2,691),(16,512),(64,541)]:\n    x=torch.randn((b,s,64),device='cuda')\n    block=1024 if x.numel()>1000000 else 256\n    co,si=packed_run(x,block)\n    ref=torch.cat((x,x),dim=-1)\n    rc=ref.cos().to(torch.bfloat16); rs=ref.sin().to(torch.bfloat16)\n    torch.cuda.synchronize()\n    print((b,s),'strides',co.stride(), 'equal',torch.equal(co,rc),torch.equal(si,rs),\n          'max', (co.float()-rc.float()).abs().max().item(),(si.float()-rs.float()).abs().max().item())\n    us=triton.testing.do_bench(lambda: packed_run(x,block),warmup=100,rep=500)*1000\n    print('  packed',f'{us:.3f} us')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
