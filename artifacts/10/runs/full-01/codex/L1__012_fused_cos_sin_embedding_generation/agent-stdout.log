{"type":"item.started","item":{"id":"item_14","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch\nimport triton\nimport kernel\nfor b,s in [(1,512),(16,512),(64,541)]:\n    x=torch.randn((b,s,64),device='cuda')\n    n=x.numel(); block=1024 if n>1000000 else 256\n    def separate():\n        co=torch.empty((*x.shape[:-1],128),device='cuda',dtype=torch.bfloat16)\n        si=torch.empty_like(co)\n        kernel._cos_sin_kernel[(triton.cdiv(n,block),)](x,co,si,n,1.0,BLOCK_SIZE=block,num_warps=4)\n        return co,si\n    def combined():\n        both=torch.empty((2,*x.shape[:-1],128),device='cuda',dtype=torch.bfloat16)\n        co=both[0]; si=both[1]\n        kernel._cos_sin_kernel[(triton.cdiv(n,block),)](x,co,si,n,1.0,BLOCK_SIZE=block,num_warps=4)\n        return co,si\n    a=triton.testing.do_bench(separate,warmup=100,rep=500)*1000\n    c=triton.testing.do_bench(combined,warmup=100,rep=500)*1000\n    print((b,s),f'separate {a:.3f} us combined {c:.3f} us')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
