{"type":"item.started","item":{"id":"item_66","type":"command_execution","command":"/bin/bash -lc \"PYTORCH_ROCM_ARCH=gfx950 python - <<'PY'\nimport torch,triton,kernel\nfrom torch.utils.cpp_extension import load\nm=load(name='hip_test_kernel',sources=['binding.cpp','kernel.hip'],build_directory='hip_build',extra_cuda_cflags=['-O3'],extra_cflags=['-O3'],verbose=False)\nfor b in (1,6,34,64,79,12383,16254):\n torch.manual_seed(100+b)\n h=torch.randn((b,2048),device='cuda',dtype=torch.bfloat16);r=torch.randn_like(h);w=torch.randn(2048,device='cuda',dtype=torch.bfloat16)\n ref=((h.float()+r.float())*torch.rsqrt((h.float()+r.float()).square().mean(-1,keepdim=True)+1e-6)*w.float()).bfloat16()\n out=m.run(h,r,w);torch.cuda.synchronize();d=(out.float()-ref.float()).abs();rel=d/ref.float().abs().clamp_min(1e-20);ratio=((d<=.0081)|(rel<=.0078125)).float().mean()\n ht=triton.testing.do_bench(lambda:m.run(h,r,w),warmup=100,rep=300)\n tt=triton.testing.do_bench(lambda:kernel.run(h,r,w),warmup=100,rep=300)\n print(b,'err',float(d.max()),float(rel.max()),float(ratio),'hip',f'{ht:.6f}','triton',f'{tt:.6f}')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
