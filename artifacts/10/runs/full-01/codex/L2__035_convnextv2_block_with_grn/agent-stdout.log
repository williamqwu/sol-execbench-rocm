{"type":"item.started","item":{"id":"item_12","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport torch\nimport torch.nn.functional as F\n\ntorch.manual_seed(1)\ntorch.cuda.set_device(0)\nfor B,C,H,W in [(2,96,56,56),(8,768,7,7),(1,160,449,7)]:\n    x=torch.randn(B,C,H,W,device='cuda')\n    w=torch.randn(C,1,7,7,device='cuda')\n    b=torch.randn(C,device='cuda')\n    a=F.conv2d(x,w,b,padding=3,groups=C)\n    q=F.conv2d(x.contiguous(memory_format=torch.channels_last),w,b,padding=3,groups=C)\n    d=(a-q).abs()\n    print((B,C,H,W), 'conv max',d.max().item(),'exact', (d==0).float().mean().item(), 'le2e-7', (d<=2.4e-7).float().mean().item(), 'q_chlast',q.is_contiguous(memory_format=torch.channels_last))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
