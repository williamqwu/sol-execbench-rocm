{"type":"item.started","item":{"id":"item_16","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport torch, triton\nimport torch.nn.functional as F\n\ndef eager(a):\n x,dw,db,lw,lb,w1,b1,gw,gb,w2,b2=a; C=x.shape[1]\n o=F.conv2d(x,dw,db,padding=3,groups=C).permute(0,2,3,1)\n o=F.layer_norm(o,(C,),lw,lb,eps=1e-6)\n o=torch.matmul(o,w1.T)+b1; o=F.gelu(o)\n g=torch.linalg.vector_norm(o,ord=2,dim=(1,2),keepdim=True); n=g/(g.mean(-1,keepdim=True)+1e-6)\n o=gw*(o*n)+gb+o\n o=torch.matmul(o,w2.T)+b2\n return x+o.permute(0,3,1,2)\ndef linear(a):\n x,dw,db,lw,lb,w1,b1,gw,gb,w2,b2=a; C=x.shape[1]\n o=F.conv2d(x,dw,db,padding=3,groups=C).permute(0,2,3,1)\n o=F.layer_norm(o,(C,),lw,lb,eps=1e-6)\n o=F.linear(o,w1,b1); o=F.gelu(o)\n g=torch.linalg.vector_norm(o,ord=2,dim=(1,2),keepdim=True); n=g/(g.mean(-1,keepdim=True)+1e-6)\n o=gw*(o*n)+gb+o\n o=F.linear(o,w2,b2)\n return x+o.permute(0,3,1,2)\n\ntorch.manual_seed(5)\nfor B,C,H,W in [(1,96,56,56),(8,768,7,7),(8,320,32,32),(64,96,112,112)]:\n E=4*C; mk=lambda *s: torch.rand(*s,device='cuda')*.1\n a=(mk(B,C,H,W),mk(C,1,7,7),mk(C),mk(C),mk(C),mk(E,C),mk(E),mk(1,1,1,E),mk(1,1,1,E),mk(C,E),mk(C))\n eager(a); linear(a); torch.cuda.synchronize()\n te=triton.testing.do_bench(lambda:eager(a),warmup=20,rep=50)\n tl=triton.testing.do_bench(lambda:linear(a),warmup=20,rep=50)\n d=(eager(a)-linear(a)).abs().max().item()\n print((B,C,H,W),'eager',te,'linear',tl,'speed',te/tl,'diff',d)\n del a\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
