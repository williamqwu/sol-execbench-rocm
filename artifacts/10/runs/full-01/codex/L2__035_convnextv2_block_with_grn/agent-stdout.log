{"type":"item.started","item":{"id":"item_13","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport torch\nimport torch.nn.functional as F\n\ntorch.manual_seed(2); dev='cuda'\nfor B,C,H,W in [(1,96,56,56),(2,768,7,7),(1,192,28,28)]:\n E=4*C\n x=torch.randn(B,C,H,W,device=dev); dw=torch.randn(C,1,7,7,device=dev); db=torch.randn(C,device=dev)\n lw=torch.randn(C,device=dev); lb=torch.randn(C,device=dev); w1=torch.randn(E,C,device=dev); b1=torch.randn(E,device=dev); gw=torch.randn(1,1,1,E,device=dev); gb=torch.randn(1,1,1,E,device=dev); w2=torch.randn(C,E,device=dev); b2=torch.randn(C,device=dev)\n o=F.conv2d(x,dw,db,padding=3,groups=C).permute(0,2,3,1); o=F.layer_norm(o,(C,),lw,lb,eps=1e-6)\n z0=torch.matmul(o,w1.T)+b1; z1=F.linear(o,w1,b1)\n d=(z0-z1).abs(); print((B,C,H,W),'linear1 max/exact/tol',d.max().item(),(d==0).float().mean().item(),(d<=2.4e-7+1.2e-7*z0.abs()).float().mean().item())\n def tail(z):\n  z=F.gelu(z); g=torch.linalg.vector_norm(z,ord=2,dim=(1,2),keepdim=True); n=g/(g.mean(dim=-1,keepdim=True)+1e-6); z=gw*(z*n)+gb+z; return torch.matmul(z,w2.T)+b2\n def tail_lin(z):\n  z=F.gelu(z); g=torch.linalg.vector_norm(z,ord=2,dim=(1,2),keepdim=True); n=g/(g.mean(dim=-1,keepdim=True)+1e-6); z=gw*(z*n)+gb+z; return F.linear(z,w2,b2)\n y0=x+tail(z0).permute(0,3,1,2); y1=x+tail_lin(z1).permute(0,3,1,2)\n d=(y0-y1).abs(); print(' full max/exact/tol',d.max().item(),(d==0).float().mean().item(),(d<=2.4e-7+1.2e-7*y0.abs()).float().mean().item())\n del x,dw,db,lw,lb,w1,b1,gw,gb,w2,b2,o,z0,z1,y0,y1\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
