{"type":"item.started","item":{"id":"item_18","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport torch, reference\n\ndef eager(q,k,c,s):\n qr=q*c+torch.cat((-q[...,32:],q[...,:32]),-1)*s\n kr=k*c+torch.cat((-k[...,32:],k[...,:32]),-1)*s\n return qr,kr\n\n@torch.compile(fullgraph=True)\ndef comp(q,k,c,s):\n qr=q*c+torch.cat((-q[...,32:],q[...,:32]),-1)*s\n kr=k*c+torch.cat((-k[...,32:],k[...,:32]),-1)*s\n return qr,kr\n\nfor B,S in [(1,131),(4,256),(1,541)]:\n x=reference.get_inputs({'batch_size':B,'seq_len':S},torch.device('cuda'))\n h,p,qw,kw,vw,ow,inv,causal=x.values()\n q=(h@qw.t()).view(B,S,16,64).transpose(1,2);k=(h@kw.t()).view(B,S,4,64).transpose(1,2)\n f=torch.matmul(inv[None,:,None].expand(B,-1,1),p[:,None,:].float()).transpose(1,2);e=torch.cat((f,f),-1);c=e.cos().unsqueeze(1);si=e.sin().unsqueeze(1)\n a=eager(q,k,c,si); z=comp(q,k,c,si)\n for u,v in zip(a,z): print((B,S),(u-v).abs().max().item(),torch.eq(u,v).float().mean().item())\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
