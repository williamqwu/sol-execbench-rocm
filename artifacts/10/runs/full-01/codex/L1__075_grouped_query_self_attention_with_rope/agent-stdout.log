{"type":"item.started","item":{"id":"item_9","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport torch\nimport reference\n\ntorch.manual_seed(123)\ndevice='cuda'\n\ndef inputs(b,s):\n    return reference.get_inputs({'batch_size':b,'seq_len':s}, torch.device(device))\n\n@torch.no_grad()\ndef alt(hidden_states, position_ids, qw, kw, vw, ow, inv, causal):\n    B,S,_=hidden_states.shape\n    q=torch.matmul(hidden_states,qw.t()).view(B,S,16,64).transpose(1,2)\n    k=torch.matmul(hidden_states,kw.t()).view(B,S,4,64).transpose(1,2)\n    v=torch.matmul(hidden_states,vw.t()).view(B,S,4,64).transpose(1,2)\n    f=(inv[None,:,None] * position_ids[:,None,:].float()).transpose(1,2)\n    c=f.cos().unsqueeze(1); si=f.sin().unsqueeze(1)\n    q1,q2=q[...,:32],q[...,32:]\n    k1,k2=k[...,:32],k[...,32:]\n    q=torch.cat((q1*c+(-q2)*si,q2*c+q1*si),-1)\n    k=torch.cat((k1*c+(-k2)*si,k2*c+k1*si),-1)\n    q=q.view(B,4,4,S,64)\n    w=torch.matmul(q,k.unsqueeze(2).transpose(-2,-1))\n    if causal:\n        mask=torch.triu(torch.ones(S,S,device=hidden_states.device,dtype=torch.bool),1)\n        w=w.masked_fill(mask,float('-inf'))\n    w=torch.softmax(w,dim=-1,dtype=torch.float32)\n    a=torch.matmul(w,v.unsqueeze(2)).view(B,16,S,64)\n    a=a.transpose(1,2).contiguous().view(B,S,1024)\n    a=torch.matmul(a,ow.t())\n    return a,w.view(B,16,S,S)\n\nfor b,s in [(1,131),(4,128),(2,211),(1,541)]:\n    x=inputs(b,s)\n    a=reference.run(**x)\n    z=alt(*x.values())\n    for name,aa,zz in zip(('out','weights'),a,z):\n        d=(aa-zz).abs()\n        ratio=((d <= 2e-8 + 1.1920928955078125e-7*aa.abs())).float().mean()\n        print(b,s,name,'max',d.max().item(),'equal',torch.eq(aa,zz).float().mean().item(),'match',ratio.item())\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
