{"type":"item.started","item":{"id":"item_29","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport gc, statistics, torch, reference, kernel\n\ntorch.manual_seed(29)\nfor B,S in [(1,131),(4,256),(1,541),(2,1024),(1,2048)]:\n    x=reference.get_inputs({'batch_size':B,'seq_len':S},torch.device('cuda'))\n    a=reference.run(**x); z=kernel.run(*x.values())\n    stats=[]\n    for u,v in zip(a,z):\n        d=(u-v).abs(); stats.append((d.max().item(),torch.eq(u,v).float().mean().item()))\n    del a,z; torch.cuda.empty_cache()\n    def bench(fn,isref):\n        for _ in range(3): fn(**x) if isref else fn(*x.values())\n        torch.cuda.synchronize(); vals=[]\n        for _ in range(11):\n            st=torch.cuda.Event(enable_timing=True); en=torch.cuda.Event(enable_timing=True)\n            st.record(); y=fn(**x) if isref else fn(*x.values()); en.record(); en.synchronize(); vals.append(st.elapsed_time(en))\n        return statistics.median(vals)\n    tr=bench(reference.run,True); tk=bench(kernel.run,False)\n    print((B,S),'diff',stats,'ms ref/cand',round(tr,3),round(tk,3),'speedup',round(tr/tk,3))\n    del x; gc.collect(); torch.cuda.empty_cache()\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
