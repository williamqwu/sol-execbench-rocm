{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' definition.json && printf '\\\\n--- reference.py ---\\\\n' && sed -n '1,320p' reference.py && printf '\\\\n--- workload.jsonl ---\\\\n' && sed -n '1,240p' workload.jsonl\"","aggregated_output":"{\n  \"name\": \"075_grouped_query_self_attention_with_rope\",\n  \"description\": \"Grouped Query Self-Attention with integrated RoPE position embeddings. Supports both encoder (non-causal, 16 heads, 4 KV heads) and decoder (causal, 24 heads, 8 KV heads) configurations. Fuses Q/K/V projections, RoPE application, GQA computation, and output projection.\",\n  \"hf_id\": \"nvidia/parakeet-tdt-0.6b-v3\",\n  \"custom_inputs_entrypoint\": \"get_inputs\",\n  \"axes\": {\n    \"batch_size\": {\n      \"type\": \"var\"\n    },\n    \"seq_len\": {\n      \"type\": \"var\"\n    },\n    \"hidden_size\": {\n      \"type\": \"const\",\n      \"value\": 1024\n    },\n    \"num_heads\": {\n      \"type\": \"const\",\n      \"value\": 16\n    },\n    \"num_key_value_heads\": {\n      \"type\": \"const\",\n      \"value\": 4\n    },\n    \"head_dim\": {\n      \"type\": \"const\",\n      \"value\": 64\n    },\n    \"num_key_value_groups\": {\n      \"type\": \"expr\",\n      \"expression\": \"num_heads // num_key_value_heads\"\n    },\n    \"q_proj_size\": {\n      \"type\": \"expr\",\n      \"expression\": \"num_heads * head_dim\"\n    },\n    \"kv_proj_size\": {\n      \"type\": \"expr\",\n      \"expression\": \"num_key_value_heads * head_dim\"\n    }\n  },\n  \"inputs\": {\n    \"hidden_states\": {\n      \"shape\": [\n        \"batch_size\",\n        \"seq_len\",\n        \"hidden_size\"\n      ],\n      \"dtype\": \"float32\",\n      \"description\": \"Input hidden states\"\n    },\n    \"position_ids\": {\n      \"shape\": [\n        \"batch_size\",\n        \"seq_len\"\n      ],\n      \"dtype\": \"int64\",\n      \"description\": \"Position indices for RoPE\"\n    },\n    \"q_proj_weight\": {\n      \"shape\": [\n        \"q_proj_size\",\n        \"hidden_size\"\n      ],\n      \"dtype\": \"float32\",\n      \"description\": \"Query projection weight\"\n    },\n    \"k_proj_weight\": {\n      \"shape\": [\n        \"kv_proj_size\",\n        \"hidden_size\"\n      ],\n      \"dtype\": \"float32\",\n      \"description\": \"Key projection weight\"\n    },\n    \"v_proj_weight\": {\n      \"shape\": [\n        \"kv_proj_size\",\n        \"hidden_size\"\n      ],\n      \"dtype\": \"float32\",\n      \"description\": \"Value projection weight\"\n    },\n    \"o_proj_weight\": {\n      \"shape\": [\n        \"hidden_size\",\n        \"q_proj_size\"\n      ],\n      \"dtype\": \"float32\",\n      \"description\": \"Output projection weight\"\n    },\n    \"inv_freq\": {\n      \"shape\": [\n        \"32\"\n      ],\n      \"dtype\": \"float32\",\n      \"description\": \"RoPE inverse frequencies (head_dim // 2 = 32)\"\n    },\n    \"is_causal\": {\n      \"shape\": null,\n      \"dtype\": \"bool\",\n      \"description\": \"Whether to apply causal masking\"\n    }\n  },\n  \"outputs\": {\n    \"attn_output\": {\n      \"shape\": [\n        \"batch_size\",\n        \"seq_len\",\n        \"hidden_size\"\n      ],\n      \"dtype\": \"float32\",\n      \"description\": \"Attention output\"\n    },\n    \"attn_weights\": {\n      \"shape\": [\n        \"batch_size\",\n        \"num_heads\",\n        \"seq_len\",\n        \"seq_len\"\n      ],\n      \"dtype\": \"float32\",\n      \"description\": \"Attention weights\"\n    }\n  },\n  \"reference\": \"import torch\\nimport math\\n\\ndef get_inputs(axes_and_scalars: dict, device: torch.device) -> dict:\\n    batch_size = axes_and_scalars['batch_size']\\n    seq_len = axes_and_scalars['seq_len']\\n    hidden_size = 1024\\n    num_heads = 16\\n    num_key_value_heads = 4\\n    head_dim = 64\\n    rope_theta = 10000.0\\n    \\n    q_proj_size = num_heads * head_dim\\n    kv_proj_size = num_key_value_heads * head_dim\\n    \\n    hidden_states = torch.randn(batch_size, seq_len, hidden_size, device=device, dtype=torch.float32)\\n    position_ids = torch.arange(seq_len, device=device, dtype=torch.int64).unsqueeze(0).expand(batch_size, -1)\\n    \\n    q_proj_weight = torch.randn(q_proj_size, hidden_size, device=device, dtype=torch.float32) * 0.02\\n    k_proj_weight = torch.randn(kv_proj_size, hidden_size, device=device, dtype=torch.float32) * 0.02\\n    v_proj_weight = torch.randn(kv_proj_size, hidden_size, device=device, dtype=torch.float32) * 0.02\\n    o_proj_weight = torch.randn(hidden_size, q_proj_size, device=device, dtype=torch.float32) * 0.02\\n    \\n    inv_freq = 1.0 / (rope_theta ** (torch.arange(0, head_dim, 2, dtype=torch.float32, device=device) / head_dim))\\n    \\n    is_causal = False\\n    \\n    return {\\n        'hidden_states': hidden_states,\\n        'position_ids': position_ids,\\n        'q_proj_weight': q_proj_weight,\\n        'k_proj_weight': k_proj_weight,\\n        'v_proj_weight': v_proj_weight,\\n        'o_proj_weight': o_proj_weight,\\n        'inv_freq': inv_freq,\\n        'is_causal': is_causal\\n    }\\n\\n@torch.no_grad()\\ndef run(\\n    hidden_states: torch.Tensor,\\n    position_ids: torch.Tensor,\\n    q_proj_weight: torch.Tensor,\\n    k_proj_weight: torch.Tensor,\\n    v_proj_weight: torch.Tensor,\\n    o_proj_weight: torch.Tensor,\\n    inv_freq: torch.Tensor,\\n    is_causal: bool\\n):\\n    batch_size, seq_len, hidden_size = hidden_states.shape\\n    num_heads = 16\\n    num_key_value_heads = 4\\n    head_dim = 64\\n    num_key_value_groups = num_heads // num_key_value_heads\\n    scaling = 1.0\\n    \\n    # Q/K/V projections\\n    query_states = torch.matmul(hidden_states, q_proj_weight.t())\\n    key_states = torch.matmul(hidden_states, k_proj_weight.t())\\n    value_states = torch.matmul(hidden_states, v_proj_weight.t())\\n    \\n    # Reshape to [batch, seq, heads, head_dim] then transpose to [batch, heads, seq, head_dim]\\n    query_states = query_states.view(batch_size, seq_len, num_heads, head_dim).transpose(1, 2)\\n    key_states = key_states.view(batch_size, seq_len, num_key_value_heads, head_dim).transpose(1, 2)\\n    value_states = value_states.view(batch_size, seq_len, num_key_value_heads, head_dim).transpose(1, 2)\\n    \\n    # Compute RoPE embeddings\\n    inv_freq_expanded = inv_freq[None, :, None].float().expand(batch_size, -1, 1)\\n    position_ids_expanded = position_ids[:, None, :].float()\\n    freqs = torch.matmul(inv_freq_expanded, position_ids_expanded).transpose(1, 2)\\n    emb = torch.cat((freqs, freqs), dim=-1)\\n    cos = emb.cos() * scaling\\n    sin = emb.sin() * scaling\\n    \\n    # Apply RoPE\\n    cos = cos.unsqueeze(1)\\n    sin = sin.unsqueeze(1)\\n    \\n    q_half1 = query_states[..., :head_dim // 2]\\n    q_half2 = query_states[..., head_dim // 2:]\\n    q_rotated = torch.cat((-q_half2, q_half1), dim=-1)\\n    query_states = (query_states * cos) + (q_rotated * sin)\\n    \\n    k_half1 = key_states[..., :head_dim // 2]\\n    k_half2 = key_states[..., head_dim // 2:]\\n    k_rotated = torch.cat((-k_half2, k_half1), dim=-1)\\n    key_states = (key_states * cos) + (k_rotated * sin)\\n    \\n    # Repeat K/V for GQA\\n    if num_key_value_groups > 1:\\n        key_states = key_states[:, :, None, :, :].expand(\\n            batch_size, num_key_value_heads, num_key_value_groups, seq_len, head_dim\\n        ).reshape(batch_size, num_heads, seq_len, head_dim)\\n        value_states = value_states[:, :, None, :, :].expand(\\n            batch_size, num_key_value_heads, num_key_value_groups, seq_len, head_dim\\n        ).reshape(batch_size, num_heads, seq_len, head_dim)\\n    \\n    # Attention scores\\n    attn_weights = torch.matmul(query_states, key_states.transpose(2, 3)) * scaling\\n    \\n    # Apply causal mask if needed\\n    if is_causal:\\n        causal_mask = torch.triu(torch.ones(seq_len, seq_len, device=hidden_states.device, dtype=torch.bool), diagonal=1)\\n        attn_weights = attn_weights.masked_fill(causal_mask.unsqueeze(0).unsqueeze(0), float('-inf'))\\n    \\n    # Softmax\\n    attn_weights = torch.softmax(attn_weights, dim=-1, dtype=torch.float32)\\n    \\n    # Attention output\\n    attn_output = torch.matmul(attn_weights, value_states)\\n    attn_output = attn_output.transpose(1, 2).contiguous().view(batch_size, seq_len, -1)\\n    \\n    # Output projection\\n    attn_output = torch.matmul(attn_output, o_proj_weight.t())\\n    \\n    return attn_output, attn_weights\\n\"\n}\n\n--- reference.py ---\nimport torch\nimport math\n\ndef get_inputs(axes_and_scalars: dict, device: torch.device) -> dict:\n    batch_size = axes_and_scalars['batch_size']\n    seq_len = axes_and_scalars['seq_len']\n    hidden_size = 1024\n    num_heads = 16\n    num_key_value_heads = 4\n    head_dim = 64\n    rope_theta = 10000.0\n    \n    q_proj_size = num_heads * head_dim\n    kv_proj_size = num_key_value_heads * head_dim\n    \n    hidden_states = torch.randn(batch_size, seq_len, hidden_size, device=device, dtype=torch.float32)\n    position_ids = torch.arange(seq_len, device=device, dtype=torch.int64).unsqueeze(0).expand(batch_size, -1)\n    \n    q_proj_weight = torch.randn(q_proj_size, hidden_size, device=device, dtype=torch.float32) * 0.02\n    k_proj_weight = torch.randn(kv_proj_size, hidden_size, device=device, dtype=torch.float32) * 0.02\n    v_proj_weight = torch.randn(kv_proj_size, hidden_size, device=device, dtype=torch.float32) * 0.02\n    o_proj_weight = torch.randn(hidden_size, q_proj_size, device=device, dtype=torch.float32) * 0.02\n    \n    inv_freq = 1.0 / (rope_theta ** (torch.arange(0, head_dim, 2, dtype=torch.float32, device=device) / head_dim))\n    \n    is_causal = False\n    \n    return {\n        'hidden_states': hidden_states,\n        'position_ids': position_ids,\n        'q_proj_weight': q_proj_weight,\n        'k_proj_weight': k_proj_weight,\n        'v_proj_weight': v_proj_weight,\n        'o_proj_weight': o_proj_weight,\n        'inv_freq': inv_freq,\n        'is_causal': is_causal\n    }\n\n@torch.no_grad()\ndef run(\n    hidden_states: torch.Tensor,\n    position_ids: torch.Tensor,\n    q_proj_weight: torch.Tensor,\n    k_proj_weight: torch.Tensor,\n    v_proj_weight: torch.Tensor,\n    o_proj_weight: torch.Tensor,\n    inv_freq: torch.Tensor,\n    is_causal: bool\n):\n    batch_size, seq_len, hidden_size = hidden_states.shape\n    num_heads = 16\n    num_key_value_heads = 4\n    head_dim = 64\n    num_key_value_groups = num_heads // num_key_value_heads\n    scaling = 1.0\n    \n    # Q/K/V projections\n    query_states = torch.matmul(hidden_states, q_proj_weight.t())\n    key_states = torch.matmul(hidden_states, k_proj_weight.t())\n    value_states = torch.matmul(hidden_states, v_proj_weight.t())\n    \n    # Reshape to [batch, seq, heads, head_dim] then transpose to [batch, heads, seq, head_dim]\n    query_states = query_states.view(batch_size, seq_len, num_heads, head_dim).transpose(1, 2)\n    key_states = key_states.view(batch_size, seq_len, num_key_value_heads, head_dim).transpose(1, 2)\n    value_states = value_states.view(batch_size, seq_len, num_key_value_heads, head_dim).transpose(1, 2)\n    \n    # Compute RoPE embeddings\n    inv_freq_expanded = inv_freq[None, :, None].float().expand(batch_size, -1, 1)\n    position_ids_expanded = position_ids[:, None, :].float()\n    freqs = torch.matmul(inv_freq_expanded, position_ids_expanded).transpose(1, 2)\n    emb = torch.cat((freqs, freqs), dim=-1)\n    cos = emb.cos() * scaling\n    sin = emb.sin() * scaling\n    \n    # Apply RoPE\n    cos = cos.unsqueeze(1)\n    sin = sin.unsqueeze(1)\n    \n    q_half1 = query_states[..., :head_dim // 2]\n    q_half2 = query_states[..., head_dim // 2:]\n    q_rotated = torch.cat((-q_half2, q_half1), dim=-1)\n    query_states = (query_states * cos) + (q_rotated * sin)\n    \n    k_half1 = key_states[..., :head_dim // 2]\n    k_half2 = key_states[..., head_dim // 2:]\n    k_rotated = torch.cat((-k_half2, k_half1), dim=-1)\n    key_states = (key_states * cos) + (k_rotated * sin)\n    \n    # Repeat K/V for GQA\n    if num_key_value_groups > 1:\n        key_states = key_states[:, :, None, :, :].expand(\n            batch_size, num_key_value_heads, num_key_value_groups, seq_len, head_dim\n        ).reshape(batch_size, num_heads, seq_len, head_dim)\n        value_states = value_states[:, :, None, :, :].expand(\n            batch_size, num_key_value_heads, num_key_value_groups, seq_len, head_dim\n        ).reshape(batch_size, num_heads, seq_len, head_dim)\n    \n    # Attention scores\n    attn_weights = torch.matmul(query_states, key_states.transpose(2, 3)) * scaling\n    \n    # Apply causal mask if needed\n    if is_causal:\n        causal_mask = torch.triu(torch.ones(seq_len, seq_len, device=hidden_states.device, dtype=torch.bool), diagonal=1)\n        attn_weights = attn_weights.masked_fill(causal_mask.unsqueeze(0).unsqueeze(0), float('-inf'))\n    \n    # Softmax\n    attn_weights = torch.softmax(attn_weights, dim=-1, dtype=torch.float32)\n    \n    # Attention output\n    attn_output = torch.matmul(attn_weights, value_states)\n    attn_output = attn_output.transpose(1, 2).contiguous().view(batch_size, seq_len, -1)\n    \n    # Output projection\n    attn_output = torch.matmul(attn_output, o_proj_weight.t())\n    \n    return attn_output, attn_weights\n\n--- workload.jsonl ---\n{\"uuid\": \"4afd94cb-94ec-53ac-9a7c-1bf4f055ddab\", \"axes\": {\"batch_size\": 8, \"seq_len\": 512}, \"inputs\": {\"hidden_states\": {\"type\": \"custom\"}, \"position_ids\": {\"type\": \"custom\"}, \"q_proj_weight\": {\"type\": \"custom\"}, \"k_proj_weight\": {\"type\": \"custom\"}, \"v_proj_weight\": {\"type\": \"custom\"}, \"o_proj_weight\": {\"type\": \"custom\"}, \"inv_freq\": {\"type\": \"custom\"}, \"is_causal\": {\"type\": \"custom\"}}, \"tolerance\": {\"max_atol\": 7.85526082129975e-09, \"max_rtol\": 1.19209289550