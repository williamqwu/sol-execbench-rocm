{"type":"item.started","item":{"id":"item_19","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport torch, reference\n@torch.compile(fullgraph=True)\ndef rope(q,k,c,s):\n return q*c+torch.cat((-q[...,32:],q[...,:32]),-1)*s, k*c+torch.cat((-k[...,32:],k[...,:32]),-1)*s\n@torch.no_grad()\ndef alt(x):\n h,p,qw,kw,vw,ow,inv,causal=x.values();B,S,_=h.shape\n q=(h@qw.t()).view(B,S,16,64).transpose(1,2);k=(h@kw.t()).view(B,S,4,64).transpose(1,2);v=(h@vw.t()).view(B,S,4,64).transpose(1,2)\n f=torch.matmul(inv[None,:,None].expand(B,-1,1),p[:,None,:].float()).transpose(1,2);e=torch.cat((f,f),-1);q,k=rope(q,k,e.cos().unsqueeze(1),e.sin().unsqueeze(1))\n k=k[:,:,None].expand(B,4,4,S,64).reshape(B,16,S,64);v=v[:,:,None].expand(B,4,4,S,64).reshape(B,16,S,64)\n w=torch.softmax(q@k.transpose(2,3),-1,dtype=torch.float32); a=(w@v).transpose(1,2).contiguous().view(B,S,1024)@ow.t();return a,w\nfor B,S in [(1,131),(1,541),(2,1024)]:\n x=reference.get_inputs({'batch_size':B,'seq_len':S},torch.device('cuda'));a=reference.run(**x);z=alt(x)\n atol={131:1.62e-8,541:7.63e-9,1024:5.21e-9}[S]\n for u,v in zip(a,z):\n  d=(u-v).abs();m=(d<=atol+1.1920928955078125e-7*u.abs()).float().mean();print((B,S),d.max().item(),m.item())\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
