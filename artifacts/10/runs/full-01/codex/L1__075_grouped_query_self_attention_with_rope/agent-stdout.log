{"type":"item.started","item":{"id":"item_38","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport torch,reference\nfor B,S in [(1,541),(4,256),(2,1024),(8,512)]:\n x=reference.get_inputs({'batch_size':B,'seq_len':S},torch.device('cuda'));h,p,qw,kw,vw,ow,inv,c=x.values()\n # construct exact reference weights and normal v\n q=h@qw.t();k=h@kw.t();v=h@vw.t();q=q.view(B,S,16,64).transpose(1,2);k=k.view(B,S,4,64).transpose(1,2);v=v.view(B,S,4,64).transpose(1,2)\n f=torch.matmul(inv[None,:,None].expand(B,-1,1),p[:,None,:].float()).transpose(1,2);e=torch.cat((f,f),-1);co=e.cos().unsqueeze(1);si=e.sin().unsqueeze(1);q=q*co+torch.cat((-q[...,32:],q[...,:32]),-1)*si;k=k*co+torch.cat((-k[...,32:],k[...,:32]),-1)*si;k=k[:,:,None].expand(B,4,4,S,64).reshape(B,16,S,64);w=torch.softmax(q@k.transpose(2,3),-1)\n o=w.view(B,4,4,S,S)@v.unsqueeze(2)\n qkv=h@torch.cat((qw,kw,vw),0).t();vc=qkv[...,1280:].view(B,S,4,64).transpose(1,2)\n oc=w.view(B,4,4,S,S)@vc.unsqueeze(2)\n print((B,S),'v exact',torch.equal(v,vc),'out',torch.equal(o,oc),(o-oc).abs().max().item(),'stride',vc.stride())\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
