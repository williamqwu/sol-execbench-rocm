{"type":"item.started","item":{"id":"item_26","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch,aiter\nB=torch.randn((4096,4096),device='cuda',dtype=torch.float16); BT=B.T\ntorch.ops.aiter.rocb_create_extension(B)\ndef em(fn,reps=5):\n fn();torch.cuda.synchronize();s=torch.cuda.Event(True);e=torch.cuda.Event(True);s.record()\n for _ in range(reps): y=fn()\n e.record();e.synchronize();return s.elapsed_time(e)/reps,y\nfor m in [1,8,16,32,64,128,256,972,2053,2379,8192]:\n A=torch.randn((m,4096),device='cuda',dtype=torch.float16)\n try: sols=torch.ops.aiter.rocb_findallsols(A,BT)\n except Exception as ex: print(m,'find err',ex);continue\n vals=[]\n for sol in sols:\n  try: vals.append((em(lambda sol=sol:torch.ops.aiter.rocb_mm(A,BT,sol),3)[0],sol))\n  except: pass\n vals.sort(); finals=[]\n for _,sol in vals[:10]:\n  ts=[em(lambda sol=sol:torch.ops.aiter.rocb_mm(A,BT,sol),20)[0] for _ in range(3)]\n  finals.append((sum(ts)/3,sol))\n finals.sort();tt,z=em(lambda:A@BT,30);tb,sol=finals[0];y=torch.ops.aiter.rocb_mm(A,BT,sol)\n print(m,'n',len(sols),'torch_us',round(tt*1000,2),'best_us',round(tb*1000,2),'sol',sol,'sp',round(tt/tb,3),'match',torch.isclose(y,z,atol=.0365,rtol=.0009765625).float().mean().item(),'top',[(round(x*1000,2),s) for x,s in finals[:5]],flush=True)\ntorch.ops.aiter.rocb_destroy_extension(B)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
