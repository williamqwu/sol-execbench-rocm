{"type":"item.started","item":{"id":"item_41","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport json, random, statistics, torch, aiter\naiter.hipb_create_extension()\nfrom aiter.jit import module_hipbsolgemm as h\nms=[]\nfor line in open('workload.jsonl'):\n m=json.loads(line)['axes']['M']\n if m not in ms: ms.append(m)\nB=torch.randn((4096,4096),device='cuda',dtype=torch.float16); BT=B.T\ncache=torch.empty(256*1024*1024//4,device='cuda',dtype=torch.int32)\n\ndef sweep(A, ids):\n order=list(ids); random.shuffle(order)\n ss=[];es=[];ys=[]\n for sol in order:\n  cache.zero_()\n  s=torch.cuda.Event(enable_timing=True); e=torch.cuda.Event(enable_timing=True)\n  s.record()\n  y=A@BT if sol == -1 else h.hipb_mm(A,BT,sol)\n  e.record(); ss.append(s);es.append(e);ys.append(y)\n torch.cuda.synchronize()\n return {sol:s.elapsed_time(e) for sol,s,e in zip(order,ss,es)}\n\nfinal={}\nfor ix,m in enumerate(ms):\n A=torch.randn((m,4096),device='cuda',dtype=torch.float16)\n sols=h.hipb_findallsols(A,BT)\n A@BT; h.hipb_mm(A,BT,sols[0]); torch.cuda.synchronize()\n r1=sweep(A,sols+[-1]); r2=sweep(A,sols+[-1])\n ranked=sorted(sols,key=lambda s:(r1[s]+r2[s])/2)[:20]\n cand=ranked+[-1]\n vals={s:[] for s in cand}\n for _ in range(9):\n  rr=sweep(A,cand)\n  for s,t in rr.items():vals[s].append(t)\n med={s:statistics.median(ts) for s,ts in vals.items()}\n best=min(ranked,key=lambda s:med[s]); ref=med[-1]\n final[m]=(best,med[best],ref,ref/med[best])\n tops=sorted(ranked,key=lambda s:med[s])[:5]\n print(f'{ix:02d} M={m:4d} sol={best} hip={med[best]*1000:7.2f}us torch={ref*1000:7.2f}us sp={ref/med[best]:5.3f} top={[(s,round(med[s]*1000,2)) for s in tops]}',flush=True)\nprint('MAP3=',{m:s for m,(s,t,r,sp) in final.items() if sp>1.03})\nprint('ALL=',{m:(s,round(t*1000,2),round(r*1000,2),round(sp,3)) for m,(s,t,r,sp) in final.items()})\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
