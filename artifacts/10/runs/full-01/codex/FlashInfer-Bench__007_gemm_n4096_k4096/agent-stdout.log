{"type":"item.completed","item":{"id":"item_45","type":"agent_message","text":"The cold-tuned table now passes all 43 workloads and delivers the expected gains—up to about 31%, with broad improvements through `M=80–256`. I’m preserving that working state while doing one last read-only comparison against rocBLAS’s cold-cache solutions; I’ll only change the submission if it shows a clear, repeatable advantage."}}
{"type":"item.started","item":{"id":"item_46","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport random,statistics,torch,aiter\naiter.hipb_create_extension(); aiter.rocb_create_extension()\nfrom aiter.jit import module_hipbsolgemm as h, module_rocsolgemm as r\nB=torch.randn((4096,4096),device='cuda',dtype=torch.float16);BT=B.T\ncache=torch.empty(256*1024*1024//4,device='cuda',dtype=torch.int32)\nhipids={256:476893,192:476894,136:476894,128:476950,96:476894,48:476984,16:476762,1:476762,972:476643,2053:476704,2379:476751}\ndef sweep(A,items):\n order=list(items);random.shuffle(order);ev=[];ys=[]\n for kind,sol in order:\n  cache.zero_();s=torch.cuda.Event(True);e=torch.cuda.Event(True);s.record()\n  if kind=='r':y=r.rocb_mm(A,BT,sol)\n  elif kind=='h':y=h.hipb_mm(A,BT,sol)\n  else:y=A@BT\n  e.record();ev.append((kind,sol,s,e));ys.append(y)\n torch.cuda.synchronize();return {(k,sid):s.elapsed_time(e) for k,sid,s,e in ev}\nfor m in hipids:\n A=torch.randn((m,4096),device='cuda',dtype=torch.float16)\n sols=r.rocb_findallsols(A,BT);base=[('r',s) for s in sols]\n rr=[sweep(A,base) for _ in range(2)]\n rank=sorted(sols,key=lambda s:sum(x[('r',s)] for x in rr))[:20]\n cand=[('r',s) for s in rank]+[('h',hipids[m]),('t',-1)];vals={x:[] for x in cand}\n for _ in range(9):\n  z=sweep(A,cand)\n  for x,v in z.items():vals[x].append(v)\n med={x:statistics.median(v) for x,v in vals.items()}; best=min([('r',s) for s in rank],key=lambda x:med[x])\n print(m,'roc',best[1],round(med[best]*1000,2),'hip',hipids[m],round(med[('h',hipids[m])]*1000,2),'torch',round(med[('t',-1)]*1000,2),'roc/hip',round(med[('h',hipids[m])]/med[best],3),flush=True)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
