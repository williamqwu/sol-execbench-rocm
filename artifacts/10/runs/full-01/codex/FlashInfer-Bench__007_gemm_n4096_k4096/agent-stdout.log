{"type":"item.started","item":{"id":"item_23","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch, aiter, time\n\ntorch.manual_seed(2)\nB=torch.randn((4096,4096),device='cuda',dtype=torch.float16)\nBT=B.T\ntorch.ops.aiter.hipb_create_extension(B)\n\ndef event_ms(fn, reps=4):\n    fn(); torch.cuda.synchronize()\n    s=torch.cuda.Event(enable_timing=True); e=torch.cuda.Event(enable_timing=True)\n    s.record()\n    for _ in range(reps): y=fn()\n    e.record(); e.synchronize()\n    return s.elapsed_time(e)/reps, y\n\nfor m in [1,8,16,32,64,128,256,972,2053,2379,8192]:\n    A=torch.randn((m,4096),device='cuda',dtype=torch.float16)\n    sols=torch.ops.aiter.hipb_findallsols(A,BT)\n    vals=[]\n    for sol in sols:\n        try:\n            t,_=event_ms(lambda sol=sol: torch.ops.aiter.hipb_mm(A,BT,sol),3)\n            vals.append((t,sol))\n        except Exception:\n            pass\n    vals.sort()\n    tt,_=event_ms(lambda: A@BT,30)\n    # Retest the best ten more carefully.\n    finalists=[]\n    for _,sol in vals[:12]:\n        times=[event_ms(lambda sol=sol: torch.ops.aiter.hipb_mm(A,BT,sol),20)[0] for _ in range(3)]\n        finalists.append((sum(times)/len(times),sol,min(times),max(times)))\n    finalists.sort()\n    tbest,sol,tmin,tmax=finalists[0]\n    y=torch.ops.aiter.hipb_mm(A,BT,sol); z=A@BT\n    match=torch.isclose(y,z,atol=.0365,rtol=.0009765625).float().mean().item()\n    print(f'M={m:4d} nsol={len(sols):3d} torch={tt*1000:7.2f}us best={tbest*1000:7.2f}us sol={sol} range={tmin*1000:.2f}-{tmax*1000:.2f} sp={tt/tbest:.3f} match={match:.6f} top={[(round(x[0]*1000,2),x[1]) for x in finalists[:5]]}',flush=True)\n\ntorch.ops.aiter.hipb_destroy_extension(B)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
