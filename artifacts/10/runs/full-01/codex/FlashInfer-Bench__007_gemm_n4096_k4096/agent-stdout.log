{"type":"item.started","item":{"id":"item_35","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,160p' verify && python - <<'PY'\nimport time,torch,aiter\naiter.hipb_create_extension()\nfrom aiter.jit import module_hipbsolgemm as h\nB=torch.randn((4096,4096),device='cuda',dtype=torch.float16); BT=B.T\n\ndef ev(fn,reps=100):\n for _ in range(5): y=fn()\n torch.cuda.synchronize();s=torch.cuda.Event(True);e=torch.cuda.Event(True);s.record()\n for _ in range(reps):y=fn()\n e.record();e.synchronize();return s.elapsed_time(e)*1000/reps\n\ndef wall(fn,reps=100):\n for _ in range(5): y=fn()\n torch.cuda.synchronize();t=time.perf_counter_ns()\n for _ in range(reps):\n  y=fn();torch.cuda.synchronize()\n return (time.perf_counter_ns()-t)/1000/reps\nfor m,sol in [(24,476999),(48,477452),(72,477362),(104,476658),(160,476775),(2379,476704)]:\n A=torch.randn((m,4096),device='cuda',dtype=torch.float16)\n fs=[('torch',lambda:A@BT),('ops',lambda:torch.ops.aiter.hipb_mm(A,BT,sol)),('direct',lambda:h.hipb_mm(A,BT,sol))]\n print('M',m)\n for n,f in fs:print(n,'event',round(ev(f),2),'wall',round(wall(f),2))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
