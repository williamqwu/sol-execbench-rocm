{"type":"item.started","item":{"id":"item_10","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch\nimport kernel\n\ntorch.manual_seed(1)\nB=torch.randn((4096,4096),device='cuda',dtype=torch.float16)\n\ndef bench(fn,A,iters=100):\n    for _ in range(5): y=fn(A,B)\n    torch.cuda.synchronize()\n    s=torch.cuda.Event(enable_timing=True); e=torch.cuda.Event(enable_timing=True)\n    s.record()\n    for _ in range(iters): y=fn(A,B)\n    e.record(); e.synchronize()\n    return s.elapsed_time(e)/iters, y\n\nfor m in [1,2,4,8,15,16,24,32,48,64,96,128,192,256,972,2053]:\n    A=torch.randn((m,4096),device='cuda',dtype=torch.float16)\n    t,y=bench(kernel.run,A)\n    r=lambda a,b: torch.matmul(a,b.T)\n    tr,z=bench(r,A)\n    err=(y-z).abs()\n    ratio=torch.isclose(y,z,atol=.0355,rtol=.0009765625).float().mean().item()\n    print(f'M={m:4} tri={t*1000:7.2f}us torch={tr*1000:7.2f}us sp={tr/t:5.2f} max={err.max().item():.4f} match={ratio:.6f}')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
