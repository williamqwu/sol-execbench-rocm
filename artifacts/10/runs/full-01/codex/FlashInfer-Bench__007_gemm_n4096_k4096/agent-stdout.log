{"type":"item.completed","item":{"id":"item_27","type":"agent_message","text":"The tuned hipBLASLt route is consistently useful for `M≈1k–2.4k` (about 7–17% in local timing), and occasionally for exact skinny shapes; rocBLAS is not better. I’m doing one exact-shape sweep now so the final dispatch table only uses solution IDs with a repeatable advantage and falls back to `torch.matmul` elsewhere."}}
{"type":"item.started","item":{"id":"item_28","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport json, torch, aiter, statistics\nms=[]\nfor line in open('workload.jsonl'):\n m=json.loads(line)['axes']['M']\n if m not in ms: ms.append(m)\nB=torch.randn((4096,4096),device='cuda',dtype=torch.float16); BT=B.T\ntorch.ops.aiter.hipb_create_extension(B)\n\ndef em(fn,reps):\n fn(); torch.cuda.synchronize()\n s=torch.cuda.Event(enable_timing=True); e=torch.cuda.Event(enable_timing=True)\n s.record()\n for _ in range(reps): y=fn()\n e.record(); e.synchronize()\n return s.elapsed_time(e)/reps\n\nresults={}\nfor idx,m in enumerate(ms):\n A=torch.randn((m,4096),device='cuda',dtype=torch.float16)\n sols=torch.ops.aiter.hipb_findallsols(A,BT)\n rough=[]\n for sol in sols:\n  try: rough.append((em(lambda sol=sol: torch.ops.aiter.hipb_mm(A,BT,sol),2),sol))\n  except Exception: pass\n rough.sort()\n fine=[]\n for _,sol in rough[:16]:\n  ts=[em(lambda sol=sol: torch.ops.aiter.hipb_mm(A,BT,sol),20) for _ in range(3)]\n  fine.append((statistics.median(ts),sol,min(ts),max(ts)))\n fine.sort()\n # Alternate measurements to reduce drift.\n tts=[em(lambda:A@BT,30) for _ in range(3)]\n tb,sol,lo,hi=fine[0]; tt=statistics.median(tts)\n results[m]=(sol,tb,tt)\n print(f'{idx:02d} M={m:4d} sol={sol} hip={tb*1000:7.3f}us torch={tt*1000:7.3f}us sp={tt/tb:6.3f} spread={lo*1000:.2f}-{hi*1000:.2f} next={[(s,round(t*1000,2)) for t,s,_,_ in fine[:4]]}',flush=True)\nprint('MAP=',{m:s for m,(s,t,tt) in results.items() if tt/t>1.015})\nprint('ALL=',{m:(s,round(t*1000,3),round(tt*1000,3),round(tt/t,3)) for m,(s,t,tt) in results.items()})\ntorch.ops.aiter.hipb_destroy_extension(B)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
