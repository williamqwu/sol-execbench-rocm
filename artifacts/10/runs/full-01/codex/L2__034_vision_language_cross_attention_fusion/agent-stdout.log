{"type":"item.started","item":{"id":"item_27","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch, math, time\nfrom kernel import _attention_bf16\n\ndef explicit(q,k,v,b,l,n):\n    kr=k[:,:,None].expand(b,8,4,n,128).reshape(b,32,n,128)\n    vr=v[:,:,None].expand(b,8,4,n,128).reshape(b,32,n,128)\n    w=(q@kr.transpose(2,3))/math.sqrt(128)\n    w=torch.softmax(w,-1,dtype=torch.float32).to(torch.bfloat16)\n    return (w@vr).transpose(1,2).contiguous().view(b,l,4096)\n\ndef timing(fn, args, reps=20):\n    for _ in range(3): fn(*args)\n    torch.cuda.synchronize()\n    s=torch.cuda.Event(enable_timing=True); e=torch.cuda.Event(enable_timing=True)\n    vals=[]\n    for _ in range(reps):\n      s.record(); fn(*args); e.record(); e.synchronize(); vals.append(s.elapsed_time(e))\n    vals.sort(); return vals[len(vals)//2]\n\nfor b,l,n in [(2,128,196),(2,256,392),(1,512,784),(1,1024,1568),(1,4096,6272)]:\n    q=torch.randn(b,32,l,128,device='cuda',dtype=torch.bfloat16)\n    k=torch.randn(b,8,n,128,device='cuda',dtype=torch.bfloat16)\n    v=torch.randn_like(k)\n    c=timing(_attention_bf16,(q,k,v,b,l,n),10)\n    x=timing(explicit,(q,k,v,b,l,n),10)\n    print((b,l,n),'custom',round(c,4),'explicit',round(x,4),'speedup',round(x/c,2))\n    del q,k,v\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
