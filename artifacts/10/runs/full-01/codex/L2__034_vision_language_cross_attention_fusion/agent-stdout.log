{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' definition.json && sed -n '1,320p' reference.py && sed -n '1,240p' workload.jsonl\"","aggregated_output":"{\n  \"name\": \"034_vision_language_cross_attention_fusion\",\n  \"description\": \"Cross-attention fusion layer for Qwen3-VL multimodal processing. Performs cross-attention between language queries (with 1D RoPE) and vision key-values (with 3D RoPE for temporal-height-width positions). Uses Grouped Query Attention (GQA) with 32 query heads and 8 key-value heads.\",\n  \"hf_id\": \"cybermotaz/Qwen3-VL-32B-Instruct-NVFP4\",\n  \"custom_inputs_entrypoint\": \"get_inputs\",\n  \"axes\": {\n    \"batch_size\": {\n      \"type\": \"var\",\n      \"description\": \"Batch size\"\n    },\n    \"lang_seq_len\": {\n      \"type\": \"var\",\n      \"description\": \"Language sequence length\"\n    },\n    \"vision_seq_len\": {\n      \"type\": \"var\",\n      \"description\": \"Vision sequence length (number of vision tokens)\"\n    },\n    \"hidden_size\": {\n      \"type\": \"const\",\n      \"value\": 4096,\n      \"description\": \"Hidden dimension size\"\n    },\n    \"num_attention_heads\": {\n      \"type\": \"const\",\n      \"value\": 32,\n      \"description\": \"Number of query attention heads\"\n    },\n    \"num_key_value_heads\": {\n      \"type\": \"const\",\n      \"value\": 8,\n      \"description\": \"Number of key-value heads for GQA\"\n    },\n    \"head_dim\": {\n      \"type\": \"const\",\n      \"value\": 128,\n      \"description\": \"Dimension per attention head\"\n    },\n    \"q_proj_dim\": {\n      \"type\": \"expr\",\n      \"expression\": \"num_attention_heads * head_dim\",\n      \"description\": \"Query projection output dimension\"\n    },\n    \"kv_proj_dim\": {\n      \"type\": \"expr\",\n      \"expression\": \"num_key_value_heads * head_dim\",\n      \"description\": \"Key/Value projection output dimension\"\n    },\n    \"thw_dim\": {\n      \"type\": \"const\",\n      \"value\": 3,\n      \"description\": \"Dimension for temporal-height-width indices\"\n    }\n  },\n  \"inputs\": {\n    \"language_hidden_states\": {\n      \"shape\": [\n        \"batch_size\",\n        \"lang_seq_len\",\n        \"hidden_size\"\n      ],\n      \"dtype\": \"bfloat16\",\n      \"description\": \"Language token hidden states\"\n    },\n    \"vision_hidden_states\": {\n      \"shape\": [\n        \"batch_size\",\n        \"vision_seq_len\",\n        \"hidden_size\"\n      ],\n      \"dtype\": \"bfloat16\",\n      \"description\": \"Vision token hidden states\"\n    },\n    \"language_position_ids\": {\n      \"shape\": [\n        \"batch_size\",\n        \"lang_seq_len\"\n      ],\n      \"dtype\": \"int64\",\n      \"description\": \"Position IDs for language tokens (1D RoPE)\"\n    },\n    \"vision_grid_thw\": {\n      \"shape\": [\n        \"batch_size\",\n        \"vision_seq_len\",\n        \"thw_dim\"\n      ],\n      \"dtype\": \"int64\",\n      \"description\": \"3D position indices (temporal, height, width) for vision tokens\"\n    },\n    \"q_proj_weight\": {\n      \"shape\": [\n        \"q_proj_dim\",\n        \"hidden_size\"\n      ],\n      \"dtype\": \"bfloat16\",\n      \"description\": \"Query projection weight\"\n    },\n    \"q_proj_bias\": {\n      \"shape\": [\n        \"q_proj_dim\"\n      ],\n      \"dtype\": \"bfloat16\",\n      \"description\": \"Query projection bias\"\n    },\n    \"k_proj_weight\": {\n      \"shape\": [\n        \"kv_proj_dim\",\n        \"hidden_size\"\n      ],\n      \"dtype\": \"bfloat16\",\n      \"description\": \"Key projection weight\"\n    },\n    \"k_proj_bias\": {\n      \"shape\": [\n        \"kv_proj_dim\"\n      ],\n      \"dtype\": \"bfloat16\",\n      \"description\": \"Key projection bias\"\n    },\n    \"v_proj_weight\": {\n      \"shape\": [\n        \"kv_proj_dim\",\n        \"hidden_size\"\n      ],\n      \"dtype\": \"bfloat16\",\n      \"description\": \"Value projection weight\"\n    },\n    \"v_proj_bias\": {\n      \"shape\": [\n        \"kv_proj_dim\"\n      ],\n      \"dtype\": \"bfloat16\",\n      \"description\": \"Value projection bias\"\n    },\n    \"o_proj_weight\": {\n      \"shape\": [\n        \"hidden_size\",\n        \"q_proj_dim\"\n      ],\n      \"dtype\": \"bfloat16\",\n      \"description\": \"Output projection weight\"\n    }\n  },\n  \"outputs\": {\n    \"output\": {\n      \"shape\": [\n        \"batch_size\",\n        \"lang_seq_len\",\n        \"hidden_size\"\n      ],\n      \"dtype\": \"bfloat16\",\n      \"description\": \"Cross-attention output\"\n    }\n  },\n  \"reference\": \"import torch\\nimport torch.nn.functional as F\\nimport math\\n\\n\\ndef get_inputs(axes_and_scalars: dict, device: torch.device) -> dict:\\n    batch_size = axes_and_scalars[\\\"batch_size\\\"]\\n    lang_seq_len = axes_and_scalars[\\\"lang_seq_len\\\"]\\n    vision_seq_len = axes_and_scalars[\\\"vision_seq_len\\\"]\\n    hidden_size = 4096\\n    num_attention_heads = 32\\n    num_key_value_heads = 8\\n    head_dim = 128\\n    \\n    language_hidden_states = torch.randn(batch_size, lang_seq_len, hidden_size, dtype=torch.bfloat16, device=device)\\n    vision_hidden_states = torch.randn(batch_size, vision_seq_len, hidden_size, dtype=torch.bfloat16, device=device)\\n    \\n    # Language position IDs: sequential positions\\n    language_position_ids = torch.arange(lang_seq_len, dtype=torch.int64, device=device).unsqueeze(0).expand(batch_size, -1).contiguous()\\n    \\n    # Vision grid THW: generate valid 3D positions\\n    vision_grid_thw = torch.zeros(batch_size, vision_seq_len, 3, dtype=torch.int64, device=device)\\n    for b in range(batch_size):\\n        for i in range(vision_seq_len):\\n            t = i // 196\\n            spatial_idx = i % 196\\n            h = spatial_idx // 14\\n            w = spatial_idx % 14\\n            vision_grid_thw[b, i, 0] = t\\n            vision_grid_thw[b, i, 1] = h\\n            vision_grid_thw[b, i, 2] = w\\n    \\n    q_proj_weight = torch.randn(num_attention_heads * head_dim, hidden_size, dtype=torch.bfloat16, device=device) * 0.02\\n    q_proj_bias = torch.randn(num_attention_heads * head_dim, dtype=torch.bfloat16, device=device) * 0.02\\n    k_proj_weight = torch.randn(num_key_value_heads * head_dim, hidden_size, dtype=torch.bfloat16, device=device) * 0.02\\n    k_proj_bias = torch.randn(num_key_value_heads * head_dim, dtype=torch.bfloat16, device=device) * 0.02\\n    v_proj_weight = torch.randn(num_key_value_heads * head_dim, hidden_size, dtype=torch.bfloat16, device=device) * 0.02\\n    v_proj_bias = torch.randn(num_key_value_heads * head_dim, dtype=torch.bfloat16, device=device) * 0.02\\n    o_proj_weight = torch.randn(hidden_size, num_attention_heads * head_dim, dtype=torch.bfloat16, device=device) * 0.02\\n    \\n    return {\\n        \\\"language_hidden_states\\\": language_hidden_states,\\n        \\\"vision_hidden_states\\\": vision_hidden_states,\\n        \\\"language_position_ids\\\": language_position_ids,\\n        \\\"vision_grid_thw\\\": vision_grid_thw,\\n        \\\"q_proj_weight\\\": q_proj_weight,\\n        \\\"q_proj_bias\\\": q_proj_bias,\\n        \\\"k_proj_weight\\\": k_proj_weight,\\n        \\\"k_proj_bias\\\": k_proj_bias,\\n        \\\"v_proj_weight\\\": v_proj_weight,\\n        \\\"v_proj_bias\\\": v_proj_bias,\\n        \\\"o_proj_weight\\\": o_proj_weight,\\n    }\\n\\n\\n@torch.no_grad()\\ndef run(\\n    language_hidden_states: torch.Tensor,\\n    vision_hidden_states: torch.Tensor,\\n    language_position_ids: torch.Tensor,\\n    vision_grid_thw: torch.Tensor,\\n    q_proj_weight: torch.Tensor,\\n    q_proj_bias: torch.Tensor,\\n    k_proj_weight: torch.Tensor,\\n    k_proj_bias: torch.Tensor,\\n    v_proj_weight: torch.Tensor,\\n    v_proj_bias: torch.Tensor,\\n    o_proj_weight: torch.Tensor,\\n):\\n    # Constants\\n    hidden_size = 4096\\n    num_attention_heads = 32\\n    num_key_value_heads = 8\\n    head_dim = 128\\n    num_kv_groups = num_attention_heads // num_key_value_heads\\n    rope_theta = 10000.0\\n    \\n    batch_size, lang_seq_len, _ = language_hidden_states.shape\\n    vision_seq_len = vision_hidden_states.shape[1]\\n    \\n    # Compute RoPE inverse frequencies\\n    inv_freq_1d = 1.0 / (rope_theta ** (torch.arange(0, head_dim, 2, dtype=torch.float32, device=language_hidden_states.device) / head_dim))\\n    # For 3D RoPE: head_dim=128, split into 3 parts of ~42/43 each\\n    # We use 42, 42, 44 split (42+42+44=128)\\n    dim_t = 42\\n    dim_h = 42\\n    dim_w = 44\\n    inv_freq_t = 1.0 / (rope_theta ** (torch.arange(0, dim_t, 2, dtype=torch.float32, device=language_hidden_states.device) / dim_t))\\n    inv_freq_h = 1.0 / (rope_theta ** (torch.arange(0, dim_h, 2, dtype=torch.float32, device=language_hidden_states.device) / dim_h))\\n    inv_freq_w = 1.0 / (rope_theta ** (torch.arange(0, dim_w, 2, dtype=torch.float32, device=language_hidden_states.device) / dim_w))\\n    \\n    def rotate_half(x):\\n        x1 = x[..., : x.shape[-1] // 2]\\n        x2 = x[..., x.shape[-1] // 2 :]\\n        return torch.cat([-x2, x1], dim=-1)\\n    \\n    def apply_rotary_pos_emb_1d(q, position_ids, inv_freq):\\n        # q: (batch, num_heads, seq_len, head_dim)\\n        # position_ids: (batch, seq_len)\\n        position_ids_expanded = position_ids.unsqueeze(1).unsqueeze(-1).float()  # (batch, 1, seq_len, 1)\\n        freqs = position_ids_expanded * inv_freq  # (batch, 1, seq_len, head_dim//2)\\n        emb = torch.cat([freqs, freqs], dim=-1)  # (batch, 1, seq_len, head_dim)\\n        cos = emb.cos().to(q.dtype)\\n        sin = emb.sin().to(q.dtype)\\n        return (q * cos) + (rotate_half(q) * sin)\\n    \\n    def apply_rotary_pos_emb_3d(k, vision_grid_thw, inv_freq_t, inv_freq_h, inv_freq_w, dim_t, dim_h, dim_w):\\n        # k: (batch, num_kv_heads, vision_seq_len, head_dim)\\n        # vision_grid_thw: (batch, vision_seq_len, 3)\\n        batch_size, num_heads, seq_len, head_dim = k.shape\\n        \\n        # Split k into t, h, w parts\\n        k_t = k[..., :dim_t]  # (batch, num_heads, seq_len, dim_t)\\n        k_h = k[..., dim_t:dim_t+dim_h]  # (batch, num_heads, seq_len, dim_h)\\n        k_w = k[..., dim_t+dim_h:]  # (batch, num_heads, seq_len, dim_w)\\n        \\n        t_pos = vision_grid_thw[..., 0]  # (batch, seq_len)\\n        h_pos = vision_grid_thw[..., 1]\\n        w_pos = vision_grid_thw[..., 2]\\n        \\n        def apply_1d_rope_component(x, pos, inv_freq):\\n            # x: (batch, num_heads, seq_len, dim)\\n            # pos: (batch, seq_len)\\n            # inv_freq: (dim//2,)\\n            pos_expanded = pos.unsqueeze(1).unsqueeze(-1).float()  # (batch, 1, seq_len, 1)\\n            freqs = pos_expanded * inv_freq  # (batch, 1, seq_len, dim//2)\\n            emb = torch.cat([freqs, freqs], dim=-1)  # (batch, 1, seq_len, dim)\\n            cos = emb.cos().to(x.dtype)\\n            sin = emb.sin().to(x.dtype)\\n            return (x * cos) + (rotate_half(x) * sin)\\n        \\n        k_t_rotated = apply_1d_rope_component(k_t, t_pos, inv_freq_t)\\n        k_h_rotated = apply_1d_rope_component(k_h, h_pos, inv_freq_h)\\n        k_w_rotated = apply_1d_rope_component(k_w, w_pos, inv_freq_w)\\n        \\n        return torch.cat([k_t_rotated, k_h_rotated, k_w_rotated], dim=-1)\\n    \\n    def repeat_kv(hidden_states, n_rep):\\n        if n_rep == 1:\\n            return hidden_states\\n        batch, num_kv_heads, slen, head_dim = hidden_states.shape\\n        hidden_states = hidden_states[:, :, None, :, :].expand(batch, num_kv_heads, n_rep, slen, head_dim)\\n        return hidden_states.reshape(batch, num_kv_heads * n_rep, slen, head_dim)\\n    \\n    # Project queries from language tokens\\n    query_states = F.linear(language_hidden_states, q_proj_weight, q_proj_bias)\\n    query_states = query_states.view(batch_size, lang_seq_len, num_attention_heads, head_dim).transpose(1, 2)\\n    \\n    # Project keys and values from vision tokens\\n    key_states = F.linear(vision_hidden_states, k_proj_weight, k_proj_bias)\\n    value_states = F.linear(vision_hidden_states, v_proj_weight, v_proj_bias)\\n    \\n    key_states = key_states.view(batch_size, vision_seq_len, num_key_value_heads, head_dim).transpose(1, 2)\\n    value_states = value_states.view(batch_size, vision_seq_len, num_key_value_heads, head_dim).transpose(1, 2)\\n    \\n    # Apply rotary position embeddings\\n    query_states = apply_rotary_pos_emb_1d(query_states, language_position_ids, inv_freq_1d)\\n    key_states = apply_rotary_pos_emb_3d(key_states, vision_grid_thw, inv_freq_t, inv_freq_h, inv_freq_w, dim_t, dim_h, dim_w)\\n    \\n    # Repeat k/v heads for GQA\\n    key_states = repeat_kv(key_states, num_kv_groups)\\n    value_states = repeat_kv(value_states, num_kv_groups)\\n    \\n    # Compute attention scores\\n    attn_weights = torch.matmul(query_states, key_states.transpose(2, 3)) / math.sqrt(head_dim)\\n    \\n    # Softmax\\n    attn_weights = F.softmax(attn_weights, dim=-1, dtype=torch.float32).to(query_states.dtype)\\n    \\n    # Compute attention output\\n    attn_output = torch.matmul(attn_weights, value_states)\\n    \\n    # Reshape and project output\\n    attn_output = attn_output.transpose(1, 2).contiguous()\\n    attn_output = attn_output.view(batch_size, lang_seq_len, num_attention_heads * head_dim)\\n    output = F.linear(attn_output, o_proj_weight)\\n    \\n    return output\\n\"\n}\nimport torch\nimport torch.nn.functional as F\nimport math\n\n\ndef get_inputs(axes_and_scalars: dict, device: torch.device) -> dict:\n    batch_size = axes_and_scalars[\"batch_size\"]\n    lang_seq_len = axes_and_scalars[\"lang_seq_len\"]\n    vision_seq_len = axes_and_scalars[\"vision_seq_len\"]\n    hidden_size = 4096\n    num_attention_heads = 32\n    num_key_value_heads = 8\n    head_dim = 128\n    \n    language_hidden_states = torch.randn(batch_size, lang_seq_len, hidden_size, dtype=torch.bfloat16, device=device)\n    vision_hidden_states = torch.randn(batch_size, vision_seq_len, hidden_size, dtype=torch.bfloat16, device=device)\n    \n    # Language position IDs: sequential positions\n    language_position_ids = torch.arange(lang_seq_len, dtype=torch.int64, device=device).unsqueeze(0).expand(batch_size, -1).contiguous()\n    \n    # Vision grid THW: generate valid 3D positions\n    vision_grid_thw = torch.zeros(batch_size, vision_seq_len, 3, dtype=torch.int64, device=device)\n    for b in range(batch_size):\n        for i in range(vision_seq_len):\n            t = i // 196\n            spatial_idx = i % 196\n            h = spatial_idx // 14\n            w = spatial_idx % 14\n            vision_grid_thw[b, i, 0] = t\n            vision_grid_thw[b, i, 1] = h\n            vision_grid_thw[b, i, 2] = w\n    \n    q_proj_weight = torch.randn(num_attention_heads * head_dim, hidden_size, dtype=torch.bfloat16, device=device) * 0.02\n    q_proj_bias = torch.randn(num_attention_heads * head_dim, dtype=torch.bfloat16, device=device) * 0.02\n    k_proj_weight = torch.randn(num_key_value_heads * head_dim, hidden_size, dtype=torch.bfloat16, device=device) * 0.02\n    k_proj_bias = torch.randn(num_key_value_heads * head_dim, dtype=torch.bfloat16, device=device) * 0.02\n    v_proj_weight = torch.randn(num_key_value_heads * head_dim, hidden_size, dtype=torch.bfloat16, device=device) * 0.02\n    v_proj_bias = torch.randn(num_key_value_heads * head_dim, dtype=torch.bfloat16, device=device) * 0.02\n    o_proj_weight = torch.randn(hidden_size, num_attention_heads * head_dim, dtype=torch.bfloat16, device=device) * 0.02\n    \n    return {\n        \"language_hidden_states\": language_hidden_states,\n        \"vision_hidden_states\": vision_hidden_states,\n        \"language_position_ids\": language_position_ids,\n        \"vision_grid_thw\": vision_grid_thw,\n        \"q_proj_weight\": q_proj_weight,\n        \"q_proj_bias\": q_proj_bias,\n        \"k_proj_weight\": k_proj_weight,\n        \"k_proj_bias\": k_proj_bias,\n        \"v_proj_weight\": v_proj_weight,\n        \"v_proj_bias\": v_proj_bias,\n        \"o_proj_weight\": o_proj_weight,\n    }\n\n\n@torch.no_grad()\ndef run(\n    language_hidden_states: torch.Tensor,\n    vision_hidden_states: torch.Tensor,\n    language_position_ids: torch.Tensor,\n    vision_grid_thw: torch.Tensor,\n    q_proj_weight: torch.Tensor,\n    q_proj_bias: torch.Tensor,\n    k_proj_weight: torch.Tensor,\n    k_proj_bias: torch.Tensor,\n    v_proj_weight: torch.Tensor,\n    v_proj_bias: torch.Tensor,\n    o_proj_weight: torch.Tensor,\n):\n    # Constants\n    hidden_size = 4096\n    num_attention_heads = 32\n    num_key_value_heads = 8\n    head_dim = 128\n    num_kv_groups = num_attention_heads // num_key_value_heads\n    rope_theta = 10000.0\n    \n    batch_size, lang_seq_len, _ = language_hidden_states.shape\n    vision_seq_len = vision_hidden_states.shape[1]\n    \n    # Compute RoPE inverse frequencies\n    inv_freq_1d = 1.0 / (rope_theta ** (torch.arange(0, head_dim, 2, dtype=torch.float32, device=language_hidden_states.device) / head_dim))\n    # For 3D RoPE: head_dim=128, split into 3 parts of ~42/43 each\n    # We use 42, 42, 44 split (42+42+44=128)\n    dim_t = 42\n    dim_h = 42\n    dim_w = 44\n    inv_freq_t = 1.0 / (rope_theta ** (torch.arange(0, dim_t, 2, dtype=torch.float32, device=language_hidden_states.device) / dim_t))\n    inv_freq_h = 1.0 / (rope_theta ** (torch.arange(0, dim_h, 2, dtype=torch.float32, device=language_hidden_states.device) / dim_h))\n    inv_freq_w = 1.0 / (rope_theta ** (torch.arange(0, dim_w, 2, dtype=torch.float32, device=language_hidden_states.device) / dim_w))\n    \n    def rotate_half(x):\n        x1 = x[..., : x.shape[-1] // 2]\n        x2 = x[..., x.shape[-1] // 2 :]\n        return torch.cat([-x2, x1], dim=-1)\n    \n    def apply_rotary_pos_emb_1d(q, position_ids, inv_freq):\n        # q: (batch, num_heads, seq_len, head_dim)\n        # position_ids: (batch, seq_len)\n        position_ids_expanded = position_ids.unsqueeze(1).unsqueeze(-1).float()  # (batch, 1, seq_len, 1)\n        freqs = position_ids_expanded * inv_freq  # (batch, 1, seq_len, head_dim//2)\n        emb = torch.cat([freqs, freqs], dim=-1)  # (batch, 1, seq_len, head_dim)\n        cos = emb.cos().to(q.dtype)\n        sin = emb.sin().to(q.dtype)\n        return (q * cos) + (rotate_half(q) * sin)\n    \n    def apply_rotary_pos_emb_3d(k, vision_grid_thw, inv_freq_t, inv_freq_h, inv_freq_w, dim_t, dim_h, dim_w):\n        # k: (batch, num_kv_heads, vision_seq_len, head_dim)\n        # vision_grid_thw: (batch, vision_seq_len, 3)\n        batch_size, num_heads, seq_len, head_dim = k.shape\n        \n        # Split k into t, h, w parts\n        k_t = k[..., :dim_t]  # (batch, num_heads, seq_len, dim_t)\n        k_h = k[..., dim_t:dim_t+dim_h]  # (batch, num_heads, seq_len, dim_h)\n        k_w = k[..., dim_t+dim_h:]  # (batch, num_heads, seq_len, dim_w)\n        \n        t_pos = vision_grid_thw[..., 0]  # (batch, seq_len)\n        h_pos = vision_grid_thw[..., 1]\n        w_pos = vision_grid_thw[..., 2]\n        \n        def apply_1d_rope_component(x, pos, inv_freq):\n            # x: (batch, num_heads, seq_len, dim)\n            # pos: (batch, seq_len)\n            # inv_freq: (dim//2,)\n            pos_expanded = pos.unsqueeze(1).unsqueeze(-1).float()  # (batch, 1, seq_len, 1)\n            freqs = pos_expanded * inv_freq  # (batch, 1, seq_len, dim//2)\n            emb = torch.cat([freqs, freqs], dim=-1)  # (batch, 1, seq_len, dim)\n            cos = emb.cos().to(x.dtype)\n            sin = emb.sin().to(x.dtype)\n            return (x * cos) + (rotate_half(x) * sin)\n        \n        k_t_rotated = apply_1d_rope_component(k_t, t_pos, inv_freq_t)\n        k_h_rotated = apply_1d_rope_component(k_h, h_pos, inv_freq_h)\n        k_w_rotated = apply_1d_rope_component(k_w, w_pos, inv_freq_w)\n        \n        return torch.cat([k_t_rotated, k_h_rotated, k_w_rotated], dim=-1)\n    \n    def repeat_kv(hidden_states, n_rep):\n        if n_rep == 1:\n            return hidden_states\n        batch, num_kv_heads, slen, head_dim = hidden_states.shape\n        hidden_states = hidden_states[:, :, None, :, :].expand(batch, num_kv_heads, n_rep, slen, head_dim)\n        return hidden_states.reshape(batch, num_kv_heads * n_rep, slen, head_dim)\n    \n    # Project queries from language tokens\n    query_states = F.linear(language_hidden_states, q_proj_weight, q_proj_bias)\n    query_states = query_states.view(batch_size, lang_seq_len, num_attention_heads, head_dim).transpose(1, 2)\n    \n    # Project keys and values from vision tokens\n    key_states = F.linear(vision_hidden_states, k_proj_weight, k_proj_bias)\n    value_states = F.linear(vision_hidden_states, v_proj_weight, v_proj_bias)\n    \n    key_states = key_states.view(batch_size, vision_seq_len, num_key_value_heads, head_dim).transpose(1, 2)\n    value_states = value_states.view(batch_size, vision_seq_len, num_key_value_heads, head_dim).transpose(1, 2)\n    \n    # Apply rotary position embeddings\n    query_states = apply_rotary_pos_emb_1d(query_states, language_position_ids, inv_freq_1d)\n    key_states = apply_rotary_pos_emb_3d(key_states, vision_grid_thw, inv_freq_t, inv_freq_h, inv_freq_w, dim_t, dim_h, dim_w)\n    \n    # Repeat k/v heads for GQA\n    key_states = repeat_kv(key_states, num_kv_groups)\n    value_states = repeat_kv(value_states, num_kv_groups)\n    \n    # Compute attention scores\n    attn_weights = torch.matmul(query_states, key_states.transpose(2, 3)) / math.sqrt(head_dim)\n    \n    # Softmax\n    attn_weights = F.softmax(attn_weights, dim=-1, dtype=torch.float32).to(query_states.dtype)\n    \n    # Compute attention output\n    attn_output = torch.matmul(attn_weights, value_states)\n    \n    # Reshape and project output\n    attn_output = attn_output.transpose(1, 2).contiguous()\n    attn_output = attn_output.view(batch_size, lang_seq_len, num_attention_heads * head_dim)\n    output = F.linear(attn_output, o_proj_weight)\n    \n    return output\n{\"uuid\": \"d48e8b5b-db2e-598e-9168-8e5c1b78d484\", \"axes\": {\"batch_size\": 2, \"lang_seq_len\": 256, \"vision_seq_len\": 392}, \"inputs\": {\"language_hidden_states\": {\"type\": \"custom\"}, \"vision_hidden_states\": {\"type\": \"custom\"}, \"language_position_ids\": {\"type\": \"custom\"}, \"vision_grid_thw\": {\"type\": \"custom\"}, \"q_proj_weight\": {\"type\": \"custom\"}, \"q_proj_bias\": {\"type\": \"custom\"}, \"k_proj_weight\": {\"type\": \"custom\"}, \"k_proj_bias\": {\"type\": \"custom\"}, \"v_proj_weight\": {\"type\": \"custom\"}, \"v_proj_bias\": {\"type\": \"custom\"}, \"o_proj_weight\": {\"type\": \"custom\"}}, \"tolerance\": {\"max_atol\": 0.002163409358068069, \"max_rtol\": 0.0078125, \"required_matched_ratio\": 0.99, \"_provenance\": \"max run-to-run error over 10 seeds x 1.25 margin, floored at torch.bfloat16 epsilon\"}}\n{\"uuid\": \"309f06b4-c228-566d-9095-9685ea1e3666\", \"axes\": {\"batch_size\": 64, \"lang_seq_len\": 256, \"vision_seq_len\": 392}, \"inputs\": {\"language_hidden_states\": {\"type\": \"custom\"}, \"vision_hidden_states\": {\"type\": \"custom\"}, \"language_position_ids\": {\"type\": \"custom\"}, \"vision_grid_thw\": {\"type\": \"custom\"}, \"q_proj_weight\": {\"type\": \"custom\"}, \"q_proj_bias\": {\"type\": \"custom\"}, \"k_proj_weight\": {\"type\": \"custom\"}, \"k_proj_bias\": {\"type\": \"custom\"}, \"v_proj_weight\": {\"type\": \"custom\"}, \"v_proj_bias\": {\"type\": \"custom\"}, \"o_proj_weight\": {\"type\": \"custom\"}}, \"tolerance\": {\"max_atol\": 0.0021522100856183318, \"max_rtol\": 0.0078125, \"required_matched_ratio\": 0.99, \"_provenance\": \"max run-to-run error over 10 seeds x 1.25 margin, floored at torch.bfloat16 epsilon\"}}\n{\"uuid\": \"89ec0f7e-c392-5e20-be12-d966a31af92b\", \"axes\": {\"batch_size\": 1, \"lang_seq_len\": 512, \"vision_seq_len\": 784}, \"input