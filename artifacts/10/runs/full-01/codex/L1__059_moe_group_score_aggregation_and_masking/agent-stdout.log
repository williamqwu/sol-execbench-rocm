{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' reference.py && sed -n '1,260p' definition.json && sed -n '1,260p' workload.jsonl\"","aggregated_output":"import torch\n\n@torch.no_grad()\ndef run(scores: torch.Tensor):\n    \"\"\"\n    Group-based score aggregation and masking for MoE routing.\n    \n    Args:\n        scores: Shape (num_tokens, 256) - expert scores after sigmoid activation\n        \n    Returns:\n        masked_scores: Shape (num_tokens, 256) - scores with non-selected groups masked\n        group_mask: Shape (num_tokens, 8) - binary mask of selected groups\n    \"\"\"\n    num_experts = 256\n    n_group = 8\n    topk_group = 4\n    experts_per_group = num_experts // n_group  # 32\n    \n    num_tokens = scores.size(0)\n    \n    # Reshape scores into groups: (num_tokens, 8, 32)\n    group_scores_reshaped = scores.view(num_tokens, n_group, experts_per_group)\n    \n    # Compute top-2 scores per group and sum them: (num_tokens, 8, 2) -> (num_tokens, 8)\n    # This aggregates group quality by summing the two best experts in each group\n    top2_per_group = torch.topk(group_scores_reshaped, k=2, dim=-1)[0]  # (num_tokens, 8, 2)\n    group_scores = top2_per_group.sum(dim=-1)  # (num_tokens, 8)\n    \n    # Select top 4 groups based on aggregated scores\n    # group_idx: (num_tokens, 4) - indices of selected groups\n    group_idx = torch.topk(group_scores, k=topk_group, dim=-1, sorted=False)[1]\n    \n    # Create binary mask for selected groups: (num_tokens, 8)\n    group_mask = torch.zeros_like(group_scores)\n    group_mask.scatter_(1, group_idx, 1)\n    \n    # Expand group mask to expert-level mask\n    # (num_tokens, 8) -> (num_tokens, 8, 1) -> (num_tokens, 8, 32) -> (num_tokens, 256)\n    score_mask = (\n        group_mask.unsqueeze(-1)\n        .expand(num_tokens, n_group, experts_per_group)\n        .reshape(num_tokens, num_experts)\n    )\n    \n    # Apply mask: set non-selected experts to 0 for subsequent topk (don't use -inf since output tensors must contain finite values only)\n    masked_scores = scores.masked_fill(~score_mask.bool(), float('-inf'))\n    \n    return masked_scores, group_mask\n{\n  \"name\": \"059_moe_group_score_aggregation_and_masking\",\n  \"description\": \"Group-based score aggregation and masking for MoE routing. Reshapes 256 expert scores into 8 groups of 32 experts each, computes group scores by summing top-2 expert scores within each group, selects top 4 groups, creates and expands group mask to expert-level, and applies masked_fill to suppress non-selected experts with -inf. This reduces the expert search space from 256 to ~128 experts before final topk selection.\",\n  \"hf_id\": \"inclusionAI/Ling-mini-2.0\",\n  \"custom_inputs_entrypoint\": null,\n  \"axes\": {\n    \"num_tokens\": {\n      \"type\": \"var\",\n      \"description\": \"Number of tokens being routed\"\n    },\n    \"num_experts\": {\n      \"type\": \"const\",\n      \"value\": 256,\n      \"description\": \"Total number of experts\"\n    },\n    \"n_group\": {\n      \"type\": \"const\",\n      \"value\": 8,\n      \"description\": \"Number of expert groups\"\n    },\n    \"topk_group\": {\n      \"type\": \"const\",\n      \"value\": 4,\n      \"description\": \"Number of groups to select\"\n    },\n    \"experts_per_group\": {\n      \"type\": \"expr\",\n      \"expression\": \"num_experts // n_group\",\n      \"description\": \"Number of experts per group (32)\"\n    }\n  },\n  \"inputs\": {\n    \"scores\": {\n      \"shape\": [\n        \"num_tokens\",\n        \"num_experts\"\n      ],\n      \"dtype\": \"float32\",\n      \"description\": \"Expert scores after sigmoid activation\"\n    }\n  },\n  \"outputs\": {\n    \"masked_scores\": {\n      \"shape\": [\n        \"num_tokens\",\n        \"num_experts\"\n      ],\n      \"dtype\": \"float32\",\n      \"description\": \"Scores with non-selected groups masked to -inf\"\n    },\n    \"group_mask\": {\n      \"shape\": [\n        \"num_tokens\",\n        \"n_group\"\n      ],\n      \"dtype\": \"float32\",\n      \"description\": \"Binary mask indicating selected groups\"\n    }\n  },\n  \"reference\": \"import torch\\n\\n@torch.no_grad()\\ndef run(scores: torch.Tensor):\\n    \\\"\\\"\\\"\\n    Group-based score aggregation and masking for MoE routing.\\n    \\n    Args:\\n        scores: Shape (num_tokens, 256) - expert scores after sigmoid activation\\n        \\n    Returns:\\n        masked_scores: Shape (num_tokens, 256) - scores with non-selected groups masked\\n        group_mask: Shape (num_tokens, 8) - binary mask of selected groups\\n    \\\"\\\"\\\"\\n    num_experts = 256\\n    n_group = 8\\n    topk_group = 4\\n    experts_per_group = num_experts // n_group  # 32\\n    \\n    num_tokens = scores.size(0)\\n    \\n    # Reshape scores into groups: (num_tokens, 8, 32)\\n    group_scores_reshaped = scores.view(num_tokens, n_group, experts_per_group)\\n    \\n    # Compute top-2 scores per group and sum them: (num_tokens, 8, 2) -> (num_tokens, 8)\\n    # This aggregates group quality by summing the two best experts in each group\\n    top2_per_group = torch.topk(group_scores_reshaped, k=2, dim=-1)[0]  # (num_tokens, 8, 2)\\n    group_scores = top2_per_group.sum(dim=-1)  # (num_tokens, 8)\\n    \\n    # Select top 4 groups based on aggregated scores\\n    # group_idx: (num_tokens, 4) - indices of selected groups\\n    group_idx = torch.topk(group_scores, k=topk_group, dim=-1, sorted=False)[1]\\n    \\n    # Create binary mask for selected groups: (num_tokens, 8)\\n    group_mask = torch.zeros_like(group_scores)\\n    group_mask.scatter_(1, group_idx, 1)\\n    \\n    # Expand group mask to expert-level mask\\n    # (num_tokens, 8) -> (num_tokens, 8, 1) -> (num_tokens, 8, 32) -> (num_tokens, 256)\\n    score_mask = (\\n        group_mask.unsqueeze(-1)\\n        .expand(num_tokens, n_group, experts_per_group)\\n        .reshape(num_tokens, num_experts)\\n    )\\n    \\n    # Apply mask: set non-selected experts to 0 for subsequent topk (don't use -inf since output tensors must contain finite values only)\\n    masked_scores = scores.masked_fill(~score_mask.bool(), float('-inf'))\\n    \\n    return masked_scores, group_mask\\n\"\n}\n{\"uuid\": \"46f8503f-f88f-5ce0-b459-7047fe9b7259\", \"axes\": {\"num_tokens\": 1163}, \"inputs\": {\"scores\": {\"type\": \"random\"}}, \"tolerance\": {\"max_atol\": 1.2320305748137874e-07, \"max_rtol\": 1.1920928955078125e-07, \"required_matched_ratio\": 0.99, \"allow_negative_inf\": true, \"_provenance\": \"max run-to-run error over 10 seeds x 1.25 margin, floored at torch.float32 epsilon\"}}\n{\"uuid\": \"59da4e6e-60da-5c03-8948-acd10634af91\", \"axes\": {\"num_tokens\": 8192}, \"inputs\": {\"scores\": {\"type\": \"random\"}}, \"tolerance\": {\"max_atol\": 1.2346565643701177e-07, \"max_rtol\": 1.1920928955078125e-07, \"required_matched_ratio\": 0.99, \"allow_negative_inf\": true, \"_provenance\": \"max run-to-run error over 10 seeds x 1.25 margin, floored at torch.float32 epsilon\"}}\n{\"uuid\": \"7472116c-d159-58dd-8238-3141a3a2cb9f\", \"axes\": {\"num_tokens\": 2521}, \"inputs\": {\"scores\": {\"type\": \"random\"}}, \"tolerance\": {\"max_atol\": 1.2327266289967894e-07, \"max_rtol\": 1.1920928955078125e-07, \"required_matched_ratio\": 0.99, \"allow_negative_inf\": true, \"_provenance\": \"max run-to-run error over 10 seeds x 1.25 margin, floored at torch.float32 epsilon\"}}\n{\"uuid\": \"91e9f4b6-0196-5316-8921-405cddfde0bd\", \"axes\": {\"num_tokens\": 997}, \"inputs\": {\"scores\": {\"type\": \"random\"}}, \"tolerance\": {\"max_atol\": 1.2323866076401556e-07, \"max_rtol\": 1.1920928955078125e-07, \"required_matched_ratio\": 0.99, \"allow_negative_inf\": true, \"_provenance\": \"max run-to-run error over 10 seeds x 1.25 margin, floored at torch.float32 epsilon\"}}\n{\"uuid\": \"608832bb-1d42-582d-ba2d-d88f15bddf2d\", \"axes\": {\"num_tokens\": 64}, \"inputs\": {