{"type":"item.completed","item":{"id":"item_37","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' kernel.py && sed -n '1,160p' solution.json\"","aggregated_output":"import torch\nimport triton\nimport triton.language as tl\n\n\n@triton.jit\ndef _merge_top2(a0, a1, b0, b1):\n    hi = tl.maximum(a0, b0)\n    lo = tl.maximum(tl.minimum(a0, b0), tl.maximum(a1, b1))\n    return hi, lo\n\n\n@triton.jit\ndef _moe_group_mask_kernel(scores, masked_scores, group_mask, n_tokens: tl.constexpr):\n    token = tl.program_id(0)\n\n    expert = tl.arange(0, 256)\n    values = tl.load(scores + token * 256 + expert)\n    grouped = tl.reshape(values, (8, 32))\n\n    # Carry the two largest values through one exact tree reduction.\n    first, second = tl.reduce(\n        (grouped, tl.full((8, 32), -float(\"inf\"), tl.float32)),\n        axis=1,\n        combine_fn=_merge_top2,\n    )\n    quality = first + second\n\n    group = tl.arange(0, 8)\n    idx0 = tl.argmax(quality, axis=0)\n    quality = tl.where(group == idx0, -float(\"inf\"), quality)\n    idx1 = tl.argmax(quality, axis=0)\n    quality = tl.where(group == idx1, -float(\"inf\"), quality)\n    idx2 = tl.argmax(quality, axis=0)\n    quality = tl.where(group == idx2, -float(\"inf\"), quality)\n    idx3 = tl.argmax(quality, axis=0)\n    selected_groups = (\n        (group == idx0) | (group == idx1) | (group == idx2) | (group == idx3)\n    )\n    tl.store(group_mask + token * 8 + group, selected_groups.to(tl.float32))\n\n    selected_experts = tl.reshape(\n        tl.broadcast_to(selected_groups[:, None], (8, 32)), (256,)\n    )\n    result = tl.where(selected_experts, values, -float(\"inf\"))\n    tl.store(masked_scores + token * 256 + expert, result)\n\n\n@triton.jit\ndef _moe_group_mask_tiled_kernel(\n    scores, masked_scores, group_mask, n_tokens: tl.constexpr, BLOCK_T: tl.constexpr\n):\n    token = tl.program_id(0) * BLOCK_T + tl.arange(0, BLOCK_T)\n    expert = tl.arange(0, 256)\n    valid = token < n_tokens\n\n    values = tl.load(\n        scores + token[:, None] * 256 + expert[None, :],\n        mask=valid[:, None],\n        other=-float(\"inf\"),\n    )\n    grouped = tl.reshape(values, (BLOCK_T, 8, 32))\n\n    first_idx = tl.argmax(grouped, axis=2)\n    lane = tl.arange(0, 32)[None, None, :]\n    first = tl.max(grouped, axis=2)\n    second = tl.max(\n        tl.where(lane == first_idx[:, :, None], -float(\"inf\"), grouped), axis=2\n    )\n    quality = first + second\n\n    group = tl.arange(0, 8)\n    idx0 = tl.argmax(quality, axis=1)\n    quality = tl.where(group[None, :] == idx0[:, None], -float(\"inf\"), quality)\n    idx1 = tl.argmax(quality, axis=1)\n    quality = tl.where(group[None, :] == idx1[:, None], -float(\"inf\"), quality)\n    idx2 = tl.argmax(quality, axis=1)\n    quality = tl.where(group[None, :] == idx2[:, None], -float(\"inf\"), quality)\n    idx3 = tl.argmax(quality, axis=1)\n\n    selected_groups = (\n        (group[None, :] == idx0[:, None])\n        | (group[None, :] == idx1[:, None])\n        | (group[None, :] == idx2[:, None])\n        | (group[None, :] == idx3[:, None])\n    )\n    tl.store(\n        group_mask + token[:, None] * 8 + group[None, :],\n        selected_groups.to(tl.float32),\n        mask=valid[:, None],\n    )\n\n    expert_group = expert // 32\n    selected_experts = (\n        (expert_group[None, :] == idx0[:, None])\n        | (expert_group[None, :] == idx1[:, None])\n        | (expert_group[None, :] == idx2[:, None])\n        | (expert_group[None, :] == idx3[:, None])\n    )\n    result = tl.where(selected_experts, values, -float(\"inf\"))\n    tl.store(\n        masked_scores + token[:, None] * 256 + expert[None, :],\n        result,\n        mask=valid[:, None],\n    )\n\n\ndef run(scores: torch.Tensor):\n    n_tokens = scores.shape[0]\n    masked_scores = torch.empty_like(scores)\n    group_mask = torch.empty((n_tokens, 8), device=scores.device, dtype=torch.float32)\n    _moe_group_mask_kernel[(n_tokens,)](\n        scores,\n        masked_scores,\n        group_mask,\n        n_tokens,\n        num_warps=1,\n    )\n    return masked_scores, group_mask\n{\n  \"name\": \"059_moe_group_score_aggregation_and_masking_agent\",\n  \"definition\": \"059_moe_group_score_aggregation_and_masking\",\n  \"author\": \"agent\",\n  \"spec\": {\n    \"languages\": [\"triton\"],\n    \"target_hardware\": [\"MI355X\", \"LOCAL\"],\n    \"entry_point\": \"kernel.py::run\",\n    \"dependencies\": [\"torch\", \"triton\"],\n    \"destination_passing_style\": false\n  },\n  \"sources\": [\n    {\"path\": \"kernel.py\", \"content\": \"\"}\n  ]\n}\n","exit_code":0,"status":"completed"}}
