{"type":"item.started","item":{"id":"item_72","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch,triton.language as tl\nfrom aiter.ops.triton.moe.moe_op import fused_moe\nfrom aiter.ops.triton.moe.moe_align_block_size import moe_align_block_size_triton\n\ntorch.manual_seed(22);d='cuda';E=512;H=2048;I=512;T=3328;K=10\nx=torch.randn(T,H,device=d,dtype=torch.bfloat16);inter=torch.randn(T*K,I,device=d,dtype=torch.bfloat16);g=torch.randn(E,I,H,device=d,dtype=torch.bfloat16)*.02;down=torch.randn(E,H,I,device=d,dtype=torch.bfloat16)*.02;ids=torch.randint(0,E,(T,K),device=d,dtype=torch.int32);w=torch.rand(T,K,device=d);w/=w.sum(1,keepdim=True)\ncs=[\n('m32n64k32g8w4',32,64,32,8,4,2,None,None),\n('m32n64k64g1w4',32,64,64,1,4,2,1,1),\n('m32n128k32g8w4',32,128,32,8,4,2,None,None),\n('m32n128k64g1w4',32,128,64,1,4,2,1,1),\n('m32n256k64g1w8',32,256,64,1,8,2,1,1),\n('m64n64k64g1w4',64,64,64,1,4,2,1,1),\n('m64n128k64g1w4',64,128,64,1,4,2,1,1),\n('m128n128k128g1w4',128,128,128,1,4,1,2,1),\n('m256n256k64g8w8',256,256,64,8,8,2,0,1),\n]\nfor name,bm,bn,bk,gm,nw,ns,wave,kpack in cs:\n conf={'BLOCK_SIZE_M':bm,'BLOCK_SIZE_N':bn,'BLOCK_SIZE_K':bk,'GROUP_SIZE_M':gm,'num_warps':nw,'num_stages':ns}\n if wave is not None:conf.update(waves_per_eu=wave,matrix_instr_nonkdim=16,kpack=kpack)\n mp=ids.numel()+E*bm;sid=torch.full((mp,),ids.numel(),device=d,dtype=torch.int32);eid=torch.empty((mp+bm-1)//bm,device=d,dtype=torch.int32);np=torch.empty(1,device=d,dtype=torch.int32);moe_align_block_size_triton(ids,E,bm,sid,eid,np);og=torch.empty(T,K,I,device=d,dtype=torch.bfloat16);od=torch.empty(T*K,1,H,device=d,dtype=torch.bfloat16)\n def mm(A,B,C,tk):fused_moe(A,B,C,None,None,None,w,ids,sid,eid,np,False,tk,tl.float32,False,False,False,None,conf)\n try:\n  mm(x,g,og,K);mm(inter,down,od,1);torch.cuda.synchronize();times=[]\n  for A,B,C,tk in [(x,g,og,K),(inter,down,od,1)]:\n   a=torch.cuda.Event(True);b=torch.cuda.Event(True);a.record()\n   for _ in range(30):mm(A,B,C,tk)\n   b.record();b.synchronize();times.append(a.elapsed_time(b)/30)\n  print(name,'pad',np.item(),'gate',round(times[0],4),'down',round(times[1],4),'sum3',round(2*times[0]+times[1],4))\n except Exception as e:print(name,'FAIL',type(e).__name__,e)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
