{"type":"item.started","item":{"id":"item_32","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch, torch.nn.functional as F, time\nimport kernel\nfrom aiter.fused_moe import fused_moe\n\ntorch.manual_seed(123); d='cuda'; E=512; H=2048; I=512; K=10\nrw=torch.randn(E,H,device=d,dtype=torch.bfloat16)*.02\ng=torch.randn(E,I,H,device=d,dtype=torch.bfloat16)*.02\nu=torch.randn(E,I,H,device=d,dtype=torch.bfloat16)*.02\ndown=torch.randn(E,H,I,device=d,dtype=torch.bfloat16)*.02\nsg=torch.randn(I,H,device=d,dtype=torch.bfloat16)*.02\nsu=torch.randn(I,H,device=d,dtype=torch.bfloat16)*.02\nsd=torch.randn(H,I,device=d,dtype=torch.bfloat16)*.02\nsw=torch.randn(1,H,device=d,dtype=torch.bfloat16)*.02\n\ndef cand(x, marks=False):\n ev=[torch.cuda.Event(True) for _ in range(7)] if marks else None\n if ev: ev[0].record()\n logits=x@rw.T\n probs=F.softmax(logits.float(),dim=1); w,ids=torch.topk(probs,K,dim=-1)\n w=(w/w.sum(-1,keepdim=True)).to(torch.bfloat16)\n if ev: ev[1].record()\n w1=torch.cat((g,u),dim=1)\n if ev: ev[2].record()\n out=fused_moe(x,w1,down,w.float(),ids.int())\n if ev: ev[3].record()\n go=x@sg.T; up=x@su.T\n if ev: ev[4].record()\n inter=(go*torch.sigmoid(go))*up; sh=inter@sd.T\n if ev: ev[5].record()\n sh=torch.sigmoid(x@sw.T)*sh; out=out+sh\n if ev:\n  ev[6].record(); ev[-1].synchronize(); print('parts', [round(ev[i].elapsed_time(ev[i+1]),3) for i in range(6)])\n return out,logits.to(torch.bfloat16)\n\nT=3328; x=torch.randn(T,H,device=d,dtype=torch.bfloat16)\nargs=(x.view(1,T,H),rw,g,u,down,sg,su,sd,sw)\nprint('warm candidate'); co,cl=cand(x); torch.cuda.synchronize(); cand(x,True)\nprint('warm grouped'); go,gl=kernel.run(*args); torch.cuda.synchronize()\nclose=torch.isclose(co,go.view(T,H),atol=.0044,rtol=.0078125)\nprint('diff cand/group', (co-go.view(T,H)).abs().max().item(), close.float().mean().item(), 'mag',go.abs().mean().item())\nfor name,fn in [('cand',lambda:cand(x)),('group',lambda:kernel.run(*args))]:\n for _ in range(2): fn()\n torch.cuda.synchronize(); a=torch.cuda.Event(True);b=torch.cuda.Event(True);a.record()\n for _ in range(5): z=fn()\n b.record();b.synchronize();print(name,'ms',a.elapsed_time(b)/5)\nfor T in [8192,39232]:\n x2=torch.randn(T,H,device=d,dtype=torch.bfloat16)\n cand(x2);torch.cuda.synchronize();a=torch.cuda.Event(True);b=torch.cuda.Event(True);a.record()\n for _ in range(3):z=cand(x2)\n b.record();b.synchronize();print('cand T',T,'ms',a.elapsed_time(b)/3); del x2,z\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
