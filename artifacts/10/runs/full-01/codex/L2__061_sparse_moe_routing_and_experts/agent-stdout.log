{"type":"item.started","item":{"id":"item_43","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch\nimport aiter\nfrom aiter.fused_moe import moe_sorting, ck_moe_stage1, ck_moe_stage2, ActivationType\n\ntorch.manual_seed(7);d='cuda';E=1;H=2048;I=512;T=64;K=1\nx=torch.randn(T,H,device=d,dtype=torch.bfloat16);g=torch.randn(E,I,H,device=d,dtype=torch.bfloat16)*.02;u=torch.randn(E,I,H,device=d,dtype=torch.bfloat16)*.02;down=torch.randn(E,H,I,device=d,dtype=torch.bfloat16)*.02\nids=torch.zeros(T,K,device=d,dtype=torch.int32);w=torch.ones(T,K,device=d,dtype=torch.float32);w1=torch.cat((g,u),1)\nsid,sw,se,nv,buf=moe_sorting(ids,w,E,H,torch.bfloat16,block_size=32)\na2=torch.empty(T,K,I,device=d,dtype=torch.bfloat16)\no=ck_moe_stage1(x,w1,down,sid,se,nv,a2,K,32,None,None,activation=ActivationType.Silu)\ntorch.cuda.synchronize()\ngg=x@g[0].T;uu=x@u[0].T;ri=(gg*torch.sigmoid(gg))*uu\nfor label,z in [('stage1',o.view(T,I))]:\n diff=(z-ri).float();cos=torch.nn.functional.cosine_similarity(z.float().flatten(),ri.float().flatten(),dim=0);print(label,z.abs().mean().item(),ri.abs().mean().item(),diff.abs().max().item(),diff.abs().mean().item(),cos.item())\n# Feed correct reference intermediate to stage2.\nfinal=torch.empty(T,H,device=d,dtype=torch.bfloat16)\nck_moe_stage2(ri.view(T,K,I),w1,down,sid,se,nv,final,K,32,None,None,activation=ActivationType.Silu,sorted_weights=sw)\ntorch.cuda.synchronize(); rr=ri@down[0].T;diff=(final-rr).float();cos=torch.nn.functional.cosine_similarity(final.float().flatten(),rr.float().flatten(),dim=0);print('stage2',final.abs().mean().item(),rr.abs().mean().item(),diff.abs().max().item(),diff.abs().mean().item(),cos.item())\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
