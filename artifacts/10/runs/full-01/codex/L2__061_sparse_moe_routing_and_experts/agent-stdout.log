{"type":"item.started","item":{"id":"item_30","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch, time\nfrom aiter.fused_moe import fused_moe\n\ntorch.manual_seed(1); d='cuda'; E=512; H=2048; I=512; T=64; K=10\nx=torch.randn(T,H,device=d,dtype=torch.bfloat16)*.01\ng=torch.randn(E,I,H,device=d,dtype=torch.bfloat16)*.01\nu=torch.randn(E,I,H,device=d,dtype=torch.bfloat16)*.01\ndown=torch.randn(E,H,I,device=d,dtype=torch.bfloat16)*.01\nscores=torch.rand(T,E,device=d)\nw,ids=torch.topk(scores,K,dim=-1)\nw=(w/w.sum(-1,keepdim=True)).to(torch.bfloat16)\nw1=torch.cat((g,u),dim=1)\nprint('prepared',w1.shape,ids.dtype,w.dtype)\nfor idtype in [torch.int64,torch.int32]:\n try:\n  torch.cuda.synchronize(); t=time.time()\n  out=fused_moe(x,w1,down,w,ids.to(idtype))\n  torch.cuda.synchronize(); print('ok',idtype,out.shape,out.dtype,'compile_sec',time.time()-t,'mag',out.abs().mean().item())\n  ref=torch.zeros(T,H,device=d,dtype=torch.bfloat16)\n  for e in range(E):\n   pos,tok=torch.where(ids.T==e)\n   if tok.numel():\n    xx=x[tok]; gg=xx@g[e].T; uu=xx@u[e].T\n    yy=(gg*torch.sigmoid(gg)*uu)@down[e].T\n    ref.index_add_(0,tok,yy*w[tok,pos,None])\n  close=torch.isclose(out,ref,atol=.0044,rtol=.0078125)\n  print('diff', (out-ref).abs().max().item(), close.float().mean().item(), torch.equal(out,ref))\n except Exception as e: print('FAIL',idtype,type(e).__name__,e)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
