{"type":"item.started","item":{"id":"item_34","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch\nfrom aiter.fused_moe import fused_moe\n\ntorch.manual_seed(4);d='cuda';E=16;H=2048;I=512;T=64;K=10\nx=torch.randn(T,H,device=d,dtype=torch.bfloat16)\ng=torch.randn(E,I,H,device=d,dtype=torch.bfloat16)*.02\nu=torch.randn(E,I,H,device=d,dtype=torch.bfloat16)*.02\ndown=torch.randn(E,H,I,device=d,dtype=torch.bfloat16)*.02\ns=torch.rand(T,E,device=d);w,ids=torch.topk(s,K);w_bf=(w/w.sum(-1,keepdim=True)).bfloat16();w=w_bf.float();ids=ids.int()\nref=torch.zeros(T,H,device=d,dtype=torch.bfloat16)\nfor expert in range(E):\n pos,tok=torch.where(ids.T==expert)\n if tok.numel():\n  xx=x[tok];gg=xx@g[expert].T;uu=xx@u[expert].T\n  yy=((gg*torch.sigmoid(gg))*uu)@down[expert].T\n  ref.index_add_(0,tok,yy*w_bf[tok,pos,None])\nprint('ref',ref.abs().mean().item(),ref.square().float().mean().sqrt().item())\nvariants=[('gu_sep',torch.cat((g,u),1),'separated'),('ug_sep',torch.cat((u,g),1),'separated'),('gu_int',torch.stack((g,u),2).flatten(1,2),'interleave'),('ug_int',torch.stack((u,g),2).flatten(1,2),'interleave')]\nfor name,w1,mode in variants:\n try:\n  o=fused_moe(x,w1,down,w,ids,gate_mode=mode);torch.cuda.synchronize()\n  diff=(o-ref).float(); close=torch.isclose(o,ref,atol=.0044,rtol=.0078125)\n  cos=torch.nn.functional.cosine_similarity(o.float().flatten(),ref.float().flatten(),dim=0)\n  print(name,'mag',o.abs().mean().item(),'max',diff.abs().max().item(),'mae',diff.abs().mean().item(),'ratio',close.float().mean().item(),'cos',cos.item())\n except Exception as e: print(name,'FAIL',type(e).__name__,e)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
