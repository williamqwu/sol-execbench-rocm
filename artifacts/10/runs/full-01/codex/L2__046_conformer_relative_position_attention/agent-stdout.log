{"type":"item.started","item":{"id":"item_36","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport torch,triton\nimport kernel\nsc=.08838834764831845\nfor B,S,ubm,ubn in [(4,541,16,32),(8,773,64,16)]:\n q=torch.randn(B,S,1024,device='cuda',dtype=torch.bfloat16);kv=torch.randn(B,S,2048,device='cuda',dtype=torch.bfloat16);r=torch.randn(1025,128,device='cuda',dtype=torch.bfloat16);y=torch.empty_like(q);p=torch.addmm(r[:1,:1],q.view(-1,128),r[1:1024].T,beta=0,alpha=sc);rem=S%512;cap=triton.next_power_of_2(rem)\n def launch(bm,bn,grid,base,ccap):\n  kernel._projected_relative_attention[grid](q,kv,p,y,sc,SEQ_LEN=S,REL_WIDTH=1023,REL_RADIUS=511,CONTEXT_CAP=ccap,CONTEXT_BASE=base,BLOCK_M=bm,BLOCK_N=bn,num_warps=4)\n def unified():launch(ubm,ubn,(triton.cdiv(S,ubm),B*8),0,512)\n print('shape',B,S,'unified',triton.testing.do_bench(unified,warmup=8,rep=30),flush=True)\n full_configs=[(16,32),(16,64),(32,32),(32,64),(64,16),(64,32)]\n tail_configs=[(16,16),(16,32),(16,64),(32,16),(32,32),(32,64),(64,16),(64,32)]\n best=(99,None)\n for fc in full_configs:\n  for tc in tail_configs:\n   def split():\n    launch(*fc,(512//fc[0],B*8),0,512)\n    launch(*tc,(triton.cdiv(rem,tc[0]),B*8),1,cap)\n   try:t=triton.testing.do_bench(split,warmup=4,rep=12)\n   except Exception:t=99\n   if t<best[0]:best=(t,(fc,tc))\n  print(' fc',fc,'current_best',best,flush=True)\n print('BEST',best,flush=True)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
