{"type":"item.started","item":{"id":"item_43","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch, aiter, time\nD='cuda:0'; T=torch.bfloat16; M=1024; H=16384; I=53248\na=torch.empty((M,H),device=D,dtype=T); b=torch.empty((H,I),device=D,dtype=T)\naiter.hipb_create_extension(); sols=aiter.hipb_findallsols(a,b)\n# Include the reordered front plus a sparse sampling of later families.\nids=sols[:24]+[sols[i] for i in [31,63,64,95,127,191,255,383,511,767,1023,1265]]\n# torch warm/timing\ny=a@b; torch.cuda.synchronize(); del y\nfor _ in range(3):\n s=torch.cuda.Event(True);e=torch.cuda.Event(True);s.record();y=a@b;e.record();e.synchronize();print('torch',s.elapsed_time(e));del y\nbest=[]\nfor idx in ids:\n try:\n  y=aiter.hipb_mm(a,b,idx); torch.cuda.synchronize(); del y\n  s=torch.cuda.Event(True);e=torch.cuda.Event(True);s.record();y=aiter.hipb_mm(a,b,idx);e.record();e.synchronize();t=s.elapsed_time(e);del y\n  best.append((t,idx)); print(idx,t)\n except Exception as ex: print(idx,'ERR',str(ex)[:120])\nprint('BEST',sorted(best)[:10])\naiter.hipb_destroy_extension()\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
