{"type":"item.started","item":{"id":"item_23","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch, triton\nimport kernel\nD='cuda:0'; T=torch.bfloat16; M=1024; N=16384; K=53248\npair=torch.empty((2,M,K),device=D,dtype=T)\ngw=torch.empty((K,N),device=D,dtype=T); uw=torch.empty_like(gw)\nout=torch.empty((M,N),device=D,dtype=T)\nconfigs=[(32,64,32,8),(64,64,32,8),(32,128,32,8),(64,32,32,8)]\nfor bm,bn,bk,nw in configs:\n grid=(triton.cdiv(M,bm)*triton.cdiv(N,bn),)\n try:\n  kernel._fused_grad_x[grid](pair,gw,uw,out,M=M,N=N,K=K,BLOCK_M=bm,BLOCK_N=bn,BLOCK_K=bk,GROUP_M=8,num_warps=nw,num_stages=2)\n  torch.cuda.synchronize()\n  vals=[]\n  for _ in range(3):\n   s=torch.cuda.Event(True); e=torch.cuda.Event(True); s.record()\n   kernel._fused_grad_x[grid](pair,gw,uw,out,M=M,N=N,K=K,BLOCK_M=bm,BLOCK_N=bn,BLOCK_K=bk,GROUP_M=8,num_warps=nw,num_stages=2)\n   e.record(); e.synchronize(); vals.append(s.elapsed_time(e))\n  print((bm,bn,bk,nw),vals)\n except Exception as ex: print((bm,bn,bk,nw),'ERROR',type(ex).__name__,ex)\n# Vendor pair.\nfor _ in range(2):\n s=torch.cuda.Event(True); e=torch.cuda.Event(True); s.record(); a=pair[0]@gw; b=pair[1]@uw; a.add_(b); e.record(); e.synchronize(); print('vendor',s.elapsed_time(e)); del a,b\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
