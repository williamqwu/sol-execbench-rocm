{"type":"item.started","item":{"id":"item_57","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch, triton, kernel\nD='cuda:0';T=torch.bfloat16;M=4096;I=53248;n=M*I\nxs=[torch.empty(n,device=D,dtype=T) for _ in range(4)]\ngated=torch.empty(n,device=D,dtype=T);pair=torch.empty(2*n,device=D,dtype=T)\nfor block,nw in [(256,4),(512,4),(512,8),(1024,4),(1024,8),(2048,8),(2048,16)]:\n try:\n  grid=(triton.cdiv(n,block),)\n  kernel._swiglu_pointwise_backward[grid](*xs,gated,pair,n,BLOCK=block,num_warps=nw);torch.cuda.synchronize()\n  ts=[]\n  for _ in range(4):\n   s=torch.cuda.Event(True);e=torch.cuda.Event(True);s.record();kernel._swiglu_pointwise_backward[grid](*xs,gated,pair,n,BLOCK=block,num_warps=nw);e.record();e.synchronize();ts.append(s.elapsed_time(e))\n  print(block,nw,ts)\n except Exception as ex: print(block,nw,'ERR',type(ex).__name__,str(ex)[:200])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
