{"type":"item.started","item":{"id":"item_47","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport torch,triton,statistics,math\nimport kernel\nfor B,S in [(2,128),(8,256),(8,512),(1,8192)]:\n sh=lambda *x:torch.randn(x,device='cuda');q,k,v,c,s=sh(B,24,S,96),sh(B,4,S,96),sh(B,4,S,96),sh(B,S,96),sh(B,S,96);kw=sh(384,1536);vw=sh(384,1536);M=B*S;p=torch.empty(M,3072,device='cuda');w=torch.empty(2,384,1536,device='cuda');print('M',M,end=' ')\n for bl,warps in [(128,1),(128,2),(256,1),(256,2),(256,4),(512,2),(512,4),(1024,4)]:\n  slots=math.ceil(2304/bl)+2*math.ceil(384/bl);grid=max(M*slots,triton.cdiv(2*384*1536,bl))\n  def go():kernel._pack_qkv_segmented[(grid,)](q,k,v,c,s,p,kw,vw,w,seq_len=S,tokens=M,BLOCK=bl,num_warps=warps)\n  for _ in range(3):go()\n  ev=[]\n  for _ in range(50):\n   a=torch.cuda.Event(enable_timing=True);b=torch.cuda.Event(enable_timing=True);a.record();go();b.record();ev.append((a,b))\n  torch.cuda.synchronize();print((bl,warps,round(statistics.median([a.elapsed_time(b) for a,b in ev])*1000,1)),end=' ')\n print()\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
