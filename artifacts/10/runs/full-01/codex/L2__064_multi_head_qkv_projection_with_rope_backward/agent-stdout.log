{"type":"item.started","item":{"id":"item_51","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport torch,statistics\nfor M in [256,586,1024,2048,4096,8192]:\n p=torch.randn(M,3072,device='cuda');q=p[:,:2304];k=p[:,2304:2688];v=p[:,2688:];qw=torch.randn(2304,1536,device='cuda');kw=torch.randn(384,1536,device='cuda');vw=torch.randn(384,1536,device='cuda');kv=p[:,2304:].reshape(M,2,384).permute(1,0,2);kvw=torch.stack((kw,vw))\n ref=(q@qw+k@kw)+v@vw\n def adds():\n  z=q@qw;z=torch.addmm(z,k,kw);z=torch.addmm(z,v,vw);return z\n def inpl():\n  z=q@qw;torch.addmm(z,k,kw,out=z);torch.addmm(z,v,vw,out=z);return z\n def curr():\n  z=q@qw; zz=torch.bmm(kv,kvw); return z+zz[0]+zz[1]\n for name,fn in [('adds',adds),('inpl',inpl),('curr',curr)]:\n  try:\n   z=fn();torch.cuda.synchronize();eq=torch.equal(z,ref);md=(z-ref).abs().max().item()\n   for _ in range(5):o=fn()\n   es=[]\n   for _ in range(100):\n    a=torch.cuda.Event(enable_timing=True);b=torch.cuda.Event(enable_timing=True);a.record();o=fn();b.record();es.append((a,b))\n   torch.cuda.synchronize();print(M,name,eq,md,round(statistics.median([a.elapsed_time(b) for a,b in es])*1000,1))\n  except Exception as e:print(M,name,type(e).__name__,str(e)[:500])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
