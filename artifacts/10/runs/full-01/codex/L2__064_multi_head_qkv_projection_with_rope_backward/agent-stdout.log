{"type":"item.started","item":{"id":"item_45","type":"command_execution","command":"/bin/bash -lc \"TRITON_ALWAYS_COMPILE=1 python3 - <<'PY'\nimport torch,triton,statistics\nimport kernel\nfor B,S in [(2,128),(2,293),(8,256),(8,512),(1,8192)]:\n sh=lambda *x:torch.randn(x,device='cuda');q,k,v,c,s=sh(B,24,S,96),sh(B,4,S,96),sh(B,4,S,96),sh(B,S,96),sh(B,S,96);kw=sh(384,1536);vw=sh(384,1536);M=B*S;n=M*3072;le=max(n,2*384*1536);bl=256 if M==256 else 512;p0=torch.empty(M,3072,device='cuda');w0=torch.empty(2,384,1536,device='cuda');p1=torch.empty_like(p0);w1=torch.empty_like(w0)\n def old():kernel._pack_qkv[(triton.cdiv(le,bl),)](q,k,v,c,s,p0,kw,vw,w0,seq_len=S,n_elements=n,BLOCK=bl,num_warps=2)\n grid=max(M*13,triton.cdiv(2*384*1536,256))\n def new():kernel._pack_qkv_segmented[(grid,)](q,k,v,c,s,p1,kw,vw,w1,seq_len=S,tokens=M,BLOCK=256,num_warps=2)\n print('M',M,end=' ')\n for name,fn in [('old',old),('new',new)]:\n  for _ in range(5):fn()\n  ev=[]\n  for _ in range(100):\n   a=torch.cuda.Event(enable_timing=True);b=torch.cuda.Event(enable_timing=True);a.record();fn();b.record();ev.append((a,b))\n  torch.cuda.synchronize();print(name,round(statistics.median([a.elapsed_time(b) for a,b in ev])*1000,2),end=' ')\n print('eq',torch.equal(p0,p1),torch.equal(w0,w1),(p0-p1).abs().max().item())\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
