{"type":"item.started","item":{"id":"item_50","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport torch\nfor M in [256,586,2048,4096,8192]:\n p=torch.randn(M,3072,device='cuda');q=p[:,:2304];k=p[:,2304:2688];v=p[:,2688:];qw=torch.randn(2304,1536,device='cuda');kw=torch.randn(384,1536,device='cuda');vw=torch.randn(384,1536,device='cuda')\n qh=q@qw;kh=k@kw;vh=v@vw;r=(qh+kh)+vh\n qk=torch.addmm(qh,k,kw);z=torch.addmm(qk,v,vw);torch.cuda.synchronize()\n print(M,torch.equal(qk,qh+kh),(qk-(qh+kh)).abs().max().item(),torch.equal(z,r),(z-r).abs().max().item(),torch.isclose(z,r,atol=5e-6,rtol=1.2e-7).float().mean().item())\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
