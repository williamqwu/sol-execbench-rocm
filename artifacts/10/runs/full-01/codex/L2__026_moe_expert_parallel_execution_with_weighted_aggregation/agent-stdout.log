{"type":"item.started","item":{"id":"item_15","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport torch, aiter\nD='cuda'; E=2; N=4; K=2; BM=32; H=128; I=256\nids=torch.tensor([[0,1],[1,0],[0,1],[1,0]],device=D,dtype=torch.int64)\ntotal=ids.numel(); cap=total+E*BM\nsorted_ids=torch.full((cap,),-99,device=D,dtype=torch.int32)\nexpert_ids=torch.full(((cap+BM-1)//BM,),-99,device=D,dtype=torch.int32)\ntoken_nums=torch.full((E+1,),-99,device=D,dtype=torch.int32)\nnum_post=torch.full((1,),-99,device=D,dtype=torch.int32)\ntry:\n aiter.moe_align_block_size(ids,E,BM,sorted_ids,expert_ids,token_nums,num_post)\n torch.cuda.synchronize()\n print('num_post',num_post.cpu(), 'token_nums',token_nums.cpu())\n print('sorted',sorted_ids.cpu())\n print('experts',expert_ids.cpu())\nexcept Exception as e: print('align err',type(e).__name__,e)\n\nx=torch.randn(N,H,device=D,dtype=torch.bfloat16)\ng=torch.randn(E,I,H,device=D,dtype=torch.bfloat16)*.02\nu=torch.randn(E,I,H,device=D,dtype=torch.bfloat16)*.02\nout=torch.empty(N*K,I,device=D,dtype=torch.bfloat16)\ntry:\n aiter.moe_stage1_g1u1(x,g,u,sorted_ids,expert_ids,num_post,out,I,'',BM)\n torch.cuda.synchronize()\n print('stage1 ok',out.shape,out.float().abs().mean().item(),out.float().abs().max().item())\n # compare canonical flat route index order\n ref=[]\n for n in range(N):\n  for k in range(K):\n   e=ids[n,k].item(); gg=x[n].float()@g[e].float().T; uu=x[n].float()@u[e].float().T\n   ref.append(torch.nn.functional.silu(gg)*uu)\n ref=torch.stack(ref)\n d=(out.float()-ref).abs()\n print('diff mean max ratio<.05',d.mean().item(),d.max().item(),(d<.05).float().mean().item())\nexcept Exception as e: print('stage1 err',type(e).__name__,str(e)[:10000])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
