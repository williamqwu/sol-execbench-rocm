{"type":"item.started","item":{"id":"item_47","type":"command_execution","command":"/bin/bash -lc \"python3 -u - <<'PY'\nimport torch,triton,aiter,statistics\nimport kernel\nfrom reference import get_inputs\naxes={'batch_size':2,'seq_len':256,'hidden_size':8192,'intermediate_size':24576,'num_experts':16,'num_experts_per_tok':2}\nprint('generating',flush=True);a=get_inputs(axes,torch.device('cuda'));x=a['hidden_states'].view(-1,8192);R=a['selected_experts'].numel();H=8192;I=24576;E=16;K=2\ninter=torch.empty((R,I),device='cuda',dtype=torch.bfloat16);route=torch.empty((R,H),device='cuda',dtype=torch.bfloat16)\nconfigs=[\n (64,64,32,8),(128,64,32,8),(64,128,32,8),(128,128,32,8),\n (64,64,64,8),(128,64,64,8),(64,128,64,8),(128,128,64,8),\n (64,64,32,4),(128,64,32,4),(64,128,32,4),\n]\nfor BM,BN,BK,NW in configs:\n cap=R+E*BM;mb=triton.cdiv(cap,BM);si=torch.full((cap,),R,device='cuda',dtype=torch.int32);ei=torch.empty(mb,device='cuda',dtype=torch.int32);tc=torch.empty(E+1,device='cuda',dtype=torch.int32);nv=torch.empty(1,device='cuda',dtype=torch.int32);aiter.moe_align_block_size(a['selected_experts'],E,BM,si,ei,tc,nv)\n g1=(mb*triton.cdiv(I,BN),);g2=(mb*triton.cdiv(H,BN),)\n try:\n  kernel._gate_up_silu_kernel[g1](x,a['gate_proj_weights'],a['up_proj_weights'],si,ei,nv,inter,R,H,I,K,BM,BN,BK,num_warps=NW,num_stages=2)\n  kernel._down_weight_kernel[g2](inter,a['down_proj_weights'],a['routing_weights'],si,ei,nv,route,R,H,I,BM,BN,BK,num_warps=NW,num_stages=2)\n  torch.cuda.synchronize()\n  t1=[];t2=[]\n  for z in range(4):\n   s=torch.cuda.Event(enable_timing=True);m=torch.cuda.Event(enable_timing=True);e=torch.cuda.Event(enable_timing=True)\n   s.record();kernel._gate_up_silu_kernel[g1](x,a['gate_proj_weights'],a['up_proj_weights'],si,ei,nv,inter,R,H,I,K,BM,BN,BK,num_warps=NW,num_stages=2);m.record();kernel._down_weight_kernel[g2](inter,a['down_proj_weights'],a['routing_weights'],si,ei,nv,route,R,H,I,BM,BN,BK,num_warps=NW,num_stages=2);e.record();e.synchronize();t1.append(s