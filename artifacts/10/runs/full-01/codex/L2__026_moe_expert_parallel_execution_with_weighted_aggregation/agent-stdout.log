{"type":"item.started","item":{"id":"item_18","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport torch, aiter\nD='cuda'; E=2; N=4; K=2; BM=32; H=128; I=256\nids=torch.tensor([[0,1],[1,0],[0,1],[1,0]],device=D,dtype=torch.int32); weights=torch.rand(N,K,device=D,dtype=torch.float32)\ntotal=ids.numel(); cap=total+E*BM\nsi=torch.empty(cap,device=D,dtype=torch.int32); sw=torch.empty(cap,device=D); se=torch.empty((cap+BM-1)//BM,device=D,dtype=torch.int32); nv=torch.empty(1,device=D,dtype=torch.int32); buf=torch.empty(cap+E+32,device=D,dtype=torch.int32)\naiter.moe_sorting_fwd(ids,weights,si,sw,se,nv,buf,E,BM)\nx=torch.randn(N,H,device=D,dtype=torch.bfloat16); g=torch.randn(E,I,H,device=D,dtype=torch.bfloat16)*.02; u=torch.randn(E,I,H,device=D,dtype=torch.bfloat16)*.02; gu=torch.cat((g,u),dim=1); d=torch.randn(E,H,I,device=D,dtype=torch.bfloat16)*.02; out=torch.empty(N,H,device=D,dtype=torch.bfloat16)\ntry:\n aiter.fmoe(out,x,gu,d,si,sw,se,nv,K)\n torch.cuda.synchronize();print('fmoe OK',out.float().abs().mean().item(),out.float().abs().max().item())\n ref=torch.zeros(N,H,device=D,dtype=torch.float32)\n for n in range(N):\n  for k in range(K):\n   e=ids[n,k].item(); gg=x[n].float()@g[e].float().T; uu=x[n].float()@u[e].float().T; inter=torch.nn.functional.silu(gg)*uu; y=inter@d[e].float().T; ref[n]+=y*weights[n,k]\n diff=(out.float()-ref).abs();print('diff',diff.mean().item(),diff.max().item(),(diff<.05).float().mean().item(),'ref',ref.abs().mean().item())\nexcept Exception as e: print('ERR',type(e).__name__,str(e)[:10000])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
