{"type":"item.completed","item":{"id":"item_54","type":"agent_message","text":"PyTorch’s ROCm build includes a native grouped-GEMM primitive. It accepts concatenated expert rows plus device-side cumulative offsets, so it can preserve the proven BF16 arithmetic while replacing 48 hipBLAS launches with three grouped launches. I’m benchmarking that path now, including route sorting and the final unsort/reduction."}}
{"type":"item.started","item":{"id":"item_55","type":"command_execution","command":"/bin/bash -lc \"python3 -u - <<'PY'\nimport torch,time,statistics\nfrom reference import get_inputs,run as ref_run\naxes={'batch_size':2,'seq_len':256,'hidden_size':8192,'intermediate_size':24576,'num_experts':16,'num_experts_per_tok':2}\na=get_inputs(axes,torch.device('cuda'));x=a['hidden_states'].view(-1,8192);N=x.shape[0]\ndef grouped():\n flat=a['selected_experts'].reshape(-1)\n sorted_e,order=torch.sort(flat)\n rows=x[order//2]\n offs=torch.bincount(sorted_e,minlength=16).cumsum(0).to(torch.int32)\n gate=torch._grouped_mm(rows,a['gate_proj_weights'].transpose(1,2),offs)\n up=torch._grouped_mm(rows,a['up_proj_weights'].transpose(1,2),offs)\n inter=torch.nn.functional.silu(gate)*up\n down=torch._grouped_mm(inter,a['down_proj_weights'].transpose(1,2),offs)\n weighted=(down.float()*a['routing_weights'].reshape(-1)[order,None]).bfloat16()\n unsorted=torch.empty_like(weighted);unsorted.index_copy_(0,order,weighted)\n return (unsorted[0::2]+unsorted[1::2]).reshape_as(a['hidden_states'])\nprint('warm',flush=True);y=grouped();torch.cuda.synchronize();print('correct',flush=True);r=ref_run(**a);d=(y.float()-r.float()).abs();print(d.mean().item(),d.max().item(),torch.isclose(y.float(),r.float(),atol=.041349952124319106,rtol=.0078125).float().mean().item(),flush=True)\nt=[]\nfor z in range(8):\n s=torch.cuda.Event(enable_timing=True);e=torch.cuda.Event(enable_timing=True);s.record();y=grouped();e.record();e.synchronize();t.append(s.elapsed_time(e));print(z,t[-1],flush=True)\nprint('median',statistics.median(t[2:]),flush=True)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
