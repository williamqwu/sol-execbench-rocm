{"type":"item.started","item":{"id":"item_20","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport torch, aiter\nD='cuda'; torch.manual_seed(1); E=2; N=4; K=2; BM=32; H=128; I=256\nids=torch.tensor([[0,1],[1,0],[0,1],[1,0]],device=D,dtype=torch.int32); weights=torch.rand(N,K,device=D,dtype=torch.float32)\ntotal=ids.numel(); cap=total+E*BM\nsi=torch.empty(cap,device=D,dtype=torch.int32); sw=torch.empty(cap,device=D); se=torch.empty((cap+BM-1)//BM,device=D,dtype=torch.int32); nv=torch.empty(1,device=D,dtype=torch.int32); buf=torch.empty(cap+E+32,device=D,dtype=torch.int32);aiter.moe_sorting_fwd(ids,weights,si,sw,se,nv,buf,E,BM)\nx=torch.randn(N,H,device=D,dtype=torch.bfloat16); g=torch.randn(E,I,H,device=D,dtype=torch.bfloat16)*.02; u=torch.randn(E,I,H,device=D,dtype=torch.bfloat16)*.02; gu=torch.cat((g,u),dim=1); d=torch.randn(E,H,I,device=D,dtype=torch.bfloat16)*.02\ninter=torch.full((N*K,I),float('nan'),device=D,dtype=torch.bfloat16); out=torch.full((N*K,H),float('nan'),device=D,dtype=torch.bfloat16)\naiter.ck_moe_stage1_fwd(x,gu,d,si,se,nv,inter,K,block_m=BM)\nrefs=[]; labels=[]\nfor n in range(N):\n for k in range(K):\n  e=ids[n,k].item(); gg=x[n].float()@g[e].float().T; uu=x[n].float()@u[e].float().T; refs.append(torch.nn.functional.silu(gg)*uu); labels.append((n,k,e))\nrefs=torch.stack(refs)\nprint('ref/inter means',refs.abs().mean().item(),inter.float().abs().mean().item(),'nan',inter.isnan().sum().item())\nmae=(inter.float()[:,None,:]-refs[None,:,:]).abs().mean(-1)\nprint('labels',labels);print('best ref each output',mae.argmin(1).cpu().tolist());print('best mae',mae.min(1).values.cpu().tolist());print('matrix',mae.cpu())\naiter.ck_moe_stage2_fwd(inter,gu,d,si,se,nv,out,K,block_m=BM)\n# refs down corresponding token-major\nrefy=torch.stack([refs[i]@d[labels[i][2]].float().T for i in range(N*K)])\nprint('down means/max/nan',refy.abs().mean().item(),out.float().abs().mean().item(),out.float().abs().max().item(),out.isnan().sum().item())\nmae2=(out.float()[:,None,:]-refy[None,:,:]).abs().mean(-1);print('down best',mae2.argmin(1).cpu().tolist(),mae2.min(1).values.cpu().tolist());print(mae2.cpu())\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
