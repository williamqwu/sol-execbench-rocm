{"type":"item.started","item":{"id":"item_59","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch,time\nfor b,s in [(1,128),(1,512),(4,256)]:\n a=torch.randn(b,24,s,s,device='cuda');v=torch.randn(b,24,s,128,device='cuda')\n ref=torch.matmul(a,v).transpose(1,2).contiguous()\n try:\n  flat=torch.empty(b,s,24,128,device='cuda');view=flat.transpose(1,2)\n  torch.matmul(a,v,out=view);torch.cuda.synchronize();d=(ref-flat).abs();print('exact',b,s,d.max().item(),(ref==flat).float().mean().item())\n  def baseline():return torch.matmul(a,v).transpose(1,2).contiguous()\n  def direct():\n   z=torch.empty(b,s,24,128,device='cuda');torch.matmul(a,v,out=z.transpose(1,2));return z\n  n=30 if s<512 else 10\n  for label,fn in [('base',baseline),('direct',direct)]:\n   for _ in range(3):z=fn()\n   torch.cuda.synchronize();t=time.perf_counter()\n   for _ in range(n):z=fn()\n   torch.cuda.synchronize();print(label,(time.perf_counter()-t)*1000/n)\n except Exception as e: print(type(e).__name__,e)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
