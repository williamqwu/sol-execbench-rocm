{"type":"item.started","item":{"id":"item_82","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch,time,gc\ns1=torch.cuda.Stream();s2=torch.cuda.Stream()\nfor m in (128,256,512,1024):\n x=torch.randn(m,3072,device='cuda');qw=torch.randn(3072,3072,device='cuda');kw=torch.randn(1024,3072,device='cuda');vw=torch.randn(1024,3072,device='cuda')\n def seq():return torch.nn.functional.linear(x,qw),torch.nn.functional.linear(x,kw),torch.nn.functional.linear(x,vw)\n def par():\n  cur=torch.cuda.current_stream();s1.wait_stream(cur);s2.wait_stream(cur)\n  q=torch.nn.functional.linear(x,qw)\n  with torch.cuda.stream(s1):k=torch.nn.functional.linear(x,kw)\n  with torch.cuda.stream(s2):v=torch.nn.functional.linear(x,vw)\n  cur.wait_stream(s1);cur.wait_stream(s2);return q,k,v\n a=seq();b=par();torch.cuda.synchronize();print('exact',m,[(u==v).float().mean().item() for u,v in zip(a,b)])\n for label,fn in [('seq',seq),('par',par)]:\n  for _ in range(5):z=fn()\n  torch.cuda.synchronize();t=time.perf_counter()\n  for _ in range(50):z=fn()\n  torch.cuda.synchronize();print(m,label,(time.perf_counter()-t)*20)\n del x,qw,kw,vw,a,b,z;gc.collect();torch.cuda.empty_cache()\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
