{"type":"item.completed","item":{"id":"item_35","type":"command_execution","command":"/bin/bash -lc \"sed -n '300,570p' kernel.py\"","aggregated_output":"            grad_hidden + token[:, None] * 2048 + offs_n[None, :],\n            acc,\n            mask=token_mask[:, None],\n        )\n\n\n@triton.jit\ndef _combined_small(\n    hidden_states,\n    gate_weight,\n    routing_probs,\n    selected_experts,\n    routing_weights_sum,\n    grad_routing_weights,\n    grad_expert_mask,\n    grad_router_logits,\n    grad_hidden,\n    grad_gate,\n    num_tokens: tl.constexpr,\n    GH_PROGRAMS: tl.constexpr,\n    GH_GROUP_N: tl.constexpr,\n):\n    pid = tl.program_id(0)\n    if pid < GH_PROGRAMS:\n        # Persistent grad-hidden tile: form sixteen complete router-gradient\n        # rows once, then reuse them for several output-column tiles.\n        pid_m = pid // GH_GROUP_N\n        group_n = pid % GH_GROUP_N\n        token = pid_m * 16 + tl.arange(0, 16)\n        token_mask = token < num_tokens\n        gh_expert = tl.arange(0, 128)\n        slot = tl.arange(0, 8)\n        probs = tl.load(\n            routing_probs + token[:, None] * 128 + gh_expert[None, :],\n            mask=token_mask[:, None],\n            other=0.0,\n        )\n        direct = tl.load(\n            grad_router_logits + token[:, None] * 128 + gh_expert[None, :],\n            mask=token_mask[:, None],\n            other=0.0,\n        ).to(tl.float32)\n        selected = tl.load(\n            selected_experts + token[:, None] * 8 + slot[None, :],\n            mask=token_mask[:, None],\n            other=0,\n        )\n        grad_weights = tl.load(\n            grad_routing_weights + token[:, None] * 8 + slot[None, :],\n            mask=token_mask[:, None],\n            other=0.0,\n        ).to(tl.float32)\n        selected_probs = tl.load(\n            routing_probs + token[:, None] * 128 + selected,\n            mask=token_mask[:, None],\n            other=0.0,\n        )\n        weight_sum = tl.load(\n            routing_weights_sum + token,\n            mask=token_mask,\n            other=1.0,\n        )\n        grad_sum = tl.sum(\n            grad_weights * selected_probs / weight_sum[:, None], axis=1\n        )\n        grad_unnorm = (\n            grad_weights / weight_sum[:, None]\n            - grad_sum[:, None] / weight_sum[:, None]\n        )\n        grad_mask = tl.load(\n            grad_expert_mask\n            + selected * (8 * num_tokens)\n            + slot[None, :] * num_tokens\n            + token[:, None],\n            mask=token_mask[:, None],\n            other=0.0,\n        ).to(tl.float32)\n        sparse_grad = grad_unnorm + grad_mask\n        dot = tl.sum(direct * probs, axis=1) + tl.sum(\n            sparse_grad * selected_probs, axis=1\n        )\n        gh_selected_contrib = tl.sum(\n            tl.where(\n                gh_expert[None, :, None] == selected[:, None, :],\n                sparse_grad[:, None, :],\n                0.0,\n            ),\n            axis=2,\n        )\n        grad = (\n            probs * (direct + gh_selected_contrib - dot[:, None])\n        ).to(tl.bfloat16)\n        for block in tl.static_range(0, 16 // GH_GROUP_N):\n            offs_n = (\n                (group_n + block * GH_GROUP_N) * 128\n                + tl.arange(0, 128)\n            )\n            weight = tl.load(\n                gate_weight + gh_expert[:, None] * 2048 + offs_n[None, :]\n            )\n            gh_acc = tl.dot(grad, weight)\n            tl.store(\n                grad_hidden + token[:, None] * 2048 + offs_n[None, :],\n                gh_acc,\n                mask=token_mask[:, None],\n            )\n    else:\n        # A regular 32x64 grad-gate output tile, except that its A operand\n        # (the router gradient) is generated inline a token block at a time.\n        gate_pid = pid - GH_PROGRAMS\n        pid_m = gate_pid % 4\n        pid_n = gate_pid // 4\n        expert_out = pid_m * 32 + tl.arange(0, 32)\n        hidden_col = pid_n * 64 + tl.arange(0, 64)\n        expert_chunk = tl.arange(0, 32)\n        slot = tl.arange(0, 8)\n        gg_acc = tl.zeros((32, 64), tl.float32)\n        for token_start in range(0, num_tokens, 16):\n            token = token_start + tl.arange(0, 16)\n            token_mask = token < num_tokens\n            dot = tl.zeros((16,), tl.float32)\n            for expert_start in tl.static_range(0, 128, 32):\n                expert = expert_start + expert_chunk\n                probs_chunk = tl.load(\n                    routing_probs\n                    + token[:, None] * 128\n                    + expert[None, :],\n                    mask=token_mask[:, None],\n                    other=0.0,\n                )\n                direct_chunk = tl.load(\n                    grad_router_logits\n                    + token[:, None] * 128\n                    + expert[None, :],\n                    mask=token_mask[:, None],\n                    other=0.0,\n                ).to(tl.float32)\n                dot += tl.sum(probs_chunk * direct_chunk, axis=1)\n            selected = tl.load(\n                selected_experts + token[:, None] * 8 + slot[None, :],\n                mask=token_mask[:, None],\n                other=0,\n            )\n            grad_weights = tl.load(\n                grad_routing_weights + token[:, None] * 8 + slot[None, :],\n                mask=token_mask[:, None],\n                other=0.0,\n            ).to(tl.float32)\n            selected_probs = tl.load(\n                routing_probs + token[:, None] * 128 + selected,\n                mask=token_mask[:, None],\n                other=0.0,\n            )\n            weight_sum = tl.load(\n                routing_weights_sum + token,\n                mask=token_mask,\n                other=1.0,\n            )\n            grad_sum = tl.sum(\n                grad_weights * selected_probs / weight_sum[:, None],\n                axis=1,\n            )\n            grad_unnorm = (\n                grad_weights / weight_sum[:, None]\n                - grad_sum[:, None] / weight_sum[:, None]\n            )\n            grad_mask = tl.load(\n                grad_expert_mask\n                + selected * (8 * num_tokens)\n                + slot[None, :] * num_tokens\n                + token[:, None],\n                mask=token_mask[:, None],\n                other=0.0,\n            ).to(tl.float32)\n            sparse_grad = grad_unnorm + grad_mask\n            dot += tl.sum(sparse_grad * selected_probs, axis=1)\n            probs_out = tl.load(\n                routing_probs\n                + token[:, None] * 128\n                + expert_out[None, :],\n                mask=token_mask[:, None],\n                other=0.0,\n            )\n            direct_out = tl.load(\n                grad_router_logits\n                + token[:, None] * 128\n                + expert_out[None, :],\n                mask=token_mask[:, None],\n                other=0.0,\n            ).to(tl.float32)\n            gg_selected_contrib = tl.sum(\n                tl.where(\n                    expert_out[None, :, None] == selected[:, None, :],\n                    sparse_grad[:, None, :],\n                    0.0,\n                ),\n                axis=2,\n            )\n            router_grad = (\n                probs_out\n                * (direct_out + gg_selected_contrib - dot[:, None])\n            ).to(tl.bfloat16)\n            hidden = tl.load(\n                hidden_states\n                + token[:, None] * 2048\n                + hidden_col[None, :],\n                mask=token_mask[:, None],\n                other=0.0,\n            )\n            gg_acc += tl.dot(tl.trans(router_grad), hidden)\n        tl.store(\n            grad_gate + expert_out[:, None] * 2048 + hidden_col[None, :],\n            gg_acc,\n        )\n\n\n@torch.no_grad()\ndef run(\n    hidden_states,\n    gate_weight,\n    router_logits,\n    routing_probs,\n    selected_experts,\n    routing_weights_sum,\n    grad_routing_weights,\n    grad_expert_mask,\n    grad_router_logits,\n):\n    num_tokens = hidden_states.shape[0]\n    grad_logits = torch.empty_like(router_logits)\n    if num_tokens <= 4096:\n        grad_hidden = torch.empty_like(hidden_states)\n        if num_tokens <= 2048:\n            group_n = 4\n        else:\n            group_n = 2\n        grid = (triton.cdiv(num_tokens, 16) * group_n,)\n        _routing_and_hidden[grid](\n            gate_weight,\n            routing_probs,\n            selected_experts,\n            routing_weights_sum,\n            grad_routing_weights,\n            grad_expert_mask,\n            grad_router_logits,\n            grad_logits,\n            grad_hidden,\n            num_tokens,\n            BLOCK_M=16,\n            BLOCK_N=128,\n            GROUP_N=group_n,\n            num_warps=4,\n            num_stages=2,\n        )\n    else:\n        _routing_backward_sparse[(num_tokens,)](\n            routing_probs,\n            selected_experts,\n            routing_weights_sum,\n            grad_routing_weights,\n            grad_expert_mask,\n            grad_router_logits,\n            grad_logits,\n            num_tokens,\n            num_warps=1,\n        )\n        grad_hidden = grad_logits @ gate_weight\n    return grad_hidden, grad_logits.t() @ hidden_states\n","exit_code":0,"status":"completed"}}
