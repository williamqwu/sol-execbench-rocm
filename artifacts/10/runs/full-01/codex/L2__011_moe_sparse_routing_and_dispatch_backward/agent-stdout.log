{"type":"item.started","item":{"id":"item_14","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch\nimport kernel, reference\n\ndef ms(fn,iters):\n for _ in range(10): fn()\n torch.cuda.synchronize(); a=torch.cuda.Event(enable_timing=True); b=torch.cuda.Event(enable_timing=True); a.record()\n for _ in range(iters): fn()\n b.record(); b.synchronize(); return a.elapsed_time(b)/iters\n\ndef refgrad(x):\n p=x['routing_probs']; sel=x['selected_experts']; gr=x['grad_routing_weights'].float(); den=x['routing_weights_sum']\n u=torch.gather(p,1,sel); gs=(gr*u/den).sum(1,keepdim=True); c=gr/den-gs/den\n gm=torch.gather(x['grad_expert_mask'].permute(2,1,0).float(),2,sel.unsqueeze(2)).squeeze(2)\n g=torch.zeros_like(p); g.scatter_(1,sel,c); g.scatter_add_(1,sel,gm); g=g+x['grad_router_logits'].float(); dot=(g*p).sum(1,keepdim=True)\n return (p*(g-dot)).bfloat16()\nfor n in (1024,8192,65536):\n x=reference.get_inputs({'num_tokens':n,'hidden_size':2048,'num_experts':128,'top_k':8},torch.device('cuda')); a=torch.empty_like(x['router_logits']); b=torch.empty_like(a)\n args=(x['routing_probs'],x['selected_experts'],x['routing_weights_sum'],x['grad_routing_weights'],x['grad_expert_mask'],x['grad_router_logits'])\n f1=lambda: kernel._routing_backward[(n,)](*args,a,n,num_warps=1)\n f2=lambda: kernel._routing_backward_sparse[(n,)](*args,b,n,num_warps=1)\n f1();f2(); torch.cuda.synchronize(); rg=refgrad(x)\n for name,y,fn in [('dense',a,f1),('sparse',b,f2)]:\n  diff=(y.float()-rg.float()).abs(); neq=(y\"'!=rg)\n  print(n,name,'\"'ms',f'{ms(fn,100 if n==65536 else 500):.4f}','max',diff.max().item(),'neq',neq.float().mean().item(),'bad',((diff>0.00028+0.0078125*rg.float().abs())).float().mean().item(),flush=True)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
