{"type":"item.started","item":{"id":"item_16","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport gc,torch\nimport torch.nn.functional as F\n\ndef bench(B,S,iters=9):\n H,G,R,D=64,8,8,96\n q=torch.randn(B,H,S,D,device='cuda',dtype=torch.bfloat16)\n k=torch.randn(B,G,S,D,device='cuda',dtype=torch.bfloat16)\n v=torch.randn(B,G,S,D,device='cuda',dtype=torch.bfloat16)\n mask=torch.randn(B,1,S,S,device='cuda',dtype=torch.bfloat16)\n def baseline():\n  kr=k[:,:,None].expand(B,G,R,S,D).reshape(B,H,S,D)\n  vr=v[:,:,None].expand(B,G,R,S,D).reshape(B,H,S,D)\n  a=torch.matmul(q,kr.transpose(-2,-1))*(D**-0.5)\n  p=F.softmax(a+mask,dim=-1,dtype=torch.float32).to(q.dtype)\n  return torch.matmul(p,vr)\n def grouped():\n  a=torch.matmul(q.view(B,G,R,S,D),k[:,:,None].transpose(-2,-1)).reshape(B,H,S,S)*(D**-0.5)\n  p=F.softmax(a+mask,dim=-1,dtype=torch.float32).to(q.dtype)\n  return torch.matmul(p.view(B,G,R,S,S),v[:,:,None]).reshape(B,H,S,D)\n ref=baseline();out=grouped();torch.cuda.synchronize()\n print('err',B,S,(ref.float()-out.float()).abs().max().item())\n for name,fn in [('base',baseline),('grouped',grouped)]:\n  for _ in range(3):fn()\n  torch.cuda.synchronize();ts=[]\n  for _ in range(iters):\n   st=torch.cuda.Event(enable_timing=True);en=torch.cuda.Event(enable_timing=True);st.record();fn();en.record();en.synchronize();ts.append(st.elapsed_time(en))\n  print(name,B,S,sorted(ts)[len(ts)//2])\n del q,k,v,mask,ref,out;gc.collect();torch.cuda.empty_cache()\nfor x in [(1,128),(8,128),(64,128),(1,512),(8,512),(2,1024),(1,2048)]:bench(*x,5)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
