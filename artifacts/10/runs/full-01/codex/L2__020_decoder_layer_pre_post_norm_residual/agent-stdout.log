{"type":"item.started","item":{"id":"item_10","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch\nimport torch.nn.functional as F\n\ntorch.manual_seed(0)\nB,Hq,Hkv,S,D = 1,64,8,512,96\ndev='cuda'\nq=torch.randn(B,Hq,S,D,device=dev,dtype=torch.bfloat16)\nk=torch.randn(B,Hkv,S,D,device=dev,dtype=torch.bfloat16)\nv=torch.randn(B,Hkv,S,D,device=dev,dtype=torch.bfloat16)\nmask=torch.randn(B,1,S,S,device=dev,dtype=torch.bfloat16)\nkr=k[:,:,None].expand(B,Hkv,8,S,D).reshape(B,Hq,S,D)\nvr=v[:,:,None].expand(B,Hkv,8,S,D).reshape(B,Hq,S,D)\ndef explicit():\n    a=torch.matmul(q,kr.transpose(2,3))*(D**-0.5)\n    a=F.softmax(a+mask,dim=-1,dtype=torch.float32).to(q.dtype)\n    return torch.matmul(a,vr)\ndef sdpa():\n    return F.scaled_dot_product_attention(q,k,v,attn_mask=mask,dropout_p=0.0,is_causal=False,enable_gqa=True,scale=D**-0.5)\nref=explicit(); out=sdpa(); torch.cuda.synchronize()\nd=(out.float()-ref.float()).abs()\nrel=d/(ref.float().abs()+1e-20)\nprint('error max_abs',d.max().item(),'mean_abs',d.mean().item(),'max_rel',rel.max().item(),'matched',((d<=0.0092)|(rel<=0.0078125)).float().mean().item())\nprint('out equal',torch.equal(ref,out))\nfor name,fn in [('explicit',explicit),('sdpa',sdpa)]:\n    for _ in range(3): fn()\n    torch.cuda.synchronize()\n    starts=[torch.cuda.Event(enable_timing=True) for _ in range(10)]\n    ends=[torch.cuda.Event(enable_timing=True) for _ in range(10)]\n    for i in range(10):\n        starts[i].record(); fn(); ends[i].record()\n    torch.cuda.synchronize()\n    ts=sorted(starts[i].elapsed_time(ends[i]) for i in range(10))\n    print(name,'median_ms',(ts[4]+ts[5])/2,'all',ts)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
