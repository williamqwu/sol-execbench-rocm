{"type":"item.started","item":{"id":"item_11","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport aiter\nnames=[n for n in dir(aiter) if any(s in n.lower() for s in ('attention','attn','mla','mha','rms','norm','silu','swiglu'))]\nprint('\\\\n'.join(names))\nPY\npython - <<'PY'\nimport gc\nimport torch\nimport torch.nn.functional as F\n\ndef bench(B,S,iters=6):\n    Hq,Hkv,D=64,8,96\n    q=torch.randn(B,Hq,S,D,device='cuda',dtype=torch.bfloat16)\n    k=torch.randn(B,Hkv,S,D,device='cuda',dtype=torch.bfloat16)\n    v=torch.randn(B,Hkv,S,D,device='cuda',dtype=torch.bfloat16)\n    mask=torch.randn(B,1,S,S,device='cuda',dtype=torch.bfloat16)\n    kr=k[:,:,None].expand(B,Hkv,8,S,D).reshape(B,Hq,S,D)\n    vr=v[:,:,None].expand(B,Hkv,8,S,D).reshape(B,Hq,S,D)\n    def explicit():\n        a=torch.matmul(q,kr.transpose(2,3))*(D**-0.5)\n        a=F.softmax(a+mask,dim=-1,dtype=torch.float32).to(q.dtype)\n        return torch.matmul(a,vr)\n    def sdpa():\n        return F.scaled_dot_product_attention(q,k,v,attn_mask=mask,dropout_p=0.0,enable_gqa=True,scale=D**-0.5)\n    ref=explicit(); out=sdpa(); torch.cuda.synchronize()\n    d=(out.float()-ref.float()).abs(); rel=d/(ref.float().abs()+1e-20)\n    ratio=((d<=0.0092)|(rel<=0.0078125)).float().mean().item()\n    vals=[]\n    for name,fn in [('explicit',explicit),('sdpa',sdpa)]:\n        for _ in range(2): fn()\n        torch.cuda.synchronize()\n        times=[]\n        for _ in range(iters):\n            st=torch.cuda.Event(enable_timing=True); en=torch.cuda.Event(enable_timing=True)\n            st.record(); fn(); en.record(); en.synchronize(); times.append(st.elapsed_time(en))\n        vals.append((name,sorted(times)[len(times)//2]))\n    print('shape',B,S,'matched',ratio,*vals)\n    del q,k,v,mask,kr,vr,ref,out,d,rel\n    gc.collect(); torch.cuda.empty_cache()\nfor B,S in [(8,128),(2,1024),(1,1024),(1,2048),(2,2048)]:\n    bench(B,S,4)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
