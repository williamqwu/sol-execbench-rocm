{"type":"item.started","item":{"id":"item_33","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport gc,torch\nimport torch.nn.functional as F\nD=6144;I=19648;dt=torch.bfloat16;dev='cuda'\nprint('alloc')\ngw=torch.randn(I,D,device=dev,dtype=dt);uw=torch.randn(I,D,device=dev,dtype=dt)\nqw=torch.randn(D,D,device=dev,dtype=dt);kw=torch.randn(768,D,device=dev,dtype=dt);vw=torch.randn(768,D,device=dev,dtype=dt)\ns1=torch.cuda.Stream();s2=torch.cuda.Stream();cur=torch.cuda.current_stream()\ntorch.cuda.synchronize();print('ready')\ndef timing(fn,n=15):\n for _ in range(4):fn()\n torch.cuda.synchronize();ts=[]\n for _ in range(n):\n  a=torch.cuda.Event(enable_timing=True);b=torch.cuda.Event(enable_timing=True);a.record();fn();b.record();b.synchronize();ts.append(a.elapsed_time(b))\n return sorted(ts)[n//2]\nfor M in (128,512,1024,2048,4096,8192):\n x=torch.randn(M,D,device=dev,dtype=dt);torch.cuda.synchronize()\n def gu_seq():return F.linear(x,gw),F.linear(x,uw)\n def gu_par():\n  s1.wait_stream(cur)\n  with torch.cuda.stream(s1):g=F.linear(x,gw)\n  u=F.linear(x,uw);cur.wait_stream(s1);g.record_stream(cur)\n  return g,u\n def qkv_seq():return F.linear(x,qw),F.linear(x,kw),F.linear(x,vw)\n def qkv_par():\n  s1.wait_stream(cur);s2.wait_stream(cur)\n  with torch.cuda.stream(s1):k=F.linear(x,kw)\n  with torch.cuda.stream(s2):v=F.linear(x,vw)\n  q=F.linear(x,qw);cur.wait_stream(s1);cur.wait_stream(s2);k.record_stream(cur);v.record_stream(cur)\n  return q,k,v\n print(M,'gu seq/par',timing(gu_seq),timing(gu_par),'qkv seq/par',timing(qkv_seq),timing(qkv_par))\n del x;gc.collect();torch.cuda.empty_cache()\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
