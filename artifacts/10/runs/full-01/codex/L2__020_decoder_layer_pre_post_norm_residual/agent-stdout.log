 by passing in KV with fewer heads\n    than Q. Note that the number of heads in Q must be divisible by the number of heads in KV.\n    For example, if Q has 6 heads and K, V have 2 heads, head 0, 1, 2 of Q will attention to head\n    0 of K, V, and head 3, 4, 5 of Q will attention to head 1 of K, V.\n\n    If causal=True, the causal mask is aligned to the bottom right corner of the attention matrix.\n    For example, if seqlen_q = 2 and seqlen_k = 5, the causal mask (1 = keep, 0 = masked out) is:\n        1 1 1 1 0\n        1 1 1 1 1\n    If seqlen_q = 5 and seqlen_k = 2, the causal mask is:\n        0 0\n        0 0\n        0 0\n        1 0\n        1 1\n    If the row of the mask is all zero, the output will be zero.\n\n    If window_size != (-1, -1), implements sliding window local attention. Query at position i\n    will only attend to keys between\n    [i + seqlen_k - seqlen_q - window_size[0], i + seqlen_k - seqlen_q + window_size[1]] inclusive.\n\n    Arguments:\n        q: (batch_size, seqlen, nheads, headdim_q)\n        k: (batch_size, seqlen, nheads_k, headdim_q)\n        v: (batch_size, seqlen, nheads_k, headdim_v)\n        dropout_p: float. Dropout probability.\n        softmax_scale: float. The scaling of QK^T before applying softmax.\n            Default to 1 / sqrt(headdim_q).\n        causal: bool. Whether to apply causal attention mask (e.g., for auto-regressive modeling).\n        window_size: (left, right). If not (-1, -1), implements sliding window local attention.\n      \n\n### mha_fwd <function torch_compile_guard.<locals>.decorator.<locals>.wrapper_custom at 0x7b5124f42680>\nsignature (*args, **kwargs)\n\n### fmha_v3_fwd <function torch_compile_guard.<locals>.decorator.<locals>.wrapper_custom at 0x7b5124f435b0>\nsignature (*args, **kwargs)\n[W806 00:32:23.987259926 AllocatorConfig.cpp:28] Warning: PYTORCH_CUDA_ALLOC_CONF is deprecated, use PYTORCH_ALLOC_CONF instead (function operator())\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_14","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport gc\nimport torch\nimport torch.nn.functional as F\nimport aiter\n\ndef one(B,S,iters=5):\n    Hq,Hkv,D=64,8,96\n    q=torch.randn(B,S,Hq,D,device='cuda',dtype=torch.bfloat16)\n    k=torch.randn(B,S,Hkv,D,device='cuda',dtype=torch.bfloat16)\n    v=torch.randn(B,S,Hkv,D,device='cuda',dtype=torch.bfloat16)\n    mask=torch.randn(B,1,S,S,device='cuda',dtype=torch.bfloat16)\n    qh=q.transpose(1,2); kh=k.transpose(1,2); vh=v.transpose(1,2)\n    kr=kh[:,:,None].expand(B,Hkv,8,S,D).reshape(B,Hq,S,D)\n    vr=vh[:,:,None].expand(B,Hkv,8,S,D).reshape(B,Hq,S,D)\n    def explicit():\n        a=torch.matmul(qh,kr.transpose(2,3))*(D**-0.5)\n        a=F.softmax(a+mask,dim=-1,dtype=torch.float32).to(q.dtype)\n        return torch.matmul(a,vr).transpose(1,2)\n    funcs=[]\n    funcs.append(('explicit',explicit))\n    for det in (True,False):\n      for cvt in (1,2):\n        funcs.append((f'aiter_d{det}_c{cvt}',lambda det=det,cvt=cvt: aiter.flash_attn_func(q,k,v,softmax_scale=D**-0.5,bias=mask,deterministic=det,how_v3_bf16_cvt=cvt)))\n    ref=explicit(); torch.cuda.synchronize()\n    for name,fn in funcs[1:]:\n      try:\n        out=fn(); torch.cuda.synchronize()\n        if isinstance(out,tuple): out=out[0]\n        d=(out.float()-ref.float()).abs(); rel=d/(ref.float().abs()+1e-20)\n        ratio=((d<=0.0092)|(rel<=0.0078125)).float().mean().item()\n        print(B,S,name,'error',d.max().item(),d.mean().item(),'matched',ratio)\n      except Exception as exc:\n        print(B,S,name,'ERROR',type(exc).__name__,str(exc)[:500])\n    for name,fn in funcs:\n      try:\n        for _ in range(2): fn()\n        torch.cuda.synchronize(); times=[]\n        for _ in range(iters):\n          st=torch.cuda.Event(enable_timing=True); en=torch.cuda.Event(enable_timing=True)\n          st.record(); fn(); en.record(); en.synchronize(); times.append(st.elapsed_time(en))\n        print(B,S,name,'ms',sorted(times)[len(times)//2])\n      except Exception: pass\n    del q,k,v,mask,qh,kh,vh,kr,vr,ref\n    gc.collect();torch.cuda.empty_cache()\none(1,128,3)\none(1,512,3)\none(1,1024,3)\none(1,2048,3)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
