{"type":"item.started","item":{"id":"item_27","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch\nimport torch.nn.functional as F\nfrom kernel import _rms_norm,_add_rms_norm,_apply_rope_and_repeat,_swiglu\n\ndef report(name,a,b):\n d=(a.float()-b.float()).abs(); rel=d/(a.float().abs()+1e-20)\n print(name,'equal',torch.equal(a,b),'max',d.max().item(),'mean',d.mean().item(),'match',((d<=0.0092)|(rel<=0.0078125)).float().mean().item())\n\nM=16\nx=torch.randn(M,6144,device='cuda',dtype=torch.bfloat16);w=torch.randn(6144,device='cuda',dtype=torch.bfloat16);u=torch.randn_like(x)\ndef eager_rms(z):\n zf=z.float();return w*(zf*torch.rsqrt(zf.square().mean(-1,keepdim=True)+1e-5)).to(torch.bfloat16)\nr=eager_rms(x);o=_rms_norm(x,w,1e-5);report('rms',r,o)\nadded=x+u;r2=eager_rms(added);added_o,o2=_add_rms_norm(x,u,w,1e-5);report('add',added,added_o);report('add_rms',r2,o2)\nB,S=2,128\nq=torch.randn(B,S,6144,device='cuda',dtype=torch.bfloat16);k=torch.randn(B,S,768,device='cuda',dtype=torch.bfloat16);v=torch.randn_like(k);c=torch.randn(B,S,48,device='cuda',dtype=torch.bfloat16);s=torch.randn_like(c)\nqh=q.view(B,S,64,96).transpose(1,2);kh=k.view(B,S,8,96).transpose(1,2);vh=v.view(B,S,8,96).transpose(1,2)\nq1,q2=qh[...,:48],qh[...,48:];k1,k2=kh[...,:48],kh[...,48:]\nqr=torch.cat((q1*c[:,None]-q2*s[:,None],q1*s[:,None]+q2*c[:,None]),-1)\nkr=torch.cat((k1*c[:,None]-k2*s[:,None],k1*s[:,None]+k2*c[:,None]),-1)\nkr=kr[:,:,None].expand(B,8,8,S,96).reshape(B,64,S,96);vr=vh[:,:,None].expand(B,8,8,S,96).reshape(B,64,S,96)\nqo,ko,vo=_apply_rope_and_repeat(q,k,v,c,s,B,S)\nreport('query rope',qr,qo);report('key rope repeat',kr,ko);report('value repeat',vr,vo)\ng=torch.randn(1000003,device='cuda',dtype=torch.bfloat16);up=torch.randn_like(g)\nsr=F.silu(g)*up;so=_swiglu(g,up);report('swiglu',sr,so)\ntorch.cuda.synchronize()\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
