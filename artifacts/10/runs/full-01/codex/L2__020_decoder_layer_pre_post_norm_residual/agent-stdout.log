{"type":"item.started","item":{"id":"item_19","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport gc,torch\nimport torch.nn.functional as F\nD=6144;I=19648;dev='cuda';dt=torch.bfloat16\nprint('alloc weights')\nw1=torch.randn(D,device=dev,dtype=dt); qpw=torch.randn(D,D,device=dev,dtype=dt); kpw=torch.randn(768,D,device=dev,dtype=dt); vpw=torch.randn(768,D,device=dev,dtype=dt); opw=torch.randn(D,D,device=dev,dtype=dt); w2=torch.randn(D,device=dev,dtype=dt); gpw=torch.randn(I,D,device=dev,dtype=dt); upw=torch.randn(I,D,device=dev,dtype=dt); dpw=torch.randn(D,I,device=dev,dtype=dt)\ntorch.cuda.synchronize();print('ready')\ndef profile(B,S):\n x=torch.randn(B,S,D,device=dev,dtype=dt);cos=torch.randn(B,S,48,device=dev,dtype=dt);sin=torch.randn_like(cos);mask=torch.randn(B,1,S,S,device=dev,dtype=dt)\n def run(mark=False):\n  ev=[]; names=[]\n  def m(n):\n   if mark:\n    e=torch.cuda.Event(enable_timing=True);e.record();ev.append(e);names.append(n)\n  m('start')\n  xf=x.float();var=xf.square().mean(-1,keepdim=True);norm=w1*(xf*torch.rsqrt(var+1e-5)).to(dt);m('norm1')\n  q=F.linear(norm,qpw);m('qgemm');k=F.linear(norm,kpw);m('kgemm');v=F.linear(norm,vpw);m('vgemm')\n  q=q.view(B,S,64,96).transpose(1,2);k=k.view(B,S,8,96).transpose(1,2);v=v.view(B,S,8,96).transpose(1,2)\n  ce=cos[:,None];se=sin[:,None];q1,q2=q[...,:48],q[...,48:];k1,k2=k[...,:48],k[...,48:]\n  q=torch.cat((q1*ce-q2*se,q1*se+q2*ce),-1);k=torch.cat((k1*ce-k2*se,k1*se+k2*ce),-1);m('rope')\n  k=k[:,:,None].expand(B,8,8,S,96).reshape(B,64,S,96);v=v[:,:,None].expand(B,8,8,S,96).reshape(B,64,S,96);m('repeat')\n  a=torch.matmul(q,k.transpose(2,3))*(96**-0.5);m('qk')\n  p=F.softmax(a+mask,dim=-1,dtype=torch.float32).to(dt);m('softmax')\n  a=torch.matmul(p,v);m('pv')\n  a=a.transpose(1,2).contiguous().view(B,S,D);m('attn transpose')\n  a=F.linear(a,opw);m('ogemm')\n  h=x+a;m('residual1')\n  hf=h.float();var=hf.square().mean(-1,keepdim=True);norm=w2*(hf*torch.rsqrt(var+1e-5)).to(dt);m('norm2')\n  g=F.linear(norm,gpw);m('gate gemm');u=F.linear(norm,upw);m('up gemm')\n  z=F.silu(g)*u;m('swiglu')\n  o=F.linear(z,dpw);m('down gemm');out=h+o;m('residual2')\n  if mark:\n   torch.cuda.synchronize();times=[]\n   for i in range(1,len(ev)):times.append((names[i],ev[i-1].elapsed_time(ev[i])))\n   return times\n  return out\n run();torch.cuda.synchronize();times=run(True)\n print('\\\\nshape',B,S,'sum',sum(t for _,t in times))\n for n,t in times:print(f'{n:16s} {t:.4f}')\n del x,cos,sin,mask;gc.collect();torch.cuda.empty_cache()\nfor shape in ((1,128),(8,128),(2,1024),(2,2048),(64,128)):\n profile(*shape)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
