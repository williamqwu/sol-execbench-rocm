{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' definition.json && sed -n '1,320p' reference.py && sed -n '1,240p' workload.jsonl\"","aggregated_output":"{\n  \"name\": \"020_decoder_layer_pre_post_norm_residual\",\n  \"description\": \"Complete decoder layer with pre-normalization, attention, MLP, and residual connections. Pattern: x = x + attention(norm(x)), x = x + mlp(norm(x)). This is the fundamental building block executed N times per forward pass.\",\n  \"hf_id\": \"RekaAI/reka-flash-3\",\n  \"custom_inputs_entrypoint\": null,\n  \"axes\": {\n    \"batch_size\": {\n      \"type\": \"var\"\n    },\n    \"seq_len\": {\n      \"type\": \"var\"\n    },\n    \"hidden_size\": {\n      \"type\": \"const\",\n      \"value\": 6144\n    },\n    \"intermediate_size\": {\n      \"type\": \"const\",\n      \"value\": 19648\n    },\n    \"num_attention_heads\": {\n      \"type\": \"const\",\n      \"value\": 64\n    },\n    \"num_key_value_heads\": {\n      \"type\": \"const\",\n      \"value\": 8\n    },\n    \"head_dim\": {\n      \"type\": \"const\",\n      \"value\": 96\n    },\n    \"qkv_hidden\": {\n      \"type\": \"expr\",\n      \"expression\": \"num_attention_heads * head_dim\"\n    },\n    \"kv_hidden\": {\n      \"type\": \"expr\",\n      \"expression\": \"num_key_value_heads * head_dim\"\n    },\n    \"half_head_dim\": {\n      \"type\": \"expr\",\n      \"expression\": \"head_dim // 2\"\n    }\n  },\n  \"inputs\": {\n    \"hidden_states\": {\n      \"shape\": [\n        \"batch_size\",\n        \"seq_len\",\n        \"hidden_size\"\n      ],\n      \"dtype\": \"bfloat16\",\n      \"description\": \"Input hidden states\"\n    },\n    \"cos\": {\n      \"shape\": [\n        \"batch_size\",\n        \"seq_len\",\n        \"half_head_dim\"\n      ],\n      \"dtype\": \"bfloat16\",\n      \"description\": \"Cosine component of RoPE (half head_dim)\"\n    },\n    \"sin\": {\n      \"shape\": [\n        \"batch_size\",\n        \"seq_len\",\n        \"half_head_dim\"\n      ],\n      \"dtype\": \"bfloat16\",\n      \"description\": \"Sine component of RoPE (half head_dim)\"\n    },\n    \"attention_mask\": {\n      \"shape\": [\n        \"batch_size\",\n        \"1\",\n        \"seq_len\",\n        \"seq_len\"\n      ],\n      \"dtype\": \"bfloat16\",\n      \"description\": \"Causal attention mask\"\n    },\n    \"input_layernorm_weight\": {\n      \"shape\": [\n        \"hidden_size\"\n      ],\n      \"dtype\": \"bfloat16\",\n      \"description\": \"Pre-attention RMSNorm weight\"\n    },\n    \"q_proj_weight\": {\n      \"shape\": [\n        \"qkv_hidden\",\n        \"hidden_size\"\n      ],\n      \"dtype\": \"bfloat16\",\n      \"description\": \"Query projection weight\"\n    },\n    \"k_proj_weight\": {\n      \"shape\": [\n        \"kv_hidden\",\n        \"hidden_size\"\n      ],\n      \"dtype\": \"bfloat16\",\n      \"description\": \"Key projection weight\"\n    },\n    \"v_proj_weight\": {\n      \"shape\": [\n        \"kv_hidden\",\n        \"hidden_size\"\n      ],\n      \"dtype\": \"bfloat16\",\n      \"description\": \"Value projection weight\"\n    },\n    \"o_proj_weight\": {\n      \"shape\": [\n        \"hidden_size\",\n        \"qkv_hidden\"\n      ],\n      \"dtype\": \"bfloat16\",\n      \"description\": \"Output projection weight\"\n    },\n    \"post_attention_layernorm_weight\": {\n      \"shape\": [\n        \"hidden_size\"\n      ],\n      \"dtype\": \"bfloat16\",\n      \"description\": \"Pre-MLP RMSNorm weight\"\n    },\n    \"gate_proj_weight\": {\n      \"shape\": [\n        \"intermediate_size\",\n        \"hidden_size\"\n      ],\n      \"dtype\": \"bfloat16\",\n      \"description\": \"MLP gate projection weight\"\n    },\n    \"up_proj_weight\": {\n      \"shape\": [\n        \"intermediate_size\",\n        \"hidden_size\"\n      ],\n      \"dtype\": \"bfloat16\",\n      \"description\": \"MLP up projection weight\"\n    },\n    \"down_proj_weight\": {\n      \"shape\": [\n        \"hidden_size\",\n        \"intermediate_size\"\n      ],\n      \"dtype\": \"bfloat16\",\n      \"description\": \"MLP down projection weight\"\n    },\n    \"rms_norm_eps\": {\n      \"shape\": null,\n      \"dtype\": \"float32\",\n      \"description\": \"Epsilon for RMSNorm stability\"\n    }\n  },\n  \"outputs\": {\n    \"output\": {\n      \"shape\": [\n        \"batch_size\",\n        \"seq_len\",\n        \"hidden_size\"\n      ],\n      \"dtype\": \"bfloat16\",\n      \"description\": \"Output hidden states after decoder layer\"\n    }\n  },\n  \"reference\": \"import torch\\nimport torch.nn.functional as F\\n\\n@torch.no_grad()\\ndef run(\\n    hidden_states: torch.Tensor,\\n    cos: torch.Tensor,\\n    sin: torch.Tensor,\\n    attention_mask: torch.Tensor,\\n    input_layernorm_weight: torch.Tensor,\\n    q_proj_weight: torch.Tensor,\\n    k_proj_weight: torch.Tensor,\\n    v_proj_weight: torch.Tensor,\\n    o_proj_weight: torch.Tensor,\\n    post_attention_layernorm_weight: torch.Tensor,\\n    gate_proj_weight: torch.Tensor,\\n    up_proj_weight: torch.Tensor,\\n    down_proj_weight: torch.Tensor,\\n    rms_norm_eps: float,\\n):\\n    # Constants\\n    num_attention_heads = 64\\n    num_key_value_heads = 8\\n    head_dim = 96\\n    num_key_value_groups = num_attention_heads // num_key_value_heads\\n    scaling = head_dim ** -0.5\\n    half_dim = head_dim // 2\\n    \\n    batch_size, seq_len, _ = hidden_states.shape\\n    \\n    # Helper: RMSNorm\\n    def rms_norm(x, weight, eps):\\n        input_dtype = x.dtype\\n        x_fp32 = x.to(torch.float32)\\n        variance = x_fp32.pow(2).mean(-1, keepdim=True)\\n        x_normed = x_fp32 * torch.rsqrt(variance + eps)\\n        return (weight * x_normed.to(input_dtype))\\n    \\n    # Helper: Repeat KV heads for GQA\\n    def repeat_kv(x, n_rep):\\n        batch, num_kv_heads, slen, hdim = x.shape\\n        if n_rep == 1:\\n            return x\\n        x = x[:, :, None, :, :].expand(batch, num_kv_heads, n_rep, slen, hdim)\\n        return x.reshape(batch, num_kv_heads * n_rep, slen, hdim)\\n    \\n    # ===== ATTENTION BLOCK =====\\n    residual1 = hidden_states\\n    \\n    # Pre-attention normalization\\n    hidden_states = rms_norm(hidden_states, input_layernorm_weight, rms_norm_eps)\\n    \\n    # QKV projections\\n    query_states = F.linear(hidden_states, q_proj_weight)\\n    key_states = F.linear(hidden_states, k_proj_weight)\\n    value_states = F.linear(hidden_states, v_proj_weight)\\n    \\n    # Reshape for attention\\n    query_states = query_states.view(batch_size, seq_len, num_attention_heads, head_dim).transpose(1, 2)\\n    key_states = key_states.view(batch_size, seq_len, num_key_value_heads, head_dim).transpose(1, 2)\\n    value_states = value_states.view(batch_size, seq_len, num_key_value_heads, head_dim).transpose(1, 2)\\n    \\n    # Apply RoPE - cos and sin have shape (batch, seq_len, half_head_dim)\\n    # Expand to (batch, 1, seq_len, half_head_dim) for broadcasting\\n    cos_expanded = cos.unsqueeze(1)\\n    sin_expanded = sin.unsqueeze(1)\\n    \\n    # Rotate query: split into first half and second half\\n    q1 = query_states[..., :half_dim]\\n    q2 = query_states[..., half_dim:]\\n    query_states = torch.cat([q1 * cos_expanded - q2 * sin_expanded, q1 * sin_expanded + q2 * cos_expanded], dim=-1)\\n    \\n    # Rotate key: split into first half and second half\\n    k1 = key_states[..., :half_dim]\\n    k2 = key_states[..., half_dim:]\\n    key_states = torch.cat([k1 * cos_expanded - k2 * sin_expanded, k1 * sin_expanded + k2 * cos_expanded], dim=-1)\\n    \\n    # Repeat KV heads for GQA\\n    key_states = repeat_kv(key_states, num_key_value_groups)\\n    value_states = repeat_kv(value_states, num_key_value_groups)\\n    \\n    # Attention computation\\n    attn_weights = torch.matmul(query_states, key_states.transpose(2, 3)) * scaling\\n    attn_weights = attn_weights + attention_mask\\n    attn_weights = F.softmax(attn_weights, dim=-1, dtype=torch.float32).to(query_states.dtype)\\n    attn_output = torch.matmul(attn_weights, value_states)\\n    \\n    # Reshape and project output\\n    attn_output = attn_output.transpose(1, 2).contiguous().view(batch_size, seq_len, -1)\\n    attn_output = F.linear(attn_output, o_proj_weight)\\n    \\n    # First residual connection\\n    hidden_states = residual1 + attn_output\\n    \\n    # ===== MLP BLOCK =====\\n    residual2 = hidden_states\\n    \\n    # Pre-MLP normalization\\n    hidden_states = rms_norm(hidden_states, post_attention_layernorm_weight, rms_norm_eps)\\n    \\n    # SwiGLU MLP\\n    gate = F.silu(F.linear(hidden_states, gate_proj_weight))\\n    up = F.linear(hidden_states, up_proj_weight)\\n    hidden_states = F.linear(gate * up, down_proj_weight)\\n    \\n    # Second residual connection\\n    output = residual2 + hidden_states\\n    \\n    return output\\n\"\n}\nimport torch\nimport torch.nn.functional as F\n\n@torch.no_grad()\ndef run(\n    hidden_states: torch.Tensor,\n    cos: torch.Tensor,\n    sin: torch.Tensor,\n    attention_mask: torch.Tensor,\n    input_layernorm_weight: torch.Tensor,\n    q_proj_weight: torch.Tensor,\n    k_proj_weight: torch.Tensor,\n    v_proj_weight: torch.Tensor,\n    o_proj_weight: torch.Tensor,\n    post_attention_layernorm_weight: torch.Tensor,\n    gate_proj_weight: torch.Tensor,\n    up_proj_weight: torch.Tensor,\n    down_proj_weight: torch.Tensor,\n    rms_norm_eps: float,\n):\n    # Constants\n    num_attention_heads = 64\n    num_key_value_heads = 8\n    head_dim = 96\n    num_key_value_groups = num_attention_heads // num_key_value_heads\n    scaling = head_dim ** -0.5\n    half_dim = head_dim // 2\n    \n    batch_size, seq_len, _ = hidden_states.shape\n    \n    # Helper: RMSNorm\n    def rms_norm(x, weight, eps):\n        input_dtype = x.dtype\n        x_fp32 = x.to(torch.float32)\n        variance = x_fp32.pow(2).mean(-1, keepdim=True)\n        x_normed = x_fp32 * torch.rsqrt(variance + eps)\n        return (weight * x_normed.to(input_dtype))\n    \n    # Helper: Repeat KV heads for GQA\n    def repeat_kv(x, n_rep):\n        batch, num_kv_heads, slen, hdim = x.shape\n        if n_rep == 1:\n            return x\n        x = x[:, :, None, :, :].expand(batch, num_kv_heads, n_rep, slen, hdim)\n        return x.reshape(batch, num_kv_heads * n_rep, slen, hdim)\n    \n    # ===== ATTENTION BLOCK =====\n    residual1 = hidden_states\n    \n    # Pre-attention normalization\n    hidden_states = rms_norm(hidden_states, input_layernorm_weight, rms_norm_eps)\n    \n    # QKV projections\n    query_states = F.linear(hidden_states, q_proj_weight)\n    key_states = F.linear(hidden_states, k_proj_weight)\n    value_states = F.linear(hidden_states, v_proj_weight)\n    \n    # Reshape for attention\n    query_states = query_states.view(batch_size, seq_len, num_attention_heads, head_dim).transpose(1, 2)\n    key_states = key_states.view(batch_size, seq_len, num_key_value_heads, head_dim).transpose(1, 2)\n    value_states = value_states.view(batch_size, seq_len, num_key_value_heads, head_dim).transpose(1, 2)\n    \n    # Apply RoPE - cos and sin have shape (batch, seq_len, half_head_dim)\n    # Expand to (batch, 1, seq_len, half_head_dim) for broadcasting\n    cos_expanded = cos.unsqueeze(1)\n    sin_expanded = sin.unsqueeze(1)\n    \n    # Rotate query: split into first half and second half\n    q1 = query_states[..., :half_dim]\n    q2 = query_states[..., half_dim:]\n    query_states = torch.cat([q1 * cos_expanded - q2 * sin_expanded, q1 * sin_expanded + q2 * cos_expanded], dim=-1)\n    \n    # Rotate key: split into first half and second half\n    k1 = key_states[..., :half_dim]\n    k2 = key_states[..., half_dim:]\n    key_states = torch.cat([k1 * cos_expanded - k2 * sin_expanded, k1 * sin_expanded + k2 * cos_expanded], dim=-1)\n    \n    # Repeat KV heads for GQA\n    key_states = repeat_kv(key_states, num_key_value_groups)\n    value_states = repeat_kv(value_states, num_key_value_groups)\n    \n    # Attention computation\n    attn_weights = torch.matmul(query_states, key_states.transpose(2, 3)) * scaling\n    attn_weights = attn_weights + attention_mask\n    attn_weights = F.softmax(attn_weights, dim=-1, dtype=torch.float32).to(query_states.dtype)\n    attn_output = torch.matmul(attn_weights, value_states)\n    \n    # Reshape and project output\n    attn_output = attn_output.transpose(1, 2).contiguous().view(batch_size, seq_len, -1)\n    attn_output = F.linear(attn_output, o_proj_weight)\n    \n    # First residual connection\n    hidden_states = residual1 + attn_output\n    \n    # ===== MLP BLOCK =====\n    residual2 = hidden_states\n    \n    # Pre-MLP normalization\n    hidden_states = rms_norm(hidden_states, post_attention_layernorm_weight, rms_norm_eps)\n    \n    # SwiGLU MLP\n    gate = F.silu(F.linear(hidden_states, gate_proj_weight))\n    up = F.linear(hidden_states, up_proj_weight)\n    hidden_states = F.linear(gate * up, down_proj_weight)\n    \n    # Second residual connection\n    output = residual2 + hidden_states\n    \n    return output\n{\"uuid\": \"2f42adfc-bf41-506d-bd71-7551d28f59ef\", \"axes\": {\"batch_size\": 8, \"seq_len\": 128}, \"inputs\": {\"hidden_states\": {\"type\": \"random\"}, \"cos\": {\"type\": \"random\"}, \"sin\": {\"type\": \"random\"}, \"attention_mask\": {\"type\": \"random\"}, \"input_layernorm_weight\": {\"type\": \"random\"}, \"q_proj_weight\": {\"type\": \"random\"}, \"k_proj_weight\": {\"type\": \"random\"}, \"v_proj_weight\": {\"type\": \"random\"}, \"o_proj_weight\": {\"type\": \"random\"}, \"post_attention_layernorm_weight\": {\"type\": \"random\"}, \"gate_proj_weight\": {\"type\": \"random\"}, \"up_proj_weight\": {\"type\": \"random\"}, \"down_proj_weight\": {\"type\": \"random\"}, \"rms_norm_eps\": {\"type\": \"scalar\", \"value\": 1e-05}}, \"tolerance\": {\"max_atol\": 0.009352844203218552, \"max_rtol\": 0.0078125, \"required_matched_ratio\": 0.99, \"_provenance\": \"max run-to-run error over 10 seeds x 1.25 margin, floored at torch.bfloat16 epsilon\"}}\n{\"uuid\": \"2ce4c31b-bfbf-5eb2-8985-420633baeeb3\", \"axes\": {\"batch_size\": 2, \"seq_len\": 512}, \"inputs\": {\"hidden_states\": {\"type\": \"random\"}, \"cos\": {\"type\": \"random\"}, \"sin\": {\"type\": \"random\"}, \"attention_mask\": {\"type\": \"random\"}, \"input_layernorm_weight\": {\"type\": \"random\"}, \"q_proj_weight\": {\"type\": \"random\"}, \"k_proj_weight\": {\"type\": \"random\"}, \"v_proj_weight\": {\"type\": \"random\"}, \"o_proj_weight\": {\"type\": \"random\"}, \"post_attention_layernorm_weight\": {\"type\": \"random\"}, \"gate_proj_weight\": {\"type\": \"random\"}, \"up_proj_weight\": {\"type\": \"random\"}, \"down_proj_weight\": {\"type\": \"random\"}, \"rms_norm_eps\": {\"type\": \"scalar\", \"value\": 1e-05}}, \"tolerance\": {\"max_atol\": 0.009188539908688445, \"max_rtol\": 0.0078125, \"required_matched_ratio\": 0.99, \"_provenance\": \"max run-to-run error over 10 seeds x 1.25 margin, floored at torch.bfloat16 epsilon\"}}\n{\"uuid\": \"c16c4bca-f0b9-5152-978d-e62904d170fc\", \"axes\": {\"batch_size\": 4, \"seq_len\": 256}, \"inputs\": {\"hidden_states\": {\"type\": \"random\"}, \"cos\": {\"type\": \"random\"}, \"sin\": {\"type\": \"random\"}, \"attention_mask\": {\"type\": \"random\"}, \"input_layernorm_weight\": {\"type\": \"random\"}, \"q_proj_weight\": {\"type\": \"random\"}, \"k_proj_weight\": {\"type\": \"random\"}, \"v_proj_weight\": {\"type\": \"random\"}, \"o_proj_weight\": {\"type\": \"random\"}, \"post_attention_layernorm_weight\": {\"type\": \"random\"}, \"gate_proj_weight\": {\"type\": \"random\"}, \"up_proj_weight\": {\"type\": \"random\"}, \"down_proj_weight\": {\"type\": \"random\"}, \"rms_norm_eps\": {\"type\": \"scalar\", \"value\": 1e-05}}, \"tolerance\": {\"max_atol\": 0.009251927905623793, \"max_rtol\": 0.0078125, \"required_matched_ratio\": 0.99, \"_provenance\": \"max run-to-run