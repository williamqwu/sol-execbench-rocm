{"type":"item.started","item":{"id":"item_28","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport gc,torch\nimport torch.nn.functional as F\nfrom kernel import _rms_norm,_add_rms_norm,_apply_rope_and_repeat,_swiglu\n\ndef time(name,fn,n=7):\n for _ in range(3):fn()\n torch.cuda.synchronize();ts=[]\n for _ in range(n):\n  a=torch.cuda.Event(enable_timing=True);b=torch.cuda.Event(enable_timing=True);a.record();fn();b.record();b.synchronize();ts.append(a.elapsed_time(b))\n print(name,sorted(ts)[n//2])\n\ndef bench(M):\n print('\\\\nM',M)\n x=torch.randn(M,6144,device='cuda',dtype=torch.bfloat16);u=torch.randn_like(x);w=torch.randn(6144,device='cuda',dtype=torch.bfloat16)\n def erms():\n  z=x.float();return w*(z*torch.rsqrt(z.square().mean(-1,keepdim=True)+1e-5)).to(torch.bfloat16)\n def eadd():\n  a=x+u;z=a.float();return a,w*(z*torch.rsqrt(z.square().mean(-1,keepdim=True)+1e-5)).to(torch.bfloat16)\n time('eager rms',erms);time('triton rms',lambda:_rms_norm(x,w,1e-5));time('eager add+rms',eadd);time('triton add+rms',lambda:_add_rms_norm(x,u,w,1e-5))\n g=torch.randn(M,19648,device='cuda',dtype=torch.bfloat16);up=torch.randn_like(g)\n time('eager swiglu',lambda:F.silu(g)*up);time('triton swiglu',lambda:_swiglu(g,up))\n B,S=(M//128,128) if M%128==0 else (1,M)\n q=torch.randn(B,S,6144,device='cuda',dtype=torch.bfloat16);k=torch.randn(B,S,768,device='cuda',dtype=torch.bfloat16);v=torch.randn_like(k);c=torch.randn(B,S,48,device='cuda',dtype=torch.bfloat16);s=torch.randn_like(c)\n def erope():\n  qh=q.view(B,S,64,96).transpose(1,2);kh=k.view(B,S,8,96).transpose(1,2);vh=v.view(B,S,8,96).transpose(1,2)\n  q1,q2=qh[...,:48],qh[...,48:];k1,k2=kh[...,:48],kh[...,48:]\n  qo=torch.cat((q1*c[:,None]-q2*s[:,None],q1*s[:,None]+q2*c[:,None]),-1)\n  ko=torch.cat((k1*c[:,None]-k2*s[:,None],k1*s[:,None]+k2*c[:,None]),-1)\n  ko=ko[:,:,None].expand(B,8,8,S,96).reshape(B,64,S,96);vo=vh[:,:,None].expand(B,8,8,S,96).reshape(B,64,S,96)\n  return qo,ko,vo\n time('eager r