{"type":"item.started","item":{"id":"item_18","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch\n\ntorch.set_grad_enabled(False)\n\ndef run_cur(g,r,w):\n    gw = g.t().mm(r)\n    ga = g.mm(w)\n    return ga,gw\n\ndef run_flip(g,r,w):\n    gw = r.t().mm(g).t()\n    ga = g.mm(w)\n    return ga,gw\n\ndef run_rev(g,r,w):\n    ga = g.mm(w)\n    gw = g.t().mm(r)\n    return ga,gw\n\ndef bench(fn,args,iters=40):\n    for _ in range(10): out=fn(*args)\n    torch.cuda.synchronize()\n    st=torch.cuda.Event(enable_timing=True); en=torch.cuda.Event(enable_timing=True)\n    vals=[]\n    for _ in range(iters):\n        st.record(); out=fn(*args); en.record(); en.synchronize(); vals.append(st.elapsed_time(en))\n    vals.sort()\n    return vals[len(vals)//2]\n\nw=torch.randn(2048,2048,device='cuda',dtype=torch.bfloat16)\nfor backend in ('cublaslt','cublas','ck'):\n    try:\n        torch.backends.cuda.preferred_blas_library(backend)\n        print('backend',backend)\n        for m in (256,512,1024,2048,4096,8192):\n            g=torch.randn(m,2048,device='cuda',dtype=torch.bfloat16)\n            r=torch.randn(m,2048,device='cuda',dtype=torch.bfloat16)\n            vals=[]\n            for fn in (run_cur,run_flip,run_rev):\n                try: vals.append(round(bench(fn,(g,r,w)),6))\n                except Exception as e: vals.append(type(e).__name__+':'+str(e)[:60])\n            print(m,vals)\n    except Exception as e:\n        print('backend setup error',backend,repr(e))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
