{"type":"item.started","item":{"id":"item_19","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch, time\n\ntorch.set_grad_enabled(False)\n\ndef eager(g,r,w,b,s):\n    ga=g.view(-1,2048).mm(w).view(b,s,32,64).transpose(1,2)\n    gw=g.view(-1,2048).t().mm(r.view(-1,2048))\n    return ga,gw\n\ncompiled=torch.compile(eager,fullgraph=True,dynamic=True)\n\ndef bench(fn,args,iters=100):\n    for _ in range(10): out=fn(*args)\n    torch.cuda.synchronize()\n    starts=[torch.cuda.Event(enable_timing=True) for _ in range(iters)]\n    ends=[torch.cuda.Event(enable_timing=True) for _ in range(iters)]\n    for i in range(iters):\n        starts[i].record(); out=fn(*args); ends[i].record()\n    torch.cuda.synchronize()\n    vals=sorted(a.elapsed_time(b) for a,b in zip(starts,ends))\n    return vals[iters//2],vals[0]\n\nw=torch.randn(2048,2048,device='cuda',dtype=torch.bfloat16)\nfor m in (256,512,1024,2048,4096,8192):\n    b,s=(1,m)\n    g=torch.randn(b,s,2048,device='cuda',dtype=torch.bfloat16)\n    r=torch.randn(b,s,2048,device='cuda',dtype=torch.bfloat16)\n    t=time.time(); out=compiled(g,r,w,b,s); torch.cuda.synchronize(); print('compile/warm',m,time.time()-t)\n    print(m,'eager',bench(eager,(g,r,w,b,s),30),'compiled',bench(compiled,(g,r,w,b,s),30))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
