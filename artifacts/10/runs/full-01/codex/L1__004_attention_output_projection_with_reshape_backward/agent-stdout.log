{"type":"item.started","item":{"id":"item_13","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch\n\ntorch.set_grad_enabled(False)\ns1 = torch.cuda.Stream()\ns2 = torch.cuda.Stream()\n\ndef seq(g, r, w):\n    m = g.numel() // 2048\n    gw = g.view(m, 2048).t().mm(r.view(m, 2048))\n    ga = g.view(m, 2048).mm(w)\n    return ga, gw\n\ndef par(g, r, w):\n    m = g.numel() // 2048\n    cur = torch.cuda.current_stream()\n    s1.wait_stream(cur)\n    s2.wait_stream(cur)\n    with torch.cuda.stream(s1):\n        gw = g.view(m, 2048).t().mm(r.view(m, 2048))\n    with torch.cuda.stream(s2):\n        ga = g.view(m, 2048).mm(w)\n    cur.wait_stream(s1)\n    cur.wait_stream(s2)\n    gw.record_stream(cur)\n    ga.record_stream(cur)\n    return ga, gw\n\ndef bench(fn, args, iters=100):\n    for _ in range(10):\n        out = fn(*args)\n    torch.cuda.synchronize()\n    starts = [torch.cuda.Event(enable_timing=True) for _ in range(iters)]\n    ends = [torch.cuda.Event(enable_timing=True) for _ in range(iters)]\n    for i in range(iters):\n        starts[i].record()\n        out = fn(*args)\n        ends[i].record()\n    torch.cuda.synchronize()\n    ts = torch.tensor([a.elapsed_time(b) for a,b in zip(starts, ends)])\n    return ts.median().item(), ts.min().item()\n\nw = torch.randn(2048, 2048, device='cuda', dtype=torch.bfloat16)\nfor m in (256, 512, 1024, 2048, 4096, 8192):\n    g = torch.randn(m, 2048, device='cuda', dtype=torch.bfloat16)\n    r = torch.randn(m, 2048, device='cuda', dtype=torch.bfloat16)\n    a = bench(seq, (g,r,w), 30)\n    b = bench(par, (g,r,w), 30)\n    print(m, 'seq median/min', a, 'parallel median/min', b)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
