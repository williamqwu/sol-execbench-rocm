{"type":"item.started","item":{"id":"item_27","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch, candidate, kernel, gc\n\ntols={256:0.1178428104011322,512:0.15822645797358625,1024:0.20416337270468732,2048:0.24975461975473104,4096:0.2884860369632454}\nrtol=0.0078125\nw=torch.randn(2048,2048,device='cuda',dtype=torch.bfloat16)\nfor m in tols:\n    g=torch.randn(1,m,2048,device='cuda',dtype=torch.bfloat16)\n    r=torch.randn_like(g)\n    ca,cw=candidate.run(g,r,w)\n    ba,bw=kernel.run(g,r,w)\n    rf_g=g.view(m,2048).float()\n    ra=rf_g.mm(w.float()).to(torch.bfloat16).view(1,m,32,64).transpose(1,2)\n    rw=rf_g.t().mm(r.view(m,2048).float()).to(torch.bfloat16)\n    torch.cuda.synchronize()\n    def stats(x,y):\n        d=(x.float()-y.float()).abs()\n        ok=d <= tols[m] + rtol*y.float().abs()\n        nz=y\"'!=0\n        rel=torch.where(nz,d/y.float().abs(),torch.zeros_like(d))\n        return float(ok.float().mean()),float(d.max()),float(rel.max())\n    print(m,'\"'candidate',stats(ca,ra),stats(cw,rw),'blas',stats(ba,ra),stats(bw,rw))\n    del g,r,ca,cw,ba,bw,rf_g,ra,rw\n    gc.collect(); torch.cuda.empty_cache()\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
