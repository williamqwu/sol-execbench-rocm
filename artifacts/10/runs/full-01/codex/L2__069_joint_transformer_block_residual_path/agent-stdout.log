batch * stride_kb\n    60\t            + head * stride_kh\n    61\t            + n[:, None] * stride_ks\n    62\t            + offs_d[None, :] * stride_kd\n    63\t        )\n    64\t        v_offsets = (\n    65\t            batch * stride_vb\n    66\t            + head * stride_vh\n    67\t            + n[:, None] * stride_vs\n    68\t            + offs_d[None, :] * stride_vd\n    69\t        )\n    70\t        k = tl.load(k_ptr + k_offsets, mask=n[:, None] < seq_len, other=0.0)\n    71\t        v = tl.load(v_ptr + v_offsets, mask=n[:, None] < seq_len, other=0.0)\n    72\t        scores = tl.dot(q, tl.trans(k), input_precision=\"ieee\") * 0.125\n    73\t        scores = tl.where(n[None, :] < seq_len, scores, -float(\"inf\"))\n    74\t\n    75\t        block_max = tl.maximum(row_max, tl.max(scores, axis=1))\n    76\t        correction = tl.exp(row_max - block_max)\n    77\t        probabilities = tl.exp(scores - block_max[:, None])\n    78\t        acc *= correction[:, None]\n    79\t        acc = tl.dot(probabilities, v, acc=acc, input_precision=\"ieee\")\n    80\t        row_sum = row_sum * correction + tl.sum(probabilities, axis=1)\n    81\t        row_max = block_max\n    82\t\n    83\t    acc /= row_sum[:, None]\n    84\t    out_offsets = (\n    85\t        batch * stride_ob\n    86\t        + offs_m[:, None] * stride_os\n    87\t        + head * stride_oh\n    88\t        + offs_d[None, :] * stride_od\n    89\t    )\n    90\t    tl.store(out_ptr + out_offsets, acc, mask=offs_m[:, None] < seq_len)\n    91\t\n    92\t\n    93\t@torch.no_grad()\n    94\tdef run(\n    95\t    hidden_states,\n    96\t    encoder_hidden_states,\n    97\t    temb,\n    98\t    norm1_weight,\n    99\t    norm1_bias,\n   100\t    norm1_context_weight,\n   101\t    norm1_context_bias,\n   102\t    to_q_weight,\n   103\t    to_q_bias,\n   104\t    to_k_weight,\n   105\t    to_k_bias,\n   106\t    to_v_weight,\n   107\t    to_v_bias,\n   108\t    add_q_proj_weight,\n   109\t    add_q_pro