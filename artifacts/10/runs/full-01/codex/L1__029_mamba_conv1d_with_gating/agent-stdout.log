": 2, \"seq_len\": 128}, \"inputs\": {\"hidden_states\": {\"type\": \"random\"}, \"attention_mask\": {\"type\": \"random\"}, \"in_proj_weight\": {\"type\": \"random\"}, \"in_proj_bias\": {\"type\": \"random\"}, \"conv1d_weight\": {\"type\": \"random\"}, \"conv1d_bias\": {\"type\": \"random\"}}, \"tolerance\": {\"max_atol\": 0.008672310905272063, \"max_rtol\": 0.0078125, \"required_matched_ratio\": 0.99, \"_provenance\": \"max run-to-run error over 10 seeds x 1.25 margin, floored at torch.bfloat16 epsilon\"}}\n{\"uuid\": \"63f6f33c-4f9a-5a6d-83d5-01d18bc35f0c\", \"axes\": {\"batch_size\": 64, \"seq_len\": 128}, \"inputs\": {\"hidden_states\": {\"type\": \"random\"}, \"attention_mask\": {\"type\": \"random\"}, \"in_proj_weight\": {\"type\": \"random\"}, \"in_proj_bias\": {\"type\": \"random\"}, \"conv1d_weight\": {\"type\": \"random\"}, \"conv1d_bias\": {\"type\": \"random\"}}, \"tolerance\": {\"max_atol\": 0.008721919703632197, \"max_rtol\": 0.0078125, \"required_matched_ratio\": 0.99, \"_provenance\": \"max run-to-run error over 10 seeds x 1.25 margin, floored at torch.bfloat16 epsilon\"}}\n{\"uuid\": \"1b0a2e46-4663-5292-9e93-86047940e693\", \"axes\": {\"batch_size\": 8, \"seq_len\": 1024}, \"inputs\": {\"hidden_states\": {\"type\": \"random\"}, \"attention_mask\": {\"type\": \"random\"}, \"in_proj_weight\": {\"type\": \"random\"}, \"in_proj_bias\": {\"type\": \"random\"}, \"conv1d_weight\": {\"type\": \"random\"}, \"conv1d_bias\": {\"type\": \"random\"}}, \"tolerance\": {\"max_atol\": 0.008725868147223056, \"max_rtol\": 0.0078125, \"required_matched_ratio\": 0.99, \"_provenance\": \"max run-to-run error over 10 seeds x 1.25 margin, floored at torch.bfloat16 epsilon\"}}\n{\"uuid\": \"f9cc5577-c923-58df-8b54-7cbb2a93ee4b\", \"axes\": {\"batch_size\": 2, \"seq_len\": 256}, \"inputs\": {\"hidden_states\": {\"type\": \"random\"}, \"attention_mask\": {\"type\": \"random\"}, \"in_proj_weight\": {\"type\": \"random\"}, \"in_proj_bias\": {\"type\": \"random\"}, \"conv1d_we