{"type":"item.started","item":{"id":"item_67","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport torch,numpy as np\nG=64;n=20480;torch.manual_seed(44);vals=torch.rand((G,512),device='cuda');x=torch.zeros((G,n),device='cuda');x[:,torch.arange(512,device='cuda')*4]=vals;target=x.sum(1).cpu().numpy();v=vals.cpu().numpy()\ndef down(a):\n a=a.copy();off=a.shape[-1]//2\n while off:a[...,:off]=np.float32(a[...,:off]+a[...,off:2*off]);off//=2\n return a[...,0]\ndef adj(a):\n a=a.copy()\n while a.shape[-1]>1:a=np.float32(a[...,0::2]+a[...,1::2])\n return a[...,0]\ndef seq(a):\n z=np.zeros(a.shape[:-1],np.float32)\n for i in range(a.shape[-1]):z=np.float32(z+a[...,i])\n return z\nreds={'down':down,'adj':adj,'seq':seq}\nfor wr,wfn in reds.items():\n ws=wfn(v.reshape(G,8,64))\n for yr,yfn in reds.items():\n  out=yfn(ws);d=out.view(np.int32)-target.view(np.int32);print(wr,yr,np.mean(d==0),np.mean(abs(d)),d.min(),d.max())\nprint('whole')\nfor r,f in reds.items():\n out=f(v);d=out.view(np.int32)-target.view(np.int32);print(r,np.mean(d==0),np.mean(abs(d)),d.min(),d.max())\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
