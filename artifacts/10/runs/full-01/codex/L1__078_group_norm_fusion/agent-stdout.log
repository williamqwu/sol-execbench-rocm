{"type":"item.started","item":{"id":"item_48","type":"command_execution","command":"/bin/bash -lc \"python3 -u - <<'PY'\nimport torch,triton,json,importlib.util\nimport kernel\nspec=importlib.util.spec_from_file_location('ref','reference.py');ref=importlib.util.module_from_spec(spec);spec.loader.exec_module(ref)\nfor idx in [0,1,2,3,4,6,9,11,12]:\n w=json.loads(open('workload.jsonl').readlines()[idx]);a=w['axes'];shape=tuple(a[k] for k in ('batch_size','num_channels','height','width'));B,C,H,W=shape;s=H*W;cpg=C//32;n=cpg*s;groups=B*32;torch.manual_seed(1234+idx);x=torch.rand(shape,device='cuda');wt=torch.rand(C,device='cuda');bi=torch.rand(C,device='cuda');tm=x.view(groups,n).mean(1);m=torch.empty_like(tm);kernel._mean_vec_loop_kernel[(groups,)](x,m,n=n,THREADS=512,VEC=4,num_warps=8);d=m.view(torch.int32)-tm.view(torch.int32);y=ref.run(x,wt,bi,1e-5);z=torch.empty_like(x)\n if n<=65536:kernel._variance_apply_kernel[(groups,)](x,wt,bi,m,z,n=n,spatial=s,channels_per_group=cpg,eps=1e-5,BLOCK=triton.next_power_of_2(n),num_warps=8)\n else:\n  parts=triton.cdiv(n,16384);p=torch.empty((groups,parts),device='cuda');kernel._partial_variance_kernel[(groups*parts,)](x,m,p,n=n,PARTS=parts,CHUNK=16384,BLOCK=16384,num_warps=8);chunks=triton.cdiv(n,4096);kernel._segmented_apply_kernel[(groups,chunks)](x,wt,bi,m,p,z,n=n,spatial=s,channels_per_group=cpg,parts=parts,chunks=chunks,eps=1e-5,BLOCK=4096,PARTIAL_BLOCK=triton.next_power_of_2(parts),num_warps=4)\n torch.cuda.synchronize();e=(y-z).abs();t=w['tolerance'];ok=e<=t['max_atol']+t['max_rtol']*y.abs();print(idx,shape,'mean exact',float((d==0).float().mean()),'ulpavg',float(d.float().abs().mean()),'range',d.min().item(),d.max().item(),'output',float(ok.float().mean()),flush=True)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
