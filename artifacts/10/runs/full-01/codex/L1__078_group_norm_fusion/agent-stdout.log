{"type":"item.started","item":{"id":"item_53","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport torch,numpy as np\nB,C,H,W=2,640,32,32;n=C//32*H*W;groups=B*32;torch.manual_seed(3);x=torch.rand((B,C,H,W),device='cuda');target=x.view(groups,n).sum(1).cpu().numpy();data=x.view(groups,n).cpu().numpy()\ndef down(a):\n a=a.copy(); size=a.shape[-1]\n off=size//2\n while off:\n  a[...,:off]=np.float32(a[...,:off]+a[...,off:2*off]);off//=2\n return a[...,0]\ndef adjacent(a):\n a=a.copy()\n while a.shape[-1]>1:a=np.float32(a[...,0::2]+a[...,1::2])\n return a[...,0]\ndef sequential(a):\n z=np.zeros(a.shape[:-1],np.float32)\n for i in range(a.shape[-1]):z=np.float32(z+a[...,i])\n return z\nreds={'down':down,'adj':adjacent,'seq':sequential}\ndef acc_scalar(mapping):\n acc=np.zeros((groups,512),np.float32)\n if mapping=='stride':\n  for base in range(0,n,512):\n   off=base+np.arange(512);mask=off<n;acc[:,mask]=np.float32(acc[:,mask]+data[:,off[mask]])\n else:\n  for base in range(0,n,2048):\n   for v in range(4):\n    off=base+np.arange(512)*4+v;mask=off<n;acc[:,mask]=np.float32(acc[:,mask]+data[:,off[mask]])\n return acc\ndef acc_multi(mapping):\n acc=np.zeros((groups,4,512),np.float32)\n for base in range(0,n,2048):\n  for v in range(4):\n   off=base+(np.arange(512)*4+v if mapping=='contig' else np.arange(512)+v*512);mask=off<n;acc[:,v,mask]=np.float32(acc[:,v,mask]+data[:,off[mask]])\n return acc\ncandidates={}\nfor mapping in ['stride','contig']:candidates['scalar_'+mapping]=acc_scalar(mapping)\nfor mapping in ['stride','contig']:\n a=acc_multi(mapping)\n for ir,fn in reds.items():candidates['multi_'+mapping+'_'+ir]=fn(np.moveaxis(a,1,-1))\nfor name,acc in candidates.items():\n rows=acc.reshape(groups,8,64)\n for wr,wfn in reds.items():\n  ws=wfn(rows)\n  for yr,yfn in reds.items():\n   out=yfn(ws)\n   d=out.view(np.int32)-target.view(np.int32); exact=np.mean(d==0);avg=np.mean(np.abs(d))\n   if exact>.7:print(name,wr,yr,'EX',exact,'avg',avg,'range',d.min(),d.max())\nbest=[]\nfor name,acc in candidates.items():\n rows=acc.reshape(groups,8,64)\n for wr,wfn in reds.items():\n  ws=wfn(rows)\n  for yr,yfn in reds.items():\n   out=yfn(ws);d=out.view(np.int32)-target.view(np.int32);best.append((np.mean(np.abs(d)),np.mean(d==0),name,wr,yr,d.min(),d.max()))\nprint('best')\nfor v in sorted(best)[:20]:print(v)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
