{"type":"item.started","item":{"id":"item_89","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport torch,numpy as np\nG=1024;n=2560;torch.manual_seed(5);x=torch.rand((G,n),device='cuda');target=x.sum(1).cpu().numpy();d=x.cpu().numpy()\ndef red(a):\n r=a.reshape(G,8,64).copy()\n for off in [4,2,1]:r[:,:off]=np.float32(r[:,:off]+r[:,off:2*off])\n q=r[:,0]\n while q.shape[1]>1:q=np.float32(q[:,0::2]+q[:,1::2])\n return q[:,0]\ndef score(name,a):\n o=red(a);z=o.view(np.int32)-target.view(np.int32);print(name,np.mean(z==0),np.mean(abs(z)),z.min(),z.max())\n# main first 2048 4 lanes\nv=[d[:,np.arange(512)*4+i] for i in range(4)]\nseq=np.float32(np.float32(np.float32(v[0]+v[1])+v[2])+v[3])\ntail=d[:,2048+np.arange(512)]\nscore('seq+tail',np.float32(seq+tail));score('tail+seq',np.float32(tail+seq))\nfor i in range(4):\n a=[q.copy() for q in v];a[i]=np.float32(a[i]+tail);s=np.float32(np.float32(np.float32(a[0]+a[1])+a[2])+a[3]);score('tail_acc'+str(i),s)\n# prefix512 scalar then vector bulk 512:2560 (2048 values), mapped contiguous4\nv2=[d[:,512+np.arange(512)*4+i] for i in range(4)];seq2=np.float32(np.float32(np.float32(v2[0]+v2[1])+v2[2])+v2[3]);pre=d[:,:512]\nscore('pre+seq',np.float32(pre+seq2))\nfor i in range(4):\n a=[q.copy() for q in v2];a[i]=np.float32(a[i]+pre);s=np.float32(np.float32(np.float32(a[0]+a[1])+a[2])+a[3]);score('pre_acc'+str(i),s)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
