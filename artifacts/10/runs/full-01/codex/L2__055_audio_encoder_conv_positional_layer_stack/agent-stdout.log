{"type":"item.started","item":{"id":"item_60","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch,torch.nn.functional as F,reference\naxes=dict(batch_size=3,input_seq_len=3000,output_seq_len=1500,num_mel_bins=80,d_model=5120,num_heads=20,head_dim=256,encoder_ffn_dim=20480);i=reference.get_inputs(axes,torch.device('cuda'))\nx=F.gelu(F.conv1d(i['input_features'],i['conv1_weight'],i['conv1_bias'],padding=1));x=F.gelu(F.conv1d(x,i['conv2_weight'],i['conv2_bias'],stride=2,padding=1));h=x.permute(0,2,1)+i['embed_positions_weight'];print('hidden1',h.stride());res=h;h32=h.float();print('float',h32.stride());m=h32.mean(-1,keepdim=True);v=((h32-m)**2).mean(-1,keepdim=True);n=(h32-m)/torch.sqrt(v+1e-5);print('normalized',n.stride());h=(n*i['self_attn_layer_norm_weight'].float()+i['self_attn_layer_norm_bias'].float()).bfloat16();print('normout',h.stride(),h.is_contiguous());q=F.linear(h,i['q_proj_weight'],i['q_proj_bias']);k=F.linear(h,i['k_proj_weight']);vv=F.linear(h,i['v_proj_weight'],i['v_proj_bias']);q=(q*.0625).view(3,1500,20,256).transpose(1,2).contiguous();k=k.view(3,1500,20,256).transpose(1,2).contiguous();vv=vv.view(3,1500,20,256).transpose(1,2).contiguous();p=F.softmax(torch.matmul(q,k.transpose(2,3)),dim=-1,dtype=torch.float32).to(q.dtype);a=torch.matmul(p,vv).transpose(1,2).contiguous().reshape(3,1500,5120);a=F.linear(a,i['out_proj_weight'],i['out_proj_bias']);h=res+a;print('hidden2',h.stride(),h.is_contiguous());h32=h.float();m=h32.mean(-1,keepdim=True);v=((h32-m)**2).mean(-1,keepdim=True);n=(h32-m)/torch.sqrt(v+1e-5);h=(n*i['final_layer_norm_weight'].float()+i['final_layer_norm_bias'].float()).bfloat16();print('normout2',h.stride(),h.is_contiguous())\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
