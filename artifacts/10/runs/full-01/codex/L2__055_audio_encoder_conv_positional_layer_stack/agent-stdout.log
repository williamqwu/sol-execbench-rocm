{"type":"item.started","item":{"id":"item_84","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch,torch.nn.functional as F,reference,kernel\naxes=dict(batch_size=3,input_seq_len=3000,output_seq_len=1500,num_mel_bins=80,d_model=5120,num_heads=20,head_dim=256,encoder_ffn_dim=20480);torch.manual_seed(77);inp=reference.get_inputs(axes,torch.device('cuda'))\nfor k,v in inp.items():inp[k]=torch.empty_like(v).uniform_(-.5,.5)\nx=F.gelu(F.conv1d(inp['input_features'],inp['conv1_weight'],inp['conv1_bias'],padding=1));x=F.gelu(F.conv1d(x,inp['conv2_weight'],inp['conv2_bias'],stride=2,padding=1));h=x.permute(0,2,1)+inp['embed_positions_weight'];a=kernel._reference_layer_norm(h,inp['self_attn_layer_norm_weight'],inp['self_attn_layer_norm_bias']);b=kernel._hybrid_layer_norm(h,inp['self_attn_layer_norm_weight'],inp['self_attn_layer_norm_bias']);d=(a.float()-b.float()).abs();print('norm exact/strides',(d==0).float().mean().item(),d.max().item(),a.stride(),b.stride())\nref=reference.run(**inp);got=kernel.run(**inp);d=(got.float()-ref.float()).abs();lim=2.485+.0078125*ref.float().abs();print('end',(d<=lim).float().mean().item(),d.mean().item(),d.max().item())\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
