{"type":"item.started","item":{"id":"item_7","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport time\nimport torch\nimport torch.nn.functional as F\nimport kernel\n\ntorch.manual_seed(1)\ndevice='cuda:0'\nM=256\nx=torch.randn(M,1024,device=device)\nw1=torch.randn(8192,1024,device=device)\nw2=torch.randn(1024,4096,device=device)\nfor _ in range(2):\n    got=kernel.run(x,w1,w2)\n    z=F.linear(x,w1); g,u=z.chunk(2,-1); ref=F.linear(u*(g*torch.sigmoid(g)),w2)\ntorch.cuda.synchronize()\nd=(got-ref).abs(); tol=7.1e-8+1.1920928955078125e-7*ref.abs()\nprint('max_abs',d.max().item(),'max_rel',(d/ref.abs().clamp_min(1e-30)).max().item(),'matched',(d<=tol).float().mean().item())\n\ndef bench(fn):\n    for _ in range(5): fn()\n    torch.cuda.synchronize(); s=time.perf_counter()\n    for _ in range(20): fn()\n    torch.cuda.synchronize(); return (time.perf_counter()-s)*1000/20\nprint('custom_ms',bench(lambda:kernel.run(x,w1,w2)))\nprint('ref_ms',bench(lambda:(lambda z:F.linear(z[:,4096:]*(z[:,:4096]*torch.sigmoid(z[:,:4096])),w2))(F.linear(x,w1))))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
