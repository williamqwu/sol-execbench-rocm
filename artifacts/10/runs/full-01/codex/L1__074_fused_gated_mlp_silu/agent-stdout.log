{"type":"item.started","item":{"id":"item_21","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport time, torch, torch.nn.functional as F\nfor M in [256,1024,4096,8192]:\n x=torch.randn(M,1024,device='cuda'); w1=torch.randn(8192,1024,device='cuda'); a=torch.randn(M,4096,device='cuda'); w2=torch.randn(1024,4096,device='cuda')\n def bench(fn,it):\n  for _ in range(5): y=fn()\n  torch.cuda.synchronize(); t=time.perf_counter()\n  for _ in range(it): y=fn()\n  torch.cuda.synchronize(); return (time.perf_counter()-t)*1000/it,y\n it=30 if M<4096 else 10\n b1,r1=bench(lambda:F.linear(x.view(1,M,1024),w1),it)\n b2,r2=bench(lambda:torch.mm(x,w1.t()),it)\n b3,r3=bench(lambda:torch.matmul(x,w1.t()),it)\n c1,s1=bench(lambda:F.linear(a.view(1,M,4096),w2),it)\n c2,s2=bench(lambda:torch.mm(a,w2.t()),it)\n print(M,'up linear/mm/matmul',round(b1,4),round(b2,4),round(b3,4),'exact',torch.equal(r1.view(M,-1),r2),torch.equal(r2,r3),'down linear/mm',round(c1,4),round(c2,4),'exact',torch.equal(s1.view(M,-1),s2))\n del x,w1,a,w2\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
