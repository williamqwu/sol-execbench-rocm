{"type":"item.started","item":{"id":"item_32","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport time,torch,triton,kernel\nconfigs=[]\nfor b in [64,128,256,512,1024,2048]:\n for w in ([1,2,4] if b<=256 else [4,8,16]): configs.append((b,w))\nfor M in [256,4096,12368]:\n z=torch.randn(M,8192,device='cuda'); s=torch.sigmoid(z[:,:4096]); out=torch.empty(M,4096,device='cuda'); n=M*4096\n def bench(b,w):\n  grid=(triton.cdiv(n,b),)\n  for _ in range(5): kernel._gated_mul_kernel[grid](z,s,out,n_elements=n,BLOCK=b,num_warps=w)\n  torch.cuda.synchronize(); t=time.perf_counter(); it=100 if M==256 else (30 if M==4096 else 10)\n  for _ in range(it): kernel._gated_mul_kernel[grid](z,s,out,n_elements=n,BLOCK=b,num_warps=w)\n  torch.cuda.synchronize(); return (time.perf_counter()-t)*1000/it\n print('M',M)\n for c in configs:\n  try: print(c,round(bench(*c),5))\n  except Exception as e: print(c,'ERR',str(e)[:80])\n del z,s,out\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
