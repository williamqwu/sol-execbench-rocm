{"type":"item.started","item":{"id":"item_34","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport time,torch,torch.nn.functional as F,triton,kernel\nfor M in [256,1024,4096,8192,12368]:\n x=torch.randn(M,1024,device='cuda'); w1=torch.randn(8192,1024,device='cuda'); w2=torch.randn(1024,4096,device='cuda')\n def old():\n  z=torch.mm(x,w1.t()); g=z[:,:4096]; s=torch.sigmoid(g); a=torch.empty(M,4096,device='cuda'); n=M*4096\n  kernel._gated_mul_kernel[(triton.cdiv(n,256),)](z,s,a,n_elements=n,BLOCK=256,num_warps=4)\n  return torch.mm(a,w2.t())\n def ref():\n  z=F.linear(x,w1);g,u=z.chunk(2,-1);return F.linear(u*(g*torch.sigmoid(g)),w2)\n def bench(fn,it):\n  for _ in range(5): y=fn()\n  torch.cuda.synchronize();t=time.perf_counter()\n  for _ in range(it): y=fn()\n  torch.cuda.synchronize();return (time.perf_counter()-t)*1000/it,y\n it=30 if M<=1024 else (15 if M<=4096 else 5)\n nms,y=bench(lambda:kernel.run(x.view(1,M,1024),w1,w2),it); oms,_=bench(old,it); rms,r=bench(ref,it)\n d=(y.view(M,1024)-r).abs();print(M,'new',round(nms,4),'old',round(oms,4),'ref',round(rms,4),'max',d.max().item(),'exact',torch.equal(y.view(M,1024),r))\n del x,w1,w2\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
