{"type":"item.started","item":{"id":"item_6","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch\nimport triton\n\ntorch.manual_seed(0)\nfor m in (256, 512, 1024, 2048, 4096, 8192):\n    x=torch.randn((m,2560),device='cuda',dtype=torch.bfloat16)\n    r=torch.randn_like(x)\n    w=torch.randn((2560,2560),device='cuda',dtype=torch.bfloat16)\n    ref=lambda: torch.matmul(x,w.t())+r\n    addmm=lambda: torch.addmm(r,x,w.t())\n    a=ref(); b=addmm()\n    diff=(a.float()-b.float()).abs()\n    ok=torch.isclose(a.float(),b.float(),atol=.01105,rtol=.0078125)\n    tref=triton.testing.do_bench(ref, warmup=20, rep=100)\n    tadd=triton.testing.do_bench(addmm, warmup=20, rep=100)\n    print(m, 'ref', round(tref,4), 'addmm', round(tadd,4), 'ratio', round(ok.float().mean().item(),6), 'max',diff.max().item())\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
