{"type":"item.started","item":{"id":"item_8","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch, triton\nimport kernel\n\ntorch.manual_seed(1); d='cuda'; b,s=2,293\nx=torch.randn((b,s,3072),device=d); t=torch.randn((b,3072),device=d)\nlw=torch.randn((6144,3072),device=d)/3072**.5; lb=torch.randn(6144,device=d)/100\nmean=x.mean(-1,keepdim=True); var=x.var(-1,keepdim=True,unbiased=False); den=torch.sqrt(var+1e-6)\nmod=torch.nn.functional.linear(t*torch.sigmoid(t),lw,lb)\nhr=(x-mean)/den; hr=hr*(1+mod[:,3072:].unsqueeze(1))+mod[:,:3072].unsqueeze(1)\nhz=torch.empty_like(x); rows=b*s\nkernel._norm_mod_kernel[(rows,triton.cdiv(3072,512))](x,mod,mean,den,hz,s,BLOCK=512,num_warps=4)\ntorch.cuda.synchronize(); dif=(hr-hz).abs()\nprint('max',dif.max().item(),'eq',(hr==hz).float().mean().item(), 'quant',torch.quantile(dif,torch.tensor([.5,.9,.99,1.],device=d)).cpu())\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
