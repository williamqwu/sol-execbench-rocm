{"type":"item.started","item":{"id":"item_29","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch, kernel\nfrom reference import run as ref\n\ndef make(n):\n d='cuda'; h=1280; m=3584\n return [torch.randn((n,h),device=d),torch.randn((n,h),device=d),torch.randn((m,h),device=d),torch.randn((m,),device=d),torch.randn((h,m),device=d),torch.randn((h,),device=d),torch.randn((n,m),device=d),torch.randn((n,m),device=d)]\ndef bench(fn,xs,it):\n for _ in range(10): y=fn(*xs)\n torch.cuda.synchronize()\n s=torch.cuda.Event(enable_timing=True); e=torch.cuda.Event(enable_timing=True)\n s.record()\n for _ in range(it): y=fn(*xs)\n e.record(); e.synchronize()\n return s.elapsed_time(e)/it\n\ntorch.manual_seed(3)\nfor n,it in [(64,100),(128,100),(512,100),(2048,50),(4096,30)]:\n xs=make(n); a=ref(*xs); b=kernel.run(*xs); torch.cuda.synchronize()\n print('exact',n,[torch.equal(x,y) for x,y in zip(a,b)])\n ar=bench(ref,xs,it); br=bench(kernel.run,xs,it)\n print('time',n,ar,br,ar/br)\n del xs,a,b\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
