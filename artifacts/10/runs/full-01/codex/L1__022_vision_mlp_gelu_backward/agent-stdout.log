{"type":"item.started","item":{"id":"item_30","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch, triton, kernel\n\ndef once(gg,x,B,w):\n out=torch.empty_like(gg); tmp=torch.empty_like(gg); n=gg.numel(); grid=(triton.cdiv(n,B),)\n kernel._gelu_pre_kernel[grid](x,tmp,n_elements=n,BLOCK=B,num_warps=w)\n tmp.tanh_()\n kernel._gelu_post_kernel[grid](gg,x,tmp,out,n_elements=n,BLOCK=B,num_warps=w)\n return out\n\ndef bench(n,B,w,it=100):\n gg=torch.randn((n,3584),device='cuda'); x=torch.randn_like(gg)\n for _ in range(5): y=once(gg,x,B,w)\n torch.cuda.synchronize(); s=torch.cuda.Event(True); e=torch.cuda.Event(True); s.record()\n for _ in range(it): y=once(gg,x,B,w)\n e.record(); e.synchronize(); return s.elapsed_time(e)/it\n\nfor n in (64,512,2048):\n vals=[]\n for B,w in ((128,4),(256,4),(512,4),(512,8),(1024,4),(1024,8)):\n  vals.append((B,w,bench(n,B,w,100 if n<2048 else 50)))\n print(n,vals)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
