{"type":"item.started","item":{"id":"item_18","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch, triton, kernel\nbf=torch.bfloat16; d='cuda'\nfor B,S in [(1,128),(4,256),(1,512),(1,1024),(1,3557),(1,8192)]:\n q=torch.randn(B,S,24,128,device=d,dtype=bf).transpose(1,2); k=torch.randn(B,S,8,128,device=d,dtype=bf).transpose(1,2); v=torch.randn_like(k); m=torch.randn(B,1,S,S,device=d,dtype=bf)\n def ours(): kernel._attention(q,k,v,m)\n def ref():\n  kr=k[:,:,None].expand(B,8,3,S,128).reshape(B,24,S,128); vr=v[:,:,None].expand(B,8,3,S,128).reshape(B,24,S,128)\n  z=torch.matmul(q,kr.transpose(2,3))*(128**-.5); z=torch.tanh(z/50.)*50.; z=z+m; p=torch.softmax(z,-1,dtype=torch.float32).to(bf); torch.matmul(p,vr)\n a=triton.testing.do_bench(ours,warmup=10,rep=20); b=triton.testing.do_bench(ref,warmup=10,rep=20)\n print(B,S,'ours',round(a,4),'ref',round(b,4),'speed',round(b/a,2),flush=True)\n del q,k,v,m\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
