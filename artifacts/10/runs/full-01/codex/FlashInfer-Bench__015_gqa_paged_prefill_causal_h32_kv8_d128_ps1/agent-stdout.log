_indptr\": {\"type\": \"safetensors\", \"path\": \"data/flashinfer-trace/blob/workloads/gqa_paged/gqa_paged_prefill_causal_h32_kv8_d128_ps1/gqa_paged_prefill_causal_h32_kv8_d128_ps1_f2b3ca65f1ea443dab4609f0828210b6.safetensors\", \"tensor_key\": \"kv_indptr\"}, \"kv_indices\": {\"type\": \"safetensors\", \"path\": \"data/flashinfer-trace/blob/workloads/gqa_paged/gqa_paged_prefill_causal_h32_kv8_d128_ps1/gqa_paged_prefill_causal_h32_kv8_d128_ps1_f2b3ca65f1ea443dab4609f0828210b6.safetensors\", \"tensor_key\": \"kv_indices\"}, \"sm_scale\": {\"type\": \"scalar\", \"value\": 0.08838834764831843}}, \"tolerance\": {\"max_atol\": 0.0007185352869235588, \"max_rtol\": 0.0078125, \"required_matched_ratio\": 0.99, \"allow_negative_inf\": true, \"_provenance\": \"max run-to-run error over 10 seeds x 1.25 margin, floored at torch.bfloat16 epsilon\"}}\n","exit_code":0,"status":"completed"}}
