{"type":"item.started","item":{"id":"item_27","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch, torch.nn.functional as F\nfrom reference import get_inputs\nfrom kernel import run\n\ndef eager(*a):\n x,t,_,_,inw,inb,c1w,c1b,ew,eb,onw,onb,c2w,c2b,sw,sb,fnw,fnb,fw,fb,eps=a;B,S,C=x.shape;H=int(S**.5);W=S//H;xs=x.reshape(B,H,W,C).permute(0,3,1,2).contiguous();h=F.conv2d(F.silu(F.group_norm(xs,32,inw,inb,eps)),c1w,c1b,padding=1);eo=F.linear(F.silu(t),ew,eb);h=F.group_norm(h,32,onw,onb,eps);s,q=eo.chunk(2,1);h=F.conv2d(F.silu(h*(1+s[:,:,None,None])+q[:,:,None,None]),c2w,c2b,padding=1);h=h+F.conv2d(xs,sw,sb);return F.conv2d(F.silu(F.group_norm(h,32,fnw,fnb,eps)),fw,fb,padding=1)\nd=get_inputs({'batch_size':8,'token_h':32,'token_w':32},torch.device('cuda'));a=list(d.values());y0=eager(*a);y=run(*a);torch.cuda.synchronize();diff=(y-y0).abs();print('max',diff.max().item(),'close',torch.isclose(y,y0,atol=.3883855163,rtol=.013157895).float().mean().item())\nfor name,fn in [('eager',eager),('new',run)]:\n for _ in range(5):fn(*a)\n torch.cuda.synchronize();e0=torch.cuda.Event(True);e1=torch.cuda.Event(True);e0.record()\n for _ in range(30):fn(*a)\n e1.record();e1.synchronize();print(name,e0.elapsed_time(e1)/30)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
