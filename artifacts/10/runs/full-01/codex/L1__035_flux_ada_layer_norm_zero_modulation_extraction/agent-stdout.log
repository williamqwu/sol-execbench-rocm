{"type":"item.started","item":{"id":"item_23","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch, aiter, time\nms=[5,16,32,96,128,131,192,211,373,384,449,512,691,773,853,919]\nk,n=3072,18432\nxall=torch.rand((max(ms),k),device='cuda',dtype=torch.float32)\nw=torch.rand((n,k),device='cuda',dtype=torch.float32);wt=w.t();b=torch.rand((n,),device='cuda',dtype=torch.float32)\naiter.hipb_create_extension()\nsols=aiter.hipb_findallsols(xall[:512],wt,b)\nprint('solutions',len(sols),flush=True)\nfor m in ms:\n x=xall[:m]\n for _ in range(3):ref=torch.addmm(b,x,wt)\n torch.cuda.synchronize()\n exact=[];t0=time.time()\n for s in sols:\n  try:\n   out=aiter.hipb_mm(x,wt,s,b)\n   if torch.equal(out,ref):exact.append(s)\n  except Exception:pass\n timed=[]\n for s in exact:\n  out=aiter.hipb_mm(x,wt,s,b);torch.cuda.synchronize()\n  st=torch.cuda.Event(True);en=torch.cuda.Event(True);st.record()\n  for _ in range(5):out=aiter.hipb_mm(x,wt,s,b)\n  en.record();en.synchronize();timed.append((st.elapsed_time(en)/5,s))\n timed.sort()\n st=torch.cuda.Event(True);en=torch.cuda.Event(True);st.record()\n for _ in range(30):out=torch.addmm(b,x,wt)\n en.record();en.synchronize();base=st.elapsed_time(en)/30\n print('M',m,'base',round(base,6),'exact',len(exact),'top',[(round(t,6),s) for t,s in timed[:8]],'wall',round(time.time()-t0,2),flush=True)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
