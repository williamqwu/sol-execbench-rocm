{"type":"item.started","item":{"id":"item_29","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch, aiter, statistics\nk,n=3072,18432\nw=torch.rand((n,k),device='cuda');b=torch.rand((n,),device='cuda')\naiter.hipb_create_extension();raw=torch.ops.aiter.hipb_mm\nfor m in (5,16,32):\n x=torch.rand((m,k),device='cuda')\n def ref():\n  y=torch.matmul(x,w.t())+b;return y.chunk(6,1)\n def addmm():\n  y=torch.addmm(b,x,w.t());return y.chunk(6,1)\n def hip():\n  y=raw(x,w.t(),485988,b);return y.chunk(6,1)\n def batched():\n  y=torch.baddbmm(b.view(6,1,3072),x.unsqueeze(0).expand(6,-1,-1),w.view(6,3072,k).transpose(1,2));return y.unbind(0)\n funcs={'ref':ref,'addmm':addmm,'hip':hip,'batched':batched}\n for name,fn in funcs.items():\n  for _ in range(10):out=fn()\n  torch.cuda.synchronize();ts=[]\n  for _ in range(100):\n   st=torch.cuda.Event(True);en=torch.cuda.Event(True);st.record();out=fn();en.record();en.synchronize();ts.append(st.elapsed_time(en))\n  print('M',m,name,'median',round(statistics.median(ts),6),'min',round(min(ts),6),'mean',round(statistics.mean(ts),6))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
