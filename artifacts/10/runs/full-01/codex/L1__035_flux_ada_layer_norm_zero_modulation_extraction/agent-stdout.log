{"type":"item.started","item":{"id":"item_22","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch\nk=3072;n=18432\nw=torch.rand((n,k),device='cuda',dtype=torch.float32);b=torch.rand((n,),device='cuda',dtype=torch.float32)\nfor m in (5,16,32,96,128,131,192,211,373,384,449,512,691,773,853,919):\n x=torch.rand((m,k),device='cuda',dtype=torch.float32)\n ref=torch.addmm(b,x,w.t()).view(m,6,3072).permute(1,0,2)\n vals=[]\n for p in (2,3,6):\n  q=n//p;wt=w.view(p,q,k).transpose(1,2);bt=b.view(p,1,q);xe=x[None].expand(p,-1,-1)\n  fn=lambda:torch.baddbmm(bt,xe,wt)\n  for _ in range(3):out=fn()\n  torch.cuda.synchronize();st=torch.cuda.Event(True);en=torch.cuda.Event(True);st.record()\n  for _ in range(30):out=fn()\n  en.record();en.synchronize();t=st.elapsed_time(en)/30\n  comp=out.view(p,m,6//p,3072).permute(0,2,1,3).reshape(6,m,3072)\n  d=(comp-ref).abs(); ratio=torch.isclose(comp,ref,atol=1.7e-7,rtol=1.1921e-7).float().mean().item()\n  vals.append((p,round(t,6),d.max().item(),round(ratio,6)))\n print(m,vals)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
