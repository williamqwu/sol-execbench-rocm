{"type":"item.started","item":{"id":"item_17","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch, aiter\nm,k,n=512,3072,18432\nx=torch.rand((m,k),device='cuda',dtype=torch.float32)\nw=torch.rand((n,k),device='cuda',dtype=torch.float32)\nb=torch.rand((n,),device='cuda',dtype=torch.float32)\nref=torch.nn.functional.linear(x,w,b)\nsols=[485555,485554,485551,485553,485552,485556,485557,485558,485559,485560]\naiter.hipb_create_extension()\nfor s in sols:\n    try:\n        for _ in range(3): out=aiter.hipb_mm(x,w.t(),s,b)\n        torch.cuda.synchronize()\n        st=torch.cuda.Event(enable_timing=True); en=torch.cuda.Event(enable_timing=True)\n        st.record()\n        for _ in range(30): out=aiter.hipb_mm(x,w.t(),s,b)\n        en.record(); en.synchronize()\n        d=(out-ref).abs(); exact=(out==ref).float().mean().item()\n        print(s,st.elapsed_time(en)/30,'maxabs',d.max().item(),'exact',exact)\n    except Exception as e:\n        print(s,'ERROR',e)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
