{"type":"item.started","item":{"id":"item_32","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch, aiter, time\nm,k,n=512,3072,18432\nx=torch.randn((m,k),device='cuda');w=torch.randn((n,k),device='cuda');wt=w.t();b=torch.randn((n,),device='cuda')\nref=torch.addmm(b,x,wt)\naiter.hipb_create_extension();sols=aiter.hipb_findallsols(x,wt,b)\nvalid=[];highest=[]\nfor s in sols:\n out=aiter.hipb_mm(x,wt,s,b)\n close=torch.isclose(out,ref,atol=1.6754e-7,rtol=1.1921e-7)\n ratio=close.float().mean().item()\n if ratio>=.99:valid.append((s,ratio))\n elif ratio>.9:highest.append((ratio,s))\nprint('valid',len(valid),'nonexact_high',sorted(highest,reverse=True)[:20])\ntimed=[]\nfor s,ratio in valid:\n for _ in range(2):out=aiter.hipb_mm(x,wt,s,b)\n torch.cuda.synchronize();st=torch.cuda.Event(True);en=torch.cuda.Event(True);st.record()\n for _ in range(10):out=aiter.hipb_mm(x,wt,s,b)\n en.record();en.synchronize();timed.append((st.elapsed_time(en)/10,s,ratio,torch.equal(out,ref)))\nprint('top valid')\nfor z in sorted(timed)[:20]:print(z)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
