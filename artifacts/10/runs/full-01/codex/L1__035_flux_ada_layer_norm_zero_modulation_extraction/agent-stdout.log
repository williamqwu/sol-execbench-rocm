{"type":"item.started","item":{"id":"item_20","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch\nimport torch.nn.functional as F\nms=[512,211,449,373,16,192,131,919,32,853,128,773,5,384,691,96]\nk,n=3072,18432\nxmax=torch.rand((max(ms),k),device='cuda',dtype=torch.float32)\nw=torch.rand((n,k),device='cuda',dtype=torch.float32)\nb=torch.rand((n,),device='cuda',dtype=torch.float32)\nfor m in ms:\n    x=xmax[:m]\n    ops=(('ref',lambda: torch.matmul(x,w.t())+b),('linear',lambda: F.linear(x,w,b)),('addmm',lambda: torch.addmm(b,x,w.t())))\n    row=[]; outs={}\n    for name,fn in ops:\n        for _ in range(3): out=fn()\n        torch.cuda.synchronize()\n        st=torch.cuda.Event(enable_timing=True); en=torch.cuda.Event(enable_timing=True)\n        st.record()\n        for _ in range(30): out=fn()\n        en.record();en.synchronize()\n        row.append(st.elapsed_time(en)/30);outs[name]=out\n    print(m,*(f'{v:.5f}' for v in row),'lin_exact',torch.equal(outs['ref'],outs['linear']))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
