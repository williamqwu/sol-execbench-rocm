{"type":"item.started","item":{"id":"item_13","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch, triton\nimport kernel\nfrom reference import get_inputs\n\ncases = [\n    dict(batch_size=1, seq_len=4096, total_num_images=3, total_num_videos=2),\n    dict(batch_size=2, seq_len=2048, total_num_images=2, total_num_videos=2),\n    dict(batch_size=64, seq_len=256, total_num_images=0, total_num_videos=8),\n    dict(batch_size=1, seq_len=256, total_num_images=1, total_num_videos=0),\n]\nvariants = [(64,1),(128,2),(256,4),(512,8),(256,2),(256,8)]\nfor axes in cases:\n    axes['spatial_merge_size']=2\n    axes['image_token_id']=151655\n    axes['video_token_id']=151656\n    axes['vision_start_token_id']=151652\n    x=get_inputs(axes, torch.device('cuda:0'))\n    b,s=x['input_ids'].shape\n    ni=x['image_grid_thw'].shape[0]; nv=x['video_grid_thw'].shape[0]\n    out=torch.empty((3,b,s),device='cuda',dtype=torch.int64)\n    delta=torch.empty((b,1),device='cuda',dtype=torch.int64)\n    print(f\\\"case b={b} s={s} i={ni} v={nv}\\\")\n    for tile,warps in variants:\n        def launch():\n            kernel._mrope_kernel[(triton.cdiv(s,tile),b)](\n                x['image_grid_thw'],x['video_grid_thw'],x['second_per_grid_ts'],out,delta,\n                SEQ=s,BATCH=b,NUM_IMAGES=ni,NUM_VIDEOS=nv,TILE=tile,\n                MAX_IMAGES=(ni+b-1)//b,MAX_VIDEOS=(nv+b-1)//b,num_warps=warps)\n        launch(); torch.cuda.synchronize()\n        ms=triton.testing.do_bench(launch, warmup=25, rep=100)\n        print(f\\\"  tile={tile:4} warps={warps}: {ms*1000:.3f} us\\\")\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
