{"type":"item.started","item":{"id":"item_40","type":"command_execution","command":"/bin/bash -lc \"python -u - <<'PY'\nimport torch,aiter,triton,time,gc\naiter.hipb_create_extension()\ntorch.manual_seed(7)\nw=torch.randn((51866,1280),device='cuda',dtype=torch.float16)\nmsizes=[128,256,422,512,1172,2048,4096,7184,8192,17312,39232]\nresults={}\nfor m in msizes:\n a=torch.randn((m,1280),device='cuda',dtype=torch.float16); p=w; q=a.t()\n sols=aiter.hipb_findallsols(p,q)\n rough=[]; wall=time.time()\n for idx in sols:\n  try:\n   o=aiter.hipb_mm(p,q,idx)\n   st=torch.cuda.Event(enable_timing=True); en=torch.cuda.Event(enable_timing=True)\n   st.record()\n   for _ in range(2): o=aiter.hipb_mm(p,q,idx)\n   en.record(); en.synchronize()\n   rough.append((st.elapsed_time(en)/2,idx))\n  except Exception: pass\n top=sorted(rough)[:20]\n fine=[]\n for _,idx in top:\n  try: fine.append((triton.testing.do_bench(lambda idx=idx: aiter.hipb_mm(p,q,idx),warmup=3,rep=8),idx))\n  except Exception: pass\n fine.sort(); bestms,bestidx=fine[0]\n default=triton.testing.do_bench(lambda: torch.mm(w,a.t()).t(),warmup=3,rep=8)\n o=aiter.hipb_mm(p,q,bestidx); ref=torch.mm(w,a.t()); torch.cuda.synchronize()\n maxdiff=(o-ref).abs().max().item(); equal=torch.equal(o,ref)\n print(f'M={m:5} n={len(sols)} wall={time.time()-wall:.1f}s default={default:.4f} best={bestms:.4f} idx={bestidx} speed={default/bestms:.3f} maxdiff={maxdiff} equal={equal} top5={fine[:5]}',flush=True)\n results[m]=bestidx\n del a,o,ref,p,q; gc.collect()\nprint('RESULTS',results,flush=True)\naiter.hipb_destroy_extension()\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
