{"type":"item.started","item":{"id":"item_50","type":"command_execution","command":"/bin/bash -lc \"python -u - <<'PY'\nimport torch,aiter,triton,time,gc\naiter.hipb_create_extension(); torch.manual_seed(10)\nw=torch.randn((51866,1280),device='cuda',dtype=torch.float16)\nfor m in [128,512,1172,2048,4096,7184,8192,17312]:\n a=torch.randn((m,1280),device='cuda',dtype=torch.float16); p=a; q=w.t(); sols=aiter.hipb_findallsols(p,q); rough=[]; wall=time.time()\n for idx in sols:\n  try:\n   o=aiter.hipb_mm(p,q,idx); st=torch.cuda.Event(True); en=torch.cuda.Event(True); st.record()\n   for _ in range(2):o=aiter.hipb_mm(p,q,idx)\n   en.record();en.synchronize();rough.append((st.elapsed_time(en)/2,idx))\n  except Exception:pass\n fine=[]\n for _,idx in sorted(rough)[:20]:\n  fine.append((triton.testing.do_bench(lambda idx=idx:aiter.hipb_mm(p,q,idx),warmup=3,rep=8),idx))\n fine.sort(); default=triton.testing.do_bench(lambda:torch.mm(a,w.t()),warmup=3,rep=8)\n print(f'M={m} wall={time.time()-wall:.1f} default_normal={default:.4f} best_normal={fine[0][0]:.4f} idx={fine[0][1]} top5={fine[:5]}',flush=True)\n del a,o,p,q;gc.collect()\naiter.hipb_destroy_extension()\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
