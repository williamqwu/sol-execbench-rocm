{"type":"item.started","item":{"id":"item_61","type":"command_execution","command":"/bin/bash -lc \"python -u - <<'PY'\nimport torch,aiter,triton,time\naiter.hipb_create_extension();torch.manual_seed(13)\nm=422;a=torch.randn((m,1280),device='cuda',dtype=torch.float16);w=torch.randn((51866,1280),device='cuda',dtype=torch.float16)\nfor label,p,q in [('normal',a,w.t()),('reverse',w,a.t())]:\n sols=aiter.hipb_findallsols(p,q);times=[];wall=time.time()\n for idx in sols:\n  try:\n   o=aiter.hipb_mm(p,q,idx);st=torch.cuda.Event(True);en=torch.cuda.Event(True);st.record()\n   for _ in range(10):o=aiter.hipb_mm(p,q,idx)\n   en.record();en.synchronize();times.append((st.elapsed_time(en)/10,idx))\n  except Exception:pass\n fine=[]\n for rough,idx in sorted(times)[:30]:\n  fine.append((triton.testing.do_bench(lambda idx=idx:aiter.hipb_mm(p,q,idx),warmup=5,rep=20),idx,rough))\n fine.sort();print(label,'wall',time.time()-wall,'top',fine[:15],flush=True)\n for ms,idx,_ in fine[:10]:\n  try:print(idx,aiter.getHipblasltKernelName(idx)[:150],flush=True)\n  except:pass\naiter.hipb_destroy_extension()\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
