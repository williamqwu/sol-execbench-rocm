{"type":"item.started","item":{"id":"item_39","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch,aiter,time\naiter.hipb_create_extension()\nm=256\na=torch.randn((m,1280),device='cuda',dtype=torch.float16)\nw=torch.randn((51866,1280),device='cuda',dtype=torch.float16)\nfor label,p,q in [('normal',a,w.t()),('reverse',w,a.t())]:\n sols=aiter.hipb_findallsols(p,q)\n timings=[]\n torch.cuda.synchronize(); wall=time.time()\n for j,idx in enumerate(sols):\n  try:\n   o=aiter.hipb_mm(p,q,idx)\n   st=torch.cuda.Event(enable_timing=True); en=torch.cuda.Event(enable_timing=True)\n   st.record(); o=aiter.hipb_mm(p,q,idx); en.record(); en.synchronize()\n   timings.append((st.elapsed_time(en),idx))\n  except Exception as e: pass\n print(label,'wall',time.time()-wall,'tested',len(timings),'top preliminary',sorted(timings)[:15])\n top=[idx for _,idx in sorted(timings)[:10]]\n import triton\n for idx in top:\n  ms=triton.testing.do_bench(lambda idx=idx: aiter.hipb_mm(p,q,idx),warmup=5,rep=15)\n  print(label,idx,ms)\naiter.hipb_destroy_extension()\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
