{"type":"item.started","item":{"id":"item_38","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport torch,triton,aiter,time\nB=torch.randn((6144,4096),device='cuda',dtype=torch.float16); BT=B.T\naiter.rocb_create_extension(); alltops={}; t0=time.time()\nfor m in [1,8,16,32,64,128,256,972,2053,8192]:\n A=torch.randn((m,4096),device='cuda',dtype=torch.float16)\n sols=torch.ops.aiter.rocb_findallsols(A,BT)\n rough=[]\n for idx in sols:\n  fn=lambda idx=idx:torch.ops.aiter.rocb_mm(A,BT,idx)\n  try: rough.append((triton.testing.do_bench(fn,warmup=2,rep=8),idx))\n  except Exception: pass\n finalists=sorted(rough)[:30]\n final=[]\n for _,idx in finalists:\n  fn=lambda idx=idx:torch.ops.aiter.rocb_mm(A,BT,idx)\n  final.append((triton.testing.do_bench(fn,warmup=10,rep=40),idx))\n tt=triton.testing.do_bench(lambda:torch.mm(A,BT),warmup=10,rep=40)\n best=sorted(final)[:12]; alltops[m]=best\n y=torch.ops.aiter.rocb_mm(A,BT,best[0][1]); ref=torch.mm(A,BT)\n ratio=torch.isclose(y,ref,atol=.0365,rtol=.0009765625).float().mean().item(); mx=(y-ref).abs().max().item()\n print('M',m,'n',len(sols),'torch',round(tt,5),'best',best,'ratio',ratio,'max',mx,'elapsed',round(time.time()-t0,1),flush=True)\naiter.rocb_destroy_extension()\nprint('ALLTOPS',alltops)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
