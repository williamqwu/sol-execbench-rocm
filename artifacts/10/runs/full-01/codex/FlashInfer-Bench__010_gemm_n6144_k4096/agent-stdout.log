{"type":"item.completed","item":{"id":"item_36","type":"agent_message","text":"AITER’s selectable rocBLAS backend is working, and a full solution scan found native kernels around `0.125 ms` at `M=256` versus roughly `0.165 ms` for the reference. I’m switching the tuning method to queued GPU-event measurements with an explicit cache flush; this lets me scan all 899 legal library kernels per shape without spending verifier runs or distorting the cold-cache timing."}}
{"type":"item.started","item":{"id":"item_37","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport torch,aiter,statistics,time\nm=256; A=torch.randn((m,4096),device='cuda',dtype=torch.float16); B=torch.randn((6144,4096),device='cuda',dtype=torch.float16); BT=B.T\nflush=torch.empty((256*1024*1024//4,),device='cuda',dtype=torch.float32)\naiter.rocb_create_extension(); sols=torch.ops.aiter.rocb_findallsols(A,BT)\n# establish all lazy allocations before timing\nfor idx in sols[:3]: torch.ops.aiter.rocb_mm(A,BT,idx)\ntorch.cuda.synchronize()\nevents=[]; t0=time.time()\nfor rep in range(3):\n for idx in sols:\n  flush.zero_(); s=torch.cuda.Event(enable_timing=True); e=torch.cuda.Event(enable_timing=True)\n  s.record(); y=torch.ops.aiter.rocb_mm(A,BT,idx); e.record(); events.append((idx,rep,s,e))\ntorch.cuda.synchronize(); vals={idx:[] for idx in sols}\nfor idx,rep,s,e in events: vals[idx].append(s.elapsed_time(e))\nrank=sorted((statistics.median(ts),idx,ts) for idx,ts in vals.items())\nprint('elapsed',time.time()-t0,'top')\nfor x in rank[:30]:print(x)\naiter.rocb_destroy_extension()\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
