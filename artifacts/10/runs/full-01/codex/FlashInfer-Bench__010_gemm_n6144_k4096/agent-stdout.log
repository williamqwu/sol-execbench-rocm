{"type":"item.started","item":{"id":"item_18","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport torch,triton,kernel\nm=256\nA=torch.randn((m,4096),device='cuda',dtype=torch.float16)\nB=torch.randn((6144,4096),device='cuda',dtype=torch.float16)\nprint('torch',triton.testing.do_bench(lambda:torch.mm(A,B.T),warmup=20,rep=60))\nvals=[]\nfor bk in [16,32,64,128]:\n for s in [1,2,3,4]:\n  for waves in [1,2,4]:\n   fn=lambda bk=bk,s=s,waves=waves:kernel._launch(A,B,64,128,bk,8,s,8,waves)\n   try:\n    fn();torch.cuda.synchronize()\n    t=triton.testing.do_bench(fn,warmup=15,rep=50)\n    vals.append((t,bk,s,waves))\n    print(f'{t:.4f} bk{bk} s{s} waves{waves}')\n   except Exception as e: print('ERR',bk,s,waves,type(e).__name__,str(e).splitlines()[-1])\nprint('BEST',sorted(vals)[:12])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
