{"type":"item.started","item":{"id":"item_39","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport json, torch, triton\nfrom kernel import _proj_kernel\nconfigs=[\n('64x64x64',(64,64,64,4,3)),\n('64x128x64',(64,128,64,4,3)),\n('64x256x64',(64,256,64,8,3)),\n('128x64x64',(128,64,64,4,3)),\n('128x128x64s2',(128,128,64,4,2)),\n('128x256x64',(128,256,64,8,3)),\n('128x256x32',(128,256,32,8,3)),\n]\n\ndef bench(B,S,cfg,iters=10):\n  BM,BN,BK,warps,stages=cfg; M=B*S; N=7168; K=16384\n  attn=torch.randn((B,128,S,128),device='cuda',dtype=torch.bfloat16); w=torch.randn((N,K),device='cuda',dtype=torch.bfloat16); out=torch.empty((B,S,N),device='cuda',dtype=torch.bfloat16)\n  grid=(triton.cdiv(M,BM),triton.cdiv(N,BN))\n  for _ in range(5): _proj_kernel[grid](attn,w,out,M,S,N,K,BLOCK_M=BM,BLOCK_N=BN,BLOCK_K=BK,num_warps=warps,num_stages=stages)\n  torch.cuda.synchronize(); st=torch.cuda.Event(enable_timing=True); en=torch.cuda.Event(enable_timing=True); st.record()\n  for _ in range(iters): _proj_kernel[grid](attn,w,out,M,S,N,K,BLOCK_M=BM,BLOCK_N=BN,BLOCK_K=BK,num_warps=warps,num_stages=stages)\n  en.record(); torch.cuda.synchronize(); return st.elapsed_time(en)/iters\nfor B,S in [(1,131),(1,293),(4,512),(1,997),(1,2048),(8,512),(32,128)]:\n  print('shape',B,S,B*S)\n  best=(999,None)\n  for name,cfg in configs:\n    try:\n      ms=bench(B,S,cfg,5)\n      if ms<best[0]: best=(ms,name)\n      print(f' {name:14s} {ms:.3f}')\n    except Exception as e: print(' ',name,'ERR',type(e).__name__,str(e)[:80])\n  print(' best',best)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
