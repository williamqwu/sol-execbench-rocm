{"type":"item.started","item":{"id":"item_31","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport torch, triton\nfrom kernel import _reshape_kernel\n\ndef copy_mm(attn,w,BM,BK,warps=4,stages=4,use_out=True):\n    B=attn.shape[0]; S=attn.shape[2]; M=B*S; K=w.shape[1]; N=w.shape[0]\n    a=torch.empty((M,K),device=attn.device,dtype=attn.dtype)\n    _reshape_kernel[(triton.cdiv(M,BM),triton.cdiv(K,BK))](attn,a,M,S,K,BLOCK_M=BM,BLOCK_K=BK,num_warps=warps,num_stages=stages)\n    if use_out:\n      o=torch.empty((M,N),device=attn.device,dtype=attn.dtype)\n      torch.mm(a,w.t(),out=o)\n      return o.reshape(B,S,N)\n    return torch.mm(a,w.t()).reshape(B,S,N)\n\ndef bench(B,S,configs,iters=10):\n  attn=torch.randn((B,128,S,128),device='cuda',dtype=torch.bfloat16); w=torch.randn((7168,16384),device='cuda',dtype=torch.bfloat16)\n  print('shape',B,S,'M',B*S)\n  best=(999,None)\n  for cfg in configs:\n    BM,BK,warps,stages=cfg\n    try:\n      for _ in range(5): y=copy_mm(attn,w,*cfg)\n      torch.cuda.synchronize()\n      st=torch.cuda.Event(enable_timing=True); en=torch.cuda.Event(enable_timing=True)\n      st.record()\n      for _ in range(iters): y=copy_mm(attn,w,*cfg)\n      en.record(); torch.cuda.synchronize(); ms=st.elapsed_time(en)/iters\n      if ms<best[0]: best=(ms,cfg)\n      print(' ',cfg,f'{ms:.3f}')\n    except Exception as e: print(' ',cfg,'ERR',type(e).__name__,str(e)[:80])\n  print(' BEST',best)\nconfigs=[]\nfor BM in [4,8,16,32,64]:\n  for BK in [128,256,512,1024]:\n    for warps in [4,8]:\n      configs.append((BM,BK,warps,4))\nfor shape in [(1,131),(1,293),(4,512),(1,2048),(8,512),(32,128)]:\n  bench(*shape,configs,iters=5)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
