{"type":"item.completed","item":{"id":"item_23","type":"agent_message","text":"The dispatch data says `128x256x64` is the best fused tile for almost every medium and large case, with smaller `64x*` tiles only helping the very shortest sequences. Since the reference is already a very fast library GEMM, I’m also testing a two-step path: custom Triton reshape copy plus the vendor GEMM, to see whether replacing only the contiguous copy beats PyTorch’s reshape path."}}
{"type":"item.started","item":{"id":"item_24","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport torch, triton\nimport triton.language as tl\nimport reference\nfrom kernel import _proj_kernel\n\n@triton.jit\ndef copy_kernel(attn, a, M:tl.constexpr, SEQ:tl.constexpr, K:tl.constexpr, BM:tl.constexpr, BK:tl.constexpr):\n    pid_m=tl.program_id(0); pid_k=tl.program_id(1)\n    offs_m=pid_m*BM+tl.arange(0, BM)\n    offs_k=pid_k*BK+tl.arange(0, BK)\n    b=offs_m//SEQ; s=offs_m-b*SEQ\n    head=offs_k//128; dim=offs_k-head*128\n    ptr=attn+((b[:,None]*128+head[None,:])*SEQ+s[:,None])*128+dim[None,:]\n    vals=tl.load(ptr, mask=(offs_m[:,None]<M)&(offs_k[None,:]<K), other=0.0)\n    tl.store(a+offs_m[:,None]*K+offs_k[None,:], vals, mask=(offs_m[:,None]<M)&(offs_k[None,:]<K))\n\ndef copy_matmul(attn,w,BM=16,BK=256):\n    B=attn.shape[0]; S=attn.shape[2]; M=B*S; K=w.shape[1]\n    a=torch.empty((M,K),device=attn.device,dtype=attn.dtype)\n    grid=(triton.cdiv(M,BM),triton.cdiv(K,BK))\n    copy_kernel[grid](attn,a,M,S,K,BM=BM,BK=BK,num_warps=4,num_stages=4)\n    return torch.matmul(a,w.t()).reshape(B,S,w.shape[0])\n\ndef fused(attn,w):\n    B=attn.shape[0]; S=attn.shape[2]; M=B*S; N=w.shape[0]; K=w.shape[1]\n    out=torch.empty((B,S,N),device=attn.device,dtype=attn.dtype)\n    BM,BN,BK,warps,stages=(128,256,64,8,3)\n    if M <= 160: BM,BN,BK,warps,stages=(64,64,64,4,3)\n    elif M <= 260: BM,BN,BK,warps,stages=(64,128,64,4,3)\n    grid=(triton.cdiv(M,BM),triton.cdiv(N,BN))\n    _proj_kernel[grid](attn,w,out,M,S,N,K,BLOCK_M=BM,BLOCK_N=BN,BLOCK_K=BK,num_warps=warps,num_stages=stages)\n    return out\n\ndef bench(fn,attn,w,iters=20):\n    y=fn(attn,w); torch.cuda.synchronize()\n    for _ in range(5): y=fn(attn,w)\n    torch.cuda.synchronize()\n    st=torch.cuda.Event(enable_timing=True); en=torch.cuda.Event(enable_timing=True)\n    st.record()\n    for _ in range(iters): y=fn(attn,w)\n    en.record(); torch.cuda.synchronize()\n    return st.elapsed_time(en)/iters\n\nfor B,S in [(1,131),(1,293),(4,512),(1,2048),(8,512),(32,128)]:\n    print('shape',B,S,'M',B*S)\n    attn=torch.randn((B,128,S,128), device='cuda', dtype=torch.bfloat16)\n    w=torch.randn((7168,16384), device='cuda', dtype=torch.bfloat16)\n    for name,fn in [('ref',reference.run),('copy16x256',lambda a,b: copy_matmul(a,b,16,256)),('copy16x512',lambda a,b: copy_matmul(a,b,16,512)),('copy32x256',lambda a,b: copy_matmul(a,b,32,256)),('fused',fused)]:\n        try:\n            print(f'  {name:12s}', f'{bench(fn,attn,w,10):.3f}')\n        except Exception as e:\n            print(' ',name,'ERR',type(e).__name__,str(e)[:100])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
