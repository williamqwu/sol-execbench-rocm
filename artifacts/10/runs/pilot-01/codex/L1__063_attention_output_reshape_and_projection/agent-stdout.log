{"type":"item.started","item":{"id":"item_46","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport torch,triton\nfrom kernel import _reshape_kernel\n\ndef run(attn,w,cfg):\n BM,BK,warps,stages=cfg; B=attn.shape[0]; S=attn.shape[2]; M=B*S; K=w.shape[1]; N=w.shape[0]\n a=torch.empty((M,K),device='cuda',dtype=torch.bfloat16)\n _reshape_kernel[(triton.cdiv(M,BM),triton.cdiv(K,BK))](attn,a,M,S,K,BLOCK_M=BM,BLOCK_K=BK,num_warps=warps,num_stages=stages)\n o=torch.empty((M,N),device='cuda',dtype=torch.bfloat16)\n torch.mm(a,w.t(),out=o)\n return o.reshape(B,S,N)\n\ndef bench(B,S,configs,iters=30):\n attn=torch.randn((B,128,S,128),device='cuda',dtype=torch.bfloat16); w=torch.randn((7168,16384),device='cuda',dtype=torch.bfloat16)\n print('shape',B,S)\n best=(999,None)\n for cfg in configs:\n  for _ in range(8): y=run(attn,w,cfg)\n  torch.cuda.synchronize(); st=torch.cuda.Event(enable_timing=True); en=torch.cuda.Event(enable_timing=True); st.record()\n  for _ in range(iters): y=run(attn,w,cfg)\n  en.record(); torch.cuda.synchronize(); ms=st.elapsed_time(en)/iters\n  if ms<best[0]: best=(ms,cfg)\n  print(' ',cfg,f'{ms:.4f}')\n print(' best',best)\nconfigs=[(4,512,4,4),(8,512,4,4),(8,1024,4,4),(16,512,4,4),(16,1024,8,4),(32,256,4,4),(32,512,4,4),(64,256,4,4),(64,512,8,4),(64,1024,4,4)]\nfor shape in [(4,1024),(2,2048),(8,512),(32,128)]: bench(*shape,configs)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
