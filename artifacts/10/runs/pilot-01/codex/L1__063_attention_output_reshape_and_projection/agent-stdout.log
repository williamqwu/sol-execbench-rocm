{"type":"item.started","item":{"id":"item_28","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport torch, triton\nfrom kernel import _reshape_kernel\n\ndef copy_mm(attn,w,BM=16,BK=512,use_out=False):\n    B=attn.shape[0]; S=attn.shape[2]; M=B*S; K=w.shape[1]; N=w.shape[0]\n    a=torch.empty((M,K),device=attn.device,dtype=attn.dtype)\n    _reshape_kernel[(triton.cdiv(M,BM),triton.cdiv(K,BK))](attn,a,M,S,K,BLOCK_M=BM,BLOCK_K=BK,num_warps=4,num_stages=4)\n    if use_out:\n        o=torch.empty((M,N),device=attn.device,dtype=attn.dtype)\n        torch.mm(a,w.t(),out=o)\n        return o.reshape(B,S,N)\n    return torch.mm(a,w.t()).reshape(B,S,N)\n\ndef bench(fn,attn,w,iters=20):\n    for _ in range(5): y=fn(attn,w)\n    torch.cuda.synchronize()\n    st=torch.cuda.Event(enable_timing=True); en=torch.cuda.Event(enable_timing=True)\n    st.record()\n    for _ in range(iters): y=fn(attn,w)\n    en.record(); torch.cuda.synchronize(); return st.elapsed_time(en)/iters\nfor B,S in [(1,131),(1,293),(4,512),(1,2048),(8,512),(32,128)]:\n  print('shape',B,S)\n  attn=torch.randn((B,128,S,128),device='cuda',dtype=torch.bfloat16); w=torch.randn((7168,16384),device='cuda',dtype=torch.bfloat16)\n  for use_out in [False,True]:\n    print(' out',use_out, f'{bench(lambda a,b: copy_mm(a,b,16,512,use_out),attn,w,10):.3f}')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
