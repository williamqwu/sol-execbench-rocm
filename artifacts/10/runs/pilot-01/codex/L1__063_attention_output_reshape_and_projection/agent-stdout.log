{"type":"item.started","item":{"id":"item_41","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport torch, reference\n\ndef eins(attn,w):\n    return torch.einsum('bhsd,ohd->bso', attn, w.view(w.shape[0],128,128))\n\ndef tens(attn,w):\n    # same contraction via permute to see backend behavior\n    return torch.tensordot(attn, w.view(w.shape[0],128,128), dims=([1,3],[1,2]))\ntry:\n    ceins=torch.compile(eins, mode='max-autotune')\nexcept Exception as e:\n    ceins=None; print('compile setup err',e)\n\ndef bench(fn,attn,w,iters=10):\n    for _ in range(5): y=fn(attn,w)\n    torch.cuda.synchronize()\n    st=torch.cuda.Event(enable_timing=True); en=torch.cuda.Event(enable_timing=True); st.record()\n    for _ in range(iters): y=fn(attn,w)\n    en.record(); torch.cuda.synchronize(); return st.elapsed_time(en)/iters\nfor B,S in [(1,131),(1,293),(4,512),(1,2048),(8,512),(32,128)]:\n  print('shape',B,S)\n  attn=torch.randn((B,128,S,128),device='cuda',dtype=torch.bfloat16); w=torch.randn((7168,16384),device='cuda',dtype=torch.bfloat16)\n  ref=reference.run(attn,w)\n  for name,fn in [('ref',reference.run),('einsum',eins),('tensordot',tens)]+([('compile_eins',ceins)] if ceins else []):\n    try:\n      y=fn(attn,w); torch.cuda.synchronize();\n      d=(y.float()-ref.float()).abs().max().item()\n      print(f' {name:12s}', f'{bench(fn,attn,w,5):.3f}', 'maxd', d)\n    except Exception as e: print(' ',name,'ERR',type(e).__name__,str(e)[:120])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
