{"type":"item.started","item":{"id":"item_43","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport torch,triton\nfrom kernel import _proj_kernel\nconfigs=[]\nfor BM in [128,256]:\n for BN in [128,256]:\n  for BK in [32,64,128]:\n   for warps in [4,8]:\n    for stages in [2,3]:\n     configs.append((BM,BN,BK,warps,stages))\n# add compile autotune promising extras\ndef bench(B,S,cfg,iters=5):\n BM,BN,BK,warps,stages=cfg; M=B*S; N=7168; K=16384\n attn=torch.randn((B,128,S,128),device='cuda',dtype=torch.bfloat16); w=torch.randn((N,K),device='cuda',dtype=torch.bfloat16); out=torch.empty((B,S,N),device='cuda',dtype=torch.bfloat16)\n grid=(triton.cdiv(M,BM),triton.cdiv(N,BN))\n for _ in range(3): _proj_kernel[grid](attn,w,out,M,S,N,K,BLOCK_M=BM,BLOCK_N=BN,BLOCK_K=BK,num_warps=warps,num_stages=stages)\n torch.cuda.synchronize(); st=torch.cuda.Event(enable_timing=True); en=torch.cuda.Event(enable_timing=True); st.record()\n for _ in range(iters): _proj_kernel[grid](attn,w,out,M,S,N,K,BLOCK_M=BM,BLOCK_N=BN,BLOCK_K=BK,num_warps=warps,num_stages=stages)\n en.record(); torch.cuda.synchronize(); return st.elapsed_time(en)/iters\nfor shape in [(4,512),(8,512),(32,128)]:\n print('shape',shape)\n best=[]\n for c in configs:\n  try:\n   ms=bench(*shape,c,iters=3); best.append((ms,c))\n  except Exception as e:\n   # print err for maybe best configs only no\n   pass\n for ms,c in sorted(best)[:12]: print(f' {ms:.3f}',c)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
