{"type":"item.started","item":{"id":"item_19","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport torch, triton\nfrom kernel import _proj_kernel\n\ndef run_config(attn,w,M,S,N,K,c,iters=10):\n    BM,BN,BK,warps,stages,*rest=c\n    extra={}\n    if rest:\n        for item in rest:\n            extra.update(item)\n    out=torch.empty((M//S,S,N), device='cuda', dtype=torch.bfloat16)\n    grid=(triton.cdiv(M,BM), triton.cdiv(N,BN))\n    for _ in range(3):\n        _proj_kernel[grid](attn,w,out,M,S,N,K,BLOCK_M=BM,BLOCK_N=BN,BLOCK_K=BK,num_warps=warps,num_stages=stages,**extra)\n    torch.cuda.synchronize()\n    st=torch.cuda.Event(enable_timing=True); en=torch.cuda.Event(enable_timing=True)\n    st.record()\n    for _ in range(iters):\n        _proj_kernel[grid](attn,w,out,M,S,N,K,BLOCK_M=BM,BLOCK_N=BN,BLOCK_K=BK,num_warps=warps,num_stages=stages,**extra)\n    en.record(); torch.cuda.synchronize()\n    return st.elapsed_time(en)/iters\n\nB,S=4,512; M=B*S; N=7168; K=16384\nattn=torch.randn((B,128,S,128), device='cuda', dtype=torch.bfloat16)\nw=torch.randn((N,K), device='cuda', dtype=torch.bfloat16)\nconfigs=[]\nfor BM in [64,128]:\n  for BN in [64,128,256]:\n    for BK in [32,64,128,256]:\n      for warps in [4,8]:\n        for stages in [2,3,4]:\n          configs.append((BM,BN,BK,warps,stages))\n# try amd extras on promising\nfor mi in [16,32]:\n  configs.append((64,128,64,4,3,{'matrix_instr_nonkdim':mi}))\n  configs.append((64,128,64,8,3,{'matrix_instr_nonkdim':mi}))\n  configs.append((128,128,64,4,3,{'matrix_instr_nonkdim':mi}))\n\nbest=[]\nfor c in configs:\n    try:\n        ms=run_config(attn,w,M,S,N,K,c,iters=5)\n        best.append((ms,c)); print(f'{ms:.3f}', c)\n    except Exception as e:\n        print('ERR',c,type(e).__name__,str(e)[:100])\nprint('BEST')\nfor ms,c in sorted(best)[:15]: print(f'{ms:.3f}', c)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
