{"type":"item.completed","item":{"id":"item_16","type":"agent_message","text":"The numerical tolerance is fairly loose because every output is `bfloat16`, so I’m testing whether the large projection GEMMs can run in BF16 while keeping the softmax/attention algebra in FP32. If that stays inside tolerance, it should cut the main cost substantially."}}
{"type":"item.started","item":{"id":"item_17","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport json, torch, torch.nn.functional as F\nimport reference\n\n@torch.no_grad()\ndef run_bf16proj(grad_output, hidden_states, query_states, key_states, value_states, cu_seqlens, q_weight, k_weight, v_weight, out_weight):\n    T=hidden_states.shape[0]; H=query_states.shape[1]; D=query_states.shape[3]; scaling=D**-0.5\n    # bf16 output projection, fp32 attention math after cast\n    grad_attn_output = torch.matmul(grad_output, out_weight).to(torch.float32)\n    qf=query_states.float(); kf=key_states.float(); vf=value_states.float()\n    # derive chunks from shape for this local experiment\n    n=cu_seqlens.numel()-1; base=T//n; rem=T%n\n    lengths=[base+(1 if i<rem else 0) for i in range(n)]\n    q_chunks=qf.split(lengths, dim=2); k_chunks=kf.split(lengths, dim=2); v_chunks=vf.split(lengths, dim=2)\n    ga_chunks=grad_attn_output.reshape(T,H,D).transpose(0,1).unsqueeze(0).split(lengths, dim=2)\n    outs=[]; gqs=[]; gks=[]; gvs=[]\n    for ga,q,k,v in zip(ga_chunks,q_chunks,k_chunks,v_chunks):\n        aw=torch.matmul(q,k.transpose(-2,-1))*scaling\n        aw=F.softmax(aw, dim=-1, dtype=torch.float32)\n        outs.append(torch.matmul(aw,v))\n        gv=torch.matmul(aw.transpose(-2,-1),ga)\n        gaw=torch.matmul(ga, v.transpose(-2,-1))\n        gaw=aw*(gaw-(aw*gaw).sum(dim=-1, keepdim=True))\n        gqs.append(torch.matmul(gaw,k)*scaling)\n        gks.append(torch.matmul(gaw.transpose(-2,-1),q)*scaling)\n        gvs.append(gv)\n    attn=torch.cat(outs, dim=2).squeeze(0).transpose(0,1).reshape(T,-1).contiguous()\n    gq=torch.cat(gqs, dim=2).squeeze(0).transpose(0,1).reshape(T,-1).contiguous()\n    gk=torch.cat(gks, dim=2).squeeze(0).transpose(0,1).reshape(T,-1).contiguous()\n    gv=torch.cat(gvs, dim=2).squeeze(0).transpose(0,1).reshape(T,-1).contiguous()\n    # bf16 input tensor-core GEMMs for final bf16 outputs\n    gqb=gq.bfloat16(); gkb=gk.bfloat16(); gvb=gv.bfloat16(); attnb=attn.bfloat16()\n    gow=torch.matmul(grad_output.t(), attnb)\n    gob=grad_output.float().sum(0)\n    gqw=torch.matmul(gqb.t(), hidden_states)\n    gkw=torch.matmul(gkb.t(), hidden_states)\n    gvw=torch.matmul(gvb.t(), hidden_states)\n    gh=(torch.matmul(gqb, q_weight).float()+torch.matmul(gkb,k_weight).float()+torch.matmul(gvb,v_weight).float())\n    return (gh.bfloat16(), gqw.bfloat16(), gq.sum(0).bfloat16(), gkw.bfloat16(), gk.sum(0).bfloat16(), gvw.bfloat16(), gv.sum(0).bfloat16(), gow.bfloat16(), gob.bfloat16())\n\ndef matched(a,b,atol,rtol):\n    af=a.float(); bf=b.float(); diff=(af-bf).abs(); ok=diff <= (atol + rtol*bf.abs())\n    return float(ok.float().mean()), float(diff.max()), float(((diff/(bf.abs()+1e-30))).max())\n\nfor i,line in enumerate(open('workload.jsonl')):\n    w=json.loads(line); axes={**w['axes'], 'd_model':1280, 'num_heads':20, 'head_dim':64}\n    inputs=reference.get_inputs(axes, torch.device('cuda:0'))\n    ref=reference.run(**inputs); out=run_bf16proj(**inputs); torch.cuda.synchronize()\n    ratios=[]; maxabs=[]\n    for a,b in zip(out, ref):\n        r,ma,mr=matched(a,b,w['tolerance']['max_atol'],w['tolerance']['max_rtol'])\n        ratios.append(r); maxabs.append(ma)\n    print(i, axes['total_seq_len'], min(ratios), max(maxabs), 'badouts', [j for j,r in enumerate(ratios) if r<0.99])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
