{"type":"item.started","item":{"id":"item_21","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport json, time, torch, torch.nn.functional as F\nimport reference\n\ndef chunks(T,n):\n    b=T//n; r=T%n; return [b+(1 if i<r else 0) for i in range(n)]\n\n@torch.no_grad()\ndef attention(inputs):\n    grad_output=inputs['grad_output']; hidden_states=inputs['hidden_states']; query_states=inputs['query_states']; key_states=inputs['key_states']; value_states=inputs['value_states']; out_weight=inputs['out_weight']; cu_seqlens=inputs['cu_seqlens']\n    T=hidden_states.shape[0]; H=query_states.shape[1]; D=query_states.shape[3]; scaling=D**-0.5\n    gof=grad_output.float(); qf=query_states.float(); kf=key_states.float(); vf=value_states.float()\n    ga=torch.matmul(gof, out_weight.float())\n    lens=chunks(T, cu_seqlens.numel()-1)\n    qs=qf.split(lens,2); ks=kf.split(lens,2); vs=vf.split(lens,2); gas=ga.reshape(T,H,D).transpose(0,1).unsqueeze(0).split(lens,2)\n    outs=[]; gqs=[]; gks=[]; gvs=[]\n    for g,q,k,v in zip(gas,qs,ks,vs):\n        aw=F.softmax(torch.matmul(q,k.transpose(-2,-1))*scaling, dim=-1, dtype=torch.float32)\n        outs.append(torch.matmul(aw,v))\n        gv=torch.matmul(aw.transpose(-2,-1),g)\n        gaw=torch.matmul(g,v.transpose(-2,-1)); gaw=aw*(gaw-(aw*gaw).sum(-1,keepdim=True))\n        gqs.append(torch.matmul(gaw,k)*scaling); gks.append(torch.matmul(gaw.transpose(-2,-1),q)*scaling); gvs.append(gv)\n    attn=torch.cat(outs,2).squeeze(0).transpose(0,1).reshape(T,-1).contiguous()\n    gq=torch.cat(gqs,2).squeeze(0).transpose(0,1).reshape(T,-1).contiguous(); gk=torch.cat(gks,2).squeeze(0).transpose(0,1).reshape(T,-1).contiguous(); gv=torch.cat(gvs,2).squeeze(0).transpose(0,1).reshape(T,-1).contiguous()\n    return gof,gq,gk,gv,attn\n\n@torch.no_grad()\ndef run_sep(inputs):\n    gof,gq,gk,gv,attn=attention(inputs)\n    hs=inputs['hidden_states']; hsf=hs.float()\n    gh=(gq@inputs['q_weight'].float()+gk@inputs['k_weight'].float()+gv@inputs['v_weight'].float()).bfloat16()\n    gqw=(gq.bfloat16().t()@hs).bfloat16(); gkw=(gk.bfloat16().t()@hs).bfloat16(); gvw=(gv.bfloat16().t()@hs).bfloat16()\n    return gh,gqw,gq.sum(0).bfloat16(),gkw,gk.sum(0).bfloat16(),gvw,gv.sum(0).bfloat16(),(inputs['grad_output'].t()@attn.bfloat16()).bfloat16(),gof.sum(0).bfloat16()\n\n@torch.no_grad()\ndef run_comb_w(inputs):\n    gof,gq,gk,gv,attn=attention(inputs)\n    hs=inputs['hidden_states']\n    gh=(gq@inputs['q_weight'].float()+gk@inputs['k_weight'].float()+gv@inputs['v_weight'].float()).bfloat16()\n    gqkv=torch.cat((gq,gk,gv), dim=1)\n    gw=(gqkv.bfloat16().t()@hs).bfloat16()\n    gb=gqkv.sum(0).bfloat16()\n    return gh,gw[:1280],gb[:1280],gw[1280:2560],gb[1280:2560],gw[2560:],gb[2560:],(inputs['grad_output'].t()@attn.bfloat16()).bfloat16(),gof.sum(0).bfloat16()\n\n@torch.no_grad()\ndef run_comb_hidden(inputs):\n    gof,gq,gk,gv,attn=attention(inputs)\n    hs=inputs['hidden_states']\n    gqkv=torch.cat((gq,gk,gv), dim=1)\n    w=torch.cat((inputs['q_weight'].float(), inputs['k_weight'].float(), inputs['v_weight'].float()), dim=0)\n    gh=(gqkv@w).bfloat16()\n    gw=(gqkv.bfloat16().t()@hs).bfloat16(); gb=gqkv.sum(0).bfloat16()\n    return gh,gw[:1280],gb[:1280],gw[1280:2560],gb[1280:2560],gw[2560:],gb[2560:],(inputs['grad_output'].t()@attn.bfloat16()).bfloat16(),gof.sum(0).bfloat16()\n\ndef check(fn, inputs, tol, ref=None):\n    if ref is None: ref=reference.run(**inputs)\n    out=fn(inputs); torch.cuda.synchronize()\n    ratios=[]; maxabs=0\n    for a,b in zip(out,ref):\n        diff=(a.float()-b.float()).abs(); ok=diff <= (tol['max_atol']+tol['max_rtol']*b.float().abs())\n        ratios.append(float(ok.float().mean())); maxabs=max(maxabs,float(diff.max()))\n    return min(ratios), maxabs\n\ndef bench(fn, inputs, reps=20):\n    for _ in range(3): fn(inputs)\n    torch.cuda.synchronize()\n    start=torch.cuda.Event(enable_timing=True); end=torch.cuda.Event(enable_timing=True)\n    start.record()\n    for _ in range(reps): fn(inputs)\n    end.record(); torch.cuda.synchronize()\n    return start.elapsed_time(end)/reps\n\nfor idx in [13,8,1,0]:\n    line=list(open('workload.jsonl'))[idx]\n    w=json.loads(line); axes={**w['axes'],'d_model':1280,'num_heads':20,'head_dim':64}\n    inputs=reference.get_inputs(axes, torch.device('cuda:0'))\n    ref=reference.run(**inputs); torch.cuda.synchronize()\n    print('shape', idx, axes['total_seq_len'], axes['num_chunks'])\n    for name,fn in [('sep',run_sep),('comb_w',run_comb_w),('comb_hidden',run_comb_hidden)]:\n        r,ma=check(fn,inputs,w['tolerance'],ref)\n        ms=bench(fn,inputs,10 if axes['total_seq_len']>1000 else 20)\n        print(name, 'ratio', r, 'maxabs', ma, 'ms', ms)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
