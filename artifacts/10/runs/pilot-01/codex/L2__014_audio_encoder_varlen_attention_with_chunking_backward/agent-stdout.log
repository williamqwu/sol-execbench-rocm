{"type":"item.started","item":{"id":"item_31","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport json, torch, triton, triton.language as tl\nimport reference\n\n@triton.jit\ndef _attn_bwd_kernel(Q,K,V,dO,CU,GQKV,OUT,T:tl.constexpr, BLOCK:tl.constexpr):\n    c=tl.program_id(0)\n    h=tl.program_id(1)\n    start=tl.load(CU+c)\n    end=tl.load(CU+c+1)\n    L=end-start\n    offs=tl.arange(0, BLOCK)\n    d=tl.arange(0, 64)\n    t=start+offs\n    mask_td=(offs[:,None] < L) & (d[None,:] < 64)\n    base_h = h*T*64\n    q=tl.load(Q + base_h + t[:,None]*64 + d[None,:], mask=mask_td, other=0.0).to(tl.float32)\n    k=tl.load(K + base_h + t[:,None]*64 + d[None,:], mask=mask_td, other=0.0).to(tl.float32)\n    v=tl.load(V + base_h + t[:,None]*64 + d[None,:], mask=mask_td, other=0.0).to(tl.float32)\n    go=tl.load(dO + t[:,None]*1280 + h*64 + d[None,:], mask=mask_td, other=0.0).to(tl.float32)\n\n    scores=tl.dot(q, tl.trans(k), input_precision=\\\"ieee\\\") * 0.125\n    col=tl.arange(0, BLOCK)\n    valid=(offs[:,None] < L) & (col[None,:] < L)\n    scores=tl.where(valid, scores, -3.4028234663852886e38)\n    m=tl.max(scores, axis=1)\n    p=tl.exp(scores - m[:,None])\n    z=tl.sum(p, axis=1)\n    p=p / z[:,None]\n\n    out=tl.dot(p, v, input_precision=\\\"ieee\\\")\n    dv=tl.dot(tl.trans(p), go, input_precision=\\\"ieee\\\")\n    dp=tl.dot(go, tl.trans(v), input_precision=\\\"ieee\\\")\n    delta=tl.sum(p*dp, axis=1)\n    ds=p*(dp-delta[:,None])\n    dq=tl.dot(ds, k, input_precision=\\\"ieee\\\") * 0.125\n    dk=tl.dot(tl.trans(ds), q, input_precision=\\\"ieee\\\") * 0.125\n\n    # store OUT as (T, 1280) bf16, GQKV as (T, 3840) fp32\n    tl.store(OUT + t[:,None]*1280 + h*64 + d[None,:], out, mask=mask_td)\n    tl.store(GQKV + t[:,None]*3840 + h*64 + d[None,:], dq, mask=mask_td)\n    tl.store(GQKV + t[:,None]*3840 + 1280 + h*64 + d[None,:], dk, mask=mask_td)\n    tl.store(GQKV + t[:,None]*3840 + 2560 + h*64 + d[None,:], dv, mask=mask_td)\n\n@torch.no_grad()\ndef run_tri(inputs):\n    T=inputs['hidden_states'].shape[0]\n    gof=inputs['grad_output'].float(); outf=inputs['out_weight'].float()\n    dO=gof@outf\n    gqkv=torch.empty((T,3840),device='cuda',dtype=torch.float32)\n    out=torch.empty((T,1280),device='cuda',dtype=torch.bfloat16)\n    n=inputs['cu_seqlens'].numel()-1\n    _attn_bwd_kernel[(n,20)](inputs['query_states'],inputs['key_states'],inputs['value_states'],dO,inputs['cu_seqlens'],gqkv,out,T, BLOCK=128, num_warps=8)\n    qkv_w=torch.cat((inputs['q_weight'],inputs['k_weight'],inputs['v_weight']),0).float()\n    gh=(gqkv@qkv_w).bfloat16()\n    gw=(gqkv.bfloat16().t()@inputs['hidden_states']).bfloat16()\n    gb=gqkv.sum(0).bfloat16()\n    gow=(inputs['grad_output'].t()@out).bfloat16(); gob=gof.sum(0).bfloat16()\n    return gh, gw[:1280],gb[:1280],gw[1280:2560],gb[1280:2560],gw[2560:],gb[2560:],gow,gob\n\n# test a small and large shape\nfor idx in [13,8,1,0]:\n    w=json.loads(list(open('workload.jsonl'))[idx]); axes={**w['axes'],'d_model':1280,'num_heads':20,'head_dim':64}\n    inputs=reference.get_inputs(axes, torch.device('cuda:0'))\n    try:\n        ref=reference.run(**inputs); out=run_tri(inputs); torch.cuda.synchronize()\n    except Exception as e:\n        print('ERR', idx, e)\n        raise\n    ratios=[]; mas=[]\n    for a,b in zip(out,ref):\n        diff=(a.float()-b.float()).abs(); ok=diff <= (w['tolerance']['max_atol']+w['tolerance']['max_rtol']*b.float().abs())\n        ratios.append(float(ok.float().mean())); mas.append(float(diff.max()))\n    print('shape', idx, axes['total_seq_len'], 'minratio', min(ratios), 'maxabs', max(mas), 'badouts', [j for j,r in enumerate(ratios) if r<0.99])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
