{"type":"item.started","item":{"id":"item_74","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport json, torch, reference, kernel\nchanged={13,11,1,6,0,4,7,8,9}\nworst=1.0\nfor i,line in enumerate(open('workload.jsonl')):\n    w=json.loads(line); axes={**w['axes'],'d_model':1280,'num_heads':20,'head_dim':64}\n    inputs=reference.get_inputs(axes, torch.device('cuda:0'))\n    ref=reference.run(**inputs); out=kernel.run(**inputs); torch.cuda.synchronize()\n    ratios=[]; mas=[]\n    for a,b in zip(out,ref):\n        diff=(a.float()-b.float()).abs(); ok=diff <= (w['tolerance']['max_atol']+w['tolerance']['max_rtol']*b.float().abs())\n        ratios.append(float(ok.float().mean())); mas.append(float(diff.max()))\n    worst=min(worst,min(ratios))\n    if min(ratios)<0.99:\n        print('BAD', i, min(ratios), max(mas), [j for j,r in enumerate(ratios) if r<0.99])\n    elif i in changed:\n        print('OK', i, axes['total_seq_len'], min(ratios), max(mas))\nprint('worst', worst)\n\ndef bench(inputs, reps):\n    for _ in range(3): kernel.run(**inputs)\n    torch.cuda.synchronize()\n    s=torch.cuda.Event(enable_timing=True); e=torch.cuda.Event(enable_timing=True)\n    s.record()\n    for _ in range(reps): kernel.run(**inputs)\n    e.record(); torch.cuda.synchronize()\n    return s.elapsed_time(e)/reps\nfor idx in [13,11,1,6,0,4,7,8,9,12]:\n    w=json.loads(list(open('workload.jsonl'))[idx]); axes={**w['axes'],'d_model':1280,'num_heads':20,'head_dim':64}\n    inputs=reference.get_inputs(axes, torch.device('cuda:0'))\n    reps=20 if axes['total_seq_len']<500 else 10\n    print('time', idx, axes['total_seq_len'], bench(inputs,reps))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
