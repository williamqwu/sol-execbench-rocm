{"type":"item.started","item":{"id":"item_19","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport json, torch, torch.nn.functional as F\nimport reference\n\n@torch.no_grad()\ndef common(inputs):\n    grad_output=inputs['grad_output']; hidden_states=inputs['hidden_states']; query_states=inputs['query_states']; key_states=inputs['key_states']; value_states=inputs['value_states']; cu_seqlens=inputs['cu_seqlens']; out_weight=inputs['out_weight']\n    T=hidden_states.shape[0]; H=query_states.shape[1]; D=query_states.shape[3]; scaling=D**-0.5\n    gof=grad_output.float(); outf=out_weight.float(); qf=query_states.float(); kf=key_states.float(); vf=value_states.float()\n    grad_attn_output=torch.matmul(gof, outf)\n    n=cu_seqlens.numel()-1; base=T//n; rem=T%n\n    lengths=[base+(1 if i<rem else 0) for i in range(n)]\n    q_chunks=qf.split(lengths, dim=2); k_chunks=kf.split(lengths, dim=2); v_chunks=vf.split(lengths, dim=2)\n    ga_chunks=grad_attn_output.reshape(T,H,D).transpose(0,1).unsqueeze(0).split(lengths, dim=2)\n    outs=[]; gqs=[]; gks=[]; gvs=[]\n    for ga,q,k,v in zip(ga_chunks,q_chunks,k_chunks,v_chunks):\n        aw=torch.matmul(q,k.transpose(-2,-1))*scaling\n        aw=F.softmax(aw, dim=-1, dtype=torch.float32)\n        outs.append(torch.matmul(aw,v))\n        gv=torch.matmul(aw.transpose(-2,-1),ga)\n        gaw=torch.matmul(ga, v.transpose(-2,-1))\n        gaw=aw*(gaw-(aw*gaw).sum(dim=-1, keepdim=True))\n        gqs.append(torch.matmul(gaw,k)*scaling)\n        gks.append(torch.matmul(gaw.transpose(-2,-1),q)*scaling)\n        gvs.append(gv)\n    attn=torch.cat(outs, dim=2).squeeze(0).transpose(0,1).reshape(T,-1).contiguous()\n    gq=torch.cat(gqs, dim=2).squeeze(0).transpose(0,1).reshape(T,-1).contiguous()\n    gk=torch.cat(gks, dim=2).squeeze(0).transpose(0,1).reshape(T,-1).contiguous()\n    gv=torch.cat(gvs, dim=2).squeeze(0).transpose(0,1).reshape(T,-1).contiguous()\n    return gof, hidden_states.float(), gq, gk, gv, attn\n\n@torch.no_grad()\ndef run_var(inputs, hidden_bf16=False, weight_bf16=True, out_bf16=True):\n    gof,hsf,gq,gk,gv,attn = common(inputs)\n    grad_output=inputs['grad_output']; hidden_states=inputs['hidden_states']\n    q_weight=inputs['q_weight']; k_weight=inputs['k_weight']; v_weight=inputs['v_weight']\n    if out_bf16:\n        gow=torch.matmul(grad_output.t(), attn.bfloat16()).bfloat16()\n    else:\n        gow=torch.matmul(gof.t(), attn).bfloat16()\n    if weight_bf16:\n        gqw=torch.matmul(gq.bfloat16().t(), hidden_states).bfloat16()\n        gkw=torch.matmul(gk.bfloat16().t(), hidden_states).bfloat16()\n        gvw=torch.matmul(gv.bfloat16().t(), hidden_states).bfloat16()\n    else:\n        gqw=torch.matmul(gq.t(), hsf).bfloat16(); gkw=torch.matmul(gk.t(), hsf).bfloat16(); gvw=torch.matmul(gv.t(), hsf).bfloat16()\n    if hidden_bf16:\n        gh=(torch.matmul(gq.bfloat16(), q_weight).float()+torch.matmul(gk.bfloat16(), k_weight).float()+torch.matmul(gv.bfloat16(), v_weight).float()).bfloat16()\n    else:\n        gh=(torch.matmul(gq, q_weight.float())+torch.matmul(gk, k_weight.float())+torch.matmul(gv, v_weight.float())).bfloat16()\n    return (gh, gqw, gq.sum(0).bfloat16(), gkw, gk.sum(0).bfloat16(), gvw, gv.sum(0).bfloat16(), gow, gof.sum(0).bfloat16())\n\ndef matched(a,b,atol,rtol):\n    af=a.float(); bf=b.float(); diff=(af-bf).abs(); ok=diff <= (atol + rtol*bf.abs())\n    return float(ok.float().mean()), float(diff.max())\n\nvariants=[('weight_out_bf16',False,True,True),('weight_bf16_only',False,True,False),('out_bf16_only',False,False,True),('hidden_bf16_also',True,True,True)]\nfor name,hb,wb,ob in variants:\n    print('VAR', name)\n    worst=1.0; bad=[]; maxabs=0.0\n    for i,line in enumerate(open('workload.jsonl')):\n        w=json.loads(line); axes={**w['axes'], 'd_model':1280, 'num_heads':20, 'head_dim':64}\n        inputs=reference.get_inputs(axes, torch.device('cuda:0'))\n        ref=reference.run(**inputs); out=run_var(inputs,hb,wb,ob); torch.cuda.synchronize()\n        ratios=[]; mas=[]\n        for a,b in zip(out, ref):\n            r,ma=matched(a,b,w['tolerance']['max_atol'],w['tolerance']['max_rtol']); ratios.append(r); mas.append(ma)\n        mr=min(ratios); worst=min(worst,mr); maxabs=max(maxabs,max(mas))\n        if mr<0.99: bad.append((i,mr,[j for j,r in enumerate(ratios) if r<0.99]))\n    print('worst', worst, 'maxabs', maxabs, 'bad', bad[:5], 'n_bad', len(bad))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
