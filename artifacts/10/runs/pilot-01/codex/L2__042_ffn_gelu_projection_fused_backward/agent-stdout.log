{"type":"item.started","item":{"id":"item_18","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport json, torch\nimport reference\n\n@torch.compile(mode='reduce-overhead')\ndef ln_part(grad_output, normalized, var, ln_weight, eps):\n    grad_ln_weight = (grad_output * normalized).sum(dim=(0, 1))\n    grad_ln_bias = grad_output.sum(dim=(0, 1))\n    grad_normalized = grad_output * ln_weight\n    std = torch.sqrt(var + eps)\n    grad_normalized_mean = grad_normalized.mean(dim=-1, keepdim=True)\n    grad_normalized_normalized_mean = (grad_normalized * normalized).mean(dim=-1, keepdim=True)\n    grad_residual_output = (1.0 / std) * (grad_normalized - grad_normalized_mean - normalized * grad_normalized_normalized_mean)\n    grad_fc2_bias = grad_residual_output.sum(dim=(0, 1))\n    return grad_residual_output, grad_fc2_bias, grad_ln_weight, grad_ln_bias\n\n@torch.compile(mode='reduce-overhead')\ndef gelu_part(grad_gelu_output, fc1_output):\n    sqrt_2_over_pi = 0.7978845608028654\n    coeff = 0.044715\n    x = fc1_output\n    x_cubed = x * x * x\n    tanh_arg = sqrt_2_over_pi * (x + coeff * x_cubed)\n    tanh_out = torch.tanh(tanh_arg)\n    dtanh_arg_dx = sqrt_2_over_pi * (1.0 + 3.0 * coeff * x * x)\n    sech_sq = 1.0 - tanh_out * tanh_out\n    gelu_grad = 0.5 * (1.0 + tanh_out) + 0.5 * x * sech_sq * dtanh_arg_dx\n    grad_fc1_output = grad_gelu_output * gelu_grad\n    grad_fc1_bias = grad_fc1_output.sum(dim=(0, 1))\n    return grad_fc1_output, grad_fc1_bias\n\n@torch.no_grad()\ndef run2(grad_output, hidden_states, fc1_weight, fc1_output, gelu_output, fc2_weight, residual_output, normalized, var, ln_weight, eps):\n    B,S,H=grad_output.shape; I=fc1_weight.shape[0]\n    grad_residual_output, grad_fc2_bias, grad_ln_weight, grad_ln_bias = ln_part(grad_output, normalized, var, ln_weight, eps)\n    grad_fc2_weight = grad_residual_output.view(-1,H).t() @ gelu_output.view(-1,I)\n    grad_gelu_output = grad_residual_output @ fc2_weight\n    grad_fc1_output, grad_fc1_bias = gelu_part(grad_gelu_output, fc1_output)\n    grad_fc1_weight = grad_fc1_output.view(-1,I).t() @ hidden_states.view(-1,H)\n    grad_hidden_states = grad_fc1_output @ fc1_weight + grad_residual_output\n    return grad_hidden_states, grad_fc1_weight, grad_fc1_bias, grad_fc2_weight, grad_fc2_bias, grad_ln_weight, grad_ln_bias\n\nlines = open('workload.jsonl').read().splitlines()\nfor idx in [10,1,4]:\n    axes = json.loads(lines[idx])['axes']; axes['hidden_size']=512; axes['intermediate_size']=2048\n    inp=reference.get_inputs(axes, torch.device('cuda:0'))\n    keys=['grad_output','hidden_states','fc1_weight','fc1_output','gelu_output','fc2_weight','residual_output','normalized','var','ln_weight','eps']\n    args=[inp[k] for k in keys]\n    ref=reference.run(*args)\n    for _ in range(3): run2(*args)\n    torch.cuda.synchronize()\n    out=run2(*args); torch.cuda.synchronize()\n    diffs=[float((a-b).abs().max().item()) for a,b in zip(out,ref)]\n    ratios=[]\n    for a,b in zip(out,ref):\n        tol = 1e-6 + 1.1920928955078125e-7*b.abs()\n        ratios.append(float(((a-b).abs() <= tol).float().mean().item()))\n    print('idx', idx, 'N', axes['batch_size']*axes['seq_len'], 'max_abs', diffs, 'rough ratios', ratios)\n    st=torch.cuda.Event(True); en=torch.cuda.Event(True)\n    for _ in range(5): run2(*args)\n    torch.cuda.synchronize(); st.record()\n    for _ in range(20): run2(*args)\n    en.record(); torch.cuda.synchronize()\n    print('run2 ms', st.elapsed_time(en)/20)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
