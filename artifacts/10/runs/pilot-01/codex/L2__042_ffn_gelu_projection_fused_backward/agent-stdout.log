{"type":"item.started","item":{"id":"item_31","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport json, torch, reference, probe_triton\n\n@torch.no_grad()\ndef run_triton_ln(*args):\n    grad_output, hidden_states, fc1_weight, fc1_output, gelu_output, fc2_weight, residual_output, normalized, var, ln_weight, eps = args\n    B,S,H=grad_output.shape; I=fc1_weight.shape[0]\n    grad_ln_weight=(grad_output*normalized).sum(dim=(0,1))\n    grad_ln_bias=grad_output.sum(dim=(0,1))\n    grad_residual_output=probe_triton.triton_ln(grad_output, normalized, var, ln_weight, eps)\n    grad_fc2_bias=grad_residual_output.sum(dim=(0,1))\n    grad_fc2_weight=grad_residual_output.view(-1,H).t() @ gelu_output.view(-1,I)\n    grad_gelu_output=grad_residual_output @ fc2_weight\n    sqrt_2_over_pi=0.7978845608028654; coeff=0.044715; x=fc1_output\n    x_cubed=x*x*x; tanh_arg=sqrt_2_over_pi*(x+coeff*x_cubed); tanh_out=torch.tanh(tanh_arg)\n    dtanh_arg_dx=sqrt_2_over_pi*(1.0+3.0*coeff*x*x); sech_sq=1.0-tanh_out*tanh_out\n    gelu_grad=0.5*(1.0+tanh_out)+0.5*x*sech_sq*dtanh_arg_dx\n    grad_fc1_output=grad_gelu_output*gelu_grad\n    grad_fc1_bias=grad_fc1_output.sum(dim=(0,1))\n    grad_fc1_weight=grad_fc1_output.view(-1,I).t() @ hidden_states.view(-1,H)\n    grad_hidden_states=grad_fc1_output @ fc1_weight + grad_residual_output\n    return grad_hidden_states,grad_fc1_weight,grad_fc1_bias,grad_fc2_weight,grad_fc2_bias,grad_ln_weight,grad_ln_bias\n\nlines=open('workload.jsonl').read().splitlines(); keys=['grad_output','hidden_states','fc1_weight','fc1_output','gelu_output','fc2_weight','residual_output','normalized','var','ln_weight','eps']\nfor idx in [10,0,11,14,7,1,13,5,8,6,3,9,2,12,4,15]:\n    wl=json.loads(lines[idx]); axes=wl['axes']; axes['hidden_size']=512; axes['intermediate_size']=2048\n    inp=reference.get_inputs(axes,torch.device('cuda:0')); args=[inp[k] for k in keys]\n    ref=reference.run(*args)\n    out=run_triton_ln(*args); torch.cuda.synchronize()\n    atol=wl['tolerance']['max_atol']; rtol=wl['tolerance']['max_rtol']\n    elems=0; matched=0; per=[]; maxes=[]\n    for a,b in zip(out,ref):\n        d=(a-b).abs(); ok=d <= (atol+rtol*b.abs())\n        elems += ok.numel(); matched += int(ok.sum().item()); per.append(float(ok.float().mean().item())); maxes.append(float(d.max().item()))\n    print('idx',idx,'N',axes['batch_size']*axes['seq_len'],'total',matched/elems,'per_min',min(per),'maxmax',max(maxes),'per', [round(x,4) for x in per])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
