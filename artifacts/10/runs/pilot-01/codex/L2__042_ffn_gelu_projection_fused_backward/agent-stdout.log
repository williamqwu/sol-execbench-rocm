{"type":"item.started","item":{"id":"item_37","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport json, torch, reference\n\ndef run_poly(args, order, thr):\n    grad_output, hidden_states, fc1_weight, fc1_output, gelu_output, fc2_weight, residual_output, normalized, var, ln_weight, eps = args\n    B,S,H=grad_output.shape; I=fc1_weight.shape[0]\n    glw=(grad_output*normalized).sum((0,1)); glb=grad_output.sum((0,1)); gn=grad_output*ln_weight; std=torch.sqrt(var+eps); gm=gn.mean(-1,True); gnm=(gn*normalized).mean(-1,True); gr=(1.0/std)*(gn-gm-normalized*gnm)\n    gfb=gr.sum((0,1)); gfw=gr.view(-1,H).t() @ gelu_output.view(-1,I); ggo=gr @ fc2_weight\n    x=fc1_output; x2=x*x; xc=x2*x; z=0.7978845608028654*(x+0.044715*xc); z2=z*z\n    # Horner for odd polynomial\n    if order==15:\n        p=-929569.0/638512875.0\n        p=p*z2 + 21844.0/6081075.0\n        p=p*z2 - 1382.0/155925.0\n        p=p*z2 + 62.0/2835.0\n        p=p*z2 - 17.0/315.0\n        p=p*z2 + 2.0/15.0\n        p=p*z2 - 1.0/3.0\n        p=p*z2 + 1.0\n        th_poly=z*p\n    elif order==11:\n        p=-1382.0/155925.0; p=p*z2+62.0/2835.0; p=p*z2-17.0/315.0; p=p*z2+2.0/15.0; p=p*z2-1.0/3.0; p=p*z2+1.0; th_poly=z*p\n    th_saved=(2.0*gelu_output/x)-1.0\n    th=torch.where(x.abs()<thr, th_poly, th_saved)\n    d=0.7978845608028654*(1.0+3.0*0.044715*x*x); sech=1.0-th*th; gg=0.5*(1.0+th)+0.5*x*sech*d; gf1=ggo*gg\n    gf1b=gf1.sum((0,1)); gf1w=gf1.view(-1,I).t() @ hidden_states.view(-1,H); gh=gf1@fc1_weight+gr\n    return gh,gf1w,gf1b,gfw,gfb,glw,glb\n\nlines=open('workload.jsonl').read().splitlines(); keys=['grad_output','hidden_states','fc1_weight','fc1_output','gelu_output','fc2_weight','residual_output','normalized','var','ln_weight','eps']\ninputs=[]\nfor idx in [1,2,3,4,8,9,12,15]:\n    wl=json.loads(lines[idx]); axes=wl['axes']; axes['hidden_size']=512; axes['intermediate_size']=2048\n    inp=reference.get_inputs(axes,torch.device('cuda:0')); args=[inp[k] for k in keys]; ref=reference.run(*args); inputs.append((idx,wl,axes,args,ref))\nfor order in [11,15]:\n  for thr in [0.2,0.3,0.4,0.5,0.7,1.0,2.0]:\n    print('order',order,'thr',thr)\n    vals=[]\n    for idx,wl,axes,args,ref in inputs:\n        out=run_poly(args,order,thr); torch.cuda.synchronize(); atol=wl['tolerance']['max_atol']; rtol=wl['tolerance']['max_rtol']; elems=matched=0; per=[]\n        for a,b in zip(out,ref):\n            ok=(a-b).abs()<=(atol+rtol*b.abs()); elems+=ok.numel(); matched+=int(ok.sum()); per.append(float(ok.float().mean()))\n        vals.append(matched/elems)\n    print([round(v,4) for v in vals], 'min', round(min(vals),4))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
