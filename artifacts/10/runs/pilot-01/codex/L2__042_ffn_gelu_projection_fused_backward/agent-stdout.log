{"type":"item.started","item":{"id":"item_35","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\n# quick all-shape total ratio for saved-gelu derivative variant\nimport json, torch, reference\n@torch.no_grad()\ndef runv(*args):\n    grad_output, hidden_states, fc1_weight, fc1_output, gelu_output, fc2_weight, residual_output, normalized, var, ln_weight, eps = args\n    B,S,H=grad_output.shape; I=fc1_weight.shape[0]\n    glw=(grad_output*normalized).sum((0,1)); glb=grad_output.sum((0,1)); gn=grad_output*ln_weight; std=torch.sqrt(var+eps); gm=gn.mean(-1,True); gnm=(gn*normalized).mean(-1,True); gr=(1.0/std)*(gn-gm-normalized*gnm)\n    gfb=gr.sum((0,1)); gfw=gr.view(-1,H).t() @ gelu_output.view(-1,I); ggo=gr @ fc2_weight\n    x=fc1_output; th=(2.0*gelu_output/x)-1.0; d=0.7978845608028654*(1.0+3.0*0.044715*x*x); sech=1.0-th*th; gg=0.5*(1.0+th)+0.5*x*sech*d; gf1=ggo*gg\n    gf1b=gf1.sum((0,1)); gf1w=gf1.view(-1,I).t() @ hidden_states.view(-1,H); gh=gf1@fc1_weight+gr\n    return gh,gf1w,gf1b,gfw,gfb,glw,glb\nlines=open('workload.jsonl').read().splitlines(); keys=['grad_output','hidden_states','fc1_weight','fc1_output','gelu_output','fc2_weight','residual_output','normalized','var','ln_weight','eps']\nfor idx,line in enumerate(lines):\n    wl=json.loads(line); axes=wl['axes']; axes['hidden_size']=512; axes['intermediate_size']=2048\n    inp=reference.get_inputs(axes,torch.device('cuda:0')); args=[inp[k] for k in keys]; ref=reference.run(*args); out=runv(*args); torch.cuda.synchronize()\n    atol=wl['tolerance']['max_atol']; rtol=wl['tolerance']['max_rtol']; elems=matched=0; per=[]\n    for a,b in zip(out,ref):\n        ok=(a-b).abs()<=(atol+rtol*b.abs()); elems+=ok.numel(); matched+=int(ok.sum().item()); per.append(float(ok.float().mean()))\n    print(idx, axes['batch_size']*axes['seq_len'], matched/elems, min(per), [round(x,3) for x in per])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
