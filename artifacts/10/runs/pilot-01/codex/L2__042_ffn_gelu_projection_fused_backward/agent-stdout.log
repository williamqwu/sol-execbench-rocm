{"type":"item.started","item":{"id":"item_25","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport json, torch, reference\n\n@torch.no_grad()\ndef run_out(*args):\n    grad_output, hidden_states, fc1_weight, fc1_output, gelu_output, fc2_weight, residual_output, normalized, var, ln_weight, eps = args\n    B,S,H=grad_output.shape; I=fc1_weight.shape[0]; N=B*S\n    grad_ln_weight=(grad_output*normalized).sum(dim=(0,1))\n    grad_ln_bias=grad_output.sum(dim=(0,1))\n    grad_normalized=grad_output*ln_weight\n    std=torch.sqrt(var+eps)\n    grad_normalized_mean=grad_normalized.mean(dim=-1,keepdim=True)\n    grad_normalized_normalized_mean=(grad_normalized*normalized).mean(dim=-1,keepdim=True)\n    grad_residual_output=(1.0/std)*(grad_normalized-grad_normalized_mean-normalized*grad_normalized_normalized_mean)\n    grad_fc2_bias=grad_residual_output.sum(dim=(0,1))\n    go2=grad_residual_output.view(N,H); gelu2=gelu_output.view(N,I)\n    grad_fc2_weight=torch.empty((H,I),device=grad_output.device,dtype=grad_output.dtype)\n    torch.mm(go2.t(), gelu2, out=grad_fc2_weight)\n    grad_gelu_output=torch.empty((N,I),device=grad_output.device,dtype=grad_output.dtype)\n    torch.mm(go2, fc2_weight, out=grad_gelu_output)\n    grad_gelu_output=grad_gelu_output.view(B,S,I)\n    sqrt_2_over_pi=0.7978845608028654; coeff=0.044715; x=fc1_output\n    x_cubed=x*x*x; tanh_arg=sqrt_2_over_pi*(x+coeff*x_cubed); tanh_out=torch.tanh(tanh_arg)\n    dtanh_arg_dx=sqrt_2_over_pi*(1.0+3.0*coeff*x*x); sech_sq=1.0-tanh_out*tanh_out\n    gelu_grad=0.5*(1.0+tanh_out)+0.5*x*sech_sq*dtanh_arg_dx\n    grad_fc1_output=grad_gelu_output*gelu_grad\n    grad_fc1_bias=grad_fc1_output.sum(dim=(0,1))\n    g1o2=grad_fc1_output.view(N,I); hid2=hidden_states.view(N,H)\n    grad_fc1_weight=torch.empty((I,H),device=grad_output.device,dtype=grad_output.dtype)\n    torch.mm(g1o2.t(), hid2, out=grad_fc1_weight)\n    grad_hidden_states=torch.empty((N,H),device=grad_output.device,dtype=grad_output.dtype)\n    torch.mm(g1o2, fc1_weight, out=grad_hidden_states)\n    grad_hidden_states=grad_hidden_states.view(B,S,H)\n    grad_hidden_states=grad_hidden_states+grad_residual_output\n    return grad_hidden_states,grad_fc1_weight,grad_fc1_bias,grad_fc2_weight,grad_fc2_bias,grad_ln_weight,grad_ln_bias\n\nlines=open('workload.jsonl').read().splitlines(); keys=['grad_output','hidden_states','fc1_weight','fc1_output','gelu_output','fc2_weight','residual_output','normalized','var','ln_weight','eps']\nfor idx in [10,1,4,15]:\n    axes=json.loads(lines[idx])['axes']; axes['hidden_size']=512; axes['intermediate_size']=2048\n    inp=reference.get_inputs(axes,torch.device('cuda:0')); args=[inp[k] for k in keys]\n    ref=reference.run(*args); out=run_out(*args); torch.cuda.synchronize()\n    print('idx',idx,[float((a-b).abs().max().item()) for a,b in zip(out,ref)])\n    st=torch.cuda.Event(True); en=torch.cuda.Event(True)\n    for _ in range(10): run_out(*args)\n    torch.cuda.synchronize(); st.record(); reps=100 if idx==10 else 30 if idx==1 else 10\n    for _ in range(reps): run_out(*args)\n    en.record(); torch.cuda.synchronize()\n    print('out ms',st.elapsed_time(en)/reps)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
