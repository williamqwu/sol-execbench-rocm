{"type":"item.started","item":{"id":"item_27","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport json, torch, triton, triton.language as tl, reference\n\n@triton.jit\ndef _ln_kernel(go, norm, var, lnw, out, N:tl.constexpr, eps:tl.constexpr, BLOCK:tl.constexpr):\n    pid=tl.program_id(0)\n    offs=tl.arange(0, BLOCK)\n    m=offs < 512\n    base=pid*512+offs\n    g=tl.load(go+base, mask=m, other=0.0)\n    n=tl.load(norm+base, mask=m, other=0.0)\n    w=tl.load(lnw+offs, mask=m, other=0.0)\n    gn=g*w\n    s=tl.sum(gn, axis=0) / 512.0\n    s2=tl.sum(gn*n, axis=0) / 512.0\n    v=tl.load(var+pid)\n    inv=1.0 / tl.sqrt(v + eps)\n    r=inv * (gn - s - n*s2)\n    tl.store(out+base, r, mask=m)\n\ndef triton_ln(grad_output, normalized, var, ln_weight, eps):\n    N=grad_output.numel()//512\n    out=torch.empty_like(grad_output)\n    _ln_kernel[(N,)](grad_output, normalized, var, ln_weight, out, N, float(eps), BLOCK=512, num_warps=8)\n    return out\n\nlines=open('workload.jsonl').read().splitlines(); keys=['grad_output','hidden_states','fc1_weight','fc1_output','gelu_output','fc2_weight','residual_output','normalized','var','ln_weight','eps']\nfor idx in [10,0,11,1,4]:\n    axes=json.loads(lines[idx])['axes']; axes['hidden_size']=512; axes['intermediate_size']=2048\n    inp=reference.get_inputs(axes,torch.device('cuda:0'))\n    go=inp['grad_output']; norm=inp['normalized']; var=inp['var']; lnw=inp['ln_weight']; eps=inp['eps']\n    gn=go*lnw; std=torch.sqrt(var+eps); gm=gn.mean(dim=-1,keepdim=True); gnm=(gn*norm).mean(dim=-1,keepdim=True); ref=(1.0/std)*(gn-gm-norm*gnm)\n    out=triton_ln(go,norm,var,lnw,eps); torch.cuda.synchronize()\n    d=(out-ref).abs(); print('idx',idx,'N',axes['batch_size']*axes['seq_len'],'max',float(d.max().item()), 'mean',float(d.mean().item()), 'ratio1e6', float((d<=1e-6).float().mean().item()))\n    st=torch.cuda.Event(True); en=torch.cuda.Event(True)\n    for _ in range(10): triton_ln(go,norm,var,lnw,eps)\n    torch.cuda.synchronize(); st.record(); reps=100 if idx in [10,0,11] else 20\n    for _ in range(reps): triton_ln(go,norm,var,lnw,eps)\n    en.record(); torch.cuda.synchronize(); print('ms', st.elapsed_time(en)/reps)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
