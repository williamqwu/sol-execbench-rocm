{"type":"item.started","item":{"id":"item_37","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport enum\nif not hasattr(enum, 'StrEnum'):\n    class StrEnum(str, enum.Enum): pass\n    enum.StrEnum = StrEnum\nimport torch, time, reference\nM=128; K=2688; N=13952; KB=21; NB=109; B=128\ninputs=reference.get_inputs({'M':M,'hidden_size':K,'projection_size':N}, torch.device('cuda'))\ny_ref=reference.run(**inputs); torch.cuda.synchronize()\nx=inputs['hidden_states'].float(); w=inputs['weight'].float()\nsx=x.reshape(M,KB,B).abs().amax(2).clamp(min=1e-12)/448.0\nsw=w.reshape(NB,B,KB,B).abs().amax(3).amax(1).clamp(min=1e-12)/448.0\nqx=(x.reshape(M,KB,B)/sx[:,:,None]).clamp(-448,448).reshape(M,K).to(torch.float8_e4m3fn)\nqw=(w.reshape(NB,B,KB,B)/sw[:,None,:,None]).clamp(-448,448).reshape(N,K).to(torch.float8_e4m3fn)\n# precompute column scales per kb as contiguous (1,N)\nsb_all=[sw[:,i].repeat_interleave(B).reshape(1,N).contiguous() for i in range(KB)]\nfor out_dtype in [torch.float32, torch.bfloat16]:\n  try:\n    torch.cuda.synchronize(); t0=time.perf_counter()\n    acc=None\n    for i in range(KB):\n      a=qx[:, i*B:(i+1)*B]\n      b=qw[:, i*B:(i+1)*B].T\n      sa=sx[:, i].reshape(M,1).contiguous()\n      y=torch._scaled_mm(a, b, sa, sb_all[i], out_dtype=out_dtype, use_fast_accum=False)\n      if acc is None:\n        acc=y.float() if out_dtype is torch.bfloat16 else y\n      else:\n        acc.add_(y.float() if out_dtype is torch.bfloat16 else y)\n    out=acc.to(torch.bfloat16)\n    torch.cuda.synchronize(); dt=(time.perf_counter()-t0)*1000\n    diff=(out.float()-y_ref.float()).abs(); rel=diff/(y_ref.float().abs().clamp_min(1e-9))\n    print('out_dtype', out_dtype, 'dt',dt,'max_abs',diff.max().item(),'mean',diff.mean().item(),'match', ((diff<=0.405)|(rel<=0.0078125)).float().mean().item(), 'all_atol', (diff<=0.405).float().mean().item())\n  except Exception as e:\n    print('out_dtype', out_dtype, 'ERR', type(e).__name__, str(e)[:500])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
