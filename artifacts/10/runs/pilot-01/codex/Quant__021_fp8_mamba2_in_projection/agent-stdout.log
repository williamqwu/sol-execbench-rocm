{"type":"item.started","item":{"id":"item_60","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport torch, time, enum\nif not hasattr(enum, 'StrEnum'):\n    class StrEnum(str, enum.Enum): pass\n    enum.StrEnum=StrEnum\nimport reference, aiter\nE=448.0; B=128; K=2688; N=13952; KB=21; NB=109\n\ndef measure(M, reps=5):\n    inputs=reference.get_inputs({'M':M,'hidden_size':K,'projection_size':N}, torch.device('cuda'))\n    hidden_states=inputs['hidden_states']; weight=inputs['weight']\n    # warm full path\n    for _ in range(2):\n      x=hidden_states.to(torch.float32); w=weight.to(torch.float32)\n      sx=x.reshape(M,KB,B).abs().amax(2).clamp(min=1e-12)/E\n      sw=w.reshape(NB,B,KB,B).abs().amax(3).amax(1).clamp(min=1e-12)/E\n      qx=((x.reshape(M,KB,B)/sx[:,:,None]).clamp(-E,E).reshape(M,K).to(torch.float8_e4m3fn))\n      qw=((w.reshape(NB,B,KB,B)/sw[:,None,:,None]).clamp(-E,E).reshape(N,K).to(torch.float8_e4m3fn))\n      out=torch.empty((M,N),device='cuda',dtype=torch.bfloat16); aiter.gemm_a8w8_blockscale_cktile(qx,qw,sx,sw,out)\n    torch.cuda.synchronize()\n    labels=['x_float','w_float','sx','sw','qx','qw','gemm']\n    sums={l:0.0 for l in labels}\n    for _ in range(reps):\n      t=time.perf_counter(); x=hidden_states.to(torch.float32); torch.cuda.synchronize(); sums['x_float']+=(time.perf_counter()-t)*1000\n      t=time.perf_counter(); w=weight.to(torch.float32); torch.cuda.synchronize(); sums['w_float']+=(time.perf_counter()-t)*1000\n      t=time.perf_counter(); sx=x.reshape(M,KB,B).abs().amax(2).clamp(min=1e-12)/E; torch.cuda.synchronize(); sums['sx']+=(time.perf_counter()-t)*1000\n      t=time.perf_counter(); sw=w.reshape(NB,B,KB,B).abs().amax(3).amax(1).clamp(min=1e-12)/E; torch.cuda.synchronize(); sums['sw']+=(time.perf_counter()-t)*1000\n      t=time.perf_counter(); qx=((x.reshape(M,KB,B)/sx[:,:,None]).clamp(-E,E).reshape(M,K).to(torch.float8_e4m3fn)); torch.cuda.synchronize(); sums['qx']+=(time.perf_counter()-t)*1000\n      t=time.perf_counter(); qw=((w.reshape(NB,B,KB,B)/sw[:,None,:,None]).clamp(-E,E).reshape(N,K).to(torch.float8_e4m3fn)); torch.cuda.synchronize(); sums['qw']+=(time.perf_counter()-t)*1000\n      out=torch.empty((M,N),device='cuda',dtype=torch.bfloat16)\n      t=time.perf_counter(); aiter.gemm_a8w8_blockscale_cktile(qx,qw,sx,sw,out); torch.cuda.synchronize(); sums['gemm']+=(time.perf_counter()-t)*1000\n    print('M',M)\n    for l in labels: print(l, sums[l]/reps)\nmeasure(128,3)\nmeasure(8192,3)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
