{"type":"item.started","item":{"id":"item_83","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport enum, time\nif not hasattr(enum, 'StrEnum'):\n    class StrEnum(str, enum.Enum): pass\n    enum.StrEnum = StrEnum\nimport torch, reference, kernel\nfor M in [128, 384, 1536]:\n    inputs=reference.get_inputs({'M':M,'hidden_size':2688,'projection_size':13952}, torch.device('cuda'))\n    y_ref=reference.run(**inputs); torch.cuda.synchronize()\n    y=kernel.run(**inputs); torch.cuda.synchronize()\n    diff=(y.float()-y_ref.float()).abs(); rel=diff/(y_ref.float().abs().clamp_min(1e-9))\n    print('M',M,'max',diff.max().item(),'mean',diff.mean().item(),'match',((diff<=0.405)|(rel<=0.0078125)).float().mean().item(), 'all_atol',(diff<=0.405).float().mean().item())\n    times=[]\n    for _ in range(5):\n        torch.cuda.synchronize(); t0=time.perf_counter(); y=kernel.run(**inputs); torch.cuda.synchronize(); times.append((time.perf_counter()-t0)*1000)\n    print(' times', times, 'min', min(times))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
