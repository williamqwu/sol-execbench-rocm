{"type":"item.started","item":{"id":"item_27","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport torch, warnings\nM=128; K=2688; N=13952; KB=21; NB=109; B=128\nx=torch.randn(M,K,device='cuda',dtype=torch.bfloat16).float(); w=torch.randn(N,K,device='cuda',dtype=torch.bfloat16).float()\nsx=x.reshape(M,KB,B).abs().amax(2).clamp(min=1e-12)/448.0\nsw=w.reshape(NB,B,KB,B).abs().amax(3).amax(1).clamp(min=1e-12)/448.0\nqx=(x.reshape(M,KB,B)/sx[:,:,None]).clamp(-448,448).reshape(M,K).to(torch.float8_e4m3fn)\nqw=(w.reshape(NB,B,KB,B)/sw[:,None,:,None]).clamp(-448,448).reshape(N,K).to(torch.float8_e4m3fn)\nfor sa,sb in [(sx, sw), (sx.contiguous(), sw.contiguous()), (sx, sw.T.contiguous()), (sx.T.contiguous(), sw.contiguous())]:\n  try:\n    y=torch._scaled_mm(qx, qw.T.contiguous(), sa, sb, out_dtype=torch.bfloat16, use_fast_accum=True)\n    torch.cuda.synchronize(); print('ok', sa.shape, sb.shape)\n  except Exception as e:\n    print('ERR shapes', sa.shape, sb.shape)\n    print(str(e))\nPY 2>/tmp/scaled_err.log\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
