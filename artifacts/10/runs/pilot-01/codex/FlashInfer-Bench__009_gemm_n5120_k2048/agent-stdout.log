{"type":"item.completed","item":{"id":"item_45","type":"agent_message","text":"For tiny `M`, the issue is parallelism: one K-loop per output tile does not create enough CTAs unless the N tile is small. I’m autotiming a small grid of Triton tile sizes before deciding whether any custom dispatch is worth keeping."}}
{"type":"item.started","item":{"id":"item_46","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport torch, triton, kernel, itertools, math\n\ndef run_cfg(A,B,bm,bn,bk,gm,warps):\n    m=A.shape[0]\n    C=torch.empty((m,5120),device=A.device,dtype=A.dtype)\n    grid=(triton.cdiv(m,bm)*triton.cdiv(5120,bn),)\n    kernel._matmul_bnt_kernel[grid](A,B,C,m,5120,2048,BLOCK_M=bm,BLOCK_N=bn,BLOCK_K=bk,GROUP_M=gm,num_warps=warps,num_stages=3)\n    return C\n\ntorch.manual_seed(3)\nB=torch.randn((5120,2048),device='cuda',dtype=torch.float16)\nfor m in [1,2,4,8,16,17,32,34,64,93,172]:\n    A=torch.randn((m,2048),device='cuda',dtype=torch.float16)\n    base=triton.testing.do_bench(lambda: torch.nn.functional.linear(A,B), warmup=5, rep=20)\n    best=[]\n    bms=sorted(set([1,2,4,8,16,32,64]))\n    for bm in bms:\n        if bm < m and m <= 16: continue\n        if bm > 64: continue\n        for bn in [16,32,64,128,256]:\n            for bk in [32,64,128]:\n                for warps in [1,2,4,8]:\n                    if bn >= 128 and warps == 1: continue\n                    if bn <= 32 and warps == 8: continue\n                    try:\n                        C=run_cfg(A,B,bm,bn,bk,1,warps); torch.cuda.synchronize()\n                        # skip expensive check except first? no\n                        t=triton.testing.do_bench(lambda bm=bm,bn=bn,bk=bk,warps=warps: run_cfg(A,B,bm,bn,bk,1,warps), warmup=3, rep=10)\n                        best.append((t,bm,bn,bk,warps))\n                    except Exception as e:\n                        pass\n    best=sorted(best)[:8]\n    print('\\\\nM',m,'torch',base)\n    for row in best:\n        print(' ',row)\n    del A\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
