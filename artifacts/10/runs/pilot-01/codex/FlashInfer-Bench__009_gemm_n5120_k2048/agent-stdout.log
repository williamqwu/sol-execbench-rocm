{"type":"item.started","item":{"id":"item_42","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport torch, triton, aiter\nfor m in [1,4,16,64,172,492,952]:\n    A=torch.randn((m,2048),device='cuda',dtype=torch.float16)\n    B=torch.randn((5120,2048),device='cuda',dtype=torch.float16)\n    R=A@B.T\n    print('\\\\nM',m)\n    for dtype in [torch.float32, torch.bfloat16]:\n        try:\n            out=torch.empty((m,5120),device='cuda',dtype=dtype)\n            aiter.gemm_a16w16_asm(A,B,out)\n            C=out.to(torch.float16)\n            torch.cuda.synchronize()\n            print('dtype',dtype,'maxdiff',float((C-R).abs().max()),'ratio',float(torch.isclose(C,R,atol=0.026,rtol=0.0009765625).float().mean()))\n            t=triton.testing.do_bench(lambda: aiter.gemm_a16w16_asm(A,B,out), warmup=5, rep=20)\n            tc=triton.testing.do_bench(lambda: out.to(torch.float16), warmup=5, rep=20)\n            print('times',t,tc,t+tc)\n        except Exception as e:\n            print('dtype',dtype,'ERR',type(e).__name__,str(e).split('\\\\n')[0][:300])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
