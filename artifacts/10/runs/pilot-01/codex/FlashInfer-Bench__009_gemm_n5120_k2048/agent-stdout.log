{"type":"item.completed","item":{"id":"item_43","type":"agent_message","text":"The AITER assembly GEMM is a BF16-oriented kernel and reads FP16 inputs incorrectly, so it is out. I’m checking whether its hipBLAS wrapper can work with a contiguous transposed copy, but that extra copy is likely too expensive."}}
{"type":"item.started","item":{"id":"item_44","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport torch, triton, aiter\nfor m in [1,16,172,952]:\n    A=torch.randn((m,2048),device='cuda',dtype=torch.float16)\n    B=torch.randn((5120,2048),device='cuda',dtype=torch.float16)\n    BT=B.T.contiguous()\n    R=A@B.T\n    print('\\\\nM',m)\n    for idx in [0,1,2,3,4,5,10,50,100,200,500,1000,10000,20000,30000]:\n        try:\n            C=aiter.hipb_mm(A,BT,idx)\n            torch.cuda.synchronize()\n            print('idx',idx,'ok', C.shape, C.dtype, float((C-R).abs().max()))\n            t=triton.testing.do_bench(lambda: aiter.hipb_mm(A,BT,idx), warmup=5, rep=20)\n            print('time hipb',t)\n            break\n        except Exception as e:\n            # print first few errors only\n            if idx in [0,1,2,3,4,5]: print('idx',idx,'ERR',type(e).__name__,str(e).split('\\\\n')[0][:120])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
