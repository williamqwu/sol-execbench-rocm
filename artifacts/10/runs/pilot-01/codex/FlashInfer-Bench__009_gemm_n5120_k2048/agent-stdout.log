{"type":"item.started","item":{"id":"item_77","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport torch, triton\nimport triton.language as tl\nimport torch.nn.functional as F\n\n@triton.jit\ndef mm_kernel(A,B,C,M:tl.constexpr, BLOCK_M:tl.constexpr, BLOCK_N:tl.constexpr, BLOCK_K:tl.constexpr, GROUP_M:tl.constexpr):\n    pid=tl.program_id(0)\n    num_pid_m=tl.cdiv(M,BLOCK_M)\n    num_pid_n=tl.cdiv(5120,BLOCK_N)\n    group_size=GROUP_M*num_pid_n\n    group_id=pid//group_size\n    first_m=group_id*GROUP_M\n    group_m=tl.minimum(num_pid_m-first_m, GROUP_M)\n    pid_in=pid-group_id*group_size\n    pid_m=first_m+(pid_in % group_m)\n    pid_n=pid_in // group_m\n    offs_m=pid_m*BLOCK_M+tl.arange(0,BLOCK_M)\n    offs_n=pid_n*BLOCK_N+tl.arange(0,BLOCK_N)\n    offs_k=tl.arange(0,BLOCK_K)\n    a_ptrs=A+offs_m[:,None]*2048+offs_k[None,:]\n    b_ptrs=B+offs_k[:,None]+offs_n[None,:]*2048\n    acc=tl.zeros((BLOCK_M,BLOCK_N),tl.float32)\n    for k in range(0,2048,BLOCK_K):\n        a=tl.load(a_ptrs, mask=offs_m[:,None] < M, other=0.0)\n        b=tl.load(b_ptrs)\n        acc=tl.dot(a,b,acc)\n        a_ptrs += BLOCK_K\n        b_ptrs += BLOCK_K\n    c_ptrs=C+offs_m[:,None]*5120+offs_n[None,:]\n    tl.store(c_ptrs, acc, mask=(offs_m[:,None] < M) & (offs_n[None,:] < 5120))\n\ndef run(A,B,bm=16,bn=64,bk=256,gm=4):\n    C=torch.empty((A.shape[0],5120),device=A.device,dtype=A.dtype)\n    grid=(triton.cdiv(A.shape[0],bm)*triton.cdiv(5120,bn),)\n    mm_kernel[grid](A,B,C,A.shape[0],BLOCK_M=bm,BLOCK_N=bn,BLOCK_K=bk,GROUP_M=gm,num_warps=4,num_stages=2)\n    return C\n\nms=[6,1,34,17,952,16,172,64,63,2,93,4,289,5,25,8,492,32,128]\ntorch.manual_seed(8)\nB=torch.randn((5120,2048),device='cuda',dtype=torch.float16)\nprint('M base tri diff ratio')\nfor m in ms:\n    A=torch.randn((m,2048),device='cuda',dtype=torch.float16)\n    R=F.linear(A,B)\n    C=run(A,B)\n    torch.cuda.synchronize()\n    diff=(C-R).abs()\n    ratio=((diff <= 0.026 + 0.0009765625*R.abs()).float().mean()).item()\n    t0=triton.testing.do_bench(lambda: F.linear(A,B), warmup=5, rep=20)\n    t1=triton.testing.do_bench(lambda: run(A,B), warmup=5, rep=20)\n    print(m, f'{t0:.4f}', f'{t1:.4f}', float(diff.max()), ratio)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
