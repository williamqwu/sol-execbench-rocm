{"type":"item.started","item":{"id":"item_28","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch, json\nimport reference\nfrom triton_probe import triton_run\n\ndef direct(a,v):\n    b=a.shape[0]; s=a.shape[2]\n    o=torch.empty((b,s,5120),device=a.device,dtype=a.dtype)\n    ov=torch.as_strided(o,(b,40,s,128),(s*5120,128,5120,1))\n    torch.matmul(a,v,out=ov)\n    return o\n\ndef chosen(a,v):\n    b=a.shape[0]; s=a.shape[2]\n    if b == 1 and s >= 800:\n        return direct(a,v)\n    if s <= 512:\n        return triton_run(a,v,128,128,32,4,3)\n    if s < 800:\n        return triton_run(a,v,64,128,32,4,3)\n    return triton_run(a,v,64,128,64,4,3)\n\nfor mode in ['uniform','softmax_randn','scaled_uniform']:\n    print('\\\\nmode', mode)\n    for i,line in enumerate(open('workload.jsonl')):\n        w=json.loads(line); b=w['axes']['batch_size']; s=w['axes']['seq_len']; tol=w['tolerance']\n        torch.manual_seed(3000+i)\n        if mode=='uniform':\n            a=torch.rand((b,40,s,s),device='cuda:0',dtype=torch.bfloat16)\n            v=torch.rand((b,40,s,128),device='cuda:0',dtype=torch.bfloat16)\n        elif mode=='softmax_randn':\n            a=torch.softmax(torch.randn((b,40,s,s),device='cuda:0',dtype=torch.float32), dim=-1).to(torch.bfloat16)\n            v=torch.randn((b,40,s,128),device='cuda:0',dtype=torch.bfloat16)\n        else:\n            a=(torch.rand((b,40,s,s),device='cuda:0',dtype=torch.float32)/s).to(torch.bfloat16)\n            v=torch.rand((b,40,s,128),device='cuda:0',dtype=torch.bfloat16)\n        r=reference.run(a,v); y=chosen(a,v); torch.cuda.synchronize()\n        d=(y.float()-r.float()).abs(); allowed=tol['max_atol']+tol['max_rtol']*r.float().abs()\n        ratio=(d<=allowed).float().mean().item(); max_abs=d.max().item(); max_rel=(d/(r.float().abs()+1e-12)).max().item()\n        status='OK' if ratio>=tol['required_matched_ratio'] else 'BAD'\n        print(f'{i:2d} {(b,s)} {status} ratio {ratio:.5f} max_abs {