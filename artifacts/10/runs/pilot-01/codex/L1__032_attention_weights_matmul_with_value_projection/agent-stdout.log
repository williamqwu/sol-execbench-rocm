{"type":"item.started","item":{"id":"item_48","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch, triton\nimport kernel, reference\n\ndef run(a,v,bm,bk,nw,wp=0):\n    b=a.shape[0]; s=a.shape[2]\n    o=torch.empty((b,s,5120),device=a.device,dtype=a.dtype)\n    grid=(triton.cdiv(s,bm), b*40)\n    kwargs=dict(num_warps=nw,num_stages=3)\n    if wp: kwargs['waves_per_eu']=wp\n    kernel._attn_value_kernel[grid](a,v,o,s,bm,bk,**kwargs)\n    return o\n\ndef bench(fn,a,v,iters=50):\n    for _ in range(12): fn(a,v)\n    torch.cuda.synchronize(); st=torch.cuda.Event(enable_timing=True); en=torch.cuda.Event(enable_timing=True); st.record()\n    for _ in range(iters): fn(a,v)\n    en.record(); torch.cuda.synchronize(); return st.elapsed_time(en)/iters\n\nb,s=4,691\ntorch.manual_seed(6914)\na=torch.rand((b,40,s,s),device='cuda:0',dtype=torch.bfloat16)\nv=torch.rand((b,40,s,128),device='cuda:0',dtype=torch.bfloat16)\nref=reference.run(a,v); torch.cuda.synchronize()\nconfigs=[]\nfor bm in [16,32,48,64,96,128]:\n  if bm & (bm-1):\n    continue\n  for bk in [16,32,64,128]:\n    for nw in [4,8]:\n      for wp in [0,1,2,3]:\n        configs.append((bm,bk,nw,wp))\nfor cfg in configs:\n    bm,bk,nw,wp=cfg\n    try:\n        fn=lambda x,y,c=cfg: run(x,y,*c)\n        y=fn(a,v); torch.cuda.synchronize()\n        diff=(y.float()-ref.float()).abs().max().item()\n        ms=bench(fn,a,v,40)\n        print(cfg, f'{ms:.5f}', diff)\n    except Exception as e:\n        print(cfg, 'ERR', type(e).__name__, e)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
