{"type":"item.started","item":{"id":"item_32","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport json, torch\nimport kernel, reference\n\ndef bench(fn, a, v, iters):\n    for _ in range(8): fn(a, v)\n    torch.cuda.synchronize()\n    st=torch.cuda.Event(enable_timing=True); en=torch.cuda.Event(enable_timing=True)\n    st.record()\n    for _ in range(iters): fn(a, v)\n    en.record(); torch.cuda.synchronize()\n    return st.elapsed_time(en)/iters\n\nall_ok=True\nfor i,line in enumerate(open('workload.jsonl')):\n    w=json.loads(line); b=w['axes']['batch_size']; s=w['axes']['seq_len']; tol=w['tolerance']\n    torch.manual_seed(400+i)\n    a=torch.rand((b,40,s,s),device='cuda:0',dtype=torch.bfloat16)\n    v=torch.rand((b,40,s,128),device='cuda:0',dtype=torch.bfloat16)\n    r=reference.run(a,v); y=kernel.run(a,v); torch.cuda.synchronize()\n    d=(y.float()-r.float()).abs(); allowed=tol['max_atol']+tol['max_rtol']*r.float().abs()\n    ratio=(d<=allowed).float().mean().item(); ok=ratio>=tol['required_matched_ratio']\n    iters=100 if s<=256 else 40 if s<=700 else 20 if s<=1100 else 10\n    kr=bench(kernel.run,a,v,iters); rr=bench(reference.run,a,v,iters)\n    all_ok = all_ok and ok and y.is_contiguous()\n    print(f'{i:2d} {(b,s)\"'!s:10s} ok {ok} ratio {ratio:.5f} max_abs {d.max().item():.5g} kernel {kr:.4f} ref {rr:.4f} speed {rr/kr:.2f}'\"')\nprint('ALL_OK', all_ok)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
