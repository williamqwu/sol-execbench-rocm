{"type":"item.started","item":{"id":"item_36","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch, triton\nfrom triton_probe import attn_v_kernel, bench\nimport reference\n\ndef run_meta(a,v,bm,bk,nw,**meta):\n    b=a.shape[0]; s=a.shape[2]\n    o=torch.empty((b,s,5120),device=a.device,dtype=a.dtype)\n    grid=(triton.cdiv(s,bm), b*40)\n    attn_v_kernel[grid](a,v,o,s,bm,128,bk,num_warps=nw,num_stages=3,**meta)\n    return o\n\nb,s=32,128\ntorch.manual_seed(1)\na=torch.rand((b,40,s,s),device='cuda:0',dtype=torch.bfloat16)\nv=torch.rand((b,40,s,128),device='cuda:0',dtype=torch.bfloat16)\nref=reference.run(a,v); torch.cuda.synchronize()\nfor meta in [{}, {'waves_per_eu':1}, {'waves_per_eu':2}, {'waves_per_eu':3}, {'matrix_instr_nonkdim':16}, {'waves_per_eu':2,'matrix_instr_nonkdim':16}, {'kpack':2}, {'waves_per_eu':2,'kpack':2}]:\n    try:\n        fn=lambda x,y,m=meta: run_meta(x,y,128,32,4,**m)\n        y=fn(a,v); torch.cuda.synchronize()\n        print(meta, 'diff', (y.float()-ref.float()).abs().max().item(), 'ms', bench(fn,a,v,100))\n    except Exception as e:\n        print(meta, 'ERR', type(e).__name__, e)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
