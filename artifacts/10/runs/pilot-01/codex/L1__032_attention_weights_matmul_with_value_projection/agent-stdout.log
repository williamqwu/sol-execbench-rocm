{"type":"item.completed","item":{"id":"item_25","type":"agent_message","text":"The first Triton probe is promising: direct fused output beats the reference for many multi-batch cases, but the best tile shape varies. I’m expanding the timing sweep across all 16 workloads and checking tolerance-style error ratios, not just max absolute error."}}
{"type":"item.started","item":{"id":"item_26","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport json, torch\nimport reference\nfrom triton_probe import triton_run, bench\n\nconfigs=[\n (16,128,32,4,3),(16,128,64,4,3),\n (32,128,32,4,3),(32,128,64,4,3),(32,64,64,4,3),\n (64,128,32,4,3),(64,128,64,4,3),(64,64,32,4,3),(64,64,64,4,3),\n (128,128,32,4,3),(128,128,64,4,3),(128,64,32,4,3),\n (64,128,32,8,3),(64,128,64,8,3),(128,128,32,8,3),(128,128,64,8,3),\n]\n\ndef direct(a,v):\n    b=a.shape[0]; s=a.shape[2]\n    o=torch.empty((b,s,5120),device=a.device,dtype=a.dtype)\n    ov=torch.as_strided(o,(b,40,s,128),(s*5120,128,5120,1))\n    torch.matmul(a,v,out=ov)\n    return o\n\nfor i,line in enumerate(open('workload.jsonl')):\n    w=json.loads(line); b=w['axes']['batch_size']; s=w['axes']['seq_len']; tol=w['tolerance']\n    torch.manual_seed(200+i)\n    a=torch.rand((b,40,s,s),device='cuda:0',dtype=torch.bfloat16)\n    v=torch.rand((b,40,s,128),device='cuda:0',dtype=torch.bfloat16)\n    ref=reference.run(a,v); torch.cuda.synchronize()\n    iters=100 if s<=256 else 40 if s<=700 else 20 if s<=1100 else 10\n    ref_ms=bench(reference.run,a,v,iters)\n    dir_ms=bench(direct,a,v,iters)\n    best=(ref_ms, 'ref', 0.0, 1.0, 0.0)\n    # direct is exact in previous checks\n    yd=direct(a,v); torch.cuda.synchronize()\n    d=(yd.float()-ref.float()).abs(); rel=d/(ref.float().abs()+1e-12)\n    ratio=((d <= (tol['max_atol'] + tol['max_rtol']*ref.float().abs()))).float().mean().item()\n    best_direct=(dir_ms,'direct',d.max().item(),ratio,rel.max().item())\n    if dir_ms < best[0]: best=best_direct\n    results=[]\n    for cfg in configs:\n        try:\n            y=triton_run(a,v,*cfg); torch.cuda.synchronize()\n            df=(y.float()-ref.float()).abs(); rf=df/(ref.float().abs()+1e-12)\n            ratio=((df <= (tol['max_atol'] + tol['max_rtol']*ref.float().abs()))).float().mean().item()\n            max_abs=df.max().item(); max_rel=rf.max().item()\n            ms=bench(lambda x,y,c=cfg: triton_run(x,y,*c),a,v,iters)\n            results.append((ms,cfg,max_abs,ratio,max_rel))\n            if ratio >= tol['required_matched_ratio'] and ms < best[0]:\n                best=(ms,cfg,max_abs,ratio,max_rel)\n        except Exception as e:\n            results.append((999,cfg,str(e),0,0))\n    results.sort(key=lambda x:x[0])\n    print(f\\\"\\\\n#{i} shape {(b,s)} tol ratio {tol['required_matched_ratio']} ref {ref_ms:.4f} direct {dir_ms:.4f} best {best}\\\")\n    print(' top:', '; '.join([f'{r[1]} {r[0]:.4f} diff {r[2]} ratio {r[3]:.4f}' for r in results[:5]]))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
