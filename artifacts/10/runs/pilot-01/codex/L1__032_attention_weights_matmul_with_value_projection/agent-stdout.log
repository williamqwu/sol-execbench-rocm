{"type":"item.started","item":{"id":"item_15","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport json, torch, statistics\nimport kernel, reference\n\ndef bench(fn, a, v, iters=50, warmup=10):\n    for _ in range(warmup):\n        y = fn(a, v)\n    torch.cuda.synchronize()\n    start = torch.cuda.Event(enable_timing=True)\n    end = torch.cuda.Event(enable_timing=True)\n    start.record()\n    for _ in range(iters):\n        y = fn(a, v)\n    end.record()\n    torch.cuda.synchronize()\n    return start.elapsed_time(end) / iters\n\nfor i, line in enumerate(open('workload.jsonl')):\n    w=json.loads(line); b=w['axes']['batch_size']; s=w['axes']['seq_len']\n    torch.manual_seed(10+i)\n    a=torch.rand((b,40,s,s),device='cuda:0',dtype=torch.bfloat16)\n    v=torch.rand((b,40,s,128),device='cuda:0',dtype=torch.bfloat16)\n    iters=100 if s<=256 else 50 if s<=700 else 20\n    tr=bench(reference.run,a,v,iters=iters)\n    tk=bench(kernel.run,a,v,iters=iters)\n    print(f'{i:2d} {(b,s)\"'!s:10s} ref {tr:.4f} ms  opt {tk:.4f} ms  speed {tr/tk:.3f}x'\"')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
