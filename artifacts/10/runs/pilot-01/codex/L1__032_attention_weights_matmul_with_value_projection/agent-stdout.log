{"type":"item.started","item":{"id":"item_38","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch, triton\nimport kernel, reference\n\ndef run_meta(a,v,bm,bk,nw,**meta):\n    b=a.shape[0]; s=a.shape[2]\n    o=torch.empty((b,s,5120),device=a.device,dtype=a.dtype)\n    grid=(triton.cdiv(s,bm), b*40)\n    kernel._attn_value_kernel[grid](a,v,o,s,bm,bk,num_warps=nw,num_stages=3,**meta)\n    return o\n\ndef bench(fn,a,v,iters=100):\n    for _ in range(8): fn(a,v)\n    torch.cuda.synchronize()\n    st=torch.cuda.Event(enable_timing=True); en=torch.cuda.Event(enable_timing=True)\n    st.record()\n    for _ in range(iters): fn(a,v)\n    en.record(); torch.cuda.synchronize(); return st.elapsed_time(en)/iters\n\nfor b,s,bm,bk,nw in [(32,128,128,32,4),(16,256,128,32,4),(4,512,128,32,8),(2,1024,64,64,8)]:\n    torch.manual_seed(2+b+s)\n    a=torch.rand((b,40,s,s),device='cuda:0',dtype=torch.bfloat16)\n    v=torch.rand((b,40,s,128),device='cuda:0',dtype=torch.bfloat16)\n    ref=reference.run(a,v); torch.cuda.synchronize()\n    print('\\\\nshape', (b,s), 'base', bench(lambda x,y: run_meta(x,y,bm,bk,nw),a,v,50 if s>=512 else 100))\n    for meta in [{'waves_per_eu':1},{'waves_per_eu':2},{'waves_per_eu':3},{'matrix_instr_nonkdim':16},{'waves_per_eu':2,'matrix_instr_nonkdim':16},{'kpack':2},{'waves_per_eu':2,'kpack':2}]:\n        try:\n            fn=lambda x,y,m=meta: run_meta(x,y,bm,bk,nw,**m)\n            out=fn(a,v); torch.cuda.synchronize()\n            print(meta, 'diff', (out.float()-ref.float()).abs().max().item(), 'ms', bench(fn,a,v,50 if s>=512 else 100))\n        except Exception as e:\n            print(meta, 'ERR', type(e).__name__, e)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
