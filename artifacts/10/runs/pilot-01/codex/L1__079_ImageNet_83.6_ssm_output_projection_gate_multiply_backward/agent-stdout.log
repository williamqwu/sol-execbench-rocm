{"type":"item.started","item":{"id":"item_29","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport torch, triton\nimport kernel, reference\n\ns_weight = torch.cuda.Stream()\ns_gated = torch.cuda.Stream()\n\ndef run_streamed(grad_output, ssm_output, gate, weight, bias, gate_activated, gated_output, use_silu_gate):\n    b,s,h = grad_output.shape\n    e = ssm_output.shape[2]\n    m = b*s\n    go = grad_output.reshape(-1,h)\n    gated = gated_output.reshape(-1,e)\n    gw = torch.empty_like(weight)\n    gb = torch.empty_like(bias)\n    ggo = torch.empty_like(ssm_output)\n    gssm = torch.empty_like(ssm_output)\n    gg = torch.empty_like(ssm_output)\n    with torch.cuda.stream(s_weight):\n        torch.mm(go.t(), gated, out=gw)\n        torch.sum(go, dim=0, out=gb)\n    with torch.cuda.stream(s_gated):\n        torch.mm(go, weight, out=ggo.reshape(-1,e))\n        kernel._gate_backward_kernel[(triton.cdiv(m*e, 1024),)](ggo,ssm_output,gate,gate_activated,gssm,gg,m*e,use_silu_gate,BLOCK_SIZE=1024,num_warps=4)\n    cur = torch.cuda.current_stream()\n    cur.wait_stream(s_weight)\n    cur.wait_stream(s_gated)\n    return gssm, gg, gw, gb\n\ndef make_inputs(b,s,use):\n    torch.manual_seed(13); device='cuda'\n    return (torch.randn((b,s,768),device=device,dtype=torch.bfloat16),\n            torch.randn((b,s,1536),device=device,dtype=torch.bfloat16),\n            torch.randn((b,s,1536),device=device,dtype=torch.bfloat16),\n            torch.randn((768,1536),device=device,dtype=torch.bfloat16),\n            torch.randn((768,),device=device,dtype=torch.bfloat16),\n            torch.randn((b,s,1536),device=device,dtype=torch.bfloat16),\n            torch.randn((b,s,1536),device=device,dtype=torch.bfloat16),\n            use)\n\ndef bench(fn,args,iters=30):\n    for _ in range(5): fn(*args)\n    torch.cuda.synchronize()\n    st=torch.cuda.Event(enable_timing=True); en=torch.cuda.Event(enable_timing=True)\n    st.record()\n    for _ in range(iters): fn(*args)\n    en.record(); torch.cuda.synchronize()\n    return st.elapsed_time(en)/iters\n\nfor shape in [(1,128,True),(4,512,True),(8,1489,False),(64,1163,True),(32,1087,True)]:\n    args=make_inputs(*shape)\n    ref=reference.run(*args); out=run_streamed(*args); torch.cuda.synchronize()\n    ok=[(a.float()-c.float()).abs().max().item() for a,c in zip(ref,out)]\n    print(shape, 'seq', bench(kernel.run,args,10), 'stream', bench(run_streamed,args,10), 'diff', ok)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
