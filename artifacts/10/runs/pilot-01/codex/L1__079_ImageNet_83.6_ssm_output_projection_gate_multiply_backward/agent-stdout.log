{"type":"item.started","item":{"id":"item_25","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport torch\nimport triton\nimport kernel\n\ndef tail_once(tmp,ssm,gate,gate_act,use_silu,block):\n    out1=torch.empty_like(ssm); out2=torch.empty_like(ssm)\n    n=ssm.numel()\n    kernel._gate_backward_kernel[(triton.cdiv(n, block),)](tmp,ssm,gate,gate_act,out1,out2,n,use_silu,BLOCK_SIZE=block,num_warps=4)\n    return out1,out2\n\ndef bench_tail(b,s,use_silu,block,iters=50):\n    device='cuda'; torch.manual_seed(1)\n    tmp=torch.randn((b,s,1536),device=device,dtype=torch.bfloat16)\n    ssm=torch.randn((b,s,1536),device=device,dtype=torch.bfloat16)\n    gate=torch.randn((b,s,1536),device=device,dtype=torch.bfloat16)\n    gate_act=torch.randn((b,s,1536),device=device,dtype=torch.bfloat16)\n    for _ in range(5): tail_once(tmp,ssm,gate,gate_act,use_silu,block)\n    torch.cuda.synchronize()\n    start=torch.cuda.Event(enable_timing=True); end=torch.cuda.Event(enable_timing=True)\n    start.record()\n    for _ in range(iters): tail_once(tmp,ssm,gate,gate_act,use_silu,block)\n    end.record(); torch.cuda.synchronize()\n    return start.elapsed_time(end)/iters\n\nfor shape in [(1,128,True),(4,512,True),(64,1163,True),(8,1489,False),(32,541,False)]:\n    print('shape', shape)\n    for block in [256,512,1024,2048,4096]:\n        ms=bench_tail(*shape,block,iters=30 if shape[0]*shape[1]<10000 else 10)\n        print(block, ms)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
