{"type":"item.started","item":{"id":"item_27","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport torch\n\n@torch.no_grad()\ndef eager_run(grad_output, ssm_output, gate, weight, bias, gate_activated, gated_output, use_silu_gate: bool):\n    b,s,h = grad_output.shape\n    e = ssm_output.shape[2]\n    go = grad_output.reshape(-1,h)\n    gated = gated_output.reshape(-1,e)\n    gw = go.t() @ gated\n    gb = go.sum(dim=0)\n    ggo2 = go @ weight\n    ggo = ggo2.view(b,s,e)\n    gssm = ggo * gate_activated\n    gga = ggo * ssm_output\n    if use_silu_gate:\n        sg = torch.sigmoid(gate)\n        silu = sg * (1.0 + gate * (1.0 - sg))\n        gg = gga * silu\n    else:\n        gg = gga\n    return gssm, gg, gw, gb\n\ncompiled = torch.compile(eager_run, fullgraph=True, dynamic=False, mode='reduce-overhead')\n\ndef make_inputs(b,s,use):\n    torch.manual_seed(7); device='cuda'\n    return (torch.randn((b,s,768),device=device,dtype=torch.bfloat16),\n            torch.randn((b,s,1536),device=device,dtype=torch.bfloat16),\n            torch.randn((b,s,1536),device=device,dtype=torch.bfloat16),\n            torch.randn((768,1536),device=device,dtype=torch.bfloat16),\n            torch.randn((768,),device=device,dtype=torch.bfloat16),\n            torch.randn((b,s,1536),device=device,dtype=torch.bfloat16),\n            torch.randn((b,s,1536),device=device,dtype=torch.bfloat16),\n            use)\n\ndef bench(fn,args,iters=20):\n    for _ in range(3): fn(*args)\n    torch.cuda.synchronize()\n    st=torch.cuda.Event(enable_timing=True); en=torch.cuda.Event(enable_timing=True)\n    st.record()\n    for _ in range(iters): fn(*args)\n    en.record(); torch.cuda.synchronize()\n    return st.elapsed_time(en)/iters\n\nfor shape in [(1,128,True),(4,512,True),(8,1489,False),(64,1163,True)]:\n    args=make_inputs(*shape)\n    print('compiling/running', shape, flush=True)\n    compiled(*args); torch.cuda.synchronize()\n    print(shape, 'eager', bench(eager_run,args,10), 'compiled', bench(compiled,args,10))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
