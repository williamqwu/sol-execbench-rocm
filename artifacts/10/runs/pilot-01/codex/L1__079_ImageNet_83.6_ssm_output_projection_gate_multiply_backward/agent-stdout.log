{"type":"item.started","item":{"id":"item_17","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport json\nimport torch\nimport reference\nimport kernel\n\nshapes = [(1,128,True),(4,1973,False),(4,512,True)]\nfor b,s,use_silu in shapes:\n    torch.manual_seed(123)\n    device='cuda'\n    go=torch.randn((b,s,768),device=device,dtype=torch.bfloat16)\n    ssm=torch.randn((b,s,1536),device=device,dtype=torch.bfloat16)\n    gate=torch.randn((b,s,1536),device=device,dtype=torch.bfloat16)\n    weight=torch.randn((768,1536),device=device,dtype=torch.bfloat16)\n    bias=torch.randn((768,),device=device,dtype=torch.bfloat16)\n    gate_act=torch.randn((b,s,1536),device=device,dtype=torch.bfloat16)\n    gated=torch.randn((b,s,1536),device=device,dtype=torch.bfloat16)\n    ref=reference.run(go,ssm,gate,weight,bias,gate_act,gated,use_silu)\n    out=kernel.run(go,ssm,gate,weight,bias,gate_act,gated,use_silu)\n    torch.cuda.synchronize()\n    print('shape', b,s,use_silu)\n    for i,(a,c) in enumerate(zip(ref,out)):\n        diff=(a.float()-c.float()).abs()\n        print(i, diff.max().item(), torch.isclose(a,c,atol=0.16,rtol=0.0078125).float().mean().item())\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
