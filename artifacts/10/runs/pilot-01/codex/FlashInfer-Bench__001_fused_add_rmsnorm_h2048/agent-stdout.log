{"type":"item.started","item":{"id":"item_14","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport torch, triton, triton.language as tl\n\n@triton.jit\ndef k(h, r, w, o, BLOCK:tl.constexpr):\n    row=tl.program_id(0)\n    offs=tl.arange(0, BLOCK)\n    idx=row*BLOCK+offs\n    hv=tl.load(h+idx).to(tl.float32)\n    rv=tl.load(r+idx).to(tl.float32)\n    wv=tl.load(w+offs).to(tl.float32)\n    x=hv+rv\n    ss=tl.sum(x*x, axis=0)\n    inv=tl.rsqrt(ss / BLOCK + 1.0e-6)\n    y=x*inv*wv\n    tl.store(o+idx, y)\n\ndef run(B, warps, stages=3):\n    h=torch.randn((B,2048), device='cuda', dtype=torch.bfloat16)\n    r=torch.randn((B,2048), device='cuda', dtype=torch.bfloat16)\n    w=torch.randn((2048,), device='cuda', dtype=torch.bfloat16)\n    o=torch.empty_like(h)\n    def f():\n        k[(B,)](h,r,w,o,BLOCK=2048,num_warps=warps,num_stages=stages)\n    ms=triton.testing.do_bench(f, warmup=20, rep=100)\n    return ms\n\nfor B in [1,6,34,64,79,12383,16254]:\n    vals=[]\n    for warps in [1,2,4,8,16]:\n        try:\n            ms=run(B,warps)\n            vals.append((warps, ms))\n        except Exception as e:\n            vals.append((warps, str(e).split('\\\\n')[0]))\n    print('B',B,vals)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
