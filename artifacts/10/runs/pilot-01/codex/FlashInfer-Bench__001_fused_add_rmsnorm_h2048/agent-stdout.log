{"type":"item.started","item":{"id":"item_23","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport torch, triton, aiter\nimport kernel\n\n@torch.no_grad()\ndef ref(h,r,w):\n    x=h.float()+r.float()\n    inv=torch.rsqrt(x.pow(2).mean(dim=-1, keepdim=True)+1e-6)\n    return (x*inv*w.float()).to(h.dtype)\n\nfor B in [1,6,64,12383,16254]:\n    h=torch.randn((B,2048),device='cuda',dtype=torch.bfloat16)\n    r=torch.randn((B,2048),device='cuda',dtype=torch.bfloat16)\n    w=torch.randn((2048,),device='cuda',dtype=torch.bfloat16)\n    o=torch.empty_like(h)\n    rout=torch.empty_like(h)\n    try:\n        aiter.rmsnorm2d_fwd_with_add_opus(o,h,r,rout,w,1e-6,0,False)\n        torch.cuda.synchronize()\n        y=ref(h,r,w)\n        max_abs=(o-y).abs().max().item()\n        matched=(((o-y).abs() <= 0.008) | (((o-y).abs()/torch.maximum(y.abs(), torch.tensor(1e-12, device='cuda'))) <= 0.0078125)).float().mean().item()\n        def f_aiter():\n            aiter.rmsnorm2d_fwd_with_add_opus(o,h,r,rout,w,1e-6,0,False)\n        ms_a=triton.testing.do_bench(f_aiter,warmup=20,rep=100)\n        ot=torch.empty_like(h)\n        def f_tri():\n            kernel._rmsnorm_kernel[(B,)](h,r,w,ot,B,BLOCK=2048,num_warps=8,num_stages=3)\n        ms_t=triton.testing.do_bench(f_tri,warmup=20,rep=100)\n        print('B',B,'aiter',round(float(ms_a),4),'triton',round(float(ms_t),4),'max_abs',max_abs,'matched',matched)\n    except Exception as e:\n        print('B',B,'error',type(e).__name__,str(e).split('\\\\n')[0])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
