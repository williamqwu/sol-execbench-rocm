{"type":"item.started","item":{"id":"item_39","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport json, torch\nimport reference, kernel\n\ndef stats(y, ref, atol, rtol):\n    diff=(y.float()-ref.float()).abs()\n    rel=diff/(ref.float().abs()+1e-12)\n    ok=(diff <= atol) | (rel <= rtol)\n    return diff.max().item(), rel.max().item(), ok.float().mean().item()\n\nfor i,line in enumerate(open('workload.jsonl')):\n    wl=json.loads(line)\n    m=wl['axes']['num_tokens']\n    tol=wl['tolerance']\n    inputs=reference.get_inputs({'num_tokens':m}, torch.device('cuda:0'))\n    torch.cuda.synchronize()\n    ref=reference.run(**inputs)\n    torch.cuda.synchronize()\n    y=kernel.run(**inputs)\n    torch.cuda.synchronize()\n    ma,mr,match=stats(y,ref,tol['max_atol'],tol['max_rtol'])\n    print(i,m,'max_abs',ma,'max_rel',mr,'match',match)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
