{"type":"item.started","item":{"id":"item_43","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport torch, triton\nfrom probe_triton import gemm\n\ndef make(M,N,K):\n    dev='cuda:0'\n    x=torch.randn(M,K,device=dev,dtype=torch.bfloat16)\n    w=torch.randn(N,K,device=dev,dtype=torch.bfloat16)\n    sx=torch.clamp(x.float().reshape(M,K//128,128).abs().amax(2)/448,min=1e-12)\n    wt=w.float().T\n    sw=torch.clamp(wt.reshape(K//128,128,N//128,128).abs().amax(3).amax(1)/448,min=1e-12).T.contiguous()\n    qx=torch.clamp(x.float().reshape(M,K//128,128)/sx.unsqueeze(2),-448,448).reshape(M,K).contiguous().to(torch.float8_e4m3fn)\n    qw=torch.clamp(w.float().T.reshape(K//128,128,N//128,128)/sw.T.unsqueeze(1).unsqueeze(3),-448,448).reshape(K,N).T.contiguous().to(torch.float8_e4m3fn)\n    c=torch.empty((M,N),device=dev,dtype=torch.bfloat16)\n    return qx,qw,sx,sw,c\n\ndef bench_shape(M,N,K):\n    print('SHAPE',M,N,K)\n    qx,qw,sx,sw,c=make(M,N,K)\n    for BM,BN,warps in [(16,16,4),(16,32,4),(32,16,4),(32,32,4),(16,64,4),(64,16,4),(32,64,4),(64,32,4),(64,64,4),(32,128,4),(128,32,4),(64,128,4),(128,64,4)]:\n        try:\n            grid=(triton.cdiv(M,BM),triton.cdiv(N,BN))\n            fn=lambda: gemm[grid](qx,qw,sx,sw,c,M,N,K,BM,BN,num_warps=warps)\n            fn(); torch.cuda.synchronize()\n            ms=triton.testing.do_bench(fn, warmup=5, rep=20)\n            print(BM,BN,warps,ms)\n        except Exception as e:\n            print(BM,BN,warps,'ERR',type(e).__name__,str(e)[:160])\n\nbench_shape(4096,2048,7168)\nbench_shape(4096,7168,2048)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
