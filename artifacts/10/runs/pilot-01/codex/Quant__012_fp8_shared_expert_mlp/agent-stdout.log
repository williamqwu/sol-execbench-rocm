{"type":"item.completed","item":{"id":"item_27","type":"agent_message","text":"A likely practical optimization is to keep the same FP8 quantization but feed BF16 dequantized operands to matrix-core GEMMs instead of explicit FP32 GEMMs. I’m testing the numerical drift first because the reference rounds only after each linear, so this may or may not fit the tolerance."}}
{"type":"item.started","item":{"id":"item_28","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport torch\nimport torch.nn.functional as F\nimport reference\nE4M3_MAX=448.0\n\ndef act_scales(x_f32):\n    m,k=x_f32.shape\n    return torch.clamp(x_f32.reshape(m,k//128,128).abs().amax(dim=2)/E4M3_MAX,min=1e-12)\n\ndef weight_scales(weight_f32):\n    wt=weight_f32.T\n    k,n=wt.shape\n    s=torch.clamp(wt.reshape(k//128,128,n//128,128).abs().amax(dim=3).amax(dim=1)/E4M3_MAX,min=1e-12)\n    return s.T.contiguous()\n\ndef qact(x_f32,s):\n    m,k=x_f32.shape\n    return torch.clamp((x_f32.reshape(m,k//128,128)/s.unsqueeze(2)), -E4M3_MAX, E4M3_MAX).reshape(m,k).to(torch.float8_e4m3fn)\n\ndef qwgt(w_f32,snk):\n    n,k=w_f32.shape\n    skn=snk.T\n    return torch.clamp(w_f32.T.reshape(k//128,128,n//128,128)/skn.unsqueeze(1).unsqueeze(3), -E4M3_MAX, E4M3_MAX).reshape(k,n).T.to(torch.float8_e4m3fn)\n\ndef deqa_bf16(q,s):\n    m,k=q.shape\n    return (q.to(torch.float32).reshape(m,k//128,128)*s.unsqueeze(2)).reshape(m,k).to(torch.bfloat16)\n\ndef deqw_bf16(q,s):\n    n,k=q.shape\n    return (q.to(torch.float32).reshape(n//128,128,k//128,128)*s.unsqueeze(1).unsqueeze(3)).reshape(n,k).to(torch.bfloat16)\n\ndef lin(x,w):\n    xf=x.to(torch.float32); wf=w.to(torch.float32)\n    sx=act_scales(xf); sw=weight_scales(wf)\n    qx=qact(xf,sx); qw=qwgt(wf,sw)\n    a=deqa_bf16(qx,sx); b=deqw_bf16(qw,sw)\n    return a @ b.T\n\ndef run_fast(h,g,u,d):\n    gate=lin(h,g)\n    up=lin(h,u)\n    inter=F.silu(gate)*up\n    return lin(inter,d)\n\ndef stats(y, ref, atol, rtol):\n    diff=(y.float()-ref.float()).abs()\n    rel=diff/(ref.float().abs()+1e-12)\n    ok=(diff <= atol) | (rel <= rtol)\n    print('max_abs', diff.max().item(), 'max_rel', rel.max().item(), 'matched', ok.float().mean().item())\n\nfor m in [256, 640, 4096]:\n    print('M',m)\n    inputs=reference.get_inputs({'num_tokens':m}, torch.device('cuda:0'))\n    torch.cuda.synchronize()\n    ref=reference.run(**inputs)\n    torch.cuda.synchronize()\n    y=run_fast(**inputs)\n    torch.cuda.synchronize()\n    stats(y, ref, 0.00465, 0.0078125)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
