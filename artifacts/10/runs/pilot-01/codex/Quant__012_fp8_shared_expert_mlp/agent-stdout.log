{"type":"item.started","item":{"id":"item_55","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport torch, triton\nimport reference, kernel\n\ndef bench_m(m):\n    print('M',m)\n    inp=reference.get_inputs({'num_tokens':m}, torch.device('cuda:0'))\n    h=inp['hidden_states']; gw=inp['gate_proj_weight']; uw=inp['up_proj_weight']; dw=inp['down_proj_weight']\n    def act_hidden():\n        hf=h.to(torch.float32); s=kernel._act_scales(hf); q=kernel._apply_act_quant(hf,s); return q,s\n    qh,sh=act_hidden(); torch.cuda.synchronize()\n    def w_gate():\n        wf=gw.to(torch.float32); s=kernel._weight_scales_transposed(wf); q=kernel._apply_weight_quant(wf,s); return q,s\n    qg,sg=w_gate(); torch.cuda.synchronize()\n    out=torch.empty((m,2048),device='cuda',dtype=torch.bfloat16)\n    # warm full to compile all\n    y=kernel.run(**inp); torch.cuda.synchronize()\n    print('full', triton.testing.do_bench(lambda: kernel.run(**inp), warmup=5, rep=20))\n    print('act_hidden', triton.testing.do_bench(act_hidden, warmup=5, rep=20))\n    print('w_gate', triton.testing.do_bench(w_gate, warmup=5, rep=20))\n    print('gemm_gate', triton.testing.do_bench(lambda: kernel._fp8_block_gemm(qh,qg,sh,sg), warmup=5, rep=20))\n    gate=kernel._fp8_linear_from_quant(qh,sh,gw); up=kernel._fp8_linear_from_quant(qh,sh,uw); inter=torch.nn.functional.silu(gate)*up; torch.cuda.synchronize()\n    print('silu_mul', triton.testing.do_bench(lambda: torch.nn.functional.silu(gate)*up, warmup=5, rep=20))\n    def act_inter():\n        inf=inter.to(torch.float32); s=kernel._act_scales(inf); q=kernel._apply_act_quant(inf,s); return q,s\n    qi,si=act_inter(); torch.cuda.synchronize()\n    print('act_inter', triton.testing.do_bench(act_inter, warmup=5, rep=20))\n    def w_down():\n        wf=dw.to(torch.float32); s=kernel._weight_scales_transposed(wf); q=kernel._apply_weight_quant(wf,s); return q,s\n    qd,sd=w_down(); torch.cuda.synchronize()\n    print('w_down', triton.testing.do_bench(w_down, warmup=5, rep=20))\n    print('gemm_down', triton.testing.do_bench(lambda: kernel._fp8_block_gemm(qi,qd,si,sd), warmup=5, rep=20))\n\nbench_m(256)\nbench_m(4096)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
