{"type":"item.started","item":{"id":"item_29","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch\nimport kernel\nshapes=[1,4,14,16,32,80,901,11948,14104]\nfor m in shapes:\n    torch.manual_seed(0)\n    A=torch.randn((m,7168),device='cuda',dtype=torch.float16)\n    B=torch.randn((256,7168),device='cuda',dtype=torch.float16)\n    C=kernel.run(A,B)\n    R=torch.matmul(A,B.T)\n    torch.cuda.synchronize()\n    diff=(C-R).abs()\n    print('check',m,float(diff.max()),float((diff <= (0.05+0.001*R.abs())).float().mean()))\n\ndef bench(fn,A,B,iters):\n    for _ in range(5): y=fn(A,B)\n    torch.cuda.synchronize()\n    s=torch.cuda.Event(True); e=torch.cuda.Event(True)\n    s.record()\n    for _ in range(iters): y=fn(A,B)\n    e.record(); torch.cuda.synchronize()\n    return s.elapsed_time(e)/iters\nfor m in shapes:\n    A=torch.randn((m,7168),device='cuda',dtype=torch.float16)\n    B=torch.randn((256,7168),device='cuda',dtype=torch.float16)\n    it=200 if m<100 else (50 if m<1000 else 10)\n    kt=bench(kernel.run,A,B,it)\n    tt=bench(lambda a,b: torch.matmul(a,b.T),A,B,it)\n    print(f'{m:5d} kernel {kt:.4f} ms torch {tt:.4f} ms ratio {kt/tt:.2f}')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
