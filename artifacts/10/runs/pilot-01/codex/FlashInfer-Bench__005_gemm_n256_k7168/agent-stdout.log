{"type":"item.started","item":{"id":"item_31","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch, triton, kernel\ncfgs=[]\nfor bm in [8,16,32,64,128]:\n  for bn in [32,64,128]:\n    for bk in [64,128,256]:\n      if 7168 % bk == 0:\n        cfgs.append((bm,bn,bk,4))\n        if bm*bn>=2048: cfgs.append((bm,bn,bk,8))\n\ndef run_cfg(A,B,cfg):\n    bm,bn,bk,nw=cfg\n    M=A.shape[0]\n    C=torch.empty((M,256),device=A.device,dtype=torch.float16)\n    kernel._matmul_kernel[(triton.cdiv(M,bm),triton.cdiv(256,bn))](A,B,C,M,bm,bn,bk,num_warps=nw)\n    return C\n\ndef bench(m,cfg,iters):\n    A=torch.randn((m,7168),device='cuda',dtype=torch.float16)\n    B=torch.randn((256,7168),device='cuda',dtype=torch.float16)\n    C=run_cfg(A,B,cfg); R=torch.matmul(A,B.T); torch.cuda.synchronize()\n    ok=float(((C-R).abs() <= (0.05+0.001*R.abs())).float().mean())>=0.99\n    if not ok:\n        return None\n    for _ in range(5): run_cfg(A,B,cfg)\n    torch.cuda.synchronize()\n    s=torch.cuda.Event(True); e=torch.cuda.Event(True)\n    s.record()\n    for _ in range(iters): run_cfg(A,B,cfg)\n    e.record(); torch.cuda.synchronize()\n    return s.elapsed_time(e)/iters\n\nfor m,it in [(1,100),(16,100),(80,100),(901,40),(14104,8)]:\n    res=[]\n    for cfg in cfgs:\n        try:\n            t=bench(m,cfg,it)\n            if t is not None: res.append((t,cfg))\n        except Exception as ex:\n            pass\n    res.sort()\n    print('M',m)\n    for t,cfg in res[:12]: print(f'{t:.4f}',cfg)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
