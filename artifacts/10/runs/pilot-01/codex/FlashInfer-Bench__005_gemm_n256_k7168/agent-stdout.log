{"type":"item.started","item":{"id":"item_12","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch\nimport kernel\nfor m in [1,4,16,32,80,901]:\n    torch.manual_seed(0)\n    A=torch.randn((m,7168),device='cuda',dtype=torch.float16)\n    B=torch.randn((256,7168),device='cuda',dtype=torch.float16)\n    C=kernel.run(A,B)\n    R=torch.matmul(A,B.T)\n    torch.cuda.synchronize()\n    diff=(C-R).abs()\n    print(m, C.shape, C.dtype, float(diff.max()), float((diff <= (0.05 + 0.001*R.abs())).float().mean()))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch\nimport kernel\nfor m in [1,4,16,32,80,901]:\n    torch.manual_seed(0)\n    A=torch.randn((m,7168),device='cuda',dtype=torch.float16)\n    B=torch.randn((256,7168),device='cuda',dtype=torch.float16)\n    C=kernel.run(A,B)\n    R=torch.matmul(A,B.T)\n    torch.cuda.synchronize()\n    diff=(C-R).abs()\n    print(m, C.shape, C.dtype, float(diff.max()), float((diff <= (0.05 + 0.001*R.abs())).float().mean()))\nPY\"","aggregated_output":"<stdin>:5: UserWarning: expandable_segments not supported on this platform (Triggered internally at /pytorch/c10/hip/HIPAllocatorConfig.h:36.)\n1 torch.Size([1, 256]) torch.float16 0.001953125 1.0\n4 torch.Size([4, 256]) torch.float16 0.0625 1.0\n16 torch.Size([16, 256]) torch.float16 0.0625 1.0\n32 torch.Size([32, 256]) torch.float16 0.0625 1.0\n80 torch.Size([80, 256]) torch.float16 0.125 1.0\n901 torch.Size([901, 256]) torch.float16 0.0 1.0\n[W804 11:35:25.775236098 AllocatorConfig.cpp:28] Warning: PYTORCH_CUDA_ALLOC_CONF is deprecated, use PYTORCH_ALLOC_CONF instead (function operator())\n","exit_code":0,"status":"completed"}}
