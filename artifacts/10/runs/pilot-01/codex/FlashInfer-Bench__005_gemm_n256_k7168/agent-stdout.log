{"type":"item.started","item":{"id":"item_14","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport time, torch\nimport kernel\nshapes=[1,4,14,15,16,32,53,54,55,56,57,58,63,80,901,11948,14104]\n\ndef bench(fn, A, B, iters):\n    # warm\n    for _ in range(3):\n        y=fn(A,B)\n    torch.cuda.synchronize()\n    start=torch.cuda.Event(enable_timing=True); end=torch.cuda.Event(enable_timing=True)\n    start.record()\n    for _ in range(iters):\n        y=fn(A,B)\n    end.record(); torch.cuda.synchronize()\n    return start.elapsed_time(end)/iters\n\nfor m in shapes:\n    torch.manual_seed(123)\n    A=torch.randn((m,7168),device='cuda',dtype=torch.float16)\n    B=torch.randn((256,7168),device='cuda',dtype=torch.float16)\n    it=100 if m<100 else (30 if m<1000 else 5)\n    kt=bench(kernel.run,A,B,it)\n    tt=bench(lambda a,b: torch.matmul(a,b.T),A,B,it)\n    print(f'{m:5d} kernel {kt:.4f} ms torch {tt:.4f} ms ratio {kt/tt:.2f}')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
