{"type":"item.started","item":{"id":"item_28","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch, time\nimport torch.nn.functional as F\nimport reference\n\ndevice='cuda:0'; B=10; S=577; E=1024; H=16; D=64\n\ntorch.manual_seed(123)\nargs=(\n    torch.rand((B,S,E),device=device),\n    torch.rand((B,S,E),device=device),\n    torch.rand((B,S,1),device=device),\n    torch.rand((B,S,1),device=device),\n    torch.rand((B,S,E),device=device),\n    torch.rand((E,),device=device),\n    torch.rand((3*E,E),device=device),\n    torch.rand((B,H,S,D),device=device),\n    torch.rand((B,H,S,D),device=device),\n    torch.rand((B,H,S,D),device=device),\n    torch.rand((B,H,S,S),device=device),\n    torch.rand((B,S,E),device=device),\n    torch.rand((E,E),device=device),\n    0.125,\n    1e-5,\n)\n\ndef direct(grad_output,x,x_mean,x_var,x_norm,ln_weight,qkv_weight,q,k,v,attn_weights,attn_output,out_weight,scale,norm_eps):\n    B,S,E=x.shape; H=16; D=64\n    go2=grad_output.reshape(-1,E)\n    grad_attn_output = torch.matmul(go2, out_weight).reshape(B,S,E)\n    grad_out_weight = torch.matmul(go2.t(), attn_output.reshape(-1,E))\n    grad_out_bias = grad_output.sum(dim=(0,1))\n    gh=grad_attn_output.view(B,S,H,D).transpose(1,2)\n    gv=torch.matmul(attn_weights.transpose(-2,-1), gh)\n    gaw=torch.matmul(gh, v.transpose(-2,-1))\n    sg=(gaw*attn_weights).sum(dim=-1, keepdim=True)\n    gas=attn_weights*(gaw-sg)\n    gq=torch.matmul(gas,k)*scale\n    gk=torch.matmul(gas.transpose(-2,-1), q*scale)\n    gq=gq.transpose(1,2).reshape(B,S,E); gk=gk.transpose(1,2).reshape(B,S,E); gv=gv.transpose(1,2).reshape(B,S,E)\n    gqkv=torch.cat([gq,gk,gv], dim=-1)\n    gxnorm=torch.matmul(gqkv.reshape(-1,3*E), qkv_weight).reshape(B,S,E)\n    gqkvw=torch.matmul(gqkv.reshape(-1,3*E).t(), x_norm.reshape(-1,E))\n    gqkvb=gqkv.sum(dim=(0,1))\n    std=torch.sqrt(x_var+norm_eps); xc=x-x_mean; xn=xc/std\n    glnw=(gxnorm*xn).sum(dim=(0,1)); glnb=gxnorm.sum(dim=(0,1))\n    gxnormed=gxnorm*ln_weight\n    gxfrom=gxnormed/std\n    mg=gxfrom.mean(dim=-1,keepdim=True)\n    mgxc=(gxnormed*xc).mean(dim=-1,keepdim=True)/(std**2)\n    gx=grad_output + gxfrom - mg - xc*mgxc\n    return gx,gqkvw,gqkvb,grad_out_weight,grad_out_bias,glnw,glnb\n\ndef direct_inplace(*args):\n    grad_output,x,x_mean,x_var,x_norm,ln_weight,qkv_weight,q,k,v,attn_weights,attn_output,out_weight,scale,norm_eps=args\n    B,S,E=x.shape; H=16; D=64\n    go2=grad_output.reshape(-1,E)\n    grad_attn_output = torch.matmul(go2, out_weight).reshape(B,S,E)\n    grad_out_weight = torch.matmul(go2.t(), attn_output.reshape(-1,E))\n    grad_out_bias = grad_output.sum(dim=(0,1))\n    gh=grad_attn_output.view(B,S,H,D).transpose(1,2)\n    gv=torch.matmul(attn_weights.transpose(-2,-1), gh)\n    gaw=torch.matmul(gh, v.transpose(-2,-1))\n    sg=(gaw*attn_weights).sum(dim=-1, keepdim=True)\n    gaw.sub_(sg); gaw.mul_(attn_weights); gas=gaw\n    gq=torch.matmul(gas,k)*scale\n    gk=torch.matmul(gas.transpose(-2,-1), q*scale)\n    gq=gq.transpose(1,2).reshape(B,S,E); gk=gk.transpose(1,2).reshape(B,S,E); gv=gv.transpose(1,2).reshape(B,S,E)\n    gqkv=torch.cat([gq,gk,gv], dim=-1)\n    gxnorm=torch.matmul(gqkv.reshape(-1,3*E), qkv_weight).reshape(B,S,E)\n    gqkvw=torch.matmul(gqkv.reshape(-1,3*E).t(), x_norm.reshape(-1,E))\n    gqkvb=gqkv.sum(dim=(0,1))\n    std=torch.sqrt(x_var+norm_eps); xc=x-x_mean; xn=xc/std\n    glnw=(gxnorm*xn).sum(dim=(0,1)); glnb=gxnorm.sum(dim=(0,1))\n    gxnormed=gxnorm*ln_weight\n    gxfrom=gxnormed/std\n    mg=gxfrom.mean(dim=-1,keepdim=True)\n    mgxc=(gxnormed*xc).mean(dim=-1,keepdim=True)/(std**2)\n    gx=grad_output + gxfrom - mg - xc*mgxc\n    return gx,gqkvw,gqkvb,grad_out_weight,grad_out_bias,glnw,glnb\n\n# correctness quick\nfor fn in [direct, direct_inplace]:\n    o=fn(*args); torch.cuda.synchronize(); r=reference.run(*args); torch.cuda.synchronize()\n    print(fn.__name__, max((a-b).abs().max().item() for a,b in zip(o,r)))\n\ndef bench(fn, reps=8):\n    # warmup\n    for _ in range(3):\n        out=fn(*args)\n    torch.cuda.synchronize()\n    st=torch.cuda.Event(enable_timing=True); en=torch.cuda.Event(enable_timing=True)\n    st.record()\n    for _ in range(reps):\n        out=fn(*args)\n    en.record(); torch.cuda.synchronize()\n    return st.elapsed_time(en)/reps\nfor fn in [reference.run, direct, direct_inplace]:\n    print(fn.__name__, bench(fn))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
