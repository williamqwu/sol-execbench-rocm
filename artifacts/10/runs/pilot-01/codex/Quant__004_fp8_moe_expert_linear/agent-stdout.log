{"type":"item.completed","item":{"id":"item_66","type":"agent_message","text":"The tuned AITER kernel entry point is much faster than the default wrapper and numerically identical in probes. I’m benchmarking kernel IDs across all workload token counts for the two GEMM shapes, then I’ll encode a small shape-to-kernel selection table."}}
{"type":"item.started","item":{"id":"item_67","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch, reference, aiter\nfrom kernel import _activation_scales,_weight_scales_transposed,_quantize_activation,_quantize_weight_t\nMs=[384,640,896,1024,1152,1536,1792,1920,2048,2176,2432,2816,3072,3584,3712,4096]\nids=list(range(16))\nreps=12\nresults={}\n\ndef time_call(fn,reps):\n    for _ in range(3): fn()\n    torch.cuda.synchronize()\n    e0=torch.cuda.Event(enable_timing=True); e1=torch.cuda.Event(enable_timing=True)\n    e0.record()\n    for _ in range(reps): fn()\n    e1.record(); torch.cuda.synchronize()\n    return e0.elapsed_time(e1)/reps\n\nfor M in Ms:\n    inp=reference.get_inputs({'num_tokens':M}, torch.device('cuda:0'))\n    h=inp['hidden_states'].float(); sh=_activation_scales(h); hf=_quantize_activation(h,sh)\n    gut=inp['gate_up_weight'].float().T; sgu=_weight_scales_transposed(gut); guf=_quantize_weight_t(gut,sgu).T\n    y1=aiter.gemm_a8w8_blockscale_tune(hf,guf,sh,sgu.T.contiguous(),torch.empty((M,4096),device='cuda',dtype=torch.bfloat16),0,0)\n    g,u=y1.chunk(2,dim=-1); gd=torch.nn.functional.silu(g)*u; gd32=gd.float(); sgd=_activation_scales(gd32); gdf=_quantize_activation(gd32,sgd)\n    dwt=inp['down_weight'].float().T; sd=_weight_scales_transposed(dwt); df=_quantize_weight_t(dwt,sd).T\n    cases=[('g1',hf,guf,sh,sgu.T.contiguous(),4096),('g2',gdf,df,sgd,sd.T.contiguous(),3584)]\n    print('M',M, flush=True)\n    for label,X,W,xs,ws,N in cases:\n        out=torch.empty((M,N),device='cuda',dtype=torch.bfloat16)\n        best=(999,None)\n        vals=[]\n        base=None\n        for kid in ids:\n            try:\n                fn=lambda kid=kid: aiter.gemm_a8w8_blockscale_tune(X,W,xs,ws,out,kid,0)\n                y=fn(); torch.cuda.synchronize()\n                if base is None: base=y.clone()\n                d=(y.float()-base.float()).abs().max().item()\n                ms=time_call(fn,reps)\n                vals.append((ms,kid,d))\n                if d <= 0 and ms < best[0]: best=(ms,kid)\n            except Exception as e:\n                vals.append((999,kid,-1))\n        vals_sorted=sorted(vals)[:4]\n        print(label, 'best', best, 'top4', [(round(v[0],4),v[1],v[2]) for v in vals_sorted], flush=True)\n        results[(M,label)]=best\nprint('TABLE')\nfor M in Ms:\n    print(M, results[(M,'g1')][1], f'{results[(M,\\\"g1\\\")][0]:.4f}', results[(M,'g2')][1], f'{results[(M,\\\"g2\\\")][0]:.4f}')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
