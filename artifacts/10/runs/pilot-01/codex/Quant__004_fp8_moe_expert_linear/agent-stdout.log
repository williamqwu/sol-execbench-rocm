{"type":"item.completed","item":{"id":"item_14","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,200p' solution.json && sed -n '1,220p' kernel.py\"","aggregated_output":"{\n  \"name\": \"004_fp8_moe_expert_linear_agent\",\n  \"definition\": \"004_fp8_moe_expert_linear\",\n  \"author\": \"agent\",\n  \"spec\": {\n    \"languages\": [\"triton\"],\n    \"target_hardware\": [\"MI355X\", \"LOCAL\"],\n    \"entry_point\": \"kernel.py::run\",\n    \"dependencies\": [\"torch\", \"triton\"],\n    \"destination_passing_style\": false\n  },\n  \"sources\": [\n    {\"path\": \"kernel.py\", \"content\": \"\"}\n  ]\n}\nimport torch\nimport torch.nn.functional as F\n\n\nE4M3_MAX = 448.0\n\n\ndef _activation_scales(x):\n    m, k = x.shape\n    return torch.clamp(\n        x.reshape(m, k // 128, 128).abs().amax(dim=2) / E4M3_MAX,\n        min=1.0e-12,\n    )\n\n\ndef _weight_scales_transposed(w_t):\n    m, k = w_t.shape\n    return torch.clamp(\n        w_t.reshape(m // 128, 128, k // 128, 128).abs().amax(dim=3).amax(dim=1)\n        / E4M3_MAX,\n        min=1.0e-12,\n    )\n\n\ndef _quantize_activation(x, scales):\n    m, k = x.shape\n    y = x.reshape(m, k // 128, 128) / scales.unsqueeze(2)\n    y = torch.clamp(y, min=-E4M3_MAX, max=E4M3_MAX)\n    return y.reshape(m, k).to(torch.float8_e4m3fn)\n\n\ndef _quantize_weight_t(w_t, scales):\n    m, k = w_t.shape\n    y = w_t.reshape(m // 128, 128, k // 128, 128) / scales.unsqueeze(1).unsqueeze(3)\n    y = torch.clamp(y, min=-E4M3_MAX, max=E4M3_MAX)\n    return y.reshape(m, k).to(torch.float8_e4m3fn)\n\n\ndef _dequantize_activation(x_fp8, scales):\n    m, k = x_fp8.shape\n    x = x_fp8.to(torch.float32).reshape(m, k // 128, 128)\n    return (x * scales.unsqueeze(2)).reshape(m, k)\n\n\ndef _dequantize_weight_b(b_fp8, scales_cublas):\n    n, k = b_fp8.shape\n    x = b_fp8.to(torch.float32).reshape(n // 128, 128, k // 128, 128)\n    return (x * scales_cublas.reshape(n // 128, k // 128).unsqueeze(1).unsqueeze(3)).reshape(n, k)\n\n\ndef _scaled_mm(a_fp8, b_fp8, scale_a, scale_b_cublas):\n    a = _dequantize_activation(a_fp8, scale_a)\n    b = _dequantize_weight_b(b_fp8, scale_b_cublas)\n    return (a @ b.T).to(torch.bfloat16)\n\n\n@torch.no_grad()\ndef run(hidden_states, routing_weight, gate_up_weight, down_weight):\n    hidden_fp32 = hidden_states.to(torch.float32)\n    scale_hidden = _activation_scales(hidden_fp32)\n\n    gate_up_weight_t = gate_up_weight.to(torch.float32).T\n    scale_gate_up = _weight_scales_transposed(gate_up_weight_t)\n\n    hidden_fp8 = _quantize_activation(hidden_fp32, scale_hidden)\n    gate_up_fp8 = _quantize_weight_t(gate_up_weight_t, scale_gate_up).T\n    gate_up_out = _scaled_mm(hidden_fp8, gate_up_fp8, scale_hidden, scale_gate_up.T.contiguous())\n\n    gate, up = gate_up_out.chunk(2, dim=-1)\n    gated = F.silu(gate) * up\n\n    gated_fp32 = gated.to(torch.float32)\n    scale_gated = _activation_scales(gated_fp32)\n\n    down_weight_t = down_weight.to(torch.float32).T\n    scale_down = _weight_scales_transposed(down_weight_t)\n\n    gated_fp8 = _quantize_activation(gated_fp32, scale_gated)\n    down_fp8 = _quantize_weight_t(down_weight_t, scale_down).T\n    out = _scaled_mm(gated_fp8, down_fp8, scale_gated, scale_down.T.contiguous())\n\n    return out * routing_weight\n","exit_code":0,"status":"completed"}}
