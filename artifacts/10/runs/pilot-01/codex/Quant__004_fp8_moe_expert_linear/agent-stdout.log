{"type":"item.started","item":{"id":"item_76","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch, reference, kernel\nfrom kernel import _activation_scales,_weight_scales_transposed,_quantize_activation,_quantize_weight_t,_scaled_mm\n\ndef bench(M, reps=5):\n    inputs=reference.get_inputs({'num_tokens':M}, torch.device('cuda:0'))\n    hs=inputs['hidden_states']; rw=inputs['routing_weight']; guw=inputs['gate_up_weight']; dw=inputs['down_weight']\n    for _ in range(2): kernel.run(hs,rw,guw,dw)\n    torch.cuda.synchronize()\n    names=['hidden_f32','scale_hidden','quant_hidden','gate_f32_T','scale_gate','quant_gate_w','gemm1','act','scale_gated','quant_gated','down_f32_T','scale_down','quant_down_w','gemm2','route']\n    totals=dict.fromkeys(names,0.0)\n    for _ in range(reps):\n        evs=[]\n        def mark():\n            e=torch.cuda.Event(enable_timing=True); e.record(); evs.append(e)\n        mark(); hidden_fp32=hs.float(); mark(); scale_hidden=_activation_scales(hidden_fp32); mark(); hidden_fp8=_quantize_activation(hidden_fp32,scale_hidden); mark(); gate_up_weight_t=guw.float().T; mark(); scale_gate_up=_weight_scales_transposed(gate_up_weight_t); mark(); gate_up_fp8=_quantize_weight_t(gate_up_weight_t,scale_gate_up).T; mark(); gate_up_out=_scaled_mm(hidden_fp8,gate_up_fp8,scale_hidden,scale_gate_up.T.contiguous()); mark(); gate,up=gate_up_out.chunk(2,dim=-1); gated=torch.nn.functional.silu(gate)*up; mark(); gated_fp32=gated.float(); scale_gated=_activation_scales(gated_fp32); mark(); gated_fp8=_quantize_activation(gated_fp32,scale_gated); mark(); down_weight_t=dw.float().T; mark(); scale_down=_weight_scales_transposed(down_weight_t); mark(); down_fp8=_quantize_weight_t(down_weight_t,scale_down).T; mark(); out=_scaled_mm(gated_fp8,down_fp8,scale_gated,scale_down.T.contiguous()); mark(); y=out*rw; mark(); torch.cuda.synchronize()\n        for name,a,b in zip(names,evs,evs[1:]): totals[name]+=a.elapsed_time(b)\n    print('M',M)\n    for n in names: print(f'{n:14s} {totals[n]/reps:.4f} ms')\n    print('sum', sum(totals.values())/reps)\nbench(384,3); bench(4096,3)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
