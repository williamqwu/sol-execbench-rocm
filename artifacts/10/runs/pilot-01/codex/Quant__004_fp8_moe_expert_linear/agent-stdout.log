{"type":"item.completed","item":{"id":"item_63","type":"agent_message","text":"The profile shows the GEMMs dominate for large token counts, while weight scale/quantization is the fixed overhead for small counts. I’m benchmarking the available AITER GEMM variants on the exact two matrix shapes to see if another backend beats the generic wrapper."}}
{"type":"item.started","item":{"id":"item_64","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch, reference, aiter\nfrom kernel import _activation_scales,_weight_scales_transposed,_quantize_activation,_quantize_weight_t\n\ndef make(M):\n    inp=reference.get_inputs({'num_tokens':M}, torch.device('cuda:0'))\n    hs=inp['hidden_states']; guw=inp['gate_up_weight']; dw=inp['down_weight']\n    h=hs.float(); sh=_activation_scales(h); hf=_quantize_activation(h, sh)\n    gut=guw.float().T; sgu=_weight_scales_transposed(gut); guf=_quantize_weight_t(gut, sgu).T\n    y1=aiter.gemm_a8w8_blockscale(hf,guf,sh,sgu.T.contiguous(),torch.bfloat16)\n    g,u=y1.chunk(2,dim=-1); gd=torch.nn.functional.silu(g)*u\n    gd32=gd.float(); sgd=_activation_scales(gd32); gdf=_quantize_activation(gd32,sgd)\n    dwt=dw.float().T; sd=_weight_scales_transposed(dwt); df=_quantize_weight_t(dwt,sd).T\n    torch.cuda.synchronize()\n    return [(f'M{M}_gemm1',hf,guf,sh,sgu.T.contiguous()),(f'M{M}_gemm2',gdf,df,sgd,sd.T.contiguous())]\n\ndef bench_one(name,X,W,xs,ws):\n    print('\\\\n', name, X.shape, W.shape, xs.shape, ws.shape)\n    out=torch.empty((X.shape[0],W.shape[0]),device='cuda',dtype=torch.bfloat16)\n    funcs=[]\n    funcs.append(('generic', lambda: aiter.gemm_a8w8_blockscale(X,W,xs,ws,torch.bfloat16)))\n    funcs.append(('ck', lambda: aiter.gemm_a8w8_blockscale_ck(X,W,xs,ws,out)))\n    funcs.append(('cktile', lambda: aiter.gemm_a8w8_blockscale_cktile(X,W,xs,ws,out)))\n    # maybe tune with a few ids if callable convention matches\n    for kid in range(4):\n        funcs.append((f'tune{kid}', lambda kid=kid: aiter.gemm_a8w8_blockscale_tune(X,W,xs,ws,out,kid,0)))\n    base=None\n    for fname,fn in funcs:\n        try:\n            for _ in range(3): y=fn()\n            torch.cuda.synchronize()\n            ev0=torch.cuda.Event(enable_timing=True); ev1=torch.cuda.Event(enable_timing=True)\n            ev0.record()\n            reps=20\n            for _ in range(reps): y=fn()\n            ev1.record(); torch.cuda.synchronize()\n            ms=ev0.elapsed_time(ev1)/reps\n            yv=y.clone(); torch.cuda.synchronize()\n            if base is None: base=yv\n            d=(yv.float()-base.float()).abs()\n            print(fname, f'{ms:.4f} ms', 'maxdiff', d.max().item(), 'mean', d.mean().item())\n        except Exception as e:\n            print(fname, 'err', type(e).__name__, str(e).split('\\\\n')[0])\nfor data in make(384)+make(4096):\n    bench_one(*data)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
