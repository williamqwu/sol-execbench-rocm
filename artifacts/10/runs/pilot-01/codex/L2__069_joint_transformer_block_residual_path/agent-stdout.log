{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,220p' definition.json && sed -n '1,20p' workload.jsonl\"","aggregated_output":"{\n  \"name\": \"069_joint_transformer_block_residual_path\",\n  \"description\": \"Complete residual path through a JointTransformerBlock including dual-stream attention, adaptive normalization, and feedforward with residual connections for SD3.5.\",\n  \"hf_id\": \"stabilityai/stable-diffusion-3.5-medium\",\n  \"custom_inputs_entrypoint\": \"get_inputs\",\n  \"axes\": {\n    \"batch_size\": {\n      \"type\": \"var\"\n    },\n    \"seq_len\": {\n      \"type\": \"var\"\n    },\n    \"context_len\": {\n      \"type\": \"var\"\n    },\n    \"num_attention_heads\": {\n      \"type\": \"const\",\n      \"value\": 24\n    },\n    \"attention_head_dim\": {\n      \"type\": \"const\",\n      \"value\": 64\n    },\n    \"inner_dim\": {\n      \"type\": \"const\",\n      \"value\": 1536\n    },\n    \"context_dim\": {\n      \"type\": \"const\",\n      \"value\": 1152\n    },\n    \"ff_inner_dim\": {\n      \"type\": \"const\",\n      \"value\": 6144\n    },\n    \"mod_dim_6x\": {\n      \"type\": \"expr\",\n      \"expression\": \"inner_dim * 6\"\n    },\n    \"context_mod_dim_6x\": {\n      \"type\": \"expr\",\n      \"expression\": \"context_dim * 6\"\n    }\n  },\n  \"inputs\": {\n    \"hidden_states\": {\n      \"shape\": [\n        \"batch_size\",\n        \"seq_len\",\n        \"inner_dim\"\n      ],\n      \"dtype\": \"float32\",\n      \"description\": \"Image latent tokens\"\n    },\n    \"encoder_hidden_states\": {\n      \"shape\": [\n        \"batch_size\",\n        \"context_len\",\n        \"context_dim\"\n      ],\n      \"dtype\": \"float32\",\n      \"description\": \"Text/context tokens\"\n    },\n    \"temb\": {\n      \"shape\": [\n        \"batch_size\",\n        \"inner_dim\"\n      ],\n      \"dtype\": \"float32\",\n      \"description\": \"Timestep embeddings\"\