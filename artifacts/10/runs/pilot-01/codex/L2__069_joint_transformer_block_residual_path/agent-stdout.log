{"type":"item.started","item":{"id":"item_33","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport torch\nimport reference\nimport kernel\n\nD=1536; CD=1152; FF=6144\nnames_shapes = [\n    ('hidden_states', lambda B,S,C: (B,S,D)),\n    ('encoder_hidden_states', lambda B,S,C: (B,C,CD)),\n    ('temb', lambda B,S,C: (B,D)),\n    ('norm1_weight', lambda B,S,C: (6*D,D)),\n    ('norm1_bias', lambda B,S,C: (6*D,)),\n    ('norm1_context_weight', lambda B,S,C: (6*CD,D)),\n    ('norm1_context_bias', lambda B,S,C: (6*CD,)),\n    ('to_q_weight', lambda B,S,C: (D,D)), ('to_q_bias', lambda B,S,C: (D,)),\n    ('to_k_weight', lambda B,S,C: (D,D)), ('to_k_bias', lambda B,S,C: (D,)),\n    ('to_v_weight', lambda B,S,C: (D,D)), ('to_v_bias', lambda B,S,C: (D,)),\n    ('add_q_proj_weight', lambda B,S,C: (D,CD)), ('add_q_proj_bias', lambda B,S,C: (D,)),\n    ('add_k_proj_weight', lambda B,S,C: (D,CD)), ('add_k_proj_bias', lambda B,S,C: (D,)),\n    ('add_v_proj_weight', lambda B,S,C: (D,CD)), ('add_v_proj_bias', lambda B,S,C: (D,)),\n    ('to_out_weight', lambda B,S,C: (D,D)), ('to_out_bias', lambda B,S,C: (D,)),\n    ('to_add_out_weight', lambda B,S,C: (CD,D)), ('to_add_out_bias', lambda B,S,C: (CD,)),\n    ('ff_linear1_weight', lambda B,S,C: (FF,D)), ('ff_linear1_bias', lambda B,S,C: (FF,)),\n    ('ff_linear2_weight', lambda B,S,C: (D,FF)), ('ff_linear2_bias', lambda B,S,C: (D,)),\n    ('ff_context_linear1_weight', lambda B,S,C: (FF,CD)), ('ff_context_linear1_bias', lambda B,S,C: (FF,)),\n    ('ff_context_linear2_weight', lambda B,S,C: (CD,FF)), ('ff_context_linear2_bias', lambda B,S,C: (CD,)),\n]\n\ndef make_inputs(B,S,C, seed):\n    g = torch.Generator(device='cuda'); g.manual_seed(seed)\n    return {name: torch.randn(fn(B,S,C), device='cuda', generator=g) for name, fn in names_shapes}\n\ncases = [\n    (32,256,77,0.01913029544967228),\n    (64,128,77,0.01758231994811705),\n    (8,256,77,0.01871684737642534),\n    (16,512,77,0.019505177941728756),\n    (4,1024,77,0.021714440594153867),\n    (2,4096,77,0.020674427844880282),\n    (4,2048,77,0.019874808822152916),\n]\nfor B,S,C,atol in cases:\n    print('case', B,S,C, flush=True)\n    for seed in [100, 101]:\n        torch.cuda.empty_cache()\n        inp = make_inputs(B,S,C,seed)\n        ref = reference.run(**inp)\n        out = kernel.run(**inp)\n        torch.cuda.synchronize()\n        ratios=[]; maxes=[]\n        for a,b in zip(out,ref):\n            diff=(a-b).abs()\n            ratios.append((diff <= atol).float().mean().item())\n            maxes.append(diff.max().item())\n        print(' seed', seed, 'ratios', ratios, 'max', maxes, flush=True)\n        del inp, ref, out\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
