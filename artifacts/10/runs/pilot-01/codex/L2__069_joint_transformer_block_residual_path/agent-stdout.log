{"type":"item.started","item":{"id":"item_35","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport time, torch\nimport reference\n\nD=1536; CD=1152; FF=6144\n\ndef make(B,S,C):\n    g=torch.Generator(device='cuda'); g.manual_seed(123)\n    shapes=[(B,S,D),(B,C,CD),(B,D),(6*D,D),(6*D,),(6*CD,D),(6*CD,),\n            (D,D),(D,),(D,D),(D,),(D,D),(D,),\n            (D,CD),(D,),(D,CD),(D,),(D,CD),(D,),\n            (D,D),(D,),(CD,D),(CD,),\n            (FF,D),(FF,),(D,FF),(D,),\n            (FF,CD),(FF,),(CD,FF),(CD,)]\n    names=list(reference.run.__annotations__.keys())\n    # annotations includes return? fallback explicit names from code order\n    names=['hidden_states','encoder_hidden_states','temb','norm1_weight','norm1_bias','norm1_context_weight','norm1_context_bias','to_q_weight','to_q_bias','to_k_weight','to_k_bias','to_v_weight','to_v_bias','add_q_proj_weight','add_q_proj_bias','add_k_proj_weight','add_k_proj_bias','add_v_proj_weight','add_v_proj_bias','to_out_weight','to_out_bias','to_add_out_weight','to_add_out_bias','ff_linear1_weight','ff_linear1_bias','ff_linear2_weight','ff_linear2_bias','ff_context_linear1_weight','ff_context_linear1_bias','ff_context_linear2_weight','ff_context_linear2_bias']\n    return {n: torch.randn(s, device='cuda', generator=g) for n,s in zip(names,shapes)}\n\ncompiled = torch.compile(reference.run, mode='reduce-overhead')\ninp=make(1,128,154)\nt0=time.time(); outc=compiled(**inp); torch.cuda.synchronize(); print('compile+run', time.time()-t0)\nt0=time.time(); outc=compiled(**inp); torch.cuda.synchronize(); print('compiled run', time.time()-t0)\nt0=time.time(); outr=reference.run(**inp); torch.cuda.synchronize(); print('eager run', time.time()-t0)\nfor a,b in zip(outc,outr):\n    d=(a-b).abs(); print(d.max().item(), (d<=0.0184).float().mean().item())\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
