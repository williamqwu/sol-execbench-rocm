{"type":"item.started","item":{"id":"item_21","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport torch\nimport reference\nimport kernel\n\ndef check(q_lens, kv_lens, num_pages=20000):\n    device='cuda:0'\n    total_q=sum(q_lens)\n    total_kv=sum(kv_lens)\n    q=torch.randn((total_q,32,128),device=device,dtype=torch.bfloat16)\n    k=torch.randn((num_pages,1,4,128),device=device,dtype=torch.bfloat16)\n    v=torch.randn((num_pages,1,4,128),device=device,dtype=torch.bfloat16)\n    qo=[0]\n    kvp=[0]\n    for x in q_lens: qo.append(qo[-1]+x)\n    for x in kv_lens: kvp.append(kvp[-1]+x)\n    qo=torch.tensor(qo,device=device,dtype=torch.int32)\n    kvp=torch.tensor(kvp,device=device,dtype=torch.int32)\n    idx=torch.randperm(num_pages,device=device,dtype=torch.int32)[:total_kv]\n    scale=1/(128**0.5)\n    out,lse=kernel.run(q,k,v,qo,kvp,idx,scale)\n    torch.cuda.synchronize()\n    ref_out,ref_lse=reference.run(q,k,v,qo,kvp,idx,scale)\n    torch.cuda.synchronize()\n    out_err=(out.float()-ref_out.float()).abs().max().item() if out.numel() else 0\n    finite=torch.isfinite(ref_lse)\n    lse_err=(lse[finite]-ref_lse[finite]).abs().max().item() if finite.any() else 0\n    same_inf=torch.equal(torch.isneginf(lse), torch.isneginf(ref_lse))\n    print('q',q_lens,'kv',kv_lens,'out_err',out_err,'lse_err',lse_err,'inf',same_inf)\n\ncheck([1],[33],100)\ncheck([16],[2],100)\ncheck([80],[4],200)\ncheck([12383],[1],100)\ncheck([3,11],[1,1],100)\ncheck([200,300,100],[500,700,400],3000)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
