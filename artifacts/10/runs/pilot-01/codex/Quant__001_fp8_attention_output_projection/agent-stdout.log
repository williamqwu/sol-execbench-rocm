{"type":"item.started","item":{"id":"item_38","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport torch\nM=256; K=N=7680\nx=torch.randn((M,K),device='cuda',dtype=torch.bfloat16)\nw=torch.randn((N,K),device='cuda',dtype=torch.bfloat16)\nb=torch.randn((N,),device='cuda',dtype=torch.bfloat16)\nE=448.0\nxf=x.float(); sx=xf.reshape(M,K//128,128).abs().amax(2).clamp(min=1e-12)/E\nqx=((xf.reshape(M,K//128,128)/sx.unsqueeze(2)).clamp(-E,E).reshape(M,K).to(torch.float8_e4m3fn))\nwft=w.float().T\nswt=wft.reshape(K//128,128,N//128,128).abs().amax(3).amax(1).clamp(min=1e-12)/E\nqw=((wft.reshape(K//128,128,N//128,128)/swt[:,None,:,None]).clamp(-E,E).reshape(K,N).T.contiguous().to(torch.float8_e4m3fn))\nprint('qx', qx.shape, qx.stride(), sx.shape, 'qw', qw.shape, qw.stride(), swt.shape)\nfor sa in [sx, sx.reshape(M,K//128), sx.contiguous(), sx[:,0:1].contiguous(), torch.ones((1,),device='cuda')]:\n  for sb in [swt.T.contiguous(), swt.contiguous(), torch.ones((1,),device='cuda')]:\n    try:\n      y=torch._scaled_mm(qx, qw.T, sa, sb, bias=b, out_dtype=torch.bfloat16, use_fast_accum=True)\n      torch.cuda.synchronize()\n      print('ok', sa.shape, sb.shape, y.shape, y.dtype, torch.isfinite(y.float()).all().item())\n    except Exception as e:\n      print('err', sa.shape, sb.shape, type(e).__name__, str(e).split('\\\\n')[0])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
