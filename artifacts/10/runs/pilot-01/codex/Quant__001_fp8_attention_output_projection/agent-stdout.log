{"type":"item.started","item":{"id":"item_55","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport torch, time\nimport triton\nimport kernel\nE=448.0; K=N=7680\n\ndef prep(M):\n    torch.manual_seed(M)\n    x=torch.randn((M,K),device='cuda',dtype=torch.bfloat16)\n    w=torch.randn((N,K),device='cuda',dtype=torch.bfloat16)\n    b=torch.randn((N,),device='cuda',dtype=torch.bfloat16)\n    xf=x.float(); sx=xf.reshape(M,K//128,128).abs().amax(2).clamp(min=1e-12)/E\n    qx=((xf.reshape(M,K//128,128)/sx.unsqueeze(2)).clamp(-E,E).reshape(M,K).to(torch.float8_e4m3fn))\n    wft=w.float().T; swt=wft.reshape(K//128,128,N//128,128).abs().amax(3).amax(1).clamp(min=1e-12)/E\n    qw=((wft.reshape(K//128,128,N//128,128)/swt[:,None,:,None]).clamp(-E,E).reshape(K,N).T.contiguous().to(torch.float8_e4m3fn))\n    sw=swt.T.contiguous()\n    return qx,qw,sx,sw,b\n\ndef run(qx,qw,sx,sw,b,M,bm,bn,warps):\n    out=torch.empty((M,N),device='cuda',dtype=torch.bfloat16)\n    grid=(triton.cdiv(M,bm),triton.cdiv(N,bn))\n    kernel._scaled_fp8_gemm_kernel[grid](qx,qw,sx,sw,b,out,M,K_TOTAL=K,N_TOTAL=N,NUM_K_BLOCKS=K//128,BLOCK_M=bm,BLOCK_N=bn,num_warps=warps)\n    return out\nfor M in [256,2048,8192]:\n    qx,qw,sx,sw,b=prep(M)\n    configs=[(16,64,4),(16,128,4),(16,128,8),(32,64,4),(32,64,8),(32,128,4),(32,128,8),(64,64,4),(64,64,8),(64,128,8)]\n    print('M',M)\n    for cfg in configs:\n        bm,bn,warps=cfg\n        try:\n            for _ in range(2): run(qx,qw,sx,sw,b,M,bm,bn,warps)\n            torch.cuda.synchronize(); t0=time.perf_counter(); it=5 if M<=2048 else 3\n            for _ in range(it): run(qx,qw,sx,sw,b,M,bm,bn,warps)\n            torch.cuda.synchronize(); ms=(time.perf_counter()-t0)*1000/it\n            print(cfg,'%.3f'%ms)\n        except Exception as e:\n            print(cfg,'ERR',type(e).__name__,str(e).split('\\\\n')[0])\n    del qx,qw,sx,sw,b\n    torch.cuda.empty_cache()\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
