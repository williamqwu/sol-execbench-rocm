{"type":"item.started","item":{"id":"item_41","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport json, time\nimport torch\nimport reference, kernel\n\ndef sync(): torch.cuda.synchronize()\n\ndef score_direct(inp, bm, nw=4):\n    B=inp['grad_attn_output'].shape[0]; Q=inp['grad_attn_output'].shape[1]; K=inp['value_states'].shape[2]\n    out=torch.empty_like(inp['attn_weights'])\n    block=kernel._next_power_of_2(K)\n    kernel._direct_scores_kernel[(triton_cdiv(Q,bm), B*80)](inp['grad_attn_output'], inp['value_states'], inp['attn_weights'], inp['dropout_mask'], out, Q, K, 1.0/0.9, bm, block, 128, num_warps=nw)\n    return out\n\ndef triton_cdiv(a,b): return (a+b-1)//b\n\ndef run_direct_bm(grad_attn_output, attn_weights, attn_weights_dropped, value_states, dropout_mask, attention_dropout, bm=4, nw=4):\n    B=grad_attn_output.shape[0]; Q=grad_attn_output.shape[1]; K=value_states.shape[2]\n    go=grad_attn_output.transpose(1,2).to(torch.float32)\n    scores=torch.empty_like(attn_weights)\n    block=kernel._next_power_of_2(K)\n    kernel._direct_scores_kernel[(triton_cdiv(Q,bm), B*80)](grad_attn_output, value_states, attn_weights, dropout_mask, scores, Q, K, 1.0/(1.0-float(attention_dropout)), bm, block, 128, num_warps=nw)\n    gve=torch.matmul(attn_weights_dropped.to(torch.float32).transpose(-2,-1), go)\n    gv=gve.reshape(B,8,10,K,128).sum(dim=2).to(torch.bfloat16)\n    return scores, gv\n\ndef timed(fn, inputs, iters=8, warm=2):\n    for _ in range(warm): y=fn(**inputs); sync(); del y\n    t0=time.perf_counter()\n    for _ in range(iters): y=fn(**inputs); sync(); del y\n    return (time.perf_counter()-t0)*1000/iters\n\nlines=open('workload.jsonl').read().splitlines()\nfor idx in [8,1,4,14,12,7]:\n    w=json.loads(lines[idx]); inp=reference.get_inputs(w['axes'], torch.device('cuda:0'))\n    print('shape', idx, w['axes'])\n    for bm in [1,2,4,8]:\n        if bm > w['axes']['seq_len_q']: continue\n        for nw in ([4] if bm<8 else [4,8]):\n            try:\n                ms=timed(lambda **kw: run_direct_bm(**kw, bm=bm, nw=nw), inp, iters=6)\n                print(' bm',bm,'nw',nw, f'{ms:.3f}')\n            except Exception as e:\n                print(' bm',bm,'nw',nw,'ERR',type(e).__name__, e)\n    torch.cuda.empty_cache()\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
