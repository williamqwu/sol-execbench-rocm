{"type":"item.started","item":{"id":"item_75","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch, json\nimport reference, kernel\nlines=open('workload.jsonl').read().splitlines()\nfor idx,line in enumerate(lines):\n    w=json.loads(line)\n    inp=reference.get_inputs(w['axes'], torch.device('cuda:0'))\n    ref=reference.run(**inp)\n    out=kernel.run(**inp)\n    torch.cuda.synchronize()\n    stats=[]\n    ok=True\n    for a,b in zip(out,ref):\n        d=(a.float()-b.float()).abs()\n        tol=w['tolerance']['max_atol']+w['tolerance']['max_rtol']*b.float().abs()\n        m=(d<=tol).float().mean().item()\n        stats.append((d.max().item(),m))\n        ok = ok and m >= w['tolerance']['required_matched_ratio']\n    print(idx, 'OK' if ok else 'BAD', w['axes'], stats)\n    del inp, ref, out\n    torch.cuda.empty_cache()\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
