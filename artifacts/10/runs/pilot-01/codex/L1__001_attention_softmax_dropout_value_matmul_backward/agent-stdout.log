{"type":"item.started","item":{"id":"item_24","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport json, time\nimport torch\nimport reference, kernel\n\n\ndef sync(): torch.cuda.synchronize()\n\ndef timed(fn, inputs, iters=10, warm=3):\n    for _ in range(warm):\n        out=fn(**inputs); sync(); del out\n    t0=time.perf_counter()\n    for _ in range(iters):\n        out=fn(**inputs); sync(); del out\n    return (time.perf_counter()-t0)*1000/iters\n\n\ndef score_kernel(grad, attn, mask, p):\n    out=torch.empty_like(attn)\n    K=attn.shape[-1]\n    rows=attn.numel()//K\n    block=kernel._next_power_of_2(K)\n    nw=8 if block>=2048 else 4\n    kernel._scores_from_dropped_grad_kernel[(rows,)](grad, attn, mask, out, K, 1.0/(1.0-float(p)), bool(p>0), block, num_warps=nw)\n    return out\n\n\ndef run_grouped_first(grad_attn_output, attn_weights, attn_weights_dropped, value_states, dropout_mask, attention_dropout):\n    B=grad_attn_output.shape[0]; Q=grad_attn_output.shape[1]; K=value_states.shape[2]\n    go=grad_attn_output.transpose(1,2).to(torch.float32)\n    go5=go.reshape(B,8,10,Q,128)\n    val_t=value_states.to(torch.float32).transpose(-2,-1)[:, :, None, :, :]\n    gd=torch.matmul(go5, val_t).reshape(B,80,Q,K)\n    scores=score_kernel(gd, attn_weights, dropout_mask, attention_dropout)\n    gve=torch.matmul(attn_weights_dropped.to(torch.float32).transpose(-2,-1), go)\n    gv=gve.reshape(B,8,10,K,128).sum(dim=2).to(torch.bfloat16)\n    return scores, gv\n\n\ndef run_grouped_both(grad_attn_output, attn_weights, attn_weights_dropped, value_states, dropout_mask, attention_dropout):\n    B=grad_attn_output.shape[0]; Q=grad_attn_output.shape[1]; K=value_states.shape[2]\n    go=grad_attn_output.transpose(1,2).to(torch.float32)\n    go5=go.reshape(B,8,10,Q,128)\n    gd=torch.matmul(go5, value_states.to(torch.float32).transpose(-2,-1)[:, :, None, :, :]).reshape(B,80,Q,K)\n    scores=score_kernel(gd, attn_weights, dropout_mask, attention_dropout)\n    attn5=attn_weights_dropped.reshape(B,8,10,Q,K).to(torch.float32)\n    gve=torch.matmul(attn5.transpose(-2,-1), go5)\n    gv=gve.sum(dim=2).to(torch.bfloat16)\n    return scores, gv\n\nlines=open('workload.jsonl').read().splitlines()\nfor idx in [0,5,15]:\n    w=json.loads(lines[idx])\n    inputs=reference.get_inputs(w['axes'], torch.device('cuda:0'))\n    print('shape', idx, w['axes'])\n    for name,fn,iters in [('current', kernel.run, 8), ('grouped_first', run_grouped_first, 8), ('grouped_both', run_grouped_both, 8)]:\n        try:\n            ms=timed(fn, inputs, iters=iters, warm=2)\n            out=fn(**inputs); ref=reference.run(**inputs); sync()\n            ok=[]\n            for a,b in zip(out,ref):\n                d=(a.float()-b.float()).abs(); tol=w['tolerance']['max_atol']+w['tolerance']['max_rtol']*b.float().abs(); ok.append((d.max().item(), (d<=tol).float().mean().item()))\n            print(name, f'{ms:.3f} ms', ok)\n        except Exception as e:\n            print(name, 'ERR', type(e).__name__, e)\n        sync(); torch.cuda.empty_cache()\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
