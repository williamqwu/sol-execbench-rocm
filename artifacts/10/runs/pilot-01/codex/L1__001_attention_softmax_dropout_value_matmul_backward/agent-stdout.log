{"type":"item.started","item":{"id":"item_35","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport json, time\nimport torch\nimport reference, kernel\n\n\ndef sync(): torch.cuda.synchronize()\n\ndef timed(fn, inputs, iters=12, warm=3):\n    for _ in range(warm):\n        y=fn(**inputs); sync(); del y\n    t0=time.perf_counter()\n    for _ in range(iters):\n        y=fn(**inputs); sync(); del y\n    return (time.perf_counter()-t0)*1000/iters\n\ndef old_run(grad_attn_output, attn_weights, attn_weights_dropped, value_states, dropout_mask, attention_dropout):\n    B=grad_attn_output.shape[0]; K=value_states.shape[2]\n    go=grad_attn_output.transpose(1,2).to(torch.float32)\n    ve=value_states[:, :, None, :, :].expand(B,8,10,K,128).reshape(B,80,K,128)\n    gd=torch.matmul(go, ve.to(torch.float32).transpose(-2,-1))\n    scores=torch.empty_like(attn_weights)\n    block=kernel._next_power_of_2(K); nw=8 if block>=2048 else 4\n    rows=attn_weights.numel()//K\n    kernel._scores_from_dropped_grad_kernel[(rows,)](gd, attn_weights, dropout_mask, scores, K, 1.0/(1.0-float(attention_dropout)), bool(attention_dropout>0), block, num_warps=nw)\n    gve=torch.matmul(attn_weights_dropped.to(torch.float32).transpose(-2,-1), go)\n    gv=gve.reshape(B,8,10,K,128).sum(dim=2).to(torch.bfloat16)\n    return scores, gv\n\nlines=open('workload.jsonl').read().splitlines()\nfor idx in [3,6,13,0,9,10,8,1,4,12,14,7]:\n    w=json.loads(lines[idx])\n    inputs=reference.get_inputs(w['axes'], torch.device('cuda:0'))\n    it=8 if w['axes']['batch_size']>=16 or w['axes']['seq_len_kv']>=512 else 12\n    ms_new=timed(kernel.run, inputs, iters=it)\n    ms_old=timed(old_run, inputs, iters=it)\n    print(idx, w['axes'], 'new', f'{ms_new:.3f}', 'old', f'{ms_old:.3f}', 'speed', f'{ms_old/ms_new:.2f}x')\n    torch.cuda.empty_cache()\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
