{"type":"item.started","item":{"id":"item_26","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport json, time\nimport torch\nimport reference, kernel\n\ndef bench_stmt(fn, iters=20, warm=5):\n    torch.cuda.synchronize()\n    for _ in range(warm):\n        x=fn(); torch.cuda.synchronize(); del x\n    t0=time.perf_counter()\n    for _ in range(iters):\n        x=fn(); torch.cuda.synchronize(); del x\n    return (time.perf_counter()-t0)*1000/iters\n\nfor idx in [0,2,5,15]:\n    w=json.loads(open('workload.jsonl').read().splitlines()[idx])\n    inp=reference.get_inputs(w['axes'], torch.device('cuda:0'))\n    B=inp['grad_attn_output'].shape[0]; Q=inp['grad_attn_output'].shape[1]; K=inp['value_states'].shape[2]\n    print('\\\\nshape', idx, w['axes'])\n    go=inp['grad_attn_output'].transpose(1,2).to(torch.float32)\n    val_exp=inp['value_states'][:, :, None, :, :].expand(B,8,10,K,128).reshape(B,80,K,128).to(torch.float32)\n    gd=torch.matmul(go, val_exp.transpose(-2,-1))\n    def first_full():\n        go0=inp['grad_attn_output'].transpose(1,2).to(torch.float32)\n        ve=inp['value_states'][:, :, None, :, :].expand(B,8,10,K,128).reshape(B,80,K,128)\n        return torch.matmul(go0, ve.to(torch.float32).transpose(-2,-1))\n    def first_matmul_only():\n        return torch.matmul(go, val_exp.transpose(-2,-1))\n    def score_only():\n        out=torch.empty_like(inp['attn_weights'])\n        block=kernel._next_power_of_2(K); nw=8 if block>=2048 else 4\n        rows=inp['attn_weights'].numel()//K\n        kernel._scores_from_dropped_grad_kernel[(rows,)](gd, inp['attn_weights'], inp['dropout_mask'], out, K, 1.0/0.9, True, block, num_warps=nw)\n        return out\n    def second_full():\n        gve=torch.matmul(inp['attn_weights_dropped'].to(torch.float32).transpose(-2,-1), go)\n        return gve.reshape(B,8,10,K,128).sum(dim=2).to(torch.bfloat16)\n    for name,fn,it in [('first_full', first_full, 10), ('first_mm', first_matmul_only, 20), ('scor