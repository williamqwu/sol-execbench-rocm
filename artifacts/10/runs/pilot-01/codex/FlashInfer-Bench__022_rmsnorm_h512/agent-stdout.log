{"type":"item.started","item":{"id":"item_22","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport torch, triton\nimport triton.language as tl\n\n@triton.jit\ndef _kernel_m_axis1(xp, wp, yp, n:tl.constexpr, RB:tl.constexpr, BLOCK:tl.constexpr):\n    pid=tl.program_id(0)\n    rows=pid*RB+tl.arange(0,RB)\n    cols=tl.arange(0,BLOCK)\n    offs=rows[:, None]*BLOCK+cols[None, :]\n    mask=rows[:, None] < n\n    x=tl.load(xp+offs, mask=mask, other=0.0).to(tl.float32)\n    w=tl.load(wp+cols).to(tl.float32)\n    ss=tl.sum(x*x, axis=1)\n    inv=tl.rsqrt(ss*(1.0/512.0)+1.0e-6)\n    y=x*inv[:, None]*w[None, :]\n    tl.store(yp+offs, y, mask=mask)\n\n@triton.jit\ndef _kernel_m_axis0(xp, wp, yp, n:tl.constexpr, RB:tl.constexpr, BLOCK:tl.constexpr):\n    pid=tl.program_id(0)\n    rows=pid*RB+tl.arange(0,RB)\n    cols=tl.arange(0,BLOCK)\n    offs=rows[:, None]*BLOCK+cols[None, :]\n    mask=rows[:, None] < n\n    x=tl.load(xp+offs, mask=mask, other=0.0).to(tl.float32)\n    w=tl.load(wp+cols).to(tl.float32)\n    ss=tl.sum(x*x, axis=0)\n    inv=tl.rsqrt(ss*(1.0/512.0)+1.0e-6)\n    y=x*inv[:, None]*w[None, :]\n    tl.store(yp+offs, y, mask=mask)\n\ndef ref(x,w):\n    xf=x.float(); return (xf*torch.rsqrt((xf*xf).mean(-1,keepdim=True)+1e-6)*w.float()).bfloat16()\n\nx=torch.randn((7,512),device='cuda',dtype=torch.bfloat16)\nw=torch.randn((512,),device='cuda',dtype=torch.bfloat16)\nr=ref(x,w)\nfor name,k in [('axis1',_kernel_m_axis1),('axis0',_kernel_m_axis0)]:\n    y=torch.empty_like(x)\n    try:\n        k[(triton.cdiv(x.shape[0],2),)](x,w,y,x.shape[0],RB=2,BLOCK=512,num_warps=1)\n        torch.cuda.synchronize()\n        print(name, (y.float()-r.float()).abs().max().item(), torch.allclose(y,r,atol=0.01,rtol=0.01))\n    except Exception as e:\n        print(name,'ERR',type(e).__name__,e)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
