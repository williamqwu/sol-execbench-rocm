{"type":"item.completed","item":{"id":"item_43","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,120p' bench_rows.py\"","aggregated_output":"import torch\nimport triton\nimport triton.language as tl\n\n\n@triton.jit\ndef _kernel_m_axis0(xp, wp, yp, n: tl.constexpr, RB: tl.constexpr, BLOCK: tl.constexpr):\n    pid = tl.program_id(0)\n    rows = pid * RB + tl.arange(0, RB)\n    cols = tl.arange(0, BLOCK)\n    offs = rows[:, None] * BLOCK + cols[None, :]\n    mask = rows[:, None] < n\n    x = tl.load(xp + offs, mask=mask, other=0.0).to(tl.float32)\n    w = tl.load(wp + cols).to(tl.float32)\n    ss = tl.sum(x * x, axis=0)\n    inv = tl.rsqrt(ss * (1.0 / 512.0) + 1.0e-6)\n    y = x * inv[:, None] * w[None, :]\n    tl.store(yp + offs, y, mask=mask)\n\n\n@triton.jit\ndef _kernel_m_axis1(xp, wp, yp, n: tl.constexpr, RB: tl.constexpr, BLOCK: tl.constexpr):\n    pid = tl.program_id(0)\n    rows = pid * RB + tl.arange(0, RB)\n    cols = tl.arange(0, BLOCK)\n    offs = rows[:, None] * BLOCK + cols[None, :]\n    mask = rows[:, None] < n\n    x = tl.load(xp + offs, mask=mask, other=0.0).to(tl.float32)\n    w = tl.load(wp + cols).to(tl.float32)\n    ss = tl.sum(x * x, axis=1)\n    inv = tl.rsqrt(ss * (1.0 / 512.0) + 1.0e-6)\n    y = x * inv[:, None] * w[None, :]\n    tl.store(yp + offs, y, mask=mask)\n\n\ndef ref(x, w):\n    xf = x.float()\n    return (xf * torch.rsqrt((xf * xf).mean(-1, keepdim=True) + 1.0e-6) * w.float()).bfloat16()\n\n\ndef main():\n    x = torch.randn((7, 512), device=\"cuda\", dtype=torch.bfloat16)\n    w = torch.randn((512,), device=\"cuda\", dtype=torch.bfloat16)\n    r = ref(x, w)\n    for name, k in [(\"axis0\", _kernel_m_axis0), (\"axis1\", _kernel_m_axis1)]:\n        y = torch.empty_like(x)\n        try:\n            k[(triton.cdiv(x.shape[0], 2),)](\n                x, w, y, x.shape[0], RB=2, BLOCK=512, num_warps=1\n            )\n            torch.cuda.synchronize()\n            print(name, (y.float() - r.float()).abs().max().item())\n        except Exception as exc:\n            print(name, type(exc).__name__, exc)\n\n    batches = [1, 7, 32, 64, 539, 11949, 14521]\n    rbs = [1, 2, 4, 8, 16]\n    warps = [1, 2, 4]\n    for b in batches:\n        x = torch.randn((b, 512), device=\"cuda\", dtype=torch.bfloat16)\n        w = torch.randn((512,), device=\"cuda\", dtype=torch.bfloat16)\n        print(\"batch\", b)\n        for rb in rbs:\n            for nw in warps:\n                if rb * 512 > 8192:\n                    continue\n                def launch():\n                    y = torch.empty_like(x)\n                    _kernel_m_axis1[(triton.cdiv(b, rb),)](\n                        x, w, y, b, RB=rb, BLOCK=512, num_warps=nw\n                    )\n                    return y\n\n                try:\n                    for _ in range(10):\n                        launch()\n                    torch.cuda.synchronize()\n                    ms = triton.testing.do_bench(launch, warmup=50, rep=200)\n                    print(\"  rb\", rb, \"warps\", nw, \"ms\", float(ms))\n                except Exception as exc:\n                    print(\"  rb\", rb, \"warps\", nw, type(exc).__name__, exc)\n\n\nif __name__ == \"__main__\":\n    main()\n","exit_code":0,"status":"completed"}}
