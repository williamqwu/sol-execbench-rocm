{"type":"item.completed","item":{"id":"item_42","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,220p' kernel.py\"","aggregated_output":"import torch\nimport triton\nimport triton.language as tl\n\n\n@triton.jit\ndef _rmsnorm_h512_kernel(x_ptr, w_ptr, y_ptr, n_rows: tl.constexpr, BLOCK: tl.constexpr, ROWS: tl.constexpr):\n    pid = tl.program_id(0)\n    rows = pid * ROWS + tl.arange(0, ROWS)\n    cols = tl.arange(0, BLOCK)\n    offs = rows[:, None] * BLOCK + cols[None, :]\n    mask = rows[:, None] < n_rows\n\n    x = tl.load(x_ptr + offs, mask=mask, other=0.0).to(tl.float32)\n    w = tl.load(w_ptr + cols).to(tl.float32)\n    ss = tl.sum(x * x, axis=1)\n    inv_rms = tl.rsqrt(ss * (1.0 / 512.0) + 1.0e-6)\n    y = x * inv_rms[:, None] * w[None, :]\n    tl.store(y_ptr + offs, y, mask=mask)\n\n\n@torch.no_grad()\ndef run(hidden_states, weight):\n    batch_size = hidden_states.shape[0]\n    output = torch.empty_like(hidden_states)\n    _rmsnorm_h512_kernel[(triton.cdiv(batch_size, 4),)](\n        hidden_states,\n        weight,\n        output,\n        batch_size,\n        BLOCK=512,\n        ROWS=4,\n        num_warps=2,\n    )\n    return output\n","exit_code":0,"status":"completed"}}
