{"type":"item.started","item":{"id":"item_22","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport time\nimport torch\nimport kernel, reference\n\ndef bench(fn, x, gp, up, iters=20):\n    # warmup\n    for _ in range(5):\n        y = fn(x, gp, up)\n    torch.cuda.synchronize()\n    start = time.perf_counter()\n    for _ in range(iters):\n        y = fn(x, gp, up)\n    torch.cuda.synchronize()\n    return (time.perf_counter() - start) * 1000 / iters, y\n\nfor m in [128, 131, 256, 512]:\n    b=1; s=m; h=3072; n=24576\n    x=torch.randn((b,s,h),device='cuda',dtype=torch.bfloat16)\n    gp=torch.randn((n,h),device='cuda',dtype=torch.bfloat16)\n    up=torch.randn((n,h),device='cuda',dtype=torch.bfloat16)\n    y=kernel.run(x,gp,up)\n    yr=reference.run(x,gp,up)\n    torch.cuda.synchronize()\n    diff=(y.float()-yr.float()).abs()\n    rel=diff/(yr.float().abs()+1e-12)\n    matched=((diff <= 0.0052) | (rel <= 0.0078125)).float().mean().item()\n    t, _ = bench(kernel.run, x, gp, up, 30)\n    tref, _ = bench(reference.run, x, gp, up, 10)\n    print('m', m, 'max_abs', diff.max().item(), 'max_rel', rel.max().item(), 'matched', matched, 'kernel_ms', t, 'ref_ms', tref)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
