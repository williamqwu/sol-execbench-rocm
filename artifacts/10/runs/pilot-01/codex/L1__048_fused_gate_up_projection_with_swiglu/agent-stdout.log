{"type":"item.started","item":{"id":"item_26","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport time\nimport torch\nimport kernel\n\ndef bench(fn, iters=20):\n    for _ in range(5): fn()\n    torch.cuda.synchronize()\n    t0=time.perf_counter()\n    for _ in range(iters): fn()\n    torch.cuda.synchronize()\n    return (time.perf_counter()-t0)*1000/iters\n\nfor m in [128, 256, 512, 2048, 8192]:\n    h=3072; n=24576\n    x=torch.randn((1,m,h),device='cuda',dtype=torch.bfloat16)\n    gp=torch.randn((n,h),device='cuda',dtype=torch.bfloat16)\n    up=torch.randn((n,h),device='cuda',dtype=torch.bfloat16)\n    gate=torch.matmul(x,gp.t()); upo=torch.matmul(x,up.t()); out=torch.empty_like(gate)\n    torch.cuda.synchronize()\n    t_gate=bench(lambda: torch.matmul(x,gp.t()), 30 if m<=512 else 10)\n    t_2=bench(lambda: (torch.matmul(x,gp.t()), torch.matmul(x,up.t())), 30 if m<=512 else 10)\n    ne=out.numel()\n    t_epi=bench(lambda: kernel._swiglu_kernel[(kernel.triton.cdiv(ne,1024),)](gate, upo, out, ne, BLOCK_SIZE=1024, num_warps=4), 30 if m<=512 else 10)\n    t_all=bench(lambda: kernel.run(x,gp,up), 30 if m<=512 else 10)\n    print('m',m,'gate',t_gate,'two_gemm',t_2,'epi',t_epi,'all',t_all)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
