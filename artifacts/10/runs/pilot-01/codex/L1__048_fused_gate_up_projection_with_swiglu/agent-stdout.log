{"type":"item.started","item":{"id":"item_30","type":"command_execution","command":"/bin/bash -lc \"python3 - <<'PY'\nimport torch, math\n\ndef ref(g, u):\n    gf=g.float()\n    inner=math.sqrt(2/math.pi)*(gf+0.044715*gf.pow(3))\n    act=(0.5*gf*(1+torch.tanh(inner))).bfloat16()\n    return act*u\n\ndef approx(g,u):\n    gf=g.float()\n    inner=math.sqrt(2/math.pi)*(gf+0.044715*gf*gf*gf)\n    z=inner\n    z2=z*z\n    t=z*(27+z2)/(27+9*z2)\n    t=torch.clamp(t,-1,1)\n    act=(0.5*gf*(1+t)).bfloat16()\n    return act*u\n\ndef approx2(g,u):\n    gf=g.float()\n    # ReLU outside small interval, exact-ish polynomial inside?\n    inner=math.sqrt(2/math.pi)*(gf+0.044715*gf*gf*gf)\n    z=inner\n    z2=z*z\n    t=z*(135135 + z2*(17325 + z2*(378 + z2))) / (135135 + z2*(62370 + z2*(3150 + 28*z2)))\n    t=torch.clamp(t,-1,1)\n    act=(0.5*gf*(1+t)).bfloat16()\n    return act*u\n\nfor m in [128,512]:\n    h=3072;n=24576\n    x=torch.randn((1,m,h),device='cuda',dtype=torch.bfloat16)\n    gp=torch.randn((n,h),device='cuda',dtype=torch.bfloat16)\n    upw=torch.randn((n,h),device='cuda',dtype=torch.bfloat16)\n    g=torch.matmul(x,gp.t())\n    u=torch.matmul(x,upw.t())\n    yr=ref(g,u)\n    for name,fn in [('pade1',approx),('pade2',approx2)]:\n        y=fn(g,u)\n        torch.cuda.synchronize()\n        d=(y.float()-yr.float()).abs(); rel=d/(yr.float().abs()+1e-12)\n        matched=((d<=0.0052)|(rel<=0.0078125)).float().mean().item()\n        print('m',m,name,'max_abs',d.max().item(),'max_rel',rel.max().item(),'matched',matched)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
