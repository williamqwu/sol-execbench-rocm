{"type":"item.started","item":{"id":"item_54","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch, aiter, time\nE=448.0\n\ndef bench(fn, it=50, warm=10):\n    for _ in range(warm): fn()\n    torch.cuda.synchronize()\n    st=torch.cuda.Event(enable_timing=True); en=torch.cuda.Event(enable_timing=True)\n    st.record()\n    for _ in range(it): fn()\n    en.record(); torch.cuda.synchronize()\n    return st.elapsed_time(en)/it\nfor M in [128,1536,3840]:\n    K=1536; N=4608\n    x=torch.randn(M,K,device='cuda',dtype=torch.bfloat16)\n    w=torch.randn(N,K,device='cuda',dtype=torch.bfloat16)\n    bias=torch.randn(N,device='cuda',dtype=torch.bfloat16)\n    def act_torch():\n        xf=x.float(); sx=(xf.abs().reshape(M,12,128).amax(2)/E).clamp(min=1e-12); qx=torch.clamp(xf.reshape(M,12,128)/sx[:,:,None],-E,E).reshape(M,K).to(torch.float8_e4m3fn); return qx,sx\n    qx_buf=torch.empty((M,K),device='cuda',dtype=torch.float8_e4m3fn); sx_buf=torch.empty((M,12),device='cuda',dtype=torch.float32)\n    def act_aiter():\n        aiter.dynamic_per_group_scaled_quant(qx_buf,x,sx_buf,128,False); return qx_buf,sx_buf\n    def weight_torch():\n        wf=w.T.float(); sw=(wf.reshape(12,128,36,128).abs().amax(3).amax(1)/E).clamp(min=1e-12); qw=torch.clamp(wf.reshape(12,128,36,128)/sw[:,None,:,None],-E,E).reshape(K,N).T.to(torch.float8_e4m3fn).contiguous(); return qw,sw\n    qx,sx=act_aiter(); qw,sw=weight_torch(); swt=sw.T.contiguous()\n    def gemm():\n        return aiter.gemm_a8w8_blockscale(qx,qw,sx,swt,torch.bfloat16)\n    y=gemm()\n    def add_split():\n        qkv=y+bias; qkv=qkv.view(M,3,16,96); return qkv[:,0].contiguous(), qkv[:,1].contiguous(), qkv[:,2].contiguous()\n    torch.cuda.synchronize()\n    print('M',M)\n    print(' act_torch',bench(act_torch), 'act_aiter', bench(act_aiter))\n    print(' weight_torch',bench(weight_torch,20,5))\n    print(' gemm',bench(gemm,50,10))\n    print(' add_split',bench(add_split,50,10))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
