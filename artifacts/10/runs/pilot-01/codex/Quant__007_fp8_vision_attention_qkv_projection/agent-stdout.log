{"type":"item.started","item":{"id":"item_78","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch, kernel\nE=448.0\n\ndef ref_run(x,w,b):\n    M=x.shape[0]\n    xf=x.float(); sx=(xf.abs().reshape(M,12,128).amax(2)/E).clamp(min=1e-12)\n    qx=torch.clamp(xf.reshape(M,12,128)/sx[:,:,None],-E,E).reshape(M,1536).to(torch.float8_e4m3fn)\n    wf=w.T.float(); sw=(wf.reshape(12,128,36,128).abs().amax(3).amax(1)/E).clamp(min=1e-12)\n    qw=torch.clamp(wf.reshape(12,128,36,128)/sw[:,None,:,None],-E,E).reshape(1536,4608).T.to(torch.float8_e4m3fn)\n    a=(qx.float().reshape(M,12,128)*sx[:,:,None]).reshape(M,1536)\n    bf=(qw.float().T.reshape(12,128,36,128)*sw[:,None,:,None]).reshape(1536,4608).T\n    qkv=(a@bf.T+b).bfloat16().view(M,3,16,96)\n    return qkv[:,0].contiguous(),qkv[:,1].contiguous(),qkv[:,2].contiguous()\nfor M in [128,384,1536,3840]:\n    x=torch.randn(M,1536,device='cuda',dtype=torch.bfloat16)\n    w=torch.randn(4608,1536,device='cuda',dtype=torch.bfloat16)\n    b=torch.randn(4608,device='cuda',dtype=torch.bfloat16)\n    y=kernel.run(x,w,b); r=ref_run(x,w,b); torch.cuda.synchronize()\n    print('M',M)\n    allrat=[]\n    for yi,ri in zip(y,r):\n        ratio=torch.isclose(yi,ri,atol=0.0111,rtol=0.0078125).float().mean().item()\n        allrat.append(ratio)\n        print((yi-ri).abs().max().item(), ratio)\n    print('min',min(allrat))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
