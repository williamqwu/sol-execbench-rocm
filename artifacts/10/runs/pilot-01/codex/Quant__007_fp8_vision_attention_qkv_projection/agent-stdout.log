{"type":"item.started","item":{"id":"item_71","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch, aiter, triton\nimport kernel\nE=448.0\n\ndef bench(fn,it=80,warm=20):\n    for _ in range(warm): fn()\n    torch.cuda.synchronize(); st=torch.cuda.Event(True); en=torch.cuda.Event(True); st.record()\n    for _ in range(it): fn()\n    en.record(); torch.cuda.synchronize(); return st.elapsed_time(en)/it\nfor M in [128,1536,3840]:\n    x=torch.randn(M,1536,device='cuda',dtype=torch.bfloat16); w=torch.randn(4608,1536,device='cuda',dtype=torch.bfloat16); b=torch.randn(4608,device='cuda',dtype=torch.bfloat16)\n    qx=torch.empty_like(x,dtype=torch.float8_e4m3fn); sx=torch.empty((M,12),device='cuda',dtype=torch.float32)\n    def act(): aiter.dynamic_per_group_scaled_quant(qx,x,sx,128,False)\n    def weight():\n        wf=w.float(); sw=(wf.reshape(36,128,12,128).abs().amax(3).amax(1)/E).clamp(min=1e-12); qw=torch.clamp(wf.reshape(36,128,12,128)/sw[:,None,:,None],-E,E).reshape(4608,1536).to(torch.float8_e4m3fn); return qw,sw\n    qw,sw=weight(); act(); y=aiter.gemm_a8w8_blockscale(qx,qw,sx,sw,torch.bfloat16)\n    q=torch.empty((M,16,96),device='cuda',dtype=torch.bfloat16); k=torch.empty_like(q); v=torch.empty_like(q); total=M*4608\n    def split1024(): kernel._bias_split_kernel[(triton.cdiv(total,1024),)](y,b,q,k,v,total,BLOCK=1024,num_warps=4)\n    def split256(): kernel._bias_split_kernel[(triton.cdiv(total,256),)](y,b,q,k,v,total,BLOCK=256,num_warps=4)\n    def split2048(): kernel._bias_split_kernel[(triton.cdiv(total,2048),)](y,b,q,k,v,total,BLOCK=2048,num_warps=8)\n    def gemm(): aiter.gemm_a8w8_blockscale(qx,qw,sx,sw,torch.bfloat16)\n    print('M',M,'act',bench(act),'weight',bench(weight,it=50,warm=10),'gemm',bench(gemm,it=80,warm=20),'split256',bench(split256),'split1024',bench(split1024),'split2048',bench(split2048))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
