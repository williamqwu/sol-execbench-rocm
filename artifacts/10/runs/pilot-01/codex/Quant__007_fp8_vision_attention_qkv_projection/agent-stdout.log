{"type":"item.started","item":{"id":"item_85","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch, kernel\nE=448.0\n\ndef ref_run(x,w,b):\n    M=x.shape[0]\n    xf=x.float(); sx=(xf.abs().reshape(M,12,128).amax(2)/E).clamp(min=1e-12)\n    qx=torch.clamp(xf.reshape(M,12,128)/sx[:,:,None],-E,E).reshape(M,1536).to(torch.float8_e4m3fn)\n    wf=w.T.float(); sw=(wf.reshape(12,128,36,128).abs().amax(3).amax(1)/E).clamp(min=1e-12)\n    qw=torch.clamp(wf.reshape(12,128,36,128)/sw[:,None,:,None],-E,E).reshape(1536,4608).T.to(torch.float8_e4m3fn)\n    a=(qx.float().reshape(M,12,128)*sx[:,:,None]).reshape(M,1536)\n    bf=(qw.float().T.reshape(12,128,36,128)*sw[:,None,:,None]).reshape(1536,4608).T\n    qkv=(a@bf.T+b).bfloat16().view(M,3,16,96)\n    return qkv[:,0].contiguous(),qkv[:,1].contiguous(),qkv[:,2].contiguous()\nfor M in [128,768,1536,3840]:\n    x=torch.randn(M,1536,device='cuda',dtype=torch.bfloat16); w=torch.randn(4608,1536,device='cuda',dtype=torch.bfloat16); b=torch.randn(4608,device='cuda',dtype=torch.bfloat16)\n    y=kernel.run(x,w,b); r=ref_run(x,w,b); torch.cuda.synchronize()\n    ratios=[torch.isclose(yi,ri,atol=0.0111,rtol=0.0078125).float().mean().item() for yi,ri in zip(y,r)]\n    maxabs=max((yi-ri).abs().max().item() for yi,ri in zip(y,r))\n    print('M',M,'maxabs',maxabs,'minratio',min(ratios))\n\ndef bench(fn,it=40,warm=10):\n    for _ in range(warm): fn()\n    torch.cuda.synchronize(); st=torch.cuda.Event(True); en=torch.cuda.Event(True); st.record()\n    for _ in range(it): fn()\n    en.record(); torch.cuda.synchronize(); return st.elapsed_time(en)/it\nfor M in [128,1536,3840]:\n    x=torch.randn(M,1536,device='cuda',dtype=torch.bfloat16); w=torch.randn(4608,1536,device='cuda',dtype=torch.bfloat16); b=torch.randn(4608,device='cuda',dtype=torch.bfloat16)\n    kernel.run(x,w,b); torch.cuda.synchronize()\n    print('bench',M,bench(lambda: kernel.run(x,w,b), it=30 if M>=1536 else 50, warm=5))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
