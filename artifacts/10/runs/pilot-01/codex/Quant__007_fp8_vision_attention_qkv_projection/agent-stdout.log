{"type":"item.started","item":{"id":"item_43","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch, aiter\nM,K,N=128,1536,4608\nx=torch.randn(M,K,device='cuda',dtype=torch.bfloat16)\nw=torch.randn(N,K,device='cuda',dtype=torch.bfloat16)\nbias=torch.randn(N,device='cuda',dtype=torch.bfloat16)\nE=448.0\nxf=x.float(); sx=(xf.abs().reshape(M,12,128).amax(2)/E).clamp(min=1e-12)\nqx=torch.clamp(xf.reshape(M,12,128)/sx[:,:,None],-E,E).reshape(M,K).to(torch.float8_e4m3fn)\nwf=w.T.float(); sw=(wf.reshape(12,128,36,128).abs().amax(3).amax(1)/E).clamp(min=1e-12)\nqw=torch.clamp(wf.reshape(12,128,36,128)/sw[:,None,:,None],-E,E).reshape(K,N).T.to(torch.float8_e4m3fn).contiguous()\na=(qx.float().reshape(M,12,128)*sx[:,:,None]).reshape(M,K)\nbf=(qw.float().T.reshape(12,128,36,128)*sw[:,None,:,None]).reshape(K,N).T\nref=(a@bf.T+bias).bfloat16()\nscales=[('sx',sx),('sx_outer',sx.T.contiguous().T),('sxT',sx.T.contiguous())]\nwscales=[('sw',sw),('swT',sw.T.contiguous()),('sw_exp',sw.repeat_interleave(128,1).contiguous()),('sw_exp_outer',sw.repeat_interleave(128,1).T.contiguous().T)]\nWs=[('qw',qw),('qwT',qw.T),('Bcont',qw.T.contiguous())]\nfor Wn,W in Ws:\n  for sn,s in scales:\n    for wn,ws in wscales:\n      try:\n        y=aiter.gemm_a8w8_blockscale(qx,W,s,ws,torch.bfloat16)\n        torch.cuda.synchronize()\n        if y.shape \"'!= ref.shape:\n          print(Wn,sn,wn,'\"'OK shape',y.shape)\n        else:\n          yy=(y+bias).bfloat16()\n          print(Wn,sn,wn,'OK', (yy-ref).abs().max().item(), torch.isclose(yy,ref,atol=0.0111,rtol=0.0078125).float().mean().item())\n      except Exception as e:\n        msg=str(e).split('\\\\n')[0]\n        # print brief for promising combos only?\n        if Wn=='qw' and sn.startswith('sx') and wn in ['sw','swT']:\n          print(Wn,sn,wn,'ERR',msg[:180])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
