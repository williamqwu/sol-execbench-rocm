{"type":"item.started","item":{"id":"item_24","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch\nM,K,N=128,1536,4608\nx=torch.randn(M,K,device='cuda',dtype=torch.bfloat16)\nw=torch.randn(N,K,device='cuda',dtype=torch.bfloat16)\nb=torch.randn(N,device='cuda',dtype=torch.bfloat16)\nE=448.0\nxf=x.float()\nsx=(xf.abs().reshape(M,12,128).amax(2)/E).clamp(min=1e-12)\nqx=torch.clamp((xf.reshape(M,12,128)/sx[:,:,None]),-E,E).reshape(M,K).to(torch.float8_e4m3fn)\nwf=w.T.float()\nsw=(wf.reshape(12,128,36,128).abs().amax(3).amax(1)/E).clamp(min=1e-12)\nqw=torch.clamp(wf.reshape(12,128,36,128)/sw[:,None,:,None],-E,E).reshape(K,N).T.to(torch.float8_e4m3fn)\na=(qx.float().reshape(M,12,128)*sx[:,:,None]).reshape(M,K)\nbf=(qw.float().T.reshape(12,128,36,128)*sw[:,None,:,None]).reshape(K,N).T\nref=(a@bf.T+b).bfloat16()\nprint('qx',qx.shape,qx.stride(),qx.dtype,'qw',qw.shape,qw.stride(),qw.dtype,'qwT',qw.T.shape,qw.T.stride())\nargs=[]\n# Try known signatures\ncalls=[]\ncalls.append(('pos_scale_no_names', lambda: torch._scaled_mm(qx, qw.T, sx, sw.T, out_dtype=torch.bfloat16)))\ncalls.append(('pos_scale_bias', lambda: torch._scaled_mm(qx, qw.T, sx, sw.T, bias=b, out_dtype=torch.bfloat16)))\ncalls.append(('scale_kw', lambda: torch._scaled_mm(qx, qw.T, scale_a=sx, scale_b=sw.T, bias=b, out_dtype=torch.bfloat16)))\ncalls.append(('scale_result', lambda: torch._scaled_mm(qx, qw.T, sx, sw.T, None, b, torch.bfloat16, True)))\ncalls.append(('flat_scales', lambda: torch._scaled_mm(qx, qw.T, sx.reshape(M,12), sw.T.reshape(36,12), bias=b, out_dtype=torch.bfloat16, use_fast_accum=True)))\n# per tensor dummy\ncalls.append(('ones', lambda: torch._scaled_mm(qx, qw.T, torch.ones((),device='cuda'), torch.ones((),device='cuda'), bias=b, out_dtype=torch.bfloat16)))\nfor name,fn in calls:\n    try:\n        y=fn()\n        if isinstance(y, tuple): y=y[0]\n        torch.cuda.synchronize()\n        print(name,'OK',y.shape,y.dtype,'max', (y-ref).abs().max().item(), 'ratio',