{"type":"item.started","item":{"id":"item_76","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch, triton, kernel\nE=448.0\nN,K=4608,1536\nw=torch.randn(N,K,device='cuda',dtype=torch.bfloat16)\n# torch direct\nwf=w.float(); sw=(wf.reshape(36,128,12,128).abs().amax(3).amax(1)/E).clamp(min=1e-12); qw=torch.clamp(wf.reshape(36,128,12,128)/sw[:,None,:,None],-E,E).reshape(N,K).to(torch.float8_e4m3fn)\n# triton\nswt=torch.empty((36,12),device='cuda',dtype=torch.float32); qwt=torch.empty_like(w,dtype=torch.float8_e4m3fn)\nkernel._weight_scale_kernel[(36,12)](w,swt,CHUNK_N=16,BLOCK_K=128,num_warps=8)\nkernel._weight_quant_kernel[(6912,)](w,swt,qwt,N*K,BLOCK=1024,num_warps=4)\ntorch.cuda.synchronize()\nprint('scale max diff', (sw-swt).abs().max().item(), 'q eq ratio', (qw==qwt).float().mean().item(), 'max q float diff',(qw.float()-qwt.float()).abs().max().item())\nidx=(qw\"'!=qwt).nonzero()[:5]\nprint('\"'mismatches',idx)\nif idx.numel():\n    n=idx[:,0]; k=idx[:,1]\n    print(w[n,k], sw[n//128,k//128], swt[n//128,k//128], qw[n,k].float(), qwt[n,k].float())\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
