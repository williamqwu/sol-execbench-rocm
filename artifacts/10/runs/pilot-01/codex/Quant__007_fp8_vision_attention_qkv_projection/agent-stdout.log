{"type":"item.completed","item":{"id":"item_64","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,180p' kernel.py\"","aggregated_output":"import torch\nimport aiter\nimport triton\nimport triton.language as tl\n\n\nE4M3_MAX = 448.0\n\n\n@triton.jit\ndef _bias_split_kernel(qkv, bias, q_out, k_out, v_out, total:tl.constexpr, BLOCK:tl.constexpr):\n    offs = tl.program_id(0) * BLOCK + tl.arange(0, BLOCK)\n    mask = offs < total\n    col = offs % 4608\n    row = offs // 4608\n    val = tl.load(qkv + offs, mask=mask, other=0.0).to(tl.float32)\n    b = tl.load(bias + col, mask=mask, other=0.0).to(tl.float32)\n    val = val + b\n\n    q_mask = mask & (col < 1536)\n    k_mask = mask & ((col >= 1536) & (col < 3072))\n    v_mask = mask & (col >= 3072)\n    q_col = col\n    k_col = col - 1536\n    v_col = col - 3072\n    tl.store(q_out + row * 1536 + q_col, val, mask=q_mask)\n    tl.store(k_out + row * 1536 + k_col, val, mask=k_mask)\n    tl.store(v_out + row * 1536 + v_col, val, mask=v_mask)\n\n\n@torch.no_grad()\ndef run(\n    hidden_states: torch.Tensor,\n    qkv_weight: torch.Tensor,\n    qkv_bias: torch.Tensor,\n):\n    seq_len = hidden_states.shape[0]\n\n    qx = torch.empty_like(hidden_states, dtype=torch.float8_e4m3fn)\n    scale_x = torch.empty((seq_len, 12), device=hidden_states.device, dtype=torch.float32)\n    aiter.dynamic_per_group_scaled_quant(qx, hidden_states, scale_x, 128, False)\n\n    w_f32 = qkv_weight.to(torch.float32)\n    weight_scales = w_f32.reshape(36, 128, 12, 128).abs().amax(dim=3).amax(dim=1)\n    weight_scales = torch.clamp(weight_scales / E4M3_MAX, min=1.0e-12)\n    qw = torch.clamp(\n        w_f32.reshape(36, 128, 12, 128) / weight_scales[:, None, :, None],\n        min=-E4M3_MAX,\n        max=E4M3_MAX,\n    ).reshape(4608, 1536).to(torch.float8_e4m3fn)\n\n    qkv = aiter.gemm_a8w8_blockscale(\n        qx, qw, scale_x, weight_scales, torch.bfloat16\n    )\n    query_states = torch.empty((seq_len, 16, 96), device=hidden_states.device, dtype=torch.bfloat16)\n    key_states = torch.empty_like(query_states)\n    value_states = torch.empty_like(query_states)\n    total = seq_len * 4608\n    _bias_split_kernel[(triton.cdiv(total, 1024),)](\n        qkv, qkv_bias, query_states, key_states, value_states, total, BLOCK=1024, num_warps=4\n    )\n    return query_states, key_states, value_states\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_65","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport torch\nimport kernel\nE=448.0\n\ndef ref_run(x,w,b):\n    M=x.shape[0]\n    xf=x.float(); sx=(xf.abs().reshape(M,12,128).amax(2)/E).clamp(min=1e-12)\n    qx=torch.clamp(xf.reshape(M,12,128)/sx[:,:,None],-E,E).reshape(M,1536).to(torch.float8_e4m3fn)\n    wf=w.T.float(); sw=(wf.reshape(12,128,36,128).abs().amax(3).amax(1)/E).clamp(min=1e-12)\n    qw=torch.clamp(wf.reshape(12,128,36,128)/sw[:,None,:,None],-E,E).reshape(1536,4608).T.to(torch.float8_e4m3fn)\n    a=(qx.float().reshape(M,12,128)*sx[:,:,None]).reshape(M,1536)\n    bf=(qw.float().T.reshape(12,128,36,128)*sw[:,None,:,None]).reshape(1536,4608).T\n    qkv=(a@bf.T+b).bfloat16().view(M,3,16,96)\n    return qkv[:,0].contiguous(),qkv[:,1].contiguous(),qkv[:,2].contiguous()\nfor M in [128,384,1536]:\n    x=torch.randn(M,1536,device='cuda',dtype=torch.bfloat16)\n    w=torch.randn(4608,1536,device='cuda',dtype=torch.bfloat16)\n    b=torch.randn(4608,device='cuda',dtype=torch.bfloat16)\n    y=kernel.run(x,w,b); r=ref_run(x,w,b); torch.cuda.synchronize()\n    print('M',M)\n    for yi,ri in zip(y,r):\n        print((yi-ri).abs().max().item(), torch.isclose(yi,ri,atol=0.0111,rtol=0.0078125).float().mean().item())\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
