#!/usr/bin/env bash
# SPDX-License-Identifier: Apache-2.0
#
# Run a command inside the pinned measurement container.
#
#   env/solb python scripts/roofline_probe.py --gpu 0 --out ...
#   env/solb bash
#
# Keeps one long-lived container ("solbench") alive so repeated calls are cheap.
# Scratch lives at the SAME absolute path inside and outside the container, so
# paths in artifacts and logs mean the same thing in both places.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
IMAGE="solbench:rocm7.2-torch2.9.1"
SCRATCH="/var/tmp/solbench"

# The container name is keyed to the tree it mounts. A fixed name looks
# harmless until two checkouts exist on one node -- a working clone and a
# read-only reference worktree, say. Whichever ran `env/solb` first wins, and
# every later call from the OTHER tree silently executes against the first
# one's /work: the dataset materializes into the wrong checkout, artifacts are
# written where nobody looks for them, and the only visible symptom is that
# `git -C /work` fails, because a linked worktree's gitdir points outside the
# mount. That is how a session 4 run wrote its node report into a reference
# worktree while reporting success. Keyed by path, the two trees simply get
# two containers.
NAME="solbench-$(printf '%s' "${ROOT}" | md5sum | cut -c1-8)"

# SOLB_AGENT=1 adds what the task-10 agent harness needs and nothing else: the
# `claude` and `codex` binaries from the host, and the credentials to reach a
# model gateway. It gets its OWN container, under a "-agent" suffix, for two
# reasons. Bind mounts are fixed when a container is created, so a flag alone
# could not retrofit them onto the long-lived measurement container -- it would
# have to destroy and recreate it, and that container routinely has a
# multi-hour sweep inside it. And a measurement container has no business
# holding an API key: every sweep that does not run agents stays exactly as it
# was, with no credential in its environment.
AGENT_MOUNTS=()
if [ "${SOLB_AGENT:-0}" = "1" ]; then
  NAME="${NAME}-agent"
  # The binary is reached through its real path, not the ~/.local/bin symlink,
  # because that symlink points into ~/.local/share and a mount of the link
  # alone would dangle inside the container.
  for d in "${HOME}/.local/share/claude" "${HOME}/.local/bin" "${HOME}/.codex"; do
    [ -e "${d}" ] && AGENT_MOUNTS+=(-v "${d}:${d}:ro")
  done
  AGENT_MOUNTS+=(-e "PATH=/opt/venv/bin:${HOME}/.local/bin:/opt/rocm/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin")

  # How the agent container reaches a model gateway is a property of the NODE,
  # not of this benchmark, so it is not written down here. Reachability differs
  # per site -- direct egress on one node, a forward proxy on another -- and a
  # value committed here would be wrong everywhere except where it was written,
  # while looking authoritative.
  #
  # Instead: if ${SCRATCH}/agent-env.sh exists it is sourced, and may append
  # docker arguments to AGENT_MOUNTS. That file is under /var/tmp, outside the
  # tree, and is deliberately not tracked.
  #
  #   # /var/tmp/solbench/agent-env.sh   (example, node-specific)
  #   AGENT_MOUNTS+=(--network host)
  #   for k in http_proxy https_proxy no_proxy HTTP_PROXY HTTPS_PROXY NO_PROXY; do
  #     [ -n "${!k:-}" ] && AGENT_MOUNTS+=(-e "${k}")
  #   done
  #
  # If the gateway is unreachable the CLI reports "Can't reach the API server
  # ... (ENOTFOUND)", which reads like a credential problem and is not one.
  # shellcheck source=/dev/null
  [ -f "${SCRATCH}/agent-env.sh" ] && . "${SCRATCH}/agent-env.sh"
fi

if ! docker image inspect "${IMAGE}" >/dev/null 2>&1; then
  echo "building ${IMAGE} ..." >&2
  docker build -q -t "${IMAGE}" "${ROOT}/env" >&2
fi

# A long-lived container keeps running against the image it was CREATED from,
# so rebuilding the image has no effect on it. That failure is silent and
# expensive: adding SOLAR to the Dockerfile, rebuilding, and re-running a sweep
# produced 3,297 "ModuleNotFoundError: No module named 'solar'" results that
# looked like 235 genuinely failing problems. Compare image IDs and recreate
# when they differ.
#
# SOLB_KEEP_CONTAINER=1 suppresses the recreation, for the case where a long
# sweep is already running inside the current container and must not be killed.
# That case is not hypothetical: adding this check and then running any solb
# command killed a 155-problem-deep sweep on the spot. The sweeps are resumable
# by construction so nothing was lost, but the surprise is worth one guard --
# so a container with running work is reported rather than removed.
WANT_IMAGE_ID="$(docker image inspect -f '{{.Id}}' "${IMAGE}" 2>/dev/null || true)"
HAVE_IMAGE_ID="$(docker inspect -f '{{.Image}}' "${NAME}" 2>/dev/null || true)"
if [ -n "${HAVE_IMAGE_ID}" ] && [ "${HAVE_IMAGE_ID}" != "${WANT_IMAGE_ID}" ]; then
  # The bracket classes are load-bearing. `pgrep -f` matches against full
  # command lines, and `|| true` makes this a compound command, so bash does
  # NOT exec pgrep in place -- it stays alive with the pattern in its own
  # cmdline and pgrep counts it. Written plainly, BUSY is always >= 1 and this
  # guard never fires, which silently re-enables the stale-image failure the
  # comment above describes. `[s]hard_sweep` matches "shard_sweep" but not the
  # literal "[s]hard_sweep" sitting in bash's argv.
  BUSY="$(docker exec "${NAME}" bash -lc \
      'pgrep -fc "[s]hard_sweep|[r]unners/|[s]ol_bounds" 2>/dev/null || true' 2>/dev/null || echo 0)"
  if [ "${SOLB_KEEP_CONTAINER:-0}" = "1" ] || [ "${BUSY:-0}" -gt 0 ]; then
    echo "WARNING: container '${NAME}' predates the current ${IMAGE}, but" >&2
    echo "         ${BUSY} sweep process(es) are running inside it, so it was" >&2
    echo "         NOT recreated. Anything needing the new image must wait, or" >&2
    echo "         run in a throwaway container. Set SOLB_KEEP_CONTAINER=0 and" >&2
    echo "         stop the sweep to force it." >&2
  else
    echo "container '${NAME}' was built from an older ${IMAGE}; recreating." >&2
    docker rm -f "${NAME}" >/dev/null 2>&1 || true
  fi
fi

if ! docker ps --format '{{.Names}}' | grep -qx "${NAME}"; then
  docker rm -f "${NAME}" >/dev/null 2>&1 || true
  mkdir -p "${SCRATCH}"
  # Run as the invoking user, not root: the repo is bind-mounted from an NFS
  # home, and root-owned artifacts/ would lock the host user out of the very
  # directories the sweeps write to. HOME must point somewhere writable or
  # torch/MIOpen cache writes fail.
  #
  # The groups must be the HOST's numeric GIDs (video=44, render=110 here).
  # /dev/kfd keeps its host GID inside the container, while `--group-add render`
  # resolves against the *container's* /etc/group (render=991) and grants
  # nothing. The failure is confusing: torch.cuda.device_count() still returns
  # 8 because enumeration works, but any real HIP context raises
  # "No HIP GPUs are available".
  mkdir -p "${SCRATCH}/home"

  # Running with --user leaves the UID absent from the container's
  # /etc/passwd, and torch.compile calls getpass.getuser() during import of
  # torch._inductor -- which raises `KeyError: getpwuid(): uid not found`.
  # That would break every submission using torch.compile, not just tests.
  # Both a passwd entry and the env vars, because getpass consults the env
  # first but other tools go straight to pwd.
  PASSWD="${SCRATCH}/passwd"
  { getent passwd; printf '%s:x:%s:%s::%s:/bin/bash\n' \
      "$(id -un)" "$(id -u)" "$(id -g)" "${SCRATCH}/home"; } \
    | awk '!seen[$0]++' > "${PASSWD}"
  # docker refuses `--hostname` together with `--network host` ("conflicting
  # options: hostname and the network mode"), and a node's agent-env.sh may well
  # ask for host networking. Under host networking the container already reports
  # the host's name, so dropping the flag changes nothing that artifacts record.
  # A LINKED WORKTREE's .git is a FILE pointing at a gitdir elsewhere -- for
  # `git worktree add /var/tmp/... ` that target is under the user's $HOME,
  # which is not mounted here. Inside the container `git rev-parse HEAD` then
  # fails with "not a git repository", and scripts/provenance.py's git_sha()
  # wraps that in a bare `except` and returns None. The result is not an error:
  # it is `"git_sha": null` stamped on every artifact, exit 0, no warning
  # anywhere. A whole sweep's worth of artifacts becomes unusable for scoring
  # (prime directive 5) and nothing says so until someone reads a gate failure
  # days later. Mount the git COMMON dir at its own absolute path so the
  # gitdir file resolves; read-only, because provenance only reads.
  GITDIR_MOUNT=()
  if [ -f "${ROOT}/.git" ]; then
    _common="$(git -C "${ROOT}" rev-parse --git-common-dir 2>/dev/null || true)"
    case "${_common}" in
      /*) [ -d "${_common}" ] && GITDIR_MOUNT+=(-v "${_common}:${_common}:ro") ;;
    esac
  fi

  HOSTNAME_ARG=(--hostname "$(hostname)")
  case " ${AGENT_MOUNTS[*]+${AGENT_MOUNTS[*]}} " in
    *" --network host "*|*" --net host "*) HOSTNAME_ARG=() ;;
  esac
  docker run -d --name "${NAME}" \
    "${HOSTNAME_ARG[@]+"${HOSTNAME_ARG[@]}"}" \
    --user "$(id -u):$(id -g)" \
    --group-add "$(getent group video  | cut -d: -f3)" \
    --group-add "$(getent group render | cut -d: -f3)" \
    --device=/dev/kfd --device=/dev/dri \
    --ipc=host --shm-size 32G \
    --security-opt seccomp=unconfined --cap-add=SYS_PTRACE \
    -v "${ROOT}:/work" \
    -v "${SCRATCH}:${SCRATCH}" \
    -v "${PASSWD}:/etc/passwd:ro" \
    "${GITDIR_MOUNT[@]+"${GITDIR_MOUNT[@]}"}" \
    -e "HOME=${SCRATCH}/home" \
    -e "USER=$(id -un)" \
    -e "LOGNAME=$(id -un)" \
    -e "HF_HOME=${SCRATCH}/hf-cache" \
    -e "FLASHINFER_TRACE_DIR=/work" \
    -e "AITER_JIT_DIR=${SCRATCH}/aiter-jit" \
    -e "AITER_USE_SYSTEM_TRITON=1" \
    -e "CK_DIR=${SCRATCH}/ck-include/ck" \
    -e "VIRTUAL_ENV=/opt/venv" \
    -e "UV_PROJECT_ENVIRONMENT=/opt/venv" \
    -e "UV_NO_SYNC=1" \
    -e "SOLEXBENCH_SCRATCH=${SCRATCH}" \
    `# AITER_JIT_DIR / AITER_USE_SYSTEM_TRITON: both are required for` \
    `# 'import aiter' to complete AT ALL in this image, and neither is` \
    `# optional taste.` \
    `#` \
    `# AITER_JIT_DIR. aiter JIT-builds module_aiter_core on first import and` \
    `# then imports it as 'aiter.jit.module_aiter_core'. get_user_jit_dir()` \
    `# writes beside the package when that is writable; /opt/aiter is` \
    `# root-owned and the container runs as the invoking user, so it takes` \
    `# its fallback branch and copies the jit tree to $HOME/.aiter/jit --` \
    `# which it never adds to sys.path OR to aiter.jit.__path__. The .so is` \
    `# built, the build reports success, and the very next line fails with` \
    `# "No module named 'aiter.jit.module_aiter_core'". Only the` \
    `# AITER_JIT_DIR branch does the sys.path.insert that makes the built` \
    `# module importable. Under the scratch mount, so the JIT cache is` \
    `# persistent and shared, same as HF_HOME above.` \
    `#` \
    `# AITER_USE_SYSTEM_TRITON. aiter at the pinned SHA imports its gluon` \
    `# kernels from aiter/__init__.py and hard-raises "aiter gluon kernels` \
    `# require triton>=3.6.0" against this stack's pinned 3.5.1+rocm7.2.0.` \
    `# The flag is aiter's own escape hatch: it downgrades that raise to a` \
    `# warning. It is set here rather than the pinned triton being moved --` \
    `# prime directive 6, and the Dockerfile already refuses aiter's` \
    `# installer swapping triton out for the same reason. The cost is stated` \
    `# rather than hidden: any aiter op that dispatches into a gluon kernel` \
    `# is running against a Triton older than aiter was written for.` \
    "${AGENT_MOUNTS[@]+"${AGENT_MOUNTS[@]}"}" \
    -w /work \
    "${IMAGE}" sleep infinity >/dev/null
fi

# A WRITABLE copy of the Composable Kernel headers, for the `ck` and `ck_tile`
# languages.
#
# torch's ROCm `load()` runs hipify over every directory in
# extra_include_paths and writes the result back INTO that directory. The
# default CK_DIR is /opt/rocm/include/ck, which is root-owned, so an
# unprivileged ck submission dies with
#
#   PermissionError: '/opt/rocm/include/ck/...'
#
# before the compiler is ever reached -- on a kernel that is fine. 27 MB copied
# once into the scratch mount is the whole fix. ck_tile comes along because
# build_ext also puts CK_DIR/.. on the include path, and `#include
# <ck_tile/...>` resolves from there.
if [ ! -d "${SCRATCH}/ck-include/ck" ]; then
  echo "materializing writable CK headers at ${SCRATCH}/ck-include ..." >&2
  docker exec "${NAME}" bash -lc \
    'mkdir -p "$1" && cp -a /opt/rocm/include/ck /opt/rocm/include/ck_tile "$1"/' \
    _ "${SCRATCH}/ck-include" >&2 || \
    echo "WARNING: CK header copy failed; ck/ck_tile submissions will not build" >&2
fi


# Gateway credentials, only for an agent container.
#
# ANTHROPIC_*/OPENAI_* are forwarded; CLAUDE_CODE_* deliberately is NOT. Those
# describe the *calling* Claude Code session -- CLAUDE_CODE_SSE_PORT,
# CLAUDE_CODE_MESSAGING_SOCKET, CLAUDE_CODE_SESSION_ID -- and handing them to a
# nested headless instance points it at a socket belonging to another process.
AGENT_ENV=()
if [ "${SOLB_AGENT:-0}" = "1" ]; then
  while IFS='=' read -r k _; do
    case "${k}" in ANTHROPIC_*|OPENAI_*) AGENT_ENV+=(-e "${k}") ;; esac
  done < <(env)
fi

# -i so stdin pipes through; no -t unless attached to a real terminal.
TTY=""
[ -t 0 ] && TTY="-t"
exec docker exec -i ${TTY} \
  ${HIP_VISIBLE_DEVICES:+-e HIP_VISIBLE_DEVICES="${HIP_VISIBLE_DEVICES}"} \
  ${SOLEXBENCH_F_LOCK_MHZ:+-e SOLEXBENCH_F_LOCK_MHZ="${SOLEXBENCH_F_LOCK_MHZ}"} \
  ${SOLEXBENCH_WORKLOADS_ROOT:+-e SOLEXBENCH_WORKLOADS_ROOT="${SOLEXBENCH_WORKLOADS_ROOT}"} \
  ${SOLEXBENCH_METHODOLOGY:+-e SOLEXBENCH_METHODOLOGY="${SOLEXBENCH_METHODOLOGY}"} \
  ${SOLEXBENCH_CLOCK_BASIS:+-e SOLEXBENCH_CLOCK_BASIS="${SOLEXBENCH_CLOCK_BASIS}"} \
  ${SOLEXBENCH_CLOCK_BRACKET_THRESHOLD:+-e SOLEXBENCH_CLOCK_BRACKET_THRESHOLD="${SOLEXBENCH_CLOCK_BRACKET_THRESHOLD}"} \
  ${SOLEXBENCH_CLOCK_SETTLE:+-e SOLEXBENCH_CLOCK_SETTLE="${SOLEXBENCH_CLOCK_SETTLE}"} \
  ${OMP_NUM_THREADS:+-e OMP_NUM_THREADS="${OMP_NUM_THREADS}"} \
  "${AGENT_ENV[@]+"${AGENT_ENV[@]}"}" \
  "${NAME}" "$@"
