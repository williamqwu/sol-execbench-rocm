#!/usr/bin/env bash
# SPDX-License-Identifier: Apache-2.0
#
# Run a command as root in a PRIVILEGED throwaway container.
#
#   env/solb-root rocm-smi --setperfdeterminism 1700 -d 3
#   env/solb-root rocm-smi -r                 # reset clocks
#
# This exists for exactly one reason: applying and releasing the GPU clock
# lock (task 01) needs write access to
# /sys/class/drm/card*/device/power_dpm_force_performance_level, and /sys is
# mounted read-only in a stock container. Note that a stock container does not
# *fail* to set clocks -- `rocm-smi --setperfdeterminism` exits 0 having done
# nothing at all, which is why the lock must always be verified under load.
#
# Measurement does NOT run through here. `env/solb` runs unprivileged, as the
# invoking user, and is what every sweep and timing run uses.
#
# !! This node is shared. A node-wide lock changes GPU clock policy for every
#    other user on it. `rocm-smi -r` reverts.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
IMAGE="solbench:rocm7.2-torch2.9.1"

if ! docker image inspect "${IMAGE}" >/dev/null 2>&1; then
  docker build -q -t "${IMAGE}" "${ROOT}/env" >&2
fi

exec docker run --rm --privileged \
  --hostname "$(hostname)" \
  --device=/dev/kfd --device=/dev/dri \
  -v "${ROOT}:/work" -w /work \
  "${IMAGE}" "$@"
